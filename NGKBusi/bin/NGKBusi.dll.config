<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
	<configSections>
		<sectionGroup name="elmah">
			<section name="security" requirePermission="false" type="Elmah.SecuritySectionHandler, Elmah"/>
			<section name="errorLog" requirePermission="false" type="Elmah.ErrorLogSectionHandler, Elmah"/>
			<section name="errorMail" requirePermission="false" type="Elmah.ErrorMailSectionHandler, Elmah"/>
			<section name="errorFilter" requirePermission="false" type="Elmah.ErrorFilterSectionHandler, Elmah"/>
		</sectionGroup>
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
	</configSections>

	<connectionStrings>
		<!-- perubahan -->
		<add name="DefaultConnection" connectionString="Data Source=TODO_DB_SERVER;Initial Catalog=TODO_DB_NAME;User ID=TODO_DB_USER;Password=TODO_DB_PASSWORD;MultipleActiveResultSets=True" providerName="System.Data.SqlClient"/>

		<!-- Commented Connections -->
		<!--<add name="DefaultConnection" connectionString="Data Source=TODO_DB_SERVER;Initial Catalog=TODO_DB_NAME;Integrated Security=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient"/>-->
		<!--<add name="DefaultConnection" connectionString="Data Source=TODO_DB_SERVER;Initial Catalog=TODO_DB_NAME;User ID=TODO_DB_USER;Password=TODO_DB_PASSWORD;MultipleActiveResultSets=True" providerName="System.Data.SqlClient"/>-->
		<!--<add name="DefaultConnection" connectionString="Data Source=TODO_DB_SERVER;Initial Catalog=TODO_DB_NAME;User ID=TODO_DB_USER;Password=TODO_DB_PASSWORD;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient"/>-->
		<!--<add name="WebIReporterConnection" connectionString="Data Source=TODO_DB_SERVER;Initial Catalog=TODO_DB_NAME;User ID=TODO_DB_USER;Password=TODO_DB_PASSWORD;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />-->

		<add name="WebIReporterConnection" connectionString="Data Source=TODO_DB_SERVER;Initial Catalog=TODO_DB_NAME;User ID=TODO_DB_USER;Password=TODO_DB_PASSWORD;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient"/>

		<!-- AX Dev -->
		<!--<add name="AxConnection" connectionString="Data Source=TODO_DB_SERVER;Initial Catalog=TODO_DB_NAME;User ID=TODO_DB_USER;Password=TODO_DB_PASSWORD;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />-->

		<!-- AX Prod -->
		<add name="AxConnection" connectionString="Data Source=TODO_DB_SERVER;Initial Catalog=TODO_DB_NAME;User ID=TODO_DB_USER;Password=TODO_DB_PASSWORD;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient"/>
		<add name="BarcodeConnection" connectionString="Data Source=TODO_DB_SERVER;Initial Catalog=TODO_DB_NAME;User ID=TODO_DB_USER;Password=TODO_DB_PASSWORD;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient"/>
		<add name="IReporterConnection" connectionString="Data Source=TODO_DB_SERVER_PGSQL;Initial Catalog=TODO_DB_NAME;User ID=TODO_DB_USER;Password=TODO_DB_PASSWORD;MultipleActiveResultSets=True;" providerName="Npgsql"/>
	</connectionStrings>

	<appSettings>
		<add key="webpages:Version" value="3.0.0.0"/>
		<add key="webpages:Enabled" value="false"/>
		<add key="ClientValidationEnabled" value="true"/>
		<add key="UnobtrusiveJavaScriptEnabled" value="true"/>
		<add key="aspnet:MaxJsonDeserializerMembers" value="150000"/>

		<!-- TODO: Konfigurasi Email -->
		<add key="smtpserver" value="TODO_SMTP_SERVER"/>
		<add key="portnumber" value="587"/>
		<add key="emailSender" value="TODO_EMAIL_SENDER"/>
		<add key="emailPassword" value="TODO_EMAIL_PASSWORD"/>
		<add key="IsSSL" value="true"/>

		<!-- TODO: Konfigurasi ReCaptcha -->
		<add key="ReCaptcha_SiteKey" value="TODO_RECAPTCHA_SITE_KEY"/>
		<add key="ReCaptcha_SecretKey" value="TODO_RECAPTCHA_SECRET_KEY"/>

		<add key="elmah.mvc.disableHandler" value="false"/>
		<add key="elmah.mvc.disableHandleErrorFilter" value="false"/>
		<add key="elmah.mvc.requiresAuthentication" value="false"/>
		<add key="elmah.mvc.IgnoreDefaultRoute" value="false"/>
		<add key="elmah.mvc.allowedRoles" value="*"/>
		<add key="elmah.mvc.allowedUsers" value="*"/>
		<add key="elmah.mvc.route" value="elmah"/>
		<add key="elmah.mvc.UserAuthCaseSensitive" value="true"/>
	</appSettings>

	<system.web>
		<sessionState mode="InProc" timeout="99999"/>
		<authentication mode="None"/>

		<!-- TODO: Generate MachineKey baru untuk production -->
		<machineKey decryptionKey="TODO_DECRYPTION_KEY" validationKey="TODO_VALIDATION_KEY"/>

		<compilation debug="true" targetFramework="4.8">
			<assemblies>
				<add assembly="netstandard, Version=2.0.0.0, Culture=neutral,PublicKeyToken=cc7b13ffcd2ddd51"/>
			</assemblies>
		</compilation>
		<trust level="Full"/>
		<customErrors mode="Off"/>
		<httpRuntime targetFramework="4.6.1" requestPathInvalidCharacters="" requestValidationMode="2.0" maxRequestLength="2097151" executionTimeout="3600"/>
		<globalization culture="en-US" enableClientBasedCulture="false" uiCulture="en-US"/>
		<httpModules>
			<add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah"/>
			<add name="ErrorMail" type="Elmah.ErrorMailModule, Elmah"/>
			<add name="ErrorFilter" type="Elmah.ErrorFilterModule, Elmah"/>
			<add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"/>
		</httpModules>
	</system.web>

	<system.webServer>
		<modules runAllManagedModulesForAllRequests="true">
			<remove name="FormsAuthentication"/>
			<remove name="TelemetryCorrelationHttpModule"/>
			<add name="TelemetryCorrelationHttpModule" type="Microsoft.AspNet.TelemetryCorrelation.TelemetryCorrelationHttpModule, Microsoft.AspNet.TelemetryCorrelation" preCondition="integratedMode,managedHandler"/>
			<remove name="ApplicationInsightsWebTracking"/>
			<add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" preCondition="managedHandler"/>
		</modules>
		<security>
			<requestFiltering>
				<requestLimits maxAllowedContentLength="4294967295"/>
			</requestFiltering>
		</security>
		<directoryBrowse enabled="false"/>
		<handlers>
			<remove name="ExtensionlessUrlHandler-Integrated-4.0"/>
			<remove name="OPTIONSVerbHandler"/>
			<remove name="TRACEVerbHandler"/>
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0"/>
		</handlers>
		<validation validateIntegratedModeConfiguration="false"/>
	</system.webServer>

	<system.serviceModel>
		<serviceHostingEnvironment aspNetCompatibilityEnabled="true"/>
	</system.serviceModel>

