                Swal.fire({ title: "Memproses...", allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

                $.ajax({
                    url: '@Url.Action("SignWasteHandover", "ITWasteHandover", new { area = "IT" })',
                    type: 'POST',
                    data: { id: detailId },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Berhasil!',
                                text: response.message,
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                if (typeof wasteTable !== 'undefined') {
                                    wasteTable.ajax.reload(null, false);
                                }
                            });
                        } else {
                            Swal.fire('Gagal', response.message, 'error');
