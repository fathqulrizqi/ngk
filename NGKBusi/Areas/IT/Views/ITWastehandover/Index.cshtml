    function tambahBarisEdit(data = {}) {
        var items = data.items || '';
        var quantity = data.quantity || 1;
        var unit = data.unit || 'unit';
        var asset_no = data.asset_no || '';
        var type = data.type || '';
        var condition = data.condition || '';
        var actions = data.actions || 'Auctioned';
        var confidentiality = data.confidentiality || 'Public';

        var barisEditBaru = `
            <tr class="baris-edit-aset">
                <td><input type="text" name="Details[${editIndex}].items" class="form-control form-control-sm item-input" value="${items}" required /></td>
                <td><input type="number" name="Details[${editIndex}].quantity" class="form-control form-control-sm qty-input text-center" value="${quantity}" required /></td>
                <td><input type="text" name="Details[${editIndex}].unit" class="form-control form-control-sm unit-input" value="${unit}" required /></td>
                <td><input type="text" name="Details[${editIndex}].asset_no" class="form-control form-control-sm asset-input" value="${asset_no}" required /></td>
                <td>
                    <select name="Details[${editIndex}].type" class="form-control form-control-sm type-input" required>
                        <option value="">Pilih...</option>
                        <option value="Laptop" ${type === 'Laptop' ? 'selected' : ''}>Laptop</option>
                        <option value="PC" ${type === 'PC' ? 'selected' : ''}>PC</option>
                        <option value="Server" ${type === 'Server' ? 'selected' : ''}>Server</option>
                        <option value="Storage" ${type === 'Storage' ? 'selected' : ''}>Storage</option>
                        <option value="Monitor" ${type === 'Monitor' ? 'selected' : ''}>Monitor</option>
                        <option value="Printer" ${type === 'Printer' ? 'selected' : ''}>Printer</option>
                        <option value="Keyboard" ${type === 'Keyboard' ? 'selected' : ''}>Keyboard</option>
                        <option value="Others" ${type === 'Others' ? 'selected' : ''}>Others</option>
                    </select>
                </td>
                <td><input type="text" name="Details[${editIndex}].condition" class="form-control form-control-sm condition-input" value="${condition}" required /></td>
                <td>
                    <select name="Details[${editIndex}].actions" class="form-control form-control-sm actions-input" required>
                        <option value="Auctioned" ${actions === 'Auctioned' ? 'selected' : ''}>Auctioned</option>
                        <option value="Donated" ${actions === 'Donated' ? 'selected' : ''}>Donated</option>
                        <option value="Destroyed" ${actions === 'Destroyed' ? 'selected' : ''}>Destroyed</option>
                        <option value="Scrap" ${actions === 'Scrap' ? 'selected' : ''}>Scrap</option>
                        <option value="Repair" ${actions === 'Repair' ? 'selected' : ''}>Repair</option>
                    </select>
                </td>
                <td>
                    <select name="Details[${editIndex}].confidentiality" class="form-control form-control-sm confidentiality-input" required>
                        <option value="Public" ${confidentiality === 'Public' ? 'selected' : ''}>Public</option>
                        <option value="Internal" ${confidentiality === 'Internal' ? 'selected' : ''}>Internal</option>
                        <option value="Confidential" ${confidentiality === 'Confidential' ? 'selected' : ''}>Confidential</option>
                    </select>
                </td>
                <td class="text-center"><button type="button" class="btn btn-danger btn-sm btn-hapus-edit px-2 py-1 font-weight-bold">Del</button></td>
            </tr>`;

        $("#editDisposalTableBody").append(barisEditBaru);
        editIndex++;
    }

    $(document).on("click", "#btnEditTambahBaris", function () {
        tambahBarisEdit();
    });

    $(document).on("click", ".btn-hapus-edit", function () {
        var row = $(this).closest("tr");
        if ($("#editDisposalTableBody tr").length <= 1) {
            Swal.fire("Perhatian", "Minimal harus ada 1 baris item disposal.", "warning");
            return;
        }
        row.remove();
        reindexEditRows();
    });

    function reindexEditRows() {
        $('#editDisposalTableBody tr').each(function (idx) {
            $(this).find('input, select').each(function () {
                var name = $(this).attr('name');
                if (name) {
                    var newName = name.replace(/\[\d+\]/, '[' + idx + ']');
                    $(this).attr('name', newName);
                }
            });
        });
        editIndex = $('#editDisposalTableBody tr').length;
    }

    $(document).on("click", "#btnSave", function (e) {
        e.preventDefault();

        var firstRow = $("#disposalTableBody tr.baris-aset").first();
        var creatorVal = firstRow.find('.creator-select').val();
        var itemsVal = firstRow.find('.item-input').val();
        var assetNoVal = firstRow.find('.asset-input').val();
        var typeVal = firstRow.find('.type-input').val();

        if (!creatorVal || !itemsVal || !assetNoVal || !typeVal) {
            Swal.fire({ icon: "warning", title: "Mohon lengkapi data nama dan item disposal!", timer: 1500, showConfirmButton: false });
            return;
        }

        var formData = $('#wasteHandoverForm').serialize();

        Swal.fire({ title: "Sedang memproses...", allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

        $.ajax({
            url: '@Url.Action("SaveWasteHandover", "ITWasteHandover", new { area = "IT" })',
            type: "POST",
            data: formData,
            success: function (response) {
                if (response.success) {
                    Swal.fire({ icon: "success", title: "Berhasil!", text: response.message || "Data berhasil disimpan.", timer: 1500, showConfirmButton: false });
                    $('#createHandoverModal').modal('hide');
                    $('#wasteHandoverForm')[0].reset();
                    $('#disposalTableBody').html(`
                        <tr class="baris-aset">
                            <td>
                                <select name="Details[0].creator_name" class="form-control form-control-sm creator-select" required>
                                    ${globalUserOptions}
                                </select>
                            </td>
                            <td><input type="text" name="Details[0].items" class="form-control form-control-sm item-input" required /></td>
                            <td><input type="number" name="Details[0].quantity" class="form-control form-control-sm qty-input text-center" value="1" required /></td>
                            <td><input type="text" name="Details[0].unit" class="form-control form-control-sm unit-input" value="unit" required /></td>
                            <td><input type="text" name="Details[0].asset_no" class="form-control form-control-sm asset-input" required /></td>
                            <td>
                                <select name="Details[0].type" class="form-control form-control-sm type-input" required>
                                    <option value="">Pilih...</option>
                                    <option value="Laptop">Laptop</option>
                                    <option value="PC">PC</option>
                                    <option value="Server">Server</option>
                                    <option value="Storage">Storage</option>
                                    <option value="Monitor">Monitor</option>
                                    <option value="Printer">Printer</option>
                                    <option value="Keyboard">Keyboard</option>
                                    <option value="Others">Others</option>
                                </select>
                            </td>
                            <td><input type="text" name="Details[0].condition" class="form-control form-control-sm condition-input" required /></td>
                            <td>
                                <select name="Details[0].actions" class="form-control form-control-sm actions-input" required>
                                    <option value="Auctioned">Auctioned</option>
                                    <option value="Donated">Donated</option>
                                    <option value="Destroyed">Destroyed</option>
                                    <option value="Scrap">Scrap</option>
                                    <option value="Repair">Repair</option>
                                </select>
                            </td>
                            <td>
                                <select name="Details[0].confidentiality" class="form-control form-control-sm confidentiality-input" required>
                                    <option value="Public">Public</option>
                                    <option value="Internal">Internal</option>
                                    <option value="Confidential">Confidential</option>
                                </select>
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-danger btn-sm btn-hapus px-2 py-1 font-weight-bold">Del</button>
                            </td>
                        </tr>
                    `);
                    if (typeof wasteTable !== 'undefined') {
                        wasteTable.ajax.reload(null, false);
                    }
                } else {
                    Swal.fire({ icon: "error", title: "Gagal", text: response.message });
                }
            },
            error: function (xhr) {
                Swal.fire("Error", "Status: " + xhr.status + " - " + xhr.responseText, "error");
            }
        });
    });

    $(document).on("click", ".btn-open-edit", function () {
        $('#edit_disposal_id').val($(this).data('id'));
        $('#edit_department').val($(this).data('department'));

        var rawDate = $(this).data('date');
        if (rawDate) {
            var timestamp = parseInt(rawDate.replace(/\/Date\((\d+)\)\//, '$1'));
            var dateObj = new Date(timestamp);
            if (!isNaN(dateObj)) {
                var formattedDate = dateObj.toISOString().split('T')[0];
                $('#edit_date').val(formattedDate);
            }
        }

        $('#editDisposalTableBody').empty();
        editIndex = 0;

        tambahBarisEdit({
            items: $(this).data('items'),
            quantity: $(this).data('qty'),
            unit: $(this).data('unit'),
            asset_no: $(this).data('asset'),
            type: $(this).data('type'),
            condition: $(this).data('condition'),
            actions: $(this).data('actions'),
            confidentiality: $(this).data('confidentiality')
        });

        $('#editHandoverModal').modal('show');
    });

    $(document).on("click", "#btnUpdate", function (e) {
        e.preventDefault();

        var formData = $('#editWasteHandoverForm').serialize();

        Swal.fire({ title: "Menyimpan Perubahan...", allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

        $.ajax({
            url: '@Url.Action("UpdateWasteHandover", "ITWasteHandover", new { area = "IT" })',
            type: "POST",
            data: formData,
            success: function (response) {
                if (response.success) {
                    Swal.fire({ icon: "success", title: "Berhasil!", text: response.message || "Data berhasil diperbarui.", timer: 1500, showConfirmButton: false });
                    $('#editHandoverModal').modal('hide');
                    if (typeof wasteTable !== 'undefined') {
                        wasteTable.ajax.reload(null, false);
                    }
                } else {
                    Swal.fire({ icon: "error", title: "Gagal", text: response.message });
                }
            },
            error: function (xhr) {
                Swal.fire("Error", "Status: " + xhr.status + " - " + xhr.responseText, "error");
            }
        });
    });

    $(document).ready(function () {
        $("body").addClass("sidebar-toggled");
        $(".sidebar").addClass("toggled");

        if (window.innerWidth >= 768) {
            $(".sidebar").css({
                "width": "65px",
                "overflow": "visible"
            });
            $(".sidebar.toggled .nav-item .collapse").removeClass("show");
        }
    });

    $(document).on("click", ".btn-delete", function () {
        var id = $(this).data("id");

        Swal.fire({
            title: "Are you sure?",
            text: "This data will be permanently deleted.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, Delete",
            cancelButtonText: "Cancel",
            confirmButtonColor: "#d33"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("DeleteWasteHandover", "ITWasteHandover", new { area = "IT" })',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted',
                                text: res.message || 'Data berhasil dihapus.',
                                timer: 1500,
                                showConfirmButton: false
                            });

                            if (typeof wasteTable !== 'undefined') {
                                wasteTable.ajax.reload(null, false);
                            }
                            $('#btnSendToDisposal').fadeOut();
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    },
                    error: function (xhr) {
                        Swal.fire('Error', 'Terjadi kesalahan: ' + xhr.statusText, 'error');
                    }
                });
            }
        });
    });
    </script>
