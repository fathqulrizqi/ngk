
@section cssHead{
    <link href="https://cdn.jsdelivr.net/npm/gijgo@1.9.14/css/gijgo.min.css" rel="stylesheet" type="text/css" />

    <style>
        .input-group-append {
            cursor: pointer;
        }

        .has-error .select2-selection {
            border-color: #dc3545 !important;
        }

        .card img {
            display: block;
            margin-left: auto;
            margin-right: auto;
            width: 50%;
        }

        .card-header .customs {
        }

        #txtQuantity-error {
            font-size: 18px;
        }

        .form-switch {
            padding-left: 8.5em;
        }

        .select2-invalid .select2-selection {
            border-color: #dc3545 !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(.375em + .1875rem) center;
            background-size: calc(.75em + .375rem) calc(.75em + .375rem);
        }

        /* Update CSS untuk Select2 Multiple yang Error */
        .select2-invalid .select2-selection--multiple,
        .select2-invalid .select2-selection--single {
            border: 1px solid #dc3545 !important; /* Warna merah bahaya Bootstrap */
        }

        .select2-container .select2-selection--single {
            height: 38px !important;
        }

        .select2-container--default .select2-selection--single {
            border: 1px solid #ccc !important;
            border-radius: 4px !important;
            line-height: 36px;
        }

            .select2-container--default .select2-selection--single .select2-selection__rendered {
                color: #444;
                line-height: 36px;
            }
    </style>
}

<script src="https://cdn.jsdelivr.net/npm/gijgo@1.9.14/js/gijgo.min.js" type="text/javascript"></script>

<script src="@Url.Content("~/Content/bootstrap-table/bootstrap-table.min.js")"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>


<div class="row">
    <div class="col-12">
        @*<div class="card" style="text-align: left; box-shadow: 0 5px 10px rgba(0,0,0,.2);">*@
            @*<div class="card-header bg-primary rounded-top rounded-5" style="text-align: center; color: white; font-weight: bold; font-size: medium; box-shadow: inherit;">
            New Reminder
        </div>*@
        <form method="post" class="row g-3" action="" enctype="multipart/form-data" id="formSettingReminder">


            <input type="hidden" name="ID" value="@(ViewBag.reminder.ID)" />
            <div class="col-md-12">
                <label for="inputEmail4" class="form-label">Event Reminder Title</label>
                <input type="text" name="ReminderTitle" class="form-control" id="txtTitle" value="@(ViewBag.reminder.ReminderTitle)">
            </div>
            <div class="col-md-6 mt-2">
                <label for="inputPassword4" class="form-label">Module</label>
                <select class="form-control" name="module" id="selModule">
                    <option value="budget" @(ViewBag.reminder.Module == "budget" ? "selected='selected'" : "")>Budget</option>
                    <option value="license" @(ViewBag.reminder.Module == "license" ? "selected='selected'" : "")>License</option>
                    <option value="Agreement" @(ViewBag.reminder.Module == "Agreement" ? "selected='selected'" : "")>Agreement</option>
                </select>
            </div>
            <div class="col-md-6 mt-2">
                <label for="inputAddress" class="form-label">Type</label>
                <input type="text" name="Type" class="form-control" id="txtType" value="@(ViewBag.reminder.Type)">
            </div>
            <div class="col-6 mt-2">
                <label for="inputAddress2" class="form-label">Third Party</label>
                <div id="parSelThirdParty">
                    @{

                    }
                    <select class="form-control select2" data-live-search="true" id="selThirdParty" name="ThirdParty" required style="@((ViewBag.reminder.Module == "permit"  || ViewBag.reminder.Module == "Agreement") ? "display:none" : "") ">
                        @{

                            foreach (var usr in ViewBag.ListVendor)
                            {

                                <option value="@(usr.ACCOUNTNUM)">@(usr.Name)  </option>
                            }
                        }
                    </select>
                </div>

                <input type="text" name="ThirdParty" class="form-control" id="txtThirdParty" value="@(ViewBag.reminder.Thirdparty)" style="@((ViewBag.reminder.Module == "permit"  || ViewBag.reminder.Module == "Agreement") ? "" : "display:none")">
            </div>

            <div class="col-md-6 mt-2">
                <label for="inputCity" class="form-label">Description</label>
                <input type="text" name="Description" class="form-control" id="txtDescription" value="@(ViewBag.reminder.Description)">
            </div>
            <div class="col-md-12 mt-2">
                <label for="tagsInput" class="form-label">Select Email Recipient</label>
                <select class="form-control selMultiple" name="selReminderUser" id="tagsInput" multiple style="width: 100%;" required>
                    @{

                        foreach (var usr in ViewBag.ListEmail)
                        {
                            string selected = "";
                            foreach (var reminderUser in ViewBag.reminderUser)
                            {
                                if (reminderUser.SendToUser == usr.Email)
                                {
                                    selected = "selected='selected'";
                                }

                            }
                            <option value="@usr.Email" @selected>@usr.Email  </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6 mt-2">
                <label for="inputCity" class="form-label">Attachment</label>
                <input type="file" name="FileAttachment" class="form-control" id="fileAttachment">
            </div>
            <div class="col-md-6 mt-2">
                <label for="inputCity" class="form-label"></label><br />

                <a target="_blank" href="@Url.Action("ViewPDF", "Reminder", new { area = "IT", fileName = ViewBag.reminder.Attachment })" class="mt-2"><i class="fa fa-file-pdf"></i> @(ViewBag.reminder.Attachment)</a>
            </div>
            <div class="col-md-6 mt-2">
                <div class="card">
                    <div class="card-header">
                        <i class="fa-solid fa-clock"></i>
                        <div class="vr"></div> Event Due Date
                    </div>
                    <div class="card-body">

                        <div class="col-md-12 mt-2">
                            <div class="form-group row">
                                <label for="inputCity" class="col-sm-4 col-form-label">Due Date</label>
                                <div class="col-sm-8">
                                    <input type="text" name="txtDueDate" class="form-control" id="datepicker" value="@(ViewBag.reminder.DueDate.ToString("dd/MM/yyyy"))" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="txtIntervalRepeatReminderNumber" class="col-sm-4 col-form-label">Repeat Event Every </label>
                                <div class="col-sm-2">
                                    <input type="number" name="IntervalRepeatReminderNumber" class="form-control" id="txtIntervalRepeatReminderNumber" placeholder="" min="1" value="@(ViewBag.reminder.IntervalRepeatReminderNumber)">
                                </div>
                                <div class="col-sm-6">
                                    <select class="form-select" name="IntervalRepetReminderType" id="SelIntervalRepetReminderType" aria-label="Select Time">
                                        <option value="OneTime" @(ViewBag.reminder.IntervalRepetReminderType == "OneTime" ? "selected=selected" : "" )>Does not repeat </option>
                                        <option value="month" @(ViewBag.reminder.IntervalRepetReminderType == "month" ? "selected=selected" : "" )>Month</option>
                                        <option value="year" @(ViewBag.reminder.IntervalRepetReminderType == "year" ? "selected=selected" : "" )>Year</option>
                                    </select>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mt-2">
                <div class="card">
                    <div class="card-header">
                        <i class="fa fa-bell"></i> Notification Settings
                    </div>
                    <div class="card-body">
                        <div class="col-md-12 mt-2">
                            <div class="form-group row">
                                <label for="txtNotifStart" class="col-sm-4 col-form-label">Send Notification From</label>
                                <div class="col-sm-4"><input type="number" name="NotifStart" class="form-control" id="txtNotifStart" min="0" placeholder="Number of Day " value="@(Math.Abs(ViewBag.reminder.NotifStart))"></div>
                                <label for="txtNotifStart" class="col-sm-4 col-form-label">Days Before Due Date.</label>

                            </div>
                            <div class="form-group row">
                                <label for="selNotifTime" class="col-sm-4 col-form-label">Sending Time</label>
                                <div class="col-sm-8">
                                    <select class="form-select" name="NotifTime" id="selNotifTime" aria-label="Select Time">
                                        <option value="00" @(ViewBag.reminder.NotifTime == "00" ? "selected='selected'" : "")>00:00</option>
                                        <option value="01" @(ViewBag.reminder.NotifTime == "01" ? "selected='selected'" : "")>01:00</option>
                                        <option value="02" @(ViewBag.reminder.NotifTime == "02" ? "selected='selected'" : "")>02:00</option>
                                        <option value="03" @(ViewBag.reminder.NotifTime == "03" ? "selected='selected'" : "")>03:00</option>
                                        <option value="04" @(ViewBag.reminder.NotifTime == "04" ? "selected='selected'" : "")>04:00</option>
                                        <option value="05" @(ViewBag.reminder.NotifTime == "05" ? "selected='selected'" : "")>05:00</option>
                                        <option value="06" @(ViewBag.reminder.NotifTime == "06" ? "selected='selected'" : "")>06:00</option>
                                        <option value="07" @(ViewBag.reminder.NotifTime == "07" ? "selected='selected'" : "")>07:00</option>
                                        <option value="08" @(ViewBag.reminder.NotifTime == "08" ? "selected='selected'" : "")>08:00</option>
                                        <option value="09" @(ViewBag.reminder.NotifTime == "09" ? "selected='selected'" : "")>09:00</option>
                                        <option value="10" @(ViewBag.reminder.NotifTime == "10" ? "selected='selected'" : "")>10:00</option>
                                        <option value="11" @(ViewBag.reminder.NotifTime == "11" ? "selected='selected'" : "")>11:00</option>
                                        <option value="12" @(ViewBag.reminder.NotifTime == "12" ? "selected='selected'" : "")>12:00</option>
                                        <option value="13" @(ViewBag.reminder.NotifTime == "13" ? "selected='selected'" : "")>13:00</option>
                                        <option value="14" @(ViewBag.reminder.NotifTime == "14" ? "selected='selected'" : "")>14:00</option>
                                        <option value="15" @(ViewBag.reminder.NotifTime == "15" ? "selected='selected'" : "")>15:00</option>
                                        <option value="16" @(ViewBag.reminder.NotifTime == "16" ? "selected='selected'" : "")>16:00</option>
                                        <option value="17" @(ViewBag.reminder.NotifTime == "17" ? "selected='selected'" : "")>17:00</option>
                                        <option value="18" @(ViewBag.reminder.NotifTime == "18" ? "selected='selected'" : "")>18:00</option>
                                        <option value="19" @(ViewBag.reminder.NotifTime == "19" ? "selected='selected'" : "")>19:00</option>
                                        <option value="20" @(ViewBag.reminder.NotifTime == "20" ? "selected='selected'" : "")>20:00</option>
                                        <option value="21" @(ViewBag.reminder.NotifTime == "21" ? "selected='selected'" : "")>21:00</option>
                                        <option value="22" @(ViewBag.reminder.NotifTime == "22" ? "selected='selected'" : "")>22:00</option>
                                        <option value="23" @(ViewBag.reminder.NotifTime == "23" ? "selected='selected'" : "")>23:00</option>
                                        <option value="24" @(ViewBag.reminder.NotifTime == "24" ? "selected='selected'" : "")>24:00</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="txtIntervalRepeatNotifNumber" class="col-sm-4 col-form-label">Repeat Notification Every</label>
                                <div class="col-sm-2">
                                    <input type="number" name="IntervalRepeatNotifNumber" class="form-control" id="txtIntervalRepeatNotifNumber" value="@(ViewBag.reminder.IntervalRepeatNotifNumber)" placeholder="" min="1">
                                </div>
                                <div class="col-sm-6">
                                    <select class="form-select" name="IntervalRepeatNotifType" id="selIntervalRepeatNotifType" aria-label="Select Time">
                                        <option value="OneTime" @(ViewBag.reminder.IntervalRepeatNotifType == "OneTime" ? "selected=selected" : "" )>Does not repeat </option>
                                        <option value="hour" @(ViewBag.reminder.IntervalRepeatNotifType == "hour" ? "selected=selected" : "" )>Hours</option>
                                        <option value="day" @(ViewBag.reminder.IntervalRepeatNotifType == "day" ? "selected=selected" : "" )>Days</option>
                                    </select>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="alert alert-primary" role="alert" id="alertReminderDate" style="display:none">
                <i class="fa fa-info-circle"></i>  Reminder will be send at <span style="font-weight:bolder" id="txtDateReiminder"></span>
            </div>
            <hr />
            <div class="col-12">
                @{
                    if (ViewBag.reminder.IsActive == 1)
                    {
                        <button type="button" class="btn btn-primary" id="btnSave"><i class="fa fa-floppy-disk"></i> | Update</button>
                        <button type="button" class="btn btn-warning" id="btnStopNotif"><i class="fa-solid fa-circle-stop"></i> | Stop Notification</button>
                    }
                }
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-close"> </i> | Close</button>
            </div>
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {
        var today, datepicker;
        hitungTanggal();
        today = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate());

        $('#datepicker').datepicker({ uiLibrary: 'bootstrap5', format: 'dd/mm/yyyy', minDate: today });

        $('.clockpicker').clockpicker()
            .find('input').change(function () {
                console.log(this.value);
            });

        $("#multiple-select-field").select2({
            theme: "bootstrap-5"
        });

        $('#selCategory, #selSection, #selCupBoardRack').select2({

            dropdownParent: $('#eventDetailModal'),
            closeOnSelect: true
        });

        $('#tagsInput').select2({
            dropdownParent: $('#eventDetailModal'),
            placeholder: "Select Option or Add New",
            tags: true,
            allowClear: true,
            createTag: function (params) {
                return {
                    id: params.term,
                    text: params.term,
                    newOption: true
                }
            },
            templateResult: function (data) {
                var $result = $("<span></span>");
                $result.text(data.text);

                if (data.newOption) {
                    $result.append(" <em>(Add New)</em>");
                }

                return $result;
            }
        });
        $('#selModule').on('change', function () {
            var module = this.value;
            if (module == "permit") {
                $("#txtThirdParty").show();
                $('#parSelThirdParty').hide();
                /*$("#selThirdParty").next(".select2-container").hide();*/
            } else {
                $("#txtThirdParty").hide();
                $('#parSelThirdParty').show();
            };
        });

        // Handle button click to show selected values
        $('#showValues').on('click', function () {
            var selectedValues = $('#tagsInput').val(); // Get selected values as an array
            if (selectedValues.length > 0) {
                alert("Nilai yang dipilih: " + selectedValues.join("+ "));
            } else {
                alert("Tidak ada nilai yang dipilih.");
            }
        });

        $('#txtNotifStart, #datepicker').change(function () {

            hitungTanggal();
        });

        //reminder due date
        $('#txtIntervalRepeatReminderNumber').change(function () {
            GetNewDueDate();
        });

        function hitungTanggal() {
            var tanggalStr = $("#datepicker").val();
            var jumlahHari = parseInt($("#txtNotifStart").val()) || 0;

            if (tanggalStr) {
                // Ubah format dari dd/mm/yy ke format yang bisa dikenali moment.js
                var tanggal = moment(tanggalStr, "DD/MM/YYYY");

                if (tanggal.isValid()) {
                    // Kurangi hari
                    var tanggalBaru = tanggal.subtract(jumlahHari, 'days').format("DD/MM/YYYY");
                    $('#alertReminderDate').removeAttr('style');
                    $("#txtDateReiminder").html(tanggalBaru);
                } else {
                    $("#txtDateReiminder").html("Tanggal tidak valid!");
                }
            }
        }

        $('#btnSave').click(function (e) {
            e.preventDefault();

            // 1. Bersihkan semua peringatan error sebelumnya (reset form)
            $('.is-invalid').removeClass('is-invalid');
            $('.select2-invalid').removeClass('select2-invalid');

            let isValid = true;

            // 2. Daftar ID input text biasa yang wajib diisi
            // (Note: File Attachment biasanya opsional, jika wajib tambahkan '#fileAttachment' ke dalam array ini)
            let requiredInputs = ['#txtTitle', '#txtType', '#txtDescription', '#datepicker', '#txtNotifStart'];

            requiredInputs.forEach(function (id) {
                let value = $(id).val();
                if (!value || value.trim() === "") {
                    $(id).addClass('is-invalid'); // Beri border merah
                    isValid = false;
                }
            });

            // 3. Validasi Select Email Recipient (Tags Input)
            let recipients = $('#tagsInput').val();

            // Hapus pesan error sebelumnya (jika ada) saat tombol save diklik ulang
            $('#error-tagsInput').remove();

            if (!recipients || recipients.length === 0) {
                // Beri border merah
                $('#tagsInput').next('.select2-container').addClass('select2-invalid');
                // Munculkan teks informasi di bawah kotak input
                $('#tagsInput').next('.select2-container').after('<div id="error-tagsInput" style="color: #dc3545; font-size: 87.5%; margin-top: .25rem; font-weight: 500;"><i class="fa fa-exclamation-triangle"></i> Minimal pilih 1 email penerima.</div>');

                isValid = false;
            }

            // 4. Validasi Third Party (Hanya jika module BUKAN permit)
            if ($('#selModule').val() !== "permit") {
                let thirdParty = $('#selThirdParty').val();
                if (!thirdParty || thirdParty === "") {
                    $('#selThirdParty').next('.select2-container').addClass('select2-invalid');
                    isValid = false;
                }
            }

            // 5. Validasi angka interval/pengulangan (Hanya dicek jika user memilih selain "Does not repeat")
            if ($('#SelIntervalRepetReminderType').val() !== "OneTime" && !$('#txtIntervalRepeatReminderNumber').val()) {
                $('#txtIntervalRepeatReminderNumber').addClass('is-invalid');
                isValid = false;
            }
            if ($('#selIntervalRepeatNotifType').val() !== "OneTime" && !$('#txtIntervalRepeatNotifNumber').val()) {
                $('#txtIntervalRepeatNotifNumber').addClass('is-invalid');
                isValid = false;
            }

            // ==========================================================
            // JIKA ADA YANG KOSONG: Tampilkan SweetAlert & Hentikan Proses
            // ==========================================================
            if (!isValid) {
                swal({
                    title: "Data Belum Lengkap!",
                    text: "Harap periksa kembali dan lengkapi kolom yang ditandai dengan warna merah.",
                    type: "warning",
                    confirmButtonText: "Baik, Mengerti"
                });
                return false; // Hentikan eksekusi AJAX
            }

            // ==========================================================
            // JIKA SEMUA VALID: Lanjutkan Proses AJAX ke Server
            // ==========================================================

            var formData = new FormData($("#formSettingReminder")[0]);
            var redirectUrl = "@Url.Action("Home", "Reminder", new { area = "IT" })";
            console.log(formData);
            $.ajax({
                type: 'POST',
                url: "@Url.Action("UpdateSettingReminder", "Reminder", new { area = "IT" })",
                data: formData,
                cache: false,
                contentType: false,
                processData: false,
                beforeSend: function () {
                    var $btn = $('#btnSave');
                    $btn.prop('disabled', true); // Menonaktifkan tombol setelah diklik
                    $btn.html(
                        '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Please Wait ...'
                    );
                },
                success: function (json) {
                    var $btn = $('#btnSave');
                    if (json.status == 1) {
                        $btn.prop('disabled', false);
                        swal({
                            title: "Good job",
                            text: json.msg,
                            type: "success"
                        },
                            function () {
                                location.href = redirectUrl;
                            }
                        );
                    } else {
                        swal("Error", json.msg, "error");
                        $btn.prop('disabled', false);
                        $btn.html(
                            '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> <i class="fa fa-floppy-disk"></i> | Save'
                        );
                    }

                },
                error: function (data) {
                    var $btn = $('#btnSave');
                    $btn.prop('disabled', false);
                },
                complete: function (data) {
                    var $btn = $('#btnSave');
                    $btn.prop('disabled', false);
                    $btn.html(
                        '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> <i class="fa fa-floppy-disk"></i> | Save'
                    );
                }
            });
        });

        $('#btnStopNotif').click(function (e) {

            e.preventDefault();

            // 1. Munculkan Konfirmasi SweetAlert
            swal({
                title: "Apakah Anda Yakin?",
                text: "Notifikasi untuk pengingat ini akan dihentikan dan tidak akan dikirimkan lagi.",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#f0ad4e", // Warna tombol warning
                confirmButtonText: "Ya, Hentikan!",
                cancelButtonText: "Batal",
                closeOnConfirm: false // Biarkan terbuka sebentar untuk ditimpa alert loading/success
            },
            function (isConfirm) {
                // 2. Jika user klik "Ya", jalankan AJAX
                if (isConfirm) {
                    var formData = new FormData($("#formSettingReminder")[0]);
                    var redirectUrl = "@Url.Action("Home", "Reminder", new { area = "IT" })";

                    $.ajax({
                        type: 'POST',
                        url: "@Url.Action("StopNotificationReminder", "Reminder", new { area = "IT" })",
                        data: formData,
                        cache: false,
                        contentType: false,
                        processData: false,
                        beforeSend: function () {
                            // Diperbaiki: Targetkan #btnStopNotif, bukan #btnSave
                            var $btn = $('#btnStopNotif');
                            $btn.prop('disabled', true);
                            $btn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Memproses...');
                        },
                        success: function (json) {
                            var $btn = $('#btnStopNotif');
                            if (json.status == 1) {
                                $btn.prop('disabled', false);
                                swal({
                                    title: "Berhasil!",
                                    text: json.msg,
                                    type: "success"
                                }, function () {
                                    location.href = redirectUrl;
                                });
                            } else {
                                swal("Gagal", json.msg, "error");
                                $btn.prop('disabled', false);
                                // Diperbaiki: Kembalikan ke teks/icon semula
                                $btn.html('<i class="fa-solid fa-circle-stop"></i> | Stop Notification');
                            }
                        },
                        error: function (data) {
                            var $btn = $('#btnStopNotif');
                            $btn.prop('disabled', false);
                            $btn.html('<i class="fa-solid fa-circle-stop"></i> | Stop Notification');
                            swal("Error", "Terjadi kesalahan pada server.", "error");
                        },
                        complete: function (data) {
                            var $btn = $('#btnStopNotif');
                            $btn.prop('disabled', false);
                            // Diperbaiki: Kembalikan ke teks/icon semula
                            $btn.html('<i class="fa-solid fa-circle-stop"></i> | Stop Notification');
                        }
                    });
                }
            });
        });

    });
</script>