<script src="@Url.Content("~/Content/bootstrap-table/bootstrap-table.min.js")"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

<script>
    $('#btnAddNew').click(function () {

        $('#detailBody').html(`
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="mt-3 text-muted">Memuat Form...</h5>
            </div>
        `);
        $('#eventDetailModal').modal('show');

        // Mengambil event berdasarkan ID yang di-klik
        $.ajax({
            url: '@Url.Action("AddReminder", "Reminder", new { area = "IT" })',  // Panggil action untuk mengambil detail event berdasarkan ID
            //data: { ID: info.event.id }, // Kirimkan ID event yang diklik
            success: function (data) {
                // Isi detail modal dengan data yang diterima dari server
                $('#detailBody').html(data);
                $('#selRecipient').select2({
                    width: '100%',
                    placeholder: 'Select options',
                    allowClear: true,
                    dropdownParent: $('#eventDetailModal')
                });
                // Tampilkan modal
                $('#eventDetailModal').modal('show');
            },
            error: function () {
                $('#detailBody').html('<div class="alert alert-danger m-3">Gagal memuat form. Silakan tutup dan coba lagi.</div>');
            }
        });
    });

    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            themeSystem: 'bootstrap5',
            initialView: 'dayGridMonth',
            contentHeight: 700,
            views: {
                multiMonthFourMonth: {
                    type: 'multiMonth',
                    duration: { months: 12 }
                }
            },
            displayEventTime: false,
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek'
            },
            events: '@Url.Action("GetReminderDashData", "Reminder", new { area = "IT" })', // Panggil action GetEvents di controller
            eventDidMount: function (info) {
                var element = info.el;

                // Cek apakah event tidak aktif (sesuaikan nama 'IsActive' dengan properti dari JSON backend Anda)
                // Menggunakan == 0 atau false atau "0" untuk berjaga-jaga format datanya
                if (info.event.extendedProps.IsActive == 0 || info.event.extendedProps.IsActive === false || info.event.extendedProps.IsActive === "0") {
                    element.style.backgroundColor = '#dc3545'; // Warna merah danger bootstrap
                    element.style.borderColor = '#dc3545';
                }

                // Mouseover effect
                $(element).on('mouseenter', function () {
                    //$(element).css('background-color', '#ff0000'); // Change background color on hover
                    $(element).attr('title', info.event.title); // Show description on hover
                });

                // Mouseout effect
                $(element).on('mouseleave', function () {
                    //$(element).css('background-color', info.event.backgroundColor); // Reset background color
                    $(element).attr('title', ''); // Reset tooltip
                });
            },
            eventClick: function (info, jsEvent, view) {
                // 1. Munculkan modal dan spinner seketika
                $('#detailBody').html(`
                    <div class="text-center my-5">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <h5 class="mt-3 text-muted">Memuat Detail Event...</h5>
                    </div>
                `);
                $('#eventDetailModal').modal('show');
                // Mengambil event berdasarkan ID yang di-klik
                $.ajax({
                    url: '@Url.Action("FormSettingReminder", "Reminder", new { area = "IT" })',  // Panggil action untuk mengambil detail event berdasarkan ID
                    data: { ID: info.event.id }, // Kirimkan ID event yang diklik
                    success: function (data) {
                        // Isi detail modal dengan data yang diterima dari server
                        $('#detailBody').html(data);
                        $('#tagsInput').select2({
                            width: '100%',
                            placeholder: 'Select options',
                            allowClear: true,
                            dropdownParent: $('#eventDetailModal')
                        });
                        // Tampilkan modal
                        $('#eventDetailModal').modal('show');
                    },
                    error: function () {
                        $('#detailBody').html('<div class="alert alert-danger m-3">Failed to retrieve event details.</div>');
                    }
                });
            },
            dateClick: function (info) {
                let dateParts = info.dateStr.split('-');
                let clickedDateFormatted = dateParts[2] + '/' + dateParts[1] + '/' + dateParts[0];

                // 1. TITIPKAN data tanggal yang diklik ke elemen Modal
                $('#eventDetailModal').data('clickedDate', clickedDateFormatted);

                $('#detailBody').html('<div class="text-center my-5"><div class="spinner-border text-primary"></div><h5 class="mt-3 text-muted">Memuat Form...</h5></div>');
                $('#eventDetailModal').modal('show');

                $.ajax({
                    url: '@Url.Action("AddReminder", "Reminder", new { area = "IT" })',
                    success: function (data) {
                        $('#detailBody').html(data);

                        // Catatan: Baris $('#datepicker').val(...) kita hapus dari sini

                        $('#selRecipient').select2({
                            width: '100%',
                            placeholder: 'Select options',
                            allowClear: true,
                            dropdownParent: $('#eventDetailModal')
                        });
                    },
                    error: function () {
                        alert('Failed to retrieve form details.');
                    }
                });
            }
        });
        calendar.render();
    });

    document.addEventListener('DOMContentLoaded', function () {
        var calendarElList = document.getElementById('calendarList');
        var myCalendarList = new FullCalendar.Calendar(calendarElList, {
            themeSystem: 'bootstrap5',
            initialView: 'listYear',
            contentHeight: 700,            
            displayEventTime: false,

            events: function (fetchInfo, successCallback, failureCallback) {
                $.ajax({
                    url: '@Url.Action("GetReminderListUpcoming", "Reminder", new { area = "IT" })',
                    type: 'GET',
                    success: function (data) {
                        var selectedModule = $('#selFilterModule').val();

                        if (selectedModule === 'all') {
                            successCallback(data); // Tampilkan semua jika filter adalah "All"
                        } else {
                            // Filter array data berdasarkan modul yang dipilih
                            var filteredData = data.filter(function (item) {
                                // Mencari nama properti (handle huruf besar/kecil bawaan JSON C#)
                                var itemModule = item.module || item.Module || (item.extendedProps && item.extendedProps.module);
                                return itemModule && itemModule.toLowerCase() === selectedModule.toLowerCase();
                            });
                            successCallback(filteredData);
                        }
                    },
                    error: function () {
                        failureCallback();
                        console.error('Gagal mengambil data list kalender.');
                    }
                });
            },
            eventContent: function (arg) {
                let eventInfo = document.createElement('div');

                // Custom tampilan tanpa jam, dan menampilkan informasi tambahan
                eventInfo.innerHTML = `
                <strong>${arg.event.title}</strong><br>
                <span>${arg.event.extendedProps.module}</span> - <span>${arg.event.extendedProps.Thirdparty}</span> <br>`;
                //<em>Lokasi: ${arg.event.extendedProps.location}</em>

                return { domNodes: [eventInfo] };
            },
            // Menghilangkan format jam bawaan
            eventTimeFormat: {
                hour: '', minute: '', meridiem: false
            },
            eventDidMount: function (info) {
                // Cek apakah event tidak aktif
                if (info.event.extendedProps.IsActive == 0 || info.event.extendedProps.IsActive === false || info.event.extendedProps.IsActive === "0") {
                    // Cari elemen lingkaran (dot) pada list view
                    var dotEl = info.el.querySelector('.fc-list-event-dot');
                    if (dotEl) {
                        // Ubah warna titik menjadi merah
                        dotEl.style.borderColor = '#dc3545';
                    }
                }
            },
            eventClick: function (info, jsEvent, view) {
                        // 1. Munculkan modal dan spinner seketika
                        $('#detailBody').html(`
                            <div class="text-center my-5">
                                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <h5 class="mt-3 text-muted">Memuat Detail Event...</h5>
                            </div>
                        `);
                        $('#eventDetailModal').modal('show');
                        // Mengambil event berdasarkan ID yang di-klik
                        $.ajax({
                            url: '@Url.Action("FormSettingReminder", "Reminder", new { area = "IT" })',  // Panggil action untuk mengambil detail event berdasarkan ID
                            data: { ID: info.event.id }, // Kirimkan ID event yang diklik
                            success: function (data) {
                                // Isi detail modal dengan data yang diterima dari server
                                $('#detailBody').html(data);
                                $('#tagsInput').select2({
                                    width: '100%',
                                    placeholder: 'Select options',
                                    allowClear: true,
                                    dropdownParent: $('#eventDetailModal')
                                });
                                // Tampilkan modal
                                $('#eventDetailModal').modal('show');
                            },
                            error: function () {
                                $('#detailBody').html('<div class="alert alert-danger m-3">Failed to retrieve event details.</div>');
                            }
                        });
            },
            dateClick: function (info, jsEvent, view) {
                // 1. Ambil tanggal yang diklik dan format menjadi DD/MM/YYYY
                let d = info.date;
                let day = ("0" + d.getDate()).slice(-2); // Tambah angka 0 di depan jika tanggal < 10
                let month = ("0" + (d.getMonth() + 1)).slice(-2); // Tambah angka 0 di depan jika bulan < 10
                let year = d.getFullYear();
                let clickedDateFormatted = day + '/' + month + '/' + year;

                // 2. Munculkan modal dengan animasi loading seketika (menerapkan solusi sebelumnya)
                $('#detailBody').html(`
                    <div class="text-center my-5">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <h5 class="mt-3 text-muted">Memuat Form...</h5>
                    </div>
                `);
                $('#eventDetailModal').modal('show');

                // 3. Request AJAX untuk memuat Form Add Reminder
                $.ajax({
                    url: '@Url.Action("AddReminder", "Reminder", new { area = "IT" })',
                    // Catatan: Tidak perlu mengirim parameter "ID" karena ini form buat baru, bukan edit event
                    success: function (data) {
                        // Isi detail modal dengan form dari server
                        $('#detailBody').html(data);

                        // --- INI KUNCI UTAMANYA ---
                        // Set input #datepicker dengan tanggal yang diklik
                        $('#datepicker').val(clickedDateFormatted);

                        // Inisialisasi ulang plugin di dalam modal
                        $('#tagsInput').select2({
                            width: '100%',
                            placeholder: 'Select options',
                            allowClear: true,
                            dropdownParent: $('#eventDetailModal')
                        });
                    },
                    error: function () {
                        $('#detailBody').html('<div class="alert alert-danger m-3">Failed to retrieve form.</div>');
                    }
                });
            },
        });
        myCalendarList.render();

        // Otomatis merefresh isi kalender setiap kali dropdown diganti
        $('#selFilterModule').on('change', function () {
            myCalendarList.refetchEvents();
        });
    });

    $(function () {
        $('#fresh-table').bootstrapTable({
            exportDataType: "all",
            exportTypes: ['excel', 'pdf'],
            buttonsClass: 'primary'
        })
    });

    function queryParams(params) {
        params.switch = "";//   <<<----------catch like this
        return params;
    }

    function ajaxRequest(params) {
        //var RequestNo = "@(ViewBag.RequestNo)";
        $.ajax({
            type: "post",
            url: "@Url.Action("GetReminderList", "Reminder", new { area = "IT" })",
            dataType: 'json',
            data: '',
            success: function (items) {
                //console.log(items.notReady);
                params.success({
                    rows: items
                }, null);
            },
            error: function (er) {
                console.log(params.error(er))
                console.log("error", er);
            }
        })
    }
    $('#selRecipient').select2({
        dropdownParent: $('#eventDetailModal'),
        placeholder: "Select Option or Add New",
        tags: true,
        allowClear: true,
        createTag: function (params) {
            return {
                id: params.term,
                text: params.term,
                newOption: true
            }
        },
        templateResult: function (data) {
            var $result = $("<span></span>");
            $result.text(data.text);

            if (data.newOption) {
                $result.append(" <em>(Add New)</em>");
            }

            return $result;
        }
    });
    $('#tagsInput').select2({
        dropdownParent: $('#eventDetailModal'),
        placeholder: "Select Option or Add New",
        tags: true,
        allowClear: true,
        createTag: function (params) {
            return {
                id: params.term,
                text: params.term,
                newOption: true
            }
        },
        templateResult: function (data) {
            var $result = $("<span></span>");
            $result.text(data.text);

            if (data.newOption) {
                $result.append(" <em>(Add New)</em>");
            }

            return $result;
        }
    });
    $(document).ready(function () {
        $("#formSettingReminder").on('submit', function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            alert('submt');
            return false;
            @* $.ajax({
                type: 'POST',
                url: "@Url.Action("UpdateSettingReminder", "Reminder", new { area = "IT" })",
                data: formData,
                cache: false,
                contentType: false,
                processData: false,
                beforeSend: function () {
                    var $btn = $('#btnSave');
                    $btn.prop('disabled', true); // Menonaktifkan tombol setelah diklik
                    $btn.html(
                        '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Please Wait ...'
                    );
                },
                success: function (json) {
                    var $btn = $('#btnSave');
                    if (json.status == 1) {
                        $btn.prop('disabled', false);
                    } else {

                        $btn.prop('disabled', false);
                    }

                },
                error: function (data) {
                    var $btn = $('#btnSave');
                    $btn.prop('disabled', false);
                },
                complete: function (data) {
                    var $btn = $('#btnSave');
                    $btn.prop('disabled', false);
                }
            });*@
        });
    });



</script>
