<style>
    .fc-event {
        cursor: pointer; /* Tampilkan kursor tangan saat hover pada event */
    }

    /* --- TAMBAHKAN KODE DI BAWAH INI --- */

    /* Menghilangkan garis bawah dan warna biru pada semua link di dalam kalender */
    .fc a {
        text-decoration: none !important;
        color: inherit !important;
    }

    /* Memastikan teks hari dan tanggal berwarna gelap/hitam (opsional, sesuaikan warna jika perlu) */
    .fc-col-header-cell-cushion,
    .fc-daygrid-day-number,
    .fc-list-day-text,
    .fc-list-day-side-text {
        color: #333333 !important;
    }

    /* Efek hover saat mouse diarahkan ke angka/hari (opsional) */
    .fc a:hover {
        color: #0d6efd !important; /* warna biru saat di-hover */
        text-decoration: none !important;
    }
</style>

<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success" id="btnAddNew"><i class="fa fa-plus"></i> Create Reminder</button>
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-lg-8 col-md-12 col-sm-12">
                <div class="card">
                    <div class="card-header bg-primary" style="color:white">
                        Reminder Dashboard
                    </div>
                    <div class="card-body">
                        <div id='calendar'></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-12 col-sm-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary d-flex justify-content-between align-items-center" style="color:white">
                        <span><i class="fa fa-list-alt"></i> Upcoming Events</span>
                    </div>
                    <div class="card-body">

                        <div class="d-flex align-items-center mb-3 p-2 rounded" style="background-color: #f8f9fa; border: 1px solid #e9ecef;">
                            <i class="fa fa-filter text-muted me-2 ms-1"></i>
                            <select id="selFilterModule" class="form-select form-select-sm border-0 shadow-none bg-transparent fw-bold text-primary" style="cursor: pointer;">
                                <option value="all">All Modules</option>
                                <option value="budget">Budget</option>
                                <option value="license">License</option>
                                <option value="agreement">Agreement</option>
                                <option value="permit">Permit</option>
                            </select>
                        </div>
                        <div id='calendarList'></div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
    <div class="modal fade" id="eventDetailModal" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Reminder Event Detail</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                    <div class="modal-body" id="detailBody">

                    </div>
            </div>
        </div>
    </div>


