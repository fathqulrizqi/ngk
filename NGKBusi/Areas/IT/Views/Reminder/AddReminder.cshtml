
@section cssHead{
    <link href="https://cdn.jsdelivr.net/npm/gijgo@1.9.14/css/gijgo.min.css" rel="stylesheet" type="text/css" />

    <style>
        .input-group-append {
            cursor: pointer;
        }

        .has-error .select2-selection {
            border-color: #dc3545 !important;
        }



        .card img {
            display: block;
            margin-left: auto;x
            margin-right: auto;
            width: 50%;
        }

        .card-header .customs {
        }

        #txtQuantity-error {
            font-size: 18px;
        }

        .form-switch {
            padding-left: 8.5em;
        }

        .select2-invalid .select2-selection {
            border-color: #dc3545 !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(.375em + .1875rem) center;
            background-size: calc(.75em + .375rem) calc(.75em + .375rem);
        }

        /* Update CSS untuk Select2 Multiple yang Error */
        .select2-invalid .select2-selection--multiple,
        .select2-invalid .select2-selection--single {
            border: 1px solid #dc3545 !important; /* Warna merah bahaya Bootstrap */
        }

        .select2-container .select2-selection--single {
            height: 38px !important;
        }

        .select2-container--default .select2-selection--single {
            border: 1px solid #ccc !important;
            border-radius: 4px !important;
            line-height: 36px;
        }

            .select2-container--default .select2-selection--single .select2-selection__rendered {
                color: #444;
                line-height: 36px;
            }

    </style>
}

<script src="https://cdn.jsdelivr.net/npm/gijgo@1.9.14/js/gijgo.min.js" type="text/javascript"></script>

<script src="@Url.Content("~/Content/bootstrap-table/bootstrap-table.min.js")"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>


<div class="row">
    <div class="col-12">
        @*<div class="card" style="text-align: left; box-shadow: 0 5px 10px rgba(0,0,0,.2);">*@
        @*<div class="card-header bg-primary rounded-top rounded-5" style="text-align: center; color: white; font-weight: bold; font-size: medium; box-shadow: inherit;">
                New Reminder
            </div>*@
        <form method="post" class="row g-3" action="" enctype="multipart/form-data" id="formAddReminder">
            <div class="col-md-12">
                <label for="inputEmail4" class="form-label">Event Reminder Title</label>
                <input type="text" name="ReminderTitle" class="form-control" id="txtTitle" value="">
            </div>
            <div class="col-md-6 mt-2">
                <label for="inputPassword4" class="form-label">Module</label>
                <select class="form-control" name="module" id="selModule">
                    <option value="budget">Budget</option>
                    <option value="license">License</option>
                </select>
            </div>
            <div class="col-md-6 mt-2">
                <label for="inputAddress" class="form-label">Type</label>
                <input type="text" name="Type" class="form-control" id="txtType" value="">
            </div>
            <div class="col-6 mt-2">
                <label for="inputAddress2" class="form-label">Third Party</label>
                <div id="parSelThirdParty">
                    @{

                    }
                    <select class="form-control select2" data-live-search="true" id="selThirdParty" name="ThirdParty" required style="width:100%">
                        @{

                            foreach (var usr in ViewBag.ListVendor)
                            {

                                <option value="@(usr.ACCOUNTNUM)">@(usr.Name)  </option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="col-md-6 mt-2">
                <label for="inputCity" class="form-label">Description</label>
                <input type="text" name="Description" class="form-control" id="txtDescription" value="">
            </div>
            <div class="col-md-12 mt-2">
                <label for="tagsInput" class="form-label">Select Email Recipient</label>
                <select class="form-control selMultiple" name="selReminderUser" id="tagsInput" multiple style="width: 100%;" required>
                    @{

                        foreach (var usr in ViewBag.ListEmail)
                        {

                            <option value="@usr.Email">@usr.Email  </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6 mt-2">
                <label for="inputCity" class="form-label">Attachment</label>
                <input type="file" name="FileAttachment" class="form-control" id="fileAttachment">
            </div>
            <div class="col-md-6 mt-2">
                <label for="inputCity" class="form-label"></label><br />

            </div>
            <div class="col-md-6 mt-2">
                <div class="card">
                    <div class="card-header">
                        <i class="fa-solid fa-clock"></i>
                        Event Due Date
                    </div>
                    <div class="card-body">

                        <div class="col-md-12 mt-2">
                            <div class="form-group row">
                                <label for="inputCity" class="col-sm-4 col-form-label">Due Date</label>
                                <div class="col-sm-8">
                                    <input type="text" name="txtDueDate" class="form-control" id="datepicker" autocomplete="off" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="txtIntervalRepeatReminderNumber" class="col-sm-4 col-form-label">Repeat Event Every </label>
                                <div class="col-sm-2">
                                    <input type="number" name="IntervalRepeatReminderNumber" class="form-control" id="txtIntervalRepeatReminderNumber" placeholder="" min="1" disabled>
                                </div>
                                <div class="col-sm-6">
                                    <select class="form-select" name="IntervalRepetReminderType" id="SelIntervalRepetReminderType" aria-label="Select Time">
                                        <option value="OneTime">Does not repeat </option>
                                        <option value="month">Month</option>
                                        <option value="year">Year</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        @*<div class="alert alert-success" role="alert" id="alertDueDate" style="display:none">
                        <i class="fa fa-info-circle"></i> Repeat event Every <span style="font-weight:bolder" id="txtAlertDueDate"></span>
                    </div>*@
                    </div>
                </div>
            </div>
            <div class="col-md-6 mt-2">
                <div class="card">
                    <div class="card-header">
                        <i class="fa fa-bell"></i> Notification Settings
                    </div>
                    <div class="card-body">
                        <div class="col-md-12 mt-2">
                            <div class="form-group row">
                                <label for="txtNotifStart" class="col-sm-5 col-form-label">Send Notification From</label>
                                <div class="col-sm-2"><input type="number" name="NotifStart" class="form-control" id="txtNotifStart" min="0" placeholder="" value=""></div>
                                <label for="txtNotifStart" class="col-sm-5 col-form-label">Days Before Due Date.</label>

                            </div>
                            <div class="form-group row">
                                <label for="selNotifTime" class="col-sm-5 col-form-label">Sending Time</label>
                                <div class="col-sm-7">
                                    <select class="form-select" name="NotifTime" id="selNotifTime" aria-label="Select Time">
                                        <option value="00">00:00</option>
                                        <option value="01">01:00</option>
                                        <option value="02">02:00</option>
                                        <option value="03">03:00</option>
                                        <option value="04">04:00</option>
                                        <option value="05">05:00</option>
                                        <option value="06">06:00</option>
                                        <option value="07">07:00</option>
                                        <option value="08">08:00</option>
                                        <option value="09">09:00</option>
                                        <option value="10">10:00</option>
                                        <option value="11">11:00</option>
                                        <option value="12">12:00</option>
                                        <option value="13">13:00</option>
                                        <option value="14">14:00</option>
                                        <option value="15">15:00</option>
                                        <option value="16">16:00</option>
                                        <option value="17">17:00</option>
                                        <option value="18">18:00</option>
                                        <option value="19">19:00</option>
                                        <option value="20">20:00</option>
                                        <option value="21">21:00</option>
                                        <option value="22">22:00</option>
                                        <option value="23">23:00</option>
                                        <option value="24">24:00</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="txtIntervalRepeatNotifNumber" class="col-sm-4 col-form-label">Repeat Notification Every</label>
                                <div class="col-sm-2">
                                    <input type="number" name="IntervalRepeatNotifNumber" class="form-control" id="txtIntervalRepeatNotifNumber" value="" placeholder="" min="1" disabled>
                                </div>
                                <div class="col-sm-6">
                                    <select class="form-select" name="IntervalRepeatNotifType" id="selIntervalRepeatNotifType" aria-label="Select Time">
                                        <option value="OneTime">Does not repeat </option>
                                        <option value="hour">Hours</option>
                                        <option value="day">Days</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @*<div class="alert alert-primary" role="alert" id="alertReminderDate" style="display:none">
                <i class="fa fa-info-circle"></i> Your Reminder will be send at <span style="font-weight:bolder" id="txtDateReiminder"></span>
            </div>*@
            <div class="alert alert-primary" role="alert" id="alertReminderDate" style="display:none">
                <i class="fa fa-info-circle"></i>  Reminder will be send at <span style="font-weight:bolder" id="txtDateReiminder"></span>
            </div>
            <hr />
            <div class="col-12">
                <button type="button" class="btn btn-primary" id="btnSave"><i class="fa fa-floppy-disk"></i> | Save</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="fa fa-close"> </i> | Close</button>
            </div>
        </form>
    </div>
</div>

<script>


    $(document).ready(function () {
        var today, datepicker;
        
        today = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate());

        // 1. Inisialisasi datepicker dan simpan ke dalam variabel 'datepicker'
        datepicker = $('#datepicker').datepicker({ uiLibrary: 'bootstrap5', format: 'dd/mm/yyyy', minDate: today });

        // 2. Cek apakah ada tanggal yang dititipkan dari klik kalender Home
        var passedDate = $('#eventDetailModal').data('clickedDate');
        if (passedDate) {
            // Gunakan fungsi bawaan Gijgo Datepicker (.value) untuk mengisi tanggalnya
            datepicker.value(passedDate);

            // Hapus memorinya agar jika user klik tombol "Create Reminder" (bukan klik kalender), tanggal tidak ikut terisi
            $('#eventDetailModal').removeData('clickedDate');
        }
        // -------------------------------

        $('.clockpicker').clockpicker()
            .find('input').change(function () {
                console.log(this.value);
            });

        $("#multiple-select-field").select2({
            theme: "bootstrap-5"
        });

        $('#selThirdParty').select2({

            dropdownParent: $('#eventDetailModal'),
            closeOnSelect: true
        });

        //$('input[name=txtDueDate]').change (function () {
        //    console.log('Text1 changed!');
        //    hitungTanggal();
        //});
        $('#txtNotifStart').change(function () {;
            hitungTanggal();
        });

        //reminder due date
        $('#txtIntervalRepeatReminderNumber').change(function () {
            GetNewDueDate();
        });

        $('#selIntervalRepeatNotifType').on('change', function() {
            if ($(this).val() == "OneTime") {
                $("#txtIntervalRepeatNotifNumber").prop('disabled', true);
            } else {
                $("#txtIntervalRepeatNotifNumber").prop('disabled', false);
            }
        });
        $('#SelIntervalRepetReminderType').on('change', function () {
            if ($(this).val() == "OneTime") {
                $("#txtIntervalRepeatReminderNumber").prop('disabled', true);
            } else {
                $("#txtIntervalRepeatReminderNumber").prop('disabled', false);
            }
        });

        function hitungTanggal() {
            var tanggalStr = $("#datepicker").val();
            var jumlahHari = parseInt($("#txtNotifStart").val()) || 0;

            if (tanggalStr) {
                // Ubah format dari dd/mm/yy ke format yang bisa dikenali moment.js
                var tanggal = moment(tanggalStr, "DD/MM/YYYY");

                if (tanggal.isValid()) {
                    // Kurangi hari
                    var tanggalBaru = tanggal.subtract(jumlahHari, 'days').format("DD/MM/YYYY");
                    $('#alertReminderDate').removeAttr('style');
                    $("#txtDateReiminder").html(tanggalBaru);
                } else {
                    $("#txtDateReiminder").html("Tanggal tidak valid!");
                }
            }
        }

        function GetNewDueDate() {
            var dateStr = $("#datepicker").val();
            var numb = parseInt($("#txtIntervalRepeatReminderNumber").val()) || 0;
            var interval = $('#SelIntervalRepetReminderType').val();

            if (dateStr) {
                // Ubah format dari dd/mm/yy ke format yang bisa dikenali moment.js
                var date = moment(dateStr, "DD/MM/YYYY");

                if (date.isValid()) {
                    // Kurangi hari
                    var newDate = date.add(numb, interval).format("DD/MM/YYYY");
                    $('#alertDueDate').removeAttr('style');
                    $("#txtAlertDueDate").html(newDate);
                } else {
                    $("#txtAlertDueDate").html("Tanggal tidak valid!");
                }
            }
        }

        $('#tagsInput').select2({
            dropdownParent: $('#eventDetailModal'),
            placeholder: "Select Option or Add New",
            tags: true,
            allowClear: true,
            createTag: function (params) {
                return {
                    id: params.term,
                    text: params.term,
                    newOption: true
                }
            },
            templateResult: function (data) {
                var $result = $("<span></span>");
                $result.text(data.text);

                if (data.newOption) {
                    $result.append(" <em>(Add New)</em>");
                }

                return $result;
            }
        });
        $('#selModule').on('change', function () {
            var module = this.value;
            if (module == "permit") {
                $("#txtThirdParty").show();
                $('#parSelThirdParty').hide();
                /*$("#selThirdParty").next(".select2-container").hide();*/
            } else {
                $("#txtThirdParty").hide();
                $('#parSelThirdParty').show();
            };
        });

        // Handle button click to show selected values
        $('#showValues').on('click', function () {
            var selectedValues = $('#tagsInput').val(); // Get selected values as an array
            if (selectedValues.length > 0) {
                alert("Nilai yang dipilih: " + selectedValues.join("+ "));
            } else {
                alert("Tidak ada nilai yang dipilih.");
            }
        });
        $('#btnSave').click(function (e) {
            e.preventDefault();

            // 1. Bersihkan semua peringatan error sebelumnya (reset form)
            $('.is-invalid').removeClass('is-invalid');
            $('.select2-invalid').removeClass('select2-invalid');

            let isValid = true;

            // 2. Daftar ID input text biasa yang wajib diisi 
            // (Note: File Attachment biasanya opsional, jika wajib tambahkan '#fileAttachment' ke dalam array ini)
            let requiredInputs = ['#txtTitle', '#txtType', '#txtDescription', '#datepicker', '#txtNotifStart'];

            requiredInputs.forEach(function (id) {
                let value = $(id).val();
                if (!value || value.trim() === "") {
                    $(id).addClass('is-invalid'); // Beri border merah
                    isValid = false;
                }
            });

            // 3. Validasi Select Email Recipient (Tags Input)
            let recipients = $('#tagsInput').val();

            // Hapus pesan error sebelumnya (jika ada) saat tombol save diklik ulang
            $('#error-tagsInput').remove();

            if (!recipients || recipients.length === 0) {
                // Beri border merah
                $('#tagsInput').next('.select2-container').addClass('select2-invalid');
                // Munculkan teks informasi di bawah kotak input
                $('#tagsInput').next('.select2-container').after('<div id="error-tagsInput" style="color: #dc3545; font-size: 87.5%; margin-top: .25rem; font-weight: 500;"><i class="fa fa-exclamation-triangle"></i> Minimal pilih 1 email penerima.</div>');

                isValid = false;
            }

            // 4. Validasi Third Party (Hanya jika module BUKAN permit)
            if ($('#selModule').val() !== "permit") {
                let thirdParty = $('#selThirdParty').val();
                if (!thirdParty || thirdParty === "") {
                    $('#selThirdParty').next('.select2-container').addClass('select2-invalid');
                    isValid = false;
                }
            }

            // 5. Validasi angka interval/pengulangan (Hanya dicek jika user memilih selain "Does not repeat")
            if ($('#SelIntervalRepetReminderType').val() !== "OneTime" && !$('#txtIntervalRepeatReminderNumber').val()) {
                $('#txtIntervalRepeatReminderNumber').addClass('is-invalid');
                isValid = false;
            }
            if ($('#selIntervalRepeatNotifType').val() !== "OneTime" && !$('#txtIntervalRepeatNotifNumber').val()) {
                $('#txtIntervalRepeatNotifNumber').addClass('is-invalid');
                isValid = false;
            }

            // ==========================================================
            // JIKA ADA YANG KOSONG: Tampilkan SweetAlert & Hentikan Proses
            // ==========================================================
            if (!isValid) {
                swal({
                    title: "Data Belum Lengkap!",
                    text: "Harap periksa kembali dan lengkapi kolom yang ditandai dengan warna merah.",
                    type: "warning",
                    confirmButtonText: "Baik, Mengerti"
                });
                return false; // Hentikan eksekusi AJAX
            }

            // ==========================================================
            // JIKA SEMUA VALID: Lanjutkan Proses AJAX ke Server
            // ==========================================================

            var formData = new FormData($("#formAddReminder")[0]);
            var redirectUrl = "@Url.Action("Home", "Reminder", new { area = "IT" })";
            console.log(formData);
            $.ajax({
                type: 'POST',
                url: "@Url.Action("AddReminder", "Reminder", new { area = "IT" })",
                data: formData,
                cache: false,
                contentType: false,
                processData: false,
                beforeSend: function () {
                    var $btn = $('#btnSave');
                    $btn.prop('disabled', true); // Menonaktifkan tombol setelah diklik
                    $btn.html(
                        '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Please Wait ...'
                    );
                },
                success: function (json) {
                    var $btn = $('#btnSave');
                    if (json.status == 1) {
                        $btn.prop('disabled', false);
                        swal({
                            title: "Good job",
                            text: json.msg,
                            type: "success"
                        },
                            function () {
                                location.href = redirectUrl;
                            }
                        );
                    } else {
                        swal("Error", json.msg, "error");
                        $btn.prop('disabled', false);
                        $btn.html(
                            '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> <i class="fa fa-floppy-disk"></i> | Save'
                        );
                    }

                },
                error: function (data) {
                    var $btn = $('#btnSave');
                    $btn.prop('disabled', false);
                },
                complete: function (data) {
                    var $btn = $('#btnSave');
                    $btn.prop('disabled', false);
                    $btn.html(
                        '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> <i class="fa fa-floppy-disk"></i> | Save'
                    );
                }
            });
        });

    });
</script>