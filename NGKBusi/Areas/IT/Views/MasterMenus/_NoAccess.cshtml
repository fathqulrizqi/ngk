@{
    ViewBag.Title = "No Access";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.NavHide = false;
    bool isLogin = (System.Web.HttpContext.Current.User != null) && System.Web.HttpContext.Current.User.Identity.IsAuthenticated;
}

@section scriptHead {
    <script src="https://cdn.tailwindcss.com"></script>
}

<div class="w-full py-4 bg-white inline-flex flex-col justify-center items-center gap-2.5 overflow-hidden">
    <div class="self-stretch py-6 flex flex-col justify-center items-center gap-2.5">
        <img class="w-96 h-80" src="@Url.Content("~/Content/Images/no-access.png")" />
    </div>
    <div class="self-stretch flex flex-col justify-start items-center gap-8">
        <div class="self-stretch flex flex-col justify-start items-center gap-4">
            <div class="justify-start text-red-500 text-3xl font-bold font-bold">Access Denied!</div>
            <div class="justify-start text-black text-xl font-bold font-normal">Oops... You don’t have access to this page!</div>
            @if (isLogin)
            {
                <div class="justify-start text-black text-lg font-normal">
                    Your department: @ViewBag.DeptName
                </div>
            }
            else
            {
                <a href="@Url.Content("~/User/Login")"
                   class="px-6 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition">
                    Go to Login
                </a>

            }

        </div>

    </div>
</div>