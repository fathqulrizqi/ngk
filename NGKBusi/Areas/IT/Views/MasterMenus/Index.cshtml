<script>
    var menuFormValidate = $("#addMenuForm").validate({
        rules: {
            menuName: {
                required: true
            },
            menuRedirect: {
                required: function (element) {
                    return $('input[name="linkType"]:checked').val() === "redirect";
                },
                url: true
            }
        },
        messages: {
            menuName: {
                required: "Menu name is required."
            },
            menuRedirect: {
                required: "Redirect URL is required.",
                url: "Please enter a valid URL."
            }
        },
        errorElement: 'div',
        errorPlacement: function (error, element) {
            // Menempatkan pesan error di dalam parent div
            // Ini akan bekerja untuk input dan select
            error.addClass('text-red-500 text-xs mt-1');
            element.closest('div').append(error);
        },
        highlight: function (element) {
            // Menambahkan kelas is-invalid untuk elemen yang error
            $(element).addClass('is-invalid');
        },
        unhighlight: function (element) {
            // Menghapus kelas is-invalid jika elemen sudah valid
            $(element).removeClass('is-invalid');
        },
        // ignore: ":hidden" // Ini untuk memastikan field hidden tidak divalidasi
    });

    var addRoleFormValidate = $("#addRoleForm").validate({
        rules: {
            // Aturan validasi untuk select User NIK
            userNik: { required: true },
            // Aturan validasi untuk select User Role
            roleID: { required: true }
        },
        messages: {
            userNik: { required: "Please select a user." },
            roleID: { required: "Please select a role." }
        },
        errorElement: 'div',
        errorPlacement: function (error, element) {
            error.addClass('invalid-feedback');
            // Logika untuk menempatkan pesan error di bawah Select2
            if (element.hasClass('select2-hidden-accessible')) {
                element.next('.select2-container').after(error);
            } else {
                error.insertAfter(element);
            }
        },
        highlight: function (element) {
            $(element).addClass('is-invalid');
            // Tambahkan kelas is-invalid ke container Select2
            if ($(element).hasClass('select2-hidden-accessible')) {
                $(element).next('.select2-container').find('.select2-selection--single').addClass('is-invalid');
            }
        },
        unhighlight: function (element) {
            $(element).removeClass('is-invalid');
            // Hapus kelas is-invalid dari container Select2
            if ($(element).hasClass('select2-hidden-accessible')) {
                $(element).next('.select2-container').find('.select2-selection--single').removeClass('is-invalid');
            }
        }
    });
</script>