                        $(this).addClass('border-red-500');
                    } else {
                        $(this).removeClass('border-red-500');
                    }
                });
                $("#menuController").on('blur', function () {
                    const linkType = $("input[name='linkType']:checked").val();
                    if (linkType === "controller" && !$(this).val().trim()) {
                        $(this).addClass('border-red-500');
                    } else {
                        $(this).removeClass('border-red-500');
                    }
                });
                $("#menuAction").on('blur', function () {
                    const linkType = $("input[name='linkType']:checked").val();
                    if (linkType === "controller" && !$(this).val().trim()) {
                        $(this).addClass('border-red-500');
                    } else {
                        $(this).removeClass('border-red-500');
                    }
                });
                $("#menuRedirect").on('blur', function () {
                    const linkType = $("input[name='linkType']:checked").val();
                    if (linkType === "redirect" && !$(this).val().trim()) {
                        $(this).addClass('border-red-500');
                    } else {
                        $(this).removeClass('border-red-500');
                    }
                });
                $('input[name="linkType"]').on('change', function () {
                    $('.border-red-500').removeClass('border-red-500');
                });
            });

            // Save order button
            $('#saveOrderBtn').on('click', function () {
                const $button = $(this);
                const originalText = $button.text();
                $button.prop('disabled', true).text('Saving...');
                try {
                    const rootContainer = document.getElementById('sortable-root');
                    if (!rootContainer) {
                        Swal.fire('Error', 'Menu container not found', 'error');
                        $button.prop('disabled', false).text(originalText);
                        return;
                    }
                    const menuData = collectMenuData(rootContainer);
                    if (menuData.length === 0) {
                        Swal.fire('Warning', 'No menu data to save', 'warning');
                        $button.prop('disabled', false).text(originalText);
                        return;
                    }
                    $.ajax({
                        url: '@Url.Action("SaveOrder", "MasterMenus", new { area = "IT" })',
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify({ items: menuData }),
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Success', response.message, 'success');
                                disableSortable();
                                $('#sortOrderBtn').text('Sort Order').removeClass('bg-red-600 hover:bg-red-700').addClass('bg-blue-600 hover:bg-blue-700');
                                $('#saveOrderBtn').addClass('hidden');
                                $('#dragState').addClass('hidden');
                                setTimeout(() => {
                                    loadMenusAndDropdown();
                                }, 1000);
                            } else {
                                Swal.fire('Error', response.message || 'Failed to save menu order', 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error('Save error:', xhr.responseText);
                            Swal.fire('Error', 'Failed to save menu order: ' + error, 'error');
                        },
                        complete: function () {
                            $button.prop('disabled', false).text(originalText);
                        }
                    });
                } catch (error) {
                    console.error('Error collecting menu data:', error);
                    Swal.fire('Error', 'Error processing menu data', 'error');
                    $button.prop('disabled', false).text(originalText);
                }
            });

            // Initial state setup
            $('#saveOrderBtn').addClass('hidden');
            $('#dragState').addClass('hidden');
            loadMenusAndDropdown();
        });
    </script>
}

