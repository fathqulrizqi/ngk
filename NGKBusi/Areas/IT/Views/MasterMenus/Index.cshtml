            function loadMenusAndDropdown() {
                $.ajax({
                    url: '@Url.Action("GetMenus", "MasterMenus")',
                    type: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        try {
                            const rootList = $('#sortable-root');
                            rootList.empty();
                            renderMenus(data, rootList);
                            setupToggleHandlers();
                            const parentSelect = $('#parentMenuId');
                            parentSelect.find('option:not(:first)').remove();
                            updateParentDropdown(data, parentSelect);
                        } catch (e) {
                            console.error('Error processing menu data:', e);
                        }
                    },
                    error: function (error) {
                        console.log('Error fetching menu data:', error);
                    }
                });
            }

            function collectMenuData(container, parentId = null) {
                const items = [];
                try {
                    const directChildren = $(container).children('.sortable-item');
                    directChildren.each(function (index) {
                        const $item = $(this);
                        const $card = $item.find('> .item-card');
                        const menuId = parseInt($card.attr('data-id'));
                        if (isNaN(menuId)) {
                            console.warn('Invalid menu ID found:', $card.attr('data-id'));
                            return;
                        }
                        const $nestedList = $item.find('> .sortable-list');
                        const itemData = {
                            Id: menuId,
                            ParentId: parentId,
                            Order: index + 1
                        };
                        items.push(itemData);
                        if ($nestedList.length > 0 && $nestedList.children('.sortable-item').length > 0) {
                            const childItems = collectMenuData($nestedList[0], menuId);
                            items.push(...childItems);
                        }
                    });
                } catch (e) {
                    console.error('Error in collectMenuData:', e);
                }
                return items;
            }

            // Function to populate form for edit mode
            window.populateEditForm = function (menuData) {
                // Isi field input dan select
                $('#menuId').val(menuData.Id);
                $('#menuName').val(menuData.Title);
                $('#menuIcon').val(menuData.Icon);
                $('#parentMenuId').val(menuData.ParentId);

                // Atur jenis tautan (Controller atau Redirect)
                if (menuData.Redirect) {
                    $('input[name="linkType"][value="redirect"]').prop('checked', true);
                    $('#controllerFields').hide();
                    $('#redirectFields').show();
                    $('#menuRedirect').val(menuData.Redirect);
                } else {
                    $('input[name="linkType"][value="controller"]').prop('checked', true);
                    $('#controllerFields').show();
                    $('#redirectFields').hide();
                    $('#menuController').val(menuData.Controller);
                    $('#menuAction').val(menuData.Action);
                    $('#menuArea').val(menuData.Area);
                }

                // =========================================================
                // BARIS BARU: Mengatur status checkbox berdasarkan data server
                // =========================================================
                $("#isActive").prop("checked", menuData.IsActive);
                $("#isGlobal").prop("checked", menuData.IsGlobal);
                $("#isShow").prop("checked", menuData.IsShow);

                // Perbarui judul modal dan tombol
                $('#modalTitle').html('<i class="fas fa-edit mr-2"></i>Edit Menu');
                $('#saveButtonText').text('Update Menu');
                $('#deleteMenuBtn').removeClass('hidden');
            };

            // Function to reset form for create mode
            window.resetCreateForm = function () {
                $('#addMenuForm')[0].reset();
                $('#menuId').val('');
                $('input[name="linkType"][value="controller"]').prop('checked', true);
                $('#controllerFields').show();
                $('#redirectFields').hide();
                $('#modalTitle').html('<i class="fas fa-plus-circle mr-2"></i>Add New Menu');
                $('#saveButtonText').text('Save Menu');
                $('#deleteMenuBtn').addClass('hidden'); // Sembunyikan tombol delete
            };

            // SORT ORDER BUTTON FUNCTIONALITY
            $('#sortOrderBtn').on('click', function () {
                try {
                    if ($('#sortable-root').hasClass('sortable-enabled')) {
                        disableSortable();
                        $(this).text('Sort Order').removeClass('bg-red-600 hover:bg-red-700').addClass('bg-blue-600 hover:bg-blue-700');
                        $('#saveOrderBtn').addClass('hidden');
                        $('#dragState').addClass('hidden');
                    } else {
                        enableSortable();
                        $(this).text('Cancel Sort').removeClass('bg-blue-600 hover:bg-blue-700').addClass('bg-red-600 hover:bg-red-700');
                        $('#saveOrderBtn').removeClass('hidden');
                        $('#dragState').removeClass('hidden');
                    }
                } catch (e) {
                    console.error('Error in sortOrderBtn click:', e);
                }
            });

            // MODAL AND FORM LOGIC
            // Handle link type change
            $('input[name="linkType"]').on('change', function () {
                if ($(this).val() === "controller") {
                    $("#controllerFields").show();
                    $("#redirectFields").hide();
                } else {
                    $("#controllerFields").hide();
                    $("#redirectFields").show();
                }
            });

            // Handle create menu button click
            $('#createMenuBtn').on('click', function () {
                window.resetCreateForm();
                $('#menuModal').modal('show');
            });

            // Handle item-card click for editing
            $(document).on('click', '.sortable-item > .item-card', function (e) {
                e.stopPropagation();
                // Check if sorting is enabled. If not, open the modal.
                if (!$('#sortable-root').hasClass('sortable-enabled')) {
                    const menuId = $(this).attr('data-id');
                    if (menuId) {
                        $.ajax({
                            url: '@Url.Action("GetMenuById", "MasterMenus", new { area = "IT" })',
                            type: 'GET',
                            data: { id: menuId },
                            success: function (menuData) {
                                window.populateEditForm(menuData);
                                $('#menuModal').modal('show');
                            },
                            error: function () {
                                Swal.fire('Error', 'Failed to load menu data', 'error');
                            }
                        });
                    }
                }
            });

           $('#saveMenuBtn').on('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        // Jalankan validasi menggunakan jQuery Validate
        // .form() akan mengembalikan true jika valid
        if (!menuFormValidate.form()) {
            return;
        }

        const isEdit = $('#menuId').val() !== '' && $('#menuId').val() !== '0';
        const $button = $(this);
        const originalText = $button.html();
        $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i>Saving...');

        const linkType = $("input[name='linkType']:checked").val();
        let data = {
            id: $('#menuId').val() || 0,
            name: $("#menuName").val(),
            parentID: $("#parentMenuId").val() || null,
            icon: $("#menuIcon").val(),
            controller: linkType === "controller" ? $("#menuController").val() : null,
            action: linkType === "controller" ? $("#menuAction").val() : null,
            area: linkType === "controller" ? $("#menuArea").val() : null,
            redirect: linkType === "redirect" ? $("#menuRedirect").val() : null,
            isActive: $("#isActive").prop("checked"),
            isGlobal: $("#isGlobal").prop("checked"),
            isShow: $("#isShow").prop("checked"),
        };

        if (isEdit) {
            data.UpdatedBy = '@ViewBag.UserNik';
        } else {
            data.CreatedBy = '@ViewBag.UserNik';
        }

        const url = isEdit
            ? '@Url.Action("UpdateMenu", "MasterMenus", new { area = "IT" })'
            : '@Url.Action("SaveMenu", "MasterMenus", new { area = "IT" })';

        $.ajax({
            url: url,
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(data),
            success: function (res) {
                if (res.success) {
                    Swal.fire({
                        title: "Success!",
                        text: isEdit ? "Menu has been updated!" : "Menu has been added!",
                        icon: "success",
                        timer: 2000,
                        showConfirmButton: false
                    });
                    $('#menuModal').modal('hide');
                    loadMenusAndDropdown();
                    location.reload();
                } else {
                    Swal.fire("Error", res.message || "Failed to save", "error");
                }
            },
            error: function (xhr) {
                Swal.fire("Error", "Something went wrong!", "error");
                console.log(xhr.responseText);
            },
            complete: function () {
                $button.prop('disabled', false).html(originalText);
            }
        });
    });


            $('#menuModal').on('hidden.bs.modal', function () {
                menuFormValidate.resetForm();
                $('#addMenuForm')[0].reset();
                // Pastikan kelas is-invalid juga di-reset
                $("#addMenuForm .input-style, #addMenuForm select").removeClass("is-invalid");
            });

            // FUNGSI BARU UNTUK DELETE MENU
            $('#deleteMenuBtn').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                const menuId = $('#menuId').val();
                if (!menuId || menuId === '0') {
                    Swal.fire('Error', 'Invalid menu ID to delete.', 'error');
                    return;
                }
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const $button = $(this);
                        const originalText = $button.html();
                        $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i>Deleting...');

                        $.ajax({
                            url: '@Url.Action("DeleteMenu", "MasterMenus", new { area = "IT" })',
