$(document).on('click', '#saveNewUserBtn', function (e) {
    e.preventDefault();

    // Panggil validasi form
    if (!$("#addRoleForm").valid()) {
        return;
    }

    const menuId = $('#addRoleMenuId').val();
    const userNik = $('#addRoleUserNIK').val().trim();
    const selectedRoleIds = $('#addRoleUser').val();

    if (!userNik || userNik.length === 0) {
        Swal.fire('Error', 'Please select user.', 'error');
        return;
    }
    // Cek apakah ada role yang dipilih
    if (!selectedRoleIds || selectedRoleIds.length === 0) {
        Swal.fire('Error', 'Please select at least one role.', 'error');
        return;
    }

    // Perbaikan: gunakan selector yang lebih spesifik untuk checkbox
    const allowInsert = $('#addRoleForm input[name="allowInsert"]').is(':checked');
    const allowView = $('#addRoleForm input[name="allowView"]').is(':checked');
    const allowUpdate = $('#addRoleForm input[name="allowUpdate"]').is(':checked');
    const allowDelete = $('#addRoleForm input[name="allowDelete"]').is(':checked');

    // Debug: log nilai checkbox
    console.log('Checkbox values:', {
        allowInsert: allowInsert,
        allowUpdate: allowUpdate,
        allowDelete: allowDelete,
        allowView: allowView
    });

    const $button = $(this);
    const originalText = $button.html();
    $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i>Adding...');

    const roleIds = selectedRoleIds.join(",");

    $.ajax({
        url: '@Url.Action("AddUserRole", "MasterMenus", new { area = "IT" })',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            menuId: menuId,
            userNik: userNik,
            roleIds: roleIds,
            allowInsert: allowInsert,
            allowUpdate: allowUpdate,
            allowDelete: allowDelete,
            allowView: allowView
        }),
        success: function (res) {
            if (res.success) {
                Swal.fire('Success!', 'User permissions added successfully.', 'success');
                loadMenuRoles(menuId);
                $('#addRoleForm')[0].reset();
                $('#addRoleUserNIK').val(null).trigger('change');
                $('#addRoleUser').val(null).trigger('change');
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        },
        error: function (xhr, status, error) {
            console.error('AJAX Error:', xhr.responseText);
            Swal.fire('Error', 'Failed to add user permissions.', 'error');
        },
        complete: function () {
            $button.prop('disabled', false).html(originalText);
        }
    });
});

