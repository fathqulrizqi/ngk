        // Handler untuk tombol "Save" di mode edit
$(document).on('click', '.save-user-role-btn', function () {
    const $row = $(this).closest('tr');
    const nik = $row.data('nik');
    const menuId = $row.data('menu-id');
    const roleIds = ($row.find('.user-role-select').val() || []).join(',');
    const allowInsert = $row.find('input[name="allowInsert"]').is(':checked');
    const allowUpdate = $row.find('input[name="allowUpdate"]').is(':checked');
    const allowDelete = $row.find('input[name="allowDelete"]').is(':checked');
    const allowView = $row.find('input[name="allowView"]').is(':checked');

    if (isNaN(menuId) || menuId === 0) {
        Swal.fire('Error', 'Invalid Menu ID. Cannot save.', 'error');
        return;
    }

    // Tampilkan loading state pada tombol
    const $button = $(this);
    const originalText = $button.html();
    $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i>Saving...');

    // Lakukan AJAX call untuk menyimpan perubahan
    $.ajax({
        url: '@Url.Action("UpdateUserRole", "MasterMenus", new { area = "IT" })',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            menuId: menuId,
            userNik: nik,
            roleIds: roleIds,
            allowInsert: allowInsert,
            allowUpdate: allowUpdate,
            allowDelete: allowDelete,
            allowView: allowView
        }),
        success: function (res) {
            if (res.success) {
                Swal.fire('Success!', 'User permission updated successfully.', 'success')
                    .then(() => {
                        loadMenuRoles(menuId); // reload modal setelah user klik OK
                    });
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        },
        error: function() {
            Swal.fire('Error', 'Failed to update user permission.', 'error');
        },
        complete: function() {
            $button.prop('disabled', false).html(originalText);
        }
    });
});

    // Handler untuk tombol "Delete"
$(document).on('click', '.delete-user-role-btn', function () {
    const $row = $(this).closest('tr');
    const userNik = $row.data('nik');
    const menuIdStr = $row.data('menu-id');
    const menuId = parseInt(menuIdStr, 10);

    if (isNaN(menuId) || menuId === 0) {
        Swal.fire('Error', 'Invalid Menu ID. Cannot delete.', 'error');
        return;
    }

    // Konfirmasi dulu
    Swal.fire({
        title: 'Are you sure?',
        text: `Delete role for user ${userNik}?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Yes, delete it!'
    }).then((result) => {
        if (result.isConfirmed) {

            // Tampilkan loading state
            const $button = $row.find('.delete-user-role-btn');
            const originalText = $button.html();
            $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i>Deleting...');

            // AJAX call untuk delete
            $.ajax({
                url: '@Url.Action("DeleteUserRole", "MasterMenus", new { area = "IT" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    menuId: menuId,
                    userNik: userNik
                }),
                success: function (res) {
                    if (res.success) {
                        Swal.fire('Deleted!', 'User role has been removed.', 'success')
                            .then(() => {
                                loadMenuRoles(menuId); // refresh modal
                            });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Failed to delete user role.', 'error');
                },
                complete: function () {
                    $button.prop('disabled', false).html(originalText);
                }
            });
        }
    });
});


    function loadMenuRoles(menuId) {
