                                } else {
                                    Swal.fire('Error', res.message || 'Failed to delete menu', 'error');
                                }
                            },
                            error: function (xhr) {
                                Swal.fire('Error', 'Something went wrong!', 'error');
                                console.log(xhr.responseText);
                            },
                            complete: function () {
                                $button.prop('disabled', false).html(originalText);
                            }
                        });
                    }
                });
            });


            // Fungsi validasi form dengan SweetAlert
            function validateMenuForm() {
                // Clear previous errors
                $('.input-style').removeClass('border-red-500');

                // Validasi Menu Name (wajib)
                if (!$("#menuName").val().trim()) {
                    Swal.fire({
                        title: "Validation Error",
                        text: "Menu Name is required!",
                        icon: "warning",
                        confirmButtonText: "OK"
                    });
                    $("#menuName").focus().addClass('border-red-500');
                    return false;
                }

                // Validasi Parent Menu ID (boleh null, tidak perlu validasi)
                // Validasi Icon (tidak wajib)

                // Cek link type yang dipilih
                const linkType = $("input[name='linkType']:checked").val();

                if (!linkType) {
                    Swal.fire({
                        title: "Validation Error",
                        text: "Please select Link Type (Controller or Redirect)!",
                        icon: "warning",
                        confirmButtonText: "OK"
                    });
                    return false;
                }

                // Validasi berdasarkan link type
                if (linkType === "controller") {
                    // Validasi Controller (wajib jika link type = controller)
                    if (!$("#menuController").val().trim()) {
                        Swal.fire({
                            title: "Validation Error",
                            text: "Controller is required when Link Type is Controller!",
                            icon: "warning",
                            confirmButtonText: "OK"
                        });
