                    // redirect harus null
                } else if (linkType === "redirect") {
                    // Validasi Redirect URL (wajib jika link type = redirect)
                    if (!$("#menuRedirect").val().trim()) {
                        Swal.fire({
                            title: "Validation Error",
                            text: "Redirect URL is required when Link Type is Redirect!",
                            icon: "warning",
                            confirmButtonText: "OK"
                        });
                        $("#menuRedirect").focus().addClass('border-red-500');
                        return false;
                    }

                    // Validasi format URL (opsional, tapi bagus untuk UX)
                    const redirectUrl = $("#menuRedirect").val().trim();
                    const urlPattern = /^(https?:\/\/)?([\da-z\.-]+)\.([a-z\.]{2,6})([\/\w \.-]*)*\/?$|^\/[\w\/-]*$/;

                    if (!urlPattern.test(redirectUrl)) {
                        Swal.fire({
                            title: "Validation Error",
                            text: "Please enter a valid URL format for Redirect!",
                            icon: "warning",
                            confirmButtonText: "OK"
                        });
                        $("#menuRedirect").focus().addClass('border-red-500');
                        return false;
                    }
                    // controller, action, area harus null
                }

                // Jika semua validasi lolos
                return true;
