﻿@{
    ViewBag.Title = "Tambah Pengajuan IT Disposal";
}

@section scriptHead {
    <script>
        var index = 1;

        // Tombol Tambah Baris
        $(document).on("click", "#btnTambahBaris", function () {
            var barisBaru = `
                <tr class="baris-aset">
                    <td><input type="text" name="Details[${index}].Items" class="form-control" required /></td>
                    <td><input type="number" name="Details[${index}].Quantity" class="form-control" value="1" required /></td>
                    <td><input type="text" name="Details[${index}].Unit" class="form-control" required /></td>
                    <td><input type="text" name="Details[${index}].AssetNo" class="form-control" required /></td>
                    <td>
                        <select name="Details[${index}].Type" class="form-control">
                            <option value="Laptop">Laptop</option>
                            <option value="PC">PC</option>
                            <option value="Server">Server</option>
                            <option value="Storage">Storage</option>
                        </select>
                    </td>
                    <td><input type="text" name="Details[${index}].Condition" class="form-control" required /></td>
                    <td>
                        <select name="Details[${index}].Actions" class="form-control">
                            <option value="Auctioned">Auctioned</option>
                            <option value="Donated">Donated</option>
                            <option value="Destroyed">Destroyed</option>
                        </select>
                    </td>
                    <td>
                        <select name="Details[${index}].Confidentiality" class="form-control">
                            <option value="Public">Public</option>
                            <option value="Internal">Internal</option>
                            <option value="Confidential">Confidential</option>
                        </select>
                    </td>
                    <td class="text-center"><button type="button" class="btn btn-danger btn-sm btn-hapus">Del</button></td>
                </tr>`;

            $("#tabelDetail tbody").append(barisBaru);
            index++;
        });

        // Tombol Hapus Baris
        $(document).on("click", ".btn-hapus", function () {
            var row = $(this).closest("tr");

            if ($("#tabelDetail tbody tr").length <= 1) {
                Swal.fire("Perhatian", "Minimal harus ada 1 baris item pengajuan.", "warning");
                return;
            }

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    row.remove();
                }
            });
        });

        $(document).off("click", "#btnSubmit");

        $(document).on("click", "#btnSubmit", function (e) {
            e.preventDefault();

            var allDetails = [];
            var deptValue = $("#department").val();
            var isValid = true;

            // Kumpulkan data dari setiap baris tabel
            $("#tabelDetail tbody tr").each(function () {
                var rowData = {
                    items: $(this).find('input[name*="Items"]').val(),
                    quantity: $(this).find('input[name*="Quantity"]').val(),
                    unit: $(this).find('input[name*="Unit"]').val(),
                    asset_no: $(this).find('input[name*="AssetNo"]').val(),
                    type: $(this).find('select[name*="Type"]').val(),
                    condition: $(this).find('input[name*="Condition"]').val(),
                    actions: $(this).find('select[name*="Actions"]').val(),
                    confidentiality: $(this).find('select[name*="Confidentiality"]').val(),
                    department: deptValue,
                    status: "Pending" // Agar langsung mentrigger email terkirim di controller Anda
                };

                if (!rowData.items || !rowData.quantity || !rowData.unit || !rowData.asset_no || !rowData.type || !rowData.condition || !rowData.actions || !rowData.confidentiality) {
                    isValid = false;
                }

                allDetails.push(rowData);
            });

            if (allDetails.length === 0) {
                Swal.fire({ icon: "warning", title: "Barang harus diisi minimal 1 item", timer: 1500, showConfirmButton: false });
                return;
            }

            if (!isValid) {
                Swal.fire({ icon: "warning", title: "Semua data barang wajib diisi", timer: 1500, showConfirmButton: false });
                return;
            }

            submitDataToServer(allDetails);
        });

        // Fungsi Rekursif AJAX berurutan baris per baris
        function submitDataToServer(allDetails) {
            var headerId = "";

            Swal.fire({
                title: "Sedang memproses...",
                text: "Mohon tunggu sebentar.",
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            function saveNext(i) {
                if (i >= allDetails.length) {
                    // SELESAI SIMPAN SEMUA BARIS -> SEKARANG KIRIM EMAIL HANYA 1 KALI
                    $.ajax({
                        url: '@Url.Action("SendEmailNotification","ITDisposal", new { area="IT"})',
                        type: "POST",
                        data: { header_id: headerId },
                        success: function (emailResponse) {
                            // Munculkan sukses lalu redirect
                            Swal.fire({
                                icon: "success",
                                title: "Success",
                                text: "Data saved and email sent successfully.",
                                timer: 1500,
                                showConfirmButton: false
                            }).then(function () {
                                window.location.href = '@Url.Action("Details","ITDisposal", new { area="IT"})?id=' + headerId;
                            });
                        },
                        error: function () {
                            // Walaupun email gagal, data sudah tersimpan, tetap arahkan ke halaman detail
                            window.location.href = '@Url.Action("Details","ITDisposal", new { area="IT"})?id=' + headerId;
                        }
                    });
                    return;
                }

                var rowData = allDetails[i];
                rowData.header_id = headerId; // Baris pertama kosong, baris selanjutnya membawa header_id yang sama

                $.ajax({
                    url: '@Url.Action("SaveDisposal","ITDisposal", new { area="IT"})',
                    type: "POST",
                    data: rowData,
                    success: function (response) {
                        if (response.success) {
                            headerId = response.id; // Tangkap/perbarui header_id untuk baris berikutnya
                            saveNext(i + 1); // Lanjut ke baris berikutnya
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: response.message || "Gagal menyimpan data."
                            });
                        }
                    },
                    error: function (xhr) {
                        Swal.fire("Error", "Failed to connect to server. Status: " + xhr.status, "error");
                    }
                });
            }

            // Mulai proses dari indeks ke-0
            saveNext(0);
        }
    </script>
}

<div class="container-fluid mt-4">
    <!-- Judul Halaman -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Buat Pengajuan Baru IT Disposal</h4>
        <a href="@Url.Action("Index", "ITDisposal", new { area = "IT" })" class="btn btn-secondary btn-sm">← Kembali ke List</a>
    </div>

    <!-- Informasi Utama -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="fas fa-info-circle"></i> Informasi Utama</h5>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label>Department Pengaju</label>
                <input id="department" type="text" class="form-control" name="username" value="@ViewBag.department" readonly>
            </div>
        </div>
    </div>

    <!-- List Item Disposal -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-list"></i> List Item Disposal</h5>
            <button type="button" id="btnTambahBaris" class="btn btn-success btn-sm">+ Tambah Baris</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0" id="tabelDetail">
                    <thead class="bg-light text-center">
                        <tr>
                            <th>Items</th>
                            <th>Qty</th>
                            <th>Unit</th>
                            <th>Asset No</th>
                            <th>Type</th>
                            <th>Condition</th>
                            <th>Actions</th>
                            <th>Confidentiality</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Baris pertama (index 0) -->
                        <tr class="baris-aset">
                            <td><input type="text" name="Details[0].Items" class="form-control" value="" required /></td>
                            <td><input type="number" name="Details[0].Quantity" class="form-control" value="1" required /></td>
                            <td><input type="text" name="Details[0].Unit" class="form-control" required /></td>
                            <td><input type="text" name="Details[0].AssetNo" class="form-control" required /></td>
                            <td>
                                <select name="Details[0].Type" class="form-control">
                                    <option value="Laptop">Laptop</option>
                                    <option value="PC">PC</option>
                                    <option value="Server">Server</option>
                                    <option value="Storage">Storage</option>
                                </select>
                            </td>
                            <td><input type="text" name="Details[0].Condition" class="form-control" required /></td>
                            <td>
                                <select name="Details[0].Actions" class="form-control">
                                    <option value="Auctioned">Auctioned</option>
                                    <option value="Donated">Donated</option>
                                    <option value="Destroyed">Destroyed</option>
                                </select>
                            </td>
                            <td>
                                <select name="Details[0].Confidentiality" class="form-control">
                                    <option value="Public">Public</option>
                                    <option value="Internal">Internal</option>
                                    <option value="Confidential">Confidential</option>
                                </select>
                            </td>
                            <td class="text-center"><button type="button" class="btn btn-danger btn-sm btn-hapus">Del</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-right">
            <button id="btnSubmit" type="submit" class="btn btn-danger font-weight-bold px-4">
                <i class="fas fa-save"></i> Simpan & Kirim Pengajuan
            </button>
        </div>
    </div>
</div>