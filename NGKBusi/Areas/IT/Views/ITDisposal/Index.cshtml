@{
    ViewBag.Title = "List Pengajuan IT Disposal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Tambahkan CSS DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<!-- Tambahkan CSS SweetAlert2 -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

<div class="container-fluid mt-4">
    <div class="card shadow-sm">

        <!-- Pindahkan judul dan tombol ke dalam card-header agar masuk kotak -->
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0 text-dark"><strong>List Pengajuan IT Disposal</strong></h4>

            <!-- Tombol Buat Pengajuan Baru (Awalnya disembunyikan, dimunculkan via JS jika canCreate = true) -->
            <a href="@Url.Action("Create", "ITDisposal", new { area = "IT" })" class="btn btn-primary btn-sm" id="btnCreateContainer" style="display: none;">
                <i class="fa fa-plus"></i> Buat Pengajuan Baru
            </a>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-sm text-center" id="tabelHeader" style="width:100%">
                    <thead class="bg-light">
                        <tr>
                            <th style="width: 50px;">No</th>
                            <th>Header ID</th>
                            <th>Department</th>
                            <th>User</th>
                            <th>Status</th>
                            <th style="width: 120px;" data-orderable="false">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data akan diisi otomatis melalui AJAX DataTables -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Tambahkan JS DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <!-- Tambahkan JS SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        body {
            background: linear-gradient(135deg, #2c5e50 0%, #a8c4b8 100%) !important;
            background-attachment: fixed !important;
            min-height: 100vh;
        }
    </style>

    <script>
   $(document).ready(function () {
        // Inisialisasi DataTables
        var table = $('#tabelHeader').DataTable({
            "processing": true,
            "serverSide": false,
            "lengthChange": false,
            "info": false,
            "ajax": {
                "url": '@Url.Action("GetDisposalHeaders", "ITDisposal", new { area = "IT" })',
                "type": "GET",
                "dataSrc": function (json) {
                    // Cek apakah canCreate bernilai true dari root JSON controller
                    if (json.canCreate === true) {
                        $('#btnCreateContainer').hide();
                    } else {
                        $('#btnCreateContainer').hide();
                    }

                    // Kembalikan array datanya ke DataTables
                    return json.data || [];
                }
            },
            "columns": [
                {
                    "data": null,
                    "render": function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },
                {
                    "data": "header_id"
                },
                { "data": "department" },
                {
                    "data": "requester_name",
                    "render": function (data) {
                        return data || '-';
                    }
                },
                {
                    "data": "status",
                    "render": function (data) {
                        var rawStatus = data || 'Draft';
                        return formatStatusText(rawStatus).toUpperCase();
                    }
                },
                {
                    "data": "id",
                    "render": function (data, type, row) {
                        var detailUrl = '@Url.Action("Details", "ITDisposal", new { area = "IT" })?id=' + row.header_id;

                        var actionButtons = `<a href="${detailUrl}" class="btn btn-info btn-sm">Detail</a>`;

                        if (row.canDelete) {
                            actionButtons += ` <button type="button" class="btn btn-danger btn-sm btn-delete" data-id="${data}">Delete</button>`;
                        }

                        return actionButtons;
                    }
                }
            ],
            "language": {
                "search": "Search:"
            },
            "pageLength": 5,
            "ordering": true,
            "autoWidth": false
        });
    });

    function formatStatusText(status) {
        if (!status) return 'Draft';
        var formatted = status.replace(/([A-Z])/g, ' $1').trim();
        return formatted
            .replace(/Returned By Checker/gi, 'Returned by Checker')
            .replace(/Rejected By Checker/gi, 'Rejected by Checker')
            .replace(/Returned By Approver/gi, 'Returned by Approver')
            .replace(/Rejected By Approver/gi, 'Rejected by Approver');
    }

    // Event listener untuk tombol Delete
    $(document).on("click", ".btn-delete", function () {

    var id = $(this).data("id");

    Swal.fire({
        title: "Are you sure?",
        text: "This data will be permanently deleted.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, Delete",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#d33"
    }).then((result) => {

        if (result.isConfirmed) {

            $.ajax({

                url: '@Url.Action("DeleteDisposal", "ITDisposal", new { area = "IT" })',

                type: 'POST',

                data: {
                    id: id
                },

                success: function (res) {

                    if (res.success) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted',
                            text: 'Data berhasil dihapus.',
                            timer: 1500,
                            showConfirmButton: false
                        });

                        $('#tabelHeader').DataTable().ajax.reload(null, false);

                    }
                    else {

                        Swal.fire(
                            'Error',
                            res.message,
                            'error'
                        );

                    }

                },

                error: function () {

                    Swal.fire(
                        'Error',
                        'Terjadi kesalahan.',
                        'error'
                    );

                }

            });

        }

    });

});
    </script>
}