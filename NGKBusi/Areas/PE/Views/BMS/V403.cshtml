@{
    ViewBag.Title = "403 Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center">
    <div style="font-size: 80px; color: #dc3545; font-weight: bold;">
        403
    </div>
    <h2 style="margin-bottom: 20px;">Access Denied</h2>

    <p class="lead" style="font-size: 18px; color: #6c757d;">
        Sorry, you do not have permission to access this page.
    </p>

    <hr style="margin: 30px 0; border-top: 1px solid #e9ecef;" />

    <p style="color: #6c757d; margin-bottom: 30px;">
        If you believe you should have access, please contact the System Administrator or your Supervisor to obtain the appropriate access rights.
    </p>

    <a href="@Url.Content("~/")" class="btn btn-primary" style="padding: 10px 20px; font-size: 16px; text-decoration: none; color: #fff; background-color: #007bff; border-radius: 5px;">
        &larr; Back to Home
    </a>
</div>