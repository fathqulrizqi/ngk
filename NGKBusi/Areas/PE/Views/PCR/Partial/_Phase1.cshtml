    $("#returnToOriginatorBtn").off("click").on("click", function () {
    const headId = new URLSearchParams(window.location.search).get("headId");
    const currentNik = "@ViewBag.Usernik";
    const currentName = "@ViewBag.Fullname";

    Swal.fire({
        title: "Return to Originator",
        text: "Please provide a reason for returning this document:",
        input: "textarea",
        inputPlaceholder: "Reason for return...",
        showCancelButton: true,
        confirmButtonText: "Submit Return",
        confirmButtonColor: "#f6ad55",
        preConfirm: (message) => {
            if (!message) {
                Swal.showValidationMessage("Reason cannot be empty.");
            }
            return message;
        }
    }).then((res) => {
        if (res.isConfirmed && res.value) {

            showLoadingState("#returnToOriginatorBtn", true, "Returning...");

            const formData = new FormData();

            formData.append("headId", headId);
            formData.append("nik", currentNik);
            formData.append("name", currentName);
            formData.append("status", 5); 
            formData.append("rejectMessage", res.value);

            $.ajax({
                url: '@Url.Action("SignPE", "PCR", new { area = "PE" })',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        Swal.fire("Success!", "Document returned to originator successfully.", "success")
                            .then(() => location.reload());
                    } else {
                        Swal.fire("Error!", response.message, "error");
                    }
                },
                error: function () {
                    Swal.fire("Error!", "A server error occurred.", "error");
                },
                complete: function () {
                    showLoadingState("#returnToOriginatorBtn", false, "Return to Originator");
                }
            });
        }
    });
    });

    function unlockForm(data) {
        if (!data) return;
        renderExistingFiles(existingFiles, data.Head.ID);

        const head = data.Head || {};
        const detail = data.Detail || {};
        // Enable lagi semua Clear button
        $(".clearBtn").prop("disabled", false)
            .css({ "color": "red", "cursor": "pointer" });
        const $docNo = $("#docNo");
        if ($docNo.length > 0) {
            $docNo.prop("disabled", false);
            $docNo.val(head.Doc_No || "");
        }

        // ================= FIELD MAPPINGS =================
        // format: fieldId: [dataSource, propertyName, elementType, wrapperId, inputType]
        const fieldMappings = {
            title: [head, 'Title', 'input', null, 'text'],
            product: [head, 'Product', 'input', null, 'text'],
            line: [head, 'Line', 'input', null, 'text'],
            purpose: [head, 'Purpose', 'textarea', null, null],
            appliedPart: [head, 'Applied_Part', 'input', null, 'text'],
            model: [head, 'Model', 'input', null, 'text'],
            partNo: [head, 'Part_No', 'input', null, 'text'],
            remark: [head, 'Remark', 'input', 'remarkInputWrapper', 'text'],
            forecast: [head, 'Forecast', 'input', 'forecastWrapper', 'text'],      // 👈 pakai text
            dept: [head, 'Dept', 'input', null, 'text'],
            currentStatement: [detail, 'Current_Statement', 'textarea', null, null],
            futureStatement: [detail, 'Future_Statement', 'textarea', null, null],
            currentCost: [detail, 'Current_Cost', 'input', 'currentCostWrapper', 'text'], // 👈 pakai text
            futureCost: [detail, 'Future_Cost', 'input', 'futureCostWrapper', 'text'],   // 👈 pakai text
            planDate: [detail, 'Plan', 'input', 'planDateWrapper', 'date'],
        };
        // ================= UNLOCK RADIO & CHECKBOX =================

        // 1️⃣ Unlock radio button
        $('input.radio-lock')
            .removeClass('radio-lock')
            .prop('disabled', false)
            .css('cursor', 'pointer');

        // 2️⃣ Unlock checkbox
        $('input.checkbox-lock')
            .removeClass('checkbox-lock')
            .prop('disabled', false)
            .css('cursor', 'pointer');
        // ================= UNLOCK LOGIC =================
        Object.keys(fieldMappings).forEach(fieldId => {
            const [dataSource, propertyName, elementType, wrapperId, forcedType] = fieldMappings[fieldId];
            let value = dataSource[propertyName] || '';

            // Cari elemen <p> yang dikunci (menggunakan atribut data-field yang baru)
            const $lockedP = $(`p.text-sm[data-field='${fieldId}']`);

            // Cari container jika menggunakan wrapper (untuk field seperti cost/remark/planDate)
            const $wrapper = wrapperId ? $(`#${wrapperId}`) : null;

            // Tentukan elemen mana yang akan kita ganti/isi
            let $targetElement = $lockedP.length > 0 ? $lockedP : $wrapper;

            if (!$targetElement || $targetElement.length === 0) {
                // Ini terjadi jika elemen belum di-lock (misalnya jika hanya berupa input normal dan tidak masuk loop fillForm)
                // atau jika elemen wrapper tidak ada, tapi elemen input aslinya sudah ada.

                // Kita hanya perlu memastikan value-nya terisi jika elemen input/textarea aslinya sudah ada.
                let $originalElement = $(`#${fieldId}`);
                if ($originalElement.length > 0) {
                    $originalElement.val(value);
                }
                return;
            }

            // 1. Buat ulang elemen input/textarea dengan semua atribut yang diperlukan
            let newElementHtml = '';
            if (elementType === 'input') {
                newElementHtml = `
            <input type="${forcedType || 'text'}" id="${fieldId}"
                   name="${getFieldName(fieldId)}"
                   class="${getInputClass(fieldId)}"
                   placeholder="${getPlaceholder(fieldId)}"
                   value="${value}">
            <div class="invalid-feedback">${getPlaceholder(fieldId)} is required.</div>
        `;
            } else if (elementType === 'textarea') {
                const rows = getTextareaRows(fieldId);
                newElementHtml = `
            <textarea id="${fieldId}"
                      name="${getFieldName(fieldId)}"
                      rows="${rows}"
                      class="${getTextareaClass(fieldId)}"
                      placeholder="${getPlaceholder(fieldId)}">${value}</textarea>
            <div class="invalid-feedback">${getPlaceholder(fieldId)} is required.</div>
        `;
            }

            // 2. Lakukan penggantian elemen
            if ($lockedP.length > 0) {
                // Case: Elemen dikunci sebagai <p> -> Ganti <p> dengan input/textarea yang baru
                $lockedP.replaceWith(newElementHtml);
            } else if ($wrapper && $wrapper.length > 0) {
                // Case: Wrapper (div) yang berisi elemen <p> yang lama sudah terhapus.
                // Langsung isi wrapper dengan input/textarea baru.
                // Catatan: Ini hanya berlaku untuk field yang memang punya wrapper (cost, remark, forecast, planDate)
                $wrapper.html(newElementHtml);
            }
        });
        // ================= CONDITION (special case) =================
        const conditionP = $('p.text-sm b:contains("Temporary"), p.text-sm b:contains("Permanent")').parent();
        if (conditionP.length > 0) {
            const conditionString = head.Condition || "";
            const temporaryDateMatch = conditionString.match(/\((.*?)\)/);
            const temporaryDateValue = (temporaryDateMatch && moment(temporaryDateMatch[1], "YYYY-MM-DD").isValid())
                ? moment(temporaryDateMatch[1], "YYYY-MM-DD").format("YYYY-MM-DD")
                : '';

            const conditionHtml = `
            <div class="d-flex gap-3 mt-2">
                <div class="form-check">
                    <input id="conditionPermanent" class="form-check-input" type="radio" name="Condition" value="Permanent" ${conditionString === 'Permanent' ? 'checked' : ''}>
                    <label class="form-check-label">Permanent</label>
                </div>
                <div class="form-check">
                    <input id="conditionTemporary" class="form-check-input" type="radio" name="Condition" value="Temporary" ${conditionString.includes('Temporary') ? 'checked' : ''}>
                    <label class="form-check-label">Temporary</label>
                </div>
            </div>
        `;

            const temporaryDateHtml = `
            <div id="temporaryDateLabel" class="flex-fill border-start ps-3" ${!conditionString.includes('Temporary') ? 'style="display:none;"' : ''}>
                <span class="d-block">If Temporary, Tell the time:</span>
                <input type="date" id="temporaryDate" name="TemporaryDate" class="form-control form-control-sm mt-1 border-black" style="max-width:200px;" value="${temporaryDateValue}">
                <div class="invalid-feedback">Please specify the date for temporary condition.</div>
            </div>
        `;

            conditionP.closest('td').find('.d-flex.p-2').html(`
            <div class="flex-fill border-end pe-3">
                <p style="font-weight:bold; font-size:12px; margin:0;">CONDITION</p>
                ${conditionHtml}
            </div>
            ${temporaryDateHtml}
        `);
        }

        // ================= TINYMCE =================
        ['currentSketch', 'futureSketch'].forEach(editorId => {
            const content = detail[editorId === 'currentSketch' ? 'Current_Sketch' : 'Future_Sketch'] || '';
            $(`#${editorId}`).replaceWith(
                `<textarea id="${editorId}" name="${editorId === 'currentSketch' ? 'Current_Sketch' : 'Future_Sketch'}">${content}</textarea>`
            );
        });

        initTinyMCE(() => {
            $('.locked-editor').remove();
            $('input[name="Condition"]').prop('disabled', false);
            $('#temporaryDate').prop('disabled', false);
            $('input[name="BCP"]').prop('disabled', false);
            $('input[name="DTBRCheckbox"]').prop('disabled', false);
            $('input[name^="PE_PCR_Classification"]').prop('disabled', false);
            $('input[name="PE_PCR_DTBR_3_Classification"]').prop('disabled', false);
            $('#dtbrOthersText').prop('disabled', false);
            $('#dropZoneLabel').prop('hidden', false);
        });
    }

    // ================= HELPER =================
    function getInputClass(fieldId) {
        const baseClass = "block w-full p-2 text-gray-900 border border-gray-300 rounded-lg bg-gray-50 text-xs focus:ring-blue-500 focus:border-blue-500";
        switch (fieldId) {
            case 'planDate':
                return "form-control form-control-sm border-black";
            default:
                return baseClass;
        }
    }
            function getTextareaClass(fieldId) {
                switch (fieldId) {
                    case 'title':
                        return "mt-2 resize-none block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500";
                    case 'purpose':
                    case 'remark':
                        return "mt-2 resize-none block w-full text-sm rounded-lg border border-gray-300 p-2.5";
                    case 'currentStatement':
                    case 'futureStatement':
                        return "resize-none block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300";
                    default:
                        return "form-control";
                }
            }

            function getPlaceholder(fieldId) {
                const placeholders = {
                    title: "Write title here...",
                    product: "Product",
                    line: "Line",
                    purpose: "Write purpose here...",
                    appliedPart: "Applied Part",
                    model: "Model",
                    partNo: "Part No",
                    remark: "Remark",
                    forecast: "20,000",
                    currentStatement: "Write current condition statement here...",
                    futureStatement: "Write future condition statement here...",
                    currentCost: "Current condition cost",
                    futureCost: "Future condition cost"
                };
                return placeholders[fieldId] || "";
            }

            function getTextareaRows(fieldId) {
                switch (fieldId) {
                    case 'title':
                        return "4";
                    case 'purpose':
                        return "2";
                    case 'currentStatement':
                    case 'futureStatement':
                        return "4";
                    default:
                        return "3";
                }
            }

            function getFieldName(fieldId) {
                const fieldNames = {
                    title: "Title",
                    product: "Product",
                    line: "Line",
                    purpose: "Purpose",
                    appliedPart: "Applied_Part",
                    model: "Model",
                    partNo: "Part_No",
                    remark: "Remark",
                    forecast: "Forecast",
                    dept: "Dept",
                    currentStatement: "Current_Statement",
                    futureStatement: "Future_Statement",
                    currentCost: "Current_Cost",
                    futureCost: "Future_Cost",
                    planDate: "Plan",
                };
                return fieldNames[fieldId] || fieldId;
            }


            $('#dtbrOthers').on('change', function () {
                // Cek apakah checkbox ini sedang dicentang
                if ($(this).is(':checked')) {
                    // Jika dicentang: Hapus atribut 'disabled' dan langsung fokuskan kursor
                    $('#dtbrOthersText').prop('disabled', false).focus();
                } else {
                    // Jika tidak dicentang: Tambahkan kembali atribut 'disabled' dan kosongkan nilainya
                    $('#dtbrOthersText').prop('disabled', true).val('');
                }
            });
            // =================================================================
            // 1. INISIALISASI PLUGIN (SELECT2, DLL)
            // =================================================================
            $('#secondIssuer, #approvedBy').select2({
                placeholder: '-- Select Name --',
                width: "100%",
                allowClear: true
            });

            $('#docNo').select2({
                placeholder: '-- Filled by PE --',
                width: "100%",
                allowClear: true
            });


            // =================================================================
            // 2. LOGIKA INTERAKSI FORM STANDAR
            // =================================================================
            $('#temporaryDate').prop('disabled', true);

            $('input[name="Condition"]').on('change', function () {
                if (this.value === 'Temporary') {
                    $('#temporaryDate').prop('disabled', false);
                } else {
                    $('#temporaryDate').prop('disabled', true);
                }
            });

            // =================================================================
            // 3. LOGIKA UNTUK FILE UPLOAD & PREVIEW
            // =================================================================
            // --- Inisialisasi Variabel ---
            const dropZoneLabel = $('#dropZoneLabel');
            const fileInput = $('#dropzone-file');
            const fileList = $('#fileList');
            let existingFiles = []; // This array will hold the filenames of files already on the server
            let uploadedFiles = []; // This array will hold the File objects of NEWLY uploaded files
            const fileUrlMap = new Map(); // Untuk menyimpan URL sementara

            $('#fileList .file-item').each(function () {
                existingFiles.push($(this).data('filename'));
            });

            // --- Event Listeners untuk Drag & Drop ---
            dropZoneLabel.on('dragover', function (e) {
                e.preventDefault();
                $(this).removeClass('border-gray-300 bg-gray-50').addClass('border-blue-500 bg-blue-100');
            });

            dropZoneLabel.on('dragleave', function (e) {
                e.preventDefault();
                $(this).removeClass('border-blue-500 bg-blue-100').addClass('border-gray-300 bg-gray-50');
            });

            dropZoneLabel.on('drop', function (e) {
                e.preventDefault();
                $(this).removeClass('border-blue-500 bg-blue-100').addClass('border-gray-300 bg-gray-50');
                const files = e.originalEvent.dataTransfer.files;
                handleFiles(files);
            });

            fileInput.off('change').on('change', function () {
                const files = this.files;
                handleFiles(files);
            });

            // Dapatkan file yang sudah ada dari DOM saat halaman dimuat
            function getExistingFilesFromDOM() {
                existingFiles = [];
                $('#fileList a').each(function () {
                    const fileName = $(this).find('span').text();
                    // Cek apakah ini file lama (punya atribut 'data-existing')
                    if ($(this).find('.remove-file').data('existing')) {
                        existingFiles.push(fileName);
                    }
                });
            }

            // Panggil saat load awal halaman
            getExistingFilesFromDOM();


            // GANTI DENGAN FUNGSI INI (Sudah termasuk fitur download)
            function handleFiles(files) {
                for (const file of files) {
                    // --- VALIDASI TIPE FILE UNTUK HANYA MEMBOLEHKAN PDF ---
                    const extension = file.name.split('.').pop().toLowerCase();
                    if (extension !== 'pdf') {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Format File Tidak Diizinkan',
                            text: 'Hanya file dengan format PDF yang dapat diunggah.'
                        });
                        continue; // Lanjut ke file berikutnya jika ada
                    }

                    if (!uploadedFiles.some(f => f.name === file.name) && !existingFiles.some(name => name === file.name)) {
                        uploadedFiles.push(file);

                        const fileIcon = getFileIcon(file.name);
                        const isPreviewable = file.type === 'application/pdf';

                        const objectUrl = URL.createObjectURL(file);
                        fileUrlMap.set(file.name, objectUrl);

                        const fileItemContent = `
                <div class="flex items-center gap-3 min-w-0">
                    ${fileIcon}
                    <span class="text-sm text-gray-700 truncate">${file.name}</span>
                </div>
                <button type="button" class="remove-file text-red-500 hover:text-red-700 font-bold z-10 pl-3" data-filename="${file.name}">&times;</button>
            `;

                        let fileItemHTML = `
    <a href="${objectUrl}" target="_blank" rel="noopener noreferrer"
       class="flex justify-between items-center p-2 border rounded-lg mb-2 bg-white shadow-sm cursor-pointer hover:bg-gray-50">
        ${fileItemContent}
    </a>
`;

                        if (isPreviewable) {
                            fileItemHTML = `
        <a href="${objectUrl}" target="_blank" rel="noopener noreferrer"
           class="flex justify-between items-center p-2 border rounded-lg mb-2 bg-white shadow-sm cursor-pointer hover:bg-gray-50">
            ${fileItemContent}
        </a>
    `;
                        } else {
                            fileItemHTML = `
        <a href="${objectUrl}" download="${file.name}"
           class="flex justify-between items-center p-2 border rounded-lg mb-2 bg-white shadow-sm cursor-pointer hover:bg-gray-50">
            ${fileItemContent}
        </a>
    `;
                        }

                        fileList.append(fileItemHTML);
                    }
                }
            }

                // Event listener untuk menghapus file
            fileList.off('click', '.remove-file').on('click', '.remove-file', function (e) {
                e.preventDefault();
                e.stopPropagation();

                const fileName = $(this).data('filename');
                const isExisting = $(this).data('existing');

                if (isExisting) {
                    existingFiles = existingFiles.filter(f => f !== fileName);
                } else {
                    uploadedFiles = uploadedFiles.filter(f => f.name !== fileName);
                    if (fileUrlMap.has(fileName)) {
                        URL.revokeObjectURL(fileUrlMap.get(fileName));
                        fileUrlMap.delete(fileName);
                    }
                }

                $(this).closest('a, div').remove();
            });



            // GANTI DENGAN FUNGSI INI (Menggunakan Font Awesome)
            function getFileIcon(fileName) {
                const extension = fileName.split('.').pop().toLowerCase();

                // Definisikan ikon menggunakan Font Awesome dengan kelas warna Tailwind
                const icon_image = `<i class="fa-solid fa-file-image fa-lg text-blue-500"></i>`;
                const icon_pdf = `<i class="fa-solid fa-file-pdf fa-lg text-red-500"></i>`;
                const icon_ppt = `<i class="fa-solid fa-file-powerpoint fa-lg text-orange-500"></i>`;
                const icon_excel = `<i class="fa-solid fa-file-excel fa-lg text-green-500"></i>`;
                const icon_word = `<i class="fa-solid fa-file-word fa-lg text-sky-600"></i>`;
                const icon_file = `<i class="fa-solid fa-file fa-lg text-gray-500"></i>`;

                switch (extension) {
                    case 'jpg': case 'jpeg': case 'png': case 'gif': case 'svg':
                        return icon_image;
                    case 'pdf':
                        return icon_pdf;
                    case 'ppt': case 'pptx':
                        return icon_ppt;
                    case 'xls': case 'xlsx':
                        return icon_excel;
                    case 'doc': case 'docx':
                        return icon_word;
                    default:
                        return icon_file;
                }
    }

function renderExistingFiles(files, headId) {
    fileList.empty(); // reset dulu

    files.forEach(f => {
        // Bisa handle kalau datanya string atau object
        const fileName = typeof f === "string" ? f : f.File_Name;
        if (!fileName) return; // skip invalid data

        const fileIcon = getFileIcon(fileName);
        const extension = fileName.split('.').pop().toLowerCase();
        const isPreviewable = ['pdf'].includes(extension);

        // Gunakan controller PreviewPdf untuk file PDF
        const fileUrl = isPreviewable
            ? `@Url.Action("PreviewPdf", "PCR")?headId=${'${headId}'}&fileName=${encodeURIComponent(fileName)}`
            : `/Files/PE/PCR/${fileName}`;

        const fileItemHTML = `
            <a href="${fileUrl}"
               ${isPreviewable ? 'target="_blank" rel="noopener noreferrer"' : 'download'}
               class="flex justify-between items-center p-2 border rounded-lg mb-2 bg-white shadow-sm cursor-pointer hover:bg-gray-50 file-item"
               data-filename="${fileName}">
                <div class="flex items-center gap-3 min-w-0">
                    ${fileIcon}
                    <span class="text-sm text-gray-700 truncate">${fileName}</span>
                </div>
                <button type="button"
                        class="remove-file text-red-500 hover:text-red-700 font-bold z-10 pl-3"
                        data-filename="${fileName}"
                        data-existing="true">&times;</button>
            </a>
        `;

        fileList.append(fileItemHTML);
    });
}


