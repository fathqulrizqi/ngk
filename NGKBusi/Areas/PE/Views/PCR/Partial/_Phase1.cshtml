<style>
    .checkbox-lock,
    .radio-lock {
        pointer-events: none; /* tidak bisa diklik */
        cursor: not-allowed; /* tampil kursor dilarang */
        opacity: 1; /* biar tidak pudar */
    }

    .form-container.rejected {
        position: relative;
        background-color: rgba(0, 0, 0, 0.6); /* gelapin */
    }

        .form-container.rejected::after {
            content: "REJECTED";
            position: absolute;
            top: 40%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-15deg);
            font-size: 4rem;
            font-weight: bold;
            color: rgba(255, 0, 0, 0.5);
            font-style: italic;
            pointer-events: none;
        }

    .reject-reason {
        margin-top: 1rem;
        color: #fca5a5; /* merah lembut */
        font-size: 0.9rem;
        font-style: italic;
    }

    .loader {
        border: 4px solid #f3f3f3;
        border-top: 4px solid #3498db;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 0.7s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>
<script>
$(document).ready(function () {

            // MAPPING DATA //
            const urlParams = new URLSearchParams(window.location.search);
            const headId = urlParams.get("headId");
    let globalFormData = null;
    const dept = "@ViewBag.CostName";
    let deptDataForSave = "";
    document.querySelectorAll('input[name="PE_PCR_DTBR_3_Classification"]').forEach(r => {
        r.addEventListener('change', function () {

            const reqInputs = document.querySelectorAll('input[name="RequirementStatus"]');

            if (this.value === "A" || this.value === "B" || this.value === "C") {
                reqInputs.forEach(x => x.disabled = false);
            } else {
                reqInputs.forEach(x => {
                    x.disabled = true;
                    x.checked = false;
                });
            }
        });
    });
            // --- Pemakaian ---
            initTinyMCE(function () {
    if (headId && headId !== "0") {

        $("#loadingSpinner").show();

        $.ajax({
            url: "@Url.Action("GetPcrById", "PCR", new { area = "PE" })",
            type: "GET",
            data: { headId: headId },
            success: function (res) {

                if (res && res.success) {
                    if (res.data.Approvals && res.data.Approvals.length > 0) {
                        approvalData = res.data.Approvals[0];
                    }

                    window.deptDataForSave = res.data.Head.Dept;
                    fillForm(res.data);
                }

            },
            error: function (xhr, status, error) {
                console.error("Error get data:", error);
            },
            complete: function () {
                $("#loadingSpinner").hide();
            }
        });
    }
});


        function fillForm(data) {
            if (!data) return;

            window.lastFormData = data;
            const head = data.Head || {};
            const detail = data.Detail || {};
            const approvals = data.Approvals && data.Approvals.length > 0 ? data.Approvals[0] : null;
            const managementapprovals = data.Approvals[0].ManagementHold;
            if (approvals) {
                console.log("DETAIL DATA", approvals)
                const managementapprovals = approvals.ManagementHold;
                const managementrejects = data?.ManagementReject;
                // Tambahkan pengecekan managementapprovals dan managementapprovals.isHold
                if (managementapprovals) {

                    $("#holdMessage").addClass("hidden").html("");

                    // --- function kecil biar rapi ---
                    const getHoldLabel = (status) => {
                        if (status === 4) return "RETURNED TO PE";
                        if (status === 5) return "RETURNED TO ORIGINATOR";
                        return ""; // default
                    };

                    // M1 HOLD
                    if (managementapprovals.M1_Hold && managementapprovals.isHold == true) {
                        const label = getHoldLabel(managementapprovals.M1_Status);
                        $("#holdMessage").removeClass("hidden").append(`
            <div>
                ${managementapprovals.M1_Name || "MANAGER"} — ${label}:
                ${managementapprovals.M1_Message || "-"}
            </div>
        `);
                    }

                    // M2 HOLD
                    if (managementapprovals.M2_Hold && managementapprovals.isHold == true) {
                        const label = getHoldLabel(managementapprovals.M2_Status);
                        $("#holdMessage").removeClass("hidden").append(`
            <div>
                ${managementapprovals.M2_Name || "MANAGER"} — ${label}:
                ${managementapprovals.M2_Message || "-"}
            </div>
        `);
                    }

                    // M3 HOLD
                    if (managementapprovals.M3_Hold && managementapprovals.isHold == true) {
                        const label = getHoldLabel(managementapprovals.M3_Status);
                        $("#holdMessage").removeClass("hidden").append(`
            <div>
                ${managementapprovals.M3_Name || "MANAGER"} — ${label}:
                ${managementapprovals.M3_Message || "-"}
            </div>
        `);
                    }
                }


                if (managementrejects) {
                    $("#rejectMessage").addClass("hidden").html(""); // reset

                    if (managementrejects.M1_Reject) {
                        $("#rejectMessage")
                            .removeClass("hidden")
                            .append(`<div>${managementrejects.M1_Name || "MANAGER"} REJECTED: ${managementrejects.M1_Message || "-"}</div>`);
                    }

                    if (managementrejects.M2_Reject) {
                        $("#rejectMessage")
                            .removeClass("hidden")
                            .append(`<div>${managementrejects.M2_Name || "MANAGER"}  REJECTED: ${managementrejects.M2_Message || "-"}</div>`);
                    }

                    if (managementrejects.M3_Reject) {
                        $("#rejectMessage")
                            .removeClass("hidden")
                            .append(`<div>${managementrejects.M3_Name || "MANAGER"}  REJECTED: ${managementrejects.M3_Message || "-"}</div>`);
                    }
                }
            }
            // ================= HEAD =================
            if (head.Doc_No) {
                const $docNo = $("#docNo");

                // Set value ke dropdown
                $docNo.val(head.Doc_No);

                // Hapus placeholder "-- Pilih Doc No --"
                $docNo.find("option[value='']").remove();

                // Kalau option belum ada, tambahin manual
                if ($docNo.find("option[value='" + head.Doc_No + "']").length === 0) {
                    $docNo.append(
                        $("<option>", {
                            value: head.Doc_No,
                            text: head.Doc_No,
                            selected: true
                        })
                    );
                }
            }

            $("#title").val(head.Title || "");
            $("#product").val(head.Product || "");
            $("#line").val(head.Line || "");
            $("#purpose").val(head.Purpose || "");
            $("#appliedPart").val(head.Applied_Part || "");
            $("#model").val(head.Model || "");
            $("#partNo").val(head.Part_No || "");
            $("#remark").val(head.Remark || "");
            $("#forecast").val(head.Forecast || "");
            $("#dept").val(head.Dept || "");

            // ================= CONDITION =================
            const conditionString = head.Condition || "";
            const temporaryDateLabel = $("#temporaryDateLabel");

            if (conditionString.includes("Temporary")) {
                temporaryDateLabel.show();
                $("#conditionTemporary").prop("checked", true);

                const parts = conditionString.split(', ');
                if (parts.length > 1) {
                    const dateString = parts[1].replace(/[()]/g, '').trim();
                    const dateObject = moment(dateString, "YYYY-MM-DD");
                    if (dateObject.isValid()) {
                        $("#temporaryDate").val(dateObject.format("YYYY-MM-DD"));
                    }
                }
            } else if (conditionString === "Permanent") {
                $("#conditionPermanent").prop("checked", true);
            }

            // ================= BCP =================
            if (head.BCP) {
                const bcpList = head.BCP.split(",");
                bcpList.forEach(b => {
                    $(`input[name='BCP'][value='${b.trim()}']`).prop("checked", true);
                });
            }

            // ================= DETAIL =================
            $("#currentStatement").val(detail.Current_Statement || "");
            $("#futureStatement").val(detail.Future_Statement || "");
            $("#currentCost").val(detail.Current_Cost || "");
            $("#futureCost").val(detail.Future_Cost || "");
            $("#planDate").val(detail.Plan || "");

            const currentSketchEditor = tinymce.get('currentSketch');
            if (currentSketchEditor) currentSketchEditor.setContent(detail.Current_Sketch || "");

            const futureSketchEditor = tinymce.get('futureSketch');
            if (futureSketchEditor) futureSketchEditor.setContent(detail.Future_Sketch || "");

            // === ACTUAL DATE (FROM MANAGEMENT APPROVAL) ===
            if (data.ActualDate) {
                const timestamp = parseInt(data.ActualDate.match(/\d+/)[0]); // ambil angka dari /Date(....)/
                const dateObj = new Date(timestamp);
                const formattedDate = dateObj.toISOString().split('T')[0]; // hasil: "2025-10-04"

                const $actualInput = $("#actualDate");
                const $p = $(`<p id="actualDate" class="text-sm font-bold">${formattedDate}</p>`);

                $actualInput.replaceWith($p);
            }

            // ================= CLASSIFICATIONS =================
            if (data.Classifications && data.Classifications.length > 0) {
                data.Classifications.forEach(c => {
                    $(`input[name='PE_PCR_Classification[${c.Master_ID - 1}].Status'][value='${c.Status}']`).prop("checked", true);
                });
            }

            // ================= DTBRs =================
            let dtbrClassification = '';
            if (data.DTBRs && data.DTBRs.length > 0) {
                dtbrClassification = data.DTBRs[0].Classification;
                data.DTBRs.forEach(d => {
                    $(`#dtbr_${d.DTBR_ID}`).prop('checked', true);
                });
            }
            if (data.DBTR_Others) {
                dtbrClassification = data.DBTR_Others.Classification;
                $('#dtbrOthers').prop('checked', true);
                $('#dtbrOthersText').val(data.DBTR_Others.Other_Description).prop('disabled', false);
            }
            if (dtbrClassification) {
                $(`input[name='PE_PCR_DTBR_3_Classification'][value='${dtbrClassification}']`).prop('checked', true);
            }

            if (data.DTBRs && data.DTBRs.length > 0) {

                const requireItem = data.DTBRs.find(x => x.isRequire !== null && x.isRequire !== undefined);

                if (requireItem) {

                    if (["A", "B", "C"].includes(dtbrClassification)) {
                        $("input[name='RequirementStatus']").prop("disabled", false);

                        if (requireItem.isRequire === true || requireItem.isRequire == 1) {
                            $("#reqComplete").prop("checked", true);
                        } else if (requireItem.isRequire === false || requireItem.isRequire == 2) {
                            $("#reqNotComplete").prop("checked", true);
                        }
                    }
                }
            }

            // ================= FIRST ISSUER =================
            if (approvals) {
                if (approvals.First_Issued_NIK && approvals.First_Issued_Name) {
                    const firstIssuerSelect = $('#firstIssuer');
                    const newFirstIssuerHtml = `
                        <p id="firstIssuer" class="text-sm">${approvals.First_Issued_Name}</p>
                        <input type="hidden" name="PE_PCR_Approval_Head.First_Issued_NIK" value="${approvals.First_Issued_NIK}" />
                    `;
                    firstIssuerSelect.parent().html(newFirstIssuerHtml);

                    if (approvals.Date_Issued1) {
                        $('#firstIssuerSignDate').text(moment(approvals.Date_Issued1).format('DD MMM YYYY'));
                    }
                }

                const firstIssuerBtn = $('#IssuedBtn1');
                if (approvals.First_Status_ID === 2) {
                    firstIssuerBtn.prop("disabled", true)
                        .text("Signed")
                        .css({ "background-color": "#cfe2ff", "cursor": "default" });
                }
            }

            // ================= LOCK / UNLOCK UI =================
            if (approvals && approvals.First_Status_ID === 2) {
                $('#cancelBtn').prop('hidden', false);

                // --- Perubahan dimulai dari sini ---
                // Lock the condition radio buttons and the date field
                //$('input[name="Condition"]').prop('disabled', true);
                $('input[name="Condition"]').addClass('radio-lock');

                $('#temporaryDate').prop('disabled', true);
                // --- Perubahan berakhir di sini ---

                const fieldsToReplace = [
                    '#title', '#product', '#line', '#purpose', '#appliedPart',
                    '#model', '#partNo', '#remark', '#forecast', '#sequence', '#dept',
                    '#currentStatement', '#futureStatement', '#currentCost', "#futureCost",
                    '#planDate'
                ];
                fieldsToReplace.forEach(selector => {
                    const value = $(selector).val();
                    $(selector).replaceWith(`<p class="text-sm" data-field="${selector.replace('#', '')}"><b>${value}</b></p>`);
                });


                const lockedConditionString = head.Condition || "";
                const conditionContainer = $('input[name="Condition"]').closest('.col-md-6');
                if (lockedConditionString.includes("Temporary")) {
                    const parts = lockedConditionString.split(', ');
                    const dateValue = parts.length > 1 ? parts[1].replace(/[()]/g, '').trim() : '';
                    conditionContainer.html(`<p class="text-sm"><b>Temporary (${moment(dateValue).format('DD MMM YYYY')})</b></p>`);
                } else if (lockedConditionString === "Permanent") {
                    conditionContainer.html(`<p class="text-sm"><b>Permanent</b></p>`);
                }

                //$('input[name="BCP"]').prop('disabled', true);
                $('input[name="BCP"]').addClass('checkbox-lock');

                //$('input[name="DTBRCheckbox"]').prop('disabled', true);
                //$('input[name^="PE_PCR_Classification"]').prop('disabled', true);
                $('input[name^="PE_PCR_Classification"]').addClass('checkbox-lock');

                //$('input[name="PE_PCR_DTBR_3_Classification"]').prop('disabled', true);
                $('#dtbrOthersText').prop('disabled', true);

                $('#dropZoneLabel').prop('hidden', true);

                ['currentSketch', 'futureSketch'].forEach(editorId => {
                    const editorInstance = tinymce.get(editorId);
                    if (editorInstance) {
                        const contentHtml = editorInstance.getContent();
                        const editorContainer = editorInstance.getContainer();
                        $(editorContainer).replaceWith(`<div class="locked-editor" data-field="${editorId}">${contentHtml}</div>`);
                    }
                });
            }

            // ================= PE MANAGER =================
if (approvals) {
    const peManagerNiks = peManagerList.map(user => user.NIK);
    const currentUserNik = "@ViewBag.Usernik";

    let approvalStatusId = approvals.Approval_ID;

    if (approvalStatusId > 10) {
        approvalStatusId = 7;
    }

    function validMessage(msg) {
        return msg && msg.trim() !== "" && msg !== "null" && msg !== "{}";
    }


    switch (approvalStatusId) {
        case 2: case 3: case 4: case 5: case 6:
            if (validMessage(approvals.Message)) {
                $("#holdMessage").removeClass("hidden").text(`RETURN REASON FROM PE: ${approvals.Message}`);
            }
            break;

        case 6:
            if (approvals.Message) {
                $("#holdMessage").removeClass("hidden").text(`RETURN REASON FROM PE: ${approvals.Message}`);
            } else {
                $("#holdMessage").removeClass("hidden").text("This request is on HOLD by PE Manager.");
            }

            break;
        case 7:
            $("#approvalBtn").prop("disabled", true)
                .text("Signed")
                .css({ "background-color": "#0d6efd", "color": "white", "cursor": "default" });

            if (approvals.Date_PE_Manager_Approved) {
                $("#approverSignDate").text(moment(approvals.Date_PE_Manager_Approved).format('DD MMM YYYY'));
            }

            // 🔒 Disable DTBRV dan classificationV
            //$("#DTBRV input").prop("disabled", true);
            $('#DTBRV input[type="checkbox"]').addClass('checkbox-lock');

            //$("#classificationV input").prop("disabled", true);
            $('#classificationV input').addClass('radio-lock');

            $(".clearBtn").prop("disabled", true).css({
                "color": "gray",
                "cursor": "default"
            });

            break;

        case 8:
            $("#approvalBtn").prop("disabled", true)
                .text("Rejected")
                .css({ "background-color": "#dc3545", "color": "white", "cursor": "default" });

            if (approvals.Message) {
                $("#rejectMessage").removeClass("hidden").text(`REJECT REASON FROM PE MANAGER: ${approvals.Message}`);
            } else {
                $("#rejectMessage").removeClass("hidden").text("This request is on HOLD by PE Manager.");
            }

            $("#approverSignDate").text('');
            break;

        case 9:
            $("#approvalBtn")
                .text("HOLD")
                .css({ "background-color": "orange", "color": "#fff" });

            if (approvals.Message) {
                $("#holdMessage").removeClass("hidden").text(`RETURN REASON FROM PE: ${approvals.Message}`);
            } else {
                $("#holdMessage").removeClass("hidden").text("This request is on HOLD by PE Manager.");
            }

            break;
        case 10:
            if (approvals.Message) {
                $("#rejectMessage").removeClass("hidden").text(`REJECT REASON FROM PE MANAGER: ${approvals.Message}`);
            } else {
                $("#rejectMessage").removeClass("hidden").text("This request is on REJECT by Approver.");
            }

            break;

        default: // Pending
            $("#approvalBtn").prop("disabled", false)
                .text("Mark as Signed")
                .css({ "background-color": "#ffe69c", "color": "black", "cursor": "pointer" });

            $("#proposalCheckBtn").prop('hidden', true);
            $("#approverSignDate").text('');
            //$("#holdMessage").addClass("hidden").text("");
            // UnlockBtn default hidden juga
            $("#unlockBtn").prop("hidden", true);
            break;
    }
}

            // ================= APPROVER & BUTTON =================
            if (approvals) {
                const approvedBtn = $('#approvedBtn');

                if (approvals.Approver_Status_ID === 2) {
                    // --- APPROVED ---
                    $("#Approved_By_Container").html(`
            <p style="padding: 4px;" class="text-gray-800">${approvals.Approver_Name || "-"}</p>
            <input type="hidden" name="PE_PCR_Approval_Head.Approver_NIK" value="${approvals.Approver_NIK || ""}" />
        `);

                    approvedBtn.prop("disabled", true)
                        .text("Signed")
                        .css({ "background-color": "#cfe2ff", "cursor": "default" });

                    if (approvals.Date_Approved) {
                        $('#approverSignDate').text(moment(approvals.Date_Approved).format('DD MMM YYYY'));
                    }
                }
                else if (approvals.Approver_Status_ID === 3) {
                    // --- REJECTED ---
                    $("#Approved_By_Container").html(`
            <p style="padding: 4px;" class="text-gray-800">${approvals.Approver_Name || "-"}</p>
            <input type="hidden" name="PE_PCR_Approval_Head.Approver_NIK" value="${approvals.Approver_NIK || ""}" />
        `);

                    approvedBtn.prop("disabled", true)
                        .text("Rejected")
                        .css({ "background-color": "#dc3545", "color": "#fff", "cursor": "default" });
                }
                else if ((approvals.Approval_ID >= 2 && approvals.Approval_ID !== 9) || approvals.Approver_Status_ID === 1) {
                    // --- READONLY, TAPI JANGAN LOCK SAAT HOLD ---
                    $("#Approved_By_Container").html(`
            <p style="padding: 4px;" class="text-gray-800">${approvals.Approver_Name || "-"}</p>
            <input type="hidden" name="PE_PCR_Approval_Head.Approver_NIK" value="${approvals.Approver_NIK || ""}" />
        `);

                    if (approvals.Date_Approved) {
                        $('#approverSignDate').text(moment(approvals.Date_Approved).format('DD MMM YYYY'));
                    }
                }
                else {
                    // --- DEFAULT: SELECT AKTIF ---
                    const approveSelect = $("#approvedBy");

                    if (approvals.Approver_NIK) {
                        approveSelect.val(approvals.Approver_NIK).trigger("change");
                    } else {
                        approveSelect.val("").trigger("change");
                    }

                    approvedBtn.prop("disabled", false)
                        .text("Mark as Approved")
                        .css({ "background-color": "#ffe69c", "cursor": "pointer" });
                }
            }

            // ================= SECOND ISSUER & BUTTON =================
            if (approvals) {
                const secondIssuerBtn = $('#IssuedBtn2');

                // --- Sudah signed OR skipped ---
                if (approvals.Second_Status_ID === 2 || approvals.Second_Status_ID === 4) {
                    if (approvals.Second_Status_ID === 4 && approvals.Second_Issued_Name === "No Second Issuer") {
                        secondIssuerBtn.prop("disabled", true)
                            .text("Skipped")
                            .css({ "background-color": "#fff", "color": "#fff", "cursor": "default" });
                    } else {
                        secondIssuerBtn.prop("disabled", true)
                            .text("Signed")
                            .css({ "background-color": "#cfe2ff", "cursor": "default" });
                    }

                    // Ganti select jadi readonly
                    $("#Second_Issued_Container").html(`
            <p style="padding: 4px;" class="text-gray-800">${approvals.Second_Issued_Name || "-"}</p>
            <input type="hidden" name="PE_PCR_Approval_Head.Second_Issued_NIK" value="${approvals.Second_Issued_NIK || ""}" />
        `);

                    // Tanggal sign
                    if (approvals.Date_Issued2) {
                        $("#secondIssuerSignDate").text(moment(approvals.Date_Issued2).format("DD MMM YYYY"));
                    }
                }
                // --- Pending tapi jangan lock kalau Approval_ID == 9 (Hold) ---
                else if ((approvals.Approval_ID >= 2 && approvals.Approval_ID !== 9) || approvals.Second_Status_ID === 1) {
                    $("#Second_Issued_Container").html(`
            <p style="padding: 4px;" class="text-gray-800">${approvals.Second_Issued_Name || "-"}</p>
            <input type="hidden" name="PE_PCR_Approval_Head.Second_Issued_NIK" value="${approvals.Second_Issued_NIK || ""}" />
        `);

                    if (approvals.Date_Issued2) {
                        $("#secondIssuerSignDate").text(moment(approvals.Date_Issued2).format("DD MMM YYYY"));
                    }
                }
                // --- Default: belum dipilih sama sekali (atau saat Hold) ---
                else {
                    const secondSelect = $("#secondIssuer");

                    // Tambahin opsi 'No Second Issuer' kalau belum ada
                    if (secondSelect.find("option[value='empty']").length === 0) {
                        secondSelect.append('<option value="empty">No Second Issuer</option>');
                    }

                    // Atur nilai
                    if (approvals.Second_Issued_NIK) {
                        secondSelect.val(approvals.Second_Issued_NIK).trigger("change");
                    } else if (approvals.Second_Issued_Name === "No Second Issuer" || approvals.Second_Status_ID === 4) {
                        secondSelect.val("empty").trigger("change");
                    } else {
                        secondSelect.val("").trigger("change");
                    }

                    // Aktifkan tombol
                    secondIssuerBtn.prop("disabled", false)
                        .text("Mark as Signed")
                        .css({ "background-color": "#ffe69c", "cursor": "pointer" });
                }
            }

// ================= PE MANAGER ROLE ACCESS =================
const peManagerNiks = typeof peManagerList !== 'undefined' ? peManagerList.map(user => user.NIK) : [];
const currentUserNik = "@ViewBag.Usernik";
const isPE = peManagerNiks.includes(currentUserNik);

if (isPE) {
    $("#unlockBtn").prop("hidden", false).text("Unlock Form");

    $("#returnToOriginatorBtn").prop("hidden", false);

    $("#cancelBtn").prop("hidden", true);
    $("#saveDraftBtn").prop("hidden", true);
    $("#saveByPE").prop("hidden", true);

    $("#unlockBtn").off("click").on("click", function () {
        const isFormLocked = $(this).text().includes("Unlock");

        if (isFormLocked) {
            unlockForm(window.lastFormData);

            $(this).text("Lock Form");

            $("#saveDraftBtn").prop("hidden", true);
            $("#saveByPE").prop("hidden", false);
            $("#cancelBtn").prop("hidden", false);
        } else {
            fillForm(window.lastFormData);
        }
    });
}
else if (approvals && (approvals.Approval_ID === 1 || approvals.Approval_ID === 9)) {
    $("#saveDraftBtn").prop("hidden", false);
    $("#unlockBtn").prop("hidden", true);
    $("#saveByPE").prop("hidden", true);
    $("#returnToOriginatorBtn").prop("hidden", true);
}
else { // <--- TAMBAHKAN INI
    $("#unlockBtn").prop("hidden", true);
    $("#saveDraftBtn").prop("hidden", true);
    $("#cancelBtn").prop("hidden", true);
    $("#saveByPE").prop("hidden", true);

    $("#returnToOriginatorBtn").prop("hidden", true);
            }


           // ================= FILES =================
            const fileList = $("#fileList");
            existingFiles = [];   // <-- TAMBAHAN BARU
            uploadedFiles = [];
            fileList.empty();

            if (data.Files && data.Files.length > 0) {
                data.Files.forEach(f => {
                    const fileName = f.File_Name;
                    const fileUrl = `@Url.Action("PreviewPdf", "PCR")?headId=${head.ID}&fileName=${encodeURIComponent(fileName)}`;
                    const fileIcon = getFileIcon(fileName);
                    const extension = fileName.split('.').pop().toLowerCase();
                    const isPreviewable = ['pdf'].includes(extension);

                    // Simpan ke array file lama
                    existingFiles.push(fileName);

                    // ========== CHECK APPROVAL_ID ==========
                    let fileItemHTML = "";
                    if (approvals && (approvals.Approval_ID === 1 || approvals.Approval_ID === 6 || approvals.Approval_ID === 9)) {
                        // Editable mode → ada tombol X
                        fileItemHTML = `
                            <a href="${fileUrl}" target="_blank" rel="noopener noreferrer"
                               class="flex justify-between items-center p-2 border rounded-lg mb-2 bg-white shadow-sm hover:bg-gray-50">
                               <div class="flex items-center gap-3 min-w-0">
