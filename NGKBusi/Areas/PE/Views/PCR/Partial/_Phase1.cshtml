                Swal.fire('Not Allowed!', res.message, 'warning');
            } else if (res.success) {
                Swal.fire('Success!', res.message, 'success').then(() => {
                    if (res.page === 1) {
                        window.location.href = '@Url.Action("Index", "PCR", new { area = "PE" })';
                    } else if (res.page === 2) {
                        location.reload();
                    }
                });
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        },
        error: function(xhr){
            console.error(xhr.responseText);
            alert('Network error. Check console.');
        }
    });
});


function initTinyMCE(callback) {
    let readyCount = 0;
    const editors = ["#currentSketch", "#futureSketch"];

    editors.forEach(sel => {
        tinymce.init({
            selector: sel,
            height: 300,
            branding: false,
            license_key: 'gpl',
            plugins: 'table anchor lists code fullscreen image',
            toolbar: "undo redo fontsize backcolor forecolor bold italic alignleft aligncenter alignright bullist numlist table image fullscreen code",
            menubar: false,
            toolbar_mode: 'wrap',
            font_size_input_default_unit: "8pt",
            font_size_formats: '8pt 10pt 12pt 14pt 16pt 18pt 24pt 36pt 48pt',

            init_instance_callback: function () {
                readyCount++;
                if (readyCount === editors.length && typeof callback === "function") {
                    callback(); // semua editor siap
                }
            }
        });
    });
}


