                                @if (ViewBag.DTBRList != null)
                                {
                                    foreach (var item in (List<NGKBusi.Areas.PE.Models.PE_PCR_DTBR_Master>)ViewBag.DTBRList)
                                    {
                                        <div style="width: 50%; margin-bottom: 6px;">
                                            <input type="checkbox"
                                                   id="dtbr_@item.ID"
                                                   name="DTBRCheckbox" value="@item.ID" data-name="@item.DTBR_Name" /> @item.DTBR_Name
                                            </div>
                                        }
                                    }

                            <div style="width: 100%; max-width: 500px;">
                                <div class="flex items-center gap-2">
                                    <input type="checkbox" id="dtbrOthers" name="DTBRCheckbox" value="0" data-name="Others" checked />
                                    <label for="dtbrOthers" class="whitespace-nowrap text-sm">Others:</label>

                                    <input type="text" id="dtbrOthersText"
                                           value="PCC and Evaluation Report"
                                           placeholder="Other document..."
                                           class="block flex-1 p-1 text-gray-900 border border-gray-300 rounded-lg bg-gray-50 text-xs"
                                           disabled />
                                </div>
                                <div class="invalid-feedback hidden text-red-500 text-xs mt-1">"Others" description is required.</div>
                            </div>
                            </div>
                        </div>
                        <div id="dtbrError" class="invalid-feedback" style="display: none; margin-top: 5px;">
                            Please select at least one document to be reviewed.
                        </div>
                    </td>

                    <td rowspan="3" style="vertical-align: top; padding: 10px;">

                        <div style="display: flex; gap: 20px; font-size: 12px;">

                            <!-- LEFT: CLASSIFICATION -->
                            <div id="classificationV" style="display: flex; font-size: 14px; flex-direction: column;">

                                <div style="margin-bottom: 6px;">
                                    <input type="radio" id="classificationA" name="PE_PCR_DTBR_3_Classification" value="A">
                                    <label for="classificationA">A</label>
                                </div>

                                <div style="margin-bottom: 6px;">
                                    <input type="radio" id="classificationB" name="PE_PCR_DTBR_3_Classification" value="B">
                                    <label for="classificationB">B</label>
                                </div>

                                <div style="margin-bottom: 6px;">
                                    <input type="radio" id="classificationC" name="PE_PCR_DTBR_3_Classification" value="C">
                                    <label for="classificationC">C</label>
                                </div>

                                <div style="margin-bottom: 6px;">
                                    <input type="radio" id="classificationD" name="PE_PCR_DTBR_3_Classification" value="D">
                                    <label for="classificationD">D</label>
                                </div>

                                <button type="button" class="clearBtn"
                                        style="background:none; border:none; color:red; cursor:pointer; font-size:12px;"
                                        onclick="document.querySelectorAll('input[name=&quot;PE_PCR_DTBR_3_Classification&quot;]').forEach(r => r.checked = false);document.querySelectorAll('input[name=&quot;RequirementStatus&quot;]').forEach(x => {
                                            x.checked = false;
                                            x.disabled = true;
                                        });
                                    ">
                                    Clear
                                </button>

                                <div id="requirementError" class="invalid-feedback" style="display: none; margin-top: 5px;">
                                    Please select at least one document to be reviewed.
                                </div>


                            </div>


                            <!-- RIGHT: REQUIREMENTS -->
                            <div id="requirementSection" style="font-size:12px; padding-left:50px;">

                                <p style="margin:0 0 10px 0; font-size: 14px;">If Rank A, B, C</p>

                                <div style="margin-bottom: 6px; font-size: 14px;">
                                    <input type="radio" id="reqComplete" name="RequirementStatus" value="Complete" disabled>
                                    <label for="reqComplete">Requirement Complete</label>
                                </div>

                                <div style="margin-bottom: 6px; font-size: 14px;">
                                    <input type="radio" id="reqNotComplete" name="RequirementStatus" value="NotComplete" disabled>
                                    <label for="reqNotComplete">Requirement not yet complete</label>
                                </div>

                                <div id="dtbrClassificationError" class="invalid-feedback" style="display: none; margin-top: 5px;">
                                    Please select a Requirement.
                                </div>

                            </div>

                        </div>


                    </td>

                    <td style="height: 30px; text-align: center; vertical-align: top; padding: 10px;">
                        Approval
                    </td>
                </tr>

                <tr>
                    <td style="width:20%; text-align:center; vertical-align:middle; padding:10px;">
                        <div style="margin:10px;">
                            <div id="approvalBtnContainer">
                                <button type="button" id="approvalBtn" class="status" style="background-color:#ffe69c; padding:2px 20px; border-radius:12px; font-size:12px; font-weight:bold; border: none; cursor: pointer;">Mark as Signed</button>
                            </div>
                            <p id="approverSignDate" class="text-xs text-gray-500 mt-2"></p>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 0; vertical-align: middle; text-align: center;">
                        <div style="padding:4px;">
                            @if (ViewBag.PEManager != null)
                            {
                                <input type="hidden" name="PE_PCR_Approval_Head.PE_Manager_NIK" value="@ViewBag.PEManager.NIK">
                                <p id="peManagerName" class="text-sm">@ViewBag.PEManager.Name</p>
                            }
                            else
                            {
                                <input type="hidden" name="PE_PCR_Approval_Head.PE_Manager_NIK" value="">
                                <p id="peManagerName" class="text-sm">PE Manager Not Found</p>
                            }
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <input type="hidden" id="peNik" name="PE_PCR_Approval_Head.PE_NIK" value="@ViewBag.Usernik" />
    <input type="hidden" id="peName" name="PE_PCR_Approval_Head.PE_Name" value="@ViewBag.Fullname" />

</form>
