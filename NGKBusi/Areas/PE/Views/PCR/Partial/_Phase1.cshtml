$("#approvedBtn").on("click", function () {
    if (!approvalData || $(this).prop('disabled')) return;

    const currentNik = "@ViewBag.Usernik";
    const approverNikFromDb = approvalData.Approver_NIK;
    const approverNameFromDb = approvalData.Approver_Name;

    // Cek issuer sudah sign
    if (approvalData.First_Status_ID !== 2 || (approvalData.Second_Status_ID !== 2 && approvalData.Second_Status_ID !== 4)) {
        Swal.fire("Action Cannot Be Completed", "Both First and Second Issuers must sign before you can approve.", "warning");
        return;
    }

    // Cek apakah user = approver
    if (currentNik !== approverNikFromDb) {
        Swal.fire("Access Denied!", "You are not allowed to sign as approver.", "warning");
        return;
    }

    Swal.fire({
        title: 'Confirm Approval',
        text: 'Do you want to sign or reject this document?',
        icon: 'question',
        showCancelButton: true,
        showDenyButton: true,
        confirmButtonText: 'Sign',
        denyButtonText: 'Reject',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#3085d6',
        denyButtonColor: '#d33',
    }).then((result) => {
        if (result.isConfirmed) {
            sendApproveAction(approverNikFromDb, approverNameFromDb, 2);
        } else if (result.isDenied) {
            Swal.fire({
                title: 'Write Rejection Message',
                input: 'textarea',
                inputPlaceholder: 'Write the reason for rejection here...',
                showCancelButton: true,
                confirmButtonText: 'Submit',
                cancelButtonText: 'Cancel',
                preConfirm: (rejectMessage) => {
                    if (!rejectMessage) {
                        Swal.showValidationMessage('Rejection message cannot be empty.');
                    }
                    return sendApproveAction(approverNikFromDb, approverNameFromDb, 3, rejectMessage);
                }
            });
        }
    });
});

function sendApproveAction(nik, name, statusId, rejectMessage = null) {
    const headId = new URLSearchParams(window.location.search).get("headId");

    showLoadingState("#approvedBtn", true, "Sign");

    return $.ajax({
        url: '@Url.Action("Approve", "PCR", new { area = "PE" })',
        type: 'POST',
        data: {
            headId: headId,
            nik: nik,
            name: name,
            status: statusId,
            rejectMessage: rejectMessage
        }
    }).done(function (res) {
        if (res.success) {
            Swal.fire("Success!", res.message, "success").then(() => location.reload());
        } else {
            Swal.showValidationMessage(`Request failed: ${res.message}`);
        }
    }).fail(function (xhr) {
        Swal.showValidationMessage(`Server error: ${xhr.statusText}`);
    }).always(function () {
        showLoadingState("#approvedBtn", false, "Signed");
    });
}


    // --- FUNGSI VALIDASI UTAMA YANG DIMODIFIKASI ---
    function validateForm() {
        let isValid = true; // Tetap true sampai ada kesalahan
        let firstInvalidElement = null;

        // --- 1. RESET SEMUA STATUS ERROR (TIDAK ADA PERUBAHAN) ---
        $('.is-invalid').removeClass('is-invalid');
        $('.tinymce-invalid').removeClass('tinymce-invalid');
        $('.select2-container').removeClass('is-invalid');
        $('#conditionGroup').css('background-color', '');
        $('#conditionError').hide().text('');
        $('#classificationError').hide().text('');
        $('#classificationTable').css('background-color', '');
        $('#bcpv').css('background-color', '');
        $('#dtbrv').css('background-color', '');
        $('#dtbrClassificationError').hide();
        $('#dropZoneLabel').css('border-color', '');
        $('.invalid-feedback').hide();

        // --- HELPER FUNCTIONS UNTUK MENANDAI ERROR ---
        // Hapus logika 'if (isValid)' di dalamnya
        // Modifikasi fungsi markInvalid
        function markInvalid(selector, message) {
            $(selector).addClass('is-invalid');
            $(selector).next('.invalid-feedback').text(message).show();
            if (firstInvalidElement === null) {
                firstInvalidElement = selector;
            }
            isValid = false;
        }

        function markInvalidSelect2(selector, message) {
            $(selector).next('.select2-container').addClass('is-invalid');
            $(selector).parent().find('.invalid-feedback').text(message).show();
            if (firstInvalidElement === null) {
                firstInvalidElement = $(selector).next('.select2-container')[0];
            }
            isValid = false;
        }

        function markInvalidTinyMce(id, message) {
            const editorContainer = tinymce.get(id).getContainer();
            $(editorContainer).addClass('tinymce-invalid');
            $(editorContainer).parent().find('.invalid-feedback').text(message).show();
            if (firstInvalidElement === null) {
                firstInvalidElement = editorContainer;
            }
            isValid = false;
        }

        function markInvalidGroup(containerSelector, errorSelector, message) {
            $(containerSelector).css('background-color', '#fff1f1');
            $(errorSelector).show().text(message);
            if (firstInvalidElement === null) {
                firstInvalidElement = containerSelector;
            }
            isValid = false;
        }

        function isTinyMceEmpty(editorId) {
            const editor = tinymce.get(editorId);
            if (!editor) return true;
            const html = editor.getContent().trim();
            const clean = html.replace(/<p>(&nbsp;|\s)*<\/p>/gi, '').trim();
            return clean === '';
        }

        function markInvalidDate(selector, labelSelector, message) {
            $(selector).addClass('is-invalid');
            $(labelSelector).addClass('is-invalid-label');
            $(selector).next('.invalid-feedback').text(message).show();
            if (firstInvalidElement === null) {
                firstInvalidElement = selector;
            }
            isValid = false;
        }

        // --- 2. JALANKAN SEMUA VALIDASI SATU PER SATU ---
        // Setiap kali ada kesalahan, panggil fungsi markInvalid, dan biarkan `isValid` diubah di dalam fungsi markInvalid.
        // Lanjutkan ke validasi berikutnya.

        // -- Bagian Head & Purpose --
        if ($('#title').val().trim() === '') markInvalid('#title', 'Title is required.');
        if ($('#product').val().trim() === '') markInvalid('#product', 'Product is required.');
        if ($('#line').val().trim() === '') markInvalid('#line', 'Line is required.');
        if ($('#purpose').val().trim() === '') markInvalid('#purpose', 'Purpose is required.');

        // -- Bagian Approval --
        if ($('#approvedBy').val() === '' || $('#approvedBy').val() === null) {
            markInvalidSelect2('#approvedBy', 'Please select a user for Approved By.');
        }
        if ($('#secondIssuer').val() === '' || $('#secondIssuer').val() === null) {
            markInvalidSelect2('#secondIssuer', 'Please select a user for Issued By.');
        }

        // -- Bagian Part & BCP & Forecast --
        if ($('#appliedPart').val().trim() === '') markInvalid('#appliedPart', 'Applied Part is required.');
        if ($('#model').val().trim() === '') markInvalid('#model', 'Model is required.');
        if ($('#partNo').val().trim() === '') markInvalid('#partNo', 'Part No is required.');
        if ($('input[name="BCP"]:checked').length === 0) {
            markInvalidGroup('#bcpv', '#bcpError', 'Please choose at least one business class.');
        }
        if ($('#forecast').val() === '') markInvalid('#forecast', 'Forecast is required.');

        // --- Bagian Condition ---
        const isTemporary = $('#conditionTemporary').is(':checked');
        const isPermanent = $('#conditionPermanent').is(':checked');

        if (!isTemporary && !isPermanent) {
            // highlight seluruh group
            markInvalidGroup('#conditionGroup', '#conditionError', 'Please choose a condition.');
        } else if (isTemporary && $('#temporaryDate').val() === '') {
            // khusus kalau temporary, validasi tanggal
            markInvalidDate('#temporaryDate', '#temporaryDateLabel span', 'Please specify the date for temporary condition.');
        }

        // -- Bagian Detail --
        if ($('#currentStatement').val().trim() === '') markInvalid('#currentStatement', 'Current Statement is required.');
        if ($('#futureStatement').val().trim() === '') markInvalid('#futureStatement', 'Future Statement is required.');
        if (isTinyMceEmpty('currentSketch')) markInvalidTinyMce('currentSketch', 'Current Sketch is required.');
        if (isTinyMceEmpty('futureSketch')) markInvalidTinyMce('futureSketch', 'Future Sketch is required.');
        if ($('#planDate').val() === '') markInvalid('#planDate', 'Plan date is required.');
        if ($('#currentCost').val() === '') markInvalid('#currentCost', 'Current cost is required.');
        if ($('#futureCost').val() === '') markInvalid('#futureCost', 'Future cost is required.');

        // -- Bagian Classification (Table) --
        if ($('#classificationTable input[type="radio"]:checked').length === 0) {
            markInvalidGroup('#classificationTable', '#classificationError', 'Please check the classification at least one.');
        }

        //// -- Bagian DTBR --
        //if ($('input[name="DTBRCheckbox"]:checked').length === 0) {
        //    markInvalidGroup('#DTBRV', '#dtbrError', 'Please select at least one document to be reviewed.');
        //}
        //if ($('input[name="PE_PCR_DTBR_3_Classification"]:checked').length === 0) {
        //    markInvalidGroup('#classificationV', '#dtbrClassificationError', 'Please select a DTBR classification.');
        //}
        //if ($('#dtbrOthers').is(':checked') && $('#dtbrOthersText').val().trim() === '') {
        //    markInvalid('#dtbrOthersText', 'Others description is required.');
        //}

        // -- Bagian Attachment --
        if (uploadedFiles.length === 0 && $('#fileList').children().length === 0) {
            markInvalidGroup('#dropZoneLabel', '#attachmentError', 'File is required.');
        }

        // --- 3. SCROLL & TOAST HANYA JIKA ADA KESALAHAN ---
        // Logika scroll dan toast sekarang dipindahkan ke akhir fungsi,
        // setelah semua validasi selesai.
        if (firstInvalidElement) {
            const offset = $(firstInvalidElement).offset().top - 100;
            $('html, body').animate({
                scrollTop: offset
            }, 500);
            showToast('Please fill out all required fields.'); // Satu toast untuk semua kesalahan
        }

        // Kembalikan hasil validasi
        return isValid;
    }

            // A standalone function to validate only the Doc No field
    function validateByPE() {
        let isValid = true;
        let firstInvalidElement = null;

        // --- Validasi DocNo ---
        const docNoSelect = $('#docNo');
        docNoSelect.removeClass('is-invalid');
        docNoSelect.next('.invalid-feedback').hide();

        if (docNoSelect.val().trim() === '') {
            docNoSelect.addClass('is-invalid');
            docNoSelect.next('.invalid-feedback').text('Doc No is required.').show();
            if (!firstInvalidElement) firstInvalidElement = docNoSelect;
            isValid = false;
        }

        // --- Validasi DTBR ---
        if ($('#DTBRV').is(':visible')) {
            // Validasi Requirement (hanya untuk Rank A/B/C)
            const selectedClass = $('input[name="PE_PCR_DTBR_3_Classification"]:checked').val();

            if (["A", "B", "C"].includes(selectedClass)) {

                if ($('input[name="RequirementStatus"]:checked').length === 0) {
                    markInvalidGroup('#requirementSection', '#requirementError', 'Please select requirement status for A, B, or C.');
                    if (!firstInvalidElement) firstInvalidElement = $('#requirementSection');
                    isValid = false;
                }

            }

            // Validasi Checkbox DTBR
            if ($('input[name="DTBRCheckbox"]:checked').length === 0) {
                markInvalidGroup('#DTBRV', '#dtbrError', 'Please select at least one document to be reviewed.');
                if (!firstInvalidElement) firstInvalidElement = $('#DTBRV');
                isValid = false;
            }

            // Validasi Klasifikasi DTBR
            if ($('input[name="PE_PCR_DTBR_3_Classification"]:checked').length === 0) {
                markInvalidGroup('#classificationV', '#dtbrClassificationError', 'Please select a classification.');
                if (!firstInvalidElement) firstInvalidElement = $('#classificationV');
                isValid = false;
            }

            // Validasi Others
            if ($('#dtbrOthers').is(':checked') && $('#dtbrOthersText').val().trim() === '') {
                markInvalid('#dtbrOthersText', 'Others description is required.');
                if (!firstInvalidElement) firstInvalidElement = $('#dtbrOthersText');
                isValid = false;
            }
        }

        // --- Scroll + Toast jika gagal ---
        if (!isValid && firstInvalidElement) {
            const offset = $(firstInvalidElement).offset().top - 100;
            $('html, body').animate({ scrollTop: offset }, 500);
            showToast('Please fill out all required fields.');
        }

        return isValid;
    }

    // --- Fungsi Helper (Pastikan Anda memiliki fungsi ini di file Anda) ---
    function markInvalidGroup(groupSelector, errorSelector, message) {
        $(errorSelector).text(message).show();
        showToast(message);
        // Tambahkan logika untuk menandai grup sebagai invalid jika diperlukan
        // Contoh: $(groupSelector).find('.form-control, .form-check-input').addClass('is-invalid');
    }

    function markInvalid(selector, message) {
        const element = $(selector);
        element.addClass('is-invalid');
        element.next('.invalid-feedback').text(message).show();
        showToast(message);
    }

