function saveByPE(peStatusId, deptData) {
    const urlParams = new URLSearchParams(window.location.search);
    const headId = urlParams.get("headId") || 0;

    const approvals = window.lastFormData && window.lastFormData.Approvals && window.lastFormData.Approvals.length > 0
        ? window.lastFormData.Approvals[0]
        : null;

    const formData = new FormData();
    formData.append("headId", headId);

    // --- HEAD ---
    formData.append("docNo", $('#docNo').val() || '');
    formData.append('Product', $('#product').val());
    formData.append('Line', $('#line').val());
    formData.append('Dept', deptData || window.deptDataForSave || '');
    formData.append('Title', $('#title').val());
    formData.append('Purpose', $('#purpose').val());
    formData.append('Applied_Part', $('#appliedPart').val());
    formData.append('Model', $('#model').val());
    formData.append('Part_No', $('#partNo').val());
    formData.append('BCP', $('input[name="BCP"]:checked').map(function () { return $(this).val(); }).get().join(', '));
    formData.append('Remark', $('#remark').val());
    formData.append('Forecast', parseInt($('#forecast').val() || 0));

    formData.append("nik", $("#peNik").val() || "");
    formData.append("name", $("#peName").val() || "");
    formData.append("peStatusId", peStatusId);

    // --- Ambil data Condition & TemporaryDate ---
    let conditionVal = $('input[name="Condition"]:checked').val() || '';
    if (conditionVal === 'Temporary') {
        const tmpDate = $('#temporaryDate').val();
        conditionVal = `Temporary, (${tmpDate})`;
        formData.append('TemporaryDate', tmpDate);
    }
    formData.append('Condition', conditionVal);

    // --- Ambil data Detail ---
    formData.append('Detail.Current_Statement', $('#currentStatement').val() || '');
    formData.append('Detail.Current_Sketch', window.tinymce ? tinymce.get('currentSketch').getContent() : $('#currentSketch').val() || '');
    formData.append('Detail.Current_Cost', $('#currentCost').val() || '');
    formData.append('Detail.Future_Statement', $('#futureStatement').val() || '');
    formData.append('Detail.Future_Sketch', window.tinymce ? tinymce.get('futureSketch').getContent() : $('#futureSketch').val() || '');
    formData.append('Detail.Future_Cost', $('#futureCost').val() || '');
    formData.append('Detail.Plan', $('#planDate').val() || '');

    // --- Ambil data Approvals ---
    formData.append('First_Issued_NIK', approvals ? approvals.First_Issued_NIK || '' : '');
    formData.append('First_Issued_Name', approvals ? approvals.First_Issued_Name || '' : '');
    formData.append('Approved_By_NIK', $('#approvedBy').val() || '');
    formData.append('Second_Issued_By_NIK', $('#secondIssuer').val() || '');


    const classArr = [];
    $('input[name^="PE_PCR_Classification"][type="radio"]:checked').each(function () {
        const name = $(this).attr('name');
        const index = name.match(/\[(\d+)\]/)[1];
        const masterIdValue = $(`input[name="PE_PCR_Classification[${index}].Master_ID"]`).val();

        // hindari duplikat Master_ID
        const existing = classArr.find(c => c.Master_ID === masterIdValue);
        if (!existing) {
            classArr.push({ Master_ID: masterIdValue, Status: $(this).val() });
        }
    });
    formData.append('PE_PCR_Classification', JSON.stringify(classArr));



    //// --- Ambil data CLASSIFICATION ---
    //const classArr = [];
    //$('input[name^="PE_PCR_Classification"][type="radio"]:checked').each(function () {
    //    const name = $(this).attr('name');
    //    const index = name.match(/\[(\d+)\]/)[1];
    //    const masterIdValue = $(`input[name="PE_PCR_Classification[${index}].Master_ID"]`).val();
    //    classArr.push({ Master_ID: masterIdValue, Status: $(this).val() });
    //});
    //formData.append('PE_PCR_Classification', JSON.stringify(classArr));

    //// --- Ambil data DTBR ---
    //const dtbrArr = [];
    //const classification = $('input[name="PE_PCR_DTBR_3_Classification"]:checked').val() || '';
    //$('input[name="DTBRCheckbox"]:checked').each(function () {
    //    const id = $(this).val();
    //    const isOthers = (id === "0");
    //    dtbrArr.push({
    //        Head_ID: headId,
    //        DTBR_ID: isOthers ? 0 : parseInt(id),
    //        Status: isOthers ? 'Others' : $(this).data('name'),
    //        Classification: classification,
    //        Other_Description: isOthers ? $('#dtbrOthersText').val().trim() : null
    //    });
    //});
    //formData.append("DTBRs", JSON.stringify(dtbrArr));

    // --- Ambil data FILES (Lama & Baru) ---
    const filesToKeep = [];
    $('#fileList a').each(function () {
        const fileName = $(this).find('span').text().trim();
        if (fileName) {
            filesToKeep.push(fileName);
        }
    });
    filesToKeep.forEach(name => formData.append("ExistingFilenames", name));

    if (typeof uploadedFiles !== 'undefined') {
        uploadedFiles.forEach(file => {
            formData.append("files", file, file.name);
        });
    }

    showLoadingState("#saveByPE", true, "Save");

    $.ajax({
        url: '@Url.Action("SaveByPE", "PCR", new { area = "PE" })',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
            if (res.success) {
                Swal.fire("Success!", res.message, "success").then(() => {
                    location.reload();
                });
            } else {
                Swal.fire("Error!", res.message, "error");
            }
        },
        error: function () {
            Swal.fire("Error!", "A server error occurred.", "error");
        },
        complete: function () {
            showLoadingState("#saveByPE", false, "Save");
        }
    });
}
// ======================
// Approver
// ======================
$("#approvalBtn").on("click", function () {
    if (!approvalData || $(this).prop('disabled')) {
        return;
    }

    if (!validateByPE()) {
        return;
    }

    const headId = new URLSearchParams(window.location.search).get("headId");
    const currentNik = "@ViewBag.Usernik";
    const currentName = "@ViewBag.Fullname";

    const peManagerNik = $('input[name="PE_PCR_Approval_Head.PE_Manager_NIK"]').val();

    const approverStatusId = approvalData.Approver_Status_ID;
    const firstStatusId = approvalData.First_Status_ID;
    const secondStatusId = approvalData.Second_Status_ID;
    const peStatusId = approvalData.PE_Status_ID;

    // --- Validations ---
    if (firstStatusId !== 2 || (secondStatusId !== 2 && secondStatusId !== 4)) {
        return Swal.fire("Action Cannot Be Completed", "Both First and Second Issuers must sign before you can approve.", "warning");
    }
    if (approverStatusId !== 2) {
        return Swal.fire("Approval Not Allowed!", "This document must be signed by the Approver first before you can proceed.", "warning");
    }
    if (peStatusId !== 2) {
        return Swal.fire("Approval Not Allowed!", "PE must mark this document as 'Fix' before you can sign as PE Manager.", "warning");
    }
    if (currentNik !== peManagerNik) {
        return Swal.fire("Access Denied!", "You are not authorized to sign as the PE Manager.", "warning");
    }

    // === Swal with 4 options ===
    Swal.fire({
        title: "Confirm Approval",
        text: "Choose your action for this document.",
        icon: "question",
        showCancelButton: true,
        showDenyButton: true,
        confirmButtonText: "Sign",
        denyButtonText: "Reject",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#3085d6",
        denyButtonColor: "#d33",
        html: `
            <button id="holdBtn" class="swal2-styled" style="background:#f6ad55;margin-top:10px;">Hold</button>
        `,
        didRender: () => {
            // add listener for hold button
            document.getElementById("holdBtn").addEventListener("click", () => {
                Swal.fire({
                    title: "Write Hold Message",
                    input: "textarea",
                    inputPlaceholder: "Reason for hold...",
                    showCancelButton: true,
                    confirmButtonText: "Submit"
                }).then(res => {
                    if (res.isConfirmed && res.value) {
                        sendApprovalAction(headId, currentNik, currentName, 5, res.value); // 5 = Hold
                    }
                });
            });
        }
    }).then((result) => {
        if (result.isConfirmed) {
            // ✅ Sign
            sendApprovalAction(headId, currentNik, currentName, 2, null);
        } else if (result.isDenied) {
            // ❌ Reject
            Swal.fire({
                title: "Write Rejection Message",
                input: "textarea",
                inputPlaceholder: "Reason for rejection...",
                showCancelButton: true,
                confirmButtonText: "Submit"
            }).then(res => {
                if (res.isConfirmed && res.value) {
                    sendApprovalAction(headId, currentNik, currentName, 3, res.value); // 3 = Reject
                }
            });
        }
        // ❎ Cancel → auto close
    });
});

// helper
function sendApprovalAction(headId, nik, name, status, message) {
    showLoadingState("#approvalBtn", true, "Mark as Signed");

    const formData = new FormData();

    // --- Ambil data CLASSIFICATION ---
    const classArr = [];
    $('input[name^="PE_PCR_Classification"][type="radio"]:checked').each(function () {
        const name = $(this).attr('name');
        const index = name.match(/\[(\d+)\]/)[1];
        const masterIdValue = $(`input[name="PE_PCR_Classification[${index}].Master_ID"]`).val();
        classArr.push({ Master_ID: masterIdValue, Status: $(this).val() });
    });
    formData.append('PE_PCR_Classification', JSON.stringify(classArr));

    // --- Ambil data DTBR ---
    const dtbrArr = [];
    const classification = $('input[name="PE_PCR_DTBR_3_Classification"]:checked').val() || '';
    $('input[name="DTBRCheckbox"]:checked').each(function () {
        const id = $(this).val();
        const isOthers = (id === "0");

        // Tentukan isRequire
        let isRequire = 0;
        if (classification === "A" || classification === "B" || classification === "C") {
            const req = $('input[name="RequirementStatus"]:checked').val();
            if (req === "Complete") isRequire = 1;
            else if (req === "NotComplete") isRequire = 2;
        }

        dtbrArr.push({
            Head_ID: headId,
            DTBR_ID: isOthers ? 0 : parseInt(id),
            Status: isOthers ? 'Others' : $(this).data('name'),
            Classification: classification,
            Other_Description: isOthers ? $('#dtbrOthersText').val().trim() : null,
            isRequire: isRequire
        });
    });

    const requirementVal = $('input[name="RequirementStatus"]:checked').val() || null;
    formData.append("RequirementStatus", requirementVal);
    formData.append("DTBRs", JSON.stringify(dtbrArr));

    // --- Tambah parameter utama ---
    formData.append("headId", headId);
    formData.append("nik", nik);
    formData.append("name", name);
    formData.append("status", status);
    formData.append("rejectMessage", message);

    $.ajax({
        url: '@Url.Action("SignPE", "PCR", new { area = "PE" })',
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
            if (res.success) {
                Swal.fire("Success!", res.message, "success").then(() => location.reload());
            } else {
                Swal.fire("Error!", res.message, "error");
            }
        },
        error: function () {
            Swal.fire("Error!", "A server error occurred.", "error");
        },
        complete: function () {
            showLoadingState("#approvalBtn", false, "Mark as Signed");
        }
    });
}

// Fungsi showLoadingState (pastikan ini ada di kode Anda)
function showLoadingState(buttonSelector, isLoading, originalText) {
    const button = $(buttonSelector);
    const icon = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';

    if (isLoading) {
        button.prop("disabled", true).html(`${icon} Loading...`);
    } else {
        button.prop("disabled", false).text(originalText);
    }
}

    function showToast(message) {
        const toast = $('#toast-warning');
        const toastMessage = $('#toast-message');

        toastMessage.text(message);
        toast.fadeIn('fast');

        setTimeout(function () {
            toast.fadeOut('fast');
        }, 5000);
    }

});

