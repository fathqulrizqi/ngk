$(document).off('click', '#saveDraftBtn').on('click', '#saveDraftBtn', function (e) {
    e.preventDefault();

    // Get headId from URL (?headId=85)
    const urlParams = new URLSearchParams(window.location.search);
    const headId = urlParams.get("headId") || 0;

    if (window.tinymce) {
        tinymce.triggerSave();
    }
    const dept = "@ViewBag.CostName";

    const formData = new FormData();
    const approvals = window.lastFormData && window.lastFormData.Approvals && window.lastFormData.Approvals.length > 0
        ? window.lastFormData.Approvals[0]
        : null;

     // --- First Issue info (required) ---
     formData.append('First_Issued_NIK', "@ViewBag.Usernik");
     formData.append('First_Issued_Name', "@ViewBag.Fullname");

     const approverNIK = $('#approvedBy').val();
     const secondIssuerNIK = $('#secondIssuer').val();

     formData.append('Approved_By_NIK', approverNIK);
     formData.append('Second_Issued_By_NIK', secondIssuerNIK);

    // --- Condition & TemporaryDate ---
    let conditionVal = $('input[name="Condition"]:checked').val() || '';
    if (conditionVal === 'Temporary') {
        const tmpDate = $('#temporaryDate').val();
        conditionVal = `Temporary, (${tmpDate})`;
        formData.append('TemporaryDate', tmpDate);
    }
    formData.append('Condition', conditionVal);

    // --- HEAD ---
    formData.append('Product', $('#product').val());
    formData.append('Line', $('#line').val());
    formData.append('Dept', dept);
    formData.append('Title', $('#title').val());
    formData.append('Purpose', $('#purpose').val());
    formData.append('Applied_Part', $('#appliedPart').val());
    formData.append('Model', $('#model').val());
    formData.append('Part_No', $('#partNo').val());
    formData.append('BCP', $('input[name="BCP"]:checked').map(function(){ return $(this).val(); }).get().join(', '));
    formData.append('Remark', $('#remark').val());
    formData.append('Forecast', parseInt($('#forecast').val() || 0));

    // --- Detail ---
    formData.append('Detail.Current_Statement', $('#currentStatement').val());
    formData.append('Detail.Current_Sketch', tinymce.get('currentSketch').getContent());
    formData.append('Detail.Current_Cost', $('#currentCost').val());
    formData.append('Detail.Future_Statement', $('#futureStatement').val());
    formData.append('Detail.Future_Sketch', tinymce.get('futureSketch').getContent());
    formData.append('Detail.Future_Cost', $('#futureCost').val());
    formData.append('Detail.Plan', $('#planDate').val());

    // --- CLASSIFICATION ---
    const classArr = [];
    $('input[name^="PE_PCR_Classification"][type="radio"]:checked').each(function () {
