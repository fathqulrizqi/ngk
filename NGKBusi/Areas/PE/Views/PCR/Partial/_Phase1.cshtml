                            <div class="invalid-feedback">Forecast is required.</div>
                        </div>
                    </td>
                </tr>
        </table>

        <div id="classificationError" class="invalid-feedback" style="display: none; margin-bottom: 5px;">
            Please check the classification at least one.
        </div>
        <table id="classificationTable" style="margin-top: -1px; border-collapse: collapse;" border="1" cellspacing="0" cellpadding="5">
            <thead>
                <tr><td colspan="8" class="center-text" style="font-weight:bold;">CLASSIFICATION</td></tr>
                <tr class="center-text">
                    <td colspan="2" style="font-weight: bold;">Item</td>
                    <td style="width: 120px">New</td>
                    <td style="width: 120px">Additional</td>
                    <td style="width: 120px">Change</td>
                    <td style="width: 120px">Replacement</td>
                    <td style="width: 120px">Delete</td>
                    <td style="width: 120px">Action</td>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.ClassificationList != null)
                {
                    var classifications = (List<NGKBusi.Areas.PE.Models.PE_PCR_Classification_Master>)ViewBag.ClassificationList;
                    for (int i = 0; i < classifications.Count; i++)
                    {
                        var item = classifications[i];
                        <tr>
                            <td class="center-text">@(i + 1)</td>

                            <td>
                                @item.Classification_Name
                                <input type="hidden" name="PE_PCR_Classification[@i].Master_ID" value="@item.ID" />
                            </td>

                            <td class="center-text">
                                <input type="radio" name="PE_PCR_Classification[@i].Status" value="New" />
                            </td>

                            <td class="center-text">
                                <input type="radio" name="PE_PCR_Classification[@i].Status" value="Additional" />
                            </td>
                            <td class="center-text">
                                <input type="radio" name="PE_PCR_Classification[@i].Status" value="Change" />
                            </td>
                            <td class="center-text">
                                <input type="radio" name="PE_PCR_Classification[@i].Status" value="Replacement" />
                            </td>
                            <td class="center-text">
                                <input type="radio" name="PE_PCR_Classification[@i].Status" value="Delete" />
                            </td>
                            <td class="center-text">
                                <button type="button" class="clearBtn"
                                        style="background:none; border:none; color:red; cursor:pointer;"
                                        onclick="document.querySelectorAll('input[name=&quot;PE_PCR_Classification[@i].Status&quot;]').forEach(r => r.checked = false);">
                                    Clear
                                </button>
                            </td>

                        </tr>
                    }
                }
            </tbody>

        </table>



        <table style="margin-top: -1px;">
            <thead>
                <tr><td colspan="8" class="center-text" style="font-weight:bold;">DETAIL</td></tr>
                <tr class="center-text">
                    <td style="width: 10%; font-weight: bold;">Info</td>
                    <td style="width: 45%; font-weight: bold;">Current Condition</td>
                    <td style="width: 45%; font-weight: bold;">Future Condition</td>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="height: 120px; text-align:center; vertical-align:middle; font-weight:bold;">Statement simple</td>
                    <td>
                        <textarea id="currentStatement" name="Current_Statement" rows="4" class="resize-none block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300" placeholder="Write current condition statement here..."></textarea>
                        <div class="invalid-feedback">Current Statement is required.</div>
                    </td>
                    <td>
                        <textarea id="futureStatement" name="Future_Statement" rows="4" class="resize-none block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300" placeholder="Write future condition statement here..."></textarea>
                        <div class="invalid-feedback">Future Statement is required.</div>
                    </td>
                </tr>
                <tr>
                    <td style="text-align:center; vertical-align:middle; font-weight:bold;">Picture / Sketch SIMPLE</td>
                    <td style="vertical-align:top;">
                        <p style="font-weight:bold; font-size:12px; margin:0; color: white; text-align: left;">Impacted to (Please Choose):</p>
                        <p style="font-weight: bold; font-size: 12px; margin: 0; color: white; text-align: center;">Q C D S M P E</p>
                        <textarea id="currentSketch" name="Current_Sketch" rows="4" style="height: 300px;" class="resize-none block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300" placeholder="Write current condition sketch here..."></textarea>
                    </td>
                    <td style="vertical-align:top;">
                        <p style="font-weight:bold; font-size:12px; margin:0; text-align: left;">Impacted to (Please Choose):</p>
                        <p style="font-weight:bold; font-size:12px; margin:0; text-align: center;">Q C D S M P E</p>
                        <textarea id="futureSketch" name="Future_Sketch" rows="4" style="height: 300px;" class="resize-none block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300" placeholder="Write future condition sketch here..."></textarea>
                    </td>
                </tr>
                <tr>
                    <td style="text-align:center; vertical-align:middle; font-weight:bold;">Cost</td>
                    <td>
                        <div id="currentCostWrapper" style="display: flex; align-items: center; gap: 10px;">
                            <span style="vertical-align: middle; font-weight:bold;">Cost:</span>
                            <input type="text" id="currentCost" name="Current_Cost"
                                   placeholder="Current condition cost"
                                   class="block w-full p-2 text-gray-900 text-normal border border-gray-300 rounded-lg bg-gray-50 text-xs">
                            <div class="invalid-feedback">Current cost is required.</div>
                        </div>
                    </td>

                    <td>
                        <div id="futureCostWrapper" style="display: flex; align-items: center; gap: 10px;">
                            <span style="vertical-align: middle; font-weight: bold;">Cost:</span>
                            <input type="text" id="futureCost" name="Future_Cost"
                                   placeholder="Future condition cost"
                                   class="block w-full p-2 text-gray-900 text-normal border border-gray-300 rounded-lg bg-gray-50 text-xs">
                            <div class="invalid-feedback">Future cost is required.</div>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

        <table style="margin-top: -1px;">
            <thead>
                <tr><td colspan="3" class="center-text" style="font-weight:bold;">TIME</td></tr>
            </thead>
            <tbody>
                <tr>
                    <td style=" text-align:center; vertical-align:middle; font-weight:bold;">Time</td>
                    <td>
                        <div id="planDateContainer" style="display: flex; align-items: center; gap: 10px;">
                            <span style="vertical-align: middle; font-weight: bold;">PLAN:</span>
                            <input type="date" id="planDate" name="Plan" class="form-control form-control-sm border-black" style="max-width:200px;">
                            <div class="invalid-feedback">Plan date is required.</div>
                        </div>
                    </td>
                    <td>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="vertical-align: middle; font-weight: bold;">ACTUAL:</span>
                            <input disabled type="date" id="actualDate" name="Actual" class="form-control form-control-sm border-black" style="max-width:200px;">
                            <div class="invalid-feedback">Actual date is required.</div>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>


        <table style="margin-top: -1px;">
            <thead>
                <tr>
                    <td class="text-center font-bold">ATTACHMENT FILES</td>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="p-4">
                        <div class="flex items-center justify-center w-full">
                            <label for="dropzone-file" id="dropZoneLabel" class="flex flex-col items-center justify-center w-full h-32 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 transition-colors">
                                <div class="flex flex-col items-center justify-center">
                                    <svg class="w-8 h-8 mb-4 text-gray-500" aria-hidden="true" xmlns="http://www.w.org/2000/svg" fill="none" viewBox="0 0 20 16">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2" />
                                    </svg>
                                    <p class="mb-2 text-sm text-gray-500"><span class="font-semibold">Click to upload</span> or drag and drop</p>
                                    <p class="text-xs text-gray-500">Bisa lebih dari satu file (PDF)</p>
                                </div>
                                <input id="dropzone-file" type="file" class="hidden" multiple />
                            </label>
                        </div>
                        <div id="attachmentError" class="invalid-feedback">File is required.</div>


                        <div id="fileList" class="mt-4"></div>
                    </td>
                </tr>
            </tbody>
        </table>

        <table style="margin-top: -1px; width:100%; border-collapse: collapse;" border="1">
            <thead>
                <tr>
                    <td style="width: 30%; font-weight: bold; font-size: 14px;">DOCUMENT TO BE REVIEWED</td>
