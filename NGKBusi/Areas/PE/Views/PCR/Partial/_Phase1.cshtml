                           onclick="document.getElementById('info').style.display=document.getElementById('info').style.display==='block'?'none':'block'">
                        </i>

                        <div id="info" style="display:none; position:absolute; top:25px; left:0; background:#333; color:white; padding:10px; border-radius:5px; font-size:12px; font-weight:normal; white-space:nowrap; z-index:1000;">
                            A = Customer Approval & Localization Request Required<br>
                            B = Customer Approval Required<br>
                            C = Localization Request Required<br>
                            D = Internal Approval Required
                        </div>
                    </td>
                    <td style="width: 20%; font-weight: bold; font-size: 14px; text-align:center;">PE MANAGER CONFIRMATION</td>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td rowspan="3" style="vertical-align: top; padding: 10px;">
