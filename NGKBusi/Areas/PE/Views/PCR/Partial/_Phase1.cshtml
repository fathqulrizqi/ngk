$("#IssuedBtn2").on("click", function() {
    // --- Validasi Awal untuk Menangani Error "undefined" ---
    // Periksa apakah data utama dan data 'Approvals' ada sebelum melanjutkan
    if (!window.lastFormData || !window.lastFormData.Approvals || window.lastFormData.Approvals.length === 0) {
        Swal.fire({
            title: "Access Denied!",
            text: "First Issuer must sign the document first.",
            icon: "warning"
        });
        return;
    }

    // Ambil data persetujuan setelah dipastikan ada
    const approvalData = window.lastFormData.Approvals[0];

    // Cek jika tombol dinonaktifkan
    if ($(this).prop('disabled')) {
        return;
    }

    const currentNik = "@ViewBag.Usernik";
    const secondIssuerNikFromDb = approvalData.Second_Issued_NIK;

    // --- Validasi 1: Periksa Status Tanda Tangan First Issuer ---
    if (approvalData.First_Status_ID !== 2) {
        Swal.fire({
            title: "Action Cannot Be Complete!",
            text: "The First Issuer must sign this document before you can proceed.",
            icon: "warning"
        });
        return;
    }

    // --- Validasi 2: Periksa Kesesuaian NIK Current User dengan Second Issuer ---
    if (currentNik !== secondIssuerNikFromDb) {
        Swal.fire({
            title: "Access Denied!",
            text: "You are not authorized to sign as the Second Issuer.",
