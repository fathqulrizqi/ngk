                      focus:ring-blue-500 focus:border-blue-500">
                            </div>
                        </div>

                    </td>
                    <td style="width:15%; padding:5px;">
                        <p style="font-weight:bold; font-size:12px; margin:0;">FORECAST (monthly):</p>
