        for (let i = 0; i < fileInput.files.length; i++) {
            formDataManagement.append("files", fileInput.files[i]);
        }
    }

    $.ajax({
        url: "@Url.Action("SaveManagementApproval", "PCR", new { area = "PE" })",
        type: "POST",
        data: formDataManagement,
        processData: false,
        contentType: false,
        success: function (res) {
