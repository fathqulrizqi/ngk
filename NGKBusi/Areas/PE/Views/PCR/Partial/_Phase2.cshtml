<script>
$(document).ready(function () {
    // ==================== GLOBAL VARIABLES ====================
    const currentUserNik = "@ViewBag.Usernik";
    const currentUserName = "@ViewBag.Fullname";
    const peList = peManagerList.map(u => u.NIK);
    const isPEUser = peList.includes(currentUserNik);
    const urlParams = new URLSearchParams(window.location.search);
    const headId = urlParams.get("headId");

    let uploadedFiles = [];
    const fileUrlMap = new Map();
    const fileInput = $('#concernFileInput');
    window.managementApprovalData = null;

    // ==================== INITIALIZATION ====================
    if (headId && headId !== "0") {
        loadPhase2Data();
    }

    // ==================== MAIN FUNCTIONS ====================
function loadPhase2Data() {
    $.ajax({
        url: "@Url.Action("GetPhase2Data", "PCR", new { area = "PE" })",
        type: "GET",
        data: { headId: headId },
        success: function (res) {
            if (res && res.success) {
                let baseDateString = null;
                // --- LOGIKA BARU: Ambil Timestamps dari concern pertama ---
                if (res.Concerns && res.Concerns.length > 0) {
                    // Cari Timestamps dari concern pertama (first or default)
                    baseDateString = res.Concerns[0].Timestamps;
                }
                // --- LOGIKA DUE DATE BERAKHIR ---

                // --- REVISI: PARSE & SIMPAN APPROVED DATE DARI BASE DATE ---
                if (baseDateString) {
                    // Cek format tanggal (Date() untuk JSON atau string langsung)
                    if (baseDateString.startsWith('/Date(')) {
                        const ticks = parseInt(baseDateString.replace(/\/Date\((\d+)\)\//, "$1"));
                        window.approvedDate = new Date(ticks);
                    } else {
                        window.approvedDate = new Date(baseDateString);
                    }
                } else {
                    window.approvedDate = null;
                }
                // -----------------------------------------------------------

                // Panggil handleDueDate dengan baseDateString yang baru
                handleDueDate(baseDateString);

                if (res.Concerns) {
                    const originatorNik = res.Originator;
                    // Kirim window.approvedDate ke mapPhase2DataToTable
                    mapPhase2DataToTable(res.Concerns, res.Approval_ID, originatorNik, window.approvedDate);
                }

                // Atur izin user
                handleUserPermissions(res.Approval_ID);
            }
        },
        error: function (xhr, status, error) {
            console.error("Error GetPhase2Data:", error);
        }
    });

    // --- Ambil data management approval ---
    $.ajax({
        url: "@Url.Action("GetManagementApproval", "PCR", new { area = "PE" })",
        type: "GET",
        data: { headId: headId },
        success: function (res) {
            if (res.success) {
                window.managementApprovalData = res.data;
                mapApprovalDataToUI(res.data);
                mapFilesToUI(res.data.Files, res.data.Head_ID);
            }
        },
        error: function (xhr) {
            console.error("Error fetching approval:", xhr);
        }
    });
    }


    function handleDueDate(baseDateString) {
        if (!baseDateString) {
            $('#dueDateText').text("-");
            $('#remainingTime').text("-");
            return;
        }

        let baseDate;
        // Logic untuk parsing string tanggal (bisa format /Date() atau string ISO)
        if (baseDateString.startsWith('/Date(')) {
            const ticks = parseInt(baseDateString.replace(/\/Date\((\d+)\)\//, "$1"));
            baseDate = new Date(ticks);
        } else {
            // Gunakan moment.js untuk parsing string ISO (seperti yang Anda tunjukkan: 2025-10-09 08:44:56.733)
            baseDate = moment(baseDateString, "YYYY-MM-DD HH:mm:ss.SSS").toDate();
        }

        const dueDate = new Date(baseDate);
        dueDate.setDate(dueDate.getDate() + 7);

        $('#dueDateText').text(dueDate.toLocaleString());

        // Hentikan interval lama jika ada
        if (window.countdownTimer) {
            clearInterval(window.countdownTimer);
        }

        function updateCountdown() {
            const now = new Date();
            const diff = dueDate - now;

            if (diff <= 0) {
                $('#remainingTime').text("Expired").css("color", "red");
                clearInterval(window.countdownTimer);
                return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            const display = `${days}d ${hours}h ${minutes}m ${seconds}s`;
            const color = days === 0 ? "orange" : "green";

            $('#remainingTime').text(display).css("color", color);
        }

        updateCountdown();
        // Simpan timer ke variabel global agar bisa dihentikan nanti
        window.countdownTimer = setInterval(updateCountdown, 1000);
    }
    function handleUserPermissions(currentApprovalId) {
        if (currentApprovalId === 7 && isPEUser) {
            $('#saveConcernUsers').removeAttr('hidden');
        } else {
            $('#saveConcernUsers').attr('hidden', true);
        }
    }

    function mapApprovalDataToUI(approval) {
        if (!approval) return;

        const managers = [
            {
                level: 1,
                nik: approval.M1_NIK,
                status: approval.M1_Status,
                name: approval.M1_Name,
                date: approval.M1_Date,
                notes: approval.M1_Notes,
                message: approval.M1_Message
            },
            {
                level: 2,
                nik: approval.M2_NIK,
                status: approval.M2_Status,
                name: approval.M2_Name,
                date: approval.M2_Date,
                notes: approval.M2_Notes,
                message: approval.M2_Message
            },
            {
                level: 3,
                nik: approval.M3_NIK,
                status: approval.M3_Status,
                name: approval.M3_Name,
                date: approval.M3_Date,
                notes: approval.M3_Notes,
                message: approval.M3_Message
            }
        ];

        managers.forEach(mgr => {
            // ✅ Map date kalau ada
            if (mgr.date) {
                $(`#date-level-${mgr.level}`).text(formatDate(mgr.date));
            }

            // Map notes/comment
            if (mgr.notes) {
                $(`textarea[data-level="${mgr.level}"]`).val(mgr.notes);
            }

            const levelToColumn = {
                1: 1,
                2: 3,
                3: 2
            };

            if (mgr.name) {
                const col = levelToColumn[mgr.level];
                $(`#managerTable tfoot td:nth-child(${col}) p`).text(mgr.name);
            }

            // ✅ Button status
            // ✅ Button status
            const $btn = $(`button.approve-btn[data-level="${mgr.level}"]`);
            if (mgr.status === 2) {
                // signed: box hijau dengan icon centang
                $btn
                    .removeClass("bg-yellow-600")
                    .addClass("bg-green-600 cursor-default") // Ubah ke hijau
                    .prop("disabled", true)
                    .html('<i class="fas fa-check mr-1"></i> Signed'); // Gunakan .html() untuk FontAwesome
            } else if (mgr.status === 3) {
                // rejected: box merah dengan icon silang
                $btn
                    .removeClass("bg-yellow-600")
                    .addClass("bg-red-600 cursor-default")
                    .prop("disabled", true)
                    .html('<i class="fas fa-times mr-1"></i> Rejected'); // Icon X untuk rejected

                // reject message
                if (mgr.message) {
                    if ($btn.next(".reject-msg").length === 0) {
                        $btn.after(
                            `<p class="reject-msg text-red-600 text-sm mt-2">${mgr.message}</p>`
                        );
                    } else {
                        $btn.next(".reject-msg").text(mgr.message);
                    }
                }
            } else if (mgr.status === 4 || mgr.status === 5) {
                // hold
                $btn
                    .removeClass("bg-yellow-600")
                    .addClass("bg-orange-500");

                // ganti text sesuai status (sekalian ditambah icon panah kembali)
                if (mgr.status === 4) {
                    $btn.html('<i class="fas fa-undo mr-1"></i> Return to PE');
                } else if (mgr.status === 5) {
                    $btn.html('<i class="fas fa-undo mr-1"></i> Return to Originator');
                }

                // tampilkan notes/hold message
                if (mgr.message) {
                    if ($btn.next(".reject-msg").length === 0) {
                        $btn.after(
                            `<p class="reject-msg text-orange-600 text-sm mt-2">${mgr.message}</p>`
                        );
                    } else {
                        $btn.next(".reject-msg").text(mgr.message);
                    }
                }

            }

            if (mgr.status !== 0) {
                $(`input.file-input[data-level="${mgr.level}"]`).hide();
            }
        });
    }

    function mapFilesToUI(files, headId) {
        if (!Array.isArray(files) || files.length === 0) return;

        $(".file-preview").empty();

        // simpan level yang sudah punya file
        const levelsWithFile = new Set();

        files.forEach(file => {
            const level = file.M_Level;
            const fileName = file.File_Name;
            const isPdf = fileName.toLowerCase().endsWith(".pdf");

            levelsWithFile.add(level);

            const $input = $(`input.file-input[data-level="${level}"]`);
            const $preview = $input.closest("td").find(".file-preview");

            if ($preview.length === 0) return;

            const fileUrl = isPdf
                ? `@Url.Action("PreviewPdf", "PCR")?headId=${headId}&fileName=${encodeURIComponent(fileName)}`
                : `/Files/PE/PCR/${headId}/${encodeURIComponent(fileName)}`;

            const fileHtml = `
                <div class="flex items-center p-2 mb-2 border rounded-lg bg-white shadow-sm max-w-[320px]">
                    <i class="pr-2 fa-solid fa-file-pdf text-red-500"></i>
                    <a href="${fileUrl}"
                       ${isPdf ? 'target="_blank"' : 'download'}
                       class="truncate text-blue-600 hover:underline max-w-[280px]">
                        ${fileName}
                    </a>
                </div>
            `;

            $preview.append(fileHtml);
        });


    }


    function formatDate(dateString) {
        if (!dateString) return "-";
        const d = new Date(dateString);
        return d.toLocaleDateString("en-GB", {
            day: "2-digit",
            month: "long",
            year: "numeric"
        });
    }


    function mapPhase2DataToTable(approvalsData, currentApprovalId, originatorNik, approvedDate) {
        if (!approvalsData) approvalsData = [];
        const dataArray = Array.isArray(approvalsData) ? approvalsData : [approvalsData];

        // Map existing data
        dataArray.forEach(item => {
            const $cell = $(`td [data-deptid='${item.deptId}']`).closest('td');
            if (!$cell.length) return;

            // TERUSKAN originatorNik & approvedDate
            updateCellData($cell, item, currentApprovalId, originatorNik, approvedDate);
        });

        // Handle cells without data (tidak perlu approvedDate di sini)
        $("td [data-deptid]").each(function () {
            const deptId = $(this).data("deptid");
            const found = dataArray.some(x => x.deptId === deptId);
            if (!found) {
                handleEmptyCell($(this).closest("td"), currentApprovalId);
            }
        });
    }


    function updateCellData($cell, item, currentApprovalId, originatorNik) {
        let calculatedIsLate = false;

        if (item.Timestamps && item.Signer_Date) {
            // Parse timestamps
            let parsedTimestamp = item.Timestamps.startsWith("/Date(")
                ? moment(parseInt(item.Timestamps.replace(/\/Date\((\d+)\)\//, "$1")))
                : moment(item.Timestamps);

            // Parse signer date
            let parsedSignerDate = item.Signer_Date.startsWith("/Date(")
                ? moment(parseInt(item.Signer_Date.replace(/\/Date\((\d+)\)\//, "$1")))
                : moment(item.Signer_Date);

            // Hitung selisih hari antara Signer_Date dan Timestamps
            const diffDays = parsedSignerDate.diff(parsedTimestamp, 'days');
            if (diffDays > 7) {
                calculatedIsLate = true;
            }
        }
        const $nameContainer = $cell.find('.name-container');
        const $textarea = $cell.find('textarea.comment-text');
        const $dateP = $(`#DateP_${item.deptId}`);
        const $buttonChoose = $cell.find('button.choose-btn');
        const $buttonMarkAsSigned = $cell.find('button.mark-btn');
        const $buttonReminder = $cell.find('button.reminder-btn');

        // --- Reset visibility ---
        $buttonChoose.hide();
        $buttonMarkAsSigned.hide();
        $textarea.prop("disabled", false);
        $buttonReminder.hide();

        // Pastikan container terlihat jika ada data
        $cell.find("div.name-container").prop("hidden", false);
        $cell.find("textarea.comment-text").prop("hidden", false);

        if (item.Signer_NIK && (item.Status_ID === 2 || item.Status_ID === 6)) {
            $nameContainer.html(`
            <p class="inline-block text-gray-800">${item.Signer_Name}</p>
            <input type="hidden" name="SelectedUser_${item.deptId}" value="${item.Signer_NIK}" />
        `);
            $textarea.prop("disabled", true);
        } else if (item.Signer_NIK && (item.Status_ID === 1)) {
            $nameContainer.html(`
     <p class="inline-block text-gray-800">${item.Signer_Name}</p>
     <input type="hidden" name="SelectedUser_${item.deptId}" value="${item.Signer_NIK}" />
 `);
        }
        else {
            if ($nameContainer.find('p').length) {
                if (item.Signer_NIK) {
                    $nameContainer.find('select').val(item.Signer_NIK);
                    $nameContainer.find('select').trigger('change');
                }
            } else if (item.Signer_NIK) {
                $nameContainer.find('select').val(item.Signer_NIK);
                $nameContainer.find('select').trigger('change');
            }
        }

        // --- Komentar ---
        if (item.Comment) {
            $textarea.val(item.Comment);
        }

        // --- Tanggal Signer ---
        if (item.Signer_Date && $dateP.length && (item.Status_ID === 2 || item.Status_ID === 6)) {
            $dateP.text(moment(item.Signer_Date).format('M/D/YYYY'));
        } else {
            $dateP.text(''); // Kosongkan jika belum signed/verified
        }

        // --- Logika Tombol (berdasarkan item.Status_ID) ---
        switch (item.Status_ID) {
            case 1: // Pending
                if (currentApprovalId == 11) {

                    // SHOW REMINDER BUTTON (only if PE)
                    if (isPEUser) {
                        $buttonReminder.show()
                            .removeClass()
                            .addClass("reminder-btn mb-2 bg-orange-500 text-white rounded-full px-3 py-1 font-bold cursor-pointer")
                            .attr("data-deptid", item.deptId)
                            .text("Send Reminder");
                    } else {
                        $buttonReminder.hide(); // Hide for non-PE
                    }

                    // Mark as Signed logic (tetap)
                    $buttonMarkAsSigned.show()
                        .removeClass()
                        .addClass("mark-btn bg-yellow-600 text-white rounded-full px-3 py-1 font-bold cursor-pointer")
                        .text("Mark as Signed")
                        .attr("data-signernik", item.Signer_NIK || "")
                        .attr("data-deptid", item.deptId);
                }
                break;

            case 2: // Signed
                if (item.Status_ID === 2) { // Signed
                    if (calculatedIsLate) {
                        $buttonMarkAsSigned.show()
                            .removeClass()
                            .addClass("mark-btn bg-yellow-500 text-white rounded-full px-3 py-1 mx-auto font-bold cursor-default text-center flex justify-center items-center")
                            .html('<i class="fa-solid fa-triangle-exclamation text-yellow-200 mr-1"></i> Signed Late')
                            .prop("disabled", true)
                            .attr("data-signernik", item.Signer_NIK)
                            .attr("data-deptid", item.deptId);
                    } else {
                        $buttonMarkAsSigned.show()
                            .removeClass()
                            .addClass("mark-btn mx-auto bg-blue-500 text-white rounded-full px-3 py-1 font-bold cursor-default text-center flex justify-center items-center")
                            .text("Signed")
                            .prop("disabled", true)
                            .attr("data-signernik", item.Signer_NIK)
                            .attr("data-deptid", item.deptId);
                    }
                    $(`#originPS_${item.deptId}`).removeAttr('hidden');
                }
                break;

            case 6: // Verified
                const headIdparse = parseInt(urlParams.get("headId") || "0", 10);

                // Tombol Verified utama
                $buttonMarkAsSigned.show()
                    .removeClass()
                    .addClass("mark-btn verified-btn bg-green-600 text-white rounded-full px-3 py-1 font-bold cursor-default")
                    .html('<i class="fa-solid fa-circle-check"></i> Verified')
                    .prop("disabled", true)
                    .attr("data-signernik", item.Signer_NIK)
                    .attr("data-deptid", item.deptId);

                // ➕ Tombol info di sebelah Verified
                const infoBtn = $(`
        <button class="info-btn bg-blue-500 text-white rounded-full px-2 py-1 ml-2"
                data-headid="${headIdparse}"
                data-deptid="${item.deptId}"
                title="View Concern Detail">
            <i class="fa-solid fa-info-circle"></i>
        </button>
    `);
                $buttonMarkAsSigned.siblings(".info-btn").remove(); // hapus jika sudah ada sebelumnya
                $buttonMarkAsSigned.after(infoBtn);

                // readonly comment
                $(`#Comment_${item.deptId}`).prop("readonly", true);

                // --- Cek late signed ---
                let parsedSignerDate = item.Signer_Date
                    ? (item.Signer_Date.startsWith("/Date(")
                        ? moment(parseInt(item.Signer_Date.replace(/\/Date\((\d+)\)\//, "$1")))
                        : moment(item.Signer_Date))
                    : null;

                let parsedTimestamp = item.Timestamps
                    ? (item.Timestamps.startsWith("/Date(")
                        ? moment(parseInt(item.Timestamps.replace(/\/Date\((\d+)\)\//, "$1")))
                        : moment(item.Timestamps))
                    : null;

                if (parsedSignerDate && parsedTimestamp) {
                    const diffDays = parsedSignerDate.diff(parsedTimestamp, "days");
                    const $lateMsg = $cell.find(".signed-late");

                    if (diffDays > 7) {
                        $lateMsg.show(); // tampilkan pesan late
                    } else {
                        $lateMsg.hide(); // sembunyikan jika tidak late
                    }
                }
                break;

            default: // Rejected / No Need / undefined / status lain
                $buttonChoose.show()
                    .removeClass().addClass("choose-btn bg-purple-600 text-white rounded-full px-3 py-1 font-bold cursor-default").text("No Need").prop("disabled", true);
                $textarea.prop("disabled", true); // Biasanya disabled jika Rejected/No Need
                break;
        }
    }
    function updateButtonsBasedOnStatus($cell, item, currentApprovalId, originatorNik) {
        const $buttonChoose = $cell.find('button.choose-btn');
        const $buttonMarkAsSigned = $cell.find('button.mark-btn');
        const $textarea = $cell.find('textarea.comment-text');

        if (!item || !item.Status_ID) {
            $buttonChoose.hide();
            $buttonMarkAsSigned.hide();
            return; // Exit the function immediately
        }
        // Reset buttons
        $buttonChoose.hide();
        $buttonMarkAsSigned.hide();

        switch (item.Status_ID) {
            case 1: // Pending
                if (currentApprovalId == 11) {
                    handlePendingStatusPhase11($buttonChoose, $buttonMarkAsSigned, $textarea, item);
                }
                break;
            case 2: // Signed
                handleSignedStatus($buttonMarkAsSigned, $textarea, item);
                break;
            case 5: // Awaiting Submission
                handleAwaitingSubmissionStatus($buttonMarkAsSigned, $textarea, item);
                break;
            case 6: // Verified
                handleVerifiedStatus($buttonMarkAsSigned, $textarea, item);
                break;
            case 7: // Submitted
                handleSubmittedStatusOrigin($buttonMarkAsSigned, $textarea, item, originatorNik);
                break;
            default: // No Need/Rejected
                handleDefaultStatus($buttonChoose);
        }
    }

    // Tanda tangan fungsi tetap sama
    function handleSubmittedStatusOrigin($buttonMarkAsSigned, $textarea, item, originatorNik) {
        const cleanCurrentUserNik = currentUserNik ? currentUserNik.trim() : null;
        const cleanOriginatorNik = originatorNik ? originatorNik.trim() : null;

        // 2. Lakukan perbandingan menggunakan NIK yang sudah bersih
        const isCurrentUserOriginator = (cleanCurrentUserNik && cleanOriginatorNik && cleanCurrentUserNik === cleanOriginatorNik);

        // console.log("Is Current User Originator:", isCurrentUserOriginator); // Gunakan ini untuk debugging

        $textarea.prop("disabled", true);

        $buttonMarkAsSigned.show()
            .removeClass()
            .attr("data-headid", headId)
            .attr("data-deptid", item.deptId);

        if (isCurrentUserOriginator) {
            $buttonMarkAsSigned
                .addClass("submission-ready origin-verify-btn bg-green-600 text-white rounded-full px-3 py-1 font-bold cursor-pointer")
                .html('<i class="fa-solid fa-check-to-slot"></i> Verify Submission')
                .prop("disabled", false); // HARUSNYA ENABLE
        } else {
            $buttonMarkAsSigned
                .addClass("origin-verify-btn bg-gray-500 text-white rounded-xl px-3 py-1 font-bold cursor-default")
                .html('<i class="fa-solid fa-file-export"></i> Submitted')
                .prop("disabled", false);
        }
    }
    function handlePendingStatusPhase7($buttonChoose, $buttonMarkAsSigned, item) {
        if (item.Signer_NIK) {
            $buttonChoose.show()
                .removeClass()
                .addClass("choose-btn needed bg-blue-500 text-white rounded-full px-3 py-1 font-bold cursor-pointer")
                .text("Needed")
                .prop("disabled", false);
        } else {
            $buttonChoose.show()
                .removeClass()
                .addClass("choose-btn no-need bg-gray-400 text-white rounded-full px-3 py-1 font-bold cursor-pointer")
                .text("No Need")
                .prop("disabled", false);
        }
        $buttonMarkAsSigned.hide();
    }

    function handlePendingStatusPhase11($buttonChoose, $buttonMarkAsSigned, item) {
        $buttonMarkAsSigned.show()
            .removeClass()
            .addClass("mark-btn bg-yellow-600 text-white rounded-full px-3 py-1 font-bold cursor-pointer")
            .text("Mark as Signed")
            .prop("disabled", false)
            .attr("data-signernik", item.Signer_NIK || "")
            .attr("data-deptid", item.deptId);
        $buttonChoose.hide();
        $textarea.prop("disabled", true);

    }

    function handleSignedStatus($buttonMarkAsSigned, $textarea, item) {
        $buttonMarkAsSigned.show()
            .removeClass()
            .addClass("mark-btn bg-green-500 text-white rounded-full px-3 py-1 font-bold cursor-default")
            .text("Signed")
            .prop("disabled", true)
            .attr("data-signernik", item.Signer_NIK)
            .attr("data-deptid", item.deptId);

        $textarea.prop("disabled", true);
        $(`#originPS_${item.deptId}`).removeAttr('hidden');
    }

    function handleVerifiedStatus($buttonMarkAsSigned, $textarea, item) {
        $buttonMarkAsSigned.show()
            .removeClass()
            .addClass("mark-btn bg-green-600 text-white rounded-full px-3 py-1 font-bold cursor-default")
            .html('<i class="fa-solid fa-circle-check"></i> Verified')
            .prop("disabled", true)
            .attr("data-signernik", item.Signer_NIK)
            .attr("data-deptid", item.deptId);

        $textarea.prop("disabled", true);
    }

    function handleDefaultStatus($buttonChoose) {
        $buttonChoose.show()
            .removeClass()
            .addClass("choose-btn bg-purple-600 text-white rounded-full px-3 py-1 font-bold cursor-default")
            .text("No Need")
            .prop("disabled", true);
    }

    function handleEmptyCell($cell, currentApprovalId) {
        const $buttonChoose = $cell.find("button.choose-btn");
        const $buttonMark = $cell.find("button.mark-btn");

        if (currentApprovalId !== 7) {
            $cell.find("div.name-container").prop("hidden", true);
            $cell.find("textarea.comment-text").prop("hidden", true);
        } else {
            $cell.find("div.name-container").prop("hidden", false);
            $cell.find("textarea.comment-text").prop("hidden", false);
        }

        $buttonMark.hide();
        $buttonChoose.show()
            .removeClass()
            .addClass("choose-btn bg-gray-400 text-white rounded-full px-3 py-1 font-bold cursor-default no-need")
            .text("No Need")
            .prop("disabled", currentApprovalId !== 7);
    }

