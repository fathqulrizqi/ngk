                        <p class="text-left py-2">Notes:</p>
                        <textarea class="w-full h-64 rounded-sm p-1 border border-gray-300"
                                  data-level="2"
                                  data-targetnik="@(ViewBag.PlantManager != null ? ViewBag.PlantManager.NIK : "")"></textarea>
