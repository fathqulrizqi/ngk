                {
                    for (int i = 0; i < ViewBag.DeptWithUsers.Count; i += 2)
                    {
                        var leftDept = ViewBag.DeptWithUsers[i];
                        var rightDept = (i + 1 < ViewBag.DeptWithUsers.Count) ? ViewBag.DeptWithUsers[i + 1] : null;

                        <tr class="border-t border-gray-200">
                            <!-- Left Department -->
                            <td class="p-2 align-top">
                                <div class="flex flex-col min-h-[120px]">
                                    <div class="font-bold" data-deptid="@leftDept.ID">@leftDept.Name</div>
                                    <div class="mt-1 name-container">
                                        <p class="inline-block mr-2">Name:</p>
