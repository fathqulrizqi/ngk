                    Signer_Name: rightBtn.hasClass('needed') ? rightSelect.find('option:selected').text() || null : null,
                    StatusId: rightBtn.hasClass('needed') ? 1 : -1,
                    Comment: null
                });
            }

            return rows;
        }).get();

        if (!details.length) return Swal.fire("Info", "Nothing selected", "info");

        Swal.fire({
            title: "Confirm Action",
            text: "Choose the action you want to perform on the selected data.",
            icon: "question",
