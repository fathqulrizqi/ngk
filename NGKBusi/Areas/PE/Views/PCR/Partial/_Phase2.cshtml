                                        ""     // No message
                                    );
                                    Swal.fire("Returned to Originator", "", "success");
                                }
                            });
                        });
                    }

                }
            }).then((result) => {

                // SIGN
                if (result.isConfirmed) {
                    saveApproval(
                        headIdparse,
                        currentLevel,
                        currentUserNik,
                        currentUserName,
                        notes,
                        SIGNED_STATUS_ID,
                        ""
                    );
                }

                // REJECT
                else if (result.isDenied) {
                    Swal.fire({
                        title: "Reject Reason",
                        input: "textarea",
                        showCancelButton: true,
                        confirmButtonText: "Submit",
                    }).then((r) => {
                        if (r.isConfirmed && r.value) {
                            sessionStorage.setItem("activePhase", 2);
                            saveApproval(
                                headIdparse,
                                currentLevel,
                                currentUserNik,
                                currentUserName,
                                notes,
                                REJECTED_STATUS_ID,
                                r.value
                            );
                        }
                    });
                }
            });
        });

    // FILES
    const fileUrlMap3 = new Map();

$(document)
    .off("change", ".file-input")
    .on("change", ".file-input", function () {
        const input = this;
        const files = input.files;
        const $preview = $(input).closest("td").find(".file-preview");

        if (!files || files.length === 0) return;

        Array.from(files).forEach(file => {
            const objectUrl = URL.createObjectURL(file);
            fileUrlMap3.set(file.name, objectUrl);

            const isPdf = file.type === "application/pdf";

            const fileItemHTML = `
                <div class="flex justify-between max-w-[350px] items-center p-2 border rounded-lg mb-2 bg-white shadow-sm">
                    <a href="${objectUrl}"
                       ${isPdf ? 'target="_blank"' : 'download'}
                       class="truncate text-blue-600 max-w-[350px] hover:underline">
                        ${file.name}
                    </a>

                    <button type="button"
                            class="remove-file text-red-500 text-sm ml-3"
                            data-filename="${file.name}">
                        ✕
                    </button>
                </div>
            `;

            $preview.append(fileItemHTML);
        });
    });

    $(document).on("click", ".remove-file", function (e) {
        e.preventDefault();

        const fileName = $(this).data("filename");

        if (fileUrlMap3.has(fileName)) {
            URL.revokeObjectURL(fileUrlMap3.get(fileName));
            fileUrlMap3.delete(fileName);
        }

        $(this).closest("div").remove();
    });


});
</script>

