@{
    string currentUserNik = ViewBag.Usernik as string;

    bool isPEUser = ViewBag.UserPEList != null &&
    ((IEnumerable<dynamic>)ViewBag.UserPEList).Any(u => u.NIK == currentUserNik);
}

<script>
    var isPEUser = @(isPEUser.ToString().ToLower());
</script>

<script type="text/javascript">
    if (window.history.replaceState) {
        window.history.replaceState(null, null, window.location.href);
    }
</script>

<form id="phase2" method="post">
    <div id="rejectMessage" class="hidden bg-red-500 text-white text-sm font-semibold px-4 py-2 mb-3 rounded">
        This request has been <span class="font-bold">REJECTED</span>. Please check the remarks.
    </div>

    <div id="holdMessage" class="hidden bg-orange-500 text-white text-sm font-semibold px-4 py-2 mb-3 rounded">
        This request is currently <span class="font-bold">ON HOLD</span>.
    </div>
    <div class="form-container">
        <div id="dueDateContainer" class="mb-3 p-3 border rounded bg-gray-50">
            <p><strong>Due Date:</strong> <span id="dueDateText">-</span></p>
            <p><strong>Remaining Time:</strong> <span id="remainingTime">-</span></p>
        </div>

        <!-- Header Table -->
        <table id="HeadPCR">
            <thead>
                <tr>
                    <td rowspan="4" style="width:170px; padding:2px; text-align:center; vertical-align:middle;">
                        <img src="~/Images/niterra-id.png" alt="Niterra Logo" class="img-fluid" style="width:100%; max-width:170px; height:auto;" />
                    </td>
                    <td rowspan="2" style="padding:2px; text-align:center; vertical-align:middle; font-weight:bold; font-size:14px;">
                        FORMULIR INTEGRASI
                    </td>
                    <td style="padding: 2px; font-size: 10px;">No. Form</td>
                    <td style="padding: 2px; font-size: 10px;">PMLK3-PE-03/L1</td>
                </tr>
                <tr>
                    <td style="padding: 2px; font-size: 10px;">Revisi</td>
                    <td style="padding: 2px; font-size: 10px;">2</td>
                </tr>
                <tr>
                    <td rowspan="2" style="padding:2px; text-align:center; vertical-align:middle; font-size:14px;">
                        PROCESS CHANGE REQUEST SHEET
                    </td>
                    <td style="padding: 2px; font-size: 10px;">Tanggal</td>
                    <td style="padding: 2px; font-size: 10px;">5-Apr-23</td>
                </tr>
                <tr>
                    <td style="padding: 2px; font-size: 10px;">Halaman</td>
                    <td style="padding: 2px; font-size: 10px;">2/2</td>
                </tr>
            </thead>
        </table>

        <!-- Concerns Table -->
