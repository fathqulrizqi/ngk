    function handleFilesP2(files) {
        for (const file of files) {
            const extension = file.name.split('.').pop().toLowerCase();
            if (extension !== 'pdf') {
                Swal.fire({
                    icon: 'warning',
                    title: 'Invalid File',
                    text: 'Only PDF files are allowed (Phase 2).'
                });
                continue;
            }

            if (isDuplicateFileP2(file.name)) continue;

            uploadedFilesP2.push(file);
            const objectUrl = URL.createObjectURL(file);
            fileUrlMapP2.set(file.name, objectUrl);
        }
        renderUploadedFilesP2();
    }

    function isDuplicateFileP2(fileName) {
        return uploadedFilesP2.some(f => f.name === fileName) || existingFilesP2.includes(fileName);
    }

    // Hapus function renderUploadedFilesP2 (yang lama) dan ganti dengan logic ini:
    function renderUploadedFilesP2() {
        fileListP2.empty(); // Bersihkan container

        const currentHeadId = $('#submitConcernFileP2').data('headid') || urlParams.get("headId");
        const currentDeptId = $('#submitConcernFileP2').data('deptid');

        let totalFiles = 0;

        // 1. Existing files
        existingFilesP2.forEach(name => {
            fileListP2.append(buildFileItemHTMLP2(name, null, true, currentHeadId, currentDeptId));
            totalFiles++;
        });

        // 2. Newly uploaded files
        uploadedFilesP2.forEach(file => {
            const objectUrl = fileUrlMapP2.get(file.name);
            fileListP2.append(buildFileItemHTMLP2(file.name, objectUrl, false, currentHeadId, currentDeptId));
            totalFiles++;
        });

        if (totalFiles === 0) {
            fileListP2.html('<p class="text-gray-400 italic">No files uploaded yet</p>');
        }
    }
    // Di dalam <script> tag Anda:

    function buildFileItemHTMLP2(fileName, objectUrl, isExisting) {
        const fileIcon = getFileIconP2(fileName);
        const href = objectUrl || `/uploads/pcr/${fileName}`;

        return `
    <a href="${href}" target="_blank" rel="noopener noreferrer"
       class="file-item2 flex justify-between items-center p-2 border rounded-lg mb-2 bg-white shadow-sm cursor-pointer hover:bg-gray-50"
       data-filename="${fileName}" data-existing="${isExisting}">
        <div class="flex items-center gap-3 min-w-0">
            ${fileIcon}
            <span class="text-sm text-gray-700 truncate">${fileName}</span>
        </div>
        <div class="flex items-center gap-2">

            <button type="button" class="remove-file text-red-500 hover:text-red-700 font-bold z-10 pl-3"
                data-filename="${fileName}" data-existing="${isExisting}">&times;</button>
        </div>
    </a>
    `;
    }

    // Remove file
    fileListP2.on('click', '.remove-file', function (e) {
        e.preventDefault();
        const fileName = $(this).data('filename');
        const isExisting = $(this).data('existing');

        if (isExisting) {
            existingFilesP2 = existingFilesP2.filter(f => f !== fileName);
        } else {
            uploadedFilesP2 = uploadedFilesP2.filter(f => f.name !== fileName);
            if (fileUrlMapP2.has(fileName)) {
                URL.revokeObjectURL(fileUrlMapP2.get(fileName));
                fileUrlMapP2.delete(fileName);
            }
        }
        renderUploadedFilesP2();
    });

// File icon function (Font Awesome)
function getFileIconP2(fileName) {
    const extension = fileName.split('.').pop().toLowerCase();
    switch (extension) {
        case 'jpg': case 'jpeg': case 'png': case 'gif': case 'svg':
            return `<i class="fa-solid fa-file-image fa-lg text-blue-500"></i>`;
        case 'pdf':
            return `<i class="fa-solid fa-file-pdf fa-lg text-red-500"></i>`;
        case 'ppt': case 'pptx':
            return `<i class="fa-solid fa-file-powerpoint fa-lg text-orange-500"></i>`;
        case 'xls': case 'xlsx':
            return `<i class="fa-solid fa-file-excel fa-lg text-green-500"></i>`;
        case 'doc': case 'docx':
            return `<i class="fa-solid fa-file-word fa-lg text-sky-600"></i>`;
        default:
            return `<i class="fa-solid fa-file fa-lg text-gray-500"></i>`;
    }
}

    function renderExistingFilesP2(fileArray, headId, deptId) {
        const $container = $("#fileListP2");
        $container.empty();

        if (!fileArray || fileArray.length === 0) {
            $container.append(`<p class="text-sm text-gray-500 italic">No files uploaded yet.</p>`);
            return;
        }

        // Simpan ke global supaya bisa diakses upload function
        window.existingFilesP2 = fileArray;

        fileArray.forEach(fileName => {
            const encodedFileName = encodeURIComponent(fileName);
            const fileUrl = `/Files/PE/PCR/${headId}/${deptId}/${encodedFileName}`;
            const fileItemHTML = buildFileItemHTMLP2(fileName, fileUrl, true);
            $container.append(fileItemHTML);
        });

        // 🟢 Event: Preview (pakai SweetAlert)
        $(".file-item2 .text-blue-600,").off("click").on("click", function (e) {
            e.preventDefault();
            const fileUrl = $(this).data("url") || $(this).attr("href");
            Swal.fire({
                title: "File Preview",
                html: `<iframe src="${fileUrl}" style="width:100%;height:500px;border:none;"></iframe>`,
                width: "80%",
                showConfirmButton: false,
                showCloseButton: true
            });
        });

        // 🔴 Event: Remove (hapus dari DOM & array)
        $(".remove-file").off("click").on("click", function (e) {
            e.preventDefault();
            const fileName = $(this).data("filename");
            const isExisting = $(this).data("existing") === true || $(this).data("existing") === "true";

            // Hapus dari array global
            if (isExisting) {
                window.existingFilesP2 = window.existingFilesP2.filter(f => f !== fileName);
            }

            $(this).closest(".file-item2").remove();

            // Kalau sudah kosong → tampilkan teks placeholder
            if ($("#fileListP2 .file-item2").length === 0) {
                $container.append(`<p class="text-sm text-gray-500 italic">No files uploaded yet.</p>`);
            }
        });
    }

