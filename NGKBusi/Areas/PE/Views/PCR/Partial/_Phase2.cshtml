                                <button type="button"
                                        class="reminder-btn bg-orange-500 text-white rounded-full px-2 py-1 font-bold hidden"
                                        data-deptid="@leftDept.ID">
                                    <i class="fa-solid fa-bell mr-1"></i> Send Reminder
                                </button>

                                <button type="button"
                                        class="mark-btn mb-2 bg-yellow-600 text-white rounded-full mx-auto px-2 py-1 font-bold flex items-center justify-center"
                                        data-deptid="@leftDept.ID">
                                    <i class="fa-solid fa-triangle-exclamation text-yellow-200 mr-1"></i> Mark as Signed
                                </button>

                                <div class="signed-late text-red-600 text-sm mt-1 flex items-center justify-center gap-1" style="display:none;">
                                    <i class="fa-solid fa-triangle-exclamation"></i> Signed Late
                                </div>

                                <p id="originPS_@leftDept.ID"
                                   class="hover:underline origin-ps-message origin-ps-clickable mt-4 text-red-500 text-xs font-bold cursor-pointer"
                                   data-deptid="@leftDept.ID"
                                   hidden>
                                    P.S. ORIGINATOR WILL VERIFY YOUR CONCERN
                                </p>
                            </td>


                            <!-- Right Department -->
                            @if (rightDept != null)
                            {
                                <td class="p-2 align-top">
                                    <div class="flex flex-col min-h-[120px]">
                                        <div class="font-bold" data-deptid="@rightDept.ID">@rightDept.Name</div>
                                        <div class="mt-1 name-container">
                                            <p class="inline-block mr-2">Name:</p>
                                            @if (rightDept.Users != null && rightDept.Users.Count > 0)
                                            {
                                                <select name="SelectedUser_@rightDept.ID" class="user-select w-full border rounded px-2 py-1">
                                                    <option value="">-- Pilih User --</option>
                                                    @foreach (var u in rightDept.Users)
                                                    {
                                                        <option value="@u.NIK">@u.Name</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <p class="inline-block italic text-gray-400">(no user)</p>
                                            }
                                        </div>
                                        <textarea id="Comment_@rightDept.ID" name="Comment_@rightDept.ID"
                                                  class="comment-text mt-1 block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300"
                                                  placeholder="Write concern points here..."
                                                  style="height: 150px;"></textarea>

                                        <div id="CommentError_@rightDept.ID" class="text-red-500 text-sm mt-1 hidden">
                                            Comment is required.
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center align-middle p-2">
                                    <div class="date-container">
                                        <p class="text-sm" id="DateP_@rightDept.ID"></p>
                                    </div>
                                </td>
                                <td class="text-center align-middle p-2" data-id="@rightDept.ID">
                                    <button type="button" class="choose-btn no-need bg-gray-400 text-white rounded-full px-3 py-1 font-bold" data-deptid="@rightDept.ID" style="display: none;">
                                        No Need
                                    </button>

                                    <button type="button"
                                            class="reminder-btn mb-2 bg-orange-500 text-white rounded-full px-2 py-1 font-bold hidden"
                                            data-deptid="@rightDept.ID">
                                        <i class="fa-solid fa-bell mr-1"></i> Send Reminder
                                    </button>

                                    <button type="button"
                                            class="mark-btn bg-yellow-600 mx-auto text-white rounded-full px-2 py-1 font-bold flex items-center justify-center"
                                            data-deptid="@rightDept.ID">
                                        <i class="fa-solid fa-triangle-exclamation text-yellow-200 mr-1"></i> Mark as Signed
                                    </button>

                                    <div class="signed-late text-red-600 text-sm mt-1 flex items-center justify-center gap-1" style="display:none;">
                                        <i class="fa-solid fa-triangle-exclamation"></i> Signed Late
                                    </div>

                                    <p id="originPS_@rightDept.ID"
                                       class="hover:underline origin-ps-message origin-ps-clickable mt-4 text-red-500 text-xs font-bold cursor-pointer"
                                       data-deptid="@rightDept.ID"
                                       hidden>
