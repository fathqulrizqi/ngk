        Swal.fire({
            title: "Are you sure?",
            text: "Do you want to sign this document?",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "Yes, Sign it",
            cancelButtonText: "Cancel"
        }).then((result) => {
