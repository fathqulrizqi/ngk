                                </div>
                            </td>
                            <td class="text-center align-middle p-2" data-id="@leftDept.ID">
                                <button type="button" class="choose-btn no-need bg-gray-400 text-white rounded-full px-3 py-1 font-bold" data-deptid="@leftDept.ID" style="display: none;">
                                    No Need
