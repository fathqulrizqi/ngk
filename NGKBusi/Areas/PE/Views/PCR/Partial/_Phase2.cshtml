    $(document).on("click", ".info-btn", async function (event) {
        event.preventDefault();

        const headId = $(this).data("headid");
        const deptId = $(this).data("deptid");
        try {
            Swal.fire({
                title: "Loading...",
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            const res = await $.get('@Url.Action("GetDeptConcernDetail", "PCR", new { area = "PE" })', { headId, deptId });
            Swal.close();

            if (!res.success) {
                Swal.fire("Error", res.message || "Failed to load concern details.", "error");
                return;
            }

            const data = res.data;
            $("#originatorMessageContentP2").val(data.CommentOrigin || "");

            existingFilesP2 = [];
            uploadedFilesP2 = [];
            fileUrlMapP2.clear();

            const fileListP2 = $("#fileListP2");
            fileListP2.empty();

            if (data.Files) {
                const files = data.Files.split(",").map(f => f.trim()).filter(f => f);
                if (files.length > 0) {
                    files.forEach(fileName => {
                        existingFilesP2.push(fileName);
                        const previewUrl = `@Url.Action("PreviewFile", "PCR", new { area = "PE" })?headId=${headId}&deptId=${deptId}&fileName=${encodeURIComponent(fileName)}`;
                        fileListP2.append(buildFileItemHTMLP2(fileName, previewUrl, true, headId, deptId));
                    });
                } else {
                    fileListP2.html(`<p class="text-gray-400 italic">No files uploaded yet</p>`);
                }
            } else {
                fileListP2.html(`<p class="text-gray-400 italic">No files uploaded yet</p>`);
            }

            $("#fileUploadModalP2").removeClass("hidden").addClass("flex");
            $(`.file-item2[data-existing='true'] .remove-file`).hide();

            $("#submitConcernFileP2")
                .data("headid", headId)
                .data("deptid", deptId);

            $("#originatorMessageContentP2").prop("readonly", true);
            $("#dropzone-file-p2").closest("#dropZoneLabelP2").hide();
            $("#dropZoneLabelText").hide();
            $("#submitConcernFileP2").hide();
        } catch (err) {
