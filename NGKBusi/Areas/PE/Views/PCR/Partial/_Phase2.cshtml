                               data-level="3"
                               data-targetnik="@(ViewBag.QMManager != null ? ViewBag.QMManager.NIK : "")" />

                        <div class="file-preview mt-2"></div>
                    </td>

                    <td class="text-center p-2">

                        <input type="file"
                               name="files"
                               multiple
                               data-level="2"
                               class="file-input cursor-pointer max-w-[350px] bg-neutral-secondary-medium border border-default-medium text-sm rounded-base block w-full"
