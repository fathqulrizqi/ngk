                                            <p class="inline-block italic text-gray-400">(no user)</p>
                                        }
                                    </div>
                                    <textarea id="Comment_@leftDept.ID" name="Comment_@leftDept.ID"
                                              class="comment-text mt-1 block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300"
                                              placeholder="Write concern points here..."
