                <tr>
                    <th colspan="6" class="p-2 text-center font-bold text-gray-700">CONCERN POINTS</th>
                </tr>
                <tr class="text-center font-bold text-gray-700">
                    <td class="w-1/4 p-2">Department</td>
                    <td class="w-1/12 p-2">Date</td>
                    <td class="w-1/6 p-2">Sign</td>
                    <td class="w-1/4 p-2">Department</td>
                    <td class="w-1/12 p-2">Date</td>
                    <td class="w-1/6 p-2">Sign</td>
                </tr>
            </thead>
            <tbody>
