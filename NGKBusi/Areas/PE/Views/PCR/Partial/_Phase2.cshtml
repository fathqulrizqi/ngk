    // Mark as signed handler
    $(document).on("click", ".mark-btn", function () {
        const $btn = $(this);
        const departmentId = $btn.data("deptid");
        const signerNik = $btn.data("signernik");
        const $commentBox = $(`#Comment_${departmentId}`);
        const comment = $commentBox.val()?.trim() || "";
