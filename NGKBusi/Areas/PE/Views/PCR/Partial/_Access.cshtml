@{
    ViewBag.Title = "No Access";
    ViewBag.NavHide = false;
}

@section scriptHead {
    <script src="https://cdn.tailwindcss.com"></script>
}

<div class="w-full py-4 bg-white inline-flex flex-col justify-center items-center gap-2.5 overflow-hidden">
    <div class="self-stretch py-6 flex flex-col justify-center items-center gap-2.5">
        <img class="w-96 h-80" src="@Url.Content("~/Content/Images/no-access.png")" />
    </div>
    <div class="self-stretch flex flex-col justify-start items-center gap-8">
        <div class="self-stretch flex flex-col justify-start items-center gap-4">
            <div class="justify-start text-red-500 text-3xl font-bold font-bold">Login First!</div>
            <div class="justify-start text-black text-xl font-bold font-normal">Oops... You have to login to access to this page!</div>
        </div>

        <a href="~/User/Login"
           class="mt-4 inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded no-underline">
            Login Page
        </a>
    </div>
</div>