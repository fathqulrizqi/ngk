@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Mock variables for dynamic scaling concept
    var currentRole = "Deputy General Manager (DGM)";
    var subLevelName = "Senior Management Tier";
    var baseLevelName = "Department Managers";
}

<!-- Use Tailwind via CDN for enhanced styling -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        corePlugins: { preflight: false },
        theme: {
            extend: {
                colors: { 
                    ngk: {
                        primary: '#007581',
                        primaryLight: '#e0f3f5',
                        primaryDark: '#00555e',
                        accent: '#eeb500',
                        accentLight: '#fdf7e6'
                    }
                }
            }
        }
    }
</script>

<div class="container-fluid py-4 px-md-5">
    
    <!-- Top Bar: Context & Role -->
    <div class="mb-6 border-b border-slate-200 pb-5">
        <div class="flex items-center gap-2 text-sm text-slate-500 mb-4 font-medium">
            <a href="@Url.Action("Dashboard", "BCP")" class="hover:text-ngk-primary transition-colors">BCP Dashboard</a>
            <span>/</span>
            <a href="#" class="hover:text-ngk-primary transition-colors">Executive Phase</a>
            <span>/</span>
            <span class="text-ngk-primary font-semibold">Tier-1 Authorization</span>
        </div>

        <div class="flex flex-col xl:flex-row justify-between xl:items-end gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">Top-Tier Executive Review</h1>
                <p class="text-slate-500 mt-1 text-sm md:text-base font-medium">Step 6: Consolidating organizational review for <strong class="text-slate-700">BCP-2604-002</strong></p>
            </div>
            
            <div class="bg-gradient-to-r from-slate-800 to-slate-900 rounded-xl p-4 flex items-center gap-4 shadow-md border border-slate-700 relative overflow-hidden h-max w-max">
                <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center shrink-0 border border-white/20">
                    <i class="fas fa-user-tie text-xl text-yellow-400"></i>
                </div>
                <div class="relative z-10 pr-2">
                    <p class="text-[0.65rem] text-slate-400 font-bold uppercase tracking-widest leading-none mb-1">Current Authorization Level</p>
                    <h5 class="m-0 text-white font-extrabold tracking-wide">@currentRole</h5>
                </div>
                <div class="absolute right-0 top-0 h-full w-1/4 bg-gradient-to-l from-yellow-500/20 to-transparent"></div>
            </div>
        </div>
    </div>

    <!-- Main Dynamic Interface -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
        
        <!-- Left Side: Hierarchical Review Trail (The dynamic part) -->
        <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-6">
            
            <div class="flex items-center gap-2 mb-2">
                <i class="fas fa-stream text-ngk-primary"></i>
                <h4 class="font-extrabold text-slate-800 tracking-wide m-0">Consolidated Review Trail</h4>
                <span class="px-2.5 py-1 bg-slate-100 text-slate-500 text-[0.65rem] font-bold uppercase tracking-widest rounded ml-2">Dynamically Cascaded</span>
            </div>

            <!-- Tier 2 Review (Sr. Manager) Box -->
            <div class="bg-white border border-slate-200 shadow-sm rounded-2xl overflow-hidden relative">
                <!-- Visual Connector Line from Top -->
                <div class="absolute left-[39px] top-12 bottom-0 w-0.5 bg-slate-200 z-0"></div>

                <div class="p-6 relative z-10">
                    <!-- Tier Header -->
                    <div class="flex items-center justify-between mb-5">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-full bg-ngk-primary text-white flex items-center justify-center font-bold shadow-md z-10 border-4 border-white">
                                L2
                            </div>
                            <div>
                                <h6 class="font-extrabold text-slate-700 m-0 text-base">@subLevelName Appraisal</h6>
                                <p class="text-[0.7rem] text-slate-500 font-medium">Completed: Today, 11:45 AM</p>
                            </div>
                        </div>
                        <span class="px-3 py-1 bg-rose-50 text-rose-600 border border-rose-200 font-bold text-[0.65rem] uppercase tracking-widest rounded-lg shadow-sm">
                            <i class="fas fa-arrow-up mr-1"></i> Escalated to DGM
                        </span>
                    </div>

                    <!-- Sr Manager Verdict -->
                    <div class="pl-14">
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-6">
                            <div class="flex gap-3 mb-3">
                                <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center shrink-0">
                                    <i class="fas fa-user-shield text-slate-600 text-xs"></i>
                                </div>
                                <div>
                                    <h6 class="font-bold text-slate-800 text-sm m-0">Ikhsan Sholihin</h6>
                                    <p class="text-[0.65rem] text-slate-500 uppercase tracking-wider font-semibold">Sr. Manager - IT Dept</p>
                                </div>
                            </div>
                            <p class="text-sm text-slate-700 leading-relaxed italic border-l-4 border-ngk-primaryLight pl-3 m-0">
                                "Based on assessing the subordinate logs below, the IT Fire has completely severed Plant operations. I formally propose declaring a Level 2 Emergency (BCP Activation). We need the DGM's authorization to utilize the emergency redundant server budget."
                            </p>
                        </div>

                        <!-- Nested Tier 1 Review (Managers) -->
                        <div>
                            <h6 class="font-bold text-slate-600 uppercase text-[0.65rem] tracking-widest mb-3 flex items-center">
                                <i class="fas fa-level-down-alt text-slate-400 mr-2"></i> Nested Base Input (@baseLevelName)
                            </h6>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <!-- Manager 1 -->
                                <div class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm hover:border-ngk-primaryLight transition-colors">
                                    <div class="flex justify-between items-start mb-2">
                                        <div>
                                            <p class="font-bold text-slate-800 text-sm mb-0">Ahmad Fauzi</p>
                                            <p class="text-[0.65rem] text-slate-500 font-semibold uppercase">IT Infrastructure</p>
                                        </div>
                                        <span class="bg-rose-100 text-rose-700 text-xs font-bold px-2 py-0.5 rounded border border-rose-200 text-center">4.2<br><span class="text-[0.5rem] uppercase">Score</span></span>
                                    </div>
                                    <p class="text-[0.7rem] text-slate-600 leading-tight m-0">Core switches and cables melted. Disruption factor is absolute.</p>
                                </div>

                                <!-- Manager 2 -->
                                <div class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm hover:border-ngk-primaryLight transition-colors">
                                    <div class="flex justify-between items-start mb-2">
                                        <div>
                                            <p class="font-bold text-slate-800 text-sm mb-0">Bambang Wijaya</p>
                                            <p class="text-[0.65rem] text-slate-500 font-semibold uppercase">App Development</p>
                                        </div>
                                        <span class="bg-orange-100 text-orange-700 text-xs font-bold px-2 py-0.5 rounded border border-orange-200 text-center">3.8<br><span class="text-[0.5rem] uppercase">Score</span></span>
                                    </div>
                                    <p class="text-[0.7rem] text-slate-600 leading-tight m-0">No hardware damage, but team is locked out of local repo & portal.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notice box regarding dynamic structure -->
            <div class="bg-ngk-primaryLight/30 border border-ngk-primaryLight rounded-xl p-4 flex gap-3 items-center">
                <i class="fas fa-info-circle text-ngk-primary text-xl"></i>
                <p class="text-xs text-ngk-primaryDark font-medium m-0 leading-relaxed">
                    This nested history UI is structured dynamically. The data cascades from the lowest impacted department head up through intermediate reviewers until it reaches the final authorization tier (DGM/BOD).
                </p>
            </div>
            
        </div>

        <!-- Right Side: Final Authorization Action -->
        <div class="lg:col-span-5 xl:col-span-4 pl-0 lg:pl-2">
            <div class="bg-white border border-slate-200 shadow-lg rounded-2xl overflow-hidden sticky top-6">
                <!-- Action Header -->
                <div class="px-6 py-5 border-b border-slate-100 bg-slate-50 relative overflow-hidden">
                    <div class="absolute -right-4 -bottom-4 opacity-5">
                        <i class="fas fa-gavel text-8xl"></i>
                    </div>
                    <h5 class="mb-1 font-extrabold text-slate-800 text-lg relative z-10">Executive Authorization</h5>
                    <p class="text-xs text-slate-500 font-medium m-0 relative z-10">Require DGM final decision based on consensus.</p>
                </div>
                
                <div class="p-6">
                    <div class="mb-5">
                        <label class="block font-bold text-slate-800 text-[0.7rem] uppercase tracking-widest mb-2">Final Decree / Conditions <span class="text-red-500 ml-1">*</span></label>
                        <textarea class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:ring-2 focus:ring-ngk-primary/50 focus:border-ngk-primary transition-all text-slate-800 text-sm shadow-inner resize-none" rows="4" placeholder="Enter your instructions for activation..."></textarea>
                    </div>

                    <div class="mb-8 border border-slate-200 rounded-xl p-4 bg-white shadow-sm">
                        <label class="block font-bold text-slate-800 text-[0.7rem] uppercase tracking-widest mb-3 border-b border-slate-100 pb-2">Protocol Routing</label>
                        
                        <label class="flex items-start gap-3 cursor-pointer group mb-3">
                            <div class="relative flex items-center justify-center mt-0.5">
                                <input type="radio" name="routing" class="peer sr-only" checked>
                                <div class="w-5 h-5 rounded-full border-2 border-slate-300 peer-checked:border-ngk-primary peer-checked:bg-ngk-primary transition-colors flex items-center justify-center">
                                    <div class="w-2 h-2 rounded-full bg-white opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                </div>
                            </div>
                            <div>
                                <h6 class="font-extrabold text-slate-700 text-sm m-0 group-hover:text-ngk-primary transition-colors">Forward to Pres. Director (BOD)</h6>
                                <p class="text-[0.65rem] text-slate-500 font-medium mt-1 leading-tight m-0">Escalate for full Corporate level 1 disaster declaration.</p>
                            </div>
                        </label>
                        
                        <label class="flex items-start gap-3 cursor-pointer group">
                            <div class="relative flex items-center justify-center mt-0.5">
                                <input type="radio" name="routing" class="peer sr-only">
                                <div class="w-5 h-5 rounded-full border-2 border-slate-300 peer-checked:border-rose-500 peer-checked:bg-rose-500 transition-colors flex items-center justify-center">
                                    <div class="w-2 h-2 rounded-full bg-white opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                                </div>
                            </div>
                            <div>
                                <h6 class="font-extrabold text-slate-700 text-sm m-0 group-hover:text-rose-600 transition-colors">Direct Activation (DGM Authority)</h6>
                                <p class="text-[0.65rem] text-slate-500 font-medium mt-1 leading-tight m-0">Bypass BOD. Execute contingency budget immediately.</p>
                            </div>
                        </label>
                    </div>

                    <div class="space-y-3">
                        <button class="w-full px-6 py-3.5 rounded-xl bg-gradient-to-r from-ngk-primary to-ngk-primaryDark text-white shadow-lg shadow-ngk-primary/30 hover:shadow-xl hover:-translate-y-0.5 transition-all font-extrabold text-sm focus:outline-none flex justify-center items-center gap-2" onclick="demoFlowStep6()">
                            Approve & Route <i class="fas fa-check-circle"></i>
                        </button>
                        <button class="w-full px-6 py-3 rounded-xl bg-white border border-slate-200 text-red-600 font-bold text-sm hover:bg-slate-50 transition-colors shadow-sm focus:outline-none flex justify-center items-center gap-2">
                            Reject Hierarchy <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Floating Demo Navigation (Tailwind Styled) -->
<div class="fixed bottom-8 right-8 z-[1050]">
    <div class="w-[280px] bg-white rounded-xl shadow-[0_10px_40px_-5px_rgba(30,64,175,0.25)] border border-ngk-primary overflow-hidden">
        <div class="bg-gradient-to-r from-ngk-primary to-ngk-primaryDark text-white p-3 text-center border-b border-ngk-primaryDark cursor-move hover:bg-ngk-primaryDark transition-colors">
            <span class="text-[0.65rem] font-bold uppercase tracking-widest text-[#e0f3f5]">Demo Control Panel</span>
        </div>
        <div class="p-3 space-y-1 bg-slate-50">
            <a href="@Url.Action("Dashboard", "BCP")" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg text-slate-600 hover:bg-white hover:text-ngk-primary hover:shadow-sm transition-all w-full text-left">
                <i class="fas fa-home w-4 text-center text-slate-400"></i> Home: Dashboard
            </a>
            <a href="@Url.Action("IncidentCreate", "BCP")" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg text-slate-600 hover:bg-white hover:text-ngk-primary hover:shadow-sm transition-all w-full text-left">
                <i class="fas fa-plus w-4 text-center text-slate-400"></i> Step 1: Report Incident
            </a>
            <a href="@Url.Action("IncidentDetail", "BCP")" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg text-slate-600 hover:bg-white hover:text-ngk-primary hover:shadow-sm transition-all w-full text-left">
                <i class="fas fa-eye w-4 text-center text-slate-400"></i> Step 2: Live Tracking
            </a>
            <a href="@Url.Action("AssessmentFill", "BCP")" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg text-slate-600 hover:bg-white hover:text-ngk-primary hover:shadow-sm transition-all w-full text-left">
                <i class="fas fa-clipboard-check w-4 text-center text-slate-400"></i> Step 3: Assessment Fill
            </a>
            <a href="@Url.Action("AssessmentScore", "BCP")" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg text-slate-600 hover:bg-white hover:text-ngk-primary hover:shadow-sm transition-all w-full text-left">
                <i class="fas fa-chart-line w-4 text-center text-slate-400"></i> Step 4: Scoring Matrix
            </a>
            <a href="@Url.Action("AssessmentReview", "BCP")" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg text-slate-600 hover:bg-white hover:text-ngk-primary hover:shadow-sm transition-all w-full text-left">
                <i class="fas fa-user-check w-4 text-center text-slate-400"></i> Step 5: Hierarchy Review
            </a>
            <a href="@Url.Action("DGMReview", "BCP")" class="flex items-center gap-3 px-4 py-2.5 text-xs font-bold rounded-lg bg-ngk-primaryLight text-ngk-primaryDark w-full text-left">
                <i class="fas fa-user-tie w-4 text-center"></i> Step 6: Final Tier
            </a>
            <a href="@Url.Action("Activate", "BCP")" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg text-slate-600 hover:bg-white hover:text-ngk-primary hover:shadow-sm transition-all w-full text-left">
                <i class="fas fa-power-off w-4 text-center text-rose-500"></i> Step 7: BCP Activation
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/BCP/bcp.js"></script>
    <script>
        function demoFlowStep6() {
            let directAct = document.querySelectorAll('input[name="routing"]')[1].checked;
            
            Swal.fire({
                title: directAct ? 'Authorizing Activation...' : 'Forwarding to BOD...',
                text: 'System is encrypting the BCP report and executing protocol.',
                timer: 2000,
                showConfirmButton: false,
                willOpen: () => { Swal.showLoading() }
            }).then(() => {
                Swal.fire({
                    icon: 'success',
                    title: directAct ? 'BCP Activated!' : 'Review Forwarded!',
                    text: directAct ? 'Emergency budget and task force protocols have been activated.' : 'The President Director has been notified for ultimate authorization.',
                    confirmButtonColor: '#007581',
                    confirmButtonText: 'View Output Page (Step 7)'
                }).then(() => {
                    window.location.href = '@Url.Action("Activate", "BCP")';
                });
            });
        }
    </script>
}
