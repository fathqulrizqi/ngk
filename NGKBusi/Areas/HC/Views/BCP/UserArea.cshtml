@section Scripts {
    <!-- Select2 Script -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            // Data stores
            let allMappings = [];
            let allUsers = [];
            let allAreas = [];
            let currentPage = 1;
            const rowsPerPage = 10;

            // Initialize Select2 on both dropdowns with 100% width
            $('#userSelect').select2({
                placeholder: "-- Select Employee --",
                allowClear: true,
                dropdownParent: $('#formPanel'),
                width: '100%'
            });

            $('#areaSelect').select2({
                placeholder: "-- Select Area --",
                allowClear: true,
                dropdownParent: $('#formPanel'),
                width: '100%'
            });

            // Fetch Form Data (Users & Areas)
            function loadFormData() {
                $.ajax({
                    url: '@Url.Action("GetUserAreaFormData", "BCP")',
                    type: 'GET',
                    success: function (res) {
                        if (res.status === 'success') {
                            allUsers = res.users;
                            allAreas = res.areas;
                            
                            // Populate Area Dropdown in Form
                            let areaHtml = '<option value="">-- Select Area --</option>';
                            let filterAreaHtml = '<option value="">All Areas</option>';
                            res.areas.forEach(function (area) {
                                let opt = `<option value="${area.ID}">${area.AreaName}</option>`;
                                areaHtml += opt;
                                filterAreaHtml += opt;
                            });
                            $('#areaSelect').html(areaHtml);
                            $('#filterUserArea').html(filterAreaHtml);

                            // Populate User Dropdown and refresh select2
                            populateUserSelect();
                        } else {
                            Swal.fire("Error", "Failed to load form lookup data: " + res.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Network connection failed.", "error");
                    }
                });
            }

            // Populate users dropdown into select2
            function populateUserSelect() {
                let userHtml = '<option value="">-- Select Employee --</option>';
                allUsers.forEach(function (u) {
                    userHtml += `<option value="${u.NIK}">${u.NIK} - ${u.Name} (${u.DeptName})</option>`;
                });
                $('#userSelect').html(userHtml).trigger('change');
            }

            // Fetch Mapping Table Data
            function loadMappings() {
                $.ajax({
                    url: '@Url.Action("GetUserAreaList", "BCP")',
                    type: 'GET',
                    data: { search: '' },
                    success: function (res) {
                        if (res.status === 'success') {
                            allMappings = res.data;
                            currentPage = 1;
                            applyFiltersAndPagination();
                        } else {
                            $('#mappingTableBody').html(`<tr><td colspan="5" class="text-center py-8 text-danger">Error: ${res.message}</td></tr>`);
                        }
                    },
                    error: function () {
                        $('#mappingTableBody').html('<tr><td colspan="5" class="text-center py-8 text-danger">Failed to fetch data from server.</td></tr>');
                    }
                });
            }

            // Filter and Paginate logic
            function applyFiltersAndPagination() {
                let generalSearch = ($('#tableSearch').val() || '').toLowerCase().trim();
                let detailsFilter = ($('#filterUserDetails').val() || '').toLowerCase().trim();
                let areaFilter = $('#filterUserArea').val();
                let deptFilter = ($('#filterUserDept').val() || '').toLowerCase().trim();

                let filtered = allMappings.filter(function(item) {
                    // General search
                    if (generalSearch) {
                        let matchGeneral = (item.EmployeeName || '').toLowerCase().includes(generalSearch) ||
                                           (item.NIK || '').toLowerCase().includes(generalSearch) ||
                                           (item.AreaName || '').toLowerCase().includes(generalSearch) ||
                                           (item.DepartmentName || '').toLowerCase().includes(generalSearch);
                        if (!matchGeneral) return false;
                    }
                    // Details filter
                    if (detailsFilter) {
                        let matchDetails = (item.EmployeeName || '').toLowerCase().includes(detailsFilter) ||
                                           (item.NIK || '').toLowerCase().includes(detailsFilter);
                        if (!matchDetails) return false;
                    }
                    // Area filter
                    if (areaFilter && String(item.AreaID) !== areaFilter) {
                        return false;
                    }
                    // Department filter
                    if (deptFilter && !(item.DepartmentName || '').toLowerCase().includes(deptFilter)) {
                        return false;
                    }
                    return true;
                });

                let totalItems = filtered.length;
                let totalPages = Math.ceil(totalItems / rowsPerPage) || 1;

                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                let startIndex = (currentPage - 1) * rowsPerPage;
                let endIndex = Math.min(startIndex + rowsPerPage, totalItems);
                let paginatedItems = filtered.slice(startIndex, endIndex);

                renderTable(paginatedItems, startIndex);
                renderPagination(totalItems, totalPages, startIndex, endIndex);
                calculateStats(allMappings);
            }

            // Render Table Rows
            function renderTable(mappings, startIndex) {
                if (mappings.length === 0) {
                    $('#mappingTableBody').html('<tr><td colspan="5" class="text-center py-12 text-slate-400"><i class="fas fa-folder-open text-3xl mb-2 block"></i>No assignments found matching your search.</td></tr>');
                    return;
                }

                let html = '';
                mappings.forEach(function (item, index) {
                    // Create beautiful initial avatar
                    let initials = item.EmployeeName.substring(0, 2).toUpperCase();
                    let randomColors = [
                        'bg-teal-500 text-teal-50',
                        'bg-sky-500 text-sky-50',
                        'bg-indigo-500 text-indigo-50',
                        'bg-purple-500 text-purple-50',
                        'bg-emerald-500 text-emerald-50'
                    ];
                    let avatarColor = randomColors[index % randomColors.length];

                    html += `
                        <tr>
                            <td class="pl-6 text-center font-semibold text-slate-400">${startIndex + index + 1}</td>
                            <td>
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-full ${avatarColor} flex items-center justify-center font-bold text-xs shadow-sm shrink-0">
                                        ${initials}
                                    </div>
                                    <div>
                                        <div class="font-semibold text-slate-800">${item.EmployeeName}</div>
                                        <div class="text-xs text-slate-400 font-mono">${item.NIK}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 font-medium text-xs border border-slate-200/50">
                                    <i class="fas fa-map-marker-alt text-ngk-primary mr-1"></i>${item.AreaName}
                                </span>
                            </td>
                            <td class="font-medium text-slate-500">${item.DepartmentName || '-'}</td>
                            <td class="pr-6 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button class="btn btn-sm btn-outline-secondary rounded-lg edit-btn p-2" data-id="${item.ID}" title="Edit Assignment">
                                        <i class="fas fa-pencil-alt"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-lg delete-btn p-2" data-id="${item.ID}" title="Delete Assignment">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                });

                $('#mappingTableBody').html(html);
            }

            // Render pagination controls
            function renderPagination(totalItems, totalPages, startIndex, endIndex) {
                $('#recordCountLabel').text(`Showing ${totalItems} assignment${totalItems !== 1 ? 's' : ''}`);

                if (totalItems === 0) {
                    $('#paginationInfo').text('Showing 0 to 0 of 0 entries');
                    $('#paginationControls').html('');
                    return;
                }

                $('#paginationInfo').text(`Showing ${startIndex + 1} to ${endIndex} of ${totalItems} entries`);

                let paginationHtml = '';
                if (currentPage === 1) {
                    paginationHtml += `<button disabled class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-50 border border-slate-200 text-slate-400 cursor-not-allowed opacity-60"><i class="fas fa-chevron-left"></i></button>`;
                } else {
                    paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors page-prev-btn"><i class="fas fa-chevron-left"></i></button>`;
                }

                let maxVisiblePages = 5;
                let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
                let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

                if (endPage - startPage + 1 < maxVisiblePages) {
                    startPage = Math.max(1, endPage - maxVisiblePages + 1);
                }

                if (startPage > 1) {
                    paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors page-num-btn" data-page="1">1</button>`;
                    if (startPage > 2) {
                        paginationHtml += `<span class="px-2 text-slate-400">...</span>`;
                    }
                }

                for (let i = startPage; i <= endPage; i++) {
                    if (i === currentPage) {
                        paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-ngk-primary text-white border border-ngk-primary shadow-sm">${i}</button>`;
                    } else {
                        paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors page-num-btn" data-page="${i}">${i}</button>`;
                    }
                }

                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        paginationHtml += `<span class="px-2 text-slate-400">...</span>`;
                    }
                    paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors page-num-btn" data-page="${totalPages}">${totalPages}</button>`;
                }

                if (currentPage === totalPages) {
                    paginationHtml += `<button disabled class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-50 border border-slate-200 text-slate-400 cursor-not-allowed opacity-60"><i class="fas fa-chevron-right"></i></button>`;
                } else {
                    paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors page-next-btn"><i class="fas fa-chevron-right"></i></button>`;
                }

                $('#paginationControls').html(paginationHtml);
            }

            // Stats calculator
            function calculateStats(mappings) {
                $('#statTotalMappings').text(mappings.length);

                let uniqueNiks = new Set();
                let uniqueAreas = new Set();
                
                mappings.forEach(function (m) {
                    if (m.NIK) uniqueNiks.add(m.NIK);
                    if (m.AreaID) uniqueAreas.add(m.AreaID);
                });

                $('#statUniqueUsers').text(uniqueNiks.size);
                $('#statAreasCovered').text(uniqueAreas.size);
            }

            // Pagination button events
            $(document).on('click', '.page-num-btn', function() {
                currentPage = parseInt($(this).attr('data-page'));
                applyFiltersAndPagination();
            });

            $(document).on('click', '.page-prev-btn', function() {
                if (currentPage > 1) {
                    currentPage--;
                    applyFiltersAndPagination();
                }
            });

            $(document).on('click', '.page-next-btn', function() {
                currentPage++;
                applyFiltersAndPagination();
            });

            // Bind column filter inputs and table search
            $('#filterUserDetails, #filterUserArea, #filterUserDept, #tableSearch').on('input change', function () {
                currentPage = 1;
                applyFiltersAndPagination();
            });

            // Expand Inline Form panel
            $('#btnNewMapping').click(function () {
                resetForm();
                $('#formTitle').text('Create User Area Assignment');
                $('#formPanel').removeClass('hidden');
                $('html, body').animate({
                    scrollTop: $("#formPanel").offset().top - 100
                }, 500);
            });

            // Cancel form
            $('#btnCancelForm, #btnDiscard').click(function () {
                $('#formPanel').addClass('hidden');
                resetForm();
            });

            // Edit Action Click
            $(document).on('click', '.edit-btn', function () {
                let id = $(this).data('id');
                let item = allMappings.find(x => x.ID == id);
                if (item) {
                    $('#mappingId').val(item.ID);
                    $('#formTitle').text('Edit User Area Assignment');
                                        // Pre-populate Select2 and trigger change
                    $('#userSelect').val(item.NIK).trigger('change');
                    $('#areaSelect').val(item.AreaID).trigger('change');

                    $('#formPanel').removeClass('hidden');
                    $('html, body').animate({
                        scrollTop: $("#formPanel").offset().top - 100
                    }, 500);
                }
            });

            // Form Submit Action
            $('#mappingForm').submit(function (e) {
                e.preventDefault();

                let data = {
                    ID: $('#mappingId').val(),
                    NIK: $('#userSelect').val(),
                    AreaID: $('#areaSelect').val()
                };

                $.ajax({
                    url: '@Url.Action("SaveUserArea", "BCP")',
                    type: 'POST',
                    data: data,
                    success: function (res) {
                        if (res.status === 'success') {
                            Swal.fire("Success", res.message, "success");
                            $('#formPanel').addClass('hidden');
                            resetForm();
                            loadMappings();
                        } else {
                            Swal.fire("Warning", res.message, "warning");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Request failed. Please try again.", "error");
                    }
                });
            });

            // Delete Action Click
            $(document).on('click', '.delete-btn', function () {
                let id = $(this).data('id');
                Swal.fire({
                    title: "Are you sure?",
                    text: "Once deleted, you will need to re-assign this employee to BCP area mapping.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteUserArea", "BCP")',
                            type: 'POST',
                            data: { ID: id },
                            success: function (res) {
                                if (res.status === 'success') {
                                    Swal.fire("Deleted!", res.message, "success");
                                    loadMappings();
                                } else {
                                    Swal.fire("Error", res.message, "error");
                                }
                            },
                            error: function () {
                                Swal.fire("Error", "Request failed. Please try again.", "error");
                            }
                        });
                    }
                });
            });
            // Helper to reset form
            function resetForm() {
                $('#mappingId').val('');
                $('#mappingForm')[0].reset();
                $('#userSelect').val('').trigger('change');
                $('#areaSelect').val('').trigger('change');
            }

            // Initial loads
            loadFormData();
            loadMappings();
        });
    </script>
}
