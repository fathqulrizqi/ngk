    <!-- Main List Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="relative w-full md:w-80">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-search text-slate-400"></i>
                </span>
                <input type="text" id="tableSearch" placeholder="Search mappings..." class="form-control pl-10 rounded-xl border-slate-200 text-sm py-2" />
            </div>
            <div class="text-slate-400 text-sm font-medium" id="recordCountLabel">
                Showing 0 assignments
            </div>
        </div>

        <div class="table-responsive">
            <table class="table bcp-table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="pl-6 w-16 text-center">No</th>
                        <th>Employee Details</th>
                        <th>Mapped Area</th>
                        <th>Department</th>
                        <th class="pr-6 w-32 text-center">Actions</th>
                    </tr>
                    <tr class="bg-slate-50/50 filter-row">
                        <th></th>
                        <th class="p-2">
                            <input type="text" id="filterUserDetails" placeholder="Filter NIK/Name..." class="form-control form-control-sm text-xs font-semibold border-slate-200 focus:border-ngk-primary focus:ring-1 focus:ring-ngk-primary rounded-lg py-1 px-2 w-full" />
                        </th>
                        <th class="p-2">
                            <select id="filterUserArea" class="form-control form-control-sm text-xs font-semibold border-slate-200 focus:border-ngk-primary focus:ring-1 focus:ring-ngk-primary rounded-lg py-1 px-2 w-full">
                                <option value="">All Areas</option>
                            </select>
                        </th>
                        <th class="p-2">
                            <input type="text" id="filterUserDept" placeholder="Filter Dept..." class="form-control form-control-sm text-xs font-semibold border-slate-200 focus:border-ngk-primary focus:ring-1 focus:ring-ngk-primary rounded-lg py-1 px-2 w-full" />
                        </th>
                        <th></th>
