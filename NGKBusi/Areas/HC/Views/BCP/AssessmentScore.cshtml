    @{
        var incident = (NGKBusi.Areas.HC.Models.HC_BCP_Incident)ViewBag.Incident;
        var assessments = (List<NGKBusi.Areas.HC.Models.HC_BCP_Assessment>)ViewBag.Assessments;
        var criteria = (List<NGKBusi.Areas.HC.Models.HC_BCP_Assessment_Criteria>)ViewBag.Criteria;

        decimal avgScore = assessments.Any() ? (decimal)assessments.Average(x => x.TotalScore ?? 0) : 0;
        decimal progressPct = avgScore * 20; // 0-100% scale for 0-5.00 score
        
        string riskLabel = "LOW IMPACT";
        string riskClass = "bg-emerald-100 text-emerald-700 border-emerald-200";
        string barClass = "bg-emerald-500";
        
        if (avgScore >= 4) { riskLabel = "EXTREME ALERT"; riskClass = "bg-rose-100 text-rose-700 border-rose-200"; barClass = "bg-rose-500"; }
        else if (avgScore >= 3) { riskLabel = "HIGH RISK ALERT"; riskClass = "bg-orange-100 text-orange-700 border-orange-200"; barClass = "bg-orange-500"; }
        else if (avgScore >= 2) { riskLabel = "MEDIUM IMPACT"; riskClass = "bg-amber-100 text-amber-700 border-amber-200"; barClass = "bg-amber-500"; }
    }

    <!-- Header -->
    <div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-end">
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-500 mb-2 font-medium">
                <a href="@Url.Action("Dashboard", "BCP")" class="hover:text-ngk-primary transition-colors">BCP Dashboard</a>
                <span>/</span>
                <span class="text-ngk-primary font-semibold">Consensus Scoring</span>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">Assessment Score Summary</h1>
            <p class="text-slate-500 mt-1 text-sm">Aggregated impact analysis for <strong>@incident.IncidentNo | @incident.Title</strong></p>
        </div>
        <div class="mt-4 md:mt-0 text-right">
             <div class="px-3 py-1 bg-teal-50 text-teal-700 border border-teal-200 text-[0.65rem] font-bold uppercase tracking-widest rounded-lg mb-2 inline-flex items-center gap-1.5">
                 <i class="fas fa-tag text-[9px]"></i> @(incident.Category ?? "Incident")
             </div>
             <p class="text-xs text-slate-400 mb-0 font-medium">Total Received: <strong>@assessments.Count Assessments</strong></p>
        </div>
    </div>

    <!-- Main Results Section -->
    <div class="row mb-5">
        <!-- Visual Gauge -->
        <div class="col-xl-4 mb-4">
             <div class="bg-white border border-slate-200 shadow-lg rounded-2xl p-8 h-100 flex flex-col justify-center items-center text-center relative overflow-hidden">
                <!-- Background Accent -->
                <div class="absolute -right-20 -bottom-20 w-64 h-64 bg-slate-50 rounded-full blur-3xl"></div>
                
                <div class="mb-4 relative z-10">
                    <span class="px-4 py-2 @riskClass rounded-full font-bold shadow-sm border text-xs tracking-wider">@riskLabel</span>
                </div>
                <h1 class="text-7xl font-black text-slate-800 mb-0 relative z-10">@avgScore.ToString("0.00")</h1>
                <p class="text-sm text-slate-500 uppercase tracking-[0.2em] font-bold mt-2 relative z-10">Weighted Global Score</p>
                
                <div class="w-full bg-slate-100 rounded-full h-3.5 mt-8 shadow-inner relative z-10 overflow-hidden">
                    <div class="@barClass h-3.5 rounded-full transition-all duration-1000 shadow-md" style="width: @(progressPct)%"></div>
                </div>
                <div class="flex justify-between w-full mt-3 text-[0.6rem] text-slate-400 font-black uppercase tracking-widest relative z-10 px-1">
                    <span>Low</span>
                    <span>Med</span>
                    <span>High</span>
                    <span>Ex</span>
                </div>
                <p class="mt-8 text-xs text-slate-400 leading-relaxed font-medium relative z-10">
                    Calculated from <strong>@assessments.Count</strong> departmental assessments using weighted criteria including Safety (50%), Operations (30%), and Infrastructure (20%).
                </p>
            </div>
        </div>

        <!-- Breakdown Charts -->
        <div class="col-xl-8 mb-4">
            <div class="bg-white border border-slate-200 shadow-sm rounded-2xl h-100 flex flex-col overflow-hidden">
                <div class="bg-slate-50 py-4 px-6 border-b border-slate-100 flex justify-between items-center">
                    <h5 class="m-0 font-extrabold text-slate-800 text-sm uppercase tracking-widest"><i class="fas fa-list-ol mr-3 text-ngk-primary"></i>Committee Breakdown</h5>
                    <a href="@Url.Action("ExportDepartmentMatrixExcel", "BCP", new { id = incident.IncidentNo })" class="bg-white border border-slate-300 text-slate-600 px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm hover:bg-slate-50 transition-colors inline-flex items-center gap-1.5 no-underline">
                        <i class="fas fa-file-excel text-emerald-600"></i> Export Matrix
                    </a>
                </div>
                <div class="flex-grow overflow-y-auto max-h-[450px] custom-scrollbar">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-slate-50/80 sticky top-0 backdrop-blur-sm shadow-sm z-10 border-b border-slate-200">
                            <tr class="text-slate-400 text-[0.65rem] uppercase tracking-widest font-black">
                                <th class="py-3 px-6">Assessor / Department</th>
                                <th class="py-3 px-4 text-center">Impacted?</th>
                                <th class="py-3 px-4 text-center">Score</th>
                                <th class="py-3 px-4">Submission Time</th>
                                <th class="py-3 px-6 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-sm">
                            @foreach(var ass in assessments) {
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="py-4 px-6">
                                        <div class="font-bold text-slate-800">@ass.AssessorName</div>
                                        <div class="text-[0.65rem] text-slate-400 font-bold">@ass.DepartmentName • @ass.AssessorNIK</div>
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        @if(ass.IsImpacted == true) {
                                            <span class="text-rose-600 font-black text-xs">YES</span>
                                        } else {
                                            <span class="text-emerald-600 font-black text-xs">NO</span>
                                        }
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        <span class="px-3 py-1 bg-slate-100 text-slate-700 font-black rounded-full border border-slate-200 text-xs">@ass.TotalScore.Value.ToString("0.00")</span>
                                    </td>
                                    <td class="py-4 px-4 text-slate-500 font-medium text-xs">@ass.Submitted_At.Value.ToString("dd MMM, hh:mm tt")</td>
                                    <td class="py-4 px-6 text-right">
                                        <button class="bg-white border border-slate-200 text-slate-500 p-1.5 rounded-lg hover:text-ngk-primary hover:border-ngk-primary transition-all shadow-sm">
                                            <i class="fas fa-search-plus"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if(!assessments.Any()) {
                                <tr>
                                    <td colspan="5" class="py-12 text-center text-slate-400 italic">No assessments submitted yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviewer Action -->
    <div class="bg-white border-2 border-dashed border-slate-200 rounded-3xl p-10 text-center mb-12">
        <div class="w-16 h-16 rounded-full bg-ngk-primaryLight text-ngk-primary flex items-center justify-center mx-auto mb-6 shadow-sm">
            <i class="fas fa-check-double text-2xl"></i>
        </div>
        <h3 class="text-2xl font-black text-slate-800 mb-3 tracking-tight">Consensus Decision Ready?</h3>
        <p class="text-slate-500 mb-8 max-w-2xl mx-auto font-medium leading-relaxed">
            With <strong>@assessments.Count assessments</strong> received and a global risk score of <strong>@avgScore.ToString("0.00")</strong>, you can now proceed to the official management review phase to determine activation.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
             <button onclick="location.reload()" class="bg-white border border-slate-300 text-slate-600 px-8 py-3 rounded-full font-bold shadow-sm hover:bg-slate-50 transition-all">
                <i class="fas fa-sync-alt mr-2"></i> Refresh Data
             </button>
             <a href="@Url.Action("AssessmentReview", "BCP", new { id = incident.IncidentNo })" class="bg-ngk-primary text-white border-0 px-10 py-3 rounded-full font-black shadow-lg hover:bg-ngk-primaryDark hover:shadow-xl hover:-translate-y-0.5 transition-all">
                Proceed to Review Phase <i class="fas fa-chevron-right ml-3"></i>
             </a>
        </div>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
</style>

<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        corePlugins: { preflight: false },
        theme: {
            extend: {
                colors: { 
                    ngk: {
                        primary: '#007581',
                        primaryLight: '#e0f3f5',
                        primaryDark: '#00555e',
                        accent: '#eeb500',
                        accentLight: '#fdf7e6'
                    }
                }
            }
        }
    }
</script>

@section Scripts {
    <script src="~/Scripts/BCP/bcp.js"></script>
}
