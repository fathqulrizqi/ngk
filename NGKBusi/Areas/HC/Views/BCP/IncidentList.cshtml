@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var incidents = (List<NGKBusi.Areas.HC.Models.HC_BCP_Incident>)ViewBag.Incidents ?? new List<NGKBusi.Areas.HC.Models.HC_BCP_Incident>();
}

<!-- Use Tailwind via CDN for enhanced styling of the Incident History -->
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<script>
    tailwind.config = {
        corePlugins: { preflight: false },
        theme: {
            extend: {
                fontFamily: { sans: ['Inter', 'sans-serif'] },
                colors: { 
                    ngk: {
                        primary: '#007581',
                        primaryLight: '#e0f3f5',
                        primaryDark: '#00555e',
                        accent: '#eeb500',
                        accentLight: '#fdf7e6'
                    }
                }
            }
        }
    }
</script>

<style>
    .fade-up { animation: fadeUp 0.5s ease-out both; }
    @@keyframes fadeUp { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:translateY(0); } }
    
    .pulse-ring-rose { animation: pulseRingRose 2s ease-in-out infinite; }
    @@keyframes pulseRingRose {
        0%, 100% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.4); }
        50%      { box-shadow: 0 0 0 8px rgba(225, 29, 72, 0); }
    }
</style>

<div class="w-full bg-slate-50 font-sans min-h-screen py-6 px-2 sm:px-4 md:px-8">
    <div class="mb-6 fade-up">
        @* BREADCRUMB *@
        <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 uppercase tracking-widest mb-5 ml-2">
            <a href="@Url.Action("Dashboard", "BCP")" class="hover:text-ngk-primary transition-colors duration-200 flex items-center gap-1.5 no-underline">
                <i class="fas fa-home"></i>BCP Home
            </a>
            <i class="fas fa-chevron-right text-[9px] text-slate-300"></i>
            <span class="text-slate-500 font-bold">Incident History</span>
        </div>

        @* NEW HEADER CARD *@
        <div class="w-full relative overflow-hidden rounded-[20px] shadow-md border border-slate-200 mb-8" style="background: linear-gradient(135deg, #0b1c24 0%, #112e3c 60%, #007581 100%);">
            <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10" style="background: radial-gradient(circle, #ffffff 0%, transparent 70%); transform: translate(30%, -40%); pointer-events: none;"></div>
            <div class="absolute bottom-0 left-1/4 w-72 h-72 rounded-full opacity-5" style="background: radial-gradient(circle, #e11d48 0%, transparent 70%); transform: translate(-50%, 50%); pointer-events: none;"></div>

            <div class="relative z-10 px-6 md:px-10 py-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div class="flex items-start gap-4">
                    <div class="w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg bg-gradient-to-br from-ngk-primary to-ngk-primaryDark">
                        <i class="fas fa-history text-white text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-black text-white tracking-tight mb-1.5">Incident Monitoring Registry</h1>
                        <p class="text-slate-300 text-xs md:text-sm font-medium">Historical logs, evaluations, and resolution progress of business continuity events.</p>
                    </div>
                </div>

                <div class="flex items-center flex-wrap gap-3">
                    <a href="@Url.Action("DownloadExcel", "BCP")" class="inline-flex items-center gap-2 px-5 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl shadow-md transition-all font-bold no-underline text-sm hover:scale-105 active:scale-95">
                        <i class="fas fa-file-excel"></i>
                        Download Excel
                    </a>
                    <a href="@Url.Action("IncidentCreate", "BCP")" class="inline-flex items-center gap-2 px-6 py-3.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl shadow-lg transition-all font-bold no-underline text-sm hover:scale-105 active:scale-95">
                        <i class="fas fa-plus-circle"></i>
                        Report New Incident
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* STATS SUMMARY GRID *@
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8 fade-up" style="animation-delay: 0.1s">
        <!-- KPI 1: Total -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/60 flex items-center justify-between">
            <div>
                <p class="text-[0.65rem] font-bold text-slate-400 uppercase tracking-widest mb-1">Total Incidents</p>
                <h3 class="text-2xl font-black text-slate-800">@ViewBag.TotalIncidents</h3>
                <p class="text-[10px] text-slate-400 font-medium mt-1">Overall registry count</p>
            </div>
            <div class="w-11 h-11 rounded-xl bg-slate-100 flex items-center justify-center text-slate-500">
                <i class="fas fa-folder-open text-lg"></i>
            </div>
        </div>

        <!-- KPI 2: Active BCP -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/60 flex items-center justify-between">
            <div>
                <p class="text-[0.65rem] font-bold text-rose-500 uppercase tracking-widest mb-1">Active BCP</p>
                <h3 class="text-2xl font-black text-rose-600 flex items-center gap-2">
                    @ViewBag.ActiveIncidents
                    @if (ViewBag.ActiveIncidents > 0)
                    {
                        <span class="inline-block w-2.5 h-2.5 rounded-full bg-rose-500 pulse-ring-rose"></span>
                    }
                </h3>
                <p class="text-[10px] text-rose-500/80 font-medium mt-1">Emergency state active</p>
            </div>
            <div class="w-11 h-11 rounded-xl bg-rose-50 flex items-center justify-center text-rose-500">
                <i class="fas fa-exclamation-triangle text-lg"></i>
            </div>
        </div>

        <!-- KPI 3: Under Assessment -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/60 flex items-center justify-between">
            <div>
                <p class="text-[0.65rem] font-bold text-amber-500 uppercase tracking-widest mb-1">Under Assessment</p>
                <h3 class="text-2xl font-black text-amber-600">@ViewBag.OpenIncidents</h3>
                <p class="text-[10px] text-amber-500/80 font-medium mt-1">Pending committee review</p>
            </div>
            <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center text-amber-500">
                <i class="fas fa-clipboard-check text-lg"></i>
            </div>
        </div>

        <!-- KPI 4: Resolved -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/60 flex items-center justify-between">
            <div>
                <p class="text-[0.65rem] font-bold text-emerald-500 uppercase tracking-widest mb-1">Resolved & Recovered</p>
                <h3 class="text-2xl font-black text-emerald-600">@ViewBag.ResolvedIncidents</h3>
                <p class="text-[10px] text-emerald-500/80 font-medium mt-1">Operational status restored</p>
            </div>
            <div class="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-500">
                <i class="fas fa-check-double text-lg"></i>
            </div>
        </div>
    </div>

    @* FILTER PANEL & TABLE CARD *@
    <div class="bg-white rounded-[20px] shadow-sm border border-slate-200 overflow-hidden fade-up" style="animation-delay: 0.15s">
        <!-- Control Bar -->
        <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex flex-col md:flex-row gap-4 items-center justify-between">
            <!-- Search & Filters Group -->
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
                <div class="relative w-full sm:w-64">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fas fa-search text-xs"></i>
                    </span>
                    <input type="text" id="incidentSearchInput" placeholder="Search title or ID..." class="w-full pl-9 pr-4 py-2 text-xs border border-slate-200 rounded-xl bg-white text-slate-700 placeholder-slate-400 focus:outline-none focus:border-ngk-primary focus:ring-1 focus:ring-ngk-primary transition-all shadow-sm">
                </div>

                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <select id="statusFilter" class="w-full sm:w-40 px-3 py-2 text-xs border border-slate-200 rounded-xl bg-white text-slate-700 focus:outline-none focus:border-ngk-primary shadow-sm">
                        <option value="">All Statuses</option>
                        <option value="Assessment">Assessment</option>
                        <option value="Review">Review</option>
                        <option value="Approved">Approved</option>
                        <option value="Activated BCP">Activated BCP</option>
                        <option value="Resolved">Resolved</option>
                    </select>

                    <select id="categoryFilter" class="w-full sm:w-40 px-3 py-2 text-xs border border-slate-200 rounded-xl bg-white text-slate-700 focus:outline-none focus:border-ngk-primary shadow-sm">
                        <option value="">All Categories</option>
                        <option value="Natural Disaster">Natural Disaster</option>
                        <option value="Facility Failure">Facility Failure</option>
                        <option value="Fire/Explosion">Fire/Explosion</option>
                        <option value="Supply Chain Disruption">Supply Chain Disruption</option>
                        <option value="IT/Utility Failure">IT/Utility Failure</option>
                        <option value="Safety/Security">Safety/Security</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <!-- Total count label -->
            <span class="text-xs font-semibold text-slate-500 bg-slate-200/60 px-3 py-1 rounded-full whitespace-nowrap" id="activeFilterLabel">
                Showing all @incidents.Count records
            </span>
        </div>

        <!-- Table Container -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse table-fixed text-xs min-w-[850px] m-0" id="incidentsMasterTable">
                <thead>
                    <tr class="bg-slate-100/70 text-slate-500 uppercase tracking-widest text-[10px] font-extrabold border-b border-slate-200">
                        <th class="py-4 px-5 w-12 text-center">No</th>
                        <th class="py-4 px-5 w-36">Incident ID</th>
                        <th class="py-4 px-5 w-72">Incident Detail & Description</th>
                        <th class="py-4 px-5 w-32 text-center">Category</th>
                        <th class="py-4 px-5 w-36 text-center">Current Phase</th>
                        <th class="py-4 px-5 w-32 text-center">Reported Date</th>
                        <th class="py-4 px-5 w-28 text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                    @{
                        int index = 1;
                    }
                    @foreach (var inc in incidents)
                    {
                        var cat = (inc.Category ?? "Other").Trim();

                        var phaseLabel = "Draft";
                        var phaseClass = "bg-slate-50 text-slate-600 border-slate-200";
                        if (inc.Status == 2) { phaseLabel = "Assessment"; phaseClass = "bg-amber-50 text-amber-700 border-amber-200"; }
                        else if (inc.Status == 3) { phaseLabel = "Review"; phaseClass = "bg-blue-50 text-blue-700 border-blue-200"; }
                        else if (inc.Status == 5) { phaseLabel = "Approved"; phaseClass = "bg-indigo-50 text-indigo-700 border-indigo-200"; }
                        else if (inc.Status == 6) { phaseLabel = "Activated BCP"; phaseClass = "bg-rose-50 text-rose-700 border-rose-200 font-black relative overflow-hidden"; }
                        else if (inc.Status == 7) { phaseLabel = "Resolved"; phaseClass = "bg-emerald-50 text-emerald-700 border-emerald-200"; }

                        <tr class="hover:bg-slate-50/50 transition-colors cursor-pointer incident-list-row" 
                            data-search="@(inc.IncidentNo.ToLower()) @(inc.Title.ToLower()) @((inc.Description ?? "").ToLower())" 
                            data-status="@phaseLabel" 
                            data-category="@cat"
                            onclick="window.location.href='@Url.Action("IncidentDetail", "BCP", new { id = inc.IncidentNo })'">
                            
                            <td class="py-4 px-5 text-center font-bold text-slate-400 align-middle">@index</td>
                            
                            <td class="py-4 px-5 align-middle">
                                <span class="font-extrabold text-slate-800 hover:text-ngk-primary transition-colors text-sm">
                                    @inc.IncidentNo
                                </span>
                            </td>
                            
                            <td class="py-4 px-5 align-middle">
                                <p class="font-bold text-slate-800 text-sm m-0 line-clamp-1">@inc.Title</p>
                                <p class="text-[11px] text-slate-400 mt-1 m-0 line-clamp-2 leading-relaxed">
                                    @(!string.IsNullOrEmpty(inc.Description) ? inc.Description : "No additional description provided.")
                                </p>
                            </td>
                            
                            <td class="py-4 px-5 align-middle text-center">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full border bg-slate-50 text-slate-700 border-slate-200 text-[10px] font-bold">
                                    <i class="fas fa-tag text-[9px] text-teal-600"></i> @cat
                                </span>
                            </td>
                            
                            <td class="py-4 px-5 align-middle text-center">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-[10px] font-bold uppercase tracking-wider @phaseClass">
                                    @if (inc.Status == 6)
                                    {
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-ping"></span>
                                    }
                                    @phaseLabel
                                </span>
                            </td>
                            
                            <td class="py-4 px-5 align-middle text-center text-slate-500 font-semibold">
                                @(inc.Created_At.HasValue ? inc.Created_At.Value.ToString("dd MMM yyyy, HH:mm") : "—")
                            </td>
                            
                            <td class="py-4 px-5 align-middle text-center" onclick="event.stopPropagation();">
                                <a href="@Url.Action("IncidentDetail", "BCP", new { id = inc.IncidentNo })" 
                                   class="inline-flex items-center justify-center px-3 py-1.5 border border-slate-200 text-[11px] font-bold text-slate-600 rounded-lg hover:border-ngk-primary hover:text-ngk-primary hover:bg-ngk-primaryLight/30 transition-all no-underline">
                                    Details &rarr;
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                    @if (!incidents.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-14 text-center text-slate-400 font-medium bg-slate-50/20">
                                <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-3">
                                    <i class="fas fa-folder-open text-2xl text-slate-300"></i>
                                </div>
                                <p class="m-0 text-sm font-bold text-slate-500">No incident logs found</p>
                                <p class="m-0 text-xs text-slate-400 mt-1">Create a new incident report to start the monitoring workflow.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div id="masterPaginationControls" class="px-6 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="text-xs text-slate-500 font-medium">
                Showing <span id="pageStart" class="font-bold text-slate-700">0</span> to <span id="pageEnd" class="font-bold text-slate-700">0</span> of <span id="totalRows" class="font-bold text-slate-700">0</span> records
            </div>
            <div class="flex gap-1.5">
                <button id="prevPage" class="px-3.5 py-1.5 text-xs font-bold text-slate-600 bg-white hover:bg-slate-100 border border-slate-200 rounded-xl disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-sm">Prev</button>
                <div id="pageNumbers" class="flex gap-1"></div>
                <button id="nextPage" class="px-3.5 py-1.5 text-xs font-bold text-slate-600 bg-white hover:bg-slate-100 border border-slate-200 rounded-xl disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-sm">Next</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/BCP/bcp.js"></script>
    <script>
        $(document).ready(function() {
            const rowsPerPage = 10;
            let currentPage = 1;
            const $rows = $('.incident-list-row');
            
            // Filters elements
            const $searchInput = $('#incidentSearchInput');
            const $statusFilter = $('#statusFilter');
            const $categoryFilter = $('#categoryFilter');

            function applyFiltersAndPagination() {
                const searchVal = $searchInput.val().toLowerCase().trim();
                const statusVal = $statusFilter.val();
                const categoryVal = $categoryFilter.val();

                // 1. Filter rows
                let $visibleRows = $rows.filter(function() {
                    const $row = $(this);
                    
                    const matchesSearch = !searchVal || $row.attr('data-search').indexOf(searchVal) > -1;
                    const matchesStatus = !statusVal || $row.attr('data-status') === statusVal;
                    const matchesCategory = !categoryVal || $row.attr('data-category') === categoryVal;
                    
                    return matchesSearch && matchesStatus && matchesCategory;
                });

                // Hide all rows initially
                $rows.hide();

                const totalFiltered = $visibleRows.length;
                const totalPages = Math.ceil(totalFiltered / rowsPerPage) || 1;

                if (currentPage > totalPages) {
                    currentPage = totalPages;
                }

                // 2. Paginate visible rows
                const start = (currentPage - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                $visibleRows.slice(start, end).show();

                // 3. Update Labels
                if (totalFiltered === 0) {
                    $('#pageStart').text(0);
                    $('#pageEnd').text(0);
                    $('#totalRows').text(0);
                    $('#activeFilterLabel').text("No records match");
                    $('#masterPaginationControls').hide();
                } else {
                    $('#pageStart').text(start + 1);
                    $('#pageEnd').text(Math.min(end, totalFiltered));
                    $('#totalRows').text(totalFiltered);
                    $('#activeFilterLabel').text(`Showing ${totalFiltered} records`);
                    $('#masterPaginationControls').show();
                }

                $('#prevPage').prop('disabled', currentPage === 1);
                $('#nextPage').prop('disabled', currentPage === totalPages);

                renderPageNumbers(totalPages);
            }

            function renderPageNumbers(totalPages) {
                let html = '';
                for (let i = 1; i <= totalPages; i++) {
                    if (i === currentPage) {
                        html += `<button class="px-3.5 py-1.5 text-xs font-bold text-white bg-ngk-primary rounded-xl shadow-sm border border-ngk-primary">${i}</button>`;
                    } else {
                        html += `<button type="button" class="page-btn px-3.5 py-1.5 text-xs font-bold text-slate-600 bg-white hover:bg-slate-100 border border-slate-200 rounded-xl transition-colors shadow-sm" data-page="${i}">${i}</button>`;
                    }
                }
                $('#pageNumbers').html(html);
            }

            // Events
            $searchInput.on('input', function() {
                currentPage = 1;
                applyFiltersAndPagination();
            });

            $statusFilter.on('change', function() {
                currentPage = 1;
                applyFiltersAndPagination();
            });

            $categoryFilter.on('change', function() {
                currentPage = 1;
                applyFiltersAndPagination();
            });

            $('#prevPage').click(function() {
                if (currentPage > 1) {
                    currentPage--;
                    applyFiltersAndPagination();
                }
            });

            $('#nextPage').click(function() {
                const searchVal = $searchInput.val().toLowerCase().trim();
                const statusVal = $statusFilter.val();
                const categoryVal = $categoryFilter.val();
                let visibleCount = $rows.filter(function() {
                    const $row = $(this);
                    return (!searchVal || $row.attr('data-search').indexOf(searchVal) > -1) &&
                           (!statusVal || $row.attr('data-status') === statusVal) &&
                           (!categoryVal || $row.attr('data-category') === categoryVal);
                }).length;
                
                const totalPages = Math.ceil(visibleCount / rowsPerPage);
                if (currentPage < totalPages) {
                    currentPage++;
                    applyFiltersAndPagination();
                }
            });

            $(document).on('click', '.page-btn', function() {
                currentPage = $(this).data('page');
                applyFiltersAndPagination();
            });

            // Initial load
            applyFiltersAndPagination();
        });
    </script>
}
