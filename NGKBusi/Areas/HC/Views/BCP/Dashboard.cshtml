@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/BCP/bcp.js"></script>
    <script>
        $(document).ready(function() {
            var errorMsg = '@TempData["ErrorMessage"]';
            if (errorMsg) {
                Swal.fire({
                    icon: 'error',
                    title: 'Akses Ditolak',
                    text: errorMsg,
                    confirmButtonColor: '#007581'
                });
            }

            // Pagination for Recent Incidents
            const rowsPerPage = 5;
            let currentPage = 1;
            const $tableBody = $('#recentIncidentsTable tbody');
            const $rows = $tableBody.find('tr.incident-row');
            const totalRows = $rows.length;
            const totalPages = Math.ceil(totalRows / rowsPerPage);

            function showPage(page) {
                if (totalRows === 0) return;
                
                currentPage = page;
                const start = (currentPage - 1) * rowsPerPage;
                const end = start + rowsPerPage;

                $rows.hide();
                $rows.slice(start, end).show();

                $('#pageStart').text(start + 1);
                $('#pageEnd').text(Math.min(end, totalRows));
                $('#totalRows').text(totalRows);

                $('#prevPage').prop('disabled', currentPage === 1);
                $('#nextPage').prop('disabled', currentPage === totalPages);
                
                renderPageNumbers();
            }

            function renderPageNumbers() {
                let html = '';
                for (let i = 1; i <= totalPages; i++) {
                    if (i === currentPage) {
                        html += `<button class="px-3 py-1 text-xs font-bold text-white bg-ngk-primary rounded">${i}</button>`;
                    } else {
                        html += `<button type="button" class="page-btn px-3 py-1 text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded transition-colors" data-page="${i}">${i}</button>`;
                    }
                }
                $('#pageNumbers').html(html);
            }

            if (totalRows > rowsPerPage) {
                $('#paginationControls').show();
                showPage(1);

                $('#prevPage').click(function() {
                    if (currentPage > 1) showPage(currentPage - 1);
                });

                $('#nextPage').click(function() {
                    if (currentPage < totalPages) showPage(currentPage + 1);
                });

                $(document).on('click', '.page-btn', function() {
                    showPage($(this).data('page'));
                });
            } else if (totalRows > 0) {
                $('#paginationControls').show();
                $('#paginationControls .flex.gap-1').hide(); // Hide buttons if only 1 page
                showPage(1);
            } else {
                $('#paginationControls').hide();
            }
        });

        function updateDashboardTodoStatus(todoId, selectElement) {
            var newStatus = selectElement.value;
            var currentDueDate = $(selectElement).data('current-duedate');
            var previousStatus = $(selectElement).data('previous-status') || 'On Progress';

            if (newStatus === 'Pending') {
                Swal.fire({
                    title: '<span class="font-black text-slate-800 text-base">Mark Task as Pending</span>',
                    html: `
                        <div class="text-left mb-4">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Pending Reason / Note <span class="text-rose-500">*</span></label>
                            <textarea id="swal-pending-note" rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-800 focus:ring-2 focus:ring-ngk-primary/20 focus:border-ngk-primary focus:bg-white transition-all outline-none resize-none" placeholder="Provide a reason or note for this pending status..."></textarea>
                        </div>
                        <div class="text-left">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">New Due Date <span class="text-rose-500">*</span></label>
                            <input type="date" id="swal-pending-duedate" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-800 focus:ring-2 focus:ring-ngk-primary/20 focus:border-ngk-primary focus:bg-white transition-all outline-none" value="${currentDueDate}">
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonColor: '#007581',
                    cancelButtonColor: '#94a3b8',
                    confirmButtonText: 'Submit Status',
                    cancelButtonText: 'Cancel',
                    focusConfirm: false,
                    preConfirm: () => {
                        const note = Swal.getPopup().querySelector('#swal-pending-note').value.trim();
                        const dueDate = Swal.getPopup().querySelector('#swal-pending-duedate').value;
                        if (!note) {
                            Swal.showValidationMessage('Pending note is required');
                            return false;
                        }
                        if (!dueDate) {
                            Swal.showValidationMessage('Due date is required');
                            return false;
                        }
                        return { note: note, dueDate: dueDate };
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.showLoading();
                        $.post('@Url.Action("UpdateTodoStatus", "BCP")', {
                            TodoID: todoId,
                            Status: 'Pending',
                            PendingNote: result.value.note,
                            DueDate: result.value.dueDate
                        }, function (res) {
                            if (res.status === 'success') {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Status Updated',
                                    text: 'Task status updated to Pending.',
                                    confirmButtonColor: '#007581'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', res.message, 'error');
                                $(selectElement).val(previousStatus);
                            }
                        }).fail(function() {
                            Swal.fire('Error', 'Network connection error', 'error');
                            $(selectElement).val(previousStatus);
                        });
                    } else {
                        $(selectElement).val(previousStatus);
                    }
                });
            } else {
                Swal.fire({
                    title: 'Update Task Status?',
                    text: `Are you sure you want to update this task status to "${newStatus}"?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#007581',
                    cancelButtonColor: '#94a3b8',
                    confirmButtonText: 'Yes, update'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.showLoading();
                        $.post('@Url.Action("UpdateTodoStatus", "BCP")', {
                            TodoID: todoId,
                            Status: newStatus
                        }, function (res) {
                            if (res.status === 'success') {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Status Updated',
                                    text: `Task status updated to ${newStatus}.`,
                                    confirmButtonColor: '#007581'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', res.message, 'error');
                                $(selectElement).val(previousStatus);
                            }
                        }).fail(function() {
                            Swal.fire('Error', 'Network connection error', 'error');
                            $(selectElement).val(previousStatus);
                        });
                    } else {
                        $(selectElement).val(previousStatus);
                    }
                });
            }
        }
    </script>
}
