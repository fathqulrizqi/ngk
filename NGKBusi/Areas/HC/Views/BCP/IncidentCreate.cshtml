@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var deptAreas = (List<NGKBusi.Areas.HC.Models.HC_BCP_Area>)ViewBag.Areas;
    string userRoleText = string.IsNullOrEmpty(ViewBag.UserBcpRole) ? "Committee Member" : (string)ViewBag.UserBcpRole;
}

<!-- Use Tailwind via CDN for enhanced styling -->
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<script>
    tailwind.config = {
        corePlugins: { preflight: false },
        theme: {
            extend: {
                fontFamily: { sans: ['Inter', 'sans-serif'] },
                colors: { 
                    ngk: {
                        primary: '#007581',
                        primaryLight: '#e0f3f5',
                        primaryDark: '#00555e',
                        accent: '#eeb500',
                        accentLight: '#fdf7e6'
                    }
                }
            }
        }
    }
</script>

<!-- Select2 Searchable Dropdown CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .fade-up { animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) both; }
    @@keyframes fadeUp { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
    
    .drop-zone {
        transition: all 0.2s ease-in-out;
    }
    .drop-zone:hover {
        border-color: #007581;
        background-color: #f8fafc;
    }
    .custom-input:focus {
        border-color: #007581;
        box-shadow: 0 0 0 3px rgba(0, 117, 129, 0.15);
    }

    /* Select2 Corporate Modern Theme */
    .select2-container {
        width: 100% !important;
    }
    .select2-container .select2-selection--single {
        height: 48px !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 0.75rem !important;
        background-color: rgba(248, 250, 252, 0.6) !important;
        display: flex !important;
        align-items: center !important;
        padding: 0 14px !important;
        transition: all 0.2s ease-in-out;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #1e293b !important;
        font-size: 0.875rem !important;
        font-weight: 500 !important;
        padding-left: 0 !important;
        padding-right: 20px !important;
        line-height: normal !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__placeholder {
        color: #94a3b8 !important;
        font-size: 0.875rem !important;
        font-weight: 400 !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 46px !important;
        right: 12px !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow b {
        border-color: #64748b transparent transparent transparent !important;
        border-width: 5px 4px 0 4px !important;
    }
    .select2-container--default.select2-container--open .select2-selection--single .select2-selection__arrow b {
        border-color: transparent transparent #007581 transparent !important;
        border-width: 0 4px 5px 4px !important;
    }
    .select2-container--open .select2-selection--single,
    .select2-container--focus .select2-selection--single {
        border-color: #007581 !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 3px rgba(0, 117, 129, 0.15) !important;
    }
    .select2-dropdown {
        border: 1px solid #cbd5e1 !important;
        border-radius: 0.75rem !important;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
        padding: 6px !important;
        background-color: #ffffff !important;
        z-index: 9999 !important;
        overflow: hidden !important;
    }
    .select2-search--dropdown {
        padding: 4px 4px 8px 4px !important;
    }
    .select2-search--dropdown .select2-search__field {
        border: 1px solid #e2e8f0 !important;
        border-radius: 0.5rem !important;
        padding: 8px 12px !important;
        font-size: 0.813rem !important;
        outline: none !important;
        font-family: inherit !important;
        background-color: #f8fafc !important;
    }
    .select2-search--dropdown .select2-search__field:focus {
        border-color: #007581 !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 2px rgba(0, 117, 129, 0.15) !important;
    }
    .select2-results__option {
        padding: 8px 12px !important;
        font-size: 0.813rem !important;
        font-weight: 500 !important;
        border-radius: 0.5rem !important;
        margin-bottom: 2px !important;
        color: #334155 !important;
        transition: all 0.15s ease;
    }
    .select2-results__option--highlighted[aria-selected] {
        background-color: #e0f3f5 !important;
        color: #00555e !important;
    }
    .select2-results__option[aria-selected="true"] {
        background-color: #007581 !important;
        color: #ffffff !important;
    }
</style>

<div class="w-full bg-slate-50 min-h-screen py-6 px-3 sm:px-6 md:px-8 font-sans">
    
    <!-- Top Header Banner -->
    <div class="w-full mb-8 fade-up">
        <!-- Breadcrumb -->
        <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4 ml-1">
            <a href="@Url.Action("Dashboard", "BCP")" class="hover:text-ngk-primary transition-colors flex items-center gap-1.5">
                <i class="fas fa-home"></i> BCP Portal
            </a>
            <i class="fas fa-chevron-right text-[9px] text-slate-300"></i>
            <span class="text-ngk-primary font-bold">New Incident Report</span>
        </div>

        <!-- Header Card -->
        <div class="relative overflow-hidden rounded-2xl border border-slate-200 shadow-sm" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #164e63 100%);">
            <!-- Decorative light effects -->
            <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10" style="background: radial-gradient(circle, #007581 0%, transparent 70%); transform: translate(30%, -40%); pointer-events: none;"></div>
            <div class="absolute bottom-0 left-1/3 w-64 h-64 rounded-full opacity-10" style="background: radial-gradient(circle, #eeb500 0%, transparent 70%); transform: translate(-50%, 50%); pointer-events: none;"></div>

            <div class="relative z-10 px-6 sm:px-8 py-7 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div class="flex items-start gap-4 sm:gap-5">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center shrink-0 shadow-lg" style="background: linear-gradient(135deg, #007581 0%, #00555e 100%); border: 1px solid rgba(255,255,255,0.2);">
                        <i class="fas fa-bullhorn text-white text-2xl"></i>
                    </div>
                    <div>
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-teal-300 text-[11px] font-extrabold uppercase tracking-widest mb-2">
                            <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
                            Step 1: Incident Initiation
                        </div>
                        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight m-0">Create Crisis Incident Report</h1>
                        <p class="text-slate-300 mt-1.5 text-xs sm:text-sm font-normal max-w-2xl leading-relaxed m-0">
                            Submit key incident parameters to immediately trigger the BCP workflow and alert the Emergency Committee.
                        </p>
                    </div>
                </div>

                <!-- Reporter Identity Badge -->
                <div class="flex items-center gap-3 bg-slate-800/60 backdrop-blur-md border border-slate-700/80 px-4 py-3 rounded-xl self-start lg:self-center shrink-0">
                    <div class="w-10 h-10 rounded-xl bg-ngk-primary/20 flex items-center justify-center border border-ngk-primary/40 text-teal-300">
                        <i class="fas fa-user-shield text-base"></i>
                    </div>
                    <div>
                        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mb-0.5">Reporting Authority</p>
                        <p class="font-extrabold text-xs sm:text-sm text-white m-0">@userRoleText</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Layout -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-8">
        
        <!-- Left 8 Columns: Form -->
        <div class="xl:col-span-8 space-y-8">
            <form id="incidentForm" class="space-y-8">

                <!-- 1. GENERAL INFORMATION CARD -->
                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden fade-up">
                    <div class="px-6 py-4 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-teal-50 text-ngk-primary flex items-center justify-center font-bold text-sm border border-teal-100">
                                <i class="fas fa-info-circle"></i>
                            </div>
                            <div>
                                <h3 class="text-sm font-extrabold text-slate-800 uppercase tracking-wider m-0">1. Incident Overview</h3>
                                <p class="text-[11px] text-slate-400 m-0">Basic identification and categorization of the event</p>
                            </div>
                        </div>
                        <span class="text-[11px] font-bold text-rose-500 bg-rose-50 border border-rose-200 px-2.5 py-1 rounded-full">
                            * Mandatory Fields
                        </span>
                    </div>

                    <div class="p-6 sm:p-8 space-y-6">
                        <!-- Incident Title -->
                        <div>
                            <label class="block font-bold text-slate-700 text-xs uppercase tracking-wider mb-2">
                                Incident Title (Headline) <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" id="Title" name="Title" required 
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-800 text-sm font-medium transition-all custom-input placeholder:text-slate-400" 
                                   placeholder="e.g. Major Structural Failure - Plant 1 Production Line A" />
                        </div>

                        <!-- Tagline Quote -->
                        <div>
                            <label class="block font-bold text-slate-700 text-xs uppercase tracking-wider mb-2">
                                Executive Summary (One-liner Tagline)
                            </label>
                            <input type="text" id="Tagline" name="Tagline" 
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-800 text-sm transition-all custom-input placeholder:text-slate-400" 
                                   placeholder="e.g. Production halted due to localized fire; evacuation complete with no casualties." />
                            <p class="text-[11px] text-slate-400 mt-1.5 flex items-center gap-1">
                                <i class="fas fa-quote-left text-slate-300"></i> This text will appear as the highlighted executive quote on the incident dashboard.
                            </p>
                        </div>

                        <!-- Category & Impacted Area Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Category -->
                            <div>
                                <label class="block font-bold text-slate-700 text-xs uppercase tracking-wider mb-2">
                                    Incident Category <span class="text-rose-500">*</span>
                                </label>
                                <select id="Category" name="Category" required class="w-full select2-searchable">
                                    <option value="">-- Select Category --</option>
                                    <option value="Natural Disaster">Natural Disaster (Gempa, Banjir, Badai)</option>
                                    <option value="Facility Failure">Facility & Structural Failure</option>
                                    <option value="Fire/Explosion">Fire / Explosion Incident</option>
                                    <option value="Supply Chain Disruption">Supply Chain & Logistics Disruption</option>
                                    <option value="IT/Utility Failure">IT Infrastructure / Power Outage</option>
                                    <option value="Safety/Security">Safety & Hazardous Material</option>
                                    <option value="Other">Other Emergency Event</option>
                                </select>
                            </div>

                            <!-- Primary Impacted Area -->
                            <div>
                                <label class="block font-bold text-slate-700 text-xs uppercase tracking-wider mb-2">
                                    Primary Impacted Area <span class="text-rose-500">*</span>
                                </label>
                                <select id="SourceAreaID" name="SourceAreaID" required class="w-full select2-searchable">
                                    @if (deptAreas != null && deptAreas.Any())
                                    {
                                        <option value="">-- Choose Assigned Department Area --</option>
                                        foreach (var area in deptAreas)
                                        {
                                            <option value="@area.ID">@area.AreaName</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="">-- No Areas Mapped to Your Department --</option>
                                    }
                                </select>
                                @if (deptAreas == null || !deptAreas.Any())
                                {
                                    <p class="text-[11px] text-rose-600 mt-2 font-bold flex items-center gap-1">
                                        <i class="fas fa-exclamation-triangle"></i> Your department currently has no assigned areas in the BCP Matrix. Please contact Admin.
                                    </p>
                                }
                                else
                                {
                                    <p class="text-[11px] text-slate-400 mt-1.5 flex items-center gap-1">
                                        <i class="fas fa-info-circle text-teal-600"></i> Showing areas mapped under your active department assignment.
                                    </p>
                                }
                            </div>
                        </div>

                        <!-- Detailed Narrative Findings -->
                        <div>
                            <label class="block font-bold text-slate-700 text-xs uppercase tracking-wider mb-2">
                                Detailed Narrative & Site Observation <span class="text-rose-500">*</span>
                            </label>
                            <textarea id="Description" name="Description" rows="4" required 
                                      class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-800 text-sm transition-all custom-input placeholder:text-slate-400 leading-relaxed" 
                                      placeholder="Provide full context of what occurred, initial chronology, observable damage, and preliminary conditions..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- 2. STRUCTURED IMPACT BREAKDOWN -->
                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden fade-up">
                    <div class="px-6 py-4 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-sm border border-amber-100">
                                <i class="fas fa-layer-group"></i>
                            </div>
                            <div>
                                <h3 class="text-sm font-extrabold text-slate-800 uppercase tracking-wider m-0">2. Crisis Impact Assessment</h3>
                                <p class="text-[11px] text-slate-400 m-0">Specific breakdown across critical dimensions</p>
                            </div>
                        </div>
                    </div>

                    <div class="p-6 sm:p-8 grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- Infrastructure Impact -->
                        <div class="space-y-2">
                            <label class="flex items-center gap-2 font-bold text-slate-700 text-xs uppercase tracking-wider">
                                <span class="w-6 h-6 rounded-md bg-amber-100 text-amber-700 flex items-center justify-center text-[10px]">
                                    <i class="fas fa-tools"></i>
                                </span>
                                Infrastructure Impact <span class="text-rose-500">*</span>
                            </label>
                            <textarea id="InfrastructureImpact" name="InfrastructureImpact" required rows="4" 
                                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-800 text-xs transition-all custom-input placeholder:text-slate-400 leading-relaxed" 
                                      placeholder="e.g. Core switch offline, power generator damaged, water supply cut off on line 2..."></textarea>
                        </div>

                        <!-- Personnel Status -->
                        <div class="space-y-2">
                            <label class="flex items-center gap-2 font-bold text-slate-700 text-xs uppercase tracking-wider">
                                <span class="w-6 h-6 rounded-md bg-rose-100 text-rose-700 flex items-center justify-center text-[10px]">
                                    <i class="fas fa-users"></i>
                                </span>
                                Personnel & Safety <span class="text-rose-500">*</span>
                            </label>
                            <textarea id="PersonnelStatus" name="PersonnelStatus" required rows="4" 
                                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-800 text-xs transition-all custom-input placeholder:text-slate-400 leading-relaxed" 
                                      placeholder="e.g. 42 staff evacuated safely, 1 minor first-aid injury treated, zero casualties..."></textarea>
                        </div>

                        <!-- Immediate Actions -->
                        <div class="space-y-2">
                            <label class="flex items-center gap-2 font-bold text-slate-700 text-xs uppercase tracking-wider">
                                <span class="w-6 h-6 rounded-md bg-emerald-100 text-emerald-700 flex items-center justify-center text-[10px]">
                                    <i class="fas fa-bolt"></i>
                                </span>
                                Immediate Actions <span class="text-rose-500">*</span>
                            </label>
                            <textarea id="ImmediateActions" name="ImmediateActions" required rows="4" 
                                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-800 text-xs transition-all custom-input placeholder:text-slate-400 leading-relaxed" 
                                      placeholder="e.g. Main gas valves shut off, fire brigade on site, cordoned 50m radius..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- 3. PHOTO DOCUMENTATION -->
                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden fade-up">
                    <div class="px-6 py-4 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center font-bold text-sm border border-sky-100">
                                <i class="fas fa-camera"></i>
                            </div>
                            <div>
                                <h3 class="text-sm font-extrabold text-slate-800 uppercase tracking-wider m-0">3. Photographic Evidence</h3>
                                <p class="text-[11px] text-slate-400 m-0">Upload visual documentation from the site (Minimum 1 photo required)</p>
                            </div>
                        </div>
                        <span class="text-[11px] font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full">
                            Max 4 Images
                        </span>
                    </div>

                    <div class="p-6 sm:p-8">
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            @for (int slot = 1; slot <= 4; slot++)
                            {
                                <div class="space-y-2">
                                    <div class="relative group h-36">
                                        <input type="file" id="Photo@(slot)" name="Photos" class="hidden file-input" accept="image/*" data-slot="@(slot)">
                                        <label for="Photo@(slot)" id="dropzone@(slot)" class="w-full h-full cursor-pointer rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50/50 hover:bg-slate-100/70 hover:border-ngk-primary transition-all flex flex-col items-center justify-center text-center overflow-hidden drop-zone shadow-inner relative" data-slot="@(slot)">
                                            <!-- Default Placeholder -->
                                            <div id="placeholder@(slot)" class="flex flex-col items-center justify-center p-3 pointer-events-none transition-all w-full h-full">
                                                <div class="w-10 h-10 rounded-full bg-slate-100 group-hover:bg-teal-50 text-slate-400 group-hover:text-ngk-primary flex items-center justify-center mb-2 transition-colors">
                                                    <i class="fas fa-camera text-base"></i>
                                                </div>
                                                <span class="text-xs font-bold text-slate-600 group-hover:text-ngk-primary transition-colors">Slot @(slot)</span>
                                                <span class="text-[10px] text-slate-400 mt-0.5">Click or Drag</span>
                                            </div>

                                            <!-- Image Preview Container -->
                                            <div id="preview-container@(slot)" class="absolute inset-0 w-full h-full overflow-hidden" style="display: none; z-index: 10;">
                                                <img id="preview-img@(slot)" src="" alt="Preview Slot @(slot)" style="width: 100%; height: 100%; object-fit: cover;" />
                                                <div class="absolute top-2 right-2 bg-white/95 rounded-full p-1.5 shadow-md flex items-center justify-center" style="z-index: 15;">
                                                    <i class="fas fa-check text-emerald-600 text-xs"></i>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                    <button type="button" id="delete-btn-@(slot)" class="w-full py-1.5 bg-rose-50 text-rose-600 rounded-xl text-[11px] font-bold border border-rose-200 hover:bg-rose-100 transition-all items-center justify-center gap-1.5 btn-remove-photo shadow-sm" style="display: none;" data-slot="@(slot)">
                                        <i class="fas fa-trash-alt text-[10px]"></i> Remove Image
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- SUBMIT ACTION BAR -->
                <div class="p-6 bg-white border border-slate-200 rounded-2xl shadow-sm flex flex-col sm:flex-row justify-between items-center gap-4 fade-up">
                    <button type="button" class="w-full sm:w-auto px-5 py-3 rounded-xl border border-slate-200 text-slate-600 font-bold text-xs uppercase tracking-wider hover:bg-slate-100 hover:text-slate-800 transition-colors flex items-center justify-center gap-2" onclick="window.location.href='@Url.Action("Dashboard", "BCP")'">
                        <i class="fas fa-arrow-left text-[11px]"></i> Cancel & Back
                    </button>
                    
                    <button type="button" id="btnSubmitIncident" onclick="submitIncidentForm()" 
                            class="w-full sm:w-auto px-8 py-3.5 rounded-xl text-white font-extrabold text-sm uppercase tracking-wider shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2.5 cursor-pointer border-0"
                            style="background: linear-gradient(135deg, #007581 0%, #00555e 100%);">
                        <span>Submit Incident Report</span>
                        <i class="fas fa-paper-plane text-xs"></i>
                    </button>
                </div>

            </form>
        </div>

        <!-- Right 4 Columns: Side Guide & Crisis Protocol -->
        <div class="xl:col-span-4 space-y-6">
            
            <!-- BCP Workflow Timeline Card -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 relative overflow-hidden fade-up">
                <div class="absolute -right-8 -top-8 w-28 h-28 bg-teal-50 rounded-full opacity-60 pointer-events-none"></div>
                
                <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest mb-4 flex items-center gap-2 m-0">
                    <i class="fas fa-sitemap text-ngk-primary"></i> Response Workflow
                </h4>
                
                <div class="space-y-4 text-xs">
                    <!-- Step 1 (Current) -->
                    <div class="flex items-start gap-3 relative">
                        <div class="w-7 h-7 rounded-full bg-teal-500 text-white flex items-center justify-center font-extrabold text-xs shrink-0 shadow-sm">1</div>
                        <div>
                            <p class="font-extrabold text-slate-800 m-0">Incident Reported</p>
                            <p class="text-slate-500 text-[11px] mt-0.5 m-0">Initial facts recorded and committee alerted.</p>
                        </div>
                    </div>
                    
                    <!-- Line -->
                    <div class="ml-3.5 h-3 border-l-2 border-slate-200"></div>

                    <!-- Step 2 -->
                    <div class="flex items-start gap-3">
                        <div class="w-7 h-7 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center font-bold text-xs shrink-0 border border-slate-200">2</div>
                        <div>
                            <p class="font-bold text-slate-700 m-0">Area Impact Assessments</p>
                            <p class="text-slate-400 text-[11px] mt-0.5 m-0">Committee members evaluate operational impact.</p>
                        </div>
                    </div>

                    <!-- Line -->
                    <div class="ml-3.5 h-3 border-l-2 border-slate-200"></div>

                    <!-- Step 3 -->
                    <div class="flex items-start gap-3">
                        <div class="w-7 h-7 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center font-bold text-xs shrink-0 border border-slate-200">3</div>
                        <div>
                            <p class="font-bold text-slate-700 m-0">Management Review</p>
                            <p class="text-slate-400 text-[11px] mt-0.5 m-0">Senior Managers & DGM review risk scores.</p>
                        </div>
                    </div>

                    <!-- Line -->
                    <div class="ml-3.5 h-3 border-l-2 border-slate-200"></div>

                    <!-- Step 4 -->
                    <div class="flex items-start gap-3">
                        <div class="w-7 h-7 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center font-bold text-xs shrink-0 border border-slate-200">4</div>
                        <div>
                            <p class="font-bold text-slate-700 m-0">Final Activation Decision</p>
                            <p class="text-slate-400 text-[11px] mt-0.5 m-0">Executive authorization to execute BCP actions.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Emergency Hotlines Card -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 fade-up">
                <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest mb-4 flex items-center gap-2 m-0">
                    <i class="fas fa-phone-alt text-rose-500"></i> Emergency Hotlines
                </h4>
                <div class="space-y-3">
                    <div class="p-3 bg-rose-50/70 border border-rose-100 rounded-xl flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-rose-500 text-white flex items-center justify-center text-xs">
                                <i class="fas fa-fire-extinguisher"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-extrabold text-rose-800 uppercase tracking-wider m-0">HSE Crisis Line</p>
                                <p class="text-xs font-black text-rose-900 m-0">Ext. 911 / 112</p>
                            </div>
                        </div>
                        <span class="text-[10px] font-bold text-rose-700 bg-rose-100 px-2 py-0.5 rounded-md">24 / 7</span>
                    </div>

                    <div class="p-3 bg-sky-50/70 border border-sky-100 rounded-xl flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-sky-600 text-white flex items-center justify-center text-xs">
                                <i class="fas fa-network-wired"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-extrabold text-sky-800 uppercase tracking-wider m-0">IT Command Center</p>
                                <p class="text-xs font-black text-sky-900 m-0">Ext. 5001 / 5002</p>
                            </div>
                        </div>
                        <span class="text-[10px] font-bold text-sky-700 bg-sky-100 px-2 py-0.5 rounded-md">IT Help</span>
                    </div>

                    <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-slate-700 text-white flex items-center justify-center text-xs">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-extrabold text-slate-700 uppercase tracking-wider m-0">Security Post</p>
                                <p class="text-xs font-black text-slate-800 m-0">Ext. 1000</p>
                            </div>
                        </div>
                        <span class="text-[10px] font-bold text-slate-600 bg-slate-200 px-2 py-0.5 rounded-md">Main Gate</span>
                    </div>
                </div>
            </div>

            <!-- Reporting Policy Note -->
            <div class="p-5 rounded-2xl bg-amber-50/60 border border-amber-200 text-amber-900 text-xs leading-relaxed fade-up">
                <div class="flex items-start gap-2.5">
                    <i class="fas fa-shield-alt text-amber-600 text-base mt-0.5"></i>
                    <div>
                        <p class="font-extrabold text-amber-950 uppercase tracking-wider text-[11px] mb-1 m-0">Reporting Policy</p>
                        <p class="text-amber-800 text-[11px] m-0 leading-normal">
                            All incident facts and photographic evidence are logged into the audit trail for regulatory compliance and business continuity reporting.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <!-- Select2 Searchable Dropdown JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/Scripts/BCP/bcp.js"></script>
    <script>
        $(document).ready(function() {
            // Initialize Select2 with Search
            $('#Category').select2({
                placeholder: "-- Select Incident Category --",
                allowClear: true,
                width: '100%'
            });

            $('#SourceAreaID').select2({
                placeholder: "-- Choose Assigned Department Area --",
                allowClear: true,
                width: '100%'
            });

            // Handle file input change
            $(document).on('change', '.file-input', function() {
                var slot = $(this).data('slot');
                if (this.files && this.files.length > 0) {
                    displayPhotoPreview(this.files[0], slot);
                }
            });

            // Drag and Drop events
            $('.drop-zone').on('dragover', function(e) {
                e.preventDefault();
                $(this).addClass('border-ngk-primary bg-teal-50/50 scale-[1.02]');
            });

            $('.drop-zone').on('dragleave', function(e) {
                e.preventDefault();
                $(this).removeClass('border-ngk-primary bg-teal-50/50 scale-[1.02]');
            });

            $('.drop-zone').on('drop', function(e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).removeClass('border-ngk-primary bg-teal-50/50 scale-[1.02]');
                
                var slot = $(this).data('slot');
                var files = e.originalEvent.dataTransfer.files;
                if (files && files.length > 0) {
                    $('#Photo' + slot)[0].files = files;
                    displayPhotoPreview(files[0], slot);
                }
            });
        });

        function displayPhotoPreview(file, slot) {
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function(e) {
                $('#preview-img' + slot).attr('src', e.target.result);
                $('#placeholder' + slot).css('display', 'none');
                $('#preview-container' + slot).css('display', 'block');
                $('#delete-btn-' + slot).css('display', 'flex');
                $('#dropzone' + slot).removeClass('border-dashed border-slate-300').addClass('border-solid border-teal-600 shadow-md');
            };
            reader.readAsDataURL(file);
        }

        // Global click handler for remove button
        $(document).on('click', '.btn-remove-photo', function(e) {
            e.preventDefault();
            var slot = $(this).data('slot');

            $('#Photo' + slot).val('');
            if ($('#Photo' + slot)[0]) {
                $('#Photo' + slot)[0].value = '';
            }

            $('#preview-img' + slot).attr('src', '');
            $('#preview-container' + slot).css('display', 'none');
            $('#placeholder' + slot).css('display', 'flex');
            $('#delete-btn-' + slot).css('display', 'none');
            $('#dropzone' + slot).removeClass('border-solid border-teal-600 shadow-md').addClass('border-dashed border-slate-300');
        });

        function submitIncidentForm() {
            var title = $('#Title').val();
            var category = $('#Category').val();
            var description = $('#Description').val();
            var infra = $('#InfrastructureImpact').val();
            var personnel = $('#PersonnelStatus').val();
            var actions = $('#ImmediateActions').val();
            var sourceArea = $('#SourceAreaID').val();
            
            // Check for at least 1 image
            var hasImage = false;
            $('.file-input').each(function() {
                if ($(this)[0].files.length > 0) hasImage = true;
            });

            if(!title || title.trim() === "" || !category || category === "" || !description || description.trim() === "" ||
               !infra || infra.trim() === "" || !personnel || personnel.trim() === "" || !actions || actions.trim() === "" || !sourceArea || sourceArea === "") {
                Swal.fire({
                    icon: 'warning',
                    title: 'Form Belum Lengkap',
                    text: 'Mohon lengkapi seluruh field wajib (termasuk Impacted Area & Detail Dampak).',
                    confirmButtonColor: '#007581'
                });
                return;
            }

            if(!hasImage) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Foto Dokumentasi Wajib',
                    text: 'Mohon unggah minimal 1 foto bukti visual dari lokasi kejadian.',
                    confirmButtonColor: '#007581'
                });
                return;
            }

            Swal.fire({
                title: 'Kirim Laporan Insiden?',
                text: "Laporan insiden akan dicatat dan seluruh Komite BCP akan menerima notifikasi untuk segera melakukan penilaian area. Lanjutkan?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#007581',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Ya, Kirim Laporan',
                cancelButtonText: 'Periksa Kembali'
            }).then((result) => {
                if (result.isConfirmed) {
                    processSubmit();
                }
            });
        }

        function processSubmit() {
            Swal.fire({
                title: 'Sedang Memproses...',
                text: 'Menyimpan laporan insiden BCP...',
                allowOutsideClick: false,
                showConfirmButton: false,
                willOpen: () => { Swal.showLoading() }
            });

            var form = $('#incidentForm')[0];
            var formData = new FormData(form);

            $.ajax({
                type: 'POST',
                url: '@Url.Action("SubmitIncident", "BCP")',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    if(res.status === 'success') {
                        Swal.fire({
                            icon: 'success',
                            title: res.title,
                            text: res.message,
                            confirmButtonColor: '#007581'
                        }).then(() => {
                            window.location.href = '@Url.Action("Dashboard", "BCP", new { area = "HC" })';
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: res.title,
                            text: res.message,
                            confirmButtonColor: '#e11d48'
                        });
                    }
                },
                error: function(err) {
                    Swal.fire({
                        icon: 'error',
                        title: 'System Error',
                        text: 'Gagal terhubung ke server. Periksa koneksi Anda.',
                        confirmButtonColor: '#e11d48'
                    });
                }
            });
        }
    </script>
}
