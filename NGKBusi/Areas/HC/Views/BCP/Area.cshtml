@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Tailwind via CDN -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        corePlugins: { preflight: false },
        theme: {
            extend: {
                colors: { 
                    ngk: {
                        primary: '#007581',
                        primaryLight: '#e0f3f5',
                        primaryDark: '#00555e',
                        accent: '#eeb500',
                        accentLight: '#fdf7e6'
                    }
                }
            }
        }
    }
</script>

<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<!-- Inline Styles to override Bootstrap conflicts and style premium components -->
<style>
    .bcp-table th {
        background-color: #f8fafc !important;
        color: #475569 !important;
        font-weight: 600 !important;
        text-transform: uppercase !important;
        font-size: 0.75rem !important;
        letter-spacing: 0.05em !important;
        border-bottom: 2px solid #e2e8f0 !important;
    }
    .bcp-table td {
        vertical-align: middle !important;
        border-bottom: 1px solid #f1f5f9 !important;
        color: #334155 !important;
        font-size: 0.875rem !important;
    }
    .bcp-btn-primary {
        background-color: #007581 !important;
        color: #ffffff !important;
        border: none !important;
    }
    .bcp-btn-primary:hover {
        background-color: #00555e !important;
    }
    .bcp-glass {
        background: rgba(255, 255, 255, 0.8) !important;
        backdrop-filter: blur(8px) !important;
    }

    /* Fix Select2 container width */
    .select2-container {
        width: 100% !important;
    }

    /* Style Select2 to match premium Tailwind look */
    .select2-container--default .select2-selection--single {
        border-color: #cbd5e1 !important;
        border-radius: 0.75rem !important;
        height: 42px !important;
        display: flex !important;
        align-items: center !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 36px !important;
        right: 8px !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #334155 !important;
        font-weight: 500 !important;
        font-size: 0.875rem !important;
        padding-left: 12px !important;
    }
    .select2-dropdown {
        border-color: #cbd5e1 !important;
        border-radius: 0.75rem !important;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1) !important;
        overflow: hidden !important;
    }
    .select2-search--dropdown .select2-search__field {
        border-color: #cbd5e1 !important;
        border-radius: 0.5rem !important;
        padding: 6px 10px !important;
        font-size: 0.875rem !important;
    }
    .select2-results__option {
        font-size: 0.875rem !important;
        padding: 8px 12px !important;
    }
    .select2-container--default .select2-results__option--highlighted[aria-selected] {
        background-color: #007581 !important;
    }
</style>

<div class="container-fluid py-4 px-md-5">
    <!-- Breadcrumb & Header -->
    <div class="bg-gradient-to-r from-white to-ngk-primaryLight border border-slate-200/60 rounded-2xl p-6 sm:p-8 mb-8 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center">
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-500 mb-2 font-medium">
                <a href="@Url.Action("Dashboard", "BCP")" class="hover:text-ngk-primary transition-colors no-underline">BCP Dashboard</a>
                <span>/</span>
                <span class="text-ngk-primary font-semibold">Area Master</span>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight m-0">Area Master</h1>
            <p class="text-slate-500 mt-1 text-sm md:text-base m-0">Manage plant locations, lines, or zones assigned for monitoring.</p>
        </div>
        <div class="mt-4 md:mt-0 flex flex-wrap items-center gap-3">
            <a href="@Url.Action("DownloadAreaTemplate", "BCP")" class="inline-flex items-center gap-2 px-4 py-3 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-xl shadow-sm transition-all font-semibold cursor-pointer text-center select-none" style="text-decoration: none;">
                <i class="fas fa-file-download text-emerald-600"></i>
                Template Excel
            </a>
            <button id="btnUploadExcel" class="inline-flex items-center gap-2 px-4 py-3 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-xl shadow-sm transition-all font-semibold cursor-pointer">
                <i class="fas fa-file-upload text-blue-600"></i>
                Upload Excel
            </button>
            <button id="btnNewArea" class="inline-flex items-center gap-2 px-5 py-3 bcp-btn-primary text-white rounded-xl shadow-md hover:shadow-lg transition-all font-semibold cursor-pointer border-0">
                <i class="fas fa-plus-circle text-ngk-primaryLight"></i>
                New Area
            </button>
        </div>
    </div>

    <!-- Excel Upload Panel (Inline, Expandable) -->
    <div id="uploadPanel" class="hidden transition-all duration-300 ease-in-out mb-8">
        <div class="bg-white border border-slate-200 rounded-2xl shadow-md overflow-hidden">
            <div class="bg-slate-50 px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                <h3 class="text-lg font-bold text-slate-800 m-0">Upload Area Excel</h3>
                <button id="btnCancelUpload" class="text-slate-400 hover:text-slate-600 bg-transparent border-0 cursor-pointer text-xl">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="p-6">
                <form id="uploadForm" enctype="multipart/form-data" class="m-0">
                    <div class="border-2 border-dashed border-slate-200 hover:border-ngk-primary rounded-2xl p-8 text-center bg-slate-50/50 cursor-pointer transition-colors relative" id="dropzone">
                        <input type="file" id="excelFile" name="file" accept=".xlsx" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" required />
                        <div class="flex flex-col items-center justify-center pointer-events-none">
                            <div class="w-16 h-16 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mb-3">
                                <i class="fas fa-file-excel text-3xl"></i>
                            </div>
                            <span class="text-slate-700 font-bold text-sm" id="fileNameText">Click to browse or drag & drop excel file here</span>
                            <span class="text-slate-400 text-xs mt-1">Only .xlsx file extension is supported.</span>
                        </div>
                    </div>
                    
                    <div class="flex justify-end gap-3 border-t border-slate-100 pt-4 mt-6">
                        <button type="button" id="btnDiscardUpload" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl transition-all font-semibold border-0 cursor-pointer">
                            Cancel
                        </button>
                        <button type="submit" class="px-6 py-2.5 bcp-btn-primary text-white rounded-xl transition-all font-semibold border-0 cursor-pointer shadow-sm">
                            <i class="fas fa-cloud-upload-alt mr-2"></i> Upload Data
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Interactive Form Panel (Inline, Expandable) -->
    <div id="formPanel" class="hidden transition-all duration-300 ease-in-out mb-8">
        <div class="bg-white border border-slate-200 rounded-2xl shadow-md overflow-hidden">
            <div class="bg-slate-50 px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                <h3 id="formTitle" class="text-lg font-bold text-slate-800 m-0">Create Area</h3>
                <button id="btnCancelForm" class="text-slate-400 hover:text-slate-600 bg-transparent border-0 cursor-pointer text-xl">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form id="areaForm" class="p-6 m-0">
                <input type="hidden" id="areaId" name="ID" />
                <div class="row">
                    <!-- Area Name -->
                    <div class="col-md-5 mb-4">
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Area Name</label>
                        <input type="text" id="areaName" name="AreaName" class="form-control rounded-xl border-slate-200 font-medium py-2 px-3 text-sm" placeholder="e.g. Line Assembly 1, Main Office" required maxlength="100" />
                        <p class="text-xs text-slate-400 mt-1">Full name or identifier of the monitoring area.</p>
                    </div>

                    <!-- Mapped Department -->
                    <div class="col-md-4 mb-4">
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Mapped Department</label>
                        <select id="deptSelect" name="DepartmentCode" class="form-control rounded-lg border-slate-200 font-medium w-full">
                            <option value="">-- No Department (Global Area) --</option>
                        </select>
                        <p class="text-xs text-slate-400 mt-1">Select the department this area belongs to, or leave empty for global/shared areas.</p>
                    </div>

                    <!-- Is Active -->
                    <div class="col-md-3 mb-4 flex flex-col justify-center">
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Status</label>
                        <div class="flex items-center mt-2">
                            <label class="relative inline-flex items-center cursor-pointer select-none">
                                <input type="checkbox" id="areaIsActive" name="IsActive" value="true" checked class="sr-only peer">
                                <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:height-5 after:width-5 after:transition-all peer-checked:bg-ngk-primary"></div>
                                <span class="ml-3 text-sm font-semibold text-slate-700" id="statusLabel">Active</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end gap-3 border-t border-slate-100 pt-4 mt-2">
                    <button type="button" id="btnDiscard" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl transition-all font-semibold border-0 cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" class="px-6 py-2.5 bcp-btn-primary text-white rounded-xl transition-all font-semibold border-0 cursor-pointer shadow-sm">
                        Save Area
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Main List Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="relative w-full md:w-80">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-search text-slate-400"></i>
                </span>
                <input type="text" id="tableSearch" placeholder="Search areas..." class="form-control pl-10 rounded-xl border-slate-200 text-sm py-2" />
            </div>
            <div class="text-slate-400 text-sm font-medium" id="recordCountLabel">
                Showing 0 areas
            </div>
        </div>

        <div class="table-responsive">
            <table class="table bcp-table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="pl-6 w-16 text-center">No</th>
                        <th>Area Name</th>
                        <th>Mapped Department</th>
                        <th>Status</th>
                        <th class="pr-6 w-32 text-center">Actions</th>
                    </tr>
                    <tr class="bg-slate-50/50 filter-row">
                        <th></th>
                        <th class="p-2">
                            <input type="text" id="filterAreaName" placeholder="Filter Name..." class="form-control form-control-sm text-xs font-semibold border-slate-200 focus:border-ngk-primary focus:ring-1 focus:ring-ngk-primary rounded-lg py-1 px-2 w-full" />
                        </th>
                        <th class="p-2">
                            <select id="filterAreaDept" class="form-control form-control-sm text-xs font-semibold border-slate-200 focus:border-ngk-primary focus:ring-1 focus:ring-ngk-primary rounded-lg py-1 px-2 w-full">
                                <option value="">All Departments</option>
                            </select>
                        </th>
                        <th class="p-2">
                            <select id="filterAreaStatus" class="form-control form-control-sm text-xs font-semibold border-slate-200 focus:border-ngk-primary focus:ring-1 focus:ring-ngk-primary rounded-lg py-1 px-2 w-full">
                                <option value="">All Status</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="areaTableBody">
                    <tr>
                        <td colspan="5" class="text-center py-8 text-slate-400">
                            <div class="spinner-border spinner-border-sm text-primary mr-2" role="status"></div>
                            Loading areas...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination Section -->
        <div class="px-6 py-4 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-4 bg-slate-50/50" id="paginationWrapper">
            <div class="text-xs font-semibold text-slate-500" id="paginationInfo">
                Showing 0 to 0 of 0 entries
            </div>
            <div class="flex items-center gap-1.5" id="paginationControls">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Select2 Script -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        $(document).ready(function () {
            let allAreas = [];
            let allDepartments = [];
            let currentPage = 1;
            const rowsPerPage = 10;

            // Initialize Select2 with 100% width
            $('#deptSelect').select2({
                placeholder: "-- No Department (Global Area) --",
                allowClear: true,
                dropdownParent: $('#formPanel'),
                width: '100%'
            });

            // Listen to checkbox state change
            $('#areaIsActive').change(function() {
                if(this.checked) {
                    $('#statusLabel').text('Active').addClass('text-slate-700').removeClass('text-slate-400');
                } else {
                    $('#statusLabel').text('Inactive').addClass('text-slate-400').removeClass('text-slate-700');
                }
            });

            // Fetch form configurations (Departments lookup)
            function loadFormData() {
                $.ajax({
                    url: '@Url.Action("GetAreaFormData", "BCP")',
                    type: 'GET',
                    success: function (res) {
                        if (res.status === 'success') {
                            allDepartments = res.departments;
                            
                            // Populate Dropdown in Form
                            let optionsHtml = '<option value="">-- No Department (Global Area) --</option>';
                            let filterDeptHtml = '<option value="">All Departments</option>';
                            filterDeptHtml += '<option value="GLOBAL">-- Global Area --</option>';
                            res.departments.forEach(function (dep) {
                                let opt = `<option value="${dep.Code}">${dep.DeptName} (${dep.Code})</option>`;
                                optionsHtml += opt;
                                filterDeptHtml += opt;
                            });
                            $('#deptSelect').html(optionsHtml).trigger('change');
                            $('#filterAreaDept').html(filterDeptHtml);
                        } else {
                            Swal.fire("Error", "Failed to load lookup departments: " + res.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Network connection failed.", "error");
                    }
                });
            }

            // Fetch and load area list
            function loadAreas() {
                $.ajax({
                    url: '@Url.Action("GetAreaList", "BCP")',
                    type: 'GET',
                    data: { search: '' },
                    success: function (res) {
                        if (res.status === 'success') {
                            allAreas = res.data;
                            currentPage = 1;
                            applyFiltersAndPagination();
                        } else {
                            $('#areaTableBody').html(`<tr><td colspan="5" class="text-center py-8 text-danger">Error: ${res.message}</td></tr>`);
                        }
                    },
                    error: function () {
                        $('#areaTableBody').html('<tr><td colspan="5" class="text-center py-8 text-danger">Failed to fetch data from server.</td></tr>');
                    }
                });
            }

            // Filter and Paginate logic
            function applyFiltersAndPagination() {
                let generalSearch = ($('#tableSearch').val() || '').toLowerCase().trim();
                let nameFilter = ($('#filterAreaName').val() || '').toLowerCase().trim();
                let deptFilter = $('#filterAreaDept').val();
                let statusFilter = $('#filterAreaStatus').val();

                let filtered = allAreas.filter(function(item) {
                    // General search
                    if (generalSearch) {
                        let matchGeneral = (item.AreaName || '').toLowerCase().includes(generalSearch) ||
                                           (item.DepartmentName || '').toLowerCase().includes(generalSearch) ||
                                           (item.DepartmentCode || '').toLowerCase().includes(generalSearch);
                        if (!matchGeneral) return false;
                    }
                    // Name filter
                    if (nameFilter && !(item.AreaName || '').toLowerCase().includes(nameFilter)) {
                        return false;
                    }
                    // Department filter
                    if (deptFilter) {
                        if (deptFilter === 'GLOBAL') {
                            if (item.DepartmentCode) return false;
                        } else {
                            if (item.DepartmentCode !== deptFilter) return false;
                        }
                    }
                    // Status filter
                    if (statusFilter) {
                        let isActiveMatch = (statusFilter === 'active');
                        if (item.IsActive !== isActiveMatch) return false;
                    }
                    return true;
                });

                let totalItems = filtered.length;
                let totalPages = Math.ceil(totalItems / rowsPerPage) || 1;

                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                let startIndex = (currentPage - 1) * rowsPerPage;
                let endIndex = Math.min(startIndex + rowsPerPage, totalItems);
                let paginatedItems = filtered.slice(startIndex, endIndex);

                renderTable(paginatedItems, startIndex);
                renderPagination(totalItems, totalPages, startIndex, endIndex);
            }

            // Render table content
            function renderTable(areas, startIndex) {
                if (areas.length === 0) {
                    $('#areaTableBody').html('<tr><td colspan="5" class="text-center py-12 text-slate-400"><i class="fas fa-folder-open text-3xl mb-2 block"></i>No areas found matching your search.</td></tr>');
                    return;
                }

                let html = '';
                areas.forEach(function (item, index) {
                    let statusBadge = item.IsActive 
                        ? `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Active</span>`
                        : `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-slate-50 text-slate-500 border border-slate-200"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Inactive</span>`;

                    let deptDisplay = item.DepartmentCode 
                        ? `<span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 font-medium text-xs border border-slate-200/50"><i class="fas fa-building text-ngk-primary mr-1"></i>${item.DepartmentName}</span>`
                        : `<span class="px-2.5 py-1 rounded-lg bg-yellow-50 text-yellow-700 font-medium text-xs border border-yellow-200/50"><i class="fas fa-globe text-ngk-accent mr-1"></i>Global Area</span>`;

                    html += `
                        <tr>
                            <td class="pl-6 text-center font-semibold text-slate-400">${startIndex + index + 1}</td>
                            <td class="font-bold text-slate-800">${item.AreaName}</td>
                            <td>${deptDisplay}</td>
                            <td>${statusBadge}</td>
                            <td class="pr-6 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button class="btn btn-sm btn-outline-secondary rounded-lg edit-btn p-2" data-id="${item.ID}" title="Edit Area">
                                        <i class="fas fa-pencil-alt"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-lg delete-btn p-2" data-id="${item.ID}" title="Delete Area">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                });

                $('#areaTableBody').html(html);
            }

            // Render pagination controls
            function renderPagination(totalItems, totalPages, startIndex, endIndex) {
                $('#recordCountLabel').text(`Showing ${totalItems} area${totalItems !== 1 ? 's' : ''}`);

                if (totalItems === 0) {
                    $('#paginationInfo').text('Showing 0 to 0 of 0 entries');
                    $('#paginationControls').html('');
                    return;
                }

                $('#paginationInfo').text(`Showing ${startIndex + 1} to ${endIndex} of ${totalItems} entries`);

                let paginationHtml = '';
                if (currentPage === 1) {
                    paginationHtml += `<button disabled class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-50 border border-slate-200 text-slate-400 cursor-not-allowed opacity-60"><i class="fas fa-chevron-left"></i></button>`;
                } else {
                    paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors page-prev-btn"><i class="fas fa-chevron-left"></i></button>`;
                }

                let maxVisiblePages = 5;
                let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
                let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

                if (endPage - startPage + 1 < maxVisiblePages) {
                    startPage = Math.max(1, endPage - maxVisiblePages + 1);
                }

                if (startPage > 1) {
                    paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors page-num-btn" data-page="1">1</button>`;
                    if (startPage > 2) {
                        paginationHtml += `<span class="px-2 text-slate-400">...</span>`;
                    }
                }

                for (let i = startPage; i <= endPage; i++) {
                    if (i === currentPage) {
                        paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-ngk-primary text-white border border-ngk-primary shadow-sm">${i}</button>`;
                    } else {
                        paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors page-num-btn" data-page="${i}">${i}</button>`;
                    }
                }

                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        paginationHtml += `<span class="px-2 text-slate-400">...</span>`;
                    }
                    paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors page-num-btn" data-page="${totalPages}">${totalPages}</button>`;
                }

                if (currentPage === totalPages) {
                    paginationHtml += `<button disabled class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-50 border border-slate-200 text-slate-400 cursor-not-allowed opacity-60"><i class="fas fa-chevron-right"></i></button>`;
                } else {
                    paginationHtml += `<button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors page-next-btn"><i class="fas fa-chevron-right"></i></button>`;
                }

                $('#paginationControls').html(paginationHtml);
            }

            // Pagination button events
            $(document).on('click', '.page-num-btn', function() {
                currentPage = parseInt($(this).attr('data-page'));
                applyFiltersAndPagination();
            });

            $(document).on('click', '.page-prev-btn', function() {
                if (currentPage > 1) {
                    currentPage--;
                    applyFiltersAndPagination();
                }
            });

            $(document).on('click', '.page-next-btn', function() {
                currentPage++;
                applyFiltersAndPagination();
            });

            // Bind column filter inputs and table search
            $('#filterAreaName, #filterAreaDept, #filterAreaStatus, #tableSearch').on('input change', function () {
                currentPage = 1;
                applyFiltersAndPagination();
            });

            // Show upload panel
            $('#btnUploadExcel').click(function () {
                $('#uploadForm')[0].reset();
                $('#fileNameText').html('Click to browse or drag & drop excel file here');
                $('#formPanel').addClass('hidden');
                $('#uploadPanel').removeClass('hidden');
                $('html, body').animate({
                    scrollTop: $("#uploadPanel").offset().top - 100
                }, 500);
            });

            // Discard/Close upload form
            $('#btnCancelUpload, #btnDiscardUpload').click(function () {
                $('#uploadPanel').addClass('hidden');
                $('#uploadForm')[0].reset();
                $('#fileNameText').html('Click to browse or drag & drop excel file here');
            });

            // Update filename label on file selection
            $('#excelFile').change(function (e) {
                if (e.target.files.length > 0) {
                    let file = e.target.files[0];
                    $('#fileNameText').html(`<i class="fas fa-file-excel text-emerald-500 mr-2 text-lg"></i><strong>${file.name}</strong> (${(file.size / 1024).toFixed(1)} KB)`);
                } else {
                    $('#fileNameText').html('Click to browse or drag & drop excel file here');
                }
            });

            // Excel Upload submit action
            $('#uploadForm').submit(function (e) {
                e.preventDefault();

                let fileInput = $('#excelFile')[0];
                if (fileInput.files.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Warning',
                        text: 'Silakan pilih file Excel terlebih dahulu.',
                        confirmButtonColor: '#007581'
                    });
                    return;
                }

                let formData = new FormData();
                formData.append("file", fileInput.files[0]);

                Swal.fire({
                    title: 'Processing Upload...',
                    text: 'Please wait while we validate and import your data.',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '@Url.Action("UploadAreaExcel", "BCP")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        Swal.close();
                        if (res.status === 'success') {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: res.message,
                                confirmButtonColor: '#007581'
                            });
                            $('#uploadPanel').addClass('hidden');
                            $('#uploadForm')[0].reset();
                            $('#fileNameText').html('Click to browse or drag & drop excel file here');
                            loadAreas();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Upload Failed',
                                text: res.message,
                                confirmButtonColor: '#007581'
                            });
                        }
                    },
                    error: function () {
                        Swal.close();
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Failed to upload Excel file. Please check file format and try again.',
                            confirmButtonColor: '#007581'
                        });
                    }
                });
            });

            // Show form panel
            $('#btnNewArea').click(function () {
                resetForm();
                $('#uploadPanel').addClass('hidden');
                $('#formTitle').text('Create Area');
                $('#formPanel').removeClass('hidden');
                $('html, body').animate({
                    scrollTop: $("#formPanel").offset().top - 100
                }, 500);
            });

            // Discard / Close form
            $('#btnCancelForm, #btnDiscard').click(function () {
                $('#formPanel').addClass('hidden');
                resetForm();
            });

            // Populate form for editing
            $(document).on('click', '.edit-btn', function () {
                let id = $(this).data('id');
                let item = allAreas.find(x => x.ID == id);
                if (item) {
                    $('#areaId').val(item.ID);
                    $('#areaName').val(item.AreaName);
                    $('#deptSelect').val(item.DepartmentCode || '').trigger('change');
                    $('#areaIsActive').prop('checked', item.IsActive).trigger('change');

                    $('#uploadPanel').addClass('hidden');
                    $('#formTitle').text('Edit Area');
                    $('#formPanel').removeClass('hidden');
                    $('html, body').animate({
                        scrollTop: $("#formPanel").offset().top - 100
                    }, 500);
                }
            });

            // Save Form Action
            $('#areaForm').submit(function (e) {
                e.preventDefault();

                let data = {
                    ID: $('#areaId').val(),
                    AreaName: $('#areaName').val(),
                    DepartmentCode: $('#deptSelect').val(),
                    IsActive: $('#areaIsActive').is(':checked')
                };

                $.ajax({
                    url: '@Url.Action("SaveArea", "BCP")',
                    type: 'POST',
                    data: data,
                    success: function (res) {
                        if (res.status === 'success') {
                            Swal.fire({
                                icon: 'success',
                                title: 'Saved!',
                                text: res.message,
                                confirmButtonColor: '#007581'
                            });
                            $('#formPanel').addClass('hidden');
                            resetForm();
                            loadAreas();
                        } else {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Warning',
                                text: res.message,
                                confirmButtonColor: '#007581'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Request failed. Please try again.',
                            confirmButtonColor: '#007581'
                        });
                    }
                });
            });

            // Delete Action Click
            $(document).on('click', '.delete-btn', function () {
                let id = $(this).data('id');
                Swal.fire({
                    title: "Are you sure?",
                    text: "You are about to delete this BCP Area mapping. Once deleted, users cannot select it for new BCP incidents or assessments.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteArea", "BCP")',
                            type: 'POST',
                            data: { ID: id },
                            success: function (res) {
                                if (res.status === 'success') {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Deleted!',
                                        text: res.message,
                                        confirmButtonColor: '#007581'
                                    });
                                    loadAreas();
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: res.message,
                                        confirmButtonColor: '#007581'
                                    });
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'Request failed. Please try again.',
                                    confirmButtonColor: '#007581'
                                });
                            }
                        });
                    }
                });
            });

            // Reset Form Values
            function resetForm() {
                $('#areaId').val('');
                $('#areaForm')[0].reset();
                $('#deptSelect').val('').trigger('change');
                $('#areaIsActive').prop('checked', true).trigger('change');
            }

            // Initial loads
            loadFormData();
            loadAreas();
        });
    </script>
}
