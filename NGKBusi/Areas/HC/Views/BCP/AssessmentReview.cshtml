@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var incident = ViewBag.Incident as NGKBusi.Areas.HC.Models.HC_BCP_Incident;
    var assessments = (ViewBag.Assessments as List<NGKBusi.Areas.HC.Models.HC_BCP_Assessment>) ?? new List<NGKBusi.Areas.HC.Models.HC_BCP_Assessment>();
    var assessmentsVM = (ViewBag.AssessmentsWithArea as List<NGKBusi.Areas.HC.Models.BCPAssessmentVM>) ?? new List<NGKBusi.Areas.HC.Models.BCPAssessmentVM>();
    var criteria = (ViewBag.Criteria as List<NGKBusi.Areas.HC.Models.HC_BCP_Assessment_Criteria>) ?? new List<NGKBusi.Areas.HC.Models.HC_BCP_Assessment_Criteria>();
    var departments = (ViewBag.Departments as List<NGKBusi.Areas.HC.Models.HC_BCP_Department>) ?? new List<NGKBusi.Areas.HC.Models.HC_BCP_Department>();
    var areas = (ViewBag.Areas as List<NGKBusi.Areas.HC.Models.HC_BCP_Area>) ?? new List<NGKBusi.Areas.HC.Models.HC_BCP_Area>();
    var reviews = (ViewBag.Reviews as List<NGKBusi.Areas.HC.Models.HC_BCP_Review>) ?? new List<NGKBusi.Areas.HC.Models.HC_BCP_Review>();
    var revNames = (ViewBag.ReviewerNames as Dictionary<string, string>) ?? new Dictionary<string, string>();
    var reviewer = ViewBag.CurrentReviewer as NGKBusi.Areas.HC.Models.HC_BCP_Organization;
    var nextReviewer = ViewBag.NextReviewer as NGKBusi.Areas.HC.Models.HC_BCP_Organization;
    var permission = ViewBag.Permissions as NGKBusi.Areas.HC.Models.HC_BCP_Role_Permission;

    string currentRole = "Reviewer";
    string nextLevel = "Committee";

    string layoutError = null;
    try
    {
        currentRole = reviewer != null ? (reviewer.BCP_Role ?? "Reviewer") : "Reviewer";
        nextLevel = nextReviewer != null ? (nextReviewer.BCP_Role ?? "Committee") : "Committee";
    }
    catch (Exception ex)
    {
        layoutError = ex.ToString();
    }

    bool canSubmitReview = ViewBag.CanSubmitReview != null ? (bool)ViewBag.CanSubmitReview : false;

    var recoveryPlans = (List<NGKBusi.Areas.HC.Models.HC_BCP_Recovery_Plan>)ViewBag.RecoveryPlans ?? new List<NGKBusi.Areas.HC.Models.HC_BCP_Recovery_Plan>();
    var orgList = (List<NGKBusi.Areas.HC.Models.HC_BCP_Organization>)ViewBag.OrgList ?? new List<NGKBusi.Areas.HC.Models.HC_BCP_Organization>();
    var questionList = (List<NGKBusi.Areas.HC.Models.HC_BCP_Assessment_Question>)ViewBag.QuestionList ?? new List<NGKBusi.Areas.HC.Models.HC_BCP_Assessment_Question>();
    bool isReviewer = ViewBag.IsReviewer == true;
    bool isActivatedOrDeactivated = incident != null && (incident.Status == 6 || incident.Status == 7);
    string curNik = Microsoft.AspNet.Identity.IdentityExtensions.GetUserId(User.Identity) ?? User.Identity.Name;
    if (!string.IsNullOrEmpty(curNik) && curNik.Contains("\\")) { curNik = curNik.Split('\\').Last(); }
    curNik = (curNik ?? "").Trim().ToLower();
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<script>
    tailwind.config = {
        corePlugins: { preflight: false },
        theme: {
            extend: {
                fontFamily: { sans: ['Inter', 'sans-serif'] },
                colors: {
                    ngk: {
                        primary: '#007581',
                        primaryLight: '#e0f3f5',
                        primaryDark: '#00555e',
                        accent: '#eeb500',
                        accentLight: '#fdf7e6'
                    }
                }
            }
        }
    }
</script>
<style>
    /* Fix Select2 container width so it occupies full column width */
    .select2-container {
        width: 100% !important;
    }

    /* Style Select2 to match premium Tailwind look */
    .select2-container--default .select2-selection--single {
        border-color: #cbd5e1 !important;
        border-radius: 0.75rem !important;
        height: 38px !important;
        display: flex !important;
        align-items: center !important;
        background-color: #f8fafc !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 34px !important;
        right: 8px !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #334155 !important;
        font-weight: 500 !important;
        font-size: 0.75rem !important;
        padding-left: 10px !important;
    }
    .select2-dropdown {
        border-color: #cbd5e1 !important;
        border-radius: 0.75rem !important;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1) !important;
        overflow: hidden !important;
        z-index: 9999 !important;
    }
    .select2-search--dropdown .select2-search__field {
        border-color: #cbd5e1 !important;
        border-radius: 0.5rem !important;
        padding: 6px 10px !important;
        font-size: 0.75rem !important;
    }
    .select2-results__option {
        font-size: 0.75rem !important;
        padding: 8px 12px !important;
    }
    .select2-container--default .select2-results__option--highlighted[aria-selected] {
        background-color: #007581 !important;
    }

    .matrix-scroll::-webkit-scrollbar {
        height: 8px;
    }

    .matrix-scroll::-webkit-scrollbar-track {
        background: #f8fafc;
        border-radius: 99px;
    }

    .matrix-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 99px;
    }

        .matrix-scroll::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

    .cell-yes {
        animation: pulseGlow 2s ease-in-out infinite;
    }

    @@keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
        }

        50% {
            box-shadow: 0 0 8px 3px rgba(239, 68, 68, 0.4);
        }
    }

    .fade-up {
        animation: fadeUp 0.5s ease-out both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .review-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .review-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        }

    /* Area name rotated 90 degrees styling */
    .area-header-cell {
        height: 200px;
        min-width: 56px;
        position: relative;
        padding: 0;
        vertical-align: middle;
        text-align: center;
    }

    .area-name-wrapper {
        position: absolute;
        top: 0;
        bottom: 38px;
        left: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .area-name-rotate {
        transform: rotate(-90deg);
        transform-origin: center;
        display: inline-block;
        white-space: nowrap;
        font-weight: 700;
        color: #475569;
        font-size: 11px;
        line-height: 1;
    }

    @@media (max-width: 800px) {
        .area-header-cell {
            height: 180px;
            min-width: 48px;
        }

        .area-name-wrapper {
            bottom: 32px;
        }

        .area-name-rotate {
            font-size: 10px;
        }
    }

    /* Ensure solid borders on BCP Recovery Plan table cells due to preflight being disabled */
    .recovery-plan-table td,
    .recovery-plan-table th {
        border-style: solid !important;
        border-color: #e2e8f0 !important;
        border-width: 1px !important;
    }
</style>

<!-- Debug output -->
