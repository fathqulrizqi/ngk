@{
    ViewBag.Title = "Stationery Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section cssHead {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.tailwindcss.css" />
    <link href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/tippy.js@6.3.7/dist/tippy.css" />
    <link href="~/Content/bootstrap/css/bootstrap5.3.3/bootstrap.min.css" rel="stylesheet" />

    <style>
        div.dt-length label {
            margin-left: 0.5rem; /* jarak antara select dan label */
        }

        select[aria-controls="itemRequest"] {
            padding: 2px !important; /* py-2 px-3 */
            border-radius: 0.5rem; /* rounded-lg */
            border: 1px solid #e5e7eb; /* border-gray-200 */
            outline: none;
        }

        select[aria-controls="itemList"] {
            padding: 2px !important; /* py-2 px-3 */
            border-radius: 0.5rem; /* rounded-lg */
            border: 1px solid #e5e7eb; /* border-gray-200 */
            outline: none;
        }

        select[aria-controls="itemRequest"]:focus {
            border-color: #3b82f6; /* focus:border-blue-500 */
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5); /* focus:ring */
        }

        input[aria-controls="itemRequest"] {
            padding: 2px !important; /* py-2 px-3 */
            border-radius: 0.5rem; /* rounded-lg */
            border: 1px solid #e5e7eb; /* border-gray-200 */
            outline: none;
        }

        input[aria-controls="itemList"] {
            padding: 2px !important; /* py-2 px-3 */
            border-radius: 0.5rem; /* rounded-lg */
            border: 1px solid #e5e7eb; /* border-gray-200 */
            outline: none;
        }

        .page-content {
            padding-top: 0 !important;
        }

        .select2-container--default .select2-selection--single {
            border-color: #DEE2E6 !important;
            height: auto !important;
        }

        .select2-container--default .select2-selection--multiple {
            min-height: 2rem;
            border-color: #DEE2E6 !important;
            padding: 0.25rem;
            width: auto !important;
            display: inline-block;
        }

        .select2-selection__rendered {
            word-wrap: break-word !important;
            text-overflow: inherit !important;
            white-space: normal !important;
        }

        table.dataTable td,
        table.dataTable th {
            padding: 0.5rem 0.5rem !important;
        }

        .hidden {
            display: none !important;
        }
    </style>

}


@section scriptHead {
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="~/Content/bootstrap/js/bootstrap5.3.3/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.tailwindcss.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

}

<div class="d-flex align-items-center rounded" style="color: #2C3E50;">
    <span style="color: #F6AA04; font-weight: bold; font-size: 20px; margin: 20px;">|</span>
    <h2 style="font-weight: bold; margin: 0; font-size: 25px">
        Create Order
    </h2>
</div>

<div class="flex flex-col md:flex-row gap-4">

    @* CONTAINER KIRI (80%) *@
    <div class="w-full md:w-1/2 h-fit bg-white p-6 rounded-xl shadow-lg">

        @*<div class="flex items-center text-black text-lg font-bold mb-2">
                <div class="flex items-center mr-4">
                    <span class="text-orange-700 font-bold text-xl text-center mr-2">|</span> Request
                </div>
            </div>
            <div class="overflow-x-auto w-full p-4 border-gray-200 border-1">
                <table id="itemRequest" class="hover w-full text-sm">
                    <thead class="text-xs text-gray-500 uppercase bg-gray-50">
                        <tr class="bg-gray-50">
                            <th class="py-2 px-3">Item Name</th>
                            <th class="py-2 px-3">QTY</th>
                        </tr>
                        <tr class="search-row caret-black">
                            <th><input data-column="0" placeholder="Search Item Name" class="w-full p-2 border rounded caret-black"></th>
                            <th><input data-column="1" placeholder="Search QTY" class="w-full p-2 border rounded caret-black"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>*@

        @*<div class="flex items-center text-black text-lg font-bold mt-2 mb-2">
                <div class="flex items-center mr-4">
                    <span class="text-orange-700 font-bold text-xl text-center mr-2">|</span> Item
                </div>
            </div>*@
        <div class="overflow-x-auto w-full p-4 border-gray-200 border-1">
            <table id="itemList" class="hover w-full text-sm border-collapse">
                <thead class="text-xs text-gray-500 uppercase bg-gray-50">
                    <tr>
                        <th></th>
                        <th class="py-2 px-3">Category</th>
                        <th class="py-2 px-3">Item Name</th>
                        <th class="py-2 px-3">Qty</th>
                        <th class="py-2 px-3">Qty Order</th>
                    </tr>
                    <tr class="search-row caret-black">
                        <th></th>
                        <th>
                            <select id="categoryFilter" class="select2 w-auto min-w-[8rem] border p-2 border-gray-300" multiple>
                                @foreach (var category in ViewBag.CategoryList)
                                {
                                    <option value="@category.Category_Name">@category.Category_Name</option>
                                }
                            </select>
                        </th>
                        <th>
                            <input data-column="2" placeholder="Search Item Name" class="w-full p-2 border rounded caret-black">
                        </th>
                        <th><input data-column="3" placeholder="Search Qty Stock" class="w-full p-2 border rounded caret-black"></th>
                        <th><input data-column="4" placeholder="Search Qty Order" class="w-full p-2 border rounded caret-black"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
            @*@Html.Partial("Partial/_Item")*@
        </div>

    </div>


    @* CONTAINER KANAN (20%) *@
    <div class="w-full md:w-1/2 h-fit bg-white p-6 rounded-xl shadow-lg">
        <div class="flex items-center text-black text-lg font-bold mb-2">
            <div class="flex items-center mr-4">
                <span class="text-orange-700 font-bold text-xl text-center mr-2">|</span> Order Cart
            </div>
        </div>

        <table id="cartTable" class="display w-full mt-2">
            <thead>
                <tr>
                    <th>Item Name</th>
                    <th>Qty Before</th>
                    <th>Qty (+)</th>
                    <th>Qty After</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <div class="flex justify-end mt-4">
            <button id="submitChecked" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
                Create Order Letter
            </button>
        </div>

    </div>

</div>
<script>
    let cartData = [];
    let cartTable;

    $(document).ready(function () {
        $('#categoryFilter').select2({
            placeholder: "-Select-",
            width: 'auto',
            multiple: true,
            closeOnSelect: false,
            dropdownAutoWidth: true
        });

        $('#categoryFilter').select2({
            placeholder: '- Select Category -',
            width: 'auto',
        });


        $('#categoryFilter').on('change', function () {
            let selected = $(this).val() || [];
            let regex = selected.length ? selected.join('|') : '';
            $('#itemList').DataTable().column(1).search(regex, true, false).draw();
        });

        $('#itemRequest').DataTable({
            processing: true,
            orderCellsTop: true,
            order: [[0, 'asc']], // Mengurutkan berdasarkan Item Name (indeks 0)
            ajax: {
                url: '@Url.Action("GetRequestItems", "Inventory", new { area = "HC" })',
                dataSrc: function (json) {
                    const groupedData = Object.values(json.reduce((acc, current) => {
                        const itemKey = current.Item_Name;
                        if (!acc[itemKey]) {
                            acc[itemKey] = {
                                Item_Name: current.Item_Name,
                                Qty_Request: 0,
                                Qty: '',
                                Qty_Preview: '',
                                Qty_Stock: current.Qty_Stock,
                                Unit_Request: current.Unit_Request,
                                Request_No: [],
                                Requestor_Name: [],
                            };
                        }
                        acc[itemKey].Qty_Request += current.Qty_Request;
                        acc[itemKey].Request_No.push(current.Request_No);
                        acc[itemKey].Requestor_Name.push(current.Requestor_Name);
                        return acc;
                    }, {}));
                    const finalResult = groupedData.map(item => {
                        const qtyStock = parseInt(item.Qty_Stock);
                        const qtyPreview = qtyStock - item.Qty_Request;
                        return {
                            Item_Name: item.Item_Name,
                            Qty: item.Qty_Request + " " + item.Unit_Request.trim(),
                            Qty_Preview: qtyPreview + " " + item.Unit_Request.trim(),
                            Qty_Preview_Int: qtyPreview,
                            Request_No: [...new Set(item.Request_No)].join(", "),
                            Requestor_Name: [...new Set(item.Requestor_Name)].join(", "),
                        };
                    }).filter(item => item.Qty_Preview_Int < 0);
                    return finalResult;
                }
            },
            columns: [
                { title: 'Item Name', data: 'Item_Name' },
                {
                    title: 'QTY',
                    data: null,
                    render: (data, type, row) => `
                        <div class="flex flex-col">
                            <span class="font-bold">${data.Qty}</span>
                            <span class="text-sm text-red-500">Qty: ${data.Qty_Preview}</span>
                        </div>`
                },
            ],
            initComplete: function () {
                const api = this.api();
                $('#itemRequest thead tr.search-row input').on('keyup change clear', function () {
                    const colIndex = $(this).data('column');
                    if (colIndex !== undefined) {
                        api.column(colIndex).search(this.value, true, false).draw();
                    }
                });
            }
        });

        const table = $('#itemList').DataTable({
            orderCellsTop: true,
            order: [],
            responsive: true,
            autoWidth: true,
            fixedHeader: true,
            ajax: {
                url: '@Url.Action("GetItemDatas", "Inventory", new { area = "HC" })',
                type: 'GET',
                dataSrc: 'datas'
            },
            columns: [
                {
                    data: null,
                    title: `<input type="checkbox" id="selectAllItem" />`,
                    className: 'text-center',
                    orderable: false,
                    render: data => {
                        console.log("hehe", data);
                        const qty = Math.abs(data.Qty);
                        return `<input type="checkbox" class="row-checkbox"
                                 data-id="${data.ID}"
                                 data-name="${data.Item_Name}"
                                 data-qty="${qty}"
                                 data-qtyreq="${data.Qty_Order}"
                                 data-unit="${data.Unit}"
                                 data-nik="@ViewBag.UserNik"
                                 data-username="@ViewBag.UserName"
                                 data-dept="@ViewBag.DeptName"
                                 data-requestno="${data.Request_No}"
                                 data-type="Item">`;
                    }
                },
                {
                    data: 'CategoryName', title: 'Category',
                    render: function (data, type) {
                        return data;
                    }
                },
                {
                    data: 'Item_Name', title: 'Item Name',
                    render: function (data, type) {
                        return data;
                    }
                },
                {
                    data: 'Qty',
                    title: 'Qty Stock',
                    className: 'text-center',
                    render: data => {
                        const qty = parseInt(data);
                        return qty <= 15
                            ? `<span class="text-red-500 font-semibold">${qty}</span>`
                            : `<span>${qty}</span>`;
                    }
                },
                {
                    data: 'Qty_Order',
                    className: 'text-center',
                    render: (data, type, row) => {
                        const qtyOrder = parseInt(data);
                        const qtyStock = parseInt(row.Qty);

                        let colorClass = '';
                        if (qtyOrder > qtyStock) {
                            colorClass = 'text-red-500 font-semibold';
                        } else {
                            colorClass = 'text-blue-500 font-semibold';
                        }

                        return qtyOrder > 0
                            ? `<span class="${colorClass}">${qtyOrder}</span>`
                            : `<span>${qtyOrder}</span>`;
                    }
                },
            ],
            initComplete: function () {
                const api = this.api();
                $('#itemList thead tr.search-row input').on('keyup change clear', function () {
                    const colIndex = $(this).data('column');
                    if (colIndex !== undefined) {
                        api.column(colIndex).search(this.value, true, false).draw();
                    }
                });
                $('#categoryFilter').on('change', function () {
                    const selectedValues = $(this).val() || [];
                    const searchValue = selectedValues.join('|');
                    api.column(1).search(searchValue, true, false).draw();
                });
            },
        });

        $('#selectAllRequest').on('change', function () {
            const checked = $(this).is(':checked');
            $('#itemRequest tbody .row-checkbox').each(function () {
                const $cb = $(this);
                $cb.prop('checked', checked).trigger('change');
            });
        });

        $(document).on('change', '#selectAllItem', function () {
            const checked = $(this).is(':checked');
            $('#itemList .row-checkbox').prop('checked', checked).trigger('change');
        });

        $('#itemRequest tbody').on('click', 'tr', function (e) {
            if ($(e.target).is('input[type="checkbox"], button, i')) return;
            const $checkbox = $(this).find('input.row-checkbox');
            $checkbox.prop('checked', !$checkbox.prop('checked')).trigger('change');
        });

        $('#itemList tbody').on('click', 'tr', function (e) {
            if ($(e.target).is('input[type="checkbox"], button, i')) return;
            const $checkbox = $(this).find('input.row-checkbox');
            $checkbox.prop('checked', !$checkbox.prop('checked')).trigger('change');
        });

        cartTable = $('#cartTable').DataTable({
            paging: false,
            searching: false,
            info: false,
            ordering: false,
            dom: 't',
            columns: [
                { data: 'name' },
                {
                    data: null,
                    className: 'text-center',
                    render: function (data, type, row) {
                        return row.qty;
                    }
                },
                {
                    data: null,
                    className: 'text-center',
                    render: function (data, type, row) {
                        const inputValue = row.qtyInput !== undefined ? row.qtyInput : 0;
                        return row.type === "Item"
                            ? `<input type="number" value="${inputValue}" class="qty-input w-16 px-2 py-1 border rounded text-center" />`
                            : `<p class="text-center">${inputValue}</p>`;
                    }
                },
                {
                    data: null,
                    title: 'Qty After',
                    className: 'text-center',
                    render: function (data, type, row) {
                        const beforeQty = parseInt(row.qty) || 0;
                        const qtyInput = row.qtyInput !== undefined ? parseInt(row.qtyInput) : 0;
                        const total = beforeQty + qtyInput;
                        const qtyReq = parseInt(row.qtyreq) || 0;

                        if (row.qtyInput === undefined || qtyInput === 0) {
                            return `<span class="total-qty" style="font-weight: bold">${beforeQty}</span>`;
                        } else {
                            const fromRequest = Math.min(total, qtyReq);
                            let restock;
                            if (qtyReq > 0) {
                                restock = Math.max(total - qtyReq, 0);
                            } else {
                                restock = qtyInput;
                            }

                            return `
                                <div>
                                    <span class="total-qty" style="font-weight: bold">${total}</span>
                                    <div class="additional-info text-xs mt-1 leading-tight">
                                        Qty Restock: <span class="qty-restock">${restock}</span><br/>
                                        Qty from Request: <span class="qty-request">${fromRequest}</span> / ${qtyReq}
                                    </div>
                                </div>
                            `;
                        }
                    }
                },
                {
                    data: null,
                    className: 'text-center',
                    render: function () {
                        return `
                            <button class="remove-cart text-red-600 hover:text-red-800" title="Delete item">
                                <i class="fas fa-trash-alt"></i>
                            </button>`;
                    }
                },
                { data: 'id', visible: false },
                { data: 'cartno', visible: false }
            ],
            rowCallback: function (row, data) {
                $(row).find('.qty-input').on('input', function () {
                    const $input = $(this);
                    const inputQty = parseInt($input.val()) || 0;
                    data.qtyInput = inputQty;

                    const beforeQty = parseInt(data.qty) || 0;
                    const total = beforeQty + inputQty;
                    const qtyReq = parseInt(data.qtyreq) || 0;

                    const fromRequest = Math.min(total, qtyReq);
                    let restock;
                    if (qtyReq > 0) {
                        restock = Math.max(total - qtyReq, 0);
                    } else {
                        restock = inputQty;
                    }

                    $(row).find('.total-qty').text(total);

                    let $infoContainer = $(row).find('.additional-info');
                    if ($infoContainer.length === 0) {
                        $(row).find('.total-qty').after(`
                            <div class="additional-info text-xs mt-1 leading-tight">
                                Qty Restock: <span class="qty-restock">${restock}</span><br/>
                                Qty from Request: <span class="qty-request">${fromRequest}</span> / ${qtyReq}
                            </div>
                        `);
                    } else {
                        $infoContainer.find('.qty-restock').text(restock);
                        $infoContainer.find('.qty-request').text(fromRequest);
                    }
                });
            }
        });

        $('#cartTable tbody').on('click', '.remove-cart', function () {
            const row = cartTable.row($(this).parents('tr'));
            const data = row.data();

            row.remove().draw();

            const selector = `.row-checkbox[data-id="${data.id}"][data-type="${data.type}"]`;
            $(selector).prop('checked', false);

            const key = `${data.type}-${data.id}`;
            const index = cartData.indexOf(key);
            if (index !== -1) cartData.splice(index, 1);
        });

        $(document).on('change', '.row-checkbox', function () {
            const $cb = $(this);
            const selectedData = {
                id: String($cb.data('id')),
                name: $cb.data('name'),
                qty: $cb.data('qty'),
                qtyreq: $cb.data('qtyreq') > 0 ? $cb.data('qtyreq') : 0,
                qtyInput: 0, // Initialize qtyInput to 0 when adding to cart
                type: $cb.data('type'),
                cartno: $cb.data('cartno') || null,
                unit: $cb.data('unit'),
                request_no: $cb.data('requestno'),
                user_nik: $cb.data('nik'),
                user_name: $cb.data('username'),
                dept_name: $cb.data('dept')
            };

            const rows = cartTable.rows().data().toArray();

            if ($cb.is(':checked')) {
                const exists = rows.some(row => row.id === selectedData.id && row.type === selectedData.type);
                if (!exists) {
                    cartTable.row.add(selectedData).draw();
                }
            } else {
                for (let i = 0; i < rows.length; i++) {
                    const row = rows[i];
                    if (String(row.id) === String(selectedData.id) && row.type === selectedData.type) {
                        cartTable.row(i).remove().draw();
                        break;
                    }
                }
            }
        });

        $(document).on('click', '#submitChecked', function () {
            const payload = [];

            $('#cartTable tbody tr').each(function () {
                const $row = $(this);
                const rowData = cartTable.row($row).data();

                const qtyInput = $(this).find('.qty-input').val();
                const totalQty = parseInt(rowData.qty) + parseInt(qtyInput);

                payload.push({
                    Type: rowData.type,
                    Status: 'Pending Prepare',
                    Request_No: rowData.request_no || null,
                    Cart_No: rowData.cartno,
                    Item_Order_Id: rowData.id,
                    Item_Order_Name: rowData.name,
                    Item_Order_Qty: totalQty || 0,
                    Item_Order_Unit: rowData.unit || '-',
                    Requestor_NIK: rowData.user_nik || '-',
                    Requestor_Name: rowData.user_name || '-',
                    Requestor_Dept: rowData.dept_name || '-'
                });
            });

            if (payload.length === 0) {
                Swal.fire("Warning", "Cart is empty!", "warning");
                return;
            }

            $.ajax({
                url: '@Url.Action("CreateOrder", "Inventory", new { area = "HC" })',
                method: 'POST',
                data: JSON.stringify({ cartItems: payload }),
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    if (response.success) {
                        const orderNo = response.orderNo;
                        Swal.fire("Success", "Order created!", "success").then(() => {
                            window.location.href = '@Url.Action("_ListOrder", "Inventory", new { area = "HC" })';
                        });
                    } else {
                        Swal.fire("Error", "Order creation failed!", "error");
                    }
                },
                error: function (xhr) {
                    console.error(xhr.responseText);
                    Swal.fire("Error", "Failed to create order!", "error");
                }
            });
        });
    });
</script>