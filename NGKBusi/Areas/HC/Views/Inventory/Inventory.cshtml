    <script>
// ================================================================
    // LOGIC DEEP LINKING: OPEN MODAL DIRECTLY
    // ================================================================

    // 1. Ambil Request No dari URL
    function getRequestNoFromUrl() {
        // Bersihkan slash akhir jika ada
        const path = window.location.pathname.replace(/\/$/, "");
        const parts = path.split('/');
        const lastPart = decodeURIComponent(parts[parts.length - 1]);

        // Cek format REQ-...
        if (lastPart && lastPart.toUpperCase().startsWith('REQ-')) {
            return lastPart;
        }
        return null;
    }

    // 2. Fungsi Utama: Load Data & Buka Modal
function loadAndShowDetailModal(requestNo) {
        // Tampilkan Modal & Loading State
        $('#historyDetailModal').removeClass('hidden');
        $('#historyLoading').removeClass('hidden');
        $('#historyDataContainer').addClass('hidden').empty();

        const reqKey = requestNo.trim();

        // --- AJAX 1: Get Details (Isi HTML) ---
        $.ajax({
            url: '@Url.Action("GetRequestHistoryDetails", "Inventory", new { area = "HC" })',
            type: 'GET',
            data: { requestNo: requestNo },
            success: function (detail) {
                // LOG DATA RESPON AJAX 1
                console.log(">>> Response AJAX 1 (Details):", detail);

                if (!detail) {
                    Swal.fire("Error", "Detail not found for " + requestNo, "error");
                    $('#historyDetailModal').addClass('hidden');
                    return;
                }

                const htmlContent = formatHistoryDetails(detail);

                $('#historyDataContainer').html(htmlContent).removeClass('hidden');
                $('#historyLoading').addClass('hidden');

                if (typeof getStamp === "function") {
                    getStamp(requestNo, $('#historyDataContainer'));
                }
            },
            error: function(xhr, status, error) {
                console.error("AJAX 1 Error:", error);
                Swal.fire("Error", "Failed to fetch details.", "error");
                $('#historyDetailModal').addClass('hidden');
            }
        });

        // --- AJAX 2: Get Invoice Params ---
        $.ajax({
            url: '@Url.Action("GetInvoiceParams", "Inventory", new { area = "HC" })',
            type: 'GET',
            data: { requestNo: requestNo },
            success: function (res) {
                // LOG DATA RESPON AJAX 2
                console.log(">>> Response AJAX 2 (Invoice Params):", res);

                if (!res) return;

                window._invoiceParams = window._invoiceParams || {};
                window._invoiceParams[reqKey] = {
                    invoiceNo: res.invoiceNumber,
                    invoiceDate: res.invoiceDate,
                    dueDate: res.dueDate,
                    thirdParty: res.thirdParty,
                    description: res.description,
                    amount: res.amount,
                    currency: "IDR",
                    paymentType: res.paymentType,
                    sectionTo: res.sectionTo,
                    details: res.details || []
                };

                console.log("Final Saved Params in Window object:", window._invoiceParams[reqKey]);
            },
            error: function(xhr, status, error) {
                console.error("AJAX 2 Error:", error);
            }
        });
    }
    // 3. Event Listener: Close Modal
    $('#closeHistoryModalBtn').on('click', function() {
        $('#historyDetailModal').addClass('hidden');

        // Opsional: Reset URL browser kembali ke bersih
        // var cleanUrl = '@Url.Action("Inventory", "Inventory", new { area = "HC" })';
        // window.history.pushState(null, "", cleanUrl);
    });

    // 4. Eksekusi Deep Link saat Halaman Siap
    $(document).ready(function() {
        const reqNo = getRequestNoFromUrl();
        if (reqNo) {
            console.log("🚀 Deep link detected. Opening modal for:", reqNo);
            loadAndShowDetailModal(reqNo);
        }
    });

    $('#itemHistory tbody').on('click', 'td.dt-control', function (e) {
        // Stop default DataTables expand behavior
        e.preventDefault();
        e.stopPropagation();

        const tr = $(this).closest('tr');
        const row = historyTable.row(tr);
        const data = row.data();

        if (data && data.Request_No) {
            // Update URL Browser agar bisa dicopy-paste
            var newUrl = '@Url.Action("Inventory", "Inventory", new { area = "HC" })' + '/' + data.Request_No;
            window.history.pushState({path: newUrl}, "", newUrl);

            // Buka Modal
            loadAndShowDetailModal(data.Request_No);
        }
    });
    </script>
    
