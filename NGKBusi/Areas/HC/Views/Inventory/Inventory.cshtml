                        if (!unbVal) {
                            Swal.fire('Warning', 'Please select UNB Cost Center.', 'warning');
                            return;
                        }

                        sectionToName = unbText;
                        sectionToCode = unbVal;
                    } else {
                        sectionToName = sectionName; 
                        sectionToCode = "";
                    }
                } else {
                    sectionToCode = budgetParts[0] || "";
                }

                // ===== KHUSUS GENERAL AFFAIR + UNB =====
                if ((deptname === 'GENERAL AFFAIR' || divisionName === 'SALES & MARKETING' || divisionName === 'PRODUCTION') && budgetNo === 'UNB') {
                    const unbText = $('#unbCostCenter option:selected').text();
                    const unbVal = $('#unbCostCenter').val();

                    if (!unbVal) {
                        Swal.fire('Warning', 'Please select UNB Cost Center.', 'warning');
                        return;
                    }

                    sectionToName = unbText;
                }

                const notes = $('#note').val();

                if (qtyReq <= 0 || isNaN(qtyReq)) {
                    Swal.fire('Warning', 'Please enter a valid quantity.', 'warning');
                    return;
                }

                if (mode === 'edit' && cartId) {
                    $.ajax({
                        url: "@Url.Action("UpdateCart", "Inventory", new { area = "HC" })",
                        type: 'POST',
                        data: {
                            id: cartId,
                            User_NIK: usernik,
                            User_Name: username,
                            Dept_Name: sectionToName,
                            Section_Name: sectionName,
                            Division_Name: divisionName,
                            Item_Id: itemId,
                            Qty_Request: qtyReq,
                            Budget_No: budgetNo,
                            Budget_Desc: budgetDesc,
                            Section_To_Name: sectionToName, // Teks (AXCostName)
                            Section_To_Code: sectionToCode, // ID (AXCostID) <--- TAMBAHKAN INI
                            Notes: notes
                        },
                        success: (res) => {
