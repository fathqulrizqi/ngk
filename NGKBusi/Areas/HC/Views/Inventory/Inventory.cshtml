                const itemId = $('#modalItemId').val();
                const qtyReq = parseInt($('#qty').val());

                // --- Validasi untuk Select2 ---
                const budgetNo = $('#budgetNumber').val(); // Ambil nilai (value) yang dipilih
                if (!budgetNo) {
                    Swal.fire('Warning', 'Please select a valid Budget Number.', 'warning');
                    return;
                }

                const selectedOptionText = $('#budgetNumber option:selected').text();
                const budgetParts = selectedOptionText.split('|').map(part => part.trim());

                let budgetDesc = budgetParts[2] || '';
                let sectionToName = budgetParts[1] || '';

                let sectionToCode = "";

                if (budgetNo === 'UNB') {
                    const isHCGA = (deptname === 'HUMAN CAPITAL' || deptname === 'HRD & GA' || deptname === 'GENERAL AFFAIR' || deptname === 'GA');

                    if (isHCGA) {
                        const unbVal = $('#unbCostCenter').val();
