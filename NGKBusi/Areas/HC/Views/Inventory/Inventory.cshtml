@{
    ViewBag.Title = "Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section cssHead {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.tailwindcss.css" />
    <link href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/tippy.js@6.3.7/dist/tippy.css" />
    <link href="~/Content/bootstrap/css/bootstrap5.3.3/bootstrap.min.css" rel="stylesheet" />

    <style>
        .page-content {
            background: linear-gradient(135deg, #1E555C 10%, #fefee3 100%);
            padding-top: 0 !important;
            margin-top: 0 !important;
        }

       /* #itemHistory tbody tr {
            cursor: pointer;
        }
*/
        #cartTable thead th,
        #itemHistory thead th {
            background-color: #F6F7F8 !important;
            border-bottom: 2px solid #F6F7F8 !important;
            color: black !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
        }

        #cartTable .dataTables_empty {
            padding: 2rem !important;
            color: #9ca3af !important;
            font-style: italic;
            background-color: transparent !important;
        }

        #cartTable {
            border-collapse: collapse !important;
            border: none !important;
        }

            #cartTable tbody td {
                border-bottom: 1px solid #f3f4f6 !important;
                background-color: transparent !important;
                padding: 12px 8px !important;
            }


        .dt-container .grid {
            margin-bottom: 0 !important;
            gap: 0 !important;
        }

        .dt-container .dt-length {
            margin-right: 1rem;
        }

        input[aria-controls="itemHistory"] {
            padding: 2px !important;
            border-radius: 0.5rem;
            border: 1px solid #007582;
            outline: none;
        }

        select[aria-controls="itemHistory"] {
            padding: 2px !important;
            border-radius: 0.5rem;
            border: 1px solid #007582;
            outline: none;
            margin-right: 10px !important;
        }

        #itemHistory td {
            white-space: normal !important;
            word-break: break-word;
        }

        #itemHistory th {
            white-space: normal !important;
            word-break: break-word;
        }

        select[aria-controls="itemHistory"]:focus {
            border-color: #007582;
            box-shadow: 0 0 0 1px rgba(59, 130, 246, 0.2) !important;
        }

        .select2-container--default .select2-selection--single {
            border-color: #DEE2E6 !important;
            height: auto !important;
        }

        .select2-container--default .select2-selection--multiple {
            min-height: 2rem;
            border-color: #DEE2E6 !important;
            padding: 0.25rem;
            width: auto !important;
            display: inline-block;
        }

        .select2-selection__rendered {
            word-wrap: break-word !important;
            text-overflow: inherit !important;
            white-space: normal !important;
        }

        table.dataTable td,
        table.dataTable th {
            padding: 0.5rem 0.5rem !important;
        }

        .hidden {
            display: none !important;
        }

        input[aria-controls="itemHistory"],
        select[aria-controls="itemHistory"],
        #dt-search-0,
        #dt-length-0 {
            background-color: #ffffff !important;
            color: #1f2937 !important;
            margin-bottom: 5px;
            border: 1px solid #DEE2E6 !important;
            border-radius: 0.5rem !important;
            padding: 0.4rem 0.8rem !important;
            transition: all 0.2s ease;
        }

        #cartTable tbody tr:nth-child(even),
        #itemHistory tbody tr:nth-child(even),
        tr.even {
            background-color: #F9FAFB !important;
        }
    </style>
}

@section scriptHead {
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="~/Content/bootstrap/js/bootstrap5.3.3/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.tailwindcss.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>

    <script>
        // Deklarasi global variables
        const itemList = @Html.Raw(Json.Encode(ViewBag.ItemList));
        const userCostNames = @Html.Raw(Json.Encode(ViewBag.userCostNames));
        const subcategoryList = @Html.Raw(Json.Encode(ViewBag.SubcategoryList));
        const categoryList = @Html.Raw(Json.Encode(ViewBag.CategoryList));
        const baseImagePath = '@Url.Content("~/Files/HC/Inventory/")';
        const Budget = @Html.Raw(Json.Encode(ViewBag.Budget ?? new object()));
        const previewPOUrl = "@Url.Action("NonPO", "PaymentRequest", new { area = "FA" })";
        const previewRequestUrl = "@Url.Action("PreviewRequest", "Inventory", new { area = "HC" })";
        const previewInvoiceUrl = "@Url.Action("PreviewInvoice", "Inventory", new { area = "HC" })";
        var inventoryBasePath = '@Url.Content("~/Files/HC/Inventory/")';

        console.log("sampleBudget", Budget);
        // Buat peta (map) untuk mencari nama kategori dengan cepat
        const categoryNameMap = {};
        categoryList.forEach(category => {
            categoryNameMap[category.ID] = category.Category_Name;
        });

        // ========================
        // Helper Functions
        // ========================
        cartTable = {
    ajax: {
        url: "@Url.Action("GetCartbyUser", "Inventory", new { area = "HC" })",
        type: 'GET',
        dataSrc: function (res) {
            const container = $('#cartTablesContainer');
            container.empty(); // Bersihkan container sebelum render ulang

            if (!res.carts || res.carts.length === 0) {
                container.append('<div class="p-4 text-center italic text-gray-500">No items in the cart.</div>');
                return [];
            }

            // 1. Grouping data berdasarkan Section_To_Name
            let groupedCarts = {};
            res.carts.forEach(item => {
                const section = item.Section_To_Name || 'Unknown Section';
                if (!groupedCarts[section]) {
                    groupedCarts[section] = [];
                }
                groupedCarts[section].push(item);
            });

            // 2. Render Header, Table, dan Budget per Section
            Object.keys(groupedCarts).forEach((sectionName, index) => {
                const sectionData = groupedCarts[sectionName];
                const tableId = `table_${index}`;

                // Hitung total harga untuk section ini saja
                let sectionTotal = 0;
                sectionData.forEach(item => {
                    sectionTotal += (parseFloat(item.Qty_Request) || 0) * (parseFloat(item.Price) || 0);
                });

                // Cari data budget yang relevan dengan section ini (opsional)
                // Disini kita asumsikan budgetSummary akan muncul di bawah masing-masing tabel

                let htmlSection = `
                    <div class="section-group mb-10 border-b pb-6">
                        <h3 class="text-lg font-bold text-cyan-800 mb-3 uppercase flex items-center">
                            <i class="fa-solid fa-building-user mr-2"></i> ${sectionName}
                        </h3>
                        <div class="overflow-x-auto mb-4">
                            <table id="${tableId}" class="stripe hover w-full text-sm cart-dynamic-table">
                                <thead>
                                    <tr class="bg-gray-100">
                                        <th width="30px">NO</th>
                                        <th>ITEM</th>
                                        <th>QTY</th>
                                        <th>PRICE</th>
                                        <th>BUDGET</th>
                                        <th width="60px">ACTION</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <div class="bg-gray-50 p-3 rounded flex justify-between items-center border border-dashed border-gray-300">
                            <span class="text-gray-600 font-medium text-sm">Est. Total for ${sectionName}:</span>
                            <span class="text-cyan-700 font-bold text-lg">${rupiah.format(sectionTotal)}</span>
                        </div>
                    </div>
                `;

                container.append(htmlSection);

                // 3. Inisialisasi DataTable untuk tabel yang baru dibuat
                $(`#${tableId}`).DataTable({
                    data: sectionData,
                    responsive: true,
                    autoWidth: true,
                    ordering: false,
                    paging: false,
                    info: false,
                    searching: false,
                    columns: [
                        { data: null, render: (data, type, row, meta) => meta.row + 1 },
                        {
                            data: 'Item_Name',
                            render: (data, type, row) => `
                                <div class="whitespace-normal break-words text-sm font-semibold text-gray-800">${row.Item_Name}</div>
                                <div class="text-sm text-gray-600">Note: ${(row.Notes && row.Notes.trim() !== '') ? row.Notes : '-'}</div>
                            `
                        },
                        { data: 'Qty' },
                        {
                            data: 'Price',
                            render: (data) => rupiah.format(data)
                        },
                        {
                            data: null,
                            render: (data, type, row) => {
                                const budgetNo = row.Budget_No || '-';
                                const budgetDesc = row.Budget_Desc || '-';
                                return `<div class="flex flex-col leading-tight">
                                            <span class="font-medium text-gray-800">${budgetNo}</span>
                                            <span class="text-xs text-gray-500">${budgetDesc}</span>
                                        </div>`;
                            }
                        },
                        {
                            data: null,
                            render: (data, type, row) => `
                                <div class="flex gap-2">
                                    <button title="Edit" class="btn btn-edit px-1"
                                        data-id="${row.ID}" data-itemid="${row.Item_Id}" data-item="${row.Item_Name}"
                                        data-qty="${row.Qty_Request}" data-budgetno="${row.Budget_No}"
                                        data-note="${row.Notes ?? ''}" data-budgetdesc="${row.Budget_Desc ?? ''}"
                                        data-sectiontoname="${row.Section_To_Name ?? ''}">
                                        <i class="fa-solid fa-pen text-[14px]" style="color: #F6AA04;"></i>
                                    </button>
                                    <button class="btn btn-delete text-red-500" data-id="${row.ID}" title="Delete">
                                        <i class="fa-solid fa-trash text-[14px]" style="color: #D91F1F;"></i>
                                    </button>
                                </div>`
                        }
                    ]
                });
            });

            // Tetap jalankan summary global jika diperlukan
            let totalCartPriceByBudget = {};
            res.carts.forEach(item => {
                const bNo = item.Budget_No;
                totalCartPriceByBudget[bNo] = (totalCartPriceByBudget[bNo] || 0) +
                                              (parseFloat(item.Qty_Request) * parseFloat(item.Price));
            });
            renderBudgetSummary(res.budgets || [], totalCartPriceByBudget);

            return res.carts;
        }
    }
};

// Panggil AJAX pertama kali saat page load
function loadCart() {
    $.ajax(cartTable.ajax).done(function(res) {
        // DataTables diinisialisasi di dalam dataSrc callback
    });
}
        function renderBudgetSummary(budgets, cartTotals, returnHtml = false) {
            let htmlOutput = "";

            budgets.forEach(b => {
                const bNo = b.budgetNo || b.BudgetNo;
                const bDesc = b.budgetDesc || b.BudgetDesc;
                const totalFY2 = parseFloat(b.totalFY2 || b.TotalFY2) || 0;

                // 1. Ambil nilai purchasedUsage dari data controller
                const purchased = parseFloat(b.purchasedUsage || b.PurchasedUsage) || 0;

                // 2. Mengambil nilai current usage (keranjang aktif) dari object cartTotals
                const used = cartTotals[bNo] || 0;

                // 3. Sisa budget dikurangi keranjang aktif DAN yang sudah di-purchase
                const remaining = totalFY2 - used - purchased;

                const remainingClass = remaining < 0 ? 'text-red-600 font-bold' : 'text-emerald-600 font-semibold';

                htmlOutput += `
<div class="mb-3 p-3 border-l-4 border-cyan-700 bg-white shadow-sm rounded-r-lg">
    <div class="text-sm font-bold text-gray-800 mb-2 uppercase">
        ${bNo} | ${bDesc}
    </div>
    <div class="flex justify-between text-sm">
        <span class="text-gray-500">Total Budget:</span>
        <span class="font-semibold">${rupiah.format(totalFY2)}</span>
    </div>
    <div class="flex justify-between text-sm">
        <span class="text-gray-500 font-bold">Purchased Usage:</span>
        <span class="font-bold text-red-600">${rupiah.format(purchased)}</span> <!-- Diganti menjadi purchased -->
    </div>
    <div class="flex justify-between text-sm">
        <span class="text-gray-500 font-bold">Current Usage (In Cart):</span>
        <span class="font-bold text-blue-600">${rupiah.format(used)}</span>
    </div>
    <div class="flex justify-between text-sm border-t mt-1 pt-1">
        <span class="text-gray-500 font-semibold">Remaining:</span>
        <span class="${remainingClass}">${rupiah.format(remaining)}</span>
    </div>
</div>`;
            });
            if (returnHtml) {
                return htmlOutput;
            } else {
                $('#budgetSummary').empty().append(htmlOutput);
            }
        }

        // Fungsi untuk mengelompokkan subkategori berdasarkan categoryId
        function groupSubcategoriesByCategory(data) {
            const groupedData = {};

            data.forEach(item => {
                const categoryId = item.Category_Id;

                if (!groupedData[categoryId]) {
                    const categoryName = categoryNameMap[categoryId] || `Category ${categoryId}`;
                    groupedData[categoryId] = {
                        CategoryName: categoryName,
                        Items: []
                    };
                }

                groupedData[categoryId].Items.push({
                    ID: item.ID,
                    Item_Name: item.Subcategory_Name,
                    Image: item.Subcategory_Image,
                });
            });
            return Object.values(groupedData);
        }

function renderSubcategorySection(category) {
    let html = `
        <div class="mb-6">
            <div class="self-stretch inline-flex flex-col justify-start items-start gap-[5px] mb-2">
                <div class="self-stretch justify-start text-black text-lg font-bold">${category.CategoryName}</div>
                <div class="self-stretch h-[1px] p-[2px] bg-cyan-700"></div>
            </div>
            <div class="flex flex-wrap gap-4">
    `;

    if (category.Items.length === 0) {
        html += `<div class="text-sm text-gray-400">No items available.</div>`;
    } else {
        category.Items.forEach(item => {
            let imageUrl = 'https://placehold.co/150x150';

            if (item.Image) {
                let isFullUrl = item.Image.startsWith("http://") || item.Image.startsWith("https://");

                imageUrl = isFullUrl
                    ? item.Image
                    : '@Url.Content("~/Files/HC/Inventory/")' + item.Image;
            }

            html += `
                <div class="card-item-subcategory w-36 bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-gray-100 transition duration-200 cursor-pointer"
                     data-id="${item.ID}"
                     data-name="${item.Item_Name}"
                     data-image="${item.Image ?? ''}"
                >
                    <img class="rounded-t-lg w-full h-24 object-contain" src="${imageUrl}" alt="${item.Item_Name}" />
                    <div class="p-2">
                        <h5 class="mb-2 text-md font-bold tracking-tight text-gray-800">${item.Item_Name}</h5>
                    </div>
                </div>
            `;
        });
    }
    html += `</div></div>`;
    return html;
}
        function groupItemsByCategory(data) {
            const groupedData = {};

            data.forEach(item => {
                const categoryId = item.Category_Id;

                if (!groupedData[categoryId]) {
                    const categoryName = categoryNameMap[categoryId] || `Category ${categoryId}`;
                    groupedData[categoryId] = {
                        CategoryName: categoryName,
                        Items: []
                    };
                }

                groupedData[categoryId].Items.push(item);
            });
            return Object.values(groupedData);
        }

        function renderEditingItemThumbnail(item) {
            let imageUrl = item.Image ? (item.Image.startsWith('http') ? item.Image : baseImagePath + item.Image) : 'https://via.placeholder.com/150/cccccc/333333?text=No+Image';
            return `
        <div class="item-thumbnail w-32 h-32 p-1 bg-white border border-gray-200 rounded-lg shadow-sm flex flex-col items-center justify-center text-center cursor-not-allowed border-cyan-700 ring-2 ring-cyan-700"
             data-id="${item.ID}">
             <img class="w-20 h-20 object-contain" src="${imageUrl}" alt="${item.Item_Name}" />
             <div class="text-xs font-medium text-gray-700 mt-1 truncate w-full px-1">${item.Item_Name}</div>
        </div>
    `;
        }

        // Fungsi untuk merender item sesuai mode (default atau search)
        function renderItems(data, isSearchMode = false) {
            const container = document.getElementById('cardContainer');
            container.innerHTML = '';

            if (data.length === 0) {
                container.innerHTML = '<div class="text-center text-gray-500 mt-8">No items found.</div>';
                return;
            }

            if (isSearchMode) {
                const groupedItems = groupItemsByCategory(data);
                groupedItems.forEach(group => {
                    container.innerHTML += renderItemThumbnailSection(group);
                });
            } else {
                const groupedSubcategories = groupSubcategoriesByCategory(data);
                groupedSubcategories.forEach(category => {
                    container.innerHTML += renderSubcategorySection(category);
                });
            }
        }

        // Fungsi utama untuk filter dan render
        function filterAndRenderItems(searchText) {
            if (!searchText || searchText.trim() === '') {
                renderItems(subcategoryList, false);
            } else {
                const lowerSearchText = searchText.toLowerCase();
                const filteredItems = itemList.filter(item =>
                    item.Item_Name.toLowerCase().includes(lowerSearchText)
                );
                renderItems(filteredItems, true);
            }
        }

        function renderStamp(dateValue, label, status = "") {
            const isRejected = status.toLowerCase().includes("reject");

            if (isRejected) {
                return `
        <div class="w-[70px] h-[70px] bg-red-500 rounded-full flex items-center justify-center cursor-default">
            <span class="text-white text-xs">Rejected</span>
        </div>
        `;
            }

            // normalize value untuk selain reject
            const invalid =
                !dateValue ||
                dateValue === "NULL" ||
                dateValue === "null" ||
                dateValue === "0" ||
                dateValue === "-" ||
                dateValue.trim() === "";

            if (invalid) {
                return `
        <div class="w-[70px] h-[70px] bg-orange-300 rounded-full flex items-center justify-center">
            <span class="text-white text-xs">Pending</span>
        </div>
        `;
            }

            // kalau valid
            return `
        <div class="w-[70px] h-[70px] bg-green-500 rounded-full flex items-center justify-center">
            <span class="text-white text-[10px] text-center">${label}<br>${dateValue}</span>
        </div>
    `;
        }

        // Panggilan AJAX untuk mengambil detail item spesifik
        const rupiah = new Intl.NumberFormat('id-ID', {
            style: 'currency',
            currency: 'IDR',
            minimumFractionDigits: 2
        });


function formatHistoryDetails(detail) {
    // =================================================================
    // 1. HELPER FUNCTIONS
    // =================================================================

    // Helper untuk mengecek apakah status tanggal masih pending
    function isPending(dateValue) {
        return !dateValue ||
            dateValue === "NULL" ||
            dateValue === "null" ||
            dateValue === "0" ||
            dateValue === "-" ||
            (typeof dateValue === 'string' && dateValue.trim() === "");
    }

    // Helper untuk merender class dan atribut button secara dinamis
    function getButtonAttributes(dateValue, status) {
        const isRejected = (status || "").toLowerCase().includes("reject");
        const pending = isPending(dateValue);

        // Disable tombol jika statusnya rejected ATAU jika sudah tidak pending (sudah di-stamp)
        const isDisabled = isRejected || !pending;

        if (isDisabled) {
            // pointer-events-none memastikan tombol benar-benar tidak bisa diklik/di-hover
            return `class="relative cursor-default pointer-events-none" disabled`;
        } else {
            // Jika masih pending, kursor jadi pointer
            return `class="relative cursor-pointer hover:opacity-80 transition-opacity"`;
        }
    }

    // renderStamp sekarang menerima parameter nameValue untuk ditampilkan di stamp SVG
    function renderStamp(dateValue, nameValue, status = "") {
        const isRejected = (status || "").toLowerCase().includes("reject");

        if (isRejected) {
            return `
            <div class="w-[70px] h-[70px] bg-red-500 rounded-full flex items-center justify-center cursor-default">
                <span class="text-white text-xs">Rejected</span>
            </div>
            `;
        }

        // Gunakan helper isPending
        if (isPending(dateValue)) {
            return `
            <div class="w-[70px] h-[70px] bg-orange-300 rounded-full flex items-center justify-center">
                <span class="text-white text-xs">Pending</span>
            </div>
            `;
        }

        // Format tanggal jika bentuknya "/Date(123456789)/"
        let formattedDate = dateValue;
        if (typeof dateValue === 'string' && dateValue.includes('/Date(')) {
            formattedDate = moment(parseInt(dateValue.replace(/[^\d]/g, ''))).format('DD-MM-YYYY');
        }

        // Ambil kata pertama dari nama
        const shortName = nameValue ? nameValue.split(' ')[0] : '-';

        // Return desain Stamp SVG persis seperti getStamp (tanpa background hijau)
        return `
            <div class="flex w-[70px] h-[70px] py-[15px] flex-col items-center gap-[9px] bg-no-repeat bg-center bg-contain select-none pointer-events-none"
                 style="background-image: url('@Url.Content("~/images/stamp.svg")'); background-size: cover;">
                <p class="text-[10px] font-bold text-red-500 leading-[10px] text-center">${shortName}</p>
                <p class="text-[10px] font-normal text-red-500 leading-[10px] text-center">${formattedDate}</p>
            </div>
        `;
    }

    const readyIcon = (val) => {
        if (val === true) {
            return `<i class="fa fa-check text-green-600 text-lg"></i>`;
        }
        if (val === false) {
            return `<i class="fa fa-times text-red-600 text-lg"></i>`;
        }
        return `-`;
    };

    // =================================================================
    // 2. DATA PROCESSING
    // =================================================================
    const isReadyToPick = detail.Status === 'Ready to Pick';
    const isComplete = detail.Status === 'Complete' || detail.Status === 'Generated' || detail.Status === 'Upload File' || detail.Status === 'E-Voucher Issued';

    let totalUsageByBudget = {};
    let grandTotalUsage = 0;

    if (detail.BudgetSummary && detail.BudgetSummary.length > 0) {
        detail.BudgetSummary.forEach(summary => {
            const val = parseFloat(summary.TotalRequest) || 0;
            totalUsageByBudget[summary.BudgetNo] = val;
            grandTotalUsage += val;
        });
    }

    // Tentukan tampilan summary berdasarkan status
    const budgetSummaryHtml = isComplete
        ? `<div class="bg-gray-100 p-3 rounded flex justify-between items-center border border-dashed border-gray-300 mb-4">
            <span class="text-gray-600 font-medium text-sm uppercase">Total:</span>
            <span class="text-cyan-700 font-bold text-lg">${rupiah.format(grandTotalUsage)}</span>
           </div>`
        : renderBudgetSummary(detail.Budgets || [], totalUsageByBudget, true);

    // Table Header Extras (is Ready)
    const headerExtra = (isReadyToPick || isComplete)
        ? `${isReadyToPick ? `<th class="border px-2 py-1 text-center">Is Ready</th>` : ''}`
        : '';

    // Build Rows
    const tableRows = detail.Items.map((item, i) => {
        let rowExtra = "";

        if (isReadyToPick) {
            rowExtra = `
                <td class="border px-2 py-1 text-center">
                    ${readyIcon(item.isReady)}
                </td>
            `;
        }

        const price = Number(item.Price) || 0;
        const qty = Number(item.Qty_Request) || 0;
        const totalPrice = price * qty;

        return `
            <tr>
                <td class="border px-2 py-1 text-center">${i + 1}</td>
                <td class="border px-2 py-1">${item.Item_Name}</td>
                <td class="border px-2 py-1 text-center">${item.Qty}</td>
                <td class="border px-2 py-1 text-right">${rupiah.format(price)}</td>
                <td class="border px-2 py-1 text-right font-semibold">${rupiah.format(totalPrice)}</td>
                <td class="border px-2 py-1 whitespace-normal break-words w-[250px]">
                    <div class="font-semibold">${item.Budget || '-'}</div>
                    <div class="font-thin">${item.Section_To_Name || '-'}</div>
                </td>
                <td class="border px-2 py-1">${item.Notes || '-'}</td>
                ${rowExtra}
            </tr>
        `;
    }).join("");

    // Reject / Return Message
    let rejectMessageHtml = "";
    if (detail.RejectMessage) {
        const statusLower = detail.Status.toLowerCase();
        if (statusLower.includes("rejected")) {
            rejectMessageHtml = `
            <div class="mb-2 p-2 bg-red-100 border border-red-300 text-red-700 text-sm rounded">
                <strong>Message:</strong> ${detail.RejectMessage}
            </div>
            `;
        } else if (statusLower.includes("return")) {
            rejectMessageHtml = `
            <div class="mb-2 p-2 bg-orange-100 border border-orange-300 text-orange-700 text-sm rounded">
                <strong>Message:</strong> ${detail.RejectMessage}
            </div>
            `;
        }
    }

    // Invoice / Voucher Buttons
    let generateSection = "";
    let generateSection2 = "";

    // const previewInvoiceUrl = "@Url.Action("PreviewInvoice", "Inventory", new { area = "HC" })";
    const previewPOUrl = "@Url.Action("NonPO", "PaymentRequest", new { area = "FA" })";

    if (isComplete) {
        const hasInvoice = !!detail.Invoice_No;

        // ---- Invoice ----
        generateSection = hasInvoice
            ? `
                <div class="flex justify-end pt-3">
                    <span class="text-sm font-semibold text-gray-700">
                        Invoice No:
                        <a href="${previewInvoiceUrl}?requestNo=${detail.Request_No}"
                           target="_blank"
                           class="text-blue-600 underline hover:text-blue-800">
                           ${detail.Invoice_No}
                        </a>
                    </span>
                </div>
              `
            : `
                <div class="flex justify-end">
                    <button class="btn btn-sm btn-primary generate-invoice-btn px-4 py-2"
                        data-requestno="${detail.Request_No}">
                        Generate Invoice
                    </button>
                </div>
              `;

        // ---- Voucher ----
        if (!hasInvoice) {
            generateSection2 = `
                <div class="flex justify-end pt-3">
                    <button class="btn btn-danger text-sm px-4 py-2 opacity-50 cursor-not-allowed" disabled>
                        Generate E-Voucher
                    </button>
                </div>
            `;
        } else {
            generateSection2 = detail.Receive_Number
                ? `
                    <div class="flex justify-end pt-3">
                        <span class="text-sm font-semibold text-gray-700">
                            Receive No:
                            <a href="${previewPOUrl}"
                               target="_blank"
                               class="text-blue-600 underline hover:text-blue-800">
                                ${detail.Receive_Number}
                            </a>
                        </span>
                    </div>
                  `
                : `
                    <div class="flex justify-end mt-2">
                        <button class="btn btn-danger generateVoucherBtn text-sm px-4 py-2"
                            data-requestno="${detail.Request_No}">
                            Generate E-Voucher
                        </button>
                    </div>
                  `;
        }
    }

    // Delete Button (Only when Pending)
    let deleteBtnHtml = "";
    if (detail.Status === "Pending") {
        deleteBtnHtml = `
        <div class="flex">
            <button class="delete-request-btn bg-red-600 hover:bg-red-700 text-white text-xs px-3 py-1 rounded shadow"
                data-requestno="${detail.Request_No}">
                <i class="fa fa-trash mr-1"></i> Delete
            </button>
        </div>
        `;
    }

    // =================================================================
    // 3. FINAL RETURN HTML
    // =================================================================
    return `
        <div class="p-2 text-xs w-full bg-gray-50 space-y-3 relative" data-request-no="${detail.Request_No}">
            ${rejectMessageHtml}
            <div class="overflow-x-auto">
                <p class="font-semibold mb-2">
                    Due Date: <span>${moment(parseInt(detail.Due_Date.replace(/[^\d]/g, ''))).format('DD-MM-YYYY')}</span>
                </p>
                <table class="min-w-full text-sm border-collapse border border-gray-300">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="border px-2 py-1 text-center">No</th>
                            <th class="border px-2 py-1">Item</th>
                            <th class="border px-2 py-1 text-center">Qty</th>
                            <th class="border px-2 py-1 text-center">Price</th>
                            <th class="border px-2 py-1 text-center">Total Price</th>
                            <th class="border px-2 py-1">Budget</th>
                            <th class="border px-2 py-1">Notes</th>
                            ${headerExtra}
                        </tr>
                    </thead>
                    <tbody>
                        ${tableRows}
                    </tbody>
                </table>
            </div>
            ${budgetSummaryHtml}

            <div id="approval">
                <div class="flex justify-start gap-12 mb-6 mx-4">

                    <div class="flex flex-col items-center gap-1">
                        <div class="text-[12px]">Approved By:</div>
                        <button id="approvalbtn" ${getButtonAttributes(detail.ApproveDate, detail.Status)} data-requestno="${detail.Request_No}">
                            ${renderStamp(detail.ApproveDate, detail.Approver ? detail.Approver.Name : detail.ApproveBy, detail.Status)}
                        </button>
                        <div id="longnameapproved" class="text-[12px] font-bold italic">${detail.Approver ? detail.Approver.Name : '-'}</div>
                    </div>

                    <div class="flex flex-col items-center gap-1">
                        <div class="text-[12px]">Checked By:</div>
                        <button id="checkbtn" ${getButtonAttributes(detail.CheckDate, detail.Status)} data-requestno="${detail.Request_No}">
                            ${renderStamp(detail.CheckDate, detail.Checker ? detail.Checker.Name : detail.CheckBy, detail.Status)}
                        </button>
                        <div id="longnamechecked" class="text-[12px] font-bold italic">${detail.Checker ? detail.Checker.Name : '-'}</div>
                    </div>

                    <div class="flex flex-col items-center gap-1">
