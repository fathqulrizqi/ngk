                                displayText = 'Need to Be Order';
                            }

                            if (data === 'Upload File') {
                                displayText = 'Complete';
                            }
                            if (data === 'Generated') {
                                displayText = 'Complete';
                            }

                            let extraInfo = '';

                            if (data === 'Ready to Pick' && row.Carts) {

                                const total = row.Carts.length;

                                const checkIsReady = (val) =>
                                    String(val).toLowerCase() === 'true' || val === 1 || val === true;

                                // READY TO PICK
                                const readyToPick = row.Carts.filter(x =>
                                    checkIsReady(x.isReady) &&
                                    (x.Pick_Date == null || x.Pick_Date === "")
                                ).length;

                                // PICKED UP
                                const pickedUp = row.Carts.filter(x =>
                                    checkIsReady(x.isReady) &&
                                    x.Pick_Date != null &&
                                    x.Pick_Date !== ""
                                ).length;

                                extraInfo = `
        <div class="text-xs mt-1">
            <span class="text-orange-700 font-semibold">
                Ready: ${readyToPick}/${total}
            </span> |
            <span class="text-green-700 font-semibold">
                Picked: ${pickedUp}/${total}
            </span>
        </div>
    `;
                            }

                            const statusColors = {
                                'On Order': 'bg-yellow-300 text-yellow-900',
                                'Rejected': 'bg-red-400 text-white',
                                'On Prepare': 'bg-blue-400 text-white',
                                'Pending': 'bg-yellow-500 text-white',
                                'Ready to Pick': 'bg-orange-400 text-white',
                                'Complete': 'bg-green-500 text-white',
                                'Approved': 'bg-purple-500 text-white',
                                'E-Voucher Issued': 'bg-teal-500 text-white',
                                'E-Voucher Stamped': 'bg-red-400 text-white',
                                'Need to Be Order': 'bg-gray-400 text-white',
                                'Waiting for Check': 'bg-cyan-500 text-white',
                                'Waiting for Approval': 'bg-slate-500 text-white'
                            };

                            const colorClass = statusColors[displayText] || 'bg-gray-200 text-gray-800';

                            return `
        <span class="px-2 py-1 text-sm rounded ${colorClass}">
            ${displayText}
        </span>
        ${extraInfo}
    `;
                        }
                    }


