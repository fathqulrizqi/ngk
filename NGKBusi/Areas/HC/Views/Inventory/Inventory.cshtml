       $(document).on("click", ".generateVoucherBtn", function () {
    const reqNo = $(this).data("requestno");
    const data = window._invoiceParams?.[reqNo];

    if (!data) {
        alert("Invoice data belum ke-load. Klik detail dulu.");
        return;
    }


    let processedDetails = "";
    if (Array.isArray(data.details)) {
        processedDetails = data.details.map(item => {
            let bgtNo = item.Budget_No || "UNB";
            let bgtDesc = item.Budget_Desc || "Unbudgeted";
            let bgtFull = (bgtNo === "UNB")
                ? "UNB|Unbudgeted"
                : `${bgtNo}|${bgtDesc}`;

            return `${item.Qty}||${bgtFull}||${item.Description}||${item.COA || ''}||${item.sectionTo}`;
        }).join("#");

    } else {
        processedDetails = data.details; // fallback jika sudah berupa string
    }

    const baseUrl = '@Url.Action("NonPO", "PaymentRequest", new { area = "FA" })';

    const url = baseUrl
        + "?addNew=addNew"
        + "&invNumber=" + encodeURIComponent(data.invoiceNo)
        + "&currency=" + encodeURIComponent(data.currency)
        + "&thirdParty=" + encodeURIComponent(data.thirdParty)
        + "&dueDate=" + encodeURIComponent(data.dueDate)
        + "&description=" + encodeURIComponent(data.description)
        + "&requestNo=" + encodeURIComponent(reqNo)
        + "&amountOfInvoice=" + encodeURIComponent(data.amount)
        + "&paymentType=" + encodeURIComponent(data.paymentType)
        + "&sectionTo=" + encodeURIComponent(data.sectionTo)
        + "&details=" + encodeURIComponent(processedDetails); // Kirim yang sudah di-map

    window.open(url, "_blank");
});


