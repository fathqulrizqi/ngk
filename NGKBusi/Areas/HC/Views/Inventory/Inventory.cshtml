        function populateModalWithItemDetails(item, cartList) {
            if (!item) {
                resetItemDetails();
                return;
            }

            const itemInCart = cartList.find(cartItem => cartItem.ID === item.ID);

            $('#modalItemId').val(item.ID);

            if (itemInCart) {
                $('#formModal').data('mode', 'edit');
                $('#modalCartId').val(itemInCart.CartID);
                $('#qty').val(itemInCart.Qty).prop('disabled', false);
                $('#note').val(itemInCart.Note).prop('disabled', false);
                $('#submitCart').prop('disabled', false);
                $('#budgetNumber').val(itemInCart.BudgetNumber).trigger('change');
            } else {
                $('#formModal').data('mode', 'add');
                $('#modalCartId').val('');
                $('#qty').val(1).prop('disabled', false);
                $('#note').val('').prop('disabled', false);
                $('#submitCart').prop('disabled', false);
                $('#budgetNumber').val('').trigger('change');
            }

            $('#itemName').text(item.Item_Name);
            $('#qtyStock').text(`${item.Qty} ${item.Unit}`);
            $('#price').text(`Rp ${item.Price}`);

            let imageUrl = item.Image ? (item.Image.startsWith('http') ? item.Image : baseImagePath + item.Image) : 'https://via.placeholder.com/150/cccccc/333333?text=No+Image';
            $('.itemimage').css({
                'background-image': `url(${imageUrl})`,
                'background-size': 'cover',
                'background-position': 'center',
                'background-color': 'transparent'
            }).empty();

            if (item.Category_Id === 3) {
                $('#budgetWrapper').hide();
                $('#budgetNumber').prop('disabled', true);
            } else {
                $('#budgetWrapper').show();
                $('#budgetNumber').prop('disabled', false);
                $('#budgetNumber').select2({ placeholder: "-- Select budget number --", allowClear: true });
            }
        }

        // Fungsi untuk mengisi sisi kiri modal dengan item dari subkategori yang sama
        function populateModalWithRelatedItems(items, cartList, editingItemId) {
            const $mapItemContainer = $('#MapItem');
            $mapItemContainer.empty();

            if (items.length === 0) {
                $mapItemContainer.html('<div class="text-sm text-gray-400 w-full text-center">No items found for this subcategory.</div>');
            } else {
                let html = '';
                items.forEach(item => {
                    const isItemInCart = cartList.some(cartItem => cartItem.ID === item.ID);
                    const inCartClass = isItemInCart ? 'item-in-cart' : '';
                    const isEditing = item.ID === editingItemId;
                    const editingClass = isEditing ? 'border-cyan-700 ring-2 ring-cyan-700' : '';

                    let imageUrl = 'https://placehold.co/150x150';

                    if (item.Image) {
                        const isFullUrl = item.Image.startsWith('http://') || item.Image.startsWith('https://');

                        imageUrl = isFullUrl ? item.Image : inventoryBasePath + item.Image;
                    }

                    html += `
                <div class="item-thumbnail w-32 h-32 p-1 bg-white border border-gray-200 rounded-lg shadow-sm flex flex-col items-center justify-center text-center cursor-pointer hover:bg-gray-100 transition duration-200 ${inCartClass} ${editingClass}"
                     data-id="${item.ID}"
                     data-subcategory-id="${item.Subcategory_Id}"
                     data-item-name="${item.Item_Name}"
                     data-qty-stock="${item.Qty}"
                     data-unit="${item.Unit}"
                     data-category-id="${item.Category_Id}"
                     data-image="${item.Image ?? ''}">

                    <img class="w-20 h-20 object-contain" src="${imageUrl}" alt="${item.Item_Name}" />

                    <div class="text-xs font-medium text-gray-700 mt-1 truncate w-full px-1">${item.Item_Name}</div>
                </div>
            `;
                });
                $mapItemContainer.append(html);

                // Memicu klik pada item yang sedang diedit
                const $editingItem = $mapItemContainer.find(`.item-thumbnail[data-id="${editingItemId}"]`);
                if ($editingItem.length > 0) {
                    $editingItem.trigger('click');
                }
            }
        }
        // Fungsi untuk mengambil dan menampilkan stempel (stamp)
function getStamp(requestNo, $child) {
    $.ajax({
        url: '@Url.Action("GetStampStatus", "Inventory", new { area = "HC" })',
        type: 'GET',
        data: { requestNo: requestNo },
        success: function (response) {
            if (!response) return;

            // === Ambil data dari response ===
            const approvedName = response.ApproveBy;
            const approvedDate = response.ApproveDate
                ? moment(parseInt(response.ApproveDate.replace(/[^\d]/g, ''))).format('DD-MM-YYYY')
                : '-';
            const checkerName = response.CheckBy;
            const checkerDate = response.CheckDate
                ? moment(parseInt(response.CheckDate.replace(/[^\d]/g, ''))).format('DD-MM-YYYY')
                : '-';

            // === Target tombol ===
            const $approvalBtn = $child.find('#approvalbtn');
            const $checkBtn = $child.find('#checkbtn');

            // === CHECK STAMP ===
            if (checkerName && checkerDate && checkerDate !== '-') {
                const checkStampHtml = `
                    <div class="flex w-[70px] h-[70px] py-[15px] flex-col items-center gap-[9px] bg-no-repeat bg-center bg-contain select-none pointer-events-none"
                         style="background-image: url('@Url.Content("~/images/stamp.svg")'); background-size: cover;">
                        <p class="text-[10px] font-bold text-red-500 leading-[10px] text-center">${checkerName.split(' ')[0]}</p>
                        <p class="text-[10px] font-normal text-red-500 leading-[10px] text-center">${checkerDate}</p>
                    </div>`;
                $checkBtn.html(checkStampHtml)
                    .prop('disabled', true)
                    .css({ cursor: 'default', pointerEvents: 'none' })
                    .off('click');
            }

            // === APPROVAL STAMP ===
            if (approvedName && approvedDate && approvedDate !== '-') {
                const approvalStampHtml = `
                    <div class="flex w-[70px] h-[70px] py-[15px] flex-col items-center gap-[9px] bg-no-repeat bg-center bg-contain select-none pointer-events-none"
                         style="background-image: url('@Url.Content("~/images/stamp.svg")'); background-size: cover;">
                        <p class="text-[10px] font-bold text-red-500 leading-[10px] text-center">${approvedName.split(' ')[0]}</p>
                        <p class="text-[10px] font-normal text-red-500 leading-[10px] text-center">${approvedDate}</p>
                    </div>`;
                $approvalBtn.html(approvalStampHtml)
                    .prop('disabled', true)
                    .css({ cursor: 'default', pointerEvents: 'none' })
                    .off('click');
            }
        },
        error: function () {
            console.error('Gagal ambil data stamp untuk', requestNo);
        }
    });
}

