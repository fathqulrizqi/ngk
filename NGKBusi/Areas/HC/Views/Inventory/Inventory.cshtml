$(document).on('click', '.btn-edit', function () {
    clearModal();
    $('#formModal').data('mode', 'edit');

    const cartId = $(this).data('id');
    const itemId = $(this).data('itemid');
    const qty = $(this).data('qty');
    const budgetNo = $(this).data('budgetno');
    const note = $(this).data('note');
    const budgetDesc = $(this).data('budgetdesc');
    const sectionToName = $(this).data('sectiontoname');
    const itemName = $(this).data('item');

    $('#modalCartId').val(cartId);
    $('#modalItemId').val(itemId);
    $('#qty').val(parseInt(qty)).prop('disabled', false);
    $('#note').val(note).prop('disabled', false);
    $('#itemName').text(itemName);
    $('#submitCart').prop('disabled', false);
    $('#formModal').removeClass('hidden');

    if (budgetNo === 'UNB') {
        // 1. Set dropdown budget ke UNB
        $('#budgetNumber').val('UNB').trigger('change');

        // 2. Load data Cost Center terlebih dahulu, baru lakukan mapping teks
        loadUnbCostCenter(function() {
            $('#unbCostCenter option').each(function () {
                const optionText = $(this).text().trim();
                // Bandingkan teks option dengan data sectionToName dari tabel
                if (optionText === sectionToName.trim()) {
                    $('#unbCostCenter').val($(this).val()).trigger('change');
                    return false;
                }
            });
        });
    } else {
        // Logika budget normal (non-UNB)
        const optionValue = `${budgetNo} | ${sectionToName} | ${budgetDesc}`;
        $('#budgetNumber option').each(function () {
            if ($(this).text().trim() === optionValue.trim()) {
                $(this).prop('selected', true);
                return false;
            }
        });
        $('#budgetNumber').trigger('change');
        $('#unbCostWrapper').addClass('hidden');
    }

    $('#budgetNumber').prop('disabled', false);
    // Inisialisasi ulang Select2
    $('#budgetNumber, #unbCostCenter').select2({ placeholder: "-- Select budget number --", allowClear: true, width: '100%' });

    // Ajax ambil detail item (tetap sama)
    $.ajax({
        url: '@Url.Action("GetItemById", "Inventory", new { area = "HC" })',
        type: 'GET',
        data: { id: itemId },
        success: function (item) {
            if (item) {
                $('#qtyStock').text(`${item.Qty} ${item.Unit}`);
                const imageUrl = item.Image ? (item.Image.startsWith('http') ? item.Image : baseImagePath + item.Image) : 'https://via.placeholder.com/150';
                $('.itemimage').css({ 'background-image': `url(${imageUrl})`, 'background-size': 'cover', 'background-position': 'center' });
                $('#MapItem').html(renderEditingItemThumbnail(item));
                $('.modal-right-section').removeClass('hidden');
            }
        }
    });
});

$('#budgetNumber').on('change', function () {
    const selected = $(this).val();

    if ((deptname === 'GENERAL AFFAIR' || divisionName === 'SALES & MARKETING' || divisionName === 'PRODUCTION') && selected === 'UNB') {
        loadUnbCostCenter();
    } else {
        $('#unbCostWrapper').addClass('hidden');
        $('#unbCostCenter').empty()
            .append('<option value="" selected disabled>Select section to name</option>');
    }
});

function loadUnbCostCenter(callback) {
    $.ajax({
        url: '@Url.Action("GetUnbCostCenters", "Inventory", new { area = "HC" })',
        type: 'GET',
        success: function (res) {
            const $select = $('#unbCostCenter');
            $select.empty().append('<option value="" selected disabled>Select section to name</option>');

            res.forEach(item => {
                $select.append(`<option value="${item.AXCostID}">${item.AXCostName}</option>`);
            });

            $('#unbCostWrapper').removeClass('hidden');
            $select.trigger('change.select2');

            // Jalankan callback jika ada (untuk proses mapping edit)
            if (typeof callback === "function") {
                callback();
            }
        }
    });
}
