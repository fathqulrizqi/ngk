            $(document).on('click', '#preparebtn, #checkbtn, #approvalbtn', function (e) {
                e.stopPropagation();
                e.preventDefault();
                const $btn = $(this);
                const $span = $btn.find('span');
                const requestNo = $btn.data('requestno');

                let action, confirmText, confirmTitle;
                const originalSpanContent = $span.html();

                // PREPARE
                if (this.id === 'preparebtn') {
                    action = 'prepare';
                    confirmTitle = 'Confirm Prepare?';
                    confirmText = 'Are you sure you want to mark this request as prepared?';

                    Swal.fire({
                        title: confirmTitle,
                        text: confirmText,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, Prepare'
                    }).then(result => {
                        if (result.isConfirmed) {
                            processAction(action, requestNo, $btn, $span, originalSpanContent, null, null);
                        }
                    });

                    return;
                }

                // CHECK / APPROVE
                if (this.id === 'checkbtn') {
                    action = 'check';
                    confirmTitle = 'Check This Request?';
                } else {
                    action = 'approve';
                    confirmTitle = 'Approve This Request?';
                }

                Swal.fire({
                    title: confirmTitle,
                    text: 'Choose what you want to do',
                    icon: 'question',
                    showCancelButton: true,
                    showDenyButton: true,
                    confirmButtonText: action === 'check' ? 'Sign' : 'Sign',
                    denyButtonText: 'Return',
                    cancelButtonText: 'Reject',

                    confirmButtonColor: '#3085d6',
                    denyButtonColor: '#f59e0b',
                    cancelButtonColor: '#d33',
                }).then(result => {

                    // ===============================
                    // CONFIRM (check / approve)
                    // ===============================
                    if (result.isConfirmed) {
                        processAction(action, requestNo, $btn, $span, originalSpanContent, null, null);
                    }

                    // ===============================
                    // RETURN (with input)
                    // ===============================
                    else if (result.isDenied) {
                        Swal.fire({
                            title: "Return Request",
                            input: "text",
                            inputPlaceholder: "Reason for returning...",
                            showCancelButton: true,
                            confirmButtonText: "Submit",
                        }).then(ret => {
                            if (ret.isConfirmed && ret.value) {
                                processAction("return", requestNo, $btn, $span, originalSpanContent, ret.value, null);
                            }
                        });
                    }

                    // ===============================
                    // REJECT (with input)
                    // ===============================
                    else if (result.dismiss === Swal.DismissReason.cancel) {

                        Swal.fire({
                            title: "Reject Request",
                            input: "text",
                            inputPlaceholder: "Reason for rejection...",
                            showCancelButton: true,
                            confirmButtonText: "Submit",
                        }).then(rej => {
                            if (rej.isConfirmed && rej.value) {

                                // FE menentukan siapa yang reject
                                const newStatus =
                                    action === "check"
                                        ? "Rejected by Checker"
                                        : "Rejected by Approver";

                                processAction(
                                    "reject",
                                    requestNo,
                                    $btn,
                                    $span,
                                    originalSpanContent,
                                    rej.value,
                                    newStatus
                                );
                            }
                        });
                    }
                });
            });

            function processAction(action, requestNo, $btn, $span, originalSpanContent, reason, newStatus) {

                $btn.prop('disabled', true).addClass('cursor-not-allowed');
                $span.html('<div class="spinner-border spinner-border-sm" role="status"></div>');

                $.ajax({
                    url: '@Url.Action("SaveStampStatus", "Inventory", new { area = "HC" })',
                    type: 'POST',
                    data: {
                        Request_No: requestNo,
                        Action: action,
                        Reason: reason || null,
                        NewStatus: newStatus || null,
                        User_NIK: usernik,
                        User_Name: username
                    },
                    success: res => {
                        if (res.success) {
                            Swal.fire('Success', res.message, 'success')
                                .then(() => location.reload());
                        } else {
                            Swal.fire('Error', res.message, 'error')
                                .then(() => location.reload());
                        }
                    },
                    error: () => {
                        Swal.fire('Error', 'Something went wrong.', 'error')
                            .then(() => location.reload());
                    }
                }).always(() => {
                    $btn.prop('disabled', false).removeClass('cursor-not-allowed');
                    $span.html(originalSpanContent);
                });
            }


function getStamp(requestNo, $child) {
    $.ajax({
        url: '@Url.Action("GetStampStatus", "Inventory", new { area = "HC" })',
        type: 'GET',
        data: { requestNo: requestNo },
        success: function (response) {
            if (!response) return;

            const preparedName = response.PrepareBy;
            const preparedDate = response.PrepareDate
                ? moment(parseInt(response.PrepareDate.replace(/[^\d]/g, ''))).format('DD-MM-YYYY')
                : '-';

            // Mengambil data untuk "Checked By"
            const checkedName = response.CheckedBy;
            const checkedDate = response.CheckedDate
                ? moment(parseInt(response.CheckedDate.replace(/[^\d]/g, ''))).format('DD-MM-YYYY')
                : '-';

            const approvedName = response.ApproveBy;
            const approvedDate = response.ApproveDate
                ? moment(parseInt(response.ApproveDate.replace(/[^\d]/g, ''))).format('DD-MM-YYYY')
                : '-';

            const $prepareBtn = $child.find('#preparebtn');
            const $checkBtn = $child.find('#checkbtn'); // Target tombol check
            const $approvalBtn = $child.find('#approvalbtn');

            // Logika untuk tombol Prepare
            if (preparedName && preparedDate) {
                const stampHtml = `
                    <div class="flex w-[70px] h-[70px] py-[15px] flex-col items-center gap-[9px] bg-no-repeat bg-center bg-contain select-none pointer-events-none"
                         style="background-image: url('@Url.Content("~/images/stamp.svg")'); background-size: cover;">
                        <p class="text-[10px] font-bold text-red-500 leading-[10px] text-center">${preparedName.split(' ')[0]}</p>
                        <p class="text-[10px] font-normal text-red-500 leading-[10px] text-center">${preparedDate}</p>
                    </div>`;
                $prepareBtn.html(stampHtml).prop('disabled', true).css({ cursor: 'default', pointerEvents: 'none' }).off('click');
                $child.find('#longnameprepared').text(`${preparedName}`).removeClass('hidden');

                // Aktifkan tombol check jika sudah diprepare
                $checkBtn.prop('disabled', false);
            } else {
                // Jika belum diprepare, pastikan tombol check dan approve tetap disabled
                $checkBtn.prop('disabled', true);
                $approvalBtn.prop('disabled', true);
            }

            // Logika untuk tombol Check
            if (checkedName && checkedDate) {
                const stampHtml = `
                    <div class="flex w-[70px] h-[70px] py-[15px] flex-col items-center gap-[9px] bg-no-repeat bg-center bg-contain select-none pointer-events-none"
                         style="background-image: url('@Url.Content("~/images/stamp.svg")'); background-size: cover;">
                        <p class="text-[10px] font-bold text-red-500 leading-[10px] text-center">${checkedName.split(' ')[0]}</p>
                        <p class="text-[10px] font-normal text-red-500 leading-[10px] text-center">${checkedDate}</p>
                    </div>`;
                $checkBtn.html(stampHtml).prop('disabled', true).css({ cursor: 'default', pointerEvents: 'none' }).off('click');

                // Aktifkan tombol approval jika sudah dicek
                $approvalBtn.prop('disabled', false);
            } else {
                // Jika belum dicek, pastikan approval button tetap disabled
                $approvalBtn.prop('disabled', true);
            }

            // Logika untuk tombol Approve
            if (approvedName && approvedDate) {
                const stampHtml = `
                    <div class="flex w-[70px] h-[70px] py-[15px] flex-col items-center gap-[9px] bg-no-repeat bg-center bg-contain select-none pointer-events-none"
                         style="background-image: url('@Url.Content("~/images/stamp.svg")'); background-size: cover;">
                        <p class="text-[10px] font-bold text-red-500 leading-[10px] text-center">${approvedName.split(' ')[0]}</p>
                        <p class="text-[10px] font-normal text-red-500 leading-[10px] text-center">${approvedDate}</p>
                    </div>`;
                $approvalBtn.html(stampHtml).prop('disabled', true).css({ cursor: 'default', pointerEvents: 'none' }).off('click');
            }
        },
        error: function () {
            console.error('Gagal ambil data stamp untuk', requestNo);
        }
    });
            }
        });

