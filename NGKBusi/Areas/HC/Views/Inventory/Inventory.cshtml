                                $('#formModal').addClass('hidden');
                                cartTable.ajax.reload();
                                clearModal();
                                filterAndRenderItems('');
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        },
                        error: () => Swal.fire('Error', 'An error occurred while updating the data.', 'error')
                    });
                } else {
                    let existingItemInCart = null;
                    let existingCartId = null;
                    let existingQty = 0;
                    cartTable.rows().every(function () {
                        const rowData = this.data();

                        const isSameItem = rowData.Item_Id == itemId;
                        const isSameBudget = rowData.Budget_No == budgetNo;

                        if (budgetNo === 'UNB') {
                            if (isSameItem && isSameBudget && rowData.Section_To_Name === sectionToName) {
                                existingItemInCart = rowData;
                                existingCartId = rowData.ID;
                                existingQty = parseInt(rowData.Qty_Request);
                                return false;
                            }
                        }
                        else {
                            if (isSameItem && isSameBudget) {
                                existingItemInCart = rowData;
                                existingCartId = rowData.ID;
                                existingQty = parseInt(rowData.Qty_Request);
                                return false;
                            }
                        }
                    });

                    if (existingItemInCart) {
