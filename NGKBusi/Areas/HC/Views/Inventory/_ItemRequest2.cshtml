        $(document).on('click', '.btn-cancel-inline', function () {
            const $tr = $(this).closest('tr').closest('table').closest('tr').prev();
            $tr.find('td.dt-control').trigger('click');
            $tr.find('td.dt-control').trigger('click');
        });

        $(document).on('click', '.btn-save-inline', function () {
            const $btn = $(this);
            const $tr = $btn.closest('tr');
            const id = $tr.data('cartid');
            const itemId = $tr.find('.edit-item-select').val();
            const qtyReq = $tr.find('.edit-qty-input').val();

            const $budgetSelect = $tr.find('.edit-budget-select');
            const budgetNo = $budgetSelect.val() || '';
            const selectedText = $budgetSelect.find('option:selected').text() || '';
            const budgetParts = selectedText.split('|').map(p => p.trim());
            const budgetDesc = budgetParts.length > 1 ? budgetParts.slice(1).join(' | ').trim() : '';
            const params = new URLSearchParams();
            params.append("Item_Id", itemId);
            params.append("Qty_Acc", qtyReq);
            params.append("Budget_No", budgetNo);
            params.append("Budget_Desc", budgetDesc);

            $.ajax({
                url: `@Url.Action("UpdateItemDetail", "Inventory", new { area = "HC" })/${id}`,
                type: 'POST',
                data: params.toString(),
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Saved',
                            text: res.message,
                            timer: 1000,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                        const $mainTr = $tr.closest('div.overflow-x-auto').closest('td').closest('tr').prev();
                        $mainTr.find('td.dt-control').trigger('click');
                        $mainTr.find('td.dt-control').trigger('click');
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Server connection failed', 'error');
                }
            });
        });

