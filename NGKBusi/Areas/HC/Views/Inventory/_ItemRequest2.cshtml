@{
    ViewBag.Title = "Stationery Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section cssHead {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.tailwindcss.css" />
    <link href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/tippy.js@6.3.7/dist/tippy.css" />
    <link href="~/Content/bootstrap/css/bootstrap5.3.3/bootstrap.min.css" rel="stylesheet" />

    <style>
        div.dt-length label {
            margin-left: 0.5rem;
        }

     /*   #itemRequest tbody tr {
            cursor: pointer;
        }*/


        input[aria-controls="itemRequest"],
        select[aria-controls="itemRequest"],
        #dt-search-0,
        #dt-length-0 {
            background-color: #ffffff !important;
            color: #1f2937 !important;
            margin-bottom: 5px;
            border: 1px solid #DEE2E6 !important;
            border-radius: 0.5rem !important;
            padding: 0.4rem 0.8rem !important;
            transition: all 0.2s ease;
        }

        .page-content {
            background: linear-gradient(135deg, #1E555C 10%, #fefee3 100%);
            padding-top: 1rem !important;
        }

        #itemRequest thead th {
            background-color: #F6F7F8 !important;
            border-bottom: 2px solid #F6F7F8 !important;
            color: black !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
        }

        #itemRequest .dataTables_empty {
            padding: 2rem !important;
            color: #9ca3af !important;
            font-style: italic;
            background-color: transparent !important;
        }

        #itemRequest {
            border-collapse: collapse !important;
            border: none !important;
        }

            #itemRequest tbody td {
                border-bottom: 1px solid #f3f4f6 !important;
                background-color: transparent !important;
                padding: 12px 8px !important;
            }

        .select2-container--default .select2-selection--single {
            border-color: #DEE2E6 !important;
            height: auto !important;
        }

        .select2-container--default .select2-selection--multiple {
            min-height: 2rem;
            border-color: #DEE2E6 !important;
            padding: 0.25rem;
            width: auto !important;
            display: inline-block;
        }

        .select2-selection__rendered {
            word-wrap: break-word !important;
            text-overflow: inherit !important;
            white-space: normal !important;
        }

        table.dataTable td,
        table.dataTable th {
            padding: 0.5rem 0.5rem !important;
        }

        .hidden {
            display: none !important;
        }

        #itemRequest tbody tr:nth-child(even),
        tr.even {
            background-color: #F9FAFB !important;
        }
    </style>
}

@section scriptHead {
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="~/Content/bootstrap/js/bootstrap5.3.3/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.tailwindcss.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
}

<div class="d-flex align-items-center rounded" style="color: #2C3E50;">
    <span style="color: #F6AA04; font-weight: bold; font-size: 20px; margin: 20px;">|</span>
    <h2 style="font-weight: bold; margin: 0; font-size: 25px" class="text-gray-50">
        Item Request
    </h2>
</div>

<div class="flex flex-col md:flex-row gap-2">
    <div class="w-full bg-white p-6 rounded-xl shadow-lg h-fit">
        <div class="d-flex mb-3">
            <button id="processSelectedBtn" class="btn btn-primary mr-2" style="display: none;">
                Process Selected
            </button>
            <button id="mergeNewInvoiceBtn" class="btn text-white bg-purple-500 hover:bg-purple-800 mr-2" style="display: none;">
                Merge New Invoice
            </button>
            <button id="summaryBtn" class="btn btn-success mr-2 " style="display: none;">
                Download Excel
            </button>
            <button id="printSelectedBtn" class="btn text-white bg-red-500 hover:bg-red-800" style="display: none;">
                Print Selected
            </button>
        </div>
        <div class="overflow-x-auto p-2">
            <table id="itemRequest" class="hover min-w-full text-sm text-left text-gray-500 text-gray-800">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50">
                    <tr>
                        <th scope="col" class="py-2 px-3" style="width: 20px;"><input class="w-5 h-5" type="checkbox" id="selectAllCheckbox"></th>
                        <th scope="col" class="py-2 px-3" style="width: 20px;"></th>
                        <th scope="col" class="py-2 px-3">Date</th>
                        <th scope="col" class="py-2 px-3">Request No</th>
                        <th scope="col" class="py-2 px-3">Invoice Number</th>
                        <th scope="col" class="py-2 px-3">Receive Number</th>
                        <th scope="col" class="py-2 px-3">Subject</th>
                        <th scope="col" class="py-2 px-3">Requestor</th>
                        <th scope="col" class="py-2 px-3">Dept</th>
                        <th scope="col" class="py-2 px-3">Section To</th>
                        <th scope="col" class="py-2 px-3">Status</th>
                    </tr>

                    <tr class="search-row">
                        <th></th>
                        <th></th>
                        <th><input data-column="2" class="w-full p-2 border rounded" placeholder="Search Date" /></th>
                        <th><input data-column="3" class="w-full p-2 border rounded" placeholder="Search Req No" /></th>
                        <th><input data-column="4" class="w-full p-2 border rounded" placeholder="Search Invoice" /></th>
                        <th><input data-column="5" class="w-full p-2 border rounded" placeholder="Search Receive" /></th>

                        <th>
                            <select data-column="6" class="w-full text-gray-500 p-2 border rounded subject-filter">
                                <option value="">-- All Subjects --</option>
                                <option class="text-black" value="Stationery">Stationery</option>
                                <option class="text-black" value="Refreshment">Refreshment</option>
                            </select>
                        </th>

                        <th><input data-column="7" class="w-full p-2 border rounded" placeholder="Search Requestor" /></th>
                        <th><input data-column="8" class="w-full p-2 border rounded" placeholder="Search Dept" /></th>
                        <th><input data-column="9" class="w-full p-2 border rounded" placeholder="Search Section" /></th>

                        <th>
                            <select data-column="10" class="w-full text-gray-500 p-2 border rounded">
                                <option class="text-gray-600" value="">-- Status --</option>
                                <option class="text-black" value="Waiting for Check">Waiting for Check</option>
                                <option class="text-black" value="Waiting for Approval">Waiting for Approval</option>
                                <option class="text-black" value="Pending">Pending</option>
                                <option class="text-black" value="Pending from Dept">Pending from Dept</option>
                                <option class="text-black" value="Ready to Pick">Ready to Pick</option>
                                <option class="text-black" value="Complete">Complete</option>
                                <option class="text-black" value="E-Voucher Issued">E-Voucher Issued</option>
                                <option class="text-black" value="E-Voucher Stamped">E-Voucher Stamped</option>
                            </select>
                        </th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="bulkActionModal" tabindex="-1" aria-labelledby="bulkActionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulkActionModalLabel">Bulk Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modalContent">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="confirmBulkActionBtn">Confirm Action</button>
            </div>
        </div>
    </div>
</div>

<div id="modalPriceLogs" class="fixed inset-0 bg-gray-900 bg-opacity-50 hidden flex items-center justify-center z-50 no-print">
    <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full p-6 relative animate-fade-in mx-4">
        <button type="button" class="btn-close-log-modal absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg">
            <i class="fas fa-times"></i>
        </button>

        <h3 class="text-lg font-bold text-gray-800 mb-1 flex items-center gap-2">
            <i class="fas fa-history text-blue-600"></i> Price Change History
        </h3>
        <p id="logModalItemName" class="text-xs text-gray-500 font-medium mb-4"></p>

        <div class="overflow-x-auto max-h-[350px] border border-gray-200 rounded-lg">
            <table class="w-full text-sm text-left text-gray-500 tbl-price-logs">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                    <tr>
                        <th class="px-4 py-3 text-center">No</th>
                        <th class="px-4 py-3 text-right">Item Name</th>
                        <th class="px-4 py-3 text-right">Old Price</th>
                        <th class="px-4 py-3">New Price</th>
                        <th class="px-4 py-3">Date</th>
