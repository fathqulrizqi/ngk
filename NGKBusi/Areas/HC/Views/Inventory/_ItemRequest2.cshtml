                    `);


                    const currentBudget = ($tr.data('budgetno') || '').split(' | ')[0].trim();
                    const $budgetCell = $tr.find('td').eq(5);
                    let budgetSelectHtml = `<select class="edit-budget-select border rounded p-1 w-full text-xs text-black" style="width:100%">`;
                    budgetSelectHtml += `<option value="">-- Select Budget --</option>`;
                    budgetSelectHtml += `<option value="UNB">UNB</option>`;
                    (Budget || []).forEach(b => {
                        const selected = currentBudget === b.Budget_No ? 'selected' : '';
                        budgetSelectHtml += `<option value="${b.Budget_No}" ${selected}>${b.Budget_No} | ${b.Description || ''} | ${b.Section_To_Name || ''}</option>`;
                    });
                    budgetSelectHtml += `</select>`;
                    $budgetCell.html(budgetSelectHtml);
                    setTimeout(() => {
                        const $sel = $budgetCell.find('.edit-budget-select');
                        $sel.select2({
                            placeholder: '-- Select Budget --',
                            allowClear: true,
                            width: '100%',
