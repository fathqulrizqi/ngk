                text: `You are about to mark Request ${requestNo} as '${newStatus}'. This action will complete the request. Do you want to continue?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, proceed',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    const itemsToUpdate = [{
                        Request_No: requestNo,
                        Status: newStatus,
                        User_NIK_Handover: '@ViewBag.UserNIK',
                        User_NIK_Handover_Name: '@ViewBag.UserName',
                    }];

                    $.ajax({
                        url: '@Url.Action("UpdateRequestStatusOnly", "Inventory", new { area = "HC" })',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(itemsToUpdate),
                        success: function (res) {
                            Swal.fire({
                                title: res.success ? 'Success' : 'Error',
                                text: res.message,
                                icon: res.success ? 'success' : 'error',
                                confirmButtonText: 'OK'
                            }).then(() => {
                                if (res.success) location.reload();
                            });
                        },
                        error: function () {
                            Swal.fire('Error', 'An error occurred.', 'error');
                        }
                    });
                }
            });
        });

    });

$('#printSelectedBtn').off('click').on('click', function () {
    if (selectedRows.length === 0) {
        Swal.fire('No Selection', 'Please select at least one request to print.', 'info');
        return;
    }

    const requestNos = selectedRows.map(r => r.Request_No).join(',');

    const url = `${previewRequestUrl}?requestNos=${encodeURIComponent(requestNos)}`;

    window.open(url, '_blank');
});

    $('#mergeNewInvoiceBtn').on('click', function () {
            if (selectedRows.length === 0) {
                Swal.fire('No Selection', 'Please select at least one request to merge.', 'info');
                return;
            }

            const invalidRows = selectedRows.filter(r => r.Status === 'Pending' || r.Status === 'Rejected');
            if (invalidRows.length > 0) {
                Swal.fire('Invalid Status', 'You cannot merge invoices for Pending or Rejected requests.', 'warning');
                return;
            }

            const requestNos = selectedRows.map(row => row.Request_No);

            Swal.fire({
                title: 'Merge into New Invoice?',
                text: `You are about to merge ${requestNos.length} selected request(s) into ONE new invoice number. Do you want to continue?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#8b5cf6',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Yes, merge it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {

                    Swal.fire({
                        title: 'Generating Invoice...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '@Url.Action("GenerateMergeInvoiceNumber", "Inventory", new { area = "HC" })',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ requestNos: requestNos }),
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Merge Successful!',
                                    html: `Successfully generated new invoice: <br><strong class="text-xl text-purple-600 mt-2 inline-block">${res.invoiceNumber}</strong>`,
                                    icon: 'success',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    table.ajax.reload(null, false);
                                    selectedRows = [];
                                    updateSelectedRowsState();
                                    $('#selectAllCheckbox').prop('checked', false);
                                });
                            } else {
                                Swal.fire('Merge Failed', res.message || 'An error occurred while generating the invoice.', 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error(error);
                            Swal.fire('Error', 'Server connection failed. Could not merge invoices.', 'error');
                        }
                    });
                }
            });
        });
</script>