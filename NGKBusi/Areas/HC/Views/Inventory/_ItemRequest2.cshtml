                <tbody class="divide-y divide-gray-100">
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/Scripts/moment.min.js"></script>
<script>
    window._invoiceParams = {};
    let selectedRows = [];
    const currUser = {
        name: '@ViewBag.UserName'.split(' ')[0],
        nik: '@ViewBag.UserNIK',
        username: '@ViewBag.username',
        today: '@ViewBag.Now'
    };
    var rawBudget = @Html.Raw(Json.Encode(ViewBag.Budget ?? new object[0]));
    const Budget = Array.isArray(rawBudget) ? rawBudget : [];
    console.log("BUDGET", Budget)

    const previewInvoiceUrl = "@Url.Action("PreviewInvoice", "Inventory", new { area = "HC" })";
    const previewRequestUrl = "@Url.Action("PreviewRequest", "Inventory", new { area = "HC" })";
    const previewPOUrl = "@Url.Action("NonPO", "PaymentRequest", new { area = "FA" })";

    function updateSelectedRowsState() {
        const hasSelection = selectedRows.length > 0;
        $('#processSelectedBtn, #summaryBtn').toggle(hasSelection);
        $('#printSelectedBtn, #summaryBtn').toggle(hasSelection);
        $('#mergeNewInvoiceBtn, #summaryBtn').toggle(hasSelection);
        const allChecked = selectedRows.length > 0 && selectedRows.length === $('#itemRequest tbody .row-checkbox:checked').length;
        $('#selectAllCheckbox').prop('checked', allChecked);
    }

    $(document).ready(function () {

        const table = $('#itemRequest').DataTable({
            orderCellsTop: true,
            order: [[2, 'desc']],
            responsive: true,
            autoWidth: true,
            fixedHeader: true,
            ajax: {
                url: '@Url.Action("GetAllHistory", "Inventory", new { area = "HC" })',
                type: 'GET',
                dataSrc: ''
            },
            columns: [
                {
                    data: null,
                    orderable: false,
                    className: 'text-center',
                    width: '20px',
                    render: function (data, type, row) {
                        return `<input type="checkbox" class="row-checkbox w-5 h-5" data-request-no="${row.Request_No}">`;
                    }
                },
                {
                    className: 'dt-control',
                    orderable: false,
                    data: null,
                    width: '20px',
                    defaultContent: '',
                },
                {
                    data: 'Approved_Date',
                    width: '120px',
                    title: 'Date',
                    render: {
                        display: function (data) {
                            return data ? moment(data).format('DD MMM YYYY') : '-';
                        },
                        filter: function (data) {
                            return data ? moment(data).format('DD MMMM YYYY') : '';
                        }
                    }
                },
                {
                    data: 'Request_No',
                    title: 'Request No',
                    render: function (data, type, row) {
                        if (!data) return '-';

                        // Pengecekan status ditambah E-Voucher Issued
                        if (row.Status === 'Complete' || row.Status === 'E-Voucher Issued' || row.Status === 'Upload File' || row.Status === 'Generated') {
                            const url = `${previewRequestUrl}?requestNos=${encodeURIComponent(data)}`;
                            return `
                <a href="${url}" target="_blank" class="text-blue-600 font-semibold underline hover:opacity-80">
                    ${data}
                </a>
            `;
                        }
                        return `<span class="text-gray-700 font-semibold">${data}</span>`;
                    }
                },
                {
                    data: 'Invoice_Number',
                    title: 'Invoice Number',
                    render: function (data, type, row) {
                        if (!data) return '-';

                        // Pengecekan status ditambah E-Voucher Issued
                        if (row.Status === 'Complete' || row.Status === 'E-Voucher Issued' || row.Status === 'Upload File' || row.Status === 'Generated') {
                            const url = `${previewInvoiceUrl}?invoiceNo=${encodeURIComponent(data)}`;
                            return `
                <a href="${url}" target="_blank" class="text-blue-600 font-semibold underline hover:opacity-80">
                    ${data}
                </a>
            `;
                        }
                        return `<span class="text-gray-700 font-semibold">${data}</span>`;
                    }
                },
                {
                    data: 'Receive_Number',
                    title: 'Receive Number',
                    render: data => data ? `<span class="text-green-600 font-semibold">${data}</span>` : '-'
                },
                {
                    data: 'Subject',
                    title: 'Subject',
                    render: data => data || '-'
                },
                {
                    data: 'User_Name',
                    title: 'Requestor',
                    render: data => data || '-'
                },
                {
                    data: 'Dept_Request',
                    title: 'Dept',
                    render: data => data || '-'
                },
                {
                    data: 'Cart_Nos',
                    title: 'Section To',
                    render: function (data, type, row) {
                        if (data && data.length > 0 && data[0].Section_To_Name) {
                            return data[0].Section_To_Name;
                        }
                        return '-';
                    }
                },
                {
                    data: 'Status',
                    title: 'Status',
                    render: function (data, type, row) {
                        if (!data) return '-';

                        let displayText = data;

                        if (data === 'Pending') {
                            displayText = 'Pending from Dept';
                        }

                        if (data === 'Approved' || data === 'Order Complete') {
                            displayText = 'Pending';
                        }


                        if (data === 'Generated') {
                            displayText = 'Complete';
                        }
                        if (data === 'Complete' && row.Receive_Number) {
                            displayText = 'E-Voucher Issued';
                        }
                        if (data === 'Upload File') {
                            displayText = 'E-Voucher Stamped';
                        }
                        let extraInfo = '';

                        if (data === 'Ready to Pick' && row.Cart_Nos) {
                            const total = row.Cart_Nos.length;
                            const isItemReady = (val) => String(val).toLowerCase() === 'true' || val === 1;

                            const readyToPick = row.Cart_Nos.filter(x =>
                                isItemReady(x.isReady) &&
                                (x.Pick_Date == null || x.Pick_Date === "")
                            ).length;

                            const pickedUp = row.Cart_Nos.filter(x =>
                                isItemReady(x.isReady) &&
                                x.Pick_Date != null &&
                                x.Pick_Date !== ""
                            ).length;

                            extraInfo = `
                             <div class="text-xs mt-1">
                                 <span class="text-orange-700 font-semibold">Ready: ${readyToPick}/${total}</span> |
                                 <span class="text-green-700 font-semibold">Picked: ${pickedUp}/${total}</span>
                             </div>
                             `;
                        }

                        const statusColors = {
                            'On Order': 'bg-yellow-300 text-yellow-900',
                            'Rejected': 'bg-red-400 text-white',
                            'On Prepare': 'bg-blue-400 text-white',
                            'Pending': 'bg-yellow-500 text-white',
                            'Ready to Pick': 'bg-orange-400 text-white',
                            'E-Voucher Stamped': 'bg-red-400 text-white',
                            'Complete': 'bg-green-500 text-white',
                            'Approved': 'bg-purple-500 text-white',
                            'E-Voucher Issued': 'bg-teal-500 text-white',
                            'Pending from Dept': 'bg-gray-500 text-white'
                        };

                        const colorClass = statusColors[displayText] || 'bg-gray-200 text-gray-800';

                        return `
                             <span class="px-2 py-1 text-sm rounded ${colorClass}">
                                 ${displayText}
                             </span>
                             ${extraInfo}
                         `;
                    }
                }
            ],
            initComplete: function () {
                const api = this.api();

                $('#itemRequest thead tr.search-row input').on('keyup change', function () {
                    const colIndex = $(this).data('column');
                    api.column(colIndex).search(this.value).draw();
                });

                $('#itemRequest thead tr.search-row select').on('change', function () {
                    const colIndex = $(this).data('column');
                    api.column(colIndex).search(this.value).draw();
                });

                $('#itemRequest thead tr.search-row th').off('click');
            }
        });

        $('#selectAllCheckbox').on('click', function () {
            const isChecked = this.checked;
            $('.row-checkbox').prop('checked', isChecked);
            selectedRows = [];
            if (isChecked) {
                table.rows({ page: 'current' }).data().each(function (row) {
                    selectedRows.push(row);
                });
            }
            updateSelectedRowsState();
        });

        $('#itemRequest tbody').on('click', '.row-checkbox', function (e) {
            e.stopPropagation();
        });

        $('#itemRequest tbody').on('change', '.row-checkbox', function (e) {
            e.stopPropagation();
            const rowData = table.row($(this).closest('tr')).data();
            const isChecked = this.checked;
            if (isChecked) {
                if (!selectedRows.some(row => row.Request_No === rowData.Request_No)) {
                    selectedRows.push(rowData);
                }
            } else {
                selectedRows = selectedRows.filter(row => row.Request_No !== rowData.Request_No);
            }
            updateSelectedRowsState();
        });

        $('#summaryBtn').on('click', function () {
            if (selectedRows.length === 0) {
                Swal.fire('No Selection', 'Please select at least one row.', 'info');
                return;
            }
            const completeRows = selectedRows.filter(r => r.Status === 'Complete');

            if (completeRows.length === 0) {
                Swal.fire('No Complete Rows', 'Please select at least one row with status "Complete".', 'warning');
                return;
            }
            if (completeRows.length !== selectedRows.length) {
                Swal.fire('Invalid Selection', 'Only rows with status "Complete" can be included in the summary.', 'warning');
                return;
            }

            const requestNos = completeRows.map(r => r.Request_No).join(',');
            const url = '@Url.Action("DownloadItemSummary", "Inventory", new { area = "HC" })' + '?ids=' + encodeURIComponent(requestNos);
            window.open(url, '_blank');
        });

        $('select[data-column]').on('change', function () {
            let colIdx = $(this).attr('data-column');
            let val = $.fn.dataTable.util.escapeRegex($(this).val());
            table.column(colIdx).search(val ? '^' + val + '$' : '', true, false).draw();
        });

        // ==========================================
        // MAIN BULK PROCESS BTN
        // ==========================================
        $('#processSelectedBtn').on('click', function () {
            if (selectedRows.length === 0) {
                Swal.fire('No Selection', 'Please select at least one row.', 'info');
                return;
            }

            const groupedByStatus = selectedRows.reduce((acc, row) => {
                const status = row.Status;
                if (!acc[status]) {
                    acc[status] = [];
                }
                acc[status].push(row);
                return acc;
            }, {});

            if (Object.keys(groupedByStatus).length > 1) {
                Swal.fire('Multiple Statuses', 'Please filter your table and select only rows with the same status to perform a bulk action.', 'warning');
                return;
            }

            const statusToProcess = Object.keys(groupedByStatus)[0];
            const rowsToProcess = groupedByStatus[statusToProcess];

            if (statusToProcess === 'Need to Be Order') {
                Swal.fire({
                    title: 'Create Order?',
                    text: 'Would you like to proceed to the Create Order page for these items?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, proceed',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const requestNos = selectedRows.map(row => row.Request_No);
                        const form = $(`<form action="@Url.Action("_CreateOrder", "Inventory", new { area = "HC" })" method="post" style="display:none;" target="_blank"></form>`);
                        requestNos.forEach(reqNo => {
                            form.append(`<input type="hidden" name="requestNos" value="${reqNo}">`);
                        });
                        $('body').append(form);
                        form.submit();
                    }
                });
            } else {
                showBulkModal(rowsToProcess, statusToProcess);
            }
        });

        function showBulkModal(rows, status) {
            const allCartNos = rows.flatMap(r => (r.Cart_Nos || []).map(c => c.Cart_No));
            const requestNoMap = new Map();
            rows.forEach(r => { r.Cart_Nos.forEach(c => requestNoMap.set(c.Cart_No, r.Request_No)); });

            $.ajax({
                url: "@Url.Action("GetCartByCartNos", "Inventory", new { area = "HC" })",
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(allCartNos),
                success: function (res) {
                    res.forEach(i => i.Request_No = requestNoMap.get(i.Cart_No));

                    const stage1 = res.filter(i => i.isReady == 0);
                    const stage2 = res.filter(i => i.isReady == 1 && !i.Pick_Date);
                    const stage3 = res.filter(i => i.isReady == 1 && i.Pick_Date && i.Receive_Number == null);
                    const stage4 = res.filter(i => i.Receive_Number != null);

                    let modalTitle = "";
                    let newStatus = "";
                    let itemsToRender = [];

                    if (stage1.length > 0) {
                        modalTitle = "Confirm Items to Ready to Pick";
                        newStatus = "Ready to Pick";
                        itemsToRender = stage1;
                    } else if (stage2.length > 0) {
                        modalTitle = "Mark as Complete";
                        newStatus = "Complete";
                        itemsToRender = stage2;
                    } else if (stage3.length > 0) {
                        modalTitle = "Generate E-Voucher";
                        newStatus = "Generated";
                        itemsToRender = stage3;
                    } else if (stage4.length > 0) {
                        modalTitle = "E-Voucher Issued Detail";
                        newStatus = "Upload File";
                        itemsToRender = stage4;
                    } else {
                        Swal.fire("Nothing to Process", "No items available for update.", "info");
                        return;
                    }

                    renderBulkTable(itemsToRender, newStatus);
                    $('#bulkActionModalLabel').text(modalTitle);
                    $('#confirmBulkActionBtn').data('new-status', newStatus);
                    $('#bulkActionModal').modal('show');
                },
                error: function () { Swal.fire('Error', 'Failed to load item details.', 'error'); }
            });
        }

        function renderBulkTable(list, status) {
            list.sort((a, b) => a.Request_No.localeCompare(b.Request_No));
            const groups = list.reduce((acc, item) => {
                if (!acc[item.Request_No]) acc[item.Request_No] = [];
                acc[item.Request_No].push(item);
                return acc;
            }, {});

            let html = ``;

            // SUMMARY UNTUK UPLOAD FILE
            if (status === "Upload File") {
