            const currentItemId = $tr.data('itemid');
            const currentQty = $tr.data('qtyacc');
            const cartId = $tr.data('cartid');

            if ($tr.hasClass('is-editing')) return;
            $tr.addClass('is-editing');

            $.ajax({
                url: '@Url.Action("GetItemBySubcategory", "Inventory", new { area = "HC" })',
                type: 'GET',
                data: { subcategoryId: subcategoryId },
                success: function (items) {
                    const $itemCell = $tr.find('td').eq(1);
                    let selectHtml = `<select class="edit-item-select border rounded p-1 w-full text-xs text-black">`;
                    items.forEach(item => {
                        const selected = item.ID == currentItemId ? 'selected' : '';
                        selectHtml += `<option value="${item.ID}" data-price="${item.Price}" ${selected}>${item.Item_Name}</option>`;
                    });
                    selectHtml += `</select>`;

                    $itemCell.html(selectHtml);

                    const $qtyCell = $tr.find('td').eq(2);
