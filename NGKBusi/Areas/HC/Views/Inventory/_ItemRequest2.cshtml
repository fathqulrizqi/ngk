            const newItemId = $select.val();
            const $priceInput = $tr.find('.edit-price-input');
            $priceInput.prop('disabled', true).val('...');

            $.ajax({
                url: '@Url.Action("GetPriceByItemId", "Inventory", new { area = "HC" })',
                type: 'GET',
                data: { itemId: newItemId },
