        $('#confirmBulkActionBtn').off('click').on('click', function () {
            const $btn = $(this);
            const newStatus = $btn.data('new-status');
            const originalText = $btn.html();

            let fileToUpload = null;
            let hasGenerated = false;

            if (newStatus === 'Upload File') {
                const $fileInput = $('#evoucherFileInput');
                if ($fileInput.length > 0) {
                    if ($fileInput[0].files.length === 0) {
                        Swal.fire('Dokumen Wajib!', 'Silakan upload dokumen pendukung karena total transaksi melebihi Rp 5.000.000.', 'warning');
                        return;
                    }
                    fileToUpload = $fileInput[0].files[0];
                }
            }

            const itemsToUpdate = [];
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Loading...');

            $('#modalContent table tbody tr').each(function () {
                const $tr = $(this);
                const requestNo = $tr.data('requestno');
                const cartNo = $tr.data('cartno');
                const itemId = parseInt($tr.data('itemid'));
                const qtyRequest = parseInt($tr.data('qtyrequest')) || 0;
                const invoiceNumber = $tr.data('invoicenumber');

                if ($tr.data('hasgenerated') === true || $tr.data('hasgenerated') === 'true') {
                    hasGenerated = true;
                }

                if (!requestNo || !cartNo || !itemId) return;

                const originalRow = selectedRows.find(r => r.Request_No === requestNo);

                itemsToUpdate.push({
                    Request_No: requestNo,
                    Receive_Number: invoiceNumber,
                    Cart_No: cartNo,
                    Item_Id: itemId,
                    Qty_Request: qtyRequest,
                    Qty_Acc: qtyRequest,
                    Status: newStatus,
                    User_NIK: originalRow?.User_NIK,
                    User_NIK_Acc: '@ViewBag.UserNIK',
                    User_NIK_Acc_Name: '@ViewBag.UserName'
                });
            });

            if (itemsToUpdate.length === 0) {
                Swal.fire('No Data', 'Nothing to update.', 'info');
                $btn.prop('disabled', false).html(originalText);
                return;
            }

            const executeDatabaseUpdate = () => {

                // === STAGE 3: GENERATE E-VOUCHER (HANYA NAVIGASI, TIDAK SAVE KE DB) ===
                if (newStatus === 'Generated') {
                    const uniqueReqs = [...new Set(itemsToUpdate.map(i => i.Request_No))];

                    // 1. Ambil data invoice params dari server (fungsi buatanmu)
                    fetchBulkInvoiceParams(uniqueReqs).then(() => {

                        // 2. Build payload dan Navigate ke Non-PO (fungsi buatanmu)
                        generateBulkVoucherFromStoredData(uniqueReqs);

                        // 3. Tutup modal dan reset tampilan
                        $('#bulkActionModal').modal('hide');
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: 'Membuka halaman Create Non-PO...',
                            timer: 2000,
                            showConfirmButton: false
                        });

                        $btn.prop('disabled', false).html(originalText);
                        table.ajax.reload(null, false); // Reload tabel agar datanya fresh
                        selectedRows = [];
                        updateSelectedRowsState();
                        $('#selectAllCheckbox').prop('checked', false);

                    }).catch((err) => {
                        Swal.fire('Error', 'Gagal mengambil detail invoice dari server.', 'error');
                        $btn.prop('disabled', false).html(originalText);
                    });

                    return; // WAJIB DI-RETURN agar tidak mengeksekusi handleBulkStatusChange (Save DB)
                }
                // =========================================================================

                // === STAGE 1, 2, & 4: UPDATE KE DATABASE ===
                if (newStatus === 'Complete' && hasGenerated) {
                    const uniqueReqs = [...new Set(itemsToUpdate.map(i => i.Request_No))];
                    fetchBulkInvoiceParams(uniqueReqs)
                        .then(() => {
                            handleBulkStatusChange(itemsToUpdate, table, $btn, originalText);
                        })
                        .catch((err) => {
                            Swal.fire('Error', 'Gagal mengambil detail invoice dari server.', 'error');
                            $btn.prop('disabled', false).html(originalText);
                        });
                } else {
                    handleBulkStatusChange(itemsToUpdate, table, $btn, originalText);
                }
            };
            // Kirim File via AJAX sebelum Update Database
            if (newStatus === 'Upload File' && fileToUpload) {
                const invoiceNo = itemsToUpdate[0].Receive_Number;
                const formData = new FormData();
                formData.append("file", fileToUpload);
                formData.append("invoice_no", invoiceNo);

                $.ajax({
                    url: '@Url.Action("ReUploadFile", "Inventory", new { area = "HC" })',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) {
                            executeDatabaseUpdate();
                        } else {
                            Swal.fire('Upload Gagal', res.message, 'error');
                            $btn.prop('disabled', false).html(originalText);
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'Gagal upload file ke server.', 'error');
                        $btn.prop('disabled', false).html(originalText);
                    }
                });
            } else {
                executeDatabaseUpdate();
            }
        });

        // ==========================================
        // 3. SUPPORTING FUNCTIONS
        // ==========================================
        function handleBulkStatusChange(itemsToUpdate, table, $btn, originalText) {
            Swal.fire({
                title: `Confirm Action`,
                text: `You are about to process ${itemsToUpdate.length} item(s). Do you want to continue?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, proceed',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    const bulkData = { Items: itemsToUpdate };

                    $.ajax({
                        url: '@Url.Action("SaveBulkRequestConfirmation", "Inventory", new { area = "HC" })',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(bulkData),
                        success: function (res) {
                            $('#bulkActionModal').modal('hide');

                            if (res.success) {
                                let generatedUrl = null;

                                if (itemsToUpdate.length > 0 && itemsToUpdate[0].Status === 'Complete') {
                                    const uniqueRequests = [...new Set(itemsToUpdate.map(x => x.Request_No))];
                                    generatedUrl = generateBulkVoucherFromStoredData(uniqueRequests);
                                }

                                Swal.fire({
                                    title: 'Success',
                                    text: res.message,
                                    icon: 'success',
                                    showCancelButton: !!generatedUrl,
                                    confirmButtonText: generatedUrl ? 'Open Voucher & Close' : 'OK',
                                    cancelButtonText: 'Close Only'
                                }).then((result) => {
                                    if (result.isConfirmed && generatedUrl) {
                                        window.open(generatedUrl, '_blank');
                                    }
                                    table.ajax.reload(null, false);
                                    selectedRows = [];
                                    updateSelectedRowsState();
                                });
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        },
                        error: function () {
                            $('#bulkActionModal').modal('hide');
                            Swal.fire('Error', 'An error occurred during the update.', 'error');
                        },
                        complete: function () {
                            $btn.prop('disabled', false).html(originalText);
                        }
                    });
                } else {
                    $btn.prop('disabled', false).html(originalText);
                }
            });
        }

        function fetchBulkInvoiceParams(requestNos) {
            return $.ajax({
                url: '@Url.Action("GetInvoiceParamsBulk", "Inventory", new { area = "HC" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ requestNos: requestNos }),
                success: function (res) {
                    if (res && res.success === false) return;
                    if (res) {
                        Object.keys(res).forEach(reqKey => {
                            const data = res[reqKey];
                            window._invoiceParams = window._invoiceParams || {};
                            window._invoiceParams[reqKey] = {
                                invoiceNo: data.invoiceNumber,
                                invoiceDate: data.invoiceDate,
                                dueDate: data.dueDate,
                                thirdParty: data.thirdParty,
                                description: data.description,
                                amount: data.amount,
                                currency: "IDR",
                                paymentType: "DirectPayment",
                                sectionTo: "Multiple",
                                details: data.details || []
                            };
                        });
                    }
                }
            });
        }

        function generateBulkVoucherFromStoredData(requestNos) {
            let allDetails = [];
            let totalAmount = 0;
            const currency = "IDR";
            let thirdParty = "D0136|KOPERASI KARYAWAN NGK";
            let headerDescription = "";
            let headerInvoice = "";
            let groupedDetails = {};

            requestNos.forEach(reqNo => {
                const data = window._invoiceParams[reqNo];
                if (!data) return;

                if (data.thirdParty && thirdParty.includes("D0136")) thirdParty = data.thirdParty;
                if (!headerDescription && data.description) headerDescription = data.description;
                if (!headerInvoice && data.invoiceNo) headerInvoice = data.invoiceNo;

                if (data.details && data.details.length > 0) {
                    data.details.forEach((det) => {
                        let lineTotal = parseFloat(det.Amount || det.LineTotal || 0);
                        if (lineTotal === 0) {
                            const qty = parseFloat(det.Qty) || 0;
                            const price = parseFloat(det.Price) || 0;
                            lineTotal = qty * price;
                        }
                        totalAmount += lineTotal;

                        const budgetNo = det.Budget_No || "";
                        const coa = det.COA || "";
                        const section = det.SectionTo || "";
                        const groupKey = `${section}_${budgetNo}_${coa}`;

                        if (!groupedDetails[groupKey]) {
                            groupedDetails[groupKey] = {
                                amount: 0,
                                budgetNo: budgetNo,
                                description: data.description,
                                coa: coa,
                                sectionTo: section
                            };
                        }
                        groupedDetails[groupKey].amount += lineTotal;
                    });
                }
            });

            Object.values(groupedDetails).forEach(group => {
                const detailString = [
                    group.amount,
                    group.budgetNo,
                    group.description,
                    group.coa,
                    group.sectionTo
                ].join("||");
                allDetails.push(detailString);
            });

            if (allDetails.length === 0) return null;

            const now = new Date();
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            const dd = String(now.getDate()).padStart(2, '0');
            const yyyy = now.getFullYear();
            const dueDate = `${mm}/${dd}/${yyyy}`;

            const payload = {
                addNew: "addNew",
                invNumber: headerInvoice,
                currency: currency,
                thirdParty: thirdParty,
                dueDate: dueDate,
                description: headerDescription,
                requestNo: requestNos.join(","),
                amountOfInvoice: totalAmount,
                paymentType: "DirectPayment",
                sectionTo: "undefined",
                details: allDetails.join("#")
            };

            navigateToPaymentRequest(payload);
            return null;
        }

        function navigateToPaymentRequest(payload) {
            const targetUrl = "@Url.Action("NonPO", "PaymentRequest", new { area = "FA" })";
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = targetUrl;
            form.target = '_blank';
            form.style.display = 'none';

            for (const key in payload) {
                if (payload.hasOwnProperty(key)) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = key;
                    input.value = payload[key];
                    form.appendChild(input);
                }
            }
            document.body.appendChild(form);
            form.submit();
            setTimeout(() => document.body.removeChild(form), 500);
        }

        function formatRupiah(value) {
            if (value == null || isNaN(value)) return '-';
            return new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                minimumFractionDigits: 0
            }).format(value);
        }


