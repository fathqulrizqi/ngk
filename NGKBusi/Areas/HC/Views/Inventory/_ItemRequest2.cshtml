$(document).on('click', '.btn-view-request-logs', function () {
    const requestNo = $(this).data('requestno');

    $('#logModalItemName').text(`Request No: ${requestNo}`);
    const $tbody = $('#modalPriceLogs table.tbl-price-logs tbody');
    $tbody.html('<tr><td colspan="6" class="text-center py-4 text-xs text-gray-500"><i class="fas fa-spinner fa-spin mr-1"></i> Loading logs...</td></tr>');

    $('#modalPriceLogs').removeClass('hidden');

    $.ajax({
        url: '@Url.Action("GetPriceLogs", "Inventory", new { area = "HC" })',
        type: 'GET',
        data: { requestNo: requestNo },
        success: function (res) {
            $tbody.empty();
            if (res.length === 0) {
                $tbody.html('<tr><td colspan="6" class="text-center py-4 text-xs text-gray-400">No price changes recorded for this request.</td></tr>');
                return;
            }

            let num = 1;
            res.forEach(log => {
                $tbody.append(`
        <tr class="hover:bg-gray-50 text-xs text-gray-700">
            <td class="px-4 py-3 text-center font-medium">${num++}</td>
            <td class="px-4 py-3 font-semibold text-gray-800">${log.Item_Name}</td>
            <td class="px-4 py-3 text-right text-red-500 line-through">${formatRupiah(log.Old_Price)}</td>
            <td class="px-4 py-3 text-right text-green-600 font-semibold">${formatRupiah(log.New_Price)}</td>
            <td class="px-4 py-3 whitespace-nowrap">${log.Update_Date}</td>
            <td class="px-4 py-3 text-center">
                <button type="button" 
                        class="btn-rollback-price bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider transition-all"
                        data-cartid="${log.Cart_ID}" 
                        data-targetprice="${log.Target_Revert_Price}"> <i class="fas fa-undo-alt mr-1"></i> Revert
                </button>
            </td>
        </tr>
    `);
            });
        },
        error: function() {
            $tbody.html('<tr><td colspan="6" class="text-center py-4 text-xs text-red-500">Failed to load logs.</td></tr>');
        }
    });
});

$(document).on('click', '.btn-rollback-price', function () {
    const cartId = $(this).data('cartid');
    const targetPrice = $(this).data('targetprice');

    // 1. Konfirmasi menggunakan SweetAlert
    Swal.fire({
        title: 'Apakah Anda yakin?',
        text: `Ingin mengembalikan harga item ini menjadi ${formatRupiah(targetPrice)}?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#0d9488', // Menyesuaikan tema Teal Koperasi kamu
        cancelButtonColor: '#ef4444',
        confirmButtonText: 'Ya, Revert!',
        cancelButtonText: 'Batal'
    }).then((result) => {
        // Jika user klik "Ya, Revert!"
        if (result.isConfirmed) {

            // Tampilkan loading spinner biar user tahu proses sedang berjalan
            Swal.fire({
                title: 'Mohon Tunggu',
                text: 'Sedang memproses rollback harga...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: '@Url.Action("RollbackPrice", "Inventory", new { area = "HC" })',
                type: 'POST',
                data: { cartId: cartId, targetPrice: targetPrice },
                success: function (response) {
                    if (response.success) {
                        // 2. Alert Sukses
                        Swal.fire({
                            title: 'Berhasil!',
                            text: response.message,
                            icon: 'success',
                            confirmButtonColor: '#0d9488'
                        }).then(() => {
                            closeLogModal();
                            if (typeof table !== 'undefined') {
                                table.ajax.reload(null, false);
                            }
                        });
                    } else {
                        Swal.fire({
                            title: 'Gagal!',
                            text: response.message,
                            icon: 'error',
                            confirmButtonColor: '#0d9488'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        title: 'Error!',
                        text: 'Terjadi error saat memproses rollback harga.',
                        icon: 'error',
                        confirmButtonColor: '#ef4444'
                    });
                }
            });
        }
    });
});

