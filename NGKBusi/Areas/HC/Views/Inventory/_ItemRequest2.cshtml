        $('#itemRequest tbody').on('click', '.status-btn[data-status="prepare"]', function (e) {
            e.stopPropagation();
            const newStatus = 'On Prepare';
            const $childRow = $(this).closest('div');
            const requestNo = $childRow.data('request-no');
            const itemsToSend = [];
            let hasNegativeStock = false;

            $childRow.find('.qty-acc-input').each(function () {
                const $el = $(this);
                const qtyAcc = parseInt($el.val() || $el.data('value')) || 0;
                const cartNo = $el.data('cartno');
                const itemId = $el.data('itemid');
                const qtyRequest = $el.data('originalqty');
                const stockLeft = parseInt($el.closest('div').find('.stock-value').text()) || 0;

                if (stockLeft < 0) {
                    hasNegativeStock = true;
                    return false;
                }

                itemsToSend.push({
                    Request_No: requestNo,
                    Cart_No: cartNo,
                    Item_Id: itemId,
                    Qty_Request: qtyRequest,
                    Qty_Acc: qtyAcc,
                    Status: newStatus
                });
            });

            if (hasNegativeStock) {
                Swal.fire('Negative Stock', 'One or more items have negative stock. Please adjust item stock or accepted quantity.', 'warning');
                return;
            }
            if (itemsToSend.length === 0) {
                Swal.fire('No Data', 'No valid item(s) to update.', 'info');
                return;
            }

            Swal.fire({
                title: 'Confirm On Prepare?',
                text: `You are about to mark Request ${requestNo} as 'On Prepare'. Do you want to continue?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, proceed',
                cancelButtonText: 'Cancel'
            }).then((result) => {
