                const newPrice = $(this).find(':selected').data('price');
                $tr.find('.edit-price-input').val(newPrice);
            }
            const qty = parseFloat($tr.find('.edit-qty-input').val()) || 0;
            const price = parseFloat($tr.find('.edit-price-input').val()) || 0;
            const total = qty * price;
            $tr.find('td').eq(4).text(formatRupiah(total));
        });

        $(document).on('change', '.edit-item-select', function () {
