// Fungsi pembantu untuk setup tooltip gambar subkategori
function setupSubcategoryImageUploadTooltip($row) {
    const $inputUpload = $row.find('.input-upload-image');
    const $inputUrl = $row.find('.input-edit-image');
    const $previewBtn = $row.find('.btn-preview-image');
    $inputUpload.on('change', function () {
        const file = this.files[0];
        if (file) {
            const url = URL.createObjectURL(file);
            $inputUrl.val(url);
            const imageHtml = `<img src="${url}" class="w-32 h-32 object-cover rounded" />`;
            $previewBtn.attr('title', imageHtml).tooltip('dispose').tooltip();
        }
    });
    $previewBtn.on('mouseenter', function () {
        const url = $inputUrl.val().trim() || 'https://via.placeholder.com/150';
        const imageHtml = `<img src="${url}" class="w-32 h-32 object-cover rounded" />`;
        $(this).attr('title', imageHtml).tooltip('dispose').tooltip({ trigger: 'hover', html: true }).tooltip('show');
    });
    $previewBtn.on('mouseleave', function () {
        $(this).tooltip('dispose');
    });
}

