@{
    ViewBag.Title = "Master Item List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section cssHead {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.tailwindcss.css" />
    <link href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/tippy.js@6.3.7/dist/tippy.css" />
    <link href="~/Content/bootstrap/css/bootstrap5.3.3/bootstrap.min.css" rel="stylesheet" />

    <style>

        div.dt-length label {
            margin-left: 0.5rem; /* jarak antara select dan label */
        }

        .page-content {
            background: linear-gradient(135deg, #1E555C 10%, #fefee3 100%);
            padding-top: 0 !important;
            margin-top: 0 !important;
        }

        input[aria-controls="itemList"] {
            padding: 2px !important; /* py-2 px-3 */
            border-radius: 0.5rem; /* rounded-lg */
            border: 1px solid #e5e7eb; /* border-gray-200 */
            outline: none;
        }

        select[aria-controls="itemList"] {
            padding: 2px !important; /* py-2 px-3 */
            border-radius: 0.5rem; /* rounded-lg */
            border: 1px solid #e5e7eb; /* border-gray-200 */
            outline: none;
        }

        .select2-container--default .select2-selection--single {
            border-color: #DEE2E6 !important;
            height: auto !important;
        }

        .select2-container--default .select2-selection--multiple {
            min-height: 2rem;
            border-color: #DEE2E6 !important;
            padding: 0.25rem;
            width: auto !important;
            display: inline-block;
        }

        .select2-selection__rendered {
            word-wrap: break-word !important;
            text-overflow: inherit !important;
            white-space: normal !important;
        }

        table.dataTable td,
        table.dataTable th {
            padding: 0.5rem 0.5rem !important;
        }

        .hidden {
            display: none !important;
        }

        #itemList thead th,
        #categoryListTable thead th,
        #subcategoryListTable thead th {
            background-color: #F6F7F8 !important;
            border-bottom: 2px solid #F6F7F8 !important;
            color: black !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
        }

        #categoryListTable .dataTables_empty,
        #itemList .dataTables_empty,
        #subcategoryListTable .dataTables_empty {
            padding: 2rem !important;
            color: #9ca3af !important;
            font-style: italic;
            background-color: transparent !important;
        }

        #itemList tbody tr:nth-child(even),
        #categoryListTable tbody tr:nth-child(even),
        #subcategoryListTable tbody tr:nth-child(even),
        tr.even {
            background-color: #F9FAFB !important;
        }

        #itemList,
        #categoryListTable,
        #subcategoryListTable {
            border-collapse: collapse !important;
            border: none !important;
        }

            #itemList tbody td,
            #categoryListTable tbody td,
            #subcategoryListTable tbody td {
                border-bottom: 1px solid #F6F7F8 !important;
                background-color: transparent !important;
                padding: 12px 8px !important;
            }

            #categoryListTable tr {
                white-space: normal !important;
                word-break: break-word;
            }

            #categoryListTable th {
                white-space: normal !important;
                word-break: break-word;
            }

        input[aria-controls="itemList"],
        select[aria-controls="itemList"],
        #dt-search-0,
        #dt-length-0 {
            background-color: #ffffff !important;
            color: #1f2937 !important;
            margin-bottom: 5px;
            border: 1px solid #DEE2E6 !important;
            border-radius: 0.5rem !important;
            padding: 0.4rem 0.8rem !important;
            transition: all 0.2s ease;
        }
    </style>

}


@section scriptHead {
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="~/Content/bootstrap/js/bootstrap5.3.3/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.tailwindcss.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

}
<!-- Header Section -->
<div class="p-4 mb-2">
    <div class="flex flex-col space-y-4 sm:space-y-0">
        <div class="flex items-center space-x-4">
            <div class="w-1 h-8 bg-gradient-to-b from-yellow-500 to-orange-600 rounded-full"></div>
            <h1 class="text-2xl font-bold text-gray-50">Master Item List</h1>

        </div>
    </div>
</div>

<!-- Category & Subcategory Section -->
<div class="flex flex-col md:flex-row gap-6 mt-6">

    <div class="w-full md:w-1/2 bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">

        <div class="px-6 py-4 bg-gradient-to-r from-gray-50 to-gray-100 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                <i class="fas fa-list text-blue-600 text-sm"></i>
                Category List
            </h3>
            <button id="createCategory" class="flex items-center gap-2 bg-orange-600 hover:bg-orange-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all duration-200">
                <i class="fas fa-plus"></i> Add New
            </button>
        </div>

        <div class="p-6">
            <table id="newCategoryTable" class="hidden w-full text-sm mb-4 border border-dashed border-gray-300 rounded-lg">
                <thead class="bg-gray-50 text-xs text-gray-700 uppercase">
                    <tr>
                        <th class="py-2 px-3 text-left">Category Name</th>
                        <th class="py-2 px-3 text-center w-24">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="p-2">
                            <input id="newCategoryName" class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-green-200 focus:border-green-500 outline-none transition" placeholder="Enter Category Name">
                        </td>
                        <td class="flex items-center justify-center gap-2 p-2">
                            <button id="btnAddCategory" title="Save" class="p-2 bg-green-100 text-green-600 rounded hover:bg-green-200 transition"><i class="fa-solid fa-check"></i></button>
                            <button id="btnCancelAddCategory" title="Cancel" class="p-2 bg-red-100 text-red-600 rounded hover:bg-red-200 transition"><i class="fa-solid fa-xmark"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="overflow-x-auto w-full">
                <table id="categoryListTable" class="stripe hover row-border w-full text-sm border border-gray-200">
                    <thead class="bg-gray-800 text-white text-xs uppercase">
                        <tr>
                            <th class="py-3 px-4 text-left">Category Name</th>
                            <th class="py-3 px-4 text-center w-24">Action</th>
                        </tr>
                        <tr class="search-row bg-gray-50 text-gray-800">
                            <th class="p-2"><input type="text" placeholder="Search..." class="w-full p-1 text-xs border rounded" data-column="0"></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="w-full md:w-1/2 bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">

        <div class="px-6 py-4 bg-gradient-to-r from-gray-50 to-gray-100 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                <i class="fas fa-layer-group text-blue-600 text-sm"></i>
                Subcategory List
            </h3>
            <button id="createSubcategory" class="flex items-center gap-2 bg-orange-600 hover:bg-orange-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all duration-200">
                <i class="fas fa-plus"></i> Add New
            </button>
        </div>

        <div class="p-6">
            <table id="newSubcategoryTable" class="hidden w-full text-sm mb-4 border border-dashed border-gray-300 rounded-lg">
                <thead class="bg-gray-50 text-xs text-gray-700 uppercase">
                    <tr>
                        <th class="py-2 px-3 text-left">Name</th>
                        <th class="py-2 px-3 text-left">Category</th>
                        <th class="py-2 px-3 text-left">Image</th>
                        <th class="py-2 px-3 text-center w-24">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="p-2 align-top">
                            <input class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-green-200 outline-none" id="newSubcategoryName" placeholder="Name">
                        </td>
                        <td class="p-2 align-top">
                            <select id="newSubcategoryCategory" class="select2 w-full p-2 text-md border border-gray-300 rounded">
                                <option value="" selected disabled hidden>-- Select --</option>
                                @foreach (var category in ViewBag.CategoryList)
                                {
                                    <option value="@category.ID">@category.Category_Name</option>
                                }
                            </select>
                        </td>
                        <td class="p-2 align-top min-w-[180px]">
                            <div class="flex items-center gap-2 mb-2">
                                <input type="text" class="w-full p-2 text-xs border border-gray-300 rounded" id="newSubcategoryImage" placeholder="URL">
                                <button id="subcategoryImageTooltipBtn" type="button" class="text-blue-500 hover:text-blue-700" data-bs-toggle="tooltip" title="Preview">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </div>
                            <label class="w-full cursor-pointer flex flex-col items-center justify-center border border-dashed border-gray-300 rounded py-2 hover:bg-blue-50 hover:border-blue-400 transition">
                                <input type="file" accept="image/*" class="hidden" id="subcategoryImageUpload">
                                <div class="flex items-center gap-1 text-xs text-gray-500">
                                    <i class="fa-solid fa-cloud-arrow-up"></i> Upload
                                </div>
                            </label>
                        </td>
                        <td class="flex items-center justify-center gap-2 p-2 align-top h-full">
                            <button id="btnAddSubcategory" title="Save" class="p-2 bg-green-100 text-green-600 rounded hover:bg-green-200 transition"><i class="fa-solid fa-check"></i></button>
                            <button id="btnCancelAddSubcategory" title="Cancel" class="p-2 bg-red-100 text-red-600 rounded hover:bg-red-200 transition"><i class="fa-solid fa-xmark"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="overflow-x-auto w-full">
                <table id="subcategoryListTable" class="stripe hover row-border w-full text-sm border border-gray-200">
                    <thead class="bg-gray-800 text-white text-xs uppercase">
                        <tr>
                            <th class="py-3 px-4 text-left">Subcategory</th>
                            <th class="py-3 px-4 text-left">Category</th>
                            <th class="py-3 px-4 text-center">Image</th>
                            <th class="py-3 px-4 text-center w-24">Action</th>
                        </tr>
                        <tr class="search-row bg-gray-50 text-gray-800">
                            <th class="p-2">
                                <select id="searchSubcategoryCategory" class="w-full p-1 text-xs border rounded" data-column="0">
                                    <option value="">All Subcategories</option>
                                    @foreach (var subcategory in ViewBag.SubcategoryList)
                                    {
                                        <option value="@subcategory.Subcategory_Name">@subcategory.Subcategory_Name</option>
                                    }
                                </select>
                            </th>
                            <th class="p-2">
                                <select id="searchCategoryCategory" class="w-full p-1 text-xs border rounded" data-column="1">
                                    <option value="">All Categories</option>
                                    @foreach (var category in ViewBag.CategoryList)
                                    {
                                        <option value="@category.Category_Name">@category.Category_Name</option>
                                    }
                                </select>
                            </th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- Item List (Full Width) -->
<div class="w-full bg-white rounded-xl shadow-lg mt-6 border border-gray-100 overflow-hidden">

    <div class="px-6 py-4 bg-gradient-to-r from-gray-50 to-gray-100 border-b border-gray-200 flex flex-col md:flex-row justify-between items-center gap-4">

        <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2 self-start md:self-center">
            <i class="fas fa-boxes-stacked text-blue-600 text-sm"></i>
            Item List
        </h3>

        <div class="flex items-center gap-2 self-end md:self-center">
            <button id="uploadXls" class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all duration-200">
                <i class="fas fa-file-excel"></i> Upload Xls
            </button>
            <button id="createItem" class="flex items-center gap-2 bg-orange-600 hover:bg-orange-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm transition-all duration-200">
                <i class="fas fa-plus"></i> Add New Item
            </button>
        </div>
    </div>

    <div class="p-6">
        <div class="overflow-x-auto">
            @Html.Partial("Partial/_Item")
        </div>
    </div>
</div>
<script>
    const categoryList = @Html.Raw(Json.Encode(ViewBag.CategoryList));
    const subcategoryList = @Html.Raw(Json.Encode(ViewBag.SubcategoryList));
</script>

<script>

$(document).ready(function () {
    $('#categoryListTable').DataTable({
        responsive: true,
        autoWidth: true,
        orderCellsTop: true,
        fixedHeader: true,
        dom: 'rtip',
        data: categoryList,
        columns: [
            { data: 'Category_Name' },
            {
                data: null,
                orderable: false,
                render: (data, type, row) => `
             <button class="text-yellow-500 p-2 btn-edit-category" data-id="${row.ID}">
                 <i class="fa-solid fa-pen"></i>
             </button>
             <button class="text-red-500 p-2 btn-delete-category" data-id="${row.ID}">
                 <i class="fa-solid fa-trash"></i>
             </button>`
            }
        ],
        initComplete: function () {
            const api = this.api();
            $('#categoryListTable thead tr.search-row input').on('keyup change clear', function () {
                const colIndex = $(this).data('column');
                api.column(colIndex).search(this.value, true, false).draw();
            });
        }
    });
    $('#categoryList').select2({
        placeholder: '--Select Category--',
        width: '100%',
    });
    $('#newSubcategoryList').select2({
        placeholder: '--Select Subcategory--',
        width: '100%',
    });

    // Event listener untuk memfilter subkategori saat kategori diubah
    $('#categoryList').on('change', function () {
        const selectedCategoryId = $(this).val();
        const $subcategoryList = $('#newSubcategoryList');
        $subcategoryList.empty();

        if (selectedCategoryId) {
            const filteredSubcategories = subcategoryList.filter(sub => sub.Category_Id == selectedCategoryId);
            let options = '<option value="" selected disabled hidden>--Select Subcategory--</option>';
            filteredSubcategories.forEach(sub => {
                options += `<option value="${sub.ID}">${sub.Subcategory_Name}</option>`;
            });
            $subcategoryList.html(options);
            $subcategoryList.prop('disabled', false);
        } else {
            $subcategoryList.html('<option value="" selected disabled hidden>--Select Subcategory--</option>');
            $subcategoryList.prop('disabled', true);
        }
        $subcategoryList.trigger('change');
    });

    $('#newSubcategoryList').select2({
        placeholder: '--Select Subcategory--',
        width: '100%',
    });

    $('#categoryFilter, #subcategoryFilter').select2({
        width: 'auto',
        multiple: true,
        closeOnSelect: false,
        dropdownAutoWidth: true
    });

    $('#categoryFilter').on('change', function () {
        let selected = $(this).val() || [];
        let regex = selected.length ? selected.join('|') : '';
        $('#itemList').DataTable().column(1).search(regex, true, false).draw();
    });
    const urlParams = new URLSearchParams(window.location.search);
    let initialPage = parseInt(urlParams.get('page')) || 1;
    let pageLength = 10;
        const table = $('#itemList').DataTable({
            orderCellsTop: true,
            displayStart: (initialPage - 1) * pageLength,
        responsive: true,
        autoWidth: true,
            fixedHeader: true,

        ajax: {
            url: '@Url.Action("GetItemDatas","Inventory", new { area = "HC" })',
            type: 'GET',
            dataSrc: 'datas'
        },
        columns: [
            { data: null, orderable: true, render: (data, type, row, meta) => meta.row + 1 },
            {
                data: 'CategoryName',
                width: '150px',
                render: function (data, type, row) {
                    return data ? data : '<span class="text-gray-400 italic">undefined</span>';
                }
            },
            // Kolom Subcategory baru
            {
                data: 'SubcategoryName',
                width: '150px',
                render: function (data, type, row) {
                    return data ? data : '<span class="text-gray-400 italic">undefined</span>';
                }
            },
            {
                data: 'Image',
                orderable: true,
                width: '150px',
                render: function (data, type, row) {
                    var isFullUrl = data.startsWith("http://") || data.startsWith("https://");
                    var imageUrl = isFullUrl ? data : '@Url.Content("~/Files/HC/Inventory/")' + data;
                    return `<img src="${imageUrl}" alt="${row.Item_Name}" class="h-16 w-16 object-cover rounded border" />`;
                }
            },
            { data: 'Item_Name', className: 'uppercase' },
            { data: 'Qty', className: 'text-center', width: '80px', title: 'Qty Stock' },
            { data: 'Qty_Order', className: 'text-center text-blue-500', width: '80px' },
            { data: 'Unit', className: 'text-center', width: '80px' },
            {
                data: 'Price',
                className: 'text-center',
                width: '80px',
                render: function (data, type, row) {
                    if (data == null || data === 0) return '<span class="text-gray-400 italic">-</span>';
                    return parseFloat(data).toLocaleString('en-US'); // Format 16500 -> 16,500
                }
            },
            { data: 'Location', width: '100px' },
            {
                data: 'Ref_Code',
                width: '100px',
                render: function (data, type, row) {
                    if (!data) {
                        return '<span class="text-gray-400 italic">No Data</span>';
                    }
                    return data;
                }
            },
            {
                data: null,
                orderable: false,
                render: (data, type, row) => `
                    <button title="Edit" class="btn btnedit p-2" data-id="${row.ID}">
                    <i class="fa-solid fa-pen text-yellow-500"></i>
                    </button>
                    <button title="Delete" class="btn btndelete p-2" data-id="${row.ID}">
                    <i class="fa-solid fa-trash text-red-500"></i>
                    </button>`
            }
        ],
            initComplete: function () {
                const api = this.api();
                $('#itemList thead tr.search-row input').each(function () {
                    $(this).on('keyup change', function () {
                        const colIndex = $(this).data('column');
                        api.column(colIndex).search(this.value, true, false).draw();
                    });
                });
            }
        });

    // === pas data ajax selesai di-load ===
    table.on('xhr.dt', function (e, settings, json) {
        if (json && json.lastPriceUpdate) {
            const match = /\/Date\((\d+)\)\//.exec(json.lastPriceUpdate);
            let formatted = '-';
            if (match) {
                const ms = parseInt(match[1]);
                const date = new Date(ms);
                formatted = date.toLocaleString('EN', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });
            }
            $('#lastUpdateFooter span').text('Last Price Update: ' + formatted);
        }
    });

    table.on('page.dt', function () {
        var info = table.page.info();
        var pageNum = info.page + 1; // DataTables page index mulai dari 0, jadi +1

        // Update URL tanpa reload halaman
        var newUrl = window.location.pathname + '?page=' + pageNum;
        history.replaceState(null, '', newUrl);
    });

    // Logika untuk tombol Edit dan Delete di Item List
    $(document).on('click', '.btnedit', function () {
        const $row = $(this).closest('tr');
        const rowData = $('#itemList').DataTable().row($row).data();

        if (!rowData || !rowData.ID) {
            console.error("Row data is undefined.");
            return;
        }

        // Ambil ID kategori dan subkategori dari data baris
        let categoryId = rowData.Category_Id;
        let subcategoryId = rowData.Subcategory_Id;

        // Buat HTML untuk dropdown kategori
        let categoryOptionsHtml = (categoryList || []).map(cat => {
            const selected = cat.ID === categoryId ? 'selected' : '';
            return `<option value="${cat.ID}" ${selected}>${cat.Category_Name}</option>`;
        }).join('');

        // Buat HTML awal untuk dropdown subkategori
        let subcategoryOptionsHtml = `<option value="" selected disabled hidden>--Select Subcategory--</option>`;
        if (categoryId) {
            const filteredSubcategories = (subcategoryList || []).filter(sub => sub.Category_Id == categoryId);
            subcategoryOptionsHtml += filteredSubcategories.map(sub => {
                const selected = sub.ID === subcategoryId ? 'selected' : '';
                return `<option value="${sub.ID}" ${selected}>${sub.Subcategory_Name}</option>`;
            }).join('');
        }

        // Perbarui kolom Category (indeks 1)
        $row.find('td').eq(1).html(`
        <select class="w-full p-2 border rounded category-select">
            ${categoryOptionsHtml}
        </select>
    `);
        $row.find('.category-select').select2({ width: '100%' });

        // Perbarui kolom Subcategory (indeks 2)
        $row.find('td').eq(2).html(`
        <select class="w-full p-2 border rounded subcategory-select" ${!categoryId ? 'disabled' : ''}>
            ${subcategoryOptionsHtml}
        </select>
    `);
        $row.find('.subcategory-select').select2({ width: '100%' });

        // Tambahkan Event listener untuk memfilter subkategori saat kategori diubah
        $row.find('.category-select').on('change', function () {
            const newCategoryId = $(this).val();
            const $subcategorySelect = $row.find('.subcategory-select');
            $subcategorySelect.empty();

            if (newCategoryId) {
                const filteredSubcategories = (subcategoryList || []).filter(sub => sub.Category_Id == newCategoryId);
                let options = '<option value="" selected disabled hidden>--Select Subcategory--</option>';
                options += filteredSubcategories.map(sub => `<option value="${sub.ID}">${sub.Subcategory_Name}</option>`).join('');
                $subcategorySelect.html(options);
                $subcategorySelect.prop('disabled', false);
            } else {
                $subcategorySelect.html('<option value="" selected disabled hidden>--Select Subcategory--</option>');
                $subcategorySelect.prop('disabled', true);
            }
            $subcategorySelect.trigger('change');
        });

        // ... (kode HTML untuk Image, Item, Qty, Qty Order, Unit, Location, dan Action)
        // PERHATIKAN: Indeks kolom telah bergeser!
        $row.find('td').eq(3).html(`
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
                <input type="text" class="w-full p-2 border rounded input-edit-image" value="${rowData.Image}" placeholder="Image URL">
                <button type="button" class="text-blue-500 hover:text-blue-600 btn-preview-image" title=""><i class="fa-solid fa-eye"></i></button>
            </div>
