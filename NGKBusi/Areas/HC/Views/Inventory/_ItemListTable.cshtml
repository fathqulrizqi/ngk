$('#subcategoryListTable').DataTable({
    responsive: true,
    autoWidth: true,
    orderCellsTop: true,
    fixedHeader: true,
    stateSave: true,
    dom: 'rtip',
    ajax: {
        url: '@Url.Action("GetSubcategoryDatas", "Inventory", new { area = "HC" })',
        type: 'GET',
        dataSrc: ''
    },
    columns: [
        { data: 'Subcategory_Name' },
        {
            data: 'CategoryName',
            render: function (data) {
                return data ? data : '<span class="text-gray-400 italic">undefined</span>';
            }
        },
        // Definisi kolom gambar yang sama dengan item list
        {
            data: 'Subcategory_Image',
            orderable: false, // Disarankan untuk gambar
            width: '150px',
            render: function (data, type, row) {
                if (!data) return '';
                var isFullUrl = data.startsWith("http://") || data.startsWith("https://");
                var imageUrl = isFullUrl ? data : '@Url.Content("~/Files/HC/Inventory/")' + data;
                return `<img src="${imageUrl}" alt="${row.Subcategory_Name}" class="h-16 w-16 object-cover rounded border" />`;
            }
        },
        {
            data: null,
            orderable: false,
            render: (data, type, row) => {
                if (!row || !row.ID) return '';
                return `
                    <button class="text-yellow-500 p-2 btn-edit-subcategory" data-id="${row.ID}">
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <button class="text-red-500 p-2 btn-delete-subcategory" data-id="${row.ID}">
                        <i class="fa-solid fa-trash"></i>
                    </button>`;
            }
        }
    ],
    initComplete: function () {
        const api = this.api();

        // 1. Filter Dropdown untuk Subcategory Name (Kolom 0)
        const $subcategorySelect = $('#searchSubcategoryCategory');

        // Atur ulang data-column ke 0 (sesuai Subcategory Name) jika belum diatur di HTML
        $subcategorySelect.attr('data-column', '0');

        // Inisialisasi Select2
        $subcategorySelect.select2({
            placeholder: '-- Search Subcategory --',
            allowClear: true,
            width: '100%'
        });

        // Terapkan filter saat nilai berubah
        $subcategorySelect.on('change', function () {
            const colIndex = $(this).data('column'); // colIndex akan menjadi 0
            const selectedValue = this.value;
            api.column(colIndex).search(selectedValue ? selectedValue : '', true, false).draw();
        });


        // 2. Filter Dropdown untuk Category Name (Kolom 1)
        const $categorySelect = $('#searchCategoryCategory');

        // Atur ulang data-column ke 1 (sesuai Category Name) jika belum diatur di HTML
        $categorySelect.attr('data-column', '1');

        // Inisialisasi Select2
        $categorySelect.select2({
            placeholder: '-- Search Category --',
            allowClear: true,
            width: '100%'
        });

        // Terapkan filter saat nilai berubah
        $categorySelect.on('change', function () {
            const colIndex = $(this).data('column'); // colIndex akan menjadi 1
            const selectedValue = this.value;
            api.column(colIndex).search(selectedValue ? selectedValue : '', true, false).draw();
        });
    }
});

