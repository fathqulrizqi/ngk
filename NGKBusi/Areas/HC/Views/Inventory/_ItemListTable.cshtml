$(document).on('click', '.btn-save-subcategory', function () {
    const id = $(this).data('id');
    const $row = $(this).closest('tr');
    const newName = $row.find('input.input-edit-subcategory').val().trim();
    const newCategoryId = $row.find('.subcategory-category-select').val();
    const imageUrlInput = $row.find('.input-edit-image').val().trim();
    const imageFile = $row.find('.input-upload-image')[0].files[0];

    const formData = new FormData();
    formData.append('id', id);
    formData.append('Subcategory_Name', newName);
    formData.append('Category_Id', newCategoryId);
    if (imageFile) {
        formData.append('Subcategory_Image', imageFile);
    } else if (imageUrlInput) {
        formData.append('Subcategory_Image', imageUrlInput);
    }

    $.ajax({
        url: "@Url.Action("UpdateSubcategory", "Inventory", new { area = "HC" })",
        type: 'POST',
        data: formData,
        contentType: false,
        processData: false,
        success: function (res) {
            if (res.success) {
                Swal.fire({ icon: 'success', title: 'Updated', text: res.message, showConfirmButton: 'OK' }).then(() => { location.reload(); });
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        },
        error: function () {
            Swal.fire({ icon: 'error', title: 'Server Error', text: 'Terjadi kesalahan saat mengupdate.' });
        }
    });
});
