    $(document).on('click', '.btn-cancel-subcategory', function () {
        const $row = $(this).closest('tr');
        const table = $('#subcategoryListTable').DataTable();
        table.row($row).invalidate().draw(false);
    });

    $(document).on('click', '.btn-delete-subcategory', function () {
        const $row = $(this).closest('tr');
        const rowData = $('#subcategoryListTable').DataTable().row($row).data();

        // Pastikan data baris ada sebelum melanjutkan
        if (!rowData || !rowData.ID) {
            Swal.fire('Error', 'Invalid subcategory data.', 'error');
            return;
        }

        const subcategoryId = rowData.ID;
        const subcategoryName = rowData.Subcategory_Name;

        // Buat pesan dinamis dengan nama subkategori
        const confirmText = `Subcategory '${subcategoryName}' will be permanently removed.`;

        Swal.fire({
            title: 'Are you sure?',
            text: confirmText,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel',
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("DeleteSubcategory","Inventory", new { area = "HC" })',
                    data: { id: subcategoryId },
                    success: function (res) {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: res.message,
                                showConfirmButton: 'OK'
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Failed',
                                text: res.message
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Server Error',
                            text: 'Terjadi kesalahan.'
                        });
                    }
                });
            }
        });
    });
