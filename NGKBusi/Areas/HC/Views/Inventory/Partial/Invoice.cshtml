    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver(function (entries) {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, observerOptions);

        });

        function printInvoice() {
            window.print();
        }

        function downloadPDF() {
            const element = document.getElementById("invoiceContent");

            if (!element) {
                console.error("Invoice content element not found!");
                return;
            }

            const invoiceNumber = document.getElementById("invoiceNumber")?.innerText || "Invoice";

            const opt = {
                margin: [0.5, 0.5, 0.5, 0.5],

                filename: invoiceNumber.replace(/\//g, "_") + ".pdf",

                image: { type: 'jpeg', quality: 0.98 },

                html2canvas: {
                    scale: 2,
                    useCORS: true,
                    logging: true,
                    allowTaint: false,
                    ignoreElements: (element) => element.classList.contains('no-print')
                },

                jsPDF: {
                    unit: 'in',
                    format: 'a4',
                    orientation: 'portrait'
                }
            };

            html2pdf().from(element).set(opt).save();
        }
        function sendEmail() {
            const subject = encodeURIComponent('Invoice #DZ0112 - KOPKAR SEJAHTERA');
            const body = encodeURIComponent('Please find attached invoice #DZ0112.\n\nTotal Amount: Rp 819.130\nDue Date: 24 Oct, 2025\n\nThank you for your business!');
            window.location.href = `mailto:?subject=${subject}&body=${body}`;
        }
    </script>

