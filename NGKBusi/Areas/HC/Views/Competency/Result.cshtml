                        <h2>RESULT</h2>
                    </div>
                    <div class="col-8 competencyResultContent border border-1 align-content-center text-center p-3">
                        <h4>BEHAVIOR</h4>
                        <hr />
                        <p><h1 class="competencyResultC">E</h1></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}