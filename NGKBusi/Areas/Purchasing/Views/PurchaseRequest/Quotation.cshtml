                                                                    <input type="radio" class="form-check-input rbQTVendorChoose" name="@("iVndrChoose" + data.ID + "[]")" @(dataLinesVendor.IsChoosen ? "checked" : "") required @(isAllowEdit ? "" : "disabled")>
