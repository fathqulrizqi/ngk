                                                        </td>
                                                        @{var currDataLinesVendor = dbPR.Purchasing_PurchaseRequest_Quotation_Line_Vendor.Where(w => w.Line_ID == data.ID).OrderByDescending(o => o.IsChoosen).ToList();}

                                                        @if (currDataLinesVendor.Count() > 0)
