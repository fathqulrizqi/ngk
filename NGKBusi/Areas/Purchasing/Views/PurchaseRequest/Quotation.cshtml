                        @{
                            var currSignList = db.Approval_List.Where(w => w.Menu_Id == 40 && w.Document_Id == 2 && w.Reveral_ID == quoNumber && w.Is_Skip == false && w.IsEmailOnly == false).Select(s => new { Title = s.Title, Header = s.Header, Label = s.Label, Levels = s.Levels, Levels_Sub = s.Levels_Sub }).Distinct().ToList().OrderByDescending(o => o.Levels).ThenByDescending(o => o.Levels_Sub);
