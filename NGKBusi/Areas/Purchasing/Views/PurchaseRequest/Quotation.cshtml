                                                    //{
                                                    //    prevFiscalYearMonths.Add(new DateTime(fiscalYear + 1, m, 1).ToString("yyyy_MM"));
                                                    //}
                                                    // Example usage: prevFiscalYear
                                                    var currentQUODate = data?.Headers.Created_At;
                                                    var currentQUOItemID = data?.Item_ID;
                                                    var currentQUOItemName = data?.Item_Name;
                                                    var netPrice = dbPR.Purchasing_PurchaseRequest_Quotation_Line_Vendor.Where(w => w.Line_ID == data.ID && w.IsChoosen == true).FirstOrDefault();
                                                    var currNetPrice = (netPrice?.Discount_Type == "Pcs"
                                                        ? netPrice?.Price - netPrice?.Discount
                                                        : netPrice?.Price - (netPrice?.Qty > 0 ? (netPrice?.Discount / netPrice?.Qty) : 0)) ?? (double?)0;
                                                    var isNewPriceBudget = data.Budget_Number == "New-Price|Propose";
                                                    double currHistoryPrice = 0;

                                                    if (!isNewPriceBudget)
                                                    {
                                                        var historyPrice = dbPR.Purchasing_PurchaseRequest_Quotation_Line
                                                            .Include("vendors")
                                                            .Where(w => w.Item_ID == currentQUOItemID && w.Item_ID != "" && w.Headers.Created_At < currentQUODate)?.OrderByDescending(o => o.Headers.Created_At)?.FirstOrDefault()?
                                                            .Vendors?.Where(w => w.IsChoosen == true).FirstOrDefault();

                                                        currHistoryPrice = (historyPrice?.Discount_Type == "Pcs"
                                                            ? (historyPrice?.Price - historyPrice?.Discount)
                                                            : historyPrice?.Price - (historyPrice?.Discount / historyPrice?.Qty)) ?? 0;
                                                    }
                                                    else
                                                    {
                                                        var historyPriceForNewPrice = dbD365.SCM_D365ImporForm_PurchaseLines
                                                            .Where(w => w.Item_number == currentQUOItemID && w.Created_at < currentQUODate && ((double)(w.Unit_price - w.Discount) != currNetPrice))?
                                                            .OrderByDescending(o => o.Created_at)?.FirstOrDefault();

                                                        var historyPriceForNewPriceCustom = dbPR.Purchasing_PurchaseRequest_Quotation_History_Price_Custom
                                                            .Where(w => (w.Item_ID == currentQUOItemID || w.Item_Name == currentQUOItemName) && w.Price_Date < currentQUODate)?
                                                            .OrderByDescending(o => o.Price_Date)?.FirstOrDefault();

                                                        currHistoryPrice = historyPriceForNewPrice != null
                                                            ? (double)historyPriceForNewPrice.Unit_price - (double)historyPriceForNewPrice.Discount
                                                            : (double?)historyPriceForNewPriceCustom?.Price ?? 0;
                                                    }
                                                    <tr class="trQTVendor" data-budgetno="@(data?.Budget_Number)" data-lineID="@(data.ID)" data-sequence="@(data?.Sequence)">
