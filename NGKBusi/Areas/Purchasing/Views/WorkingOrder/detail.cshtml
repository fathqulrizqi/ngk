    const selectedBudgets = $('#budgetNo').select2('data');
    const budgetNos = selectedBudgets.map(item => item.id).join(', ');
    const budgetDescs = selectedBudgets
        .map(item => $(item.element).data('description') || '')
        .filter(desc => desc)
        .join(', ');
    const queryId = getQueryParam("id");

    const startDateVal = $("#startDate").val();
    const endDateVal = $("#endDate").val();

    const formattedStartDate = moment(startDateVal, "DD-MM-YYYY", true).isValid()
        ? moment(startDateVal, "DD-MM-YYYY").format("YYYY-MM-DD")
        : startDateVal;

    const formattedEndDate = moment(endDateVal, "DD-MM-YYYY", true).isValid()
        ? moment(endDateVal, "DD-MM-YYYY").format("YYYY-MM-DD")
                : endDateVal;

            let priceRows = [];
            $(".price-row").each(function () {
                let row = $(this);
                priceRows.push({
                    Price_Before: unformatRupiah(row.find(".price-before").val()),
                    Discount: unformatRupiah(row.find(".price-discount").val()),
                    Price_Total: unformatRupiah(row.find(".price-total").val())
                });
            });

    $.ajax({
        url: '@Url.Action("SaveApproval", "WorkingOrder", new { area = "Purchasing" })',
        type: 'POST',
        data: {
            id: idLetter,
            Attn: $("#attn").val(),
            Ref: $("#ref").val(),
            Project: $("#project").val(),
            Html: htmlContent,
            Date: unformatDate,
            Total: totalValue,
            PaymentTerm: $("#payment").val(),
            StartDate: formattedStartDate,
            EndDate: formattedEndDate,
            BudgetNo: budgetNos,
            BudgetDesc: budgetDescs,
            Remark: $("#remark").val(),
            Approved: 'DOLLY',
            PreparedName: '@ViewBag.username',
            DateApproved: dateApproved,
            Prepared: '@ViewBag.userNIK',
            PriceRowsJson: JSON.stringify(priceRows)

        },
        success: function(response) {
            if (response.success) {
                Swal.fire({
                    title: 'Success!',
                    text: response.message,
                    icon: 'success',
                    confirmButtonText: 'OK'
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire('Warning', response.message, 'warning');
            }
        },
        error: function() {
            Swal.fire('Error', 'Failed to save approval', 'error');
        }
    });
}

