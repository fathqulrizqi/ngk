        let priceRowCounter = 0;

        function generatePriceRow() {
            priceRowCounter++;
            return `
                    <tr class="price-row">
                        <td class="border border-gray-300 p-1">
                            <input type="text" name="PriceBefore_${priceRowCounter}" class="price-before border rounded w-full px-2 py-1 text-sm bg-white" placeholder="Rp 0" autocomplete="off" />
