            });

            // 3. Event Tombol Delete Row
            $(document).on("click", ".remove-price-row", function (e) {
                e.preventDefault();
                $(this).closest("tr").remove();
                calculateTotal(); // Recalculate grand total after row removal
            });

            // 4. Kalkulasi Otomatis & Formatting Input
            // 1. KETIKA FOKUS: Ubah ke angka polos dengan koma agar user gampang mengetik desimal
            $(document).on("focus", ".price-before, .price-discount, #total", function () {
                let val = $(this).val();
                let cleanVal = val.replace(/Rp|\s|\./g, ''); // Hapus Rp dan titik
                if (cleanVal === "0,00" || cleanVal === "0") cleanVal = "";
                $(this).val(cleanVal);
            });

            // 2. KETIKA KETIK: Hanya izinkan angka dan 1 buah koma (tanpa auto-format biar tak error)
            $(document).on("input", ".price-before, .price-discount, #total", function () {
                let val = $(this).val().replace(/[^0-9,]/g, ''); // Filter hanya angka dan koma
                // Cegah user ketik koma lebih dari satu kali
                if ((val.match(/,/g) || []).length > 1) {
                    val = val.substring(0, val.lastIndexOf(','));
                }
                $(this).val(val);

                if ($(this).attr('id') !== 'total') {
                    calculateTotal();
                }
            });

            // 3. KETIKA BLUR (KLIK KELUAR): Rapikan kembali menjadi format Rp xxx.xxx,xx
            $(document).on("blur", ".price-before, .price-discount, #total", function () {
                let numeric = unformatRupiah($(this).val());
                $(this).val(formatRupiah(numeric));

                $(this).valid();
            });

            // 4. Hitung Ulang Total
            function calculateTotal() {
                let grandTotal = 0;
                $(".price-row").each(function () {
                    let row = $(this);
                    let valBefore = unformatRupiah(row.find(".price-before").val());
                    let valDiscount = unformatRupiah(row.find(".price-discount").val());

                    let rowTotal = valBefore - valDiscount;
                    if (rowTotal < 0) rowTotal = 0;

                    row.find(".price-total").val(formatRupiah(rowTotal));
                    grandTotal += rowTotal;
                });
                $("#total").val(formatRupiah(grandTotal));
            }
        });

        function saveApproval(idLetter) {

    const today = new Date();
    const totalValue = unformatRupiah($("#total").val());

