        $.validator.addMethod("validAmount", function (value, element) {
            let isFormatted = /^Rp\s[0-9]{1,3}(\.[0-9]{3})*(,[0-9]+)?$/.test(value);
            let isRaw = /^[0-9]+(,[0-9]+)?$/.test(value);
            return this.optional(element) || isFormatted || isRaw;
        }, "Please enter a valid amount");

        $.validator.addMethod("validTableAmount", function (value, element) {
            let isFormatted = /^Rp\s[0-9]{1,3}(\.[0-9]{3})*(,[0-9]+)?$/.test(value);
            let isRaw = /^[0-9]+(,[0-9]+)?$/.test(value);
            return this.optional(element) || isFormatted || isRaw;
        }, "Please enter a valid amount");

        $.validator.addMethod("validDate", function (value, element) {
            return this.optional(element) || /^\d{2}-\d{2}-\d{4}$/.test(value);
        }, "Please enter a valid date (DD-MM-YYYY)");

        $.validator.addMethod("endAfterStart", function (value, element, params) {
            var startDate = $(params).val();
            if (!startDate || !value) return true;

            function parseDate(dateStr) {
                var parts = dateStr.split('-');
                return new Date(parts[2], parts[1] - 1, parts[0]);
            }

            var start = parseDate(startDate);
            var end = parseDate(value);

            return end >= start;
        }, "End date must be after or equal to start date.");

        $.validator.addClassRules("price-before", {
            required: true,
            validTableAmount: true
        });

        $.validator.addClassRules("price-discount", {
            required: true,
            validTableAmount: true
        });

        const letterValidation = $("#letterForm").validate({
            rules: {
                attn: { required: true },
                ref: { required: true },
                project: { required: true },
                total: {
                    required: true,
                    validAmount: true,
                },
                payment: { required: true },
                startDate: {
                    required: true,
                    validDate: true,
                },
                endDate: {
                    required: true,
                    validDate: true,
                    endAfterStart: "#startDate"
                },
                budgetNo: { required: true },
                remark: {}
            },
            messages: {
                attn: { required: "Please enter attention" },
                ref: { required: "Please enter reference" },
                project: { required: "Please enter project" },
                total: { required: "Please enter total amount" },
                payment: { required: "Please enter payment term" },
                startDate: { required: "Please enter start date" },
                endDate: { required: "Please enter end date" },
                budgetNo: { required: "Please select budget number" },
                remark: {}
            },
            errorElement: 'div',
            errorPlacement: function (error, element) {
                error.addClass('invalid-feedback');

                if (element.hasClass('price-before') || element.hasClass('price-discount')) {
                    return;
                }

                if (element.hasClass('select2-hidden-accessible')) {
                    error.insertAfter(element.next('.select2-container'));
                } else {
                    error.insertAfter(element);
                }
            },
            highlight: function (element, errorClass, validClass) {
                if ($(element).hasClass('select2-hidden-accessible')) {
                    $(element).next('.select2-container')
                        .find('.select2-selection')
                        .addClass('is-invalid')
                        .css('border-color', '#dc3545');
                } else {
                    $(element).addClass('is-invalid')
                        .css('border-color', '#dc3545');
                }
            },
            unhighlight: function (element, errorClass, validClass) {
                if ($(element).hasClass('select2-hidden-accessible')) {
                    $(element).next('.select2-container')
                        .find('.select2-selection')
                        .removeClass('is-invalid')
                        .css('border-color', '');
                } else {
                    $(element).removeClass('is-invalid')
                        .css('border-color', '');
                }
            }
        });

        $("#startDate, #endDate").on('change', function () {
            $("#startDate").valid();
            $("#endDate").valid();
        });
    </script>

</body>
