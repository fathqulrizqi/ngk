function generatePDF() {
    const queryId = getQueryParam("id");

    $.ajax({
        url: '@Url.Action("GetLetterById", "WorkingOrder", new { area = "Purchasing" })',
        method: 'GET',
        data: { id: queryId },
        success: function (response) {
            if (response.success) {
                const data = response.data;
                const modifiedHtml = data.Html;
                const today = data.Date;
                const letterheadHTML = document.getElementById("letterhead").outerHTML;

                const formatSmartDate = (val) => {
                    if (!val) return '-';
                    if (val.toLowerCase() === "follow niterra schedule") return val;
                    if (moment(val, 'YYYY-MM-DD', true).isValid()) {
                        return moment(val, 'YYYY-MM-DD').format("LL");
                    }
                    return val;
                };

                const replacedFirstP = letterheadHTML.replace(
                    /<p class="text-lg font-bold text-center underline mt-4">([\s\S]*?)<\/p>/,
                    '<p style="text-align: center; margin-top: 16px; margin-bottom: 4px;">' +
                    '<span style="font-size: 16px; font-weight: bold; border-bottom: 1px solid black;">$1</span></p>'
                );

                const replacedBoth = replacedFirstP.replace(
                    /<p id="number" name="number" class="text-sm font-bold text-center underline">([\s\S]*?)<\/p>/,
                    '<p id="number" name="number" style="text-align: center; margin-bottom: 2px;">' +
                    '<span style="font-weight: bold; border-bottom: 1px solid black;">$1</span></p>'
                );

                const letterhead = replacedBoth;
                const paymentValue = (data.PaymentTerm).replace(/\n/g, "<br>");

                const modifiedLetterhead = letterhead.replace(
                    '<div id="line"',
                    '<div id="line" style="width: 100%; gap: 1px;"'
                ).replace(
                    /class="self-stretch h-0 outline outline-1 outline-offset-\[-0\.50px\] outline-black"/g,
                    'style="width: 100%; border-bottom: 1px solid black;"'
                );

                // === 1. GENERATE STATIS ROW TABEL PRICE UNTUK PDF ===
                let priceRowsHtml = "";
                if (data.PriceRows && data.PriceRows.length > 0) {
                    data.PriceRows.forEach(function (row) {
                        priceRowsHtml += `
            <tr>
                <td style="border: 0.5px solid #ccc; padding: 4px; text-align: left;">${formatRupiah(row.Price_Before)}</td>
                <td style="border: 0.5px solid #ccc; padding: 4px; text-align: left;">${formatRupiah(row.Discount)}</td>
                <td style="border: 0.5px solid #ccc; padding: 4px; text-align: left; font-weight: bold;">${formatRupiah(row.Price_Total)}</td>
            </tr>
        `;
                    });
                } else {
                    priceRowsHtml += `
        <tr>
            <td colspan="3" style="border: 0.5px solid #ccc; padding: 4px; text-align: center;">-</td>
        </tr>
    `;
                }
                // ===================================================

                const letterbody = `
                <table class="table-fixed w-full text-[10px]">
                    <tbody>
                        <tr><td class="w-[170px] text-[12px] align-top">To</td><td class="text-[12px]">: ${data.VendorCode} - ${data.Vendor}</td></tr>
                        <tr><td class="w-[170px] text-[12px] align-top">Attn</td><td class="text-[12px]">: ${data.Attn}</td></tr>
                        <tr><td class="w-[170px] text-[12px] align-top">Ref Quotation No & Date</td><td class="text-[12px]">: ${data.Ref}</td></tr>
                        <tr><td class="w-[170px] text-[12px] align-top">Project</td><td class="max-w-[360px] text-[12px]"><span style="font-weight: normal;">: </span><span style="font-weight: bold;">${data.Project}</span><br>${modifiedHtml}</td></tr>

                        <tr>
                            <td class="w-[170px] text-[12px] align-top">Price</td>
                            <td class="align-top text-[12px]">
                                <div style="display: flex; align-items: flex-start; gap: 0.3em;">
                                    <span style="">:</span>
                                    <div style="flex-grow: 1; width: 100%;">
                                        <table style="width: 100%; border-collapse: collapse; font-size: 10pt;">
                                            <thead>
                                                <tr style="background-color: #f3f4f6;">
                                                    <th style="border: 0.5px solid #ccc; padding: 4px; text-align: left; font-size: 11px;">Before</th>
                                                    <th style="border: 0.5px solid #ccc; padding: 4px; text-align: left; font-size: 11px;">Discount</th>
                                                    <th style="border: 0.5px solid #ccc; padding: 4px; text-align: left; font-size: 11px;">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${priceRowsHtml}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="w-[170px] text-[12px] align-top">Date</td>
                            <td class="text-[12px]">: ${moment(data.Date).format('LL')}</td>
                        </tr>
                        <tr><td class="w-[170px] text-[12px] align-top">Total</td><td class="text-[12px]"><span style="font-weight: normal;">: </span><span style="font-weight: bold;">${formatRupiah(data.Total)}</span></td></tr>
                        <tr>
                            <td class="w-[170px] text-[12px] align-top">Payment Term</td>
                            <td class="align-top text-[12px]" style="vertical-align: top;">
                                <div style="display: flex; align-items: flex-start;">
                                    <span style="margin-right: 0.3em;">:</span>
                                    <div style="white-space: pre-line;">${paymentValue}</div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="w-[170px] text-[12px] align-top">Start Date</td>
                            <td class="text-[12px]">: ${formatSmartDate(data.StartDate)}</td>
                        </tr>
                        <tr>
                            <td class="w-[170px] text-[12px] align-top">End Date</td>
                            <td class="text-[12px]">: ${formatSmartDate(data.EndDate)}</td>
                        </tr>
                        <tr><td class="w-[170px] text-[12px] align-top">Budget No</td><td class="text-[12px]"><span style="font-weight: normal;">: </span><span style="font-weight: bold;">${data.BudgetNo}</span></td></tr>
                        <tr><td class="w-[170px] text-[12px] align-top">Remark</td><td class="text-[12px]">: ${data.Remark}</td></tr>
                    </tbody>
                </table>
                <p class="text-[12px] mt-2">Please attached working order confirmation together with Invoice.</p>`;

                const approval = document.getElementById("approval").outerHTML;

                const fullDoc = `
                    <div style="margin: 0; width: 21cm; height: 29.7cm; padding: 2cm; font-size: 10pt;" class="bg-white mx-auto">
                        ${modifiedLetterhead}
                        <div class="mt-6">${letterbody}</div>
                        <div class="mt-6">${approval}</div>
                    </div>`;

                const element = document.createElement('div');
                element.innerHTML = fullDoc;

                const opt = {
                    margin: 0,
                    filename: `WO_${data.Number}.pdf`,
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: {
                        scale: 2,
                        useCORS: true,
                        logging: false
                    },
                    jsPDF: {
                        unit: 'mm',
                        format: 'a4',
                        orientation: 'portrait'
                    }
                };

                html2pdf().set(opt).from(element).toPdf().get('pdf').then((pdf) => {
                    if (pdf.internal.pages.length > 1) {
                        pdf.deletePage(2);
                    }
                    return pdf.output('blob');
                }).then((pdfBlob) => {
                    const blobUrl = URL.createObjectURL(pdfBlob);
                    window.open(blobUrl, '_blank');
                });
            }
        },
        error: function() {
            Swal.fire('Error', 'Failed to retrieve letter data', 'error');
        }
    });
}

function downloadpdf() {
    const queryId = getQueryParam("id");

    // Menampilkan loading UI saat memproses PDF
    Swal.fire({
        title: 'Generating PDF...',
        text: 'Please wait a moment.',
        allowOutsideClick: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });

    $.ajax({
        url: '@Url.Action("GetLetterById", "WorkingOrder", new { area = "Purchasing" })',
        method: 'GET',
        data: { id: queryId },
        success: function (response) {
            if (response.success) {
                const data = response.data;
                const modifiedHtml = data.Html || "";
                const letterheadHTML = document.getElementById("letterhead").outerHTML;

