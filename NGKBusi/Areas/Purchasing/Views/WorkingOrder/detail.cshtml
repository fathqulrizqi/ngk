               return option.text;
           }

           function formatBudgetSelection(option) {
               if (!option.id) {
                   return option.text;
               }
               const description = $(option.element).data('description');
               if (description) {
                   return $(`<span>${option.id} | ${description}</span>`);
               }
               return option.text;
           }
               const startPlaceholder = $("#startDate").attr("placeholder");
