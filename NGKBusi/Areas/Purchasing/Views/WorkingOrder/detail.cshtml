function loadLetterIfExists(idList) {
    $.ajax({
        url: '@Url.Action("GetLetterById", "WorkingOrder", new { area = "Purchasing" })',
        method: 'GET',
        data: { id: idList },
        success: function (response) {
            if (response.success) {
                const d = response.data;
                console.log('data', d);

                // === 1. RENDER PRICE ROWS DARI DATABASE DI AWAL ===
                $("#priceTable tbody").empty();
                if (d && d.PriceRows && d.PriceRows.length > 0) {
                    d.PriceRows.forEach(function (row) {
                        $("#priceTable tbody").append(`
                            <tr class="price-row">
                                <td class="border border-gray-300 p-1">
                                    <input type="text" class="price-before border rounded w-full px-2 py-1 text-sm bg-white" value="${formatRupiah(row.Price_Before)}" autocomplete="off" />
                                </td>
                                <td class="border border-gray-300 p-1">
                                    <input type="text" class="price-discount border rounded w-full px-2 py-1 text-sm bg-white" value="${formatRupiah(row.Discount)}" autocomplete="off" />
                                </td>
                                <td class="border border-gray-300 p-1 bg-gray-50">
                                    <input type="text" class="price-total border rounded w-full px-2 py-1 text-sm font-bold text-gray-700" value="${formatRupiah(row.Price_Total)}" readonly />
                                </td>
                                <td class="border border-gray-300 p-1 text-center">
                                    <button type="button" class="remove-price-row px-2 py-1 bg-red-600 text-white rounded text-xs hover:bg-red-700 transition">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        `);
                    });
                } else {
                    $("#priceTable tbody").append(generatePriceRow());
                }

                // === 2. JALANKAN VALIDASI PREVIEW SETELAH ELEMENT PRICE TERBENTUK ===
                if (response.success && response.data.NIKApproval) {
                    transformToPreviewMode(response.data);
                }

                setTinyMCEContent(d.Html);
                $('#idLetter').val(d.ID);
                $('#idList').val(d.IDList);
                $('#number').text(d.Number);
                $('#attn').val(d.Attn);
                $('#ref').val(d.Ref);
                $('#project').val(d.Project);
                $("#total").val(formatRupiah(d.Total));
                $('#payment').val(d.PaymentTerm);

                loadIfExist(d);

                $('#remark').val(d.Remark);
                $('#dateprepared').text(formatDotNetDate(d.DatePrepared) || "");
                $('#nameprepared').text(d.NamePrepared || "");

                if ('@ViewBag.userNIK' != d.NIKPrepared) {
                    transformToPreviewMode(response.data);
                    $("#buttonlock").hide();
                }

                const approvalBtn = $('#approvalbtn');
                if (d.NIKApproval) {
                    approvalBtn.html(`
                        <div class="flex w-[70px] h-[70px] py-[15px] flex-col items-center gap-[9px]"
                             style="background-image: url('@Url.Content("~/images/stamp.svg")'); background-size: cover; background-repeat: no-repeat; background-position: center;">
                            <p class="text-[10px] leading-[10px] font-bold text-red-500 font-inter text-center">
                                ${d.NIKApproval}
                            </p>
                            <p class="text-[10px] leading-[10px] font-normal text-red-500 font-inter text-center">
                                ${formatDotNetDate(d.DateApproval)}
                            </p>
                        </div>
                    `);
                    approvalBtn.prop('disabled', true);
                }

                if (d.Timestamps) {
                    $('#timestampsletters').text("Last Modified: " + d.Timestamps);
                }

                if (d.BudgetNo && d.BudgetNo.trim() !== "") {
                    const budgetNos = d.BudgetNo.split(',').map(b => b.trim()).filter(Boolean);
                    $('#budgetNo').val(budgetNos).trigger('change');
                } else {
                    $('#budgetNo').val(null).trigger('change');
                }
            }
        },
    });
}


    </script>

    <script>

        function formatDotNetDate(dotNetDate) {
            if (!dotNetDate) return '';

            // Handle .NET date format
            const matches = dotNetDate.match(/\/Date\((\d+)\)\//);
            if (matches) {
                return moment(parseInt(matches[1])).format('DD-MM-YYYY');
            }

            // Handle regular date string
            const momentDate = moment(dotNetDate);
            return momentDate.isValid() ? momentDate.format('DD-MM-YYYY') : '';
        }

        function formatRupiah(value) {
            if (!value) value = 0;
            return accounting.formatMoney(value, {
                symbol: "Rp ",
                precision: 0,       
                thousand: ".",    
                decimal: ","       
            });
        }

        function unformatRupiah(value) {
            let strVal = (value || "").toString();
            strVal = strVal.replace(/Rp|\s|\./g, '');
            strVal = strVal.replace(',', '.');
            return parseFloat(strVal) || 0;
        }


    function getBudgetInfo() {
        const selectedOptions = $('#budgetNo').select2('data');
        const budgetNos = [];
        const budgetDescs = [];

        selectedOptions.forEach(option => {
            budgetNos.push(option.id);
            const description = $(option.element).data('description') || '';
            budgetDescs.push(description);
        });

        return {
            numbers: budgetNos.join(', '),
            descriptions: budgetDescs.join(', ')
        };
    }


function SaveLetterData() {
    const totalValue = unformatRupiah($("#total").val());
    const queryId = getQueryParam("id");
    const raw = $("#timestamps").val();
    const formattedTimestamp = formatTimestampUS(raw);
    const day = $("#date").text();
    const unformatDate = formatDotNetDate(day);
    const budgetInfo = getBudgetInfo();
    const selectedBudgets = $('#budgetNo').select2('data');
    const budgetNos = selectedBudgets.map(item => item.id).join(', ');
    const budgetDescs = selectedBudgets
        .map(item => $(item.element).data('description') || '')
        .filter(desc => desc)
        .join(', ');

    let priceRows = [];
    $(".price-row").each(function () {
        let row = $(this);
        priceRows.push({
            Price_Before: unformatRupiah(row.find(".price-before").val()),
            Discount: unformatRupiah(row.find(".price-discount").val()),
            Price_Total: unformatRupiah(row.find(".price-total").val())
        });
    });

    const formatSmartDate = (val) => {
        if (!val || val.trim() === "") return "";
        if (val.toLowerCase() === "follow niterra schedule") return val;
        if (moment(val, 'DD-MM-YYYY', true).isValid()) {
            return moment(val, 'DD-MM-YYYY').format("YYYY-MM-DD");
        }
        return "";
    };

    let htmlContent = tinymce.get("project-field")?.getContent();
    if (htmlContent) {
        htmlContent = htmlContent
            .replace(/<table/g, '<table class="mce-table" style="border-collapse: collapse; width: 100%; border: 0.5px solid rgba(0, 0, 0, 0.7);"')
            .replace(/<td(?![^>]*style=)[^>]*>/g, '<td style="border: 0.5px solid rgba(0, 0, 0, 0.7);">')
            .replace(/<td([^>]*?)style="([^"]*?)"/g, '<td$1style="$2; border: 0.5px solid rgba(0, 0, 0, 0.7);"');
    }

    $.ajax({
        url: '@Url.Action("SaveLetter", "WorkingOrder", new { area = "Purchasing" })',
        type: 'POST',
        data: {
            IDList: $("#idList").val(),
            Number: $("#number").text(),
            Vendor: $("#vendor").text(),
            Attn: $("#attn").val(),
            Ref: $("#ref").val(),
            Project: $("#project").val(),
            Html: htmlContent,
            Date: unformatDate,
            Total: totalValue,
            PaymentTerm: $("#payment").val(),
            StartDate: formatSmartDate($("#startDate").val()),
            EndDate: formatSmartDate($("#endDate").val()),
            BudgetNo: budgetNos,
            BudgetDesc: budgetDescs,
            Remark: $("#remark").val(),
            Prepared: '@ViewBag.userNIK',
            PreparedName: '@ViewBag.username',
            Timestamps: formattedTimestamp,
            PriceRowsJson: JSON.stringify(priceRows)
        },
        beforeSend: function () {
            var $btn = $('#savebutton');
            $btn.prop('disabled', true);
            $btn.html(
                '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving Data ...'
            );
        },
        success: function (response) {
            if (response.success) {
                Swal.fire({
                    title: 'Success',
                    text: response.message,
                    icon: 'success',
                    confirmButtonText: 'OK'
                }).then(() => {
                    window.location.href = '@Url.Action("Detail", "WorkingOrder", new { area = "Purchasing" })' + '?id=' + queryId;
                });
            } else {
                Swal.fire('Warning', response.message, 'warning');
            }
        },
        error: function () {
            Swal.fire('Error', 'Something went wrong', 'error');
        }
    });
}


