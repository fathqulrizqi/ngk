@{
    ViewBag.Title = "Plug Cap Palet Records";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

@section scriptHead{
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.0/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/ui/1.14.0/jquery-ui.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3"></script>

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3/dist/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/printThis/1.15.0/printThis.min.js"></script>
    }
@{
    var FGTagList = ViewBag.FGTagList as List<NGKBusi.Areas.Production.Models.Production_PlugCap_Tag_FG> ?? new List<NGKBusi.Areas.Production.Models.Production_PlugCap_Tag_FG>();
}
<style>
    .datatable-input {
        border: 1px solid #d1d5db;
        background-color: white;
        border-radius: 0.5rem;
        outline: none;
    }


        .datatable-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

    @@media print {
        #modalContentContainer {
            height: auto !important;
            max-height: none !important;
            overflow: visible !important;
        }
        #modalContentContainer .border,
        #modalContentContainer .border-b,
        #modalContentContainer .border-t,
        #modalContentContainer .border-gray-200,
        #modalContentContainer .border-gray-300,
        #modalContentContainer table,
        #modalContentContainer th,
        #modalContentContainer td {
            border-color: #000000 !important; 
        }

        .break-inside-avoid {
            page-break-inside: avoid;
        }
    }
</style>
<body class=" min-h-screen font-sans text-gray-800 bg-gray-100">
    <div class="px-6 border-b border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">
                <i class="fa-solid fa-boxes-stacked text-blue-600 mr-2"></i>Plug Cap Palet Records
            </h1>
            <p class="text-sm text-gray-500 mt-1">Manage production pallets</p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="getSelectedAndOpenBatch()" class="bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 shadow flex items-center gap-2">
                <i class="fa-solid fa-layer-group"></i> View Selected Details
            </button>
            <button onclick="openQrModal()" class="group bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg shadow-md transition-all duration-200 flex items-center gap-2">
                <i class="fa-solid fa-qrcode group-hover:scale-110 transition-transform"></i>
                <span>Scan QR / Input</span>
            </button>
        </div>
    </div>

    <div class="px-6 border shadow-sm mt-3 bg-white pt-2">
        <div class="overflow-x-auto">
            <table id="palletTable" class="w-full text-sm text-left bg-white border">
                <thead class="bg-gray-50 text-gray-700 font-semibold uppercase">
                    <tr>
                        <th>
                            <input type="checkbox" id="checkAll" class="pallet-checkbox w-4 h-4">
                        </th>
                        <th>Pallet No</th>
                        <th>Part No</th>
                        <th>Type</th>
                        <th>Lot No</th>
                        <th>Qty</th>
                        <th>Created At</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (FGTagList != null && FGTagList.Any())
                    {
                        foreach (var item in FGTagList)
                        {
                            <tr class="hover:bg-blue-50 transition-colors">
                                <td>
                                    <input type="checkbox" class="pallet-checkbox w-4 h-4" value="@item.id">
                                </td>
                                <td class="font-medium text-blue-600">@item.pallet_no</td>
                                <td>@item.part_no</td>
                                <td>
                                    <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs font-bold">
                                        @item.type
                                    </span>
                                </td>
                                <td>@item.lot_no</td>
                                <td class="font-bold text-gray-800">@item.qty</td>
                                <td class="text-gray-500">
                                    @if (item.created_at != null)
                                    {@item.created_at.Value.ToString("dd MMM yyyy HH:mm")}
                                </td>
                                <td>
                                    <div class="flex justify-center gap-2">
                                        <button onclick="showDetail('@item.id')" class="p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-100 rounded-full transition-all" title="Detail">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                        <button onclick="confirmDelete('@item.id')" class="p-2 text-gray-500 hover:text-red-600 hover:bg-red-100 rounded-full transition-all" title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="qrModal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-gray-900 bg-opacity-80 transition-opacity backdrop-blur-sm"></div>

        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4">

                <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-2xl transition-all w-full max-w-lg">

                    <div class="flex justify-between items-center bg-gray-50 px-6 py-4 border-b border-gray-100">
                        <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                            <i class="fa-solid fa-qrcode text-blue-600"></i> Scan / Input Pallet
                        </h3>
                        <button onclick="closeQrModal()" class="text-gray-400 hover:text-red-500 transition-colors">
                            <i class="fa-solid fa-xmark text-xl"></i>
                        </button>
                    </div>

                    <div class="px-6 py-6">

                        <div class="mb-6">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Manual Input</label>
                            <div class="flex gap-2">
                                <div class="relative w-full">
                                    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                                        <i class="fa-solid fa-keyboard text-gray-400"></i>
                                    </div>
                                    <input type="text" id="qrInput"
                                           class="block w-full pl-10 pr-3 py-2.5 text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
                                           placeholder="Type pallet ID here..." autocomplete="off">
                                </div>
                                <button onclick="processQr()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors shadow-sm">
                                    <i class="fa-solid fa-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="bg-gray-50 px-6 py-3 flex justify-end gap-3 border-t border-gray-100">
                        <button type="button" onclick="closeQrModal()" class="px-4 py-2 bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-100 font-medium text-sm transition-colors">
                            Cancel
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div id="batchDetailModal" class="fixed inset-0 z-[60] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-gray-900 bg-opacity-75 transition-opacity backdrop-blur-sm"></div>

        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">

                <div class="relative transform overflow-hidden rounded-xl bg-gray-50 text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-6xl">

                    <div class="bg-blue-700 px-6 py-4 flex justify-between items-center sticky top-0 z-20 shadow-md">
                        <h3 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-layer-group"></i> Batch View Pallets
                        </h3>
                        <div class="flex gap-3">
                            <button onclick="printBatchContent()" class="text-sm bg-blue-600 hover:bg-blue-500 text-white border border-blue-400 px-3 py-1 rounded transition flex items-center gap-2">
                                <i class="fa-solid fa-print"></i> Print View
                            </button>
                            <button onclick="closeBatchModal()" class="text-white hover:text-red-200 transition-colors">
                                <i class="fa-solid fa-xmark text-2xl"></i>
                            </button>
                        </div>
                    </div>

                    <div id="modalContentContainer" class="px-6 py-6 max-h-[80vh] overflow-y-auto space-y-8">
                    </div>

                    <div class="bg-white px-6 py-4 border-t flex justify-end">
                        <button onclick="closeBatchModal()" class="px-6 py-2 bg-gray-600 text-white rounded hover:bg-gray-700">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

    <script>
            function printBatchContent() {
                $('#modalContentContainer').printThis({
                    importCSS: true,
                    importStyle: true,
                    loadCSS: "https://cdn.tailwindcss.com",
                    pageTitle: "Batch Pallet Records",
                    header: `
            <div class="text-center mb-4 border-b pb-2">
                <h1 class="text-2xl font-bold text-gray-800">Batch Pallet Report</h1>
                <p class="text-sm text-gray-500">Dicetak pada: ${new Date().toLocaleString('id-ID')}</p>
            </div>
        `,
                    footer: '<div class="text-center text-xs text-gray-400 mt-4">Dokumen ini digenerate oleh sistem.</div>',
                    base: true,
                    formValues: true,
                    removeScripts: false,
                    copyTagClasses: true
                });
            }
            let html5QrcodeScanner = null;

            document.addEventListener("DOMContentLoaded", function () {
                new simpleDatatables.DataTable("#palletTable", {
                    searchable: true, fixedHeight: false, perPage: 10, columns: [
                        { select: 0, sortable: false }
                    ] });
            });
            const modal = document.getElementById('qrModal');
            const qrInput = document.getElementById('qrInput');
            const readerDiv = document.getElementById('reader');

            function openQrModal() {
                modal.classList.remove('hidden');
                qrInput.value = '';

                qrInput.focus();

            }

            function closeQrModal() {
                modal.classList.add('hidden');
            }


            function processQr() {
                const code = qrInput.value;
                if (!code) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Empty Input',
                        text: 'Please type a code or scan a QR',
                        timer: 2000
                    });
                    return;
                }
                const code_baru = code.replace(" -", "-")
                closeQrModal();
                processResult(code_baru);
            }

            function processResult(code) {
                Swal.fire({
                    title: 'Processing...',
                    text: 'Checking Pallet: ' + code,
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading() }
                });


                let cleanCode = code.replace(/\s+/g, ' ').trim();

                $.ajax({
                    url:'@Url.Action("inputFGTag", "PlugCapPaletRecord")',
                    type: 'POST',
                    data: { data: cleanCode },
                    success: function (response) {
                        console.log(response);
                        if (response.success) {

                            Swal.fire({
                                icon: 'success',
                                title: 'Found!',
                                text: 'Redirecting to details...',
                                timer: 1000,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = response.redirectUrl;

                            });

                        } else {
                            Swal.fire('Error', response.message || 'Data not found', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'Server connection failed', 'error');
                    }
                });

            }

            qrInput.addEventListener("keypress", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    processQr();
                }
            });

            function showDetail(id) {
                var url = '@Url.Action("Detail", "PlugCapPaletRecord", new { id = "-1" })';
                url = url.replace("-1", id);
                window.location.href = url;
            }
            function confirmDelete(id) {
            Swal.fire({
                title: 'Hapus Pallet?',
                text: "Data Pallet beserta seluruh Part di dalamnya akan dihapus permanen!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Ya, Hapus!',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {

                    Swal.fire({
                        title: 'Menghapus...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading() }
                    });

                    $.ajax({
                        url: '@Url.Action("deleteFGTag", "PlugCapPaletRecord")',
                        type: 'POST',
                        data: { id: id },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Terhapus!',
                                    text: response.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Gagal', response.message, 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            Swal.fire('Error', 'Terjadi kesalahan sistem.', 'error');
                        }
                    });
                }
            });
            }
        function getSelectedAndOpenBatch() {
            let selectedIds = [];

            const checkboxes = document.querySelectorAll('.pallet-checkbox:checked');

            checkboxes.forEach((checkbox) => {
                const val = parseInt(checkbox.value);
                if (!isNaN(val) && val > 0) {
                    selectedIds.push(val);
                }
            });


            if (selectedIds.length === 0) {
                Swal.fire('Info', 'Silakan centang data di tabel terlebih dahulu.', 'info');
            } else {
                openBatchDetailModal(selectedIds);
            }
        }

        function formatDate(dateString, withTime = false) {
            if (!dateString) return '-';

            let date;

            if (typeof dateString === 'string' && dateString.includes('/Date(')) {
                const timeValue = parseInt(dateString.replace(/\D/g, ''));
                date = new Date(timeValue);
            } else {
                date = new Date(dateString);
            }

            if (isNaN(date.getTime())) {
                return 'Invalid Date';
            }

            const options = {
                day: 'numeric',
                month: 'short',
                year: 'numeric'
            };

            if (withTime) {
                options.hour = '2-digit';
                options.minute = '2-digit';
                options.hour12 = false;
            }

            return date.toLocaleDateString('id-ID', options).replace(/\./g, ':');
        }

function openBatchDetailModal(selectedIds) {
    if (!selectedIds || selectedIds.length === 0) {
        Swal.fire('Peringatan', 'Pilih setidaknya satu data FG Tag.', 'warning');
        return;
    }

    Swal.fire({
        title: 'Memuat Batch Data...',
        didOpen: () => Swal.showLoading()
    });

    $.ajax({
        url: '@Url.Action("GetBatchPalletDetails", "PlugCapPaletRecord")',
        type: 'POST',
        data: { ids: selectedIds },
        success: function (response) {
            Swal.close();
            if (response.success) {
                renderBatchData(response.data);
                document.getElementById('batchDetailModal').classList.remove('hidden');
            } else {
                Swal.fire('Error', response.message, 'error');
            }
        },
        error: function () {
            Swal.close();
            Swal.fire('Error', 'Gagal mengambil data.', 'error');
        }
    });
}

function closeBatchModal() {
    document.getElementById('batchDetailModal').classList.add('hidden');
}

function renderBatchData(dataList) {
    const container = document.getElementById('modalContentContainer');
    container.innerHTML = '';

    dataList.forEach((item, index) => {
        const header = item.header;
        const details = item.details;

        let totalPartQty = details.reduce((acc, curr) => acc + curr.qty, 0);

        let rowsHtml = '';
        if (details.length > 0) {
            details.forEach((part, idx) => {
                rowsHtml += `
                    <tr class="border-b hover:bg-gray-50">
                        <td class="px-4 py-2 text-center text-gray-500">${idx + 1}</td>
                        <td class="px-4 py-2 font-medium text-gray-800">${part.part_no}</td>
                        <td class="px-4 py-2">${part.type}</td>
                        <td class="px-4 py-2">${part.lot_prod}</td>
                        <td class="px-4 py-2 text-gray-600">${formatDate(part.tgl_repacking)}</td>
                        <td class="px-4 py-2">${part.BN}</td>
                        <td class="px-4 py-2 text-right font-bold text-green-700">${part.qty}</td>
                    </tr>
                `;
            });
        } else {
            rowsHtml = `<tr><td colspan="7" class="text-center py-4 italic text-gray-400">Tidak ada detail part.</td></tr>`;
        }

        const cardHtml = `
            <div class="bg-white border border-gray-300 rounded-lg shadow-sm overflow-hidden break-inside-avoid">
                <div class="bg-gradient-to-r from-blue-50 to-white px-6 py-4 border-b border-gray-200">
                    <div class="flex justify-between items-start">
                        <div>
                            <h4 class="text-2xl font-extrabold text-blue-900 mt-1">${header.type}</h4>
                            <div class="text-sm text-gray-500 mt-1 flex gap-4">
                                <span><i class="fa-regular fa-clock"></i> Input Time: ${formatDate(header.created_at, true)}</span>
                                <span><i class="fa-solid fa-layer-group"></i> Lot FG: <b>${header.lot_no}</b></span>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-xs text-gray-500 uppercase">FG Part No</div>
                            <div class="text-xl font-bold text-gray-800">${header.part_no}</div>
                            <div class="text-sm font-semibold text-gray-600">${header.pallet_no}</div>
                        </div>
                    </div>

                    <div class="mt-4 flex items-center gap-2 text-sm">
                        <span class="text-gray-600">Total Qty FG: <b>${header.qty}</b></span>
                        ${totalPartQty != 0
                            ? `
                                <span class="text-gray-400 mx-2">|</span>
                            <span class="${totalPartQty === header.qty ? 'text-green-600' : 'text-red-500'} font-bold">
                                Total Scanned: ${totalPartQty}
                            </span>
                            ${totalPartQty === header.qty
                                    ? '<i class="fa-solid fa-circle-check text-green-500"></i>'
                                    : '<i class="fa-solid fa-triangle-exclamation text-red-500" title="Qty tidak match"></i>'
                                }
                          `
                                : ''
                        }
                    </div>
                </div>

                <div class="px-6 py-4">
                    <table class="w-full text-sm text-left text-gray-500 border border-gray-200">
                        <thead class="text-xs text-gray-700 uppercase bg-gray-100">
                            <tr>
                                <th class="px-4 py-2 text-center w-12">No</th>
                                <th class="px-4 py-2">Part No</th>
                                <th class="px-4 py-2">Type</th>
                                <th class="px-4 py-2">Lot Prod</th>
                                <th class="px-4 py-2">Tgl Repack</th>
                                <th class="px-4 py-2">BN</th>
                                <th class="px-4 py-2 text-right">Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${rowsHtml}
                        </tbody>
                    </table>
                </div>
            </div>
        `;

        container.innerHTML += cardHtml;
    });
        }
    </script>
    <script>
        $(document).ready(function () {

            $(document).on('click', '#checkAll', function (e) {
                e.stopPropagation(); 
                var isChecked = $(this).is(':checked');

                $('.pallet-checkbox').prop('checked', isChecked);
            });

            $(document).on('change', '.pallet-checkbox', function () {
                var totalCheckboxes = $('.pallet-checkbox').length;
                var totalChecked = $('.pallet-checkbox:checked').length;

                $('#checkAll').prop('checked', totalCheckboxes > 0 && totalCheckboxes === totalChecked);
            });

        });
    </script>
</body>
