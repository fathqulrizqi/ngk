<style>
    /* CSS Khusus Kawasaki agar tidak mengganggu layout lain */
    .kws-page {
        width: 100%;
        max-width: 21cm;
        aspect-ratio: 21 / 29.7;
        padding: 5% 9.76% 5% 9.76%;
        box-sizing: border-box;
        background: #fff;
        margin: 0 auto;
    }

    .card-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: repeat(5, 1fr);
        column-gap: 6.5%;
        row-gap: 2%;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
    }

    .card-table {
        width: 100%;
        height: 100%;
        border: 1px solid black;
        border-collapse: collapse;
    }

    .kws-border {
        border: 1px solid black !important;
    }

    @@media print {
        .kws-page {
            font-size: 12px !important;
            box-shadow: none !important;
            border: none !important;
            margin: 0 !important;
            max-width: 100%;
            page-break-after: always;
            break-after: page;
        }

        .card-table tbody {
            font-size: 12px !important;
        }
    }
</style>

@{
    var data = ViewBag.Data as NGKBusi.Areas.Production.Models.Production_PlugCup_QrGenerator_History;
    var details = ViewBag.Details as List<NGKBusi.Areas.Production.Models.Production_PlugCup_QrGenerator_History_Detail> ?? new List<NGKBusi.Areas.Production.Models.Production_PlugCup_QrGenerator_History_Detail>();

    bool isDetailEmpty = details.Count == 0;
    string displayFrontQr = ViewBag.DisplayFrontQr as string;

    // 10 Item per halaman (Kapasitas grid 5x2)
    int totalChunks = isDetailEmpty ? 1 : (int)Math.Ceiling(details.Count / 10.0);
}

@for (int c = 0; c < totalChunks; c++)
{
    var chunkDetails = isDetailEmpty ? null : details.Skip(c * 10).Take(10).ToList();

    <!-- ================= PAGE DEPAN ================= -->
    <div class="kws-page shadow-lg flex flex-col @(c > 0 ? "page-break" : "")">
        <div class="card-grid">
            @for (int i = 0; i < 10; i++)
            {
                bool shouldRenderBox = isDetailEmpty || (chunkDetails != null && i < chunkDetails.Count);
                
                string ird_no = data.IRD_No.ToString();

                string formattedDate = DateTime.ParseExact(ird_no, "ddMMyy", System.Globalization.CultureInfo.InvariantCulture).ToString("dd-MM-yyyy");
                
                if (shouldRenderBox)
                {
                    <table class="card-table relative">
                        <colgroup>
                            <col style="width: 35.25%;">
                            <col style="width: 24.99%;">
                            <col style="width: 13.25%;">
                            <col style="width: 13.25%;">
                            <col style="width: 13.25%;">
                        </colgroup>
                        <tbody class="font-bold text-left align-middle" style="font-size: 9px; font-family: Arial, sans-serif;">
                            <tr>
                                <td class="kws-border px-1">Customer</td>
                                <td class="kws-border px-1" colspan="4">PT KAWASAKI MOTOR INDONESIA</td>
                            </tr>
                            <tr>
                                <td class="kws-border px-1">Part No</td>
                                <td class="kws-border px-1" colspan="4">@data.Part_No</td>
                            </tr>
                            <tr>
                                <td class="kws-border px-1">Part Name</td>
                                <td class="kws-border px-1" colspan="4">@data.Part_Name</td>
                            </tr>
                            <tr>
                                <td class="kws-border px-1">Model</td>
                                <td class="kws-border px-1" colspan="4">@data.Customer_Type</td>
                            </tr>
                            <tr>
                                <td class="kws-border px-1">Quantity</td>
                                <td class="kws-border px-1">@data.Qty</td>
                                <td class="kws-border px-1" colspan="3" rowspan="6"></td>
                            </tr>
                            <tr>
                                <td class="kws-border px-1">NITERRA Type No</td>
                                <td class="kws-border px-1">@data.Tipe</td>
                            </tr>
                            <tr>
                                <td class="kws-border px-1">Lot No</td>
                                <td class="kws-border px-1">@data.Lot_No</td>
                            </tr>
                            <tr>
                                <td class="kws-border px-1">Manufact Date</td>
                                <td class="kws-border px-1">@formattedDate<td>
                            </tr>
                            <tr>
                                <td class="kws-border px-1">Delivery Date</td>
                                <td class="kws-border px-1"></td>
                            </tr>
                            <tr>
                                <td class="kws-border px-1">Delivery Location</td>
                                <td class="kws-border px-1"></td>
                            </tr>
                            <tr>
                                <td class="kws-border px-1">Supplier</td>
                                <td class="kws-border px-1" colspan="4">PT NITERRA MOBILITY INDONESIA</td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="w-full h-full border kws-border"></div>
                }
            }
        </div>
    </div>

    <!-- ================= PAGE BELAKANG ================= -->
    if (!isDetailEmpty)
    {
        <div class="kws-page shadow-lg page-break">
            <div class="card-grid">
                @for (int i = 0; i < 10; i++)
                {
                    int row = i / 2;
                    int col = i % 2;
                    int mirroredCol = 1 - col;
                    int mappedIndex = (row * 2) + mirroredCol;
                    var mirroredItem = mappedIndex < chunkDetails.Count ? chunkDetails[mappedIndex] : null;

                    <div class="w-full h-full flex justify-center items-center border kws-border relative" style="padding: 4%;">
                        @if (mirroredItem != null)
                        {
                            <div class="qrcode-page2-container flex justify-center items-center w-full h-full" data-qr-text="@mirroredItem.QR_String"></div>
                            <div class="absolute bottom-1 right-2 text-gray-400" style="font-size: 7px;">@data.Customer Seq: @mirroredItem.Sequence_No</div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}
