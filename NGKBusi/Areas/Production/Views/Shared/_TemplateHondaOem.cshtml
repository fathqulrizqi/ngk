
@{
    var data = ViewBag.Data as NGKBusi.Areas.Production.Models.Production_PlugCup_QrGenerator_History;
    var details = ViewBag.Details as List<NGKBusi.Areas.Production.Models.Production_PlugCup_QrGenerator_History_Detail> ?? new List<NGKBusi.Areas.Production.Models.Production_PlugCup_QrGenerator_History_Detail>();

    bool isDetailEmpty = details.Count == 0;
    string displayFrontQr = ViewBag.DisplayFrontQr as string;
    int totalChunks = isDetailEmpty ? 1 : (int)Math.Ceiling(details.Count / 16.0);
}

@for (int c = 0; c < totalChunks; c++)
{
    var chunkDetails = isDetailEmpty ? null : details.Skip(c * 16).Take(16).ToList();

    <!-- PAGE DEPAN DEFAULT (GANJIL) -->
    <div class="page bg-white border shadow-lg flex flex-col m-0 @(c > 0 ? "page-break" : "")" style="width: 29.7cm; height: 21cm; padding: 1.2cm; box-sizing: border-box;">
        <div class="flex flex-wrap h-[100%] border" style="border-color: black !important;">
            @for (int i = 0; i < 16; i++)
            {
                bool shouldRenderBox = isDetailEmpty || (chunkDetails != null && i < chunkDetails.Count);
                <div class="col-3 h-[25%] border p-1" style="border-color: black !important; box-sizing: border-box;">
                    @if (shouldRenderBox)
                    {
                        <div class="border border-black h-100 p-2 relative" style="border-color: black !important;">
                            <table>
                                <colgroup><col class="w-[28.3%]"><col class="w-[0.2%]"><col class="w-[19%]"><col class="w-[23.5%]"><col class="w-[29%]"></colgroup>
                                <tbody class="font-bold" style="font-size:9px">
                                    <tr><td class="pr-1">Type</td><td class="px-1">:</td><td colspan="2">@(data.Tipe)</td><td rowspan="5" class="pl-2 qrcode-container" data-qr-text="@displayFrontQr"></td></tr>
                                    <tr><td class="pr-1">Part No</td><td class="px-1">:</td><td colspan="2" class="border-b border-dotted border-black" style="font-size:8.5px;">@(data.Part_No)</td></tr>
                                    <tr><td class="pr-1">Part Name</td><td class="px-1">:</td><td colspan="2" class="border-b border-dotted border-black" style="font-size:8.5px;">@(data.Part_Name)</td></tr>
                                    <tr><td class="pr-1">Quantity</td><td class="px-1">:</td><td colspan="2" class="border-b border-dotted border-black" style="font-size:8.5px;">@(data.Qty) Pcs</td></tr>
                                    <tr><td class="pr-1">No.Lot Prod</td><td class="px-1">:</td><td colspan="2" class="border-b border-dotted border-black" style="font-size:8.5px;">@(data.Lot_No)</td></tr>
                                    <tr><td class="pr-1" style="font-size:9px;">Tgl Inspection</td><td class="px-1">:</td><td colspan="3" class="border-b border-dotted border-black" style="font-size:8.5px;">@(data.Tgl_Inspection.HasValue ? data.Tgl_Inspection.Value.ToString("dd/MM/yyyy") : "")</td></tr>
                                    <tr><td class="pr-1" style="font-size:9px;">Tgl Kirim</td><td class="px-1">:</td><td colspan="3" class="border-b border-dotted border-black"></td></tr>
                                    <tr><td colspan="5" style="font-size:8.5px;">S/C : PT. NITERRA MOBILITY INDONESIA</td></tr>
                                    <tr><td class="pr-1" style="font-size:9px;">No. IRD</td><td class="px-1">:</td><td class="border-b border-dotted border-black" style="font-size:8.5px;">@(data.IRD_No)</td><td colspan="2"></td></tr>
                                    <tr><td class="pr-1" style="font-size:9px;">Inspector</td><td class="px-1">:</td><td colspan="2" class="border-b border-dotted border-black" style="font-size:8.5px;">@(data.Inspector)</td><td></td></tr>
                                </tbody>
                            </table>
                            <div class="w-[22%] h-[35%] top-[62%] right-[3%] absolute rounded-full border !border-dashed bg-white flex items-center justify-center" style="border-color: black !important;">
                                <span><b>OK</b></span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- PAGE BELAKANG DEFAULT (GENAP) -->
    if (!isDetailEmpty)
    {
        <div class="page bg-white border shadow-lg m-0 page-break" style="width: 29.7cm; height: 21cm; padding: 1.2cm; box-sizing: border-box; page-break-before: always;">
            <div class="flex flex-wrap h-[100%] border" style="border-color: black !important;">
                @for (int i = 0; i < 16; i++)
                {
                    int row = i / 4; int col = i % 4; int mirroredRow = 3 - row; int mappedIndex = (mirroredRow * 4) + col;
                    var mirroredItem = mappedIndex < chunkDetails.Count ? chunkDetails[mappedIndex] : null;

                    <div class="col-3 h-[25%] border p-1" style="border-color: black !important; box-sizing: border-box;">
                        <div class="border border-black h-100 p-2 flex justify-center items-center relative" style="border-color: black !important; height: 100%;">
                            @if (mirroredItem != null)
                            {
                                <div class="qrcode-page2-container flex justify-center items-center w-full h-full" data-qr-text="@mirroredItem.QR_String"></div>
                                <div class="absolute bottom-1 right-2 text-gray-400" style="font-size: 7px;">@data.Customer Seq: @mirroredItem.Sequence_No</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}