@{
    ViewBag.Title = "401 Autentikasi Diperlukan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center">
    <div style="font-size: 80px; color: #fd7e14; font-weight: bold;">
        401
    </div>
    <h2 style="margin-bottom: 20px;">Silakan Login Terlebih Dahulu</h2>

    <p class="lead" style="font-size: 18px; color: #6c757d;">
        Maaf, Anda harus login ke dalam sistem untuk dapat mengakses halaman ini.
    </p>

    <hr style="margin: 30px 0; border-top: 1px solid #e9ecef;" />

    <p style="color: #6c757d; margin-bottom: 30px;">
        Sesi Anda mungkin telah berakhir atau Anda belum terautentikasi. Silakan masuk menggunakan kredensial Anda untuk melanjutkan.
    </p>

    <a href="@Url.Action("Login", "User", new { area = "" })" class="btn btn-primary" style="padding: 10px 20px; font-size: 16px; text-decoration: none; color: #fff; background-color: #007bff; border-radius: 5px;">
        Menuju Halaman Login &rarr;
    </a>
</div>