    // Fungsi khusus untuk mengambil manpower dan langsung merender baris Detail pada mode EDIT
    function loadManpowerForEdit(sectionName, detailsData) {
        fetch(`@Url.Action("getManpower", "TransferLabor")?section=${encodeURIComponent(sectionName)}`, { cache: 'no-store' })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    currentManpowerList = res.data;
                    const tableBody = document.querySelector('#tableDetail tbody');
                    tableBody.innerHTML = ''; // Clear rows

                    // Render masing-masing baris dari data yang tersimpan
                    detailsData.forEach((detail, index) => {
                        addRow(); // Panggil addRow bawaan Anda

                        // Setelah baris ditambah, set nilainya berdasarkan data di database
                        const lastRow = tableBody.rows[tableBody.rows.length - 1];
                        const selectName = lastRow.querySelector('select[name="name[]"]');
                        selectName.value = detail.name;

                        // Trigger setNIK untuk memunculkan NIK
                        setNIK(selectName);

                        const planningSelect = lastRow.querySelector('select[name="planning[]"]');
                        if (planningSelect) planningSelect.value = detail.planning || '';

                        // Set Jam TL dan OT
                        lastRow.querySelector('input[name="transfer_labor_hours[]"]').value = detail.transfer_labor_hours;
                        lastRow.querySelector('input[name="transfer_overtime_hours[]"]').value = detail.transfer_overtime_hours;
                    });
                    updateTotalManPower();
                }
            });
    }

