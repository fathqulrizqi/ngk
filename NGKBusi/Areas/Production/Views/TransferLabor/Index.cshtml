            <input type="number" step="0.1" name="transfer_labor_hours[]" oninput="validateHours(this)" class="w-full border rounded p-1.5 text-sm text-center outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500" value="${lastLaborHours}">
        </td>
        <td class="px-3 py-2">
            <input type="number" step="0.1" name="transfer_overtime_hours[]" oninput="validateHours(this)" class="w-full border rounded p-1.5 text-sm text-center outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500" value="${lastOvertimeHours}">
        </td>
        <td class="px-3 py-2 text-center">
            <button type="button" onclick="removeRow(this)" class="text-red-400 hover:text-red-600 transition-colors cursor-pointer" title="Hapus Baris">
                <i class="fas fa-trash text-sm"></i>
            </button>
        </td>
    `;
        tableBody.appendChild(newRow);

        if (typeof updateTotalManPower === "function") updateTotalManPower();
    }

    // Fungsi removeRow yang sudah Anda miliki (ditambahkan panggilan updateTotalManPower)
    function removeRow(btn) {
        const row = btn.closest('tr');
        row.remove();

        // Re-index nomor baris
        const rows = document.querySelectorAll('#tableDetail tbody tr');
        rows.forEach((r, index) => {
            r.cells[0].innerText = index + 1;
        });

        // Update total setelah menghapus baris
        updateTotalManPower();
    }
</script>