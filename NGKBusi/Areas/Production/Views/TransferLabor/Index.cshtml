        </td>
        <td class="px-3 py-2">
            <select name="planning[]" class="w-full border rounded p-1.5 text-sm bg-white text-gray-700 outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500" required>
                <option value="PLANNED">PLANNED</option>
