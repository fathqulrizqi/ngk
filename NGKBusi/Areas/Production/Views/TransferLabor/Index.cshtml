    // Fungsi untuk menghitung maksimal jam dari Start Date & End Date
    function getMaxTransferHours() {
        const startInput = document.querySelector('input[name="start_date"]').value;
        const endInput = document.querySelector('input[name="end_date"]').value;

        if (!startInput || !endInput) return null; // Jika salah satu belum diisi

        const startDate = new Date(startInput);
        const endDate = new Date(endInput);
        const diffMs = endDate - startDate;

        if (diffMs < 0) return -1; // Jika End Date lebih kecil (salah input)

        // Konversi milisecond ke jam
        return diffMs / (1000 * 60 * 60);
    }

    // Fungsi validasi saat user memasukkan jam
    function validateHours(inputElement) {
        const maxHours = getMaxTransferHours();

        // 1. Cek apakah tanggal sudah diisi
        if (maxHours === null) {
            Swal.fire('Peringatan', 'Silakan isi Start Date & Time dan End Date terlebih dahulu!', 'warning');
            inputElement.value = '';
            return;
        }

        // 2. Cek apakah tanggal valid (End > Start)
        if (maxHours < 0) {
            Swal.fire('Error', 'Date of Completion harus lebih besar dari Start Date!', 'error');
            inputElement.value = '';
            return;
        }

        // 3. Ambil nilai TL dan OT di baris (tr) yang sama
        const tr = inputElement.closest('tr');
        const laborInput = tr.querySelector('input[name="transfer_labor_hours[]"]');
        const otInput = tr.querySelector('input[name="transfer_overtime_hours[]"]');

        const laborHours = parseFloat(laborInput.value) || 0;
        const otHours = parseFloat(otInput.value) || 0;
        const totalRowHours = laborHours + otHours;

        // 4. Validasi jumlahnya
        if (totalRowHours > maxHours) {
            Swal.fire({
                title: 'Melebihi Batas!',
                text: `Total jam (TL + TL OT) pada baris ini adalah ${totalRowHours} jam. Maksimal durasi berdasarkan tanggal yang dipilih adalah ${maxHours.toFixed(1)} jam.`,
                icon: 'warning',
                confirmButtonColor: '#1E555C'
            });

            // Kosongkan input terakhir yang memicu error
            inputElement.value = '';
        }
    }

    // Variabel global untuk menyimpan data karyawan hasil AJAX
let currentManpowerList = [];

// 1. Fungsi AJAX untuk mengambil data dari Controller
function loadManpower(sectionName) {
    if(!sectionName) return;

    // --- PERBAIKAN 1: BUSTER CACHE ---
    // Tambahkan timestamp di URL agar browser selalu menganggap ini URL baru dan tidak mengambil dari cache
    const timestamp = new Date().getTime();
    const url = `@Url.Action("getManpower", "TransferLabor")?section=${encodeURIComponent(sectionName)}`;

    // Reset dropdown yang sudah ada ke status loading
    const allDropdowns = document.querySelectorAll('.emp-dropdown');
    allDropdowns.forEach(dd => {
        dd.innerHTML = '<option value="">Loading data...</option>';
    });

    // Reset semua kotak NIK agar tidak ada NIK lama yang nyangkut
    document.querySelectorAll('.emp-nik').forEach(nikInput => {
        nikInput.value = "";
    });
    document.querySelectorAll('.emp-description').forEach(descriptionInput => {
        descriptionInput.value = "";
    });
    document.querySelectorAll('.emp-status').forEach(statusInput => {
        statusInput.value = "";
    });

    // --- PERBAIKAN 2: PAKSA FETCH AGAR TIDAK CACHE ---
    fetch(url, {
        method: 'GET',
        cache: 'no-store', // Mencegah caching secara ketat
        headers: {
            'Cache-Control': 'no-cache',
            'Pragma': 'no-cache'
        }
    })
    .then(response => response.json())
    .then(res => {
        if (res.success) {
            // Kosongkan list lama terlebih dahulu untuk mencegah tumpang tindih
            currentManpowerList = [];
            currentManpowerList = res.data; // Simpan data baru ke global
            populateDropdowns(); // Isi semua dropdown di tabel
        } else {
            Swal.fire('Gagal', "Gagal memuat data karyawan: " + res.message, 'error');
            allDropdowns.forEach(dd => {
                dd.innerHTML = '<option value="">-- Gagal Load Data --</option>';
            });
        }
    })
    .catch(error => {
        console.error('Error fetching manpower:', error);
        Swal.fire('Error', 'Terjadi kesalahan jaringan.', 'error');
        allDropdowns.forEach(dd => {
            dd.innerHTML = '<option value="">-- Error Jaringan --</option>';
        });
    });
}

// 2. Fungsi untuk mengisi ulang SEMUA dropdown di tabel dengan data baru
function populateDropdowns() {
    const allDropdowns = document.querySelectorAll('.emp-dropdown');

    let optionsHTML = '<option value="">-- Pilih Karyawan --</option>';

    console.log(currentManpowerList);
    currentManpowerList.forEach(emp => {
        // Kita simpan NIK di atribut custom 'data-nik'
        // Membaca versi huruf besar ATAU huruf kecil. Jika keduanya null, ganti jadi teks kosong ('')
        optionsHTML += `<option value="${emp.Name}" data-nik="${emp.NIK}" data-description="${emp.Description || emp.description || ''}" data-status="${emp.Status || emp.status || ''}">${emp.Name} (${emp.NIK})</option>`;
    });

    allDropdowns.forEach(dd => {
        dd.innerHTML = optionsHTML;
        // --- PERBAIKAN 3: KEMBALIKAN KE PILIHAN PERTAMA ---
        dd.value = "";
    });

    // Reset input NIK karena dropdown berubah (kembali ke "Pilih Karyawan")
    document.querySelectorAll('.emp-nik').forEach(nikInput => {
        nikInput.value = "";
    });
    document.querySelectorAll('.emp-description').forEach(descriptionInput => {
        descriptionInput.value = "";
    });
    document.querySelectorAll('.emp-status').forEach(statusInput => {
        statusInput.value = "";
    });
}

// 3. Fungsi yang dipanggil otomatis saat user memilih NAMA di dropdown
function setNIK(selectElement) {
    // Cari input NIK di baris yang sama (<tr>)
    const tr = selectElement.closest('tr');
    const nikInput = tr.querySelector('.emp-nik');
    const descriptionInput = tr.querySelector('.emp-description');
    const statusInput = tr.querySelector('.emp-status');

    // Ambil data-nik dari <option> yang sedang dipilih
    const selectedOption = selectElement.options[selectElement.selectedIndex];

    if (selectedOption && selectedOption.value !== "") {
        nikInput.value = selectedOption.getAttribute('data-nik');
        descriptionInput.value = selectedOption.getAttribute('data-description');
        statusInput.value = selectedOption.getAttribute('data-status');
    } else {
        nikInput.value = "";
        descriptionInput.value = "";
        statusInput.value = "";
    }
}

