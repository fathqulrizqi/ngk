    function applySignature() {
        // 1. Ambil waktu saat ini
        let now = new Date();

        // -- Untuk Tampilan Stempel (dd.mm.yy) --
        let day = String(now.getDate()).padStart(2, '0');
        let month = String(now.getMonth() + 1).padStart(2, '0');
        let shortYear = now.getFullYear().toString().slice(-2);
        let formattedDateStamp = `${day}.${month}.${shortYear}`;

        // -- Untuk Data Backend (YYYY-MM-DD HH:mm:ss) --
        let fullYear = now.getFullYear();
        let hours = String(now.getHours()).padStart(2, '0');
        let minutes = String(now.getMinutes()).padStart(2, '0');
        let seconds = String(now.getSeconds()).padStart(2, '0');
        let backendDateTime = `${fullYear}-${month}-${day} ${hours}:${minutes}:${seconds}`;

        // 2. Isi value pada input hidden
        document.getElementById('request_creator_sign').value = "Created";
        document.getElementById('request_creator_sign_date').value = backendDateTime; // <--- INI TAMBAHANNYA

        // 3. Ubah tampilan teks/icon di dalam signUI menjadi stempel merah mirip gambar
        const signUI = document.getElementById('signUI');
        signUI.innerHTML = `
        <div class="flex items-center justify-center">
            <div class="w-20 h-20 rounded-full border-2 border-red-600 flex flex-col items-center justify-center text-center text-red-600 font-mono font-bold leading-tight shadow-sm bg-white">
                <div class="text-[10px] tracking-wider uppercase border-b border-red-600 w-11 pb-0.5">Created</div>
                <div class="text-[11px] py-0.5">${formattedDateStamp}</div>
                <div class="border-t border-red-600 w-11 pt-0.5 text-[8px] italic"></div>
            </div>
        </div>
    `;

        // 4. Ubah style kotak signBox
        const signBox = document.getElementById('signBox');
        signBox.classList.remove('border-dashed', 'border-gray-200', 'hover:bg-gray-50', 'hover:border-teal-400', 'cursor-pointer');
        signBox.classList.add('bg-white', 'border-solid', 'border-gray-200');

        // 5. Matikan event klik
        signBox.onclick = null;
    }
