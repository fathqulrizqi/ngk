@{
    ViewBag.Title = "Plug Cap Tag FG Generator";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section scriptHead{
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.0/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/ui/1.14.0/jquery-ui.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3"></script>

    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3/dist/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/printThis/1.15.0/printThis.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
}

@{
    var FGTagList = ViewBag.FGTagList as List<NGKBusi.Areas.Production.Models.Production_PlugCap_TagFG_Generator_Tag_FG> ?? new List<NGKBusi.Areas.Production.Models.Production_PlugCap_TagFG_Generator_Tag_FG>();
}

<style>
    .datatable-input {
        border: 1px solid #d1d5db;
        background-color: white;
        border-radius: 0.5rem;
        outline: none;
    }

        .datatable-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
</style>

<body class="min-h-screen font-sans text-gray-800 bg-gray-100">
    <div class="px-6 border-b border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">
                <i class="fa-solid fa-qrcode text-blue-600 mr-2"></i>Tag FG Generator
            </h1>
            <p class="text-sm text-gray-500 mt-1">Sistem scan part untuk pembuatan Tag Finished Good</p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="getSelectedAndPrintBatch()" class="bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 shadow flex items-center gap-2">
                <i class="fa-solid fa-print"></i> Print FG Tag
            </button>
            <button onclick="openScanModal()" class="group bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg shadow-md transition-all duration-200 flex items-center gap-2">
                <i class="fa-solid fa-barcode group-hover:scale-110 transition-transform"></i>
                <span>Mulai Scan Part</span>
            </button>
        </div>
    </div>

    <div class="px-6 border shadow-sm mt-3 bg-white pt-2 pb-4 mx-6 mb-8">
        <div class="overflow-x-auto">
            <table id="fgTable" class="w-full text-sm text-left bg-white border">
                <thead class="bg-gray-50 text-gray-700 font-semibold uppercase">
                    <tr>
                        <th class="py-3 px-4" data-orderable="false" data-sortable="false">
                            <input type="checkbox" id="checkAll" class="raw-checkbox w-4 h-4">
                        </th>
                        <th class="py-3 px-4">BN</th>
                        <th class="py-3 px-4">Part No</th>
                        <th class="py-3 px-4">Product Name</th>
                        <th class="py-3 px-4">Inspector</th>
                        <th class="py-3 px-4">Lot FG</th>
                        <th class="py-3 px-4">Total Qty</th>
                        <th class="py-3 px-4">Created At</th>
                        <th class="py-3 px-4 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (FGTagList != null && FGTagList.Any())
                    {
                        foreach (var item in FGTagList)
                        {
                            <tr class="hover:bg-blue-50 transition-colors">
                                <td class="px-4 py-3">
                                    <input type="checkbox" class="raw-checkbox w-4 h-4" value="@item.id">
                                </td>
                                <td class="px-4 py-3 font-medium text-blue-600">@item.BN</td>
                                <td class="px-4 py-3">@item.part_no</td>
                                <td class="px-4 py-3">@item.product_name</td>
                                <td class="px-4 py-3">@item.inspector</td>
                                <td class="px-4 py-3">
                                    <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs font-bold">
                                        @item.lot
                                    </span>
                                </td>
                                <td class="px-4 py-3 font-bold text-gray-800">@item.qty</td>
                                <td class="px-4 py-3 text-gray-500">
                                    @(item.created_at.HasValue ? item.created_at.Value.ToString("dd MMM yyyy HH:mm") : "-")
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex justify-center gap-2">
                                        <a href="@Url.Action("Detail", "PlugCapTagFGGenerator", new { id = item.id })" class="p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-100 rounded-full transition-all" title="Detail">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <button onclick="confirmDelete('@item.id')" class="p-2 text-gray-500 hover:text-red-600 hover:bg-red-100 rounded-full transition-all" title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="scanModal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-gray-900 bg-opacity-80 transition-opacity backdrop-blur-sm"></div>

        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4">

                <div class="relative transform overflow-hidden rounded-xl bg-white text-left shadow-2xl transition-all w-full max-w-7xl">

                    <div class="flex justify-between items-center bg-gray-50 px-6 py-4 border-b border-gray-100">
                        <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                            <i class="fa-solid fa-qrcode text-blue-600"></i> Rapid Scan Part
                        </h3>
                        <button onclick="closeScanModal()" class="text-gray-400 hover:text-red-500 transition-colors">
                            <i class="fa-solid fa-xmark text-xl"></i>
                        </button>
                    </div>

                    <div class="px-6 py-6">

                        <div class="mb-5">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Scan Part QR Here:</label>
                            <div class="flex gap-2">
                                <div class="relative w-full">
                                    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                                        <i class="fa-solid fa-keyboard text-gray-400"></i>
                                    </div>
                                    <input type="text" id="qrInput"
                                           class="block w-full pl-10 pr-3 py-2.5 text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all font-mono"
                                           placeholder="Siap untuk scan..." autocomplete="off">
                                </div>
                                <button onclick="processQr()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors shadow-sm whitespace-nowrap flex items-center gap-2">
                                    <i class="fa-solid fa-plus"></i> Add
                                </button>
                            </div>
                        </div>

                        <div class="flex justify-between items-end mb-2 mt-4">
                            <h4 class="font-bold text-gray-700 flex items-center gap-2">
                                <i class="fa-solid fa-boxes-stacked text-blue-500"></i> Part Ter-Scan (Belum Disimpan)
                            </h4>
                            <span id="scanCounter" class="text-blue-700 bg-blue-100 border border-blue-200 text-xs font-bold px-2 py-1 rounded">
                                0 Item
                            </span>
                        </div>

                        <div class="border shadow-sm bg-white overflow-y-auto overflow-x-auto custom-scrollbar min-h-[30vh] max-h-[40vh]">
                            <table class="w-full text-sm text-left bg-white border whitespace-nowrap">
                                <thead class="bg-gray-50 text-gray-700 font-semibold uppercase sticky top-0 shadow-sm z-10">
                                    <tr>
                                        <th class="px-4 py-3 border-b text-center">No</th>
                                        <th class="px-4 py-3 border-b">Sequence (BN)</th>
                                        <th class="px-4 py-3 border-b">Part No</th>
                                        <th class="px-4 py-3 border-b">Product Name</th>
                                        <th class="px-4 py-3 border-b text-center">Gimz Code</th>
                                        <th class="px-4 py-3 border-b text-center">Lot</th>
                                        <th class="px-4 py-3 border-b text-center">Inspector</th>
                                        <th class="px-4 py-3 border-b text-center">Qty</th>
                                        <th class="px-4 py-3 border-b text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="cacheTableBody" class="divide-y divide-gray-100">
                                    <tr>
                                        <td colspan="9" class="text-center py-8 text-gray-400 italic">Belum ada part yang di-scan.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>

                    <div class="bg-gray-50 px-6 py-3 flex justify-end gap-3 border-t border-gray-100">
                        <button type="button" onclick="closeScanModal()" class="px-4 py-2 bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-100 font-medium text-sm transition-colors">
                            Cancel
                        </button>
                        <button id="btnGenerate" onclick="generateTagFG()" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium text-sm transition-colors flex items-center gap-2 opacity-50 cursor-not-allowed" disabled>
                            <i class="fa-solid fa-file-circle-check"></i>
                            Simpan & Generate Tag FG
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>
        let scannedPartsCache = [];
        const scanModal = document.getElementById('scanModal');
        const qrInput = document.getElementById('qrInput');

        document.addEventListener("DOMContentLoaded", function () {
            new simpleDatatables.DataTable("#fgTable", {
                searchable: true,
                fixedHeight: false,
                perPage: 10
            });
        });

        function openScanModal() {
            scanModal.classList.remove('hidden');
            setTimeout(() => {
                qrInput.value = '';
                qrInput.focus();
            }, 100);
            renderCacheTable();
        }

        function closeScanModal() {
            if(scannedPartsCache.length > 0) {
                Swal.fire({
                    title: 'Tutup Scanner?',
                    text: "Ada data yang belum disimpan. Yakin ingin menutup? (Data tidak akan hilang)",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Ya, Tutup',
                    cancelButtonText: 'Batal',
                    confirmButtonColor: '#ef4444'
                }).then((result) => {
                    if (result.isConfirmed) {
                        scanModal.classList.add('hidden');
                    } else {
                        qrInput.focus();
                    }
                });
            } else {
                scanModal.classList.add('hidden');
            }
        }

        qrInput.addEventListener("keypress", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                processQr();
            }
        });

        function processQr() {
            const rawCode = qrInput.value;
            if (!rawCode) {
                qrInput.focus();
                return;
            }

            const code = rawCode.padEnd(252, ' ');

            if (code.length < 200) {
                const ToastErr = Swal.mixin({ toast: true, position: 'top', showConfirmButton: false, timer: 2000 });
                ToastErr.fire({ icon: 'error', title: 'Format QR tidak sesuai (Bukan format 252 Karakter)!' });
                qrInput.value = '';
                qrInput.focus();
                return;
            }

            let partObj = {
                BN: code.substring(0, 49).trim() || "-",
                inspector: code.substring(49, 74).trim() || "-",
                product_name: code.substring(74, 153).trim() || "-",
                part_no: code.substring(153, 188).trim() || "-",
                gimzcode: code.substring(188, 206).trim() || "-",
                lot: code.substring(206, 216).trim() || "-",
                qty: parseInt(code.substring(216, 239).trim(), 10) || 0
            };

            // ==========================================
            // 1. VALIDASI GIMZCODE & LOT (HARUS SAMA DENGAN SCAN PERTAMA)
            // ==========================================
            if (scannedPartsCache.length > 0) {
                const referencePart = scannedPartsCache[0]; // Ambil data part pertama di list sebagai acuan
                if (partObj.gimzcode !== referencePart.gimzcode || partObj.lot !== referencePart.lot) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Validasi Gagal!',
                        html: `Gimzcode atau Lot tidak sama dengan part sebelumnya!<br/><br/>
                               Scanned Part:<br/>Gimzcode: <b>${partObj.gimzcode}</b> | Lot: <b>${partObj.lot}</b><br/><br/>
                               Standard Part (List):<br/>Gimzcode: <b>${referencePart.gimzcode}</b> | Lot: <b>${referencePart.lot}</b>`,
                        didClose: () => {
                            qrInput.value = '';
                            qrInput.focus();
                        }
                    });
                    return; // Hentikan proses jika beda
                }
            }

            // ==========================================
            // 2. VALIDASI DUPLIKAT (SEQUENCE BN)
            // ==========================================
            if (partObj.BN !== "-" && scannedPartsCache.some(item => item.BN === partObj.BN)) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Duplikat!',
                    text: 'Sequence ' + partObj.BN + ' sudah di-scan sebelumnya.',
                    timer: 2000,
                    showConfirmButton: false
                });

                qrInput.value = '';
                qrInput.focus();
                return;
            }

            scannedPartsCache.unshift(partObj);

            qrInput.value = '';
            qrInput.focus();
            renderCacheTable();

            const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 800 });
            Toast.fire({ icon: 'success', title: 'Berhasil di-scan!' });
        }

        function removePartFromCache(index) {
            scannedPartsCache.splice(index, 1);
            renderCacheTable();
            qrInput.focus();
        }

        function renderCacheTable() {
            const tbody = document.getElementById('cacheTableBody');
            const counter = document.getElementById('scanCounter');
            const btnGenerate = document.getElementById('btnGenerate');

            tbody.innerHTML = '';
            counter.innerText = `${scannedPartsCache.length} Item`;

            if (scannedPartsCache.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="text-center py-8 text-gray-400 italic">Belum ada part yang di-scan.</td>
                    </tr>`;

                btnGenerate.disabled = true;
                btnGenerate.classList.add('opacity-50', 'cursor-not-allowed');
                btnGenerate.classList.remove('hover:bg-green-700');
                return;
            }

            btnGenerate.disabled = false;
            btnGenerate.classList.remove('opacity-50', 'cursor-not-allowed');
            btnGenerate.classList.add('hover:bg-green-700');

            scannedPartsCache.forEach((part, index) => {
                let tr = document.createElement('tr');
                tr.className = "hover:bg-blue-50 transition-colors border-b border-gray-100";

                if(index === 0) {
                    tr.classList.add('bg-green-50');
                }

                tr.innerHTML = `
                    <td class="px-4 py-2 text-center text-gray-500">${scannedPartsCache.length - index}</td>
                    <td class="px-4 py-2 font-mono text-xs text-blue-600 font-semibold">${part.BN}</td>
                    <td class="px-4 py-2 font-medium text-gray-800">${part.part_no}</td>
                    <td class="px-4 py-2 text-gray-600">${part.product_name}</td>
                    <td class="px-4 py-2 text-center text-gray-600">${part.gimzcode}</td>
                    <td class="px-4 py-2 text-center">
                        <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs font-bold border border-gray-200">
                            ${part.lot}
                        </span>
                    </td>
                    <td class="px-4 py-2 text-center text-gray-600">${part.inspector}</td>
                    <td class="px-4 py-2 text-center font-bold text-green-600 text-base">${part.qty}</td>
                    <td class="px-4 py-2 text-center">
                        <button onclick="removePartFromCache(${index})" class="p-2 text-red-400 hover:text-white hover:bg-red-500 rounded-full transition-all" title="Hapus dari List">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function generateTagFG() {
            if (scannedPartsCache.length === 0) return;

            Swal.fire({
                title: 'Simpan & Generate?',
                text: `Membuat Tag FG dari ${scannedPartsCache.length} part.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#16a34a',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Ya, Generate!',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Processing...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });

                    $.ajax({
                        url: '@Url.Action("GenerateTagFG", "PlugCapTagFGGenerator")',
                        type: 'POST',
                        contentType: "application/json",
                        data: JSON.stringify({ scannedParts: scannedPartsCache }),
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Berhasil!',
                                    text: response.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    scannedPartsCache = [];
                                    window.location.href = response.redirectUrl;
                                });
                            } else {
                                Swal.fire('Error', response.message, 'error').then(() => qrInput.focus());
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'Gagal menghubungi server.', 'error').then(() => qrInput.focus());
                        }
                    });
                } else {
                    qrInput.focus();
                }
            });
        }

        function confirmDelete(id) {
            Swal.fire({
                title: 'Hapus Tag FG?',
                text: "Data Tag FG beserta seluruh Part di dalamnya akan dihapus permanen!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Ya, Hapus!',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Menghapus...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });

                    $.ajax({
                        url: '@Url.Action("deleteFGTag", "PlugCapTagFGGenerator")',
                        type: 'POST',
                        data: { id: id },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success', title: 'Terhapus!', text: response.message, timer: 1500, showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Gagal', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'Terjadi kesalahan sistem.', 'error');
                        }
                    });
                }
            });
        }


        function getSelectedAndPrintBatch() {
            let selectedIds = [];
            const checkboxes = document.querySelectorAll('.raw-checkbox:checked');

            checkboxes.forEach((checkbox) => {
                const val = parseInt(checkbox.value);
                if (!isNaN(val) && val > 0) {
                    selectedIds.push(val);
                }
            });

            if (selectedIds.length === 0) {
                Swal.fire('Info', 'Silakan centang data di tabel terlebih dahulu.', 'info');
            } else {
                processPrintBatch(selectedIds);
            }
        }

        function processPrintBatch(selectedIds) {
            Swal.fire({
                title: 'Menyiapkan Dokumen Print...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '@Url.Action("GetBatchFGDetails", "PlugCapTagFGGenerator")',
                type: 'POST',
                data: { ids: selectedIds },
                success: function (response) {
                    if (response.success) {
                        Swal.close();
                        renderAndPrint(response.data);
                    } else {
                        Swal.fire('Error', response.message, 'error');
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire('Error', 'Gagal mengambil data dari server.', 'error');
                }
            });
        }

        function renderAndPrint(dataList) {
            // 1. Siapkan Wrapper Induk tersembunyi
            let printWrapper = document.getElementById('printWrapper');
            let printContainer = document.getElementById('printContainer');

            if (!printWrapper) {
                printWrapper = document.createElement('div');
                printWrapper.id = 'printWrapper';
                printWrapper.style.display = 'none';

                printContainer = document.createElement('div');
                printContainer.id = 'printContainer';

                printWrapper.appendChild(printContainer);
                document.body.appendChild(printWrapper);
            }

            printContainer.innerHTML = '';

            let htmlContent = `
                <style>
                    .text-center { text-align: center; }
                    .page-wrapper {
                        display: block;
                        background: white;
                    }
                    .a4-landscape-page {
                        width: 297mm;
                        height: 210mm;
                        background-color: white;
                        padding: 10px;
                        color: #333;
                        box-sizing: border-box;
                        page-break-after: always; /* Pastikan ganti halaman setelah div ini */
                    }
                    .print-table {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                    }
                    .print-table td, .print-table th {
                        border: 1px solid #000;
                        padding: 6px 8px;
                        vertical-align: middle;
                        font-size: 13px;
                        color: #000;
                    }
                    @@media print {
                        body {
                            background: none;
                            -webkit-print-color-adjust: exact;
                            print-color-adjust: exact;
                            color: #000 !important;
                        }
                        .page-wrapper {
                            padding: 0;
                            display: block;
                        }
                        .a4-landscape-page {
                            width: 297mm;
                            height: 210mm;
                            margin: 0 auto;
                            padding: 15mm;
                            box-shadow: none;
                            background: white;
                            page-break-after: always; /* Force page break saat diprint */
                        }
                        @@page {
                            margin: 0;
                        }
                    }
                </style>
                <div class="page-wrapper">
            `;
            // PERHATIKAN: Saya menghapus <div class="a4-landscape-page"> dari sini.
            // Kita akan membuatnya di dalam loop.

            // Variabel untuk menampung data QR sebelum dirender ke DOM
            let qrCodeDataList = [];

            // 3. Loop Data
            dataList.forEach((item, index) => {
                const typeName = item.product_name || "TYPE N/A";
                const lotNo = item.lot || "N/A";
                const qty = item.qty || 0;
                const gimzcode = item.gimzcode || "N/A";

                let qrChars = Array(252).fill(' ');
                const insertAt = (pos, val) => {
                    if (val === null || val === undefined || val === '') return;
                    val = String(val).replace(/[\r\n]/g, "").replace(/\t/g, " ");
                    let zeroBasedIndex = pos - 1;
                    for (let j = 0; j < val.length && (zeroBasedIndex + j) < 252; j++) {
                        qrChars[zeroBasedIndex + j] = val[j];
                    }
                };

                insertAt(1, item.BN || "");
                insertAt(50, item.inspector || "");
                insertAt(75, item.product_name || "");
                insertAt(154, item.part_no || "");
                insertAt(189, item.gimzcode || "");
                insertAt(207, item.lot || "");
                insertAt(217, String(qty).padStart(6, '0'));
                insertAt(240, String(qty).padStart(7, '0'));

                const finalQrString = qrChars.join('');

                // Simpan text QR ke dalam array dengan ID unik untuk di generate nanti
                const qrElementId = `qr-box-${index}`;
                qrCodeDataList.push({ id: qrElementId, text: finalQrString });

                // ==========================================
                // LOGIKA PAGE BREAK (PENTING)
                // ==========================================

                // 1. Jika index genap (0, 2, 4...), buat BUNGKUS HALAMAN BARU
                if (index % 2 === 0) {
                    htmlContent += `<div class="a4-landscape-page">`;
                }

                // 2. Render Tabel Tag-nya
                htmlContent += `
                        <table class="print-table">
                            <colgroup>
                                <col span="2" style="width: 11.33mm;" />
                                <col span="16" style="width: 5.67mm; " />
                                <col span="6" style="width: 8.33mm; " />
                            </colgroup>

                            <tr>
                                <td colspan="2" rowspan="4" class="text-center">
                                    <img src="@Url.Content("~/Images/niterra-logo.jpg")" alt="Niterra-Logo" style="max-height: 40px; max-width: 100%; object-fit: contain;" />
                                </td>
                                <td rowspan="4" colspan="16" class="text-center" style="font-size:38pt; font-family: 'Arial Black', sans-serif;">
                                    TAG FG PLUGCAP
                                </td>
                                <td colspan="2" style="font-size: 14pt;padding:3px; font-family: 'Calibri', sans-serif;">No. Dok</td>
                                <td colspan="4" style="font-size: 14pt;padding:3px; font-family: 'Calibri', sans-serif;">PK-APC-APC-19/F3</td>
                            </tr>
                            <tr>
                                <td colspan="2" style="font-size: 14pt;padding:3px; font-family: 'Calibri', sans-serif;">Revisi</td>
                                <td colspan="4" style="font-size: 14pt;padding:3px; font-family: 'Calibri', sans-serif;">00</td>
                            </tr>
                            <tr>
                                <td colspan="2" style="font-size: 14pt;padding:3px; font-family: 'Calibri', sans-serif;">Tanggal</td>
                                <td colspan="4" style="font-size: 14pt;padding:3px; font-family: 'Calibri', sans-serif;">04 September 2026</td>
                            </tr>
                            <tr>
                                <td colspan="2" style="font-size: 14pt;padding:3px; font-family: 'Calibri', sans-serif;">Halaman</td>
                                <td colspan="4" style="font-size: 14pt;padding:3px; font-family: 'Calibri', sans-serif;">1 / 1</td>
                            </tr>
                            <tr>
                                <td colspan="24" style="font-size: 14px; font-family: 'Arial', sans-serif; border-bottom: none; padding:0px;">
                                    <!-- Wrapper Flexbox ditambahkan di sini -->
                                    <div style="display: flex; width: 100%; justify-content: space-between; margin:0px;">

                                        <!-- Kolom Kiri -->
                                        <div style="width: 75%;border-right: 1px solid black; padding:20px 10px;">
                                            <div style="font-weight: 500; font-family: 'Calibri', sans-serif; font-size: 21pt;">
                                                PART NAME
                                            </div>
                                            <div style="font-size: 75pt; font-weight: bold; font-family: 'Arial Narrow', sans-serif; padding-top: 0px; vertical-align: top; line-height: 0.8;">
                                                ${typeName}
                                            </div>
                                        </div>
            
                                        <!-- Kolom Kanan -->
                                        <div style="width: 25%;padding:20px 10px;">
                                            <div style="font-weight: 500; font-family: 'Calibri', sans-serif; font-size: 21pt;">
                                                LOT NO
                                            </div>
                                            <div style="font-size: 80pt; font-weight: bold; font-family: 'Arial Narrow', sans-serif; padding-top: 0px; vertical-align: top; line-height: 0.8;">
                                                ${lotNo}
                                            </div>
                                        </div>  
                  
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="18" style=" padding:10px 10px 20px 10px;">
                                    <div style="font-weight: 500; font-family: 'Calibri', sans-serif; font-size: 21pt;">
                                        PART NUMBER
                                    </div>
                                    <div style="font-size: 75pt; font-weight: bold; font-family: 'Arial Narrow', sans-serif; border-top: none; bordeer-right: none; padding-top: 0px; vertical-align: top; line-height: 0.8;">
                                          ${gimzcode}
                                    </div>
                                </td>
                                <td colspan="6" class="text-center" style="vertical-align: middle; border-left: none;">
                                    <!-- Container untuk JS lokal merender QR Code -->
                                    <div id="${qrElementId}" style="display: flex; justify-content: center; align-items: center;"></div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="15" rowspan="6" style="font-weight: 500; padding:20px 10px;"">
                                    <div style="font-family: 'Calibri', sans-serif; font-size: 21pt;">
                                        TOTAL QTY (PCS)
                                    </div>
                                    <div style="font-size: 90pt; font-weight: bold; font-family: 'Arial Narrow', sans-serif; border-top: none; padding-top: 0px; vertical-align: top; line-height: 0.8;">
                                        ${qty}
                                    </div>
                                </td>
                                <td colspan="3" style="font-size: 12pt; text-align: center; padding: 0px; font-weight: bold; font-family: 'Calibri', sans-serif;">
                                    TANGGAL PENGECEKAN
                                </td>
                                <td colspan="3" style="font-size: 18px; text-align: center; padding: 0px; font-weight: bold; font-family: 'Calibri', sans-serif; ">
                                    INSPECTOR
                                </td>
                                <td colspan="3" style="font-size: 18px; text-align: center; padding: 0px; font-weight: bold; font-family: 'Calibri', sans-serif; ">
                                    QTY
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3" style="font-size: 12pt;"></td>
                                <td colspan="3" style="font-size: 12pt; padding: 0px;"> ${item.inspector}</td>
                                <td colspan="3" style="font-size: 12pt;"></td>
                            </tr>
                            <tr>
                                <td colspan="3" style="font-size: 12pt;"></td>
                                <td colspan="3" style="font-size: 12pt;"></td>
                                <td colspan="3" style="font-size: 12pt;"></td>
                            </tr>
                            <tr>
                                <td colspan="3" style="font-size: 12pt; "></td>
                                <td colspan="3" style="font-size: 12pt;"></td>
                                <td colspan="3" style="font-size: 12pt;"></td>
                            </tr>
                            <tr>
                                <td colspan="3" style="font-size: 12pt; "></td>
                                <td colspan="3" style="font-size: 12pt;"></td>
                                <td colspan="3" style="font-size: 12pt;"></td>
                            </tr>
                            <tr>
                                <td colspan="3" style="font-size: 12pt; "></td>
                                <td colspan="3" style="font-size: 12pt;"></td>
                                <td colspan="3" style="font-size: 12pt;"></td>
                            </tr>
                        </table>
                `;

                // 3. Beri jarak HANYA JIKA ini tag pertama di halaman tersebut (bukan tag terakhir)
                if (index % 2 === 0 && index !== dataList.length - 1) {
                    htmlContent += `<br><br><br>`;
                }

                // 4. TUTUP BUNGKUS HALAMAN jika index ganjil (artinya tag ke-2 di halaman tsb)
                //    ATAU jika ini adalah perulangan terakhir
                if (index % 2 === 1 || index === dataList.length - 1) {
                    htmlContent += `</div>`;
                }
            });

            htmlContent += `</div>`; // Menutup .page-wrapper
            printContainer.innerHTML = htmlContent;

            // 4. Generate Local QR Code pada masing-masing div
            qrCodeDataList.forEach(qr => {
                let el = document.getElementById(qr.id);
                if (el) {
                    new QRCode(el, {
                        text: qr.text,
                        width: 160, 
                        height: 160, 
                        colorDark : "#000000",
                        colorLight : "#ffffff",
                        correctLevel : QRCode.CorrectLevel.M // Level koreksi (Standard)
                    });
                }
            });

            // 5. Eksekusi Print
            setTimeout(() => {
                $(printContainer).printThis({
                    importCSS: false,
                    importStyle: false,
                    pageTitle: "Tag_FG_Plugcap",
                    printDelay: 500
                });
            }, 300);
        }
    </script>
    <script>
        $(document).ready(function () {

            $(document).on('click', '#checkAll', function (e) {
                e.stopPropagation();
                var isChecked = $(this).is(':checked');

                $('.raw-checkbox').prop('checked', isChecked);
            });

            $(document).on('change', '.raw-checkbox', function () {
                var totalCheckboxes = $('.raw-checkbox').length;
                var totalChecked = $('.raw-checkbox:checked').length;

                $('#checkAll').prop('checked', totalCheckboxes > 0 && totalCheckboxes === totalChecked);
            });

        });
    </script>
</body>