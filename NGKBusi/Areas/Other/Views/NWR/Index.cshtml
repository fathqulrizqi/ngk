    <script>
let allRoomsData = [];

    function getDetailRooms(roomCatSequence) {
        $.ajax({
            url: "@Url.Action("GetRoomDetails", "NWR", new { area = "Other" })",
            type: "POST",
            tryCount: 0,
            tryLimit: 3,
            // Pastikan nama parameter cocok dengan di Controller (sequenceId)
            data: { sequenceId: parseInt(roomCatSequence) },
            dataType: "json",
            success: function (response) {
                if (!Array.isArray(response)) return;

                allRoomsData = response;
                let carouselInner = $(".carousel-inner");
                carouselInner.empty();

                if (response.length > 0) {
                    response.forEach(function (room, index) {
                        let activeClass = index === 0 ? "active" : "";
                        let imageName = room.Image || "no_room.png";

                        carouselInner.append(`
                            <div class="carousel-item ${activeClass}" data-room-id="${room.ID}" data-room-title="${room.RoomTitle}">
                                <img alt="${imageName}" src="@Url.Content("~/Content/Images/Room/")${imageName}" class="d-block w-100" height="200px" />
                            </div>
                        `);
                    });

                    $('.carousel-control-prev, .carousel-control-next').toggle(response.length > 1);

                    const firstRoom = response[0];
                    $("#buildingName, #activeBuildingName").text(firstRoom.RoomTitle || "No Room Available");
                    $("#roomId").val(firstRoom.ID);

                    displayRoomProps(firstRoom.ID);
                    renderCalendar(firstRoom.ID);
                } else {
                    // Handler jika data ruangan kosong di dalam kategori tsb
                    $("#buildingName, #activeBuildingName").text("No Room Available");
                    $("#propertiesTableBody").empty();
                    $("#ex_number").empty();
                    $('.carousel-control-prev, .carousel-control-next').hide();

                    if(calendar) {
                        calendar.destroy();
                        calendar = null;
                    }
                }
            },
            error: function (xhr, textStatus) {
                if (textStatus === "timeout") {
                    this.tryCount++;
                    if (this.tryCount <= this.tryLimit) {
                        $.ajax(this);
                        return;
                    }
                }
                Swal.fire('Error', 'Failed to fetch data.', 'error');
            }
        });
    }

    function displayRoomProps(roomId) {
        const room = allRoomsData.find(r => r.ID === parseInt(roomId));
        if (!room) return;

        const roomHtml = `
            <div class="d-flex align-items-center justify-content-center mt-4" style="position: relative;">
                <p style="margin: 0; font-size: 13px; font-weight: bold" id="ex_number">
                    ☎️ Extension Number: ${room.ExtensionNumber || '-'}
                </p>
            </div>
        `;

        const props = room.prop || [];
        const propsHtml = props.map(prop => `
            <tr>
                <td style="font-size: 12px;">${prop.PropsName}</td>
                <td style="padding:6px 30px; font-size: 12px;">${prop.Quantity}</td>
            </tr>
        `).join('');

        $("#propertiesTableBody").html(propsHtml);
        $("#ex_number").html(roomHtml);
    }

    function loadRoomCategories() {
        $.ajax({
            url: "@Url.Action("GetRoomCat", "NWR", new { area = "Other" })",
            type: "GET",
            dataType: "json",
            success: function (categories) {
                let container = $("#categoryContainer");
                container.empty();

                let firstAvailableSequence = null;

                categories.forEach(function (cat) {
                    let maintenanceClass = cat.isMaintenance ? "disabled-icon" : "";
                    let maintenanceStyle = cat.isMaintenance ? "opacity: 0.5; filter: grayscale(100%);" : "";

                    // Simpan sequence pertama yang tidak maintenance untuk initial load
                    if (!cat.isMaintenance && firstAvailableSequence === null) {
                        firstAvailableSequence = cat.sequence;
                    }

                    let focusClass = (cat.sequence === firstAvailableSequence) ? "focus active" : "";
                    let categoryActive = (cat.sequence === firstAvailableSequence) ? "active" : "";

                    let html = `
                        <a href="#" class="link-dark category-icon ${maintenanceClass} ${focusClass}"
                           style="text-decoration: none; ${maintenanceStyle}"
                           data-sequence="${cat.sequence}"
                           data-maintenance="${cat.isMaintenance}">
                            <div class="category text-center ${categoryActive}">
                                <i class="fa-solid fa-building fa-4x"></i>
                                <p class="mt-2">${cat.RoomCat}</p>
                            </div>
                        </a>
                    `;
                    container.append(html);
                });

                // Load initial data for the first available category (Mencegah tampilan kosong)
                if(firstAvailableSequence !== null) {
                    getDetailRooms(firstAvailableSequence);
                }
            },
            error: function(xhr, status, error) {
                console.error("Gagal memuat kategori ruangan:", error);
            }
        });
    }

    $(document).ready(function () {
        // Render kategori secara otomatis saat halaman dimuat
        loadRoomCategories();

        // DELEGATION UNTUK KLIK ICON GEDUNG (Menggunakan .on() ke body/document)
        $(document).on("click", ".category-icon", function (e) {
            e.preventDefault();

            const roomCatSequence = $(this).data("sequence"); // Mengambil parameter dari data-sequence
            const isMaintenance = $(this).data("maintenance");

            if (isMaintenance === true) {
                $('#maintenanceModal').modal('show');
                return;
            }

            if (calendar) {
                currentView = calendar.view.type;
                currentDate = currentView === 'dayGridMonth' ? lastMonthDate : calendar.getDate();
            }

            getDetailRooms(roomCatSequence);

            // Update Class Active Visual
            $(".category-icon").removeClass("focus active");
            $(".category").removeClass("active");

            $(this).addClass("focus active");
            $(this).find(".category").addClass("active");
        });

        // Trigger Calendar re-render ketika ganti gambar ruangan dari Carousel
        $("#carouselExampleFade").on("slid.bs.carousel", function () {
            const activeItem = $(".carousel-item.active");
            const activeRoomId = activeItem.data("room-id");
            const newBuildingName = activeItem.data("room-title");

            if (calendar) {
                currentView = calendar.view.type;
                currentDate = currentView === 'dayGridMonth' ? lastMonthDate : calendar.getDate();
            }

            if (newBuildingName) {
                $("#buildingName, #activeBuildingName").text(newBuildingName);
                $("#roomTitle").val(newBuildingName);
            }

            if (activeRoomId) {
                $("#roomId").val(activeRoomId);
                displayRoomProps(activeRoomId);
                renderCalendar(activeRoomId);
            }
        });
    });
    </script>
}

