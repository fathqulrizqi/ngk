@{
    ViewBag.Title = "CAR & OFI Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    /* Background Gradient */
    html, body {
        background-image: linear-gradient(135deg, #2563eb 0%, #bae6fd 55%, #f8fafc 100%);
        background-size: cover;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .table-container::-webkit-scrollbar {
        height: 6px;
    }

    .table-container::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    .table-container::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

        .table-container::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

    .swal2-container {
        z-index: 100000 !important;
    }
</style>

<div class="min-h-screen pt-2 pb-6 sm:px-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-0">

        <!-- Header -->
        <div class="mb-4">
            <h2 class="text-2xl font-extrabold text-white drop-shadow-sm tracking-tight">CAR & OFI Data</h2>
            <p class="mt-1 text-xs text-blue-100">Manage and track Corrective Action Reports and Opportunities for Improvement.</p>
        </div>

        <!-- Filter Panel -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 mb-3">
            <div class="flex items-center mb-3 text-slate-800 font-bold text-sm">
                <svg class="w-4 h-4 mr-1.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                </svg>
                Filters
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                <div>
                    <label class="block text-[11px] text-slate-500 mb-1 font-medium">Section</label>
                    <select id="filterSection" class="w-full border border-slate-300 rounded-md py-1.5 px-2.5 text-xs text-slate-700 bg-white focus:ring-1 focus:ring-blue-500 outline-none transition-all cursor-pointer">
                        <option value="">All Sections</option>

                    </select>
                </div>
                <div>
                    <label class="block text-[11px] text-slate-500 mb-1 font-medium">Event</label>
                    <select id="filterEvent" class="w-full border border-slate-300 rounded-md py-1.5 px-2.5 text-xs text-slate-700 bg-white focus:ring-1 focus:ring-blue-500 outline-none transition-all cursor-pointer">
                        @if (ViewBag.EventList != null)
                        {
                            foreach (var data in ViewBag.EventList)
                            {
                                <option value="@data.audit_event_id">@data.audit_name</option>
                            }
                        }
                        else
                        {
                            <option value="">-- Tidak ada data event --</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] text-slate-500 mb-1 font-medium">Show Rows</label>
                    <select id="pageSize" class="w-full border border-slate-300 rounded-md py-1.5 px-2.5 text-xs text-slate-700 bg-white focus:ring-1 focus:ring-blue-500 outline-none transition-all cursor-pointer">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] text-slate-500 mb-1 font-medium">Search</label>
                    <div class="relative w-full">
                        <svg class="absolute left-2.5 top-1/2 transform -translate-y-1/2 text-slate-400 w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" id="searchInput" placeholder="Search data..." class="w-full pl-8 pr-3 py-1.5 border border-slate-300 rounded-md text-xs text-slate-700 bg-white focus:ring-1 focus:ring-blue-500 outline-none transition-all">
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
            <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-sm flex flex-col justify-center">
                <p class="text-[11px] text-slate-500 font-medium">Total Findings</p>
                <p class="text-2xl font-bold text-slate-800 mt-0.5" id="sumTotal">0</p>
            </div>
            <div class="bg-red-50 border border-red-100 rounded-xl p-3 shadow-sm flex flex-col justify-center">
                <p class="text-[11px] text-red-600 font-medium">Major</p>
                <p class="text-2xl font-bold text-red-600 mt-0.5" id="sumMajor">0</p>
            </div>
            <div class="bg-orange-50 border border-orange-100 rounded-xl p-3 shadow-sm flex flex-col justify-center">
                <p class="text-[11px] text-orange-600 font-medium">Minor</p>
                <p class="text-2xl font-bold text-orange-600 mt-0.5" id="sumMinor">0</p>
            </div>
            <div class="bg-blue-50 border border-blue-100 rounded-xl p-3 shadow-sm flex flex-col justify-center">
                <p class="text-[11px] text-blue-600 font-medium">OFI</p>
                <p class="text-2xl font-bold text-blue-600 mt-0.5" id="sumOFI">0</p>
            </div>
        </div>

        <!-- Table Container -->
        <div class="w-full overflow-hidden rounded-xl shadow-md border border-slate-200 bg-white flex flex-col">
            <div class="overflow-x-auto table-container">
                <table class="min-w-full text-left text-[13px] text-slate-600 table-fixed">
                    <thead class="bg-slate-50/80 border-b border-slate-200 text-slate-400 font-bold text-[11px] uppercase tracking-wider">
                        <tr>
                            <th scope="col" class="px-2 py-4 w-44">Report No. / ID</th>
                            <th scope="col" class="px-2 py-4 w-24">Clause</th>
                            <th scope="col" class="px-2 py-4 text-center w-28">Category</th>
                            <th scope="col" class="px-3 py-4 w-full min-w-[400px]">Question</th>
                            <th scope="col" class="px-2 py-4 w-27 whitespace-nowrap">Verification 1</th>
                            <th scope="col" class="px-2 py-4 w-27 whitespace-nowrap">Verification 2</th>
                            <th scope="col" class="px-2 py-4 text-center w-20">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody" class="divide-y divide-slate-100 bg-white">
                        <!-- Data loaded via Ajax -->
                    </tbody>
                </table>
            </div>

            <div id="paginationContainer" class="px-4 py-3 border-t border-slate-200 bg-slate-50 text-xs"></div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let currentPage = 1;
            let currentSearch = "";
            let pageSize = 10;
            let searchTimeout;

            function loadSections(eventId, callback) {
                let sectionSelect = $('#filterSection');

                if (!eventId) {
                    sectionSelect.html('<option value="">All Sections</option>');
                    if (callback) callback();
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetSectionsByEvent", "EAudit")',
                    type: 'GET',
                    data: { eventId: eventId },
                    success: function (response) {
                        let options = '<option value="">All Sections</option>';

                        if (response.success && response.data) {
                            $.each(response.data, function (index, item) {
                                options += `<option value="${item}">${item}</option>`;
                            });
                        } else {
                            console.error("Gagal memuat section: " + response.message);
                        }

                        sectionSelect.html(options);

                        if (callback) callback();
                    },
                    error: function () {
                        sectionSelect.html('<option value="">All Sections</option>');
                        if (callback) callback();
                    }
                });
            }

            let urlParams = new URLSearchParams(window.location.search);
            let eventParam = urlParams.get('eventId');
            let sectionParam = urlParams.get('section');

            // Jika ada Event ID dari URL, set ke dropdown Event
            if (eventParam) {
                $('#filterEvent').val(eventParam);
            }

            let initialEventId = $('#filterEvent').val();
            loadSections(initialEventId, function () {
                // Setelah section di-load, jika ada Section Name dari URL, set ke dropdown Section
                if (sectionParam) {
                    $('#filterSection').val(sectionParam);
                }
                loadData(); // Memanggil tabel
            });

            $('#filterEvent').on('change', function () {
                currentPage = 1;
                let selectedEventId = $(this).val();

                loadSections(selectedEventId, function() {
                    loadData();
                });
            });

            $('#filterSection').on('change', function () {
                currentPage = 1;
                loadData();
            });

            $('#pageSize').on('change', function () {
                pageSize = $(this).val();
                currentPage = 1;
                loadData();
            });

            $('#searchInput').on('input', function () {
                clearTimeout(searchTimeout);
                currentSearch = $(this).val();
                currentPage = 1;
                searchTimeout = setTimeout(loadData, 500);
            });

            function parseJsonDate(dateStr) {
                if (!dateStr) return null;
                if (typeof dateStr === 'string' && dateStr.includes('/Date(')) {
                    return new Date(parseInt(dateStr.replace(/\/Date\((.*?)\)\//gi, "$1")));
                }
                return new Date(dateStr);
            }

            function formatDate(dateObj) {
                if (!dateObj || isNaN(dateObj.getTime())) return '';
                let year = dateObj.getFullYear();
                let month = String(dateObj.getMonth() + 1).padStart(2, '0');
                let day = String(dateObj.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }

            function loadData() {
                $('#tableBody').html('<tr><td colspan="7" class="px-4 py-8 text-center text-slate-400 font-medium"><div class="flex flex-col items-center justify-center"><div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600 mb-2"></div>Loading data...</div></td></tr>');

                $.ajax({
                    url: '@Url.Action("GetCAROFI", "EAudit")',
                    type: 'GET',
                    data: {
                        search: currentSearch,
                        page: currentPage,
                        pageSize: pageSize,
                        section: $('#filterSection').val(), // Nilai ini sekarang dinamis sesuai event
                        eventId: $('#filterEvent').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            renderTable(response.data);
                            renderPaginationControls(response.pagination);

                            if (response.summary) {
                                $('#sumTotal').text(response.summary.total);
                                $('#sumMajor').text(response.summary.major);
                                $('#sumMinor').text(response.summary.minor);
                                $('#sumOFI').text(response.summary.ofi);
                            }
                        } else {
                            $('#tableBody').html('<tr><td colspan="7" class="px-4 py-6 text-center text-rose-500">Failed to load data from server.</td></tr>');
                        }
                    },
                    error: function () {
                        $('#tableBody').html('<tr><td colspan="7" class="px-4 py-6 text-center text-rose-500">A system error occurred.</td></tr>');
                    }
                });
            }

            function renderTable(data) {
                let html = '';

                if (data.length === 0) {
                    html = '<tr><td colspan="7" class="px-4 py-8 text-center text-slate-400 font-medium">No data found.</td></tr>';
                } else {
                    $.each(data, function (index, item) {
                        let createdDateObj = parseJsonDate(item.CreatedDate);
                        let createdFormatted = createdDateObj ? formatDate(createdDateObj) : '';

                        let isOfi = item.StatusProblem && item.StatusProblem.toLowerCase() === 'ofi';
                        let computedType = isOfi ? 'OFI' : 'CAR';

                        let badgeCategory = '-';
                        if (item.StatusProblem) {
                            let statLower = item.StatusProblem.toLowerCase();
                            if (statLower === 'major') {
                                badgeCategory = `<span class="inline-flex flex-col items-center text-center px-2 py-1 rounded font-bold bg-red-50 text-red-700 min-w-[70px] ring-1 ring-inset ring-red-600/20">
                                                    <span>Major</span>
                                                    <span class="font-normal opacity-80">${item.CategoryAudit}</span>
                                                </span>`;
                            } else if (statLower === 'minor') {
                                badgeCategory = `<span class="inline-flex flex-col items-center text-center px-2 py-1 rounded font-bold bg-yellow-50 text-yellow-700 min-w-[70px] ring-1 ring-inset ring-yellow-600/20">
                                                    <span>Minor</span>
                                                    <span class="font-normal opacity-80">${item.CategoryAudit}</span>
                                                </span>`;
                            } else if (statLower === 'ofi') {
                                badgeCategory = `<span class="inline-flex flex-col items-center text-center px-2 py-1 rounded font-bold bg-blue-50 text-blue-700 min-w-[70px] ring-1 ring-inset ring-blue-600/20">
                                                    <span>OFI</span>
                                                    <span class="font-normal opacity-80">${item.CategoryAudit}</span>
                                                </span>`;
                            } else {
                                badgeCategory = `<span class="inline-flex items-center px-2 py-1 rounded font-semibold bg-gray-100 text-gray-600">${item.StatusProblem}</span>`;
                            }
                        }

                        let sectionHtml = item.Section
                            ? `<span class="inline-flex items-center px-2.5 py-0.5 rounded bg-blue-50 text-blue-600 font-medium text-xs border border-blue-100">${item.Section}</span>`
                            : '-';

                        html += `
                            <tr class="hover:bg-slate-50/80 transition-all duration-150 border-b border-slate-100">

                                <td class="px-3 py-4 align-middle truncate">
                                    <div class="font-bold text-slate-900 text-sm tracking-tight">${item.Id}</div>
                                    ${item.DueDate ? `<div class="text-[11px] text-slate-400 font-medium mt-0.5">Due Date : ${item.DueDate}</div>` : ''}
                                </td>
                                <td class="px-3 py-4 text-slate-600 font-medium font-mono text-xs align-middle truncate">${item.Clause || '-'}</td>
                                <td class="px-3 py-4 text-center align-middle truncate">
                                    ${badgeCategory}
                                </td>
                                <td class="px-4 py-4 text-slate-600 whitespace-normal break-words align-middle leading-relaxed font-medium">
                                    ${item.Question || '-'}
                                </td>
                                <td class="px-3 py-4 text-center text-slate-600 font-medium font-mono text-xs align-middle truncate">
                                  ${
                                    item.Verification1 === 'Approved'
                                        ? '<span style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; background-color: #28a745; border-radius: 50%;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;"><polyline points="20 6 9 17 4 12"></polyline></svg></span>'
                                        : item.Verification1 === 'Rejected'
                                            ? '<span style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; background-color: #dc3545; border-radius: 50%;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></span>'
                                            : ''
                                    }
                                </td>

                                <td class="px-3 py-4 text-center text-slate-600 font-medium font-mono text-xs align-middle truncate">
                                  ${item.Verification2 === 'Approved'
                                    ? '<span style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; background-color: #28a745; border-radius: 50%;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;"><polyline points="20 6 9 17 4 12"></polyline></svg></span>'
                                    : item.Verification2 === 'Rejected'
                                        ? '<span style="display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; background-color: #dc3545; border-radius: 50%;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></span>'
                                        : ''
                                  }
                                </td>
                                <td class="px-3 py-4 text-center align-middle">
                                    <div class="flex items-center justify-center gap-3">
                                        <button onclick="handleAction('${item.Id}', '${computedType}')"
                                                class="text-slate-400 hover:text-blue-600 transition-colors focus:outline-none"
                                                title="${computedType === 'OFI' ? 'View Details' : 'Fill Data'}">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `;
                    });
                }
                $('#tableBody').html(html);
            }

            window.changePage = function(newPage) {
                currentPage = newPage;
                loadData();
            };

            document.getElementById("searchInput").focus();

            function renderPaginationControls(pagination) {
                const container = $('#paginationContainer');
                if (pagination.totalRecords === 0) { container.html(''); return; }

                const current = pagination.currentPage;
                const totalPages = pagination.totalPages || 1;
                const startIndex = (current - 1) * pagination.pageSize + 1;
                const actualEnd = Math.min(current * pagination.pageSize, pagination.totalRecords);

                let html = `
                    <div class="flex flex-col sm:flex-row w-full items-center justify-between gap-3 text-slate-600">
                        <div>Showing <span class="font-medium text-slate-900">${startIndex}</span> to <span class="font-medium text-slate-900">${actualEnd}</span> of <span class="font-medium text-slate-900">${pagination.totalRecords}</span> results</div>
                        <div class="flex items-center gap-1">
                            <button onclick="changePage(${current - 1})" class="px-2.5 py-1 border border-slate-200 rounded hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors" ${current === 1 ? 'disabled' : ''}>Prev</button>
                `;

                const getPageList = (c, t) => {
                    if (t <= 5) return Array.from({ length: t }, (_, i) => i + 1);
                    if (c <= 3) return [1, 2, 3, 4, '...', t];
                    if (c >= t - 2) return [1, '...', t - 3, t - 2, t - 1, t];
                    return [1, '...', c - 1, c, c + 1, '...', t];
                };

                getPageList(current, totalPages).forEach(p => {
                    if (p === '...') html += `<span class="px-1.5 py-1 text-slate-400 font-medium tracking-widest">...</span>`;
                    else if (p === current) html += `<button class="px-2.5 py-1 bg-blue-600 text-white border border-blue-600 rounded font-medium shadow-sm">${p}</button>`;
                    else html += `<button onclick="changePage(${p})" class="px-2.5 py-1 border border-slate-200 text-slate-700 rounded hover:bg-slate-100 transition-colors">${p}</button>`;
                });

                html += `<button onclick="changePage(${current + 1})" class="px-2.5 py-1 border border-slate-200 rounded hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors" ${current === totalPages ? 'disabled' : ''}>Next</button></div></div>`;
                container.html(html);
            }
        });

        function handleAction(id, type) {
            let encodeId = encodeURIComponent(id);
            let cleanId = encodeId.replace(/&amp;/g, '&');
            console.log(cleanId);
            if (type === 'OFI') {
                window.location.href = '@Url.Action("DetailOFI", "EAudit")' + '?id=' + cleanId;
            } else {
                window.location.href = '@Url.Action("DetailCAR", "EAudit")' + '?id=' + cleanId;
            }
        }
    </script>
}