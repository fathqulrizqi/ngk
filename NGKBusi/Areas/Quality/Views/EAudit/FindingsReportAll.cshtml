    // =========================================================================
    // PAGINATION ENGINE
    // =========================================================================

    function mmToPx(mm) {
        const $ruler = $('<div>').css({ position: 'absolute', visibility: 'hidden', height: 0, width: mm + 'mm' }).appendTo('body');
        const px = $ruler.width();
        $ruler.remove();
        return px;
    }

    function paginateRows(printRowsArr, kriteriaHtml) {
        const contentWidthPx = mmToPx(297) - (PADDING_PX * 2);

        const contentHeightPx = mmToPx(210) - (PADDING_PX * 2) - 35;

        const $stage = $('<div>').css({ position: 'absolute', visibility: 'hidden', left: '-99999px', top: 0, width: contentWidthPx + 'px' }).appendTo('body');
        const colgroupHtml = `<colgroup><col span="69" style="width:1.4492%;"></colgroup>`;

        const $headerTbl = $(`<table class="tbl-bordered w-full text-gray-800">${colgroupHtml}${buildPrintTheadHtml(kriteriaHtml, 1, 1)}<tbody></tbody></table>`).appendTo($stage);
        const headerHeightPx = $headerTbl.find('thead').outerHeight(true) || 0;
        $headerTbl.remove();

        const $footerEl = $(buildPrintFooterHtml(0, 0, 0, '00 Jan 0000')).css('width', contentWidthPx + 'px').appendTo($stage);
        const footerHeightPx = $footerEl.outerHeight(true) || 0;
        $footerEl.remove();

        const $rowTbl = $(`<table class="tbl-bordered w-full text-gray-800">${colgroupHtml}<tbody></tbody></table>`).appendTo($stage);
        const $tbody = $rowTbl.find('tbody');
        const rowHeights = printRowsArr.map(rowHtml => {
            $tbody.html(rowHtml);
            return $tbody.find('tr').outerHeight(true) || 0;
        });
        $rowTbl.remove();
        $stage.remove();

        const pages = [];
        let current = { start: 0, count: 0, height: headerHeightPx };
        for (let i = 0; i < rowHeights.length; i++) {
            const h = rowHeights[i];
            if (current.count > 0 && (current.height + h) > contentHeightPx) {
                pages.push(current);
                current = { start: i, count: 0, height: headerHeightPx };
            }
            current.height += h;
            current.count++;
        }
        pages.push(current);

        const lastPage = pages[pages.length - 1];
        if (lastPage.height + footerHeightPx > contentHeightPx) {
            pages.push({ start: printRowsArr.length, count: 0, height: headerHeightPx });
        }

        return pages;
    }

    // =========================================================================
    // MAIN RENDER (Modified Parameter)
    // =========================================================================

    function renderLaporanTemuan(items, auditStandards, docDateStr) {
        const validItems = items || [];

        let totalMajor = 0, totalMinor = 0, totalOfi = 0;
        validItems.forEach(item => {
            const klas = item.klasifikasi_temuan ? item.klasifikasi_temuan.toUpperCase() : '';
            if (klas === 'MAJOR') totalMajor++;
            if (klas === 'MINOR') totalMinor++;
            if (klas === 'OFI') totalOfi++;
        });

        const kriteriaString = 'ISO 9001 : 2015 / IATF 16949 : 2016 / ISO 14001 : 2015 / ISO 45001 : 2018';
        const kriteriaHtml = renderAuditStandardsDynamic(kriteriaString, auditStandards);

        let screenRowsArr = [];
        let printRowsArr = [];

        if (validItems.length === 0) {
            screenRowsArr = [`<tr><td colspan="15" class="p-4 text-center italic">Tidak ada temuan audit.</td></tr>`];
            printRowsArr = [`<tr><td colspan="69" class="p-4 text-center italic">Tidak ada temuan audit.</td></tr>`];
        } else {
            validItems.forEach((item, idx) => {
                const rowNumber = idx + 1;
                const klasifikasi = item.klasifikasi_temuan ? item.klasifikasi_temuan.toUpperCase() : '';

                const p = item.problem ? `<b>Problem:</b><br>${item.problem}<br>` : '';
                const l = item.location ? `<b>Lokasi:</b> ${item.location}<br>` : '';
                const d = item.detail ? `${klasifikasi != 'OFI' ? '<b>Detail:</b><br>' : '' }${item.detail}` : '';
                const detailsStr = p || l || d ? `${p}${l}${d}` : '-';

                const auditorFormatted = item.auditor || '-';
                const jenisAudit = item.category_audit || '-';

                screenRowsArr.push(`
                    <tr class="align-top">
                        <td class="p-1 text-center">${rowNumber}</td>
                        <td class="p-1 text-center">${item.section || '-'}</td>
                        <td class="p-1 text-center whitespace-nowrap">${item.start_date || '-'}</td>
                        <td class="p-1 text-center">-</td>
                        <td class="p-1 text-center">${auditorFormatted}</td>
                        <td class="p-1 text-center">${item.clause || '-'}</td>
                        <td class="p-1 text-center">${jenisAudit}</td>
                        <td class="p-1 text-left whitespace-pre-wrap">${detailsStr}</td>
                        <td class="p-1 text-left">${item.Object || '-'}</td>
                        <td class="p-1 text-center font-bold">${klasifikasi === 'MAJOR' ? 'V' : ''}</td>
                        <td class="p-1 text-center font-bold">${klasifikasi === 'MINOR' ? 'V' : ''}</td>
                        <td class="p-1 text-center font-bold">${klasifikasi === 'OFI' ? 'V' : ''}</td>
                        <td class="p-1 text-center">
                            ${klasifikasi === 'OFI'
                                    ? `<a href="${item.url}" class="text-blue-600 underline hover:text-blue-800 font-semibold transition-colors">LINK</a>`
                                    : `<a href="${item.url}" class="text-blue-600 underline hover:text-blue-800 font-semibold transition-colors">${item.no || '-'}</a>`
                            }
                        </td>
                        ${klasifikasi === 'OFI'
                        ? `<td colspan="2" class="p-1 text-center font-bold text-[9px]">
                           ${item.verifikasi1 === "Approved" ? "CLOSE" :"OPEN"}
                       </td>`
                        : `<td class="p-1 text-center font-bold text-[9px]">
                           ${item.verifikasi1 === "Approved" ? "CLOSE" : "OPEN"}
                       </td>
                       <td class="p-1 text-center font-bold text-[9px]">
                           ${item.verifikasi2 === "Approved" ? "CLOSE" : "OPEN"}
                       </td>`
                }
                </tr>`);

                printRowsArr.push(`
                    <tr class="align-top font-sans text-[9px] text-gray-800">
                        <td colspan="1" class="p-1 text-center">${rowNumber}</td>
                        <td colspan="3" class="p-1 text-center">${item.section || '-'}</td>
                        <td colspan="3" class="p-1 text-center whitespace-nowrap">${item.start_date || '-'}</td>
                        <td colspan="2" class="p-1 text-center">-</td>
                        <td colspan="4" class="p-1 text-center">${auditorFormatted}</td>
                        <td colspan="6" class="p-1 text-center">${item.clause || '-'}</td>
                        <td colspan="3" class="p-1 text-center">${jenisAudit}</td>
                        <td colspan="15" class="p-1 text-left whitespace-pre-wrap">${detailsStr}</td>
                        <td colspan="15" class="p-1 text-left">${item.Object || '-'}</td>
                        <td colspan="2" class="p-1 text-center font-bold">${klasifikasi === 'MAJOR' ? 'V' : ''}</td>
                        <td colspan="2" class="p-1 text-center font-bold">${klasifikasi === 'MINOR' ? 'V' : ''}</td>
                        <td colspan="2" class="p-1 text-center font-bold">${klasifikasi === 'OFI' ? 'V' : ''}</td>
                        <td colspan="5" class="p-1 text-center">
                            ${klasifikasi === 'OFI'
                                ? `-`
                                : `${item.no || '-'}</a>`
                            }
                        </td>
                        ${klasifikasi === 'OFI'
                            ? `<td colspan="6" class="p-1 text-center font-bold text-[9px]">
                                ${item.verifikasi1 === "Approved" ? "CLOSE" :"OPEN"}
                            </td>`
                            : `<td colspan="3" class="p-1 text-center font-bold text-[9px]">
                                ${item.verifikasi1 === "Approved" ? "CLOSE" : "OPEN"}
                            </td>
                            <td colspan="3" class="p-1 text-center font-bold text-[9px]">
                                ${item.verifikasi2 === "Approved" ? "CLOSE" : "OPEN"}
                            </td>`
                        }
                    </tr>`);
            });
        }

        const pages = paginateRows(printRowsArr, kriteriaHtml);
        const totalPages = pages.length;

        let screenFullHtml = '';
        let printFullHtml = '';

        pages.forEach((pg, pIdx) => {
            const pageNum = pIdx + 1;
            const isLastPage = pageNum === totalPages;
            const screenRowsHtml = screenRowsArr.slice(pg.start, pg.start + pg.count).join('');
            const printRowsHtml = printRowsArr.slice(pg.start, pg.start + pg.count).join('');

            screenFullHtml += `
                <div class="print-paper font-sans text-black text-[10px] flex flex-col justify-between">
                    <div>
                        ${buildScreenLetterheadHtml(kriteriaHtml, pageNum, totalPages)}
                        <table class="tbl-bordered text-[9.5px]">
                            ${buildScreenTheadHtml()}
                            <tbody>
                                ${screenRowsHtml}
                            </tbody>
                        </table>
                    </div>
                    ${isLastPage ? buildScreenFooterHtml(totalMajor, totalMinor, totalOfi, docDateStr) : ''}
                </div>
            `;

            printFullHtml += `
                <div class="a4-landscape-page${isLastPage ? '' : ' page-break'}">
                    <table class="tbl-bordered w-full text-gray-800">
                        <colgroup>
                            <col span="69" style="width: 1.4492%;" />
                        </colgroup>
                        ${buildPrintTheadHtml(kriteriaHtml, pageNum, totalPages)}
                        <tbody>
                            ${printRowsHtml}
                        </tbody>
                    </table>
                    ${isLastPage ? buildPrintFooterHtml(totalMajor, totalMinor, totalOfi, docDateStr) : ''}
                </div>
            `;
        });

        $('#screenContainer').html(screenFullHtml);
        $('#printContainer').html(printFullHtml);
    }

    function executeSign(roleLabel, status, btnElement) {
        const isApprove = status === 'Approved';
        Swal.fire({
            title: isApprove ? 'Approve Dokumen?' : 'Reject Dokumen?',
            text: `Tanda tangani di kolom ${roleLabel}?`,
            icon: isApprove ? 'question' : 'warning',
            showCancelButton: true,
            confirmButtonColor: isApprove ? '#10b981' : '#e11d48',
            confirmButtonText: isApprove ? 'Ya, Approve' : 'Ya, Reject'
        }).then((result) => {
            if (result.isConfirmed) {

                const payload = {
                    audit_event_id: globalEventId,
                    recap_sign_category: roleLabel, // "Dibuat", "Diperiksa", "Disetujui"
                    recap_sign_status: status
                };

                $.ajax({
                    url: '@Url.Action("UpsertApprovalRecapEventAudit", "EAudit")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if (res.success) {
                            // PERBAIKAN: HAPUS SEMUA SPASI DAN SIMBOL MENGGUNAKAN REGEX
                            const roleKey = roleLabel.toLowerCase().replace(/[^a-z0-9]/g, '');

                            $(`.action-btns-${roleKey}`).hide();

                            const dateObj = new Date();
                            const dateString = `${String(dateObj.getDate()).padStart(2, '0')} ${["Jan","Feb","Mar","Apr","Mei","Jun","Jul","Agu","Sep","Okt","Nov","Des"][dateObj.getMonth()]} ${dateObj.getFullYear()}`;
                            const stampHtml = isApprove
                                ? `<div class="stamp-circle stamp-approved-circle"><span class="stamp-text">APPROVED</span><span class="stamp-date">${dateString}</span></div>`
                                : `<div class="stamp-circle stamp-rejected-circle"><span class="stamp-text">REJECTED</span><span class="stamp-date">${dateString}</span></div>`;

                            $(`.stamp-container-${roleKey}`).html(stampHtml);
                            $(`.name-lbl-${roleKey}`).text(currentUserName);

                            Swal.fire({ title: 'Berhasil!', icon: 'success', timer: 1500, showConfirmButton: false })
                                .then(() => {
                                    if(roleLabel === 'Dibuat' && isApprove) {
                                        window.location.reload();
                                    }
                                });
                        } else {
                            Swal.fire('Gagal', res.message, 'error');
                        }
                    }
                });
            }
        });
    }

    function renderExistingVerificationStamp(roleLabel, status, dateStr, signerName) {
        if (!status || !roleLabel) return;

        const roleKey = roleLabel.toLowerCase().replace(/[^a-z0-9]/g, '');
        $(`.action-btns-${roleKey}`).hide();

        let dateObj = new Date();
        if (dateStr) {
            let timestamp = parseInt(dateStr.replace(/\/Date\((\d+)\)\//, '$1'));
            if (!isNaN(timestamp)) dateObj = new Date(timestamp);
            else dateObj = new Date(dateStr);
        }
        const dateString = `${String(dateObj.getDate()).padStart(2, '0')} ${["Jan","Feb","Mar","Apr","Mei","Jun","Jul","Agu","Sep","Okt","Nov","Des"][dateObj.getMonth()]} ${dateObj.getFullYear()}`;

        const stampHtml = status.toLowerCase() === 'approved'
            ? `<div class="stamp-circle stamp-approved-circle"><span class="stamp-text">APPROVED</span><span class="stamp-date">${dateString}</span></div>`
            : `<div class="stamp-circle stamp-rejected-circle"><span class="stamp-text">REJECTED</span><span class="stamp-date">${dateString}</span></div>`;

        $(`.stamp-container-${roleKey}`).html(stampHtml);
        $(`.name-lbl-${roleKey}`).text(signerName);
    }
    function exportExcel() {
        if (!globalEventId) {
            Swal.fire('Error', 'ID Event tidak ditemukan di URL.', 'error');
            return;
        }

        // Tampilkan overlay loading
        $('#loadingOverlay').fadeIn();

        // Panggil endpoint action Export Excel
        window.location.href = '@Url.Action("ExportExcelRekapLaporan", "EAudit")' + '?eventId=' + globalEventId;

        // Sembunyikan overlay setelah jeda (karena pengalihan window.location.href tidak memiliki callback succes)
        setTimeout(() => {
            $('#loadingOverlay').fadeOut();
        }, 1500);
    }
</script>