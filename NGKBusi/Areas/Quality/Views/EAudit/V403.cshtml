@{
    ViewBag.Title = "403 Akses Ditolak";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center">
    <div style="font-size: 80px; color: #dc3545; font-weight: bold;">
        403
    </div>
    <h2 style="margin-bottom: 20px;">Akses Ditolak</h2>

    <p class="lead" style="font-size: 18px; color: #6c757d;">
        Maaf, Anda tidak memiliki izin untuk mengakses halaman ini.
    </p>

    <hr style="margin: 30px 0; border-top: 1px solid #e9ecef;" />

    <p style="color: #6c757d; margin-bottom: 30px;">
        Jika Anda merasa seharusnya memiliki akses, silakan hubungi Administrator Sistem atau Atasan Anda untuk mendapatkan hak akses yang sesuai.
    </p>

    <a href="@Url.Content("~/")" class="btn btn-primary" style="padding: 10px 20px; font-size: 16px; text-decoration: none; color: #fff; background-color: #007bff; border-radius: 5px;">
        &larr; Kembali ke Beranda
    </a>
</div>