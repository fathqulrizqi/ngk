@{
    ViewBag.Title = "Form Catatan Audit";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string deptName = ViewBag.DeptName ?? "Memuat...";
    string tanggalAudit = ViewBag.TanggalAudit ?? DateTime.Now.ToString("dd-MMMM-yyyy");
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/printThis/1.15.0/printThis.min.js"></script>

<style>
    /* Styling Dasar Layout */
    html, body {
        background-image: linear-gradient(135deg, #2563eb 0%, #bae6fd 55%, #f8fafc 100%);
        background-size: cover;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
        margin: 0;
        font-family: Arial, sans-serif;
    }

    .doc-border {
        border-color: #0c359e;
    }

    /* Style Stampel Web */
    .stamp-circle {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        border: 2.5px solid;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transform: rotate(-12deg);
        opacity: 0.85;
        user-select: none;
        pointer-events: none;
        position: relative;
        margin: 0 auto;
    }

        .stamp-circle::before {
            content: '';
            position: absolute;
            top: 2px;
            left: 2px;
            right: 2px;
            bottom: 2px;
            border-radius: 50%;
            border: 1px solid;
        }

        .stamp-circle .stamp-text {
            font-size: 0.6rem;
            font-weight: 900;
            letter-spacing: 0.5px;
            line-height: 1;
            margin-bottom: 2px;
        }

        .stamp-circle .stamp-date {
            font-size: 0.45rem;
            font-weight: 800;
            border-top: 1px solid;
            padding-top: 2px;
            width: 80%;
            text-align: center;
        }

    .stamp-approved-circle {
        color: #059669;
        border-color: #059669;
    }

        .stamp-approved-circle::before, .stamp-approved-circle .stamp-date {
            border-color: #059669;
        }

    .stamp-rejected-circle {
        color: #dc2626;
        border-color: #dc2626;
    }

        .stamp-rejected-circle::before, .stamp-rejected-circle .stamp-date {
            border-color: #dc2626;
        }

    /* LAYOUT SCREEN TAB CONTENT */
    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

    .screen-only-doc {
        max-width: 1120px;
        margin: 0 auto 2.5rem auto;
        background-color: white;
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
        padding: 2rem;
    }

    /* PRINT TABLE STYLING */
    .print-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .print-table td, .print-table th {
            border: 1px solid #000;
            padding: 6px 8px;
            vertical-align: middle;
            font-size: 11px;
        }

    .text-center {
        text-align: center;
    }

    .text-left {
        text-align: left;
    }

    .font-semibold {
        font-weight: bold;
    }

    .text-medium {
        font-size: 15px;
    }

    .text-small {
        font-size: 11px;
    }

    .no-border-right {
        border-right: none !important;
    }

    .no-border-left {
        border-left: none !important;
    }

    .no-border-x {
        border-left: none !important;
        border-right: none !important;
    }

    .td-dashed-y {
        border-top: 1px dashed #000 !important;
        border-bottom: 1px dashed #000 !important;
    }

    /* Styling Print (PDF/Hardcopy) */
    @@media screen {
        #printAllContainer {
            display: none !important;
        }
    }

    @@media print {
        body {
            background: white !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            margin: 0;
            padding: 0;
        }

        .no-print, .screen-only-doc, #tabsContainer {
            display: none !important;
        }

        #printAllContainer {
            display: block !important;
        }

        .a4-landscape-page {
            width: 297mm;
            height: 210mm; /* Kunci kertas pas A4 */
            margin: 0 auto;
            padding: 10mm;
            box-sizing: border-box;
            background: white;
            page-break-after: always;
            overflow: hidden; /* Mencegah browser pecah tabel otomatis */
        }

            .a4-landscape-page:last-child {
                page-break-after: auto;
            }

        @@page {
            size: A4 landscape;
            margin: 0;
        }
    }
</style>

<div class="max-w-6xl mx-auto px-4 py-4 no-print flex justify-between items-center">
    <a href="javascript:history.back()" class="inline-flex items-center text-white hover:text-blue-100 text-sm font-semibold transition-all hover:-translate-x-1 drop-shadow-sm">
        <i class="bi bi-arrow-left mr-1.5"></i> Back
    </a>

    <div class="flex items-center gap-2">
        @if (ViewBag.IsAdministrator != null && (bool)ViewBag.IsAdministrator)
        {
            <button type="button" onclick="openReminderModal()" class="shrink-0 bg-amber-500 text-white px-4 py-2.5 rounded-lg shadow-md font-bold hover:bg-amber-600 transition flex items-center gap-2 text-sm cursor-pointer">
                <svg class="w-5 h-5 animate-pulse-hover" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                </svg>
                Send Reminder
            </button>
        }
        <button onclick="printReport()" class="group flex items-center bg-red-600 hover:bg-red-700 text-white text-sm font-bold px-4 py-2 rounded-md shadow hover:shadow-md transition-all duration-150 active:scale-95">
            <i class="bi bi-file-earmark-pdf mr-2 text-base transition-transform duration-150 group-hover:scale-110"></i>
            Print PDF
        </button>

        <button onclick="exportExcel()" class="group flex items-center bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold px-4 py-2 rounded-md shadow hover:shadow-md transition-all duration-150 active:scale-95">
            <i class="bi bi-file-earmark-excel mr-2 text-base transition-transform duration-150 group-hover:scale-110"></i>
            Export Excel
        </button>
    </div>
</div>
<div class="max-w-6xl mx-auto mb-4 no-print">
    <div id="tabsContainer" class="flex gap-3 overflow-x-auto py-2 px-1"></div>

</div>

<div id="formsContainer" class="w-full pb-10 relative min-h-[500px] no-print">
    <div id="loadingOverlay" class="absolute inset-0 z-50 flex flex-col justify-start items-center pt-20 no-print">
        <div class="bg-white/90 backdrop-blur-sm p-6 rounded-2xl shadow-lg flex flex-col items-center">
            <i class="bi bi-arrow-repeat animate-spin text-4xl text-blue-800 mb-2"></i>
            <span class="font-bold text-slate-600">Menyusun Dokumen...</span>
        </div>
    </div>
</div>

<div id="printAllContainer"></div>

<div id="reminderModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[1000] flex items-center justify-center no-print transition-opacity">

    <!-- Modal Card (Sesuai dengan tema elegant-section) -->
    <div class="bg-white rounded shadow-2xl w-full max-w-md transform transition-all overflow-hidden flex flex-col max-h-[90vh] border border-gray-200">

        <!-- Modal Header -->
        <div class="bg-gray-50 p-3 border-b border-gray-200 flex justify-between items-center">
            <div>
                <h3 class="text-sm font-bold text-teal-800 uppercase tracking-wide">Send Reminder</h3>
                <p class="text-[11px] text-gray-500 mt-0.5">Select recipients and add an optional message.</p>
            </div>
            <button type="button" onclick="closeReminderModal()" class="text-gray-400 hover:text-red-600 transition cursor-pointer p-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-3 overflow-y-auto flex-1 space-y-4">

            <!-- Checkbox List User -->
            <div>
                <label class="block text-[13px] font-bold text-gray-800 mb-2">Pilih Penerima :</label>

                <!-- Kotak Scrollable -->
                <div class="max-h-48 overflow-y-auto border border-gray-200 rounded bg-white p-2 space-y-3 shadow-inner">

                    <!-- Looping List Auditee -->
                    @if (ViewBag.ListAuditee != null)
                    {
                        <div>
                            <div class="text-[10px] font-bold text-gray-500 mb-1 px-1 uppercase border-b border-gray-100 pb-1">Auditee</div>
                            <div class="space-y-0.5">
                                @foreach (var auditee in ViewBag.ListAuditee)
                                {
                                    <label class="flex items-center p-2 hover:bg-teal-50 rounded cursor-pointer transition">
                                        <input type="checkbox" name="reminderUsers" value="@auditee.Email" class="w-3.5 h-3.5 accent-teal-600 cursor-pointer">
                                        <div class="ml-2 flex flex-col leading-tight">
                                            <span class="text-[13px] font-semibold text-gray-800">@auditee.Name</span>
                                            <span class="text-[10px] text-gray-500">NIK: @auditee.NIK</span>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <!-- Looping List Auditor -->
                    @if (ViewBag.ListAuditor != null)
                    {
                        <div>
                            <div class="text-[10px] font-bold text-gray-500 mb-1 px-1 uppercase border-b border-gray-100 pb-1 mt-2">Auditor</div>
                            <div class="space-y-0.5">
                                @foreach (var auditor in ViewBag.ListAuditor)
                                {
                                    <label class="flex items-center p-2 hover:bg-teal-50 rounded cursor-pointer transition">
                                        <input type="checkbox" name="reminderUsers" value="@auditor.Email" class="w-3.5 h-3.5 accent-teal-600 cursor-pointer">
                                        <div class="ml-2 flex flex-col leading-tight">
                                            <span class="text-[13px] font-semibold text-gray-800">@auditor.Name</span>
                                            <span class="text-[10px] text-gray-500">NIK: @auditor.NIK</span>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Input Pesan Tambahan -->
            <div>
                <label for="reminderMessage" class="block text-[13px] font-bold text-gray-800 mb-2">Message :</label>
                <textarea id="reminderMessage" rows="3" placeholder="Type your reminder message here..." class="w-full text-[13px] border border-gray-300 rounded bg-transparent p-2.5 outline-none focus:border-teal-600 transition text-gray-800 resize-none shadow-sm"></textarea>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="bg-gray-50 px-2 py-2 border-t border-gray-200 flex justify-end gap-2">
            <button type="button" onclick="closeReminderModal()" class="text-xs px-5 py-2 font-bold bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition cursor-pointer shadow-sm">Cancel</button>
            <button type="button" onclick="processReminder('Catatan Audit', '@ViewBag.AuditNotesId')" class="text-xs px-5 py-2 font-bold bg-teal-700 text-white rounded-lg hover:bg-teal-800 transition shadow-md flex items-center gap-1.5 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                Send Reminder
            </button>
        </div>
    </div>
</div>

<script>
    const deptName = '@Html.Raw(deptName)';
    const tanggalAudit = '@Html.Raw(tanggalAudit)';

    let currentUserName = "";
    const urlParams = new URLSearchParams(window.location.search);
    const globalStakeholderId = urlParams.get('id');

    const eligibleAuditorCats = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.EligibleAuditorCategories ?? new List<string>()));
    const eligibleAuditeeCats = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.EligibleAuditeeCategories ?? new List<string>()));

    $(document).ready(function() {
        const auditType = urlParams.get('type') || 'ALL';

        if (globalStakeholderId) {
            $.ajax({
                url: '@Url.Action("GetCatatanAuditData", "EAudit")',
                type: 'GET',
                data: { stakeholderId: globalStakeholderId, type: auditType },
                success: function(res) {
                    if (res.success) {
                        currentUserName = res.currentUserName || "User";
                        renderForms(res.data, res.guides, res.generalNotes, auditType, res.auditStandards);

                        if(res.existingApprovals) {
                            res.existingApprovals.forEach(app => {
                                let match = app.category_recap.match(/\(([^)]+)\)/);
                                if(match && match[1]) {
                                    let category = match[1];
                                    renderExistingVerificationStamp(category, app.recap_sign_role, app.recap_sign_status, app.recap_sign_date, app.recap_sign_by_name);
                                }
                            });
                        }
                    } else {
                        showEmptyState("Gagal memuat data: " + res.message);
                    }
                },
                error: function() { showEmptyState("Koneksi ke server terputus."); },
                complete: function() { $('#loadingOverlay').fadeOut(); }
            });
        } else {
            showEmptyState("ID Stakeholder tidak ditemukan di URL.");
            $('#loadingOverlay').fadeOut();
        }
    });

    function showEmptyState(msg) {
        $('#tabsContainer').empty();
        $('#formsContainer').html(`<div class="text-center p-10 font-bold text-rose-500 bg-white rounded-xl shadow max-w-2xl mx-auto">${msg}</div>`);
    }

    function renderAuditStandardsDynamic(kriteriaText, standards) {
        if (!standards || standards.length === 0) {
            return kriteriaText.split(' / ').map(part => `<span class="line-through opacity-60 text-gray-400">${part.trim()}</span>`).join(' / ');
        }
        const parts = kriteriaText.split(' / ').map(s => s.trim());
        const result = parts.map(part => {
            const isMatch = standards.some(std => part.toLowerCase().includes(std.toLowerCase()));
            return isMatch ? `<span class="font-bold text-gray-900">${part}</span>` : `<span class="line-through opacity-60 text-gray-400">${part}</span>`;
        });
        return result.join(' / ');
    }

    function renderAuditStandardsPrint(kriteriaText, standards) {
        if (!standards || standards.length === 0) {
            return kriteriaText.split(' / ').map(part => `<span style="text-decoration: line-through; color: #888;">${part.trim()}</span>`).join(' / ');
        }
        const parts = kriteriaText.split(' / ').map(s => s.trim());
        const result = parts.map(part => {
            const isMatch = standards.some(std => part.toLowerCase().includes(std.toLowerCase()));
            return isMatch ? `<span class="font-semibold" style="color: #000;">${part}</span>` : `<span style="text-decoration: line-through; color: #888;">${part}</span>`;
        });
        return result.join(' / ');
    }

    // ============================================
    // PENGATURAN HALAMAN PRINT (PAGINATION CERDAS)
    // ============================================
    function paginatePrintRows(printRowsArr, printHeaderHtml, printFooterRowsHtml) {
        // PERBAIKAN 1: Limit dinaikkan agar mengisi ruang kosong kertas A4 yang sebenarnya (190mm ≈ ~700px)
        const CONTENT_HEIGHT_LIMIT = 650;

        const $stage = $('<div>').css({ position: 'absolute', visibility: 'hidden', left: '-99999px', top: 0, width: '277mm' }).appendTo('body');

        const $testWrapper = $(`<table class="print-table"><colgroup><col span="62" style="width: 1.61%;" /></colgroup><thead>${printHeaderHtml}</thead></table>`).appendTo($stage);
        const headerHeight = $testWrapper.outerHeight(true) || 0;
        $testWrapper.remove();

        const $testFooter = $(`<table class="print-table"><colgroup><col span="62" style="width: 1.61%;" /></colgroup><tbody>${printFooterRowsHtml}</tbody></table>`).appendTo($stage);
        const footerHeight = $testFooter.outerHeight(true) || 0;
        $testFooter.remove();

        const $rowTbl = $(`<table class="print-table"><colgroup><col span="62" style="width: 1.61%;" /></colgroup><tbody></tbody></table>`).appendTo($stage);
        const $tbody = $rowTbl.find('tbody');

        const rowHeights = printRowsArr.map(html => {
            $tbody.html(html);
            return $tbody.find('tr').outerHeight(true) || 0;
        });
        $rowTbl.remove();
        $stage.remove();

        const pages = [];
        let current = { start: 0, count: 0, height: headerHeight };

        // PERBAIKAN 2: Data row tidak lagi dipaksa pindah page hanya karena memikirkan ukuran Footer
        for (let i = 0; i < rowHeights.length; i++) {
            const h = rowHeights[i];

            // Evaluasi kemuatan baris murni hanya berdasarkan LIMIT halamannya saja
            if (current.count > 0 && (current.height + h) > CONTENT_HEIGHT_LIMIT) {
                pages.push(current);
                current = { start: i, count: 0, height: headerHeight };
            }
            current.height += h;
            current.count++;
        }
        if (current.count > 0) pages.push(current);

        // Footer diatur terpisah. Bila halaman terakhir sisa limitnya tidak muat dipasang footer,
        // Buatkan satu page (lembar) kosong baru khusus hanya untuk mencetak Header dan Footer (Note) saja.
        const lastPage = pages[pages.length - 1];
        if (lastPage.height + footerHeight > CONTENT_HEIGHT_LIMIT) {
            pages.push({ start: printRowsArr.length, count: 0, height: headerHeight });
        }

        return pages;
    }

    function buildPrintHeaderHtml(category, pageNum, totalPages) {
        return `
            <tr class="font-semibold">
                <td colspan="8" rowspan="4" class="text-center" style="padding: 2px;">
                    <img src="@Url.Content("~/Images/niterra-logo.jpg")" alt="Logo" style="max-height: 40px; max-width: 100%; object-fit: contain;" />
                </td>
                <td rowspan="2" colspan="42" class="text-center text-medium">FORMULIR INTEGRASI</td>
                <td colspan="4" class="text-small">No. Dok</td>
                <td colspan="8" class="text-small text-center">PMLK3-MR-09/L3</td>
            </tr>
            <tr class="font-semibold">
                <td colspan="4" class="text-small">Revisi</td>
                <td colspan="8" class="text-small text-center">03</td>
            </tr>
            <tr class="font-semibold">
                <td colspan="42" rowspan="2" class="text-center text-medium">CATATAN AUDIT (${category.toUpperCase()})</td>
                <td colspan="4" class="text-small">Tanggal</td>
                <td colspan="8" class="text-small text-center">20-May-2026</td>
            </tr>
            <tr class="font-semibold">
                <td colspan="4" class="text-small">Halaman</td>
                <td colspan="8" class="text-small text-center">${pageNum} / ${totalPages}</td>
            </tr>
            <tr class="font-semibold bg-gray-50 text-small">
                <td colspan="2" class="text-center">No.</td>
                <td colspan="6" class="text-center">Klausul</td>
                <td colspan="20" class="text-center">Pertanyaan</td>
                <td colspan="34" class="text-center">CATATAN AUDIT</td>
            </tr>
        `;
    }

    function buildPrintMetaRowsHtml(category, kriteriaHtml, guidesArr, auditorName, auditeeName) {
        const isSys = category === 'System' ? '■' : '□';
        const isPro = category === 'Process' ? '■' : '□';
        const isPrd = category === 'Product' ? '■' : '□';

        const isChecked = (name) => guidesArr.includes(name) ? '■' : '□';
        const defaultGuides = ['Customer Claim', 'Rejection', 'PQCC', 'CSR', 'Temuan audit', 'FMEA', 'Klausul ISO'];
        const otherGuides = guidesArr.filter(g => !defaultGuides.includes(g));
        const isLainChecked = otherGuides.length > 0 ? '■' : '□';
        const textLain = otherGuides.length > 0 ? otherGuides.join(', ') : '........................';

        const trimName = (n) => n && n !== '-' ? n.split(' ').slice(0, 2).join(' ') : '-';

        return `
            <tr class="font-semibold">
                <td colspan="12" class="no-border-right td-dashed-y text-small">Tanggal Audit</td>
                <td class="no-border-x text-center td-dashed-y text-small">:</td>
                <td colspan="30" class="no-border-left td-dashed-y text-small">${tanggalAudit}</td>
                <td colspan="10" class="text-center bg-gray-50">Auditor</td>
                <td colspan="9" class="text-center bg-gray-50">Auditee</td>
            </tr>
            <tr class="font-semibold">
                <td colspan="12" class="no-border-right td-dashed-y text-small">Dept/Proses</td>
                <td class="no-border-x text-center td-dashed-y text-small">:</td>
                <td colspan="30" class="no-border-left td-dashed-y text-small">${deptName}</td>
                <td colspan="10" rowspan="3" class="text-center align-bottom" style="height:55px; padding: 2px;">
                    <div id="print-stamp-auditor-${category}" style="margin: 0 auto; min-height:40px;"></div>
                </td>
                <td colspan="9" rowspan="3" class="text-center align-bottom" style="height:55px; padding: 2px;">
                    <div id="print-stamp-auditee-${category}" style="margin: 0 auto; min-height:40px;"></div>
                </td>
            </tr>
            <tr class="font-semibold">
                <td colspan="12" class="no-border-right td-dashed-y text-small">Kriteria Audit</td>
                <td class="no-border-x text-center td-dashed-y text-small">:</td>
                <td colspan="30" class="no-border-left td-dashed-y text-small">${kriteriaHtml} *)</td>
            </tr>
            <tr class="font-semibold">
                <td colspan="12" class="no-border-right td-dashed-y text-small">Jenis Audit</td>
                <td class="no-border-x text-center td-dashed-y text-small">:</td>
                <td colspan="30" class="no-border-left td-dashed-y text-small">${isSys} Sistem / ${isPro} Proses / ${isPrd} Produk</td>
            </tr>
            <tr class="font-semibold text-small">
                <td colspan="43" style="border-right: none; border-bottom: none;" class="td-dashed-y"></td>
                <td colspan="10" class="text-center" id="print-name-auditor-${category}">${trimName(auditorName)}</td>
                <td colspan="9" class="text-center" id="print-name-auditee-${category}">${trimName(auditeeName)}</td>
            </tr>

            <tr class="font-semibold text-small">
                <td colspan="62" style="border-bottom: none; padding-top: 15px;">Historical problem / panduan audit</td>
            </tr>
            <tr class="font-semibold text-small">
                <td class="text-center" style="border-top: none; border-bottom: none; border-right: none;">${isChecked('Customer Claim')}</td>
                <td colspan="9" style="border: none;">Customer Claim</td>
                <td class="text-center" style="border: none;">${isChecked('Rejection')}</td>
                <td colspan="6" style="border: none;">Rejection</td>
                <td class="text-center" style="border: none;">${isChecked('PQCC')}</td>
                <td colspan="7" style="border: none;">PQCC</td>
