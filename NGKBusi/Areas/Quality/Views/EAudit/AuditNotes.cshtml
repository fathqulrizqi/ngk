    function switchTab(category) {
        $('.tab-content').removeClass('active');
        $('.tab-btn').removeClass('bg-white text-blue-700 border-white shadow-md scale-105').addClass('bg-white/20 text-white border-white/30 backdrop-blur-md');
        $(`#tab-content-${category}`).addClass('active');
        $(`#tab-btn-${category}`).removeClass('bg-white/20 text-white border-white/30 backdrop-blur-md').addClass('bg-white text-blue-700 border-white shadow-md scale-105');
        globalActiveTab = category;
    }

    function executeSign(category, role, status, btnElement) {
        const isApprove = status === 'Approved';
        Swal.fire({
            title: isApprove ? `Approve Form ${category}?` : `Reject Form ${category}?`,
            text: `Anda akan menandatangani sebagai ${role} dengan status ${status.toUpperCase()}.`,
            icon: isApprove ? 'question' : 'warning',
            showCancelButton: true,
            confirmButtonColor: isApprove ? '#10b981' : '#e11d48',
            confirmButtonText: isApprove ? 'Ya, Approve' : 'Ya, Reject'
        }).then((result) => {
            if (result.isConfirmed) {
                const payload = {
                    audit_event_stakeholder_id: globalStakeholderId,
                    category_recap: `Catatan Audit (${category})`,
                    recap_sign_role: role,
                    recap_sign_status: status
                };

                $.ajax({
                    url: '@Url.Action("UpsertApprovalRecapAudit", "EAudit")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if (res.success) {
                            $(btnElement).parent().hide();
                            const dateObj = new Date();
                            const dateString = `${String(dateObj.getDate()).padStart(2, '0')} ${["JAN","FEB","MAR","APR","MEI","JUN","JUL","AGU","SEP","OKT","NOV","DES"][dateObj.getMonth()]} ${dateObj.getFullYear()}`;

                            const htmlCap = isApprove
                                ? `<div class="stamp-circle stamp-approved-circle"><span class="stamp-text">APPROVED</span><span class="stamp-date">${dateString}</span></div>`
                                : `<div class="stamp-circle stamp-rejected-circle"><span class="stamp-text">REJECTED</span><span class="stamp-date">${dateString}</span></div>`;

                            $(`#stamp-container-${role.toLowerCase()}-${category}`).html(htmlCap);
                            $(`#name-lbl-${role.toLowerCase()}-${category}`).text(currentUserName).addClass("font-bold text-slate-900");

                            $(`#print-stamp-${role.toLowerCase()}-${category}`).html(htmlCap);
                            $(`#print-name-${role.toLowerCase()}-${category}`).text(currentUserName);

                            Swal.fire({ title: 'Berhasil!', icon: 'success', timer: 1500, showConfirmButton: false });
                        } else {
                            Swal.fire('Gagal', res.message, 'error');
                        }
                    }
                });
            }
        });
    }

    function renderExistingVerificationStamp(category, role, status, dateStr, signerName) {
        if (!status) return;
        const roleKey = role.toLowerCase();
        $(`.action-btns-${category}-${roleKey}`).hide();

        let dateObj = new Date();
        if (dateStr) {
            let timestamp = parseInt(dateStr.replace(/\/Date\((\d+)\)\//, '$1'));
            if (!isNaN(timestamp)) dateObj = new Date(timestamp);
        }
        const dateString = `${String(dateObj.getDate()).padStart(2, '0')} ${["JAN", "FEB", "MAR", "APR", "MEI", "JUN", "JUL", "AGU", "SEP", "OKT", "NOV", "DES"][dateObj.getMonth()]} ${dateObj.getFullYear()}`;

        const htmlCap = status.toLowerCase() === 'approved'
            ? `<div class="stamp-circle stamp-approved-circle"><span class="stamp-text">APPROVED</span><span class="stamp-date">${dateString}</span></div>`
            : `<div class="stamp-circle stamp-rejected-circle"><span class="stamp-text">REJECTED</span><span class="stamp-date">${dateString}</span></div>`;

        $(`#stamp-container-${roleKey}-${category}`).html(htmlCap);
        $(`#name-lbl-${roleKey}-${category}`).text(signerName).addClass("font-bold text-slate-900");

        $(`#print-stamp-${roleKey}-${category}`).html(htmlCap);
        $(`#print-name-${roleKey}-${category}`).text(signerName);
    }

    function printReport() {
        $('#printAllContainer').printThis({
            importCSS: true,
            importStyle: true,
            printContainer: true,
            pageTitle: "Form Catatan Audit",
            removeInline: false
        });
    }

    function exportExcel() {
        if (!globalStakeholderId) {
            Swal.fire('Error', 'ID Stakeholder tidak ditemukan di URL.', 'error');
            return;
        }

        $('#loadingOverlay').fadeIn();
        window.location.href = '@Url.Action("ExportExcelCatatanAudit", "EAudit")' + '?id=' + globalStakeholderId;

        setTimeout(() => {
            $('#loadingOverlay').fadeOut();
        }, 1500);
    }
    function openReminderModal() {
    const modal = document.getElementById('reminderModal');
    modal.classList.remove('hidden');
}

function closeReminderModal() {
    const modal = document.getElementById('reminderModal');
    modal.classList.add('hidden');

    // Reset form saat ditutup
    document.getElementById('reminderMessage').value = "";
    const checkboxes = document.querySelectorAll('input[name="reminderUsers"]');
    checkboxes.forEach(cb => cb.checked = false);
}

function processReminder(jenisReminder, docId) {
    // 1. Tutup modal terlebih dahulu agar layar fokus ke loading alert
    

    // 2. Ambil semua checkbox yang dicentang
    const selectedCheckboxes = document.querySelectorAll('input[name="reminderUsers"]:checked');
    const selectedEmails = Array.from(selectedCheckboxes).map(cb => cb.value);
    const message = document.getElementById('reminderMessage').value;

    // 3. Validasi: pastikan user sudah dipilih minimal 1
    if (selectedEmails.length === 0) {
        Swal.fire({
            icon: 'warning',
            title: 'Penerima Kosong',
            text: 'Silakan pilih minimal satu penerima (Auditee atau Auditor).',
            confirmButtonColor: '#0f766e'
        }).then(() => {
            // Buka kembali modal jika validasi gagal
            openReminderModal();
        });
        return;
    }

    closeReminderModal();
    // 4. Tampilkan loading (menunggu respon server)
    Swal.fire({
        title: 'Mengirim Reminder...',
        text: 'Mohon tunggu sebentar, email sedang dikirim.',
        allowOutsideClick: false,
        showConfirmButton: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });

    // 5. Setup data (payload) yang akan dikirim ke Controller
    const payload = {
        emails: selectedEmails,
        message: message,
        id: docId,
        jenisReminder: jenisReminder
    };

    // 6. Eksekusi AJAX ke Backend (Menggunakan Razor Url.Action)
    $.ajax({
        url: '@Url.Action("SendReminderEmail", "EAudit")', // URL Dinamis Razor
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload),
        success: function (response) {
            if (response.status === "success") {
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    text: response.message,
                    confirmButtonColor: '#0f766e'
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Gagal!',
                    text: response.message,
                    confirmButtonColor: '#dc2626'
                });
            }
        },
        error: function () {
            Swal.fire({
                icon: 'error',
                title: 'Error Koneksi',
                text: 'Terjadi kesalahan saat menghubungi server untuk mengirim email.',
                confirmButtonColor: '#dc2626'
            });
        }
    });
}
</script>