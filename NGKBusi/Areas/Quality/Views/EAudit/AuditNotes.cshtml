    function renderForms(data, guidesData, notesData, requestedType, standardsData) {
        const tabsContainer = $('#tabsContainer');
        const formsContainer = $('#formsContainer');
        const printAllContainer = $('#printAllContainer');

        tabsContainer.empty();
        formsContainer.empty();
        printAllContainer.empty();

        const groupedData = {}; const groupedGuides = {}; const groupedNotes = {};
        if(data) data.forEach(item => {
            const cat = item.CategoryAudit && item.CategoryAudit !== "-" ? item.CategoryAudit : 'System';
            if (!groupedData[cat]) groupedData[cat] = []; groupedData[cat].push(item);
        });
        if(guidesData) guidesData.forEach(g => {
            const cat = g.CategoryAudit || 'System';
            if (!groupedGuides[cat]) groupedGuides[cat] = []; groupedGuides[cat].push(g.GuideName);
        });
        if(notesData) notesData.forEach(n => {
            const cat = n.CategoryAudit || 'System';
            if (!groupedNotes[cat]) groupedNotes[cat] = []; groupedNotes[cat].push(n.Note);
        });

        const allCategories = new Set([...Object.keys(groupedData)]);
        if (allCategories.size === 0) allCategories.add('System');

        let tabsHtml = '';
        let formsHtml = '';
        let printAllHtmlCombined = '';

        const categoriesToRender = requestedType === 'ALL' ? Array.from(allCategories) : [requestedType];
        const kriteriaString = 'ISO 9001 : 2015 / IATF 16949 : 2016 / ISO 14001 : 2015 / ISO 45001 : 2018';

        categoriesToRender.forEach((category, index) => {
            const isActive = index === 0;
            if(isActive) globalActiveTab = category;

            const items = groupedData[category] || [];
            const guides = groupedGuides[category] || [];
            const generalNotes = groupedNotes[category] || [];

            tabsHtml += `
                <button onclick="switchTab('${category}')" id="tab-btn-${category}" class="tab-btn px-6 py-2 font-bold text-sm rounded-full transition-all duration-300 whitespace-nowrap border ${isActive ? 'bg-white text-blue-700 border-white shadow-md scale-105' : 'bg-white/20 text-white border-white/30 hover:bg-white/30 backdrop-blur-md'}">
                    <i class="bi bi-file-earmark-text mr-1.5"></i> ${category}
                </button>
            `;

            const isSys = category === 'System' ? 'checked' : '';
            const isPro = category === 'Process' ? 'checked' : '';
            const isPrd = category === 'Product' ? 'checked' : '';

            const defaultGuides = ['Customer Claim', 'Rejection', 'PQCC', 'CSR', 'Temuan audit', 'FMEA', 'Klausul ISO'];
            const isChecked = (name) => guides.includes(name) ? 'checked' : '';
