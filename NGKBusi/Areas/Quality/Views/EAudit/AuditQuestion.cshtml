        function loadAuditNote() {
            // Pengaturan disabled state
            if (!window.isAssignedAuditor) {
                 $('#txtGeneralAuditNote')
                    .prop('disabled', true)
                    .addClass('bg-slate-100 cursor-not-allowed opacity-75 text-slate-500');
            } else {
                 $('#txtGeneralAuditNote')
                    .prop('disabled', false)
                    .removeClass('bg-slate-100 cursor-not-allowed opacity-75 text-slate-500')
                    .addClass('bg-white');
            }

            $.ajax({
                url: apiGetAuditNoteUrl,
                type: 'GET',
                data: { stakeholderId: paramStakeholderId, categoryAudit: paramAuditType },
                success: function (res) {
                    if (res.success) {
                        $('#txtGeneralAuditNote').val(res.data);
                    }
                }
            });
        }

        let typingTimerNote;
        $(document).on('input', '#txtGeneralAuditNote', function () {
            if (window.isAssignedAuditor) {
                clearTimeout(typingTimerNote);
                // Menunggu user selesai mengetik (1 detik) sebelum auto-save
                typingTimerNote = setTimeout(function () {
                    saveAuditNote();
                }, 1000);
            }
        });

        function saveAuditNote() {
            let noteContent = $('#txtGeneralAuditNote').val();
            let $status = $('#auditNoteSaveStatus');

            $status.html('<i class="bi bi-arrow-repeat animate-spin inline-block"></i> Menyimpan...')
                .removeClass('text-emerald-500 text-red-500 hidden')
                .addClass('text-slate-400 inline-block');

            const dto = {
                audit_event_stakeholder_id: paramStakeholderId,
                category_audit: paramAuditType,
                note: noteContent
            };

            $.ajax({
                url: apiSaveAuditNoteUrl,
                type: 'POST',
                data: dto,
                success: function (res) {
                    if (res.success) {
                        $status.html('<i class="bi bi-check2-all"></i> Tersimpan')
                            .removeClass('text-slate-400')
                            .addClass('text-emerald-500');
                        setTimeout(() => $status.fadeOut(300), 2500);
                    } else {
                        $status.html('<i class="bi bi-exclamation-triangle"></i> Gagal Menyimpan')
                            .removeClass('text-slate-400')
                            .addClass('text-red-500');
                    }
                },
                error: function () {
                    $status.html('<i class="bi bi-wifi-off"></i> Error Koneksi')
                        .removeClass('text-slate-400')
                        .addClass('text-red-500');
                }
            });
        }


