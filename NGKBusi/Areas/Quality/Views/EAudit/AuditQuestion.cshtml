        function submitAudit() {
            let isValid = true;
            let errorMessages = [];

            $('.q-score-dropdown').each(function () {
                let val = $(this).val();

                if (val && String(val).trim() !== '') {
                    let selectedOpt = this.options[this.selectedIndex];
                    let judgementText = selectedOpt.getAttribute('data-default-judgement') || '';

                    if (!judgementText || judgementText === 'undefined' || judgementText === 'null') {
                        let match = selectedOpt.text.match(/\(([^)]+)\)/);
                        if (match) {
                            judgementText = match[1];
                        }
                    }

                    let upperVal = (judgementText || '').toUpperCase().trim();

                    if (upperVal === 'MINOR' || upperVal === 'MAJOR') {
                        let $parent = $(this).closest('.relative.bg-white');
                        let qNum = $parent.find('span.bg-blue-600').text() || 'Soal';

                        let prob = $parent.find('input[id^="finding_prob_"]').val().trim();
                        let loc = $parent.find('input[id^="finding_loc_"]').val().trim();
                        let obj = $parent.find('input[id^="finding_obj_"]').val().trim();
                        let ref = $parent.find('input[id^="finding_ref_"]').val().trim();

                        if (!prob || !loc || !obj || !ref) {
                            isValid = false;
                            errorMessages.push(`<b>${qNum}</b>: Mohon lengkapi (Problem, Location, Object, Reference)`);
                        }
                    }
                }
            });

            if (!isValid) {
                Swal.fire({
                    title: 'Finding Details Kosong!',
                    html: '<div class="text-sm text-slate-600 mb-2">Terdapat temuan MINOR/MAJOR yang detailnya belum lengkap:</div>' +
                          '<div class="text-left text-sm text-red-600 bg-red-50 p-3 rounded border border-red-100 leading-relaxed">' +
                          errorMessages.join('<br>') +
                          '</div>',
                    icon: 'warning',
                    confirmButtonColor: '#3b82f6',
                    confirmButtonText: 'Mengerti'
                });
                return;
            }

            Swal.fire({
                title: 'Submit Audit?',
                text: "Apakah Anda yakin ingin menyelesaikan dan mengirim audit ini? Pastikan semua soal telah terjawab.",
                icon: 'question',
