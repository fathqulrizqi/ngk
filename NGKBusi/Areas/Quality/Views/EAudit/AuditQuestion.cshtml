        function downloadEvidence(url, suggestedFileName) {
            if (!url) return;

            if (url.startsWith('data:')) {
                const a = document.createElement('a');
                a.href = url;

                let ext = ".bin";
                if (url.includes('image/jpeg')) ext = ".jpg";
                else if (url.includes('image/png')) ext = ".png";
                else if (url.includes('application/pdf')) ext = ".pdf";

                a.download = suggestedFileName + ext;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                return;
            }

            let rootPath = '@Url.Content("~/")';
            let finalUrl = url;

            if (url.startsWith('/')) {
                finalUrl = rootPath + url.substring(1);
            }

            let actualFileName = finalUrl.substring(finalUrl.lastIndexOf('/') + 1);

            const a = document.createElement('a');
            a.href = finalUrl;
            a.download = actualFileName;

            a.target = '_blank';
            a.rel = 'noopener noreferrer';

            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        $(document).on('change', '#chkLainLain', function() {
            if ($(this).is(':checked')) {
                $('#txtLainLain').removeClass('hidden').focus();
            } else {
                $('#txtLainLain').addClass('hidden').val('');
            }
        });


        function loadAuditGuides() {
            if (window.isAssignedAuditor) {
                $('#btnSaveGuide').removeClass('hidden');
                $('.guide-checkbox, #txtLainLain').prop('disabled', false);
            } else {
                $('#btnSaveGuide').addClass('hidden');
                $('.guide-checkbox, #txtLainLain').prop('disabled', true);
            }

            $.ajax({
                url: apiGetGuideUrl,
                type: 'GET',
                data: { stakeholderId: paramStakeholderId, categoryAudit: paramAuditType },
                success: function (res) {
                    if (res.success && res.data) {
                        $('.guide-checkbox').prop('checked', false);
                        $('#txtLainLain').addClass('hidden').val('');

                        res.data.forEach(function (guideName) {
                            let $chk = $(`.guide-checkbox[value="${guideName}"]`);

                            if ($chk.length > 0) {
                                $chk.prop('checked', true);
                            } else if (guideName.startsWith("Lain-lain:")) {
                                $('#chkLainLain').prop('checked', true);
                                $('#txtLainLain').removeClass('hidden').val(guideName.replace("Lain-lain: ", "").trim());
                            }
                        });
                    }
                }
            });
        }

        $(document).on('change', '.guide-checkbox', function () {
            if (window.isAssignedAuditor) {
                saveAuditGuides();
            }
        });

        let typingTimerGuide;
        $(document).on('input', '#txtLainLain', function () {
            if (window.isAssignedAuditor) {
                clearTimeout(typingTimerGuide);
                typingTimerGuide = setTimeout(function () {
                    saveAuditGuides();
                }, 1000);
            }
        });

        function saveAuditGuides() {
            let selectedGuides = [];

            $('.guide-checkbox:checked').each(function () {
                let val = $(this).val();
                if (val === "Lain-lain") {
                    let customText = $('#txtLainLain').val().trim();
                    if (customText !== "") {
                        selectedGuides.push("Lain-lain: " + customText);
                    } else {
                        selectedGuides.push("Lain-lain");
                    }
                } else {
                    selectedGuides.push(val);
                }
            });

            let $status = $('#guideSaveStatus');

            $status.html('<i class="bi bi-arrow-repeat animate-spin inline-block"></i> Menyimpan...')
                .removeClass('text-emerald-500 text-red-500 hidden')
                .addClass('text-slate-400');

            $.ajax({
                url: apiSaveGuideUrl,
                type: 'POST',
                data: {
                    audit_event_stakeholder_id: paramStakeholderId,
                    category_audit: paramAuditType,
                    selected_guides: selectedGuides
                },
                success: function (res) {
                    if (res.success) {
                        $status.html('<i class="bi bi-check2-all"></i> Tersimpan')
                            .removeClass('text-slate-400')
                            .addClass('text-emerald-500');

                        setTimeout(() => $status.fadeOut(300), 2000);
                    } else {
                        $status.html('<i class="bi bi-exclamation-triangle"></i> Gagal Menyimpan')
                            .removeClass('text-slate-400')
                            .addClass('text-red-500');
                    }
                },
                error: function () {
                    $status.html('<i class="bi bi-wifi-off"></i> Error Koneksi')
                        .removeClass('text-slate-400')
                        .addClass('text-red-500');
                }
            });
        }
    </script>
}