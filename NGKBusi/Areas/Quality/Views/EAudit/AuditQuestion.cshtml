        function renderHeader(info) {
            if (!info) return;

            $('#lblSectionName').text(info.section_name || 'N/A');
            $('#lblAuditType').text(`${paramAuditType} Audit`);
            $('#lblAuditName').text(info.audit_name || 'N/A');

            $('#inputStakeholderId').val(info.stakeholder_id);
            $('#formStakeholderId').val(info.stakeholder_id);

            const formatDate = (dateStr, isInput) => {
                if (!dateStr) return '';

                let timestamp = dateStr;
                if (typeof dateStr === 'string' && dateStr.indexOf('/Date(') > -1) {
                    timestamp = parseInt(dateStr.replace(/[^0-9]/g, ''));
                }

                const d = new Date(timestamp);

                if (isNaN(d.getTime())) return '';

                if (isInput) {
                    const year = d.getFullYear();
                    const month = String(d.getMonth() + 1).padStart(2, '0');
                    const day = String(d.getDate()).padStart(2, '0');
                    return `${year}-${month}-${day}`;
                }

                return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
            };

            if (jsIsAdmin && $('#inputStartDate').length) {
                $('#inputStartDate').val(formatDate(info.start_event, true));
                $('#inputEndDate').val(formatDate(info.end_event, true));
            } else if ($('#lblPeriodDate').length) {
                $('#lblPeriodDate').text(`${formatDate(info.start_event, false)} - ${formatDate(info.end_event, false)}`);
            }
        }

        function renderPersons(dataList, containerSelector, emptyMsg) {
            const $container = $(containerSelector);
            $container.empty();

            if (!dataList || dataList.length === 0) {
                $container.html(`<div class="p-3 bg-slate-50 border border-slate-100 rounded-lg text-center text-[10px] sm:text-xs text-slate-400 italic">${emptyMsg}</div>`);
                return;
            }

            let html = '';
            $.each(dataList, function(index, p) {
                let deleteBtn = jsIsAdmin ? `
                    <button type="button" onclick="deletePerson('${p.audity_auditor_id}')" class="hidden sm:group-hover:flex sm:absolute right-2 top-1/2 sm:-translate-y-1/2 w-6 h-6 items-center justify-center bg-red-50 text-red-500 hover:bg-red-500 hover:text-white rounded transition-colors mt-2 sm:mt-0" title="Remove">
                        <i class="bi bi-trash text-xs"></i>
                    </button>
                ` : '';

                html += `
                    <div id="person_${p.audity_auditor_id}" class="relative group p-3 bg-slate-50 hover:bg-slate-100 border border-slate-100 rounded-lg transition-colors flex flex-col sm:block">
                        <h6 class="font-bold text-slate-800 text-xs sm:text-sm mb-0.5 line-clamp-1 pr-0 sm:pr-6">${p.person_name || '-'}</h6>
                        <div class="text-[9px] sm:text-[10px] text-slate-500 font-medium uppercase tracking-wider mb-1">${p.role || '-'}</div>
                        <div class="text-[10px] sm:text-xs text-blue-600 truncate pr-0 sm:pr-6"><i class="bi bi-envelope mr-1"></i>${p.email || '-'}</div>
                        ${deleteBtn}
                    </div>
                `;
            });
            $container.html(html);
        }

        function openPersonModal(role) {
            $('#personModalTitle').text('Add ' + role);
            $('#personRole').val(role);

            $('#personForm')[0].reset();
            $('#personDetailPreview').addClass('hidden');
            $('#personCategoryAudit').val(paramAuditType);

            const $select = $('#personSelect');
            $select.empty();
            $select.append(`<option value="" disabled selected>-- Select ${role} --</option>`);

            const dataSource = listUser;

            if (dataSource && dataSource.length > 0) {
                $.each(dataSource, function(i, p) {
                    $select.append(`<option value="${p.NIK}"
                                            data-name="${p.name || ''}"
                                            data-email="${p.email || ''}"
                                            data-section="${window.info.section_name}">${p.name} (${p.NIK})</option>`);
                });
            } else {
                $select.append(`<option value="" disabled>Data Master ${role} Kosong</option>`);
            }

            if(role.includes('Audit')) {
                if (role === 'Auditee' || role === 'Auditee') {
                    $('#personModal .bg-gradient-to-r').removeClass('from-blue-600 to-blue-500').addClass('from-emerald-600 to-emerald-500');
                    $('#personModal button.bg-blue-600').removeClass('bg-blue-600 hover:bg-blue-700').addClass('bg-emerald-600 hover:bg-emerald-700');
                } else {
                    $('#personModal .bg-gradient-to-r').removeClass('from-emerald-600 to-emerald-500').addClass('from-blue-600 to-blue-500');
                    $('#personModal button.bg-emerald-600').removeClass('bg-emerald-600 hover:bg-emerald-700').addClass('bg-blue-600 hover:bg-blue-700');
                }
            }

            $('#personModal').removeClass('hidden').addClass('flex');
        }

        function handlePersonSelection(selectElement) {
            const $selectedOption = $(selectElement).find(':selected');

            const nik = $selectedOption.val();
            const name = $selectedOption.data('name');
            const email = $selectedOption.data('email');
            const section = $selectedOption.data('section');

            $('#personNik').val(nik);
            $('#personName').val(name);
            $('#personEmail').val(email);
            $('#personSection').val(section);

            $('#previewNik').text(nik || '-');
            $('#previewEmail').text(email || '-');
            $('#previewSection').text(section || '-');
            $('#personDetailPreview').removeClass('hidden');
        }

        function closePersonModal() {
            $('#personModal').addClass('hidden').removeClass('flex');
        }

        function savePerson() {
            const stakeholderId = $('#inputStakeholderId').val();
            const addedRole = $('#personRole').val();

            const dataPayload = {
                audit_event_stakeholder_id: stakeholderId,
                person_name: $('#personName').val(),
                nik: $('#personNik').val(),
                email: $('#personEmail').val(),
                section: $('#personSection').val(),
                role: $('#personRole').val(),
                category_audit: $('#personCategoryAudit').val()
            };

            if(!dataPayload.person_name || !dataPayload.nik) {
                Swal.fire('Peringatan', 'Silakan pilih person dari dropdown terlebih dahulu.', 'warning');
                return;
            }

            Swal.fire({
                title: 'Menyimpan...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '@Url.Action("AddPerson", "EAudit")',
                type: 'POST',
                data: dataPayload,
                success: function(res) {
                    if (res.success) {
                        Swal.fire('Berhasil!', res.message, 'success');
                        closePersonModal();
                        refreshPersonList(addedRole, stakeholderId);
                    } else {
                        Swal.fire('Gagal', res.message, 'error');
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire('Error', 'Terjadi kesalahan pada server.', 'error');
                }
            });

            function refreshPersonList(role, stakeholderId) {
                let apiUrl = '';
                let container = '';
                let emptyMsg = '';

                if (role === 'Auditor') {
                    apiUrl = apiAuditorUrl;
                    container = '#auditorsListContainer';
                    emptyMsg = 'No auditors assigned.';
                } else if (role === 'Auditie' || role === 'Auditee') {
                    apiUrl = apiAuditieUrl;
                    container = '#auditeesListContainer';
                    emptyMsg = 'No auditees assigned.';
                }

                $(container).html('<div class="animate-pulse flex space-x-4"><div class="flex-1 space-y-2 py-1"><div class="h-3 bg-slate-200 rounded w-3/4"></div><div class="h-3 bg-slate-200 rounded w-1/2"></div></div></div>');

                $.ajax({
                    url: apiUrl,
                    type: 'GET',
                    data: { stakeholderId: stakeholderId, type: paramAuditType },
                    success: function (res) {
                        if (res.success) {
                            renderPersons(res.data, container, emptyMsg);
                        } else {
                            $(container).html(`<div class="text-xs text-red-500 p-2">Gagal memuat ulang data.</div>`);
                        }
                    },
                    error: function () {
                        $(container).html(`<div class="text-xs text-red-500 p-2">Error koneksi saat memuat data.</div>`);
                    }
                });
            }
        }

        function deletePerson(personId) {
            Swal.fire({
                title: 'Hapus Peserta?',
                text: "Anda yakin ingin menghapus peserta ini dari audit?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Ya, Hapus!'
            }).then((result) => {
                if (result.isConfirmed) {

                    Swal.fire({
                        title: 'Menghapus...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.ajax({
                        url: '@Url.Action("DeletePerson", "EAudit")',
                        type: 'POST',
                        data: { id: personId },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    toast: true, position: 'top-end', showConfirmButton: false,
                                    timer: 2000, icon: 'success', title: response.message
                                });

                                $(`#person_${personId}`).fadeOut(300, function() {
                                    $(this).remove();
                                    refreshPersonList()
                                });
                            } else {
                                Swal.fire('Gagal', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'Gagal menghubungi server. Periksa koneksi Anda.', 'error');
                        }
                    });
                }
            });
        }


