        function saveAuditPeriod() {
            const stakeholderId = $('#inputStakeholderId').val();
            const startDate = $('#inputStartDate').val();
            const endDate = $('#inputEndDate').val();

            if (!stakeholderId) {
                Swal.fire('Error', 'Stakeholder ID tidak ditemukan.', 'error');
                return;
            }
            if (!startDate || !endDate) {
                Swal.fire('Peringatan', 'Periode Audit (Start Date & End Date) wajib diisi.', 'warning');
                return;
            }
            if (new Date(startDate) > new Date(endDate)) {
                Swal.fire('Peringatan', 'Start Date tidak boleh lebih besar dari End Date.', 'warning');
                return;
            }

            Swal.fire({
                title: 'Menyimpan Periode...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            const dataPayload = {
                id: stakeholderId,
                dto: {
                    start_event: startDate,
                    end_event: endDate
                }
            };

            $.ajax({
                url: '@Url.Action("UpdateStakeholder", "EAudit")',
                type: 'POST',
                data: dataPayload,
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            toast: true, position: 'top-end', showConfirmButton: false,
                            timer: 2000, icon: 'success', title: 'Periode Audit diperbarui!'
                        });
                    } else {
                        Swal.fire('Gagal menyimpan', response.message, 'error');
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire('Error Server', 'Gagal menyimpan periode audit. Periksa koneksi Anda.', 'error');
                }
            });
        }

