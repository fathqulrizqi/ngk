        function handleScoreChange(selectElement, idx) {
            if (typeof recalculateProgress === "function") {
                recalculateProgress();
            }

            const selectedOption = $(selectElement).find(':selected');
            const defaultNote = selectedOption.data('criteria');

            const $textArea = $(`#note-text-${idx}`);
            if (!$textArea.val() && defaultNote && defaultNote !== "null") {
                $textArea.val(defaultNote);
            }

            let judgementText = selectedOption.data('default-judgement') || '';
            let upperVal = judgementText.toUpperCase().trim();

            if (upperVal === 'MINOR' || upperVal === 'MAJOR') {
                $(`#finding-container-${idx}`).slideDown(200).removeClass('hidden');
            } else {
                $(`#finding-container-${idx}`).slideUp(200);
            }
        }

        function updateProgress(questions) {
