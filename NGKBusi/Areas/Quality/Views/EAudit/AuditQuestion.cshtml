        function recalculateProgress() {
            let total = $('.q-score-dropdown').length;
            let answered = 0;

            let statusCounts = {
                'OK': 0,
                'OFI': 0,
                'MINOR': 0,
                'MAJOR': 0
            };

            $('.q-score-dropdown').each(function () {
                let val = $(this).val();

                if (val && String(val).trim() !== '') {
                    answered++;

                    let judgementText = '';
                    if (this.selectedIndex >= 0) {
                        let selectedOpt = this.options[this.selectedIndex];
                        judgementText = selectedOpt.getAttribute('data-default-judgement') || '';

                        if (!judgementText || judgementText === 'undefined' || judgementText === 'null') {
                            let textOpt = selectedOpt.text;
                            let match = textOpt.match(/\(([^)]+)\)/);
                            if (match) {
                                judgementText = match[1];
                            }
                        }
                    }

                    let upperVal = (judgementText || '').toUpperCase().trim();

                    if (statusCounts[upperVal] !== undefined) {
                        statusCounts[upperVal]++;
                    }
                }
            });

            applyProgressUI(answered, total, statusCounts);
        }

        function applyProgressUI(answered, total, counts) {
            const percentage = total > 0 ? Math.round((answered / total) * 100) : 0;

            $('#lblProgressCount').text(`${answered} / ${total}`);
            $('#progressBar').css('width', `${percentage}%`);

            if ($('#lblBottomProgress').length) {
                $('#lblBottomProgress').text(`Progress: ${answered} of ${total} questions answered`);
            }

            if (counts) {
                $('#countOK').text(`${counts['OK'] || 0} OK`);
                $('#countOFI').text(`${counts['OFI'] || 0} OFI`);
                $('#countMINOR').text(`${counts['MINOR'] || 0} MINOR`);
                $('#countMAJOR').text(`${counts['MAJOR'] || 0} MAJOR`);
            }
        }

