            const $generalNoteContainer = $('#generalAuditNoteContainer');

            $container.empty();

            if (!questions || questions.length === 0) {
                $badgeCount.text("0");
                $container.html(`
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8 md:p-12 text-center">
                        <div class="w-12 h-12 sm:w-16 sm:h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-3 sm:mb-4">
                            <i class="bi bi-inbox text-slate-400 text-2xl sm:text-3xl"></i>
                        </div>
