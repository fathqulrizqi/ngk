                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Memproses...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.ajax({
                        url: '@Url.Action("SubmitAuditSection", "EAudit")',
                        type: 'POST',
                        data: {
                            audit_event_stakeholder_id: paramStakeholderId,
                            category_audit: paramAuditType
                        },
