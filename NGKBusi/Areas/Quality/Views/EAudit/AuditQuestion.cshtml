@{
    ViewBag.Title = "Audit Execution";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isAdmin = ViewBag.Role == "Administrator";
    string userNik = ViewBag.UserNik ?? "";
    bool isAssignedAuditor = ViewBag.isAssignedAuditor;
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<style>
    html, body {
        background-image: linear-gradient(135deg, #2563eb 0%, #bae6fd 55%, #f8fafc 100%);
        background-size: cover;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
    }
</style>

<div class="min-h-screen pt-2 pb-10 p-2 sm:p-4 md:p-6 lg:px-0 relative">
    <div class="max-w-7xl mx-auto">

        <div class="mb-4">
            <a href="javascript:history.back()" class="inline-flex items-center text-sm font-medium text-white hover:text-blue-700 transition-colors">
                <i class="bi bi-arrow-left mr-1.5"></i> Back to Sections
            </a>
        </div>

        <div id="loadingIndicator" class="text-center py-20">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mb-2"></div>
            <p class="text-slate-500 text-sm font-medium">Menarik data dari server...</p>
        </div>

        <div id="mainContent" class="hidden">

            <div class="flex flex-col mb-6 bg-white p-4 sm:p-5 md:p-6 rounded-xl border border-slate-200 shadow-sm">
                <div class="flex flex-col md:flex-row md:justify-between md:items-start">
                    <div>
                        <div class="flex items-center gap-3 mb-1">
                            <h3 id="lblSectionName" class="text-xl sm:text-2xl font-bold text-slate-800 m-0">Loading...</h3>
                            <span id="lblAuditType" class="bg-blue-100 text-blue-800 text-[10px] sm:text-xs font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wide">...</span>
                        </div>
                        <p id="lblAuditName" class="text-xs sm:text-sm text-slate-500 m-0">Loading...</p>
                        <p class="text-xs sm:text-sm text-slate-500 m-0">No. Dok: PMLK3-MR-09/L3</p>
                    </div>

                    <div class="md:mt-0 flex flex-col md:items-end w-full md:w-auto mt-4 md:mt-0">
                        @if (isAdmin)
                        {
                            <label class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Audit Period</label>
                            <form id="formAuditPeriod" class="flex flex-wrap sm:flex-nowrap items-center gap-2 w-full sm:w-auto">
                                <input type="hidden" id="inputStakeholderId" name="stakeholderId" />
                                <input type="date" id="inputStartDate" name="startDate" class="flex-1 sm:flex-none border border-slate-200 bg-slate-50 text-slate-700 rounded-lg shadow-sm py-1.5 px-2 text-xs sm:text-sm focus:ring-blue-500 focus:border-blue-500" />
                                <span class="text-slate-400 text-sm hidden sm:inline">-</span>
                                <input type="date" id="inputEndDate" name="endDate" class="flex-1 sm:flex-none border border-slate-200 bg-slate-50 text-slate-700 rounded-lg shadow-sm py-1.5 px-2 text-xs sm:text-sm focus:ring-blue-500 focus:border-blue-500" />
                                <button type="button" onclick="saveAuditPeriod()" class="w-full sm:w-auto mt-2 sm:mt-0 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-1.5 rounded-lg shadow-sm text-xs sm:text-sm transition-colors">
                                    Save
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="text-xs sm:text-sm text-slate-600 flex items-center font-semibold bg-slate-100 px-3 py-1.5 rounded-lg w-full sm:w-auto justify-center md:justify-start">
                                <i class="bi bi-calendar4 mr-2 text-blue-600"></i>
                                <span id="lblPeriodDate">Loading...</span>
                            </div>
                        }
                    </div>
                </div>

                <hr class="my-4 border-slate-100">
                <div class="w-full">
                    <div class="flex justify-between items-center mb-3">
                        <label class="text-xs sm:text-sm font-bold text-slate-700 uppercase tracking-wider"><i class="bi bi-ui-radios mr-1"></i> Audit Guide <span class="text-red-500 normal-case font-normal text-[10px]">*Minimal pilih 1</span></label>
                        <span id="guideSaveStatus" class="text-[10px] sm:text-xs font-bold transition-all hidden"></span>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 sm:gap-3 text-xs sm:text-sm text-slate-700 font-medium">
                        <label class="flex items-center gap-2 cursor-pointer hover:text-blue-600"><input type="checkbox" value="Customer Claim" class="guide-checkbox w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-blue-500"> Customer Claim</label>
                        <label class="flex items-center gap-2 cursor-pointer hover:text-blue-600"><input type="checkbox" value="Rejection" class="guide-checkbox w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-blue-500"> Rejection</label>
                        <label class="flex items-center gap-2 cursor-pointer hover:text-blue-600"><input type="checkbox" value="PQCC" class="guide-checkbox w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-blue-500"> PQCC</label>
                        <label class="flex items-center gap-2 cursor-pointer hover:text-blue-600"><input type="checkbox" value="CSR" class="guide-checkbox w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-blue-500"> CSR</label>
                        <label class="flex items-center gap-2 cursor-pointer hover:text-blue-600"><input type="checkbox" value="Temuan audit" class="guide-checkbox w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-blue-500"> Temuan audit</label>
                        <label class="flex items-center gap-2 cursor-pointer hover:text-blue-600"><input type="checkbox" value="FMEA" class="guide-checkbox w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-blue-500"> FMEA</label>
                        <label class="flex items-center gap-2 cursor-pointer hover:text-blue-600"><input type="checkbox" value="Klausul ISO" class="guide-checkbox w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-blue-500"> Klausul ISO</label>

                        <div class="flex flex-col sm:flex-row sm:items-center gap-2 col-span-2 md:col-span-1">
                            <label class="flex items-center gap-2 cursor-pointer hover:text-blue-600 whitespace-nowrap">
                                <input type="checkbox" id="chkLainLain" value="Lain-lain" class="guide-checkbox w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-blue-500"> Lain-lain
                            </label>
                            <input type="text" id="txtLainLain" class="hidden text-xs border border-slate-300 rounded px-2 py-1 w-full focus:ring-blue-500 focus:border-blue-500" placeholder="Sebutkan..." />
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-col lg:flex-row lg:items-start gap-6">

                <div class="w-full lg:w-1/3 xl:w-1/4 flex flex-col gap-4 sm:gap-5 lg:sticky lg:top-6">
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 sm:p-5">
                        <div class="flex justify-between items-center mb-3 sm:mb-4">
                            <h6 class="font-bold text-slate-800 flex items-center text-sm m-0">
                                <div class="w-5 h-5 sm:w-6 sm:h-6 rounded bg-blue-100 flex items-center justify-center mr-2">
                                    <i class="bi bi-person-check-fill text-blue-600 text-[10px] sm:text-xs"></i>
                                </div>
                                Auditors
                            </h6>
                            @if (isAdmin)
                            {
                                <button type="button" onclick="openPersonModal('Auditor')" class="text-[10px] sm:text-xs bg-slate-50 hover:bg-blue-50 text-blue-600 font-semibold py-1 px-2.5 rounded border border-slate-200 hover:border-blue-200 transition-colors">
                                    <i class="bi bi-plus-lg"></i> Add
                                </button>
                            }
                        </div>
                        <div id="auditorsListContainer" class="space-y-3"></div>
                    </div>

                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 sm:p-5">
                        <div class="flex justify-between items-center mb-3 sm:mb-4">
                            <h6 class="font-bold text-slate-800 flex items-center text-sm m-0">
                                <div class="w-5 h-5 sm:w-6 sm:h-6 rounded bg-emerald-100 flex items-center justify-center mr-2">
                                    <i class="bi bi-people-fill text-emerald-600 text-[10px] sm:text-xs"></i>
                                </div>
                                Auditees
                            </h6>
                            @if (isAdmin)
                            {
                                <button type="button" onclick="openPersonModal('Auditee')" class="text-[10px] sm:text-xs bg-slate-50 hover:bg-emerald-50 text-emerald-600 font-semibold py-1 px-2.5 rounded border border-slate-200 hover:border-emerald-200 transition-colors">
                                    <i class="bi bi-plus-lg"></i> Add
                                </button>
                            }
                        </div>
                        <div id="auditeesListContainer" class="space-y-3"></div>
                    </div>

                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm pt-3 p-4 sm:p-5">
                        <h6 class="font-bold text-slate-800 mb-3 sm:mb-4 text-sm sm:text-base">Section Progress</h6>
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-[10px] sm:text-xs font-medium text-slate-500">Answered</span>
                            <span id="lblProgressCount" class="text-[10px] sm:text-xs font-bold text-slate-800">0 / 0</span>
                        </div>
                        <div class="w-full bg-slate-200/70 rounded-full h-2 mb-4 overflow-hidden">
                            <div id="progressBar" class="bg-blue-500 h-2 rounded-full transition-all duration-700 ease-out" style="width: 0%"></div>
                        </div>
                        <hr class="border-slate-100 mb-3">
                        <div class="text-[10px] sm:text-xs font-medium text-slate-500 mb-2 sm:mb-3">Status Summary</div>
                        <div class="flex flex-wrap gap-2">
                            <span id="countOK" class="bg-green-100 text-green-700 text-[10px] sm:text-xs font-medium px-2.5 py-1 rounded shadow-sm">0 OK</span>
                            <span id="countOFI" class="bg-blue-100 text-blue-700 text-[10px] sm:text-xs font-medium px-2.5 py-1 rounded shadow-sm">0 OFI</span>
                            <span id="countMINOR" class="bg-orange-100 text-orange-700 text-[10px] sm:text-xs font-medium px-2.5 py-1 rounded shadow-sm">0 MINOR</span>
                            <span id="countMAJOR" class="bg-red-100 text-red-700 text-[10px] sm:text-xs font-medium px-2.5 py-1 rounded shadow-sm">0 MAJOR</span>
                        </div>
                    </div>
                </div>

                <div class="w-full lg:w-2/3 xl:w-3/4 flex flex-col gap-4 sm:gap-5">

                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-3 sm:p-4 flex flex-wrap justify-between items-center gap-3">
                        <h6 class="font-bold text-slate-800 flex items-center text-sm md:text-base m-0">
                            <i class="bi bi-ui-checks text-blue-600 mr-2"></i> Audit Questions
                            <span id="lblTotalQuestionsBadge" class="ml-3 bg-slate-100 text-slate-600 border border-slate-200 text-xs font-bold px-2.5 py-0.5 rounded-full">0</span>
                        </h6>

                        <div class="flex gap-2">
                            @if (isAssignedAuditor || isAdmin)
                            {
                                <button type="button" onclick="openAddQuestionModal()" class="w-full sm:w-auto justify-center bg-blue-600 hover:bg-blue-700 text-white font-semibold py-1.5 px-3 rounded-lg shadow-sm text-sm transition-colors flex items-center">
                                    <i class="bi bi-plus mr-1.5"></i> Add Question
                                </button>
                            }
                            @if (isAdmin)
                            {
                                <button type="button" onclick="openImportQuestionModal()" class="w-full sm:w-auto justify-center bg-[#107c41] hover:bg-[#0c5e31] text-white font-semibold py-1.5 px-3 rounded-lg shadow-sm text-sm transition-colors flex items-center">
                                    <i class="bi bi-file-earmark-excel mr-1.5"></i> Import Question
                                </button>
                            }
                        </div>
                    </div>

                    <form id="auditForm" method="post" action="SubmitAuditSection" enctype="multipart/form-data">
                        <input type="hidden" id="formStakeholderId" name="stakeholderId" />

                        <div id="questionsContainer"></div>

                        <div id="generalAuditNoteContainer" class="hidden bg-white rounded-xl border border-slate-200 shadow-sm p-4 sm:p-5 mt-4 sm:mt-5 transition-all">
                            <div class="flex justify-between items-center mb-3">
                                <label class="text-xs sm:text-sm font-bold text-slate-700 uppercase tracking-wider"><i class="bi bi-journal-text mr-1 text-blue-600"></i> General Audit Note</label>
                                <span id="auditNoteSaveStatus" class="text-[10px] sm:text-xs font-bold transition-all hidden"></span>
                            </div>
                            <textarea id="txtGeneralAuditNote" class="block w-full border border-slate-200 text-slate-800 rounded-lg shadow-sm p-3 sm:p-4 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-xs sm:text-sm resize-y transition-shadow" rows="4" placeholder="Tuliskan catatan umum, rangkuman, atau kesimpulan audit di sini..."></textarea>
                        </div>
                        <div id="saveActionContainer" class="hidden bg-white p-3 sm:p-4 rounded-xl border border-slate-200 shadow-sm flex-col sm:flex-row justify-between items-center mt-4 mb-8 gap-3 sm:gap-4">
                            <span id="lblBottomProgress" class="text-xs sm:text-sm font-medium text-slate-500 text-center sm:text-left">Progress: 0 of 0 questions answered</span>

                            <button type="button" id="btnSubmitAuditSection" onclick="submitAudit()" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 sm:py-2.5 px-8 rounded-lg text-sm transition-colors shadow-sm flex items-center justify-center cursor-pointer">
                                <i class="bi bi-send-check-fill mr-2"></i> Submit Audit
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<div id="personModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden overflow-y-auto h-full w-full z-50 items-center justify-center p-4">
    <div class="relative mx-auto bg-white rounded-2xl shadow-2xl ring-1 ring-slate-900/5 w-full max-w-md overflow-hidden transition-all">
        <div class="px-6 py-4 bg-gradient-to-r from-blue-600 to-blue-500 opacity-90 flex items-center justify-between">
            <h3 id="personModalTitle" class="text-xl font-bold text-white tracking-wide">Add Person</h3>
            <button type="button" onclick="closePersonModal()" class="text-blue-100 hover:text-white transition-colors">
                <i class="bi bi-x-lg text-lg"></i>
            </button>
        </div>
        <div class="p-6">
            <form id="personForm" class="space-y-4">
                <input type="hidden" id="personRole" name="role" />
                <input type="hidden" id="personNik" name="nik" />
                <input type="hidden" id="personName" name="person_name" />
                <input type="hidden" id="personEmail" name="email" />
                <input type="hidden" id="personSection" name="section" />
                <input type="hidden" id="personCategoryAudit" name="category_audit" />
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Select Person</label>
                    <select id="personSelect" onchange="handlePersonSelection(this)" required class="block w-full border border-slate-300 rounded-lg shadow-sm py-2 px-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all cursor-pointer">
                        <option value="" disabled selected>-- Select Person --</option>
                    </select>
                </div>
                <div id="personDetailPreview" class="hidden mt-3 p-3 bg-slate-50 border border-slate-100 rounded-lg text-xs text-slate-600">
                    <p><strong>NIK:</strong> <span id="previewNik">-</span></p>
                    <p><strong>Email:</strong> <span id="previewEmail">-</span></p>
                    <p><strong>Section:</strong> <span id="previewSection">-</span></p>
                </div>
            </form>
        </div>
        <div class="px-6 py-4 border-t border-slate-100 flex justify-end gap-3 bg-slate-50/50">
            <button type="button" onclick="closePersonModal()" class="px-5 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-semibold hover:bg-slate-50 transition-all focus:outline-none focus:ring-2 focus:ring-slate-200">
                Cancel
            </button>
            <button type="button" onclick="savePerson()" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 transition-colors text-white rounded-lg text-sm font-semibold shadow-sm focus:outline-none focus:ring-4 focus:ring-blue-500/30">
                Save
            </button>
        </div>
    </div>
</div>

<div id="addQuestionModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden overflow-y-auto h-full w-full z-50 items-center justify-center p-4">
    <div class="relative mx-auto bg-white rounded-2xl shadow-2xl ring-1 ring-slate-900/5 w-full max-w-lg overflow-hidden transition-all">
        <div class="px-6 py-4 bg-gradient-to-r from-blue-600 to-blue-500 opacity-90 flex items-center justify-between">
            <h3 class="text-xl font-bold text-white tracking-wide">Add New Question</h3>
            <button type="button" onclick="closeAddQuestionModal()" class="text-blue-100 hover:text-white transition-colors">
                <i class="bi bi-x-lg text-lg"></i>
            </button>
        </div>
        <div class="p-6">
            <form id="addQuestionForm" class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Evidence</label>
                    <input type="text" id="add_process_name" class="block w-full border border-slate-300 rounded-lg shadow-sm py-2 px-3 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600" placeholder="Ya/Tidak" required />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Clausul</label>
                    <input type="text" id="add_clausul" class="block w-full border border-slate-300 rounded-lg shadow-sm py-2 px-3 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600" placeholder="e.g. 7.1.2" required />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Question</label>
                    <textarea id="add_question" rows="3" class="block w-full border border-slate-300 rounded-lg shadow-sm py-2 px-3 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 resize-y" placeholder="Type the question here..." required></textarea>
                </div>
            </form>
        </div>
        <div class="px-6 py-4 border-t border-slate-100 flex justify-end gap-3 bg-slate-50/50">
            <button type="button" onclick="closeAddQuestionModal()" class="px-5 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-semibold hover:bg-slate-50">Cancel</button>
            <button type="button" onclick="submitAddQuestion()" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold shadow-sm">Save Question</button>
        </div>
    </div>
</div>

<div id="importQuestionModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden overflow-y-auto h-full w-full z-50 items-center justify-center p-4">
    <div class="relative mx-auto bg-white rounded-2xl shadow-2xl ring-1 ring-slate-900/5 w-full max-w-md overflow-hidden transition-all">
        <div class="px-6 py-4 bg-gradient-to-r from-[#107c41] to-[#0c5e31] opacity-90 flex items-center justify-between">
            <h3 class="text-xl font-bold text-white tracking-wide">Import Questions</h3>
            <button type="button" onclick="closeImportQuestionModal()" class="text-green-100 hover:text-white transition-colors">
                <i class="bi bi-x-lg text-lg"></i>
            </button>
        </div>
        <div class="p-6">
            <form id="importQuestionForm" class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Upload Excel File</label>
                    <input type="file" id="import_excel_file" accept=".xlsx, .xls" class="block w-full border border-slate-300 rounded-lg shadow-sm py-2 px-3 text-sm focus:outline-none file:mr-4 file:py-1 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100" required />
                </div>
            </form>
        </div>
        <div class="px-6 py-4 border-t border-slate-100 flex justify-end gap-3 bg-slate-50/50">
            <button type="button" onclick="closeImportQuestionModal()" class="px-5 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-semibold hover:bg-slate-50">Cancel</button>
            <button type="button" onclick="submitImportQuestion()" class="px-5 py-2 bg-[#107c41] hover:bg-[#0c5e31] text-white rounded-lg text-sm font-semibold shadow-sm">Import Now</button>
        </div>
    </div>
</div>
@section Scripts {
    <script>
       const masterAuditors = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            ViewBag.Auditor ?? new List<object>(),
            new Newtonsoft.Json.JsonSerializerSettings { ReferenceLoopHandling = Newtonsoft.Json.ReferenceLoopHandling.Ignore }
        ));

        const masterAuditees = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            ViewBag.Auditie ?? new List<object>(),
            new Newtonsoft.Json.JsonSerializerSettings { ReferenceLoopHandling = Newtonsoft.Json.ReferenceLoopHandling.Ignore }
        ));

        const listUser = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            ViewBag.ListUser ?? new List<object>(),
            new Newtonsoft.Json.JsonSerializerSettings { ReferenceLoopHandling = Newtonsoft.Json.ReferenceLoopHandling.Ignore }
        ));

        console.log(listUser);

        const currentUserNik = '@userNik';
        const jsIsAdmin = @(isAdmin.ToString().ToLower());

        const urlParams = new URLSearchParams(window.location.search);
        const paramStakeholderId = urlParams.get('stakeholderId');
        const paramAuditType = urlParams.get('type');
        const judgementCriteriaList = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.CriteriaList ?? new List<object>()));

        const apiInfoUrl = '@Url.Action("GetAuditInfo", "EAudit")';
        const apiAuditorUrl = '@Url.Action("GetAuditAuditor", "EAudit")';
        const apiAuditieUrl = '@Url.Action("GetAuditAuditie", "EAudit")';
        const apiQuestionUrl = '@Url.Action("GetAuditQuestion", "EAudit")';
        const apiGetGuideUrl = '@Url.Action("GetAuditGuides", "EAudit")';
        const apiSaveGuideUrl = '@Url.Action("SaveAuditGuides", "EAudit")';

        // --- API URL UNTUK AUDIT NOTE ---
        const apiGetAuditNoteUrl = '@Url.Action("GetAuditNote", "EAudit")';
        const apiSaveAuditNoteUrl = '@Url.Action("SaveAuditNote", "EAudit")';

        window.isSystemAdmin = jsIsAdmin;
        window.isAssignedAuditor = false;

        $(document).ready(function() {
            if (!paramStakeholderId || !paramAuditType) {
                alert("Parameter tidak lengkap di URL!");
                return;
            }
            fetchDataParalel();
        });

        function fetchDataParalel() {
            $('#loadingIndicator').removeClass('hidden');
            $('#mainContent').addClass('hidden');

            var reqInfo = $.ajax({ url: apiInfoUrl, type: 'GET', data: { stakeholderId: paramStakeholderId } });
            var reqAuditor = $.ajax({ url: apiAuditorUrl, type: 'GET', data: { stakeholderId: paramStakeholderId, type: paramAuditType } });
            var reqAuditie = $.ajax({ url: apiAuditieUrl, type: 'GET', data: { stakeholderId: paramStakeholderId, type: paramAuditType } });
            var reqQuestion = $.ajax({ url: apiQuestionUrl, type: 'GET', data: { stakeholderId: paramStakeholderId, type: paramAuditType } });

            $.when(reqInfo, reqAuditor, reqAuditie, reqQuestion)
                .done(function (resInfo, resAuditor, resAuditie, resQuestion) {
                    var dataInfo = resInfo[0];
                    var dataAuditor = resAuditor[0];
                    var dataAuditie = resAuditie[0];
                    var dataQuestion = resQuestion[0];

                    if (dataInfo.success) renderHeader(dataInfo.data);

                    window.info = dataInfo.data;

                    window.isAssignedAuditor = false;
                    if (dataAuditor.success && dataAuditor.data) {
                        window.isAssignedAuditor = dataAuditor.data.some(a => String(a.nik).trim() === String(currentUserNik).trim());
                    }

                    if (!window.isAssignedAuditor) {
                        $('#btnSubmitAuditSection').hide();
                    } else {
                        $('#btnSubmitAuditSection').show();
                    }

                    loadAuditGuides();
                    loadAuditNote(); // Tarik catatan audit

                    if (dataAuditor.success) renderPersons(dataAuditor.data, '#auditorsListContainer', 'No auditors assigned.');
                    if (dataAuditie.success) renderPersons(dataAuditie.data, '#auditeesListContainer', 'No auditees assigned.');

                    if (dataQuestion.success) {
                        renderQuestions(dataQuestion.data);
                        let total = dataQuestion.data.length;
                        let answered = dataQuestion.data.filter(q => q.score && q.score.trim() !== '').length;
                        applyProgressUI(answered, total, dataQuestion.summary);
                    }

                    $('#loadingIndicator').addClass('hidden');
                    $('#mainContent').removeClass('hidden');
                })
                .fail(function (xhr, status, error) {
                    console.error("Terjadi error saat fetch data:", error);
                    alert("Gagal menghubungi server. Periksa koneksi atau console.");
                });
        }

