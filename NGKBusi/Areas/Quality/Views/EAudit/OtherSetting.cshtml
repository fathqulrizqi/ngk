@section Scripts {
    <script>
        // --- DATA STATE UNTUK PAGINATION & SEARCH ---
        const tableState = {
            'Section': { originalData: [], filteredData: [], currentPage: 1, itemsPerPage: 5 },
            'Judgement': { originalData: [], filteredData: [], currentPage: 1, itemsPerPage: 5 },
            'Access': { originalData: [], filteredData: [], currentPage: 1, itemsPerPage: 5 },
            'Standard': { originalData: [], filteredData: [], currentPage: 1, itemsPerPage: 5 }
        };

        $(document).ready(function() {
            loadData('Section');
            loadData('Judgement');
            loadData('Access');
            loadData('Standard');
        });

        // --- HELPER DATE ---
        function formatDate(dateStr, includeTime = false) {
            if (!dateStr) return "-";
            let date;
            if (typeof dateStr === 'string' && dateStr.includes('/Date(')) {
                date = new Date(parseInt(dateStr.replace(/\/Date\((.*?)\)\//gi, "$1")));
            } else {
                date = new Date(dateStr);
            }
            if (isNaN(date.getTime())) return "-";

            const pad = n => n.toString().padStart(2, '0');
            const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

            let formatted = `${pad(date.getDate())} ${months[date.getMonth()]} ${date.getFullYear()}`;
            if (includeTime) formatted += `, ${pad(date.getHours())}:${pad(date.getMinutes())}`;
            return formatted;
        }

        // --- FUNGSI AJAX FETCH ---
        function loadData(type) {
            const getEndpoints = {
                'Section': 'GetSections',
                'Judgement': 'GetJudgements',
                'Access': 'GetAccesses',
                'Standard': 'GetStandards'
            };

            const actionName = getEndpoints[type];
            const baseUrl = '@Url.Action("Placeholder", "EAudit", new { area = "Quality" })';
            const url = baseUrl.replace("Placeholder", actionName);

            $(`#tbody-${type}`).html(`<tr><td colspan="6" class="px-6 py-8 text-center text-slate-400">Loading data...</td></tr>`);

            $.ajax({
                url: url,
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        // Simpan data mentah ke originalData
                        tableState[type].originalData = response.data || [];

                        // Terapkan pencarian jika ada teks yang tertinggal di input search
                        const searchTerm = $(`#search-${type}`).val() || "";
                        applySearch(type, searchTerm);
                    } else {
                        $(`#tbody-${type}`).html(`<tr><td colspan="6" class="px-6 py-8 text-center text-rose-500">Failed: ${response.message}</td></tr>`);
                    }
                },
                error: function () {
                    $(`#tbody-${type}`).html(`<tr><td colspan="6" class="px-6 py-8 text-center text-rose-500">Server error while loading data.</td></tr>`);
                }
            });
        }

        // --- LOGIKA SEARCH / FILTERING ---
        function handleSearch(type) {
            const term = $(`#search-${type}`).val();
            applySearch(type, term);
        }

        function applySearch(type, term) {
            const state = tableState[type];
            const lowerTerm = term.toLowerCase().trim();

            // Selalu reset ke page 1 ketika melakukan pencarian
            state.currentPage = 1;

            if (!lowerTerm) {
                // Jika input kosong, tampilkan semua
                state.filteredData = [...state.originalData];
            } else {
                // Filter data: Cek apakah nilai dari salah satu kolom objek mengandung kata kunci
                state.filteredData = state.originalData.filter(item => {
                    return Object.values(item).some(val =>
                        val !== null && String(val).toLowerCase().includes(lowerTerm)
                    );
                });
            }

            renderPaginatedTable(type);
        }

        // --- RENDER PAGINASI & DATA ARRAY SLICE ---
        function renderPaginatedTable(type) {
            const state = tableState[type];

            // Gunakan filteredData, BUKAN originalData
            const totalItems = state.filteredData.length;
            const totalPages = Math.ceil(totalItems / state.itemsPerPage) || 1;

            // Mencegah out of bounds
            if (state.currentPage > totalPages) state.currentPage = totalPages;
            if (state.currentPage < 1) state.currentPage = 1;

            const startIndex = (state.currentPage - 1) * state.itemsPerPage;
            const endIndex = startIndex + state.itemsPerPage;

            // Potong array data terfilter sesuai itemsPerPage
            const currentData = state.filteredData.slice(startIndex, endIndex);

            renderTable(type, currentData);
            renderPaginationControls(type, totalItems, totalPages, startIndex, Math.min(endIndex, totalItems));
        }

        function renderTable(type, data) {
            const tbody = $(`#tbody-${type}`);
            tbody.empty();

            if (!data || data.length === 0) {
                tbody.html(`<tr><td colspan="6" class="px-6 py-8 text-center text-slate-400">No data found</td></tr>`);
                return;
            }

            data.forEach(item => {
                let tr = `<tr class="hover:bg-slate-50 transition-colors duration-200">`;

                if (type === 'Section') {
                    tr += `<td class="px-6 py-4 text-slate-500 font-medium">${item.section_id}</td>`;
                    tr += `<td class="px-6 py-4 text-slate-800 font-semibold">${item.section_name}</td>`;
                    tr += `<td class="px-6 py-4 text-center">
                                <button onclick="openSectionModal('${item.section_id}', '${item.section_name.replace(/'/g, "\\'")}')" class="text-blue-600 hover:text-blue-800 font-semibold mr-4 transition-colors">Edit</button>
                                <button onclick="deleteData('Section', '${item.section_id}')" class="text-rose-500 hover:text-rose-700 font-semibold transition-colors">Delete</button>
                           </td>`;
                }
                else if (type === 'Judgement') {
                    tr += `<td class="px-6 py-4 text-slate-800 font-semibold">${item.score}</td>`;
                    tr += `<td class="px-6 py-4 text-slate-600">${item.criteria}</td>`;
                    tr += `<td class="px-6 py-4"><span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20">${item.judgement}</span></td>`;
                    tr += `<td class="px-6 py-4 text-center">
                                <button onclick="openJudgementModal('${item.judgement_criteri_id}', '${item.score}', '${item.criteria.replace(/'/g, "\\'")}', '${item.judgement}')" class="text-blue-600 hover:text-blue-800 font-semibold mr-4 transition-colors">Edit</button>
                                <button onclick="deleteData('Judgement', '${item.judgement_criteri_id}')" class="text-rose-500 hover:text-rose-700 font-semibold transition-colors">Delete</button>
                           </td>`;
                }
                else if (type === 'Access') {
                    const safeName = item.name ? item.name : '-';
                    const escapedName = item.name ? item.name.replace(/'/g, "\\'") : '';
                    const escapedEmail = item.email ? item.email.replace(/'/g, "\\'") : '';

                    tr += `<td class="px-6 py-4 text-slate-800 font-semibold">${item.NIK}</td>`;
                    tr += `<td class="px-6 py-4 text-slate-600 font-medium">${item.email}</td>`;
                    tr += `<td class="px-6 py-4 text-slate-600 font-medium">${safeName}</td>`;
                    tr += `<td class="px-6 py-4"><span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-indigo-50 text-indigo-700 ring-1 ring-inset ring-indigo-600/20">${item.access}</span></td>`;
                    tr += `<td class="px-6 py-4 text-slate-500">${formatDate(item.created_at)}</td>`;
                    tr += `<td class="px-6 py-4 text-slate-500">${formatDate(item.updated_at)}</td>`;
                    tr += `<td class="px-6 py-4 text-center">
                                <button onclick="openAccessModal('${item.access_id}', '${item.NIK}', '${escapedName}', '${escapedEmail}', '${item.access}')" class="text-blue-600 hover:text-blue-800 font-semibold mr-4 transition-colors">Edit</button>
                                <button onclick="deleteData('Access', '${item.access_id}')" class="text-rose-500 hover:text-rose-700 font-semibold transition-colors">Delete</button>
                           </td>`;
                }
                // Ganti blok ini di dalam renderTable:
                else if (type === 'Standard') {
                        const escapedStdName = item.audit_standard_name ? item.audit_standard_name.replace(/'/g, "\\'") : '';
                        const escapedMrName = item.mr_name ? item.mr_name.replace(/'/g, "\\'") : '';
                        const escapedMrEmail = item.mr_email ? item.mr_email.replace(/'/g, "\\'") : '';

                        const safeMrName = item.mr_name ? item.mr_name : '-';
                        const safeMrEmail = item.mr_email ? item.mr_email : '-';

                        tr += `<td class="px-6 py-4 text-slate-500 font-medium">${item.audit_standard_id}</td>`;
                        tr += `<td class="px-6 py-4 text-slate-800 font-semibold">${item.audit_standard_name}</td>`;

                        // --> INI TAMBAHANNYA <--
                        tr += `<td class="px-6 py-4 text-slate-600">${safeMrName}</td>`;
                        tr += `<td class="px-6 py-4 text-slate-600">${safeMrEmail}</td>`;

                        tr += `<td class="px-6 py-4 text-center">
                    <button onclick="openStandardModal('${item.audit_standard_id}', '${escapedStdName}', '${escapedMrName}', '${escapedMrEmail}')" class="text-blue-600 hover:text-blue-800 font-semibold mr-4 transition-colors">Edit</button>
                    <button onclick="deleteData('Standard', '${item.audit_standard_id}')" class="text-rose-500 hover:text-rose-700 font-semibold transition-colors">Delete</button>
               </td>`;
                }
                tr += `</tr>`;
                tbody.append(tr);
            });
        }

        // --- RENDER PAGINATION HTML (Dengan Ellipsis) ---
        function renderPaginationControls(type, totalItems, totalPages, startIndex, actualEnd) {
            const container = $(`#pagination-${type}`);

            if (totalItems === 0) {
                container.html('');
                return;
            }

            const current = tableState[type].currentPage;

            let html = `
                <div class="flex flex-col sm:flex-row w-full items-center justify-between gap-4 text-sm text-slate-600">
                    <div>
                        Showing <span class="font-medium text-slate-900">${startIndex + 1}</span> to <span class="font-medium text-slate-900">${actualEnd}</span> of <span class="font-medium text-slate-900">${totalItems}</span> results
                    </div>
                    <div class="flex items-center gap-1">
                        <button onclick="changePage('${type}', ${current - 1})" class="px-3 py-1.5 border border-slate-200 rounded-md hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors" ${current === 1 ? 'disabled' : ''}>Prev</button>
            `;

            const getPageList = (c, t) => {
                if (t <= 5) return Array.from({ length: t }, (_, i) => i + 1);
                if (c <= 3) return [1, 2, 3, 4, '...', t];
                if (c >= t - 2) return [1, '...', t - 3, t - 2, t - 1, t];
                return [1, '...', c - 1, c, c + 1, '...', t];
            };

            const pages = getPageList(current, totalPages);

            pages.forEach(p => {
                if (p === '...') {
                    html += `<span class="px-2 py-1.5 text-slate-400 font-medium tracking-widest">...</span>`;
                } else if (p === current) {
                    html += `<button class="px-3 py-1.5 bg-blue-600 text-white border border-blue-600 rounded-md font-medium shadow-sm">${p}</button>`;
                } else {
                    html += `<button onclick="changePage('${type}', ${p})" class="px-3 py-1.5 border border-slate-200 text-slate-700 rounded-md hover:bg-slate-100 transition-colors">${p}</button>`;
                }
            });

            html += `
                        <button onclick="changePage('${type}', ${current + 1})" class="px-3 py-1.5 border border-slate-200 rounded-md hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors" ${current === totalPages ? 'disabled' : ''}>Next</button>
                    </div>
                </div>
            `;

            container.html(html);
        }

        function changePage(type, newPage) {
            tableState[type].currentPage = newPage;
            renderPaginatedTable(type);
        }

        // --- LOGIKA UTALITAS TAB ---
        function openTab(evt, tabName) {
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-blue-600', 'text-white', 'border-transparent');
                btn.classList.add('bg-white', 'text-slate-600', 'border-slate-200', 'hover:bg-slate-50');
            });
            document.getElementById(tabName).classList.add('active');
            evt.currentTarget.classList.remove('bg-white', 'text-slate-600', 'border-slate-200', 'hover:bg-slate-50');
            evt.currentTarget.classList.add('bg-blue-600', 'text-white', 'border-transparent');
        }

        // --- GLOBAL MODAL CONTROLLERS ---
        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) modal.classList.add('hidden');
        }

        document.addEventListener('keydown', function (event) {
            if (event.key === "Escape") ['sectionModal', 'judgementModal', 'accessModal', 'standardModal'].forEach(id => closeModal(id));
        });

        function openSectionModal(id = '', name = '') {
            document.getElementById('sectionForm').reset();
            document.getElementById('modal_section_id').value = id;
            document.getElementById('modal_section_name').value = name;
            document.getElementById('sectionModalTitle').innerText = id ? "Edit Section" : "Add New Section";
            document.getElementById('sectionModal').classList.remove('hidden');
            setTimeout(() => document.getElementById('modal_section_name').focus(), 100);
        }

        function openJudgementModal(id = '', score = '', criteria = '', judgement = '') {
            document.getElementById('judgementForm').reset();
            document.getElementById('modal_judgement_criteria_id').value = id;
            document.getElementById('modal_judgement_score').value = score;
            document.getElementById('modal_judgement_criteria').value = criteria;
            document.getElementById('modal_judgement_status').value = judgement;
            document.getElementById('judgementModalTitle').innerText = id ? "Edit Judgement Criteria" : "Add Judgement Criteria";
            document.getElementById('judgementModal').classList.remove('hidden');
            setTimeout(() => document.getElementById('modal_judgement_score').focus(), 100);
        }

        function openAccessModal(id = '', nik = '', name = '', email = '', role = '') {
            document.getElementById('accessForm').reset();
            document.getElementById('modal_access_id').value = id;
            document.getElementById('modal_access_nik').value = nik;
            document.getElementById('modal_access_name').value = name;
            document.getElementById('modal_access_email').value = email;
            document.getElementById('modal_access_role').value = role;
            document.getElementById('accessModalTitle').innerText = id ? "Edit Access Mapping" : "Add Access Mapping";
            document.getElementById('accessModal').classList.remove('hidden');
            setTimeout(() => document.getElementById('modal_access_nik').focus(), 100);
        }

        function openStandardModal(id = '', name = '', mrName = '', mrEmail = '') {
            document.getElementById('standardForm').reset();
            document.getElementById('modal_audit_standard_id').value = id;
            document.getElementById('modal_audit_standard_name').value = name;
            document.getElementById('modal_mr_name').value = mrName;
            document.getElementById('modal_mr_email').value = mrEmail;
            document.getElementById('standardModalTitle').innerText = id ? "Edit Audit Standard" : "Add Audit Standard";
            document.getElementById('standardModal').classList.remove('hidden');
            setTimeout(() => document.getElementById('modal_audit_standard_name').focus(), 100);
        }

        // --- SAVE/UPDATE ---
        function saveData(type) {
            let formId, modalId, dataPayload = {};

            if (type === 'Section') {
                formId = 'sectionForm'; modalId = 'sectionModal';
                const id = document.getElementById('modal_section_id').value;
                const name = document.getElementById('modal_section_name').value;
                if (!name.trim()) return validationWarning('Section Name');
                dataPayload = { id: id, section_id: id, section_name: name };
            }
            else if (type === 'Judgement') {
                formId = 'judgementForm'; modalId = 'judgementModal';
                const id = document.getElementById('modal_judgement_criteria_id').value;
                const score = document.getElementById('modal_judgement_score').value;
                const criteria = document.getElementById('modal_judgement_criteria').value;
                const status = document.getElementById('modal_judgement_status').value;
                if (!score.trim() || !criteria.trim() || !status.trim()) return validationWarning('All fields');
                dataPayload = { id: id, judgement_criteri_id: id, score: score, criteria: criteria, judgement: status };
            }
            else if (type === 'Access') {
                formId = 'accessForm'; modalId = 'accessModal';
                const id = document.getElementById('modal_access_id').value;
                const nik = document.getElementById('modal_access_nik').value;
                const name = document.getElementById('modal_access_name').value;
                const email = document.getElementById('modal_access_email').value;
                const role = document.getElementById('modal_access_role').value;
                if (!nik.trim() || !name.trim() || !role || !email.trim()) return validationWarning('NIK, Name, Email and Access Role');
                dataPayload = { id: id, access_id: id, NIK: nik, name: name, access: role, email: email };
            }
            else if (type === 'Standard') {
                formId = 'standardForm'; modalId = 'standardModal';
                const id = document.getElementById('modal_audit_standard_id').value;
                const name = document.getElementById('modal_audit_standard_name').value;
                const mrName = document.getElementById('modal_mr_name').value;
                const mrEmail = document.getElementById('modal_mr_email').value;

                if (!name.trim()) return validationWarning('Audit Standard Name');

                dataPayload = {
                    id: id,
                    audit_standard_id: id,
                    audit_standard_name: name,
                    mr_name: mrName,
                    mr_email: mrEmail
                };
            }

            const isUpdate = Object.values(dataPayload)[0];
            const actionName = isUpdate ? `Update${type}` : `Create${type}`;
            const baseUrl = '@Url.Action("Placeholder", "EAudit", new { area = "Quality" })';
            const url = baseUrl.replace("Placeholder", actionName);

            Swal.fire({ title: 'Saving changes...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            $.ajax({
                url: url,
                type: 'POST',
                data: dataPayload,
                success: function (response) {
                    if (response.success) {
                        closeModal(modalId);
                        Swal.fire({ title: 'Success!', text: response.message || 'Data processed successfully.', icon: 'success', timer: 1000, showConfirmButton: false }).then(() => {
                            loadData(type);
                        });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Failed', text: response.message || 'Error occurred while saving.', confirmButtonColor: '#2563eb' });
                    }
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Server Error', text: 'Could not communicate with server application context.', confirmButtonColor: '#2563eb' });
                }
            });
        }

        // --- DELETE ---
        function deleteData(type, id) {
            Swal.fire({
                title: 'Are you sure?',
                text: `This configuration item will be deleted permanently!`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#cbd5e1',
                cancelButtonText: '<span style="color:#0f172a">Cancel</span>',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Deleting entry...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                    const actionNameDelete = `Delete${type}`;
                    const baseUrlDelete = '@Url.Action("Placeholder", "EAudit", new { area = "Quality" })';
                    const urlDelete = baseUrlDelete.replace("Placeholder", actionNameDelete);

                    $.ajax({
                        url: urlDelete,
                        type: 'POST',
                        data: { id: id },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({ title: 'Deleted!', text: 'The item has been cleared.', icon: 'success', timer: 1000, showConfirmButton: false }).then(() => {
                                    loadData(type);
                                });
                            } else {
                                Swal.fire('Error', response.message || 'Failed to remove entry asset.', 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'Server processing execution failed.', 'error');
                        }
                    });
                }
            });
        }

        function validationWarning(fieldName) {
            Swal.fire({ icon: 'warning', title: 'Validation Warning', text: `${fieldName} data cannot be evaluated empty!`, confirmButtonColor: '#2563eb' });
            return false;
        }
    </script>
}