@{
    ViewBag.Title = "Other Settings - Administrator";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    /* Background Gradient */
    html, body {
        background-image: linear-gradient(135deg, #2563eb 0%, #bae6fd 55%, #f8fafc 100%);
        background-size: cover;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    /* Animasi transisi tab */
    .tab-content {
        display: none;
        animation: fadeIn 0.4s ease-out forwards;
    }

        .tab-content.active {
            display: block;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Animasi Modal */
    .modal-backdrop {
        animation: fadeInBackdrop 0.3s ease-out forwards;
    }

    .modal-panel {
        animation: scaleInModal 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes fadeInBackdrop {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes scaleInModal {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(10px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    /* Custom Scrollbar */
    .table-container::-webkit-scrollbar {
        height: 8px;
    }

    .table-container::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    .table-container::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

        .table-container::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

    .swal2-container {
        z-index: 100000 !important;
    }
</style>

<div class="min-h-screen pt-3 sm:px-0">

    <div class="mb-4">
        <h2 class="text-3xl font-extrabold text-white drop-shadow-sm tracking-tight">Administrator Settings</h2>
        <p class="mt-2 text-sm text-blue-100">Manage system configurations, user access, and audit criteria.</p>
    </div>

    <div class="flex flex-row overflow-x-auto sm:flex-wrap gap-2 mb-8 pb-2 sm:pb-0 hide-scrollbar">
        <button onclick="openTab(event, 'section')" class="tab-btn active whitespace-nowrap bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition-colors border border-transparent" id="defaultOpen">
            Sections
        </button>
        <button onclick="openTab(event, 'judgement')" class="tab-btn whitespace-nowrap bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition-colors">
            Judgement Criteria
        </button>
        <button onclick="openTab(event, 'access')" class="tab-btn whitespace-nowrap bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition-colors">
            User Access
        </button>
        <button onclick="openTab(event, 'standard')" class="tab-btn whitespace-nowrap bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition-colors">
            Audit Standards
        </button>
    </div>

    <div class="pb-10">

        <div id="section" class="tab-content active">
            <div class="bg-white/10 backdrop-blur-md border border-white/20 p-6 rounded-2xl shadow-2xl">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4 sm:gap-0">
                    <div>
                        <h4 class="text-xl font-bold text-white tracking-wide drop-shadow-sm">Section List</h4>
                        <p class="text-sm text-blue-100 mt-1">Manage system operational sections.</p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto items-center">
                        <div class="relative w-full sm:w-64">
                            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400 w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input type="text" id="search-Section" oninput="handleSearch('Section')" placeholder="Search sections..." class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all outline-none">
                        </div>
                        <button type="button" onclick="openSectionModal()" class="w-full sm:w-auto justify-center bg-gradient-to-r from-blue-600 to-cyan-400 opacity-90 hover:opacity-100 transition-all duration-300 text-white px-5 py-2.5 rounded-lg flex items-center font-semibold shadow-md hover:shadow-lg focus:ring-2 focus:ring-cyan-300 focus:outline-none text-sm border border-cyan-400/30 whitespace-nowrap">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 mr-2"><path fill-rule="evenodd" d="M10.5 4.5a1.5 1.5 0 0 1 3 0v6h6a1.5 1.5 0 0 1 0 3h-6v6a1.5 1.5 0 0 1-3 0v-6h-6a1.5 1.5 0 0 1 0-3h6v-6Z" clip-rule="evenodd" /></svg>
                            Add Section
                        </button>
                    </div>
                </div>

                <div class="w-full overflow-hidden rounded-xl shadow-inner border border-slate-200/60 bg-white flex flex-col">
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-slate-50/80 border-b border-slate-200">
                                <tr>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">ID</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">Section Name</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-Section" class="divide-y divide-slate-100"></tbody>
                        </table>
                    </div>
                    <div id="pagination-Section" class="px-6 py-4 border-t border-slate-200 bg-slate-50/50"></div>
                </div>
            </div>
        </div>

        <div id="judgement" class="tab-content">
            <div class="bg-white/10 backdrop-blur-md border border-white/20 p-6 rounded-2xl shadow-2xl">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4 sm:gap-0">
                    <div>
                        <h4 class="text-xl font-bold text-white tracking-wide drop-shadow-sm">Judgement Criteria</h4>
                        <p class="text-sm text-blue-100 mt-1">Configure scoring levels and status.</p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto items-center">
                        <div class="relative w-full sm:w-64">
                            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400 w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input type="text" id="search-Judgement" oninput="handleSearch('Judgement')" placeholder="Search criteria..." class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all outline-none">
                        </div>
                        <button type="button" onclick="openJudgementModal()" class="w-full sm:w-auto justify-center bg-gradient-to-r from-blue-600 to-cyan-400 opacity-90 hover:opacity-100 transition-all duration-300 text-white px-5 py-2.5 rounded-lg flex items-center font-semibold shadow-md hover:shadow-lg focus:ring-2 focus:ring-cyan-300 focus:outline-none text-sm border border-cyan-400/30 whitespace-nowrap">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 mr-2"><path fill-rule="evenodd" d="M10.5 4.5a1.5 1.5 0 0 1 3 0v6h6a1.5 1.5 0 0 1 0 3h-6v6a1.5 1.5 0 0 1-3 0v-6h-6a1.5 1.5 0 0 1 0-3h6v-6Z" clip-rule="evenodd" /></svg>
                            Add Judgement
                        </button>
                    </div>
                </div>

                <div class="w-full overflow-hidden rounded-xl shadow-inner border border-slate-200/60 bg-white flex flex-col">
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-slate-50/80 border-b border-slate-200">
                                <tr>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">Score</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">Criteria</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">Judgement</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-Judgement" class="divide-y divide-slate-100"></tbody>
                        </table>
                    </div>
                    <div id="pagination-Judgement" class="px-6 py-4 border-t border-slate-200 bg-slate-50/50"></div>
                </div>
            </div>
        </div>

        <div id="access" class="tab-content">
            <div class="bg-white/10 backdrop-blur-md border border-white/20 p-6 rounded-2xl shadow-2xl">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4 sm:gap-0">
                    <div>
                        <h4 class="text-xl font-bold text-white tracking-wide drop-shadow-sm">User Access Settings</h4>
                        <p class="text-sm text-blue-100 mt-1">Manage role mapping and permissions.</p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto items-center">
                        <div class="relative w-full sm:w-64">
                            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400 w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input type="text" id="search-Access" oninput="handleSearch('Access')" placeholder="Search NIK or Name..." class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all outline-none">
                        </div>
                        <button type="button" onclick="openAccessModal()" class="w-full sm:w-auto justify-center bg-gradient-to-r from-blue-600 to-cyan-400 opacity-90 hover:opacity-100 transition-all duration-300 text-white px-5 py-2.5 rounded-lg flex items-center font-semibold shadow-md hover:shadow-lg focus:ring-2 focus:ring-cyan-300 focus:outline-none text-sm border border-cyan-400/30 whitespace-nowrap">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 mr-2"><path fill-rule="evenodd" d="M10.5 4.5a1.5 1.5 0 0 1 3 0v6h6a1.5 1.5 0 0 1 0 3h-6v6a1.5 1.5 0 0 1-3 0v-6h-6a1.5 1.5 0 0 1 0-3h6v-6Z" clip-rule="evenodd" /></svg>
                            Add Access
                        </button>
                    </div>
                </div>

                <div class="w-full overflow-hidden rounded-xl shadow-inner border border-slate-200/60 bg-white flex flex-col">
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-slate-50/80 border-b border-slate-200">
                                <tr>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">NIK</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">Email</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">Name</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">Access Role</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">Created At</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">Updated At</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-Access" class="divide-y divide-slate-100"></tbody>
                        </table>
                    </div>
                    <div id="pagination-Access" class="px-6 py-4 border-t border-slate-200 bg-slate-50/50"></div>
                </div>
            </div>
        </div>

        <div id="standard" class="tab-content">
            <div class="bg-white/10 backdrop-blur-md border border-white/20 p-6 rounded-2xl shadow-2xl">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4 sm:gap-0">
                    <div>
                        <h4 class="text-xl font-bold text-white tracking-wide drop-shadow-sm">Audit Standard Master</h4>
                        <p class="text-sm text-blue-100 mt-1">Define standardization rules.</p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto items-center">
                        <div class="relative w-full sm:w-64">
                            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400 w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input type="text" id="search-Standard" oninput="handleSearch('Standard')" placeholder="Search standards..." class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all outline-none">
                        </div>
                        <button type="button" onclick="openStandardModal()" class="w-full sm:w-auto justify-center bg-gradient-to-r from-blue-600 to-cyan-400 opacity-90 hover:opacity-100 transition-all duration-300 text-white px-5 py-2.5 rounded-lg flex items-center font-semibold shadow-md hover:shadow-lg focus:ring-2 focus:ring-cyan-300 focus:outline-none text-sm border border-cyan-400/30 whitespace-nowrap">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 mr-2"><path fill-rule="evenodd" d="M10.5 4.5a1.5 1.5 0 0 1 3 0v6h6a1.5 1.5 0 0 1 0 3h-6v6a1.5 1.5 0 0 1-3 0v-6h-6a1.5 1.5 0 0 1 0-3h6v-6Z" clip-rule="evenodd" /></svg>
                            Add Standard
                        </button>
                    </div>
                </div>

                <div class="w-full overflow-hidden rounded-xl shadow-inner border border-slate-200/60 bg-white flex flex-col">
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-slate-50/80 border-b border-slate-200">
                                <tr>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">ID</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">Audit Standard Name</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">MR Name</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider">MR Email</th>
                                    <th scope="col" class="px-6 py-4 font-bold text-xs text-slate-600 uppercase tracking-wider text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-Standard" class="divide-y divide-slate-100"></tbody>
                        </table>
                    </div>
                    <div id="pagination-Standard" class="px-6 py-4 border-t border-slate-200 bg-slate-50/50"></div>
                </div>
            </div>
        </div>

    </div>
</div>

<div id="sectionModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden h-full w-full flex items-center justify-center p-4" style="z-index: 99999;" role="dialog" aria-modal="true">
    <div class="relative mx-auto bg-white rounded-2xl shadow-2xl ring-1 ring-slate-900/5 w-full max-w-lg flex flex-col max-h-[90vh] modal-panel">
        <div class="px-6 py-4 bg-gradient-to-r from-blue-600 to-cyan-500 opacity-95 flex items-center gap-3 shrink-0 rounded-t-2xl">
            <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-white/20 text-white rounded-xl backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
            </div>
            <div>
                <h3 class="text-xl font-bold text-white tracking-wide" id="sectionModalTitle">Add New Section</h3>
                <p class="text-xs text-cyan-50 mt-0.5">Add or edit an operational section.</p>
            </div>
        </div>
        <form id="sectionForm" class="flex flex-col flex-1 overflow-hidden">
            <input type="hidden" id="modal_section_id" name="section_id" value="" />
            <div class="p-6 overflow-y-auto flex-1 space-y-5">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Section Name <span class="text-red-500">*</span></label>
                    <input type="text" id="modal_section_name" name="section_name" required placeholder="e.g. IT Operations" class="block w-full border border-slate-300 rounded-lg shadow-sm py-2 px-3 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" autocomplete="off">
                </div>
            </div>
            <div class="px-6 py-4 border-t border-slate-100 flex flex-col-reverse sm:flex-row justify-end gap-3 bg-slate-50/50 shrink-0 rounded-b-2xl">
                <button type="button" onclick="closeModal('sectionModal')" class="w-full sm:w-auto px-5 py-2.5 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-semibold hover:bg-slate-50 hover:text-slate-900 transition-all focus:outline-none focus:ring-2 focus:ring-slate-200 text-center">Cancel</button>
                <button type="button" onclick="saveData('Section')" class="w-full sm:w-auto px-5 py-2.5 bg-gradient-to-r from-blue-600 to-cyan-500 opacity-90 hover:opacity-100 transition-opacity text-white rounded-lg text-sm font-semibold shadow-sm hover:shadow focus:outline-none focus:ring-4 focus:ring-blue-500/30 text-center">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<div id="judgementModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden h-full w-full flex items-center justify-center p-4" style="z-index: 99999;" role="dialog" aria-modal="true">
    <div class="relative mx-auto bg-white rounded-2xl shadow-2xl ring-1 ring-slate-900/5 w-full max-w-lg flex flex-col max-h-[90vh] modal-panel">
        <div class="px-6 py-4 bg-gradient-to-r from-blue-600 to-cyan-500 opacity-95 flex items-center gap-3 shrink-0 rounded-t-2xl">
            <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-white/20 text-white rounded-xl backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
            </div>
            <div>
                <h3 class="text-xl font-bold text-white tracking-wide" id="judgementModalTitle">Add Judgement</h3>
                <p class="text-xs text-cyan-50 mt-0.5">Define scoring rules and judgement status.</p>
            </div>
        </div>
        <form id="judgementForm" class="flex flex-col flex-1 overflow-hidden">
            <input type="hidden" id="modal_judgement_criteria_id" name="judgement_criteri_id" value="" />
            <div class="p-6 overflow-y-auto flex-1 space-y-5">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Score <span class="text-red-500">*</span></label>
                    <input type="text" id="modal_judgement_score" name="score" required placeholder="e.g. 100" class="block w-full border border-slate-300 rounded-lg shadow-sm py-2 px-3 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" autocomplete="off">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Criteria <span class="text-red-500">*</span></label>
                    <textarea id="modal_judgement_criteria" name="criteria" rows="3" required placeholder="Describe the criteria" class="block w-full border border-slate-300 rounded-lg shadow-sm py-2 px-3 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all"></textarea>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Judgement <span class="text-red-500">*</span></label>
                    <input type="text" id="modal_judgement_status" name="judgement" required placeholder="e.g. OK / NG" class="block w-full border border-slate-300 rounded-lg shadow-sm py-2 px-3 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" autocomplete="off">
                </div>
            </div>
            <div class="px-6 py-4 border-t border-slate-100 flex flex-col-reverse sm:flex-row justify-end gap-3 bg-slate-50/50 shrink-0 rounded-b-2xl">
                <button type="button" onclick="closeModal('judgementModal')" class="w-full sm:w-auto px-5 py-2.5 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-semibold hover:bg-slate-50 hover:text-slate-900 transition-all focus:outline-none focus:ring-2 focus:ring-slate-200 text-center">Cancel</button>
