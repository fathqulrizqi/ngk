<!-- Modal Background Overlay -->
<div id="reminderModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[1000] flex items-center justify-center no-print transition-opacity">

    <!-- Modal Card (Sesuai dengan tema elegant-section) -->
    <div class="bg-white rounded shadow-2xl w-full max-w-md transform transition-all overflow-hidden flex flex-col max-h-[90vh] border border-gray-200">

        <!-- Modal Header -->
        <div class="bg-gray-50 p-3 border-b border-gray-200 flex justify-between items-center">
            <div>
                <h3 class="text-sm font-bold text-teal-800 uppercase tracking-wide">Send Reminder</h3>
                <p class="text-[11px] text-gray-500 mt-0.5">Select recipients and add an optional message.</p>
            </div>
            <button type="button" onclick="closeReminderModal()" class="text-gray-400 hover:text-red-600 transition cursor-pointer p-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-3 overflow-y-auto flex-1 space-y-4">

            <!-- Checkbox List User -->
            <div>
                <label class="block text-[13px] font-bold text-gray-800 mb-2">Pilih Penerima :</label>

                <!-- Kotak Scrollable -->
                <div class="max-h-48 overflow-y-auto border border-gray-200 rounded bg-white p-2 space-y-3 shadow-inner">

                    <!-- Looping List Auditee -->
                    @if (ViewBag.ListAuditee != null)
                    {
                        <div>
                            <div class="text-[10px] font-bold text-gray-500 mb-1 px-1 uppercase border-b border-gray-100 pb-1">Auditee</div>
                            <div class="space-y-0.5">
                                @foreach (var auditee in ViewBag.ListAuditee)
                                {
                                    <label class="flex items-center p-2 hover:bg-teal-50 rounded cursor-pointer transition">
                                        <input type="checkbox" name="reminderUsers" value="@auditee.Email" class="w-3.5 h-3.5 accent-teal-600 cursor-pointer">
                                        <div class="ml-2 flex flex-col leading-tight">
                                            <span class="text-[13px] font-semibold text-gray-800">@auditee.Name</span>
                                            <span class="text-[10px] text-gray-500">NIK: @auditee.NIK</span>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <!-- Looping List Auditor -->
                    @if (ViewBag.ListAuditor != null)
                    {
                        <div>
                            <div class="text-[10px] font-bold text-gray-500 mb-1 px-1 uppercase border-b border-gray-100 pb-1 mt-2">Auditor</div>
                            <div class="space-y-0.5">
                                @foreach (var auditor in ViewBag.ListAuditor)
                                {
                                    <label class="flex items-center p-2 hover:bg-teal-50 rounded cursor-pointer transition">
                                        <input type="checkbox" name="reminderUsers" value="@auditor.Email" class="w-3.5 h-3.5 accent-teal-600 cursor-pointer">
                                        <div class="ml-2 flex flex-col leading-tight">
                                            <span class="text-[13px] font-semibold text-gray-800">@auditor.Name</span>
                                            <span class="text-[10px] text-gray-500">NIK: @auditor.NIK</span>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Input Pesan Tambahan -->
            <div>
                <label for="reminderMessage" class="block text-[13px] font-bold text-gray-800 mb-2">Message :</label>
                <textarea id="reminderMessage" rows="3" placeholder="Type your reminder message here..." class="w-full text-[13px] border border-gray-300 rounded bg-transparent p-2.5 outline-none focus:border-teal-600 transition text-gray-800 resize-none shadow-sm"></textarea>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="bg-gray-50 px-2 py-2 border-t border-gray-200 flex justify-end gap-2">
            <button type="button" onclick="closeReminderModal()" class="text-xs px-5 py-2 font-bold bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition cursor-pointer shadow-sm">Cancel</button>
            <button type="button" onclick="processReminder('CAR', '@ViewBag.CARID')" class="text-xs px-5 py-2 font-bold bg-teal-700 text-white rounded-lg hover:bg-teal-800 transition shadow-md flex items-center gap-1.5 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                Send Reminder
            </button>
        </div>
    </div>
</div>

<script>
    // =============================================================
    // 1. VARIABEL GLOBAL & FUNGSI UTILITY
    // =============================================================
    let currentTtdId = '';
    let signaturePadInstance;
    const currentUserName = '@ViewBag.Name';

    const isAuditor = @((ViewBag.isAuditor != null && (bool)ViewBag.isAuditor) ? "true" : "false");
    const isAuditee = @((ViewBag.isAuditee != null && (bool)ViewBag.isAuditee) ? "true" : "false");

    function parseDotNetDate(jsonDate) {
        if (!jsonDate) return null;
        if (typeof jsonDate === 'string' && jsonDate.indexOf('/Date(') !== -1) {
            return new Date(parseInt(jsonDate.replace(/\/Date\((-?\d+)\)\//, '$1')));
        }
        return new Date(jsonDate);
    }

    function formatDateToInput(jsonDate) {
        let d = parseDotNetDate(jsonDate);
        if (!d || isNaN(d)) return "";
        let month = '' + (d.getMonth() + 1), day = '' + d.getDate(), year = d.getFullYear();
        if (month.length < 2) month = '0' + month;
        if (day.length < 2) day = '0' + day;
        return [year, month, day].join('-');
    }

    function generateGUID() {
        return 'PRB-' + 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            var r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }

    function debounce(func, delay) {
        let timer;
        return function (...args) {
            clearTimeout(timer);
            timer = setTimeout(() => func.apply(this, args), delay);
        };
    }

    function lockSection(selector) {
        $(selector).find('input[type="text"], input[type="number"], textarea').prop('readOnly', true).addClass('bg-gray-50 text-gray-500');
        $(selector).find('input[type="radio"], input[type="checkbox"], input[type="date"], input[type="file"]').prop('disabled', true);
        $(selector).find('[onclick^="set"], [onclick^="reset"], [onclick^="openSignature"], [onclick^="deleteEvidence"]').removeAttr('onclick').removeClass('cursor-pointer').addClass('opacity-60 cursor-not-allowed');
        $(selector).find('label').css('pointer-events', 'none');
    }

    function applyRoleAccess() {
        $('#btn-tab-1, #btn-tab-2, #btn-tab-3').prop('disabled', false).css('pointer-events', 'auto').removeClass('opacity-50 opacity-60 cursor-not-allowed').addClass('cursor-pointer');

        if (!isAuditor) {
            lockSection('#tab-1');
            lockSection('#verification-section');
            $('#btn-next-1').prop('disabled', false).css('pointer-events', 'auto').removeClass('opacity-60 cursor-not-allowed');
        }

        if (!isAuditee) {
            lockSection('#auditee-section');
            lockSection('#tab-3');
            $('#btn-next-2').prop('disabled', false).css('pointer-events', 'auto').removeClass('opacity-60 cursor-not-allowed');
        }

        if (!isAuditor && !isAuditee) {
            $('#btn-submit').prop('disabled', true).addClass('opacity-50 cursor-not-allowed');
        }
    }

    // =============================================================
    // 2. INISIALISASI & LOAD DATA
    // =============================================================
    $(document).ready(function () {
        applyRoleAccess();
        checkTab1Lock();
        checkTab2Lock();
        checkVerification();

        function validateDeviceAccess() {
            if (window.innerWidth < 1024) {
                $('#elegant-section').addClass('hidden');
                Swal.fire({
                    title: 'Layar Terlalu Kecil!',
                    html: 'Halaman ini dioptimalkan untuk perangkat Laptop atau Desktop.',
                    icon: 'warning', allowOutsideClick: false, showConfirmButton: false, background: '#fef2f2'
                });
            } else {
                $('#elegant-section').removeClass('hidden');
                if (Swal.isVisible()) Swal.close();
            }
        }
        validateDeviceAccess();
        $(window).resize(validateDeviceAccess);

        const reportId = '@Html.Raw(ViewBag.CARID)';
        console.log(reportId);
        if(reportId) {
            loadDataCAR(reportId);
        }

        function loadDataCAR(id) {
            $.ajax({
                url: '@Url.Action("GetDetailCAR", "EAudit")',
                type: 'GET',
                data: { id: id },
                success: function(res) {
                    if(res.success && res.data) {
                        populateForm(res.data);
                    } else {
                        Swal.fire('Error', res.message || 'Gagal memuat data CAR', 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error', 'Terjadi kesalahan koneksi server saat menarik data.', 'error');
                }
            });
        }

        function populateForm(data) {
            $('#no_report').val(data.no_report);
            if(data.date) $('#date').val(formatDateToInput(data.date));
            $('#to_Dept').val(data.to_Dept);
            $('#attention').val(data.attention);
            $('#from_auditor').val(data.from_auditor);
            $('#qty_check').val(data.qty_check);
            $('#ng_rasio').val(data.ng_rasio);
            if(data.reply_deadline) $('#reply_deadline').val(formatDateToInput(data.reply_deadline));

            if(data.incident_status) {
                $(`input[name="incident_status"][value="${data.incident_status}"]`).prop('checked', true);
            }

            if(data.Problem) {
                let p = data.Problem;
                $('#problem_id').val(p.problem_id);
                $('#problem_name').val(p.problem_name);
                $('#problem_location').val(p.problem_location);
                $('#problem_part_name').val(p.problem_part_name);
                $('#problem_lot_number').val(p.problem_lot_number);
                $('#problem_qty').val(p.problem_qty);
                $('#problem_detail').val(p.problem_detail).trigger('input');

                if(p.problem_category) {
                    let matched = false;
                    $(`input[name="problem_category"]`).each(function() {
                        let val = $(this).val();
                        if(val.toLowerCase() === p.problem_category.toLowerCase() || (val === "Audit" && p.problem_category === "Internal Audit")) {
                            $(this).prop('checked', true);
                            matched = true;
                        }
                    });
                    if(!matched && p.problem_category) {
                        $('#problem_category_lain_radio').prop('checked', true);
                        $('#problem_category_lain').val(p.problem_category);
                    }
                }

                if(p.problem_status) {
                    $(`input[name="problem_status"]`).each(function() {
                        if($(this).val().toUpperCase() === p.problem_status.toUpperCase()) $(this).prop('checked', true);
                    });
                }
            }

            if(data.Action) {
                let a = data.Action;
                $('#PIC_dept').val(a.PIC_dept);
                $('#action_id').val(a.action_id);
                $('#review_PFMEA').val(a.review_PFMEA).trigger('input');
                $('#containment_action').val(a.containment_action).trigger('input');
                $('#PIC_containment').val(a.PIC_containment_action);
                if(a.date_containment_action) $('#date_containment').val(formatDateToInput(a.date_containment_action));

                $('#detail_correction').val(a.detail_correction).trigger('input');
                $('#PIC_detail_correction').val(a.PIC_detail_correction);
                if(a.date_detail_correction) $('#date_detail_correction').val(formatDateToInput(a.date_detail_correction));

                $('#detail_corrective_action').val(a.detail_corrective_action).trigger('input');
                $('#PIC_detail_corrective_action').val(a.PIC_detail_corrective_action);
                if(a.date_detail_corrective_action) $('#date_detail_corrective_action').val(formatDateToInput(a.date_detail_corrective_action));

                $('#yokotenkai').val(a.yokotenkai);
                $('#initial_lot_after_repair').val(a.initial_lot_after_repair);
                $('#PIC_yokotenkai').val(a.PIC_yokotenkai);
                if(a.date_yokotenkai) $('#date_yokotenkai').val(formatDateToInput(a.date_yokotenkai));

                if(a.is_document_updated) {
                    $(`input[name="is_document_updated"][value="${a.is_document_updated}"]`).prop('checked', true);
                }

                if(a.document_type_updated) {
                    let docs = a.document_type_updated.split(',').map(item => item.trim());
                    $(`input[name="document_type_updated"]`).each(function() {
                        if(docs.includes($(this).val())) $(this).prop('checked', true);
                    });
                }
                $('#document_number').val(a.document_number);

                if(a.action_date) {
                    let d = parseDotNetDate(a.action_date);
                    if(!isNaN(d)) {
                        $('#action_date_d').val(String(d.getDate()).padStart(2, '0'));
                        $('#action_date_m').val(String(d.getMonth() + 1).padStart(2, '0'));
                        $('#action_date_y').val(d.getFullYear());
                    }
                }
            }

            if (data.FiveWhy && data.FiveWhy.length > 0) {
                data.FiveWhy.forEach(fw => {
                    if (fw.why_number >= 1 && fw.why_number <= 5) {
                        $(`#why_id_${fw.why_number}`).val(fw.why_id);
                        $(`#why_${fw.why_number}`).val(fw.why_problem);
                    }
                });
            }

            if (data.Verification && data.Verification.length > 0) {
                let v1List = data.Verification.filter(v => v.verification_name === 'Verifikasi 1');
                let v2List = data.Verification.filter(v => v.verification_name === 'Verifikasi 2');

                let v1 = v1List.length > 0 ? v1List[v1List.length - 1] : null;
                let v2 = v2List.length > 0 ? v2List[v2List.length - 1] : null;

                if (v1) {
                    $('#verification_id_v1').val(v1.verification_id);
                    if (v1.verification_status) $(`input[name="v1_status"][value="${v1.verification_status}"]`).prop('checked', true);
                    $('#v1_comment').val(v1.verification_comment).trigger('input');
                    $('#sign_name_v1_auditor').val(v1.verification_auditor_sign_by);
                    renderExistingVerificationStamp('v1_auditor', v1.verification_auditor_status, v1.verification_auditor_date);
                    $('#sign_name_v1_mr').val(v1.verification_mr_sign_by);
                    renderExistingVerificationStamp('v1_mr', v1.verification_mr_status, v1.verification_mr_date);
                }

                if (v2) {
                    $('#verification_id_v2').val(v2.verification_id);
                    if (v2.verification_status) $(`input[name="v2_status"][value="${v2.verification_status}"]`).prop('checked', true);
                    $('#v2_comment').val(v2.verification_comment).trigger('input');
                    if (v2.verification_mr_date) $('#v2_date').val(formatDateToInput(v2.verification_mr_date));
                    $('#sign_name_v2_auditor').val(v2.verification_auditor_sign_by);
                    renderExistingVerificationStamp('v2_auditor', v2.verification_auditor_status, v2.verification_auditor_date);
                    $('#sign_name_v2_mr').val(v2.verification_mr_sign_by);
                    renderExistingVerificationStamp('v2_mr', v2.verification_mr_status, v2.verification_mr_date);
                }
            }

            if(data.Approval && data.Approval.length > 0) {
                data.Approval.forEach(ap => {
                    let targetId = null;
                    let group = ap.group_type || "";
                    let role = (ap.role_type || "").toLowerCase();

                    if(group === "Auditor Approval") {
                        if(role === "disetujui") targetId = "disetujui_1";
                        else if(role === "diperiksa") targetId = "diperiksa_1";
                        else if(role === "dibuat") targetId = "dibuat_1";
                    } else if(group === "Auditee Approval") {
                        if(role === "disetujui") targetId = "dept_disetujui";
                        else if(role === "diperiksa") targetId = "dept_diperiksa";
                        else if(role === "dibuat") targetId = "dept_dibuat";
                    }
                    if (targetId) {
                        $('#approval_id_' + targetId).val(ap.approval_id);
                        $('#sign_name_' + targetId).val(ap.sign_by);
                        if(ap.status) renderExistingStamp(targetId, ap.status, ap.sign_date);
                    }
                });
            }

            if (data.Ilustration && data.Ilustration.length > 0) {
                let img = data.Ilustration[0];
                $('#ilustration_id').val(img.ilustration_id);
                if (img.file_url) {
                    $('#ilustration_preview').attr('src', img.file_url).removeClass('hidden');
                    $('#upload-placeholder').addClass('hidden');
                    $('#btn_remove_ilustration').removeClass('hidden');
                }
            }

            if (data.Evidence && data.Evidence.length > 0) {
                data.Evidence.forEach(ev => {
                    renderEvidenceItem(ev.evidence_id, ev.evidence_name, ev.evidence_url);
                });
            }
            checkTab1Lock();
            checkTab2Lock();
            checkVerification();
        }

        // ==============================================================
        // AUTO-SAVE HANDLERS
        // ==============================================================
        const autoSaveHeader = debounce(function () {
            if (!isAuditor) return;
            const noReport = $('#no_report').val();
            if (!noReport) return;

            const payload = {
                no_report: noReport,
                to_Dept: $('#to_Dept').val(),
                attention: $('#attention').val(),
                date: $('#date').val() ? $('#date').val() : null,
                from_auditor: $('#from_auditor').val(),
                qty_check: $('#qty_check').val() ? parseInt($('#qty_check').val()) : null,
                ng_rasio: $('#ng_rasio').val(),
                incident_status: $('input[name="incident_status"]:checked').val(),
                reply_deadline: $('#reply_deadline').val() ? $('#reply_deadline').val() : null
            };

            $.ajax({
                url: '@Url.Action("UpdateHeader", "EAudit")',
                type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                success: function (response) {
                    if (response.status === "success") Swal.mixin({ toast: true, position: 'bottom-end', showConfirmButton: false, timer: 1500 }).fire({ icon: 'success', title: 'Header auto-saved' });
                }
            });
        }, 1000);

        $('#to_Dept, #attention, #date, #from_auditor, #qty_check, #ng_rasio, #reply_deadline').on('input change', autoSaveHeader);
        $('input[name="incident_status"]').on('change', autoSaveHeader);

        const autoSaveProblem = debounce(function () {
            if (!isAuditor) return;
            const noReport = $('#no_report').val();
            if (!noReport) return;

            let probId = $('#problem_id').val();
            if (!probId) { probId = generateGUID(); $('#problem_id').val(probId); }

            let category = $('input[name="problem_category"]:checked').val();
            if (category === "Lain") category = $('#problem_category_lain').val();

            const payload = {
                problem_id: probId, no_report: noReport, problem_name: $('#problem_name').val(), problem_location: $('#problem_location').val(),
                problem_part_name: $('#problem_part_name').val(), problem_lot_number: $('#problem_lot_number').val(),
                problem_qty: $('#problem_qty').val() ? parseInt($('#problem_qty').val()) : null, problem_detail: $('#problem_detail').val(),
                problem_category: category, problem_status: $('input[name="problem_status"]:checked').val()
            };

            $.ajax({
                url: '@Url.Action("UpsertProblem", "EAudit")',
                type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                success: function (response) {
                    if (response.status === "success") Swal.mixin({ toast: true, position: 'bottom-end', showConfirmButton: false, timer: 1500 }).fire({ icon: 'success', title: 'Problem auto-saved' });
                }
            });
        }, 1000);

        $('#problem_name, #problem_location, #problem_part_name, #problem_lot_number, #problem_qty, #problem_detail, #problem_category_lain').on('input change', autoSaveProblem);
        $('input[name="problem_category"], input[name="problem_status"]').on('change', autoSaveProblem);

        const autoSaveAction = debounce(function () {
            if (!isAuditee) return;
            const noReport = $('#no_report').val();
            if (!noReport) return;

            let actId = $('#action_id').val();
            if (!actId) { actId = generateGUID().replace('PRB-', 'ACT-'); $('#action_id').val(actId); }

            let aDateD = $('#action_date_d').val(); let aDateM = $('#action_date_m').val(); let aDateY = $('#action_date_y').val();
            let actionDateFull = null;
            if (aDateD && aDateM && aDateY) actionDateFull = `${aDateY}-${aDateM.padStart(2, '0')}-${aDateD.padStart(2, '0')}`;

            let docTypes = [];
            $('input[name="document_type_updated"]:checked').each(function() { docTypes.push($(this).val()); });
            let docTypeStr = docTypes.length > 0 ? docTypes.join(', ') : null;

            const payload = {
                action_id: actId, no_report: noReport, PIC_dept: $('#PIC_dept').val(), action_date: actionDateFull, review_PFMEA: $('#review_PFMEA').val(),
                containment_action: $('#containment_action').val(), PIC_containment_action: $('#PIC_containment').val(), date_containment_action: $('#date_containment').val() ? $('#date_containment').val() : null,
                detail_correction: $('#detail_correction').val(), PIC_detail_correction: $('#PIC_detail_correction').val(), date_detail_correction: $('#date_detail_correction').val() ? $('#date_detail_correction').val() : null,
                detail_corrective_action: $('#detail_corrective_action').val(), PIC_detail_corrective_action: $('#PIC_detail_corrective_action').val(), date_detail_corrective_action: $('#date_detail_corrective_action').val() ? $('#date_detail_corrective_action').val() : null,
                yokotenkai: $('#yokotenkai').val(), initial_lot_after_repair: $('#initial_lot_after_repair').val(), PIC_yokotenkai: $('#PIC_yokotenkai').val(), date_yokotenkai: $('#date_yokotenkai').val() ? $('#date_yokotenkai').val() : null,
                is_document_updated: $('input[name="is_document_updated"]:checked').val(), document_type_updated: docTypeStr, document_number: $('#document_number').val()
            };

            $.ajax({
                url: '@Url.Action("UpsertAction", "EAudit")',
                type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                success: function (response) {
                    if (response.status === "success") Swal.mixin({ toast: true, position: 'bottom-end', showConfirmButton: false, timer: 1500 }).fire({ icon: 'success', title: 'Action auto-saved' });
                }
            });
        }, 1000);

        $('#PIC_dept, #action_date_d, #action_date_m, #action_date_y, #review_PFMEA, #containment_action, #PIC_containment, #date_containment, #detail_correction, #PIC_detail_correction, #date_detail_correction, #detail_corrective_action, #PIC_detail_corrective_action, #date_detail_corrective_action, #yokotenkai, #initial_lot_after_repair, #PIC_yokotenkai, #date_yokotenkai, #document_number').on('input change', autoSaveAction);
        $('input[name="is_document_updated"], input[name="document_type_updated"]').on('change', autoSaveAction);

        const autoSaveFiveWhy = debounce(function () {
            if (!isAuditee) return;
            const noReport = $('#no_report').val();
            if (!noReport) return;

            let payload = [];
            for (let i = 1; i <= 5; i++) {
                let whyText = $(`#why_${i}`).val() || ""; let whyId = $(`#why_id_${i}`).val();
                if (whyText.trim() !== "" || whyId !== "") {
                    if (!whyId) { whyId = generateGUID().replace('PRB-', 'WHY-'); $(`#why_id_${i}`).val(whyId); }
                    payload.push({ why_id: whyId, no_report: noReport, why_number: i, why_problem: whyText });
                }
            }

            if (payload.length === 0) return;

            $.ajax({
                url: '@Url.Action("UpsertFiveWhy", "EAudit")',
                type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                success: function (response) {
                    if (response.status === "success") Swal.mixin({ toast: true, position: 'bottom-end', showConfirmButton: false, timer: 1500 }).fire({ icon: 'success', title: '5 Why auto-saved' });
                }
            });
        }, 1000);

        $('#why_1, #why_2, #why_3, #why_4, #why_5').on('input change', autoSaveFiveWhy);

        const autoSaveVerificationV1 = debounce(function () {
            if (!isAuditor) return;
            const noReport = $('#no_report').val();
            if (!noReport) return;

            let radioStatus = $('input[name="v1_status"]:checked').val() || null; let commentText = $('#v1_comment').val() || null;
            let auditorSign = $('#sign_name_v1_auditor').val() || null; let auditorStamp = $('#status_v1_auditor').val() || null;
            let mrSign = $('#sign_name_v1_mr').val() || null; let mrStamp = $('#status_v1_mr').val() || null;

            let verifId = $('#verification_id_v1').val();
            if (!verifId && !radioStatus && !commentText && !auditorSign && !auditorStamp && !mrSign && !mrStamp) return;
            if (!verifId) { verifId = generateGUID().replace('PRB-', 'VRF1-'); $('#verification_id_v1').val(verifId); }

            const payload = {
                verification_id: verifId, no_report: noReport, verification_name: "Verifikasi 1", verification_status: radioStatus, verification_comment: commentText,
                verification_auditor_sign_by: auditorSign, verification_auditor_status: auditorStamp, verification_auditor_date: auditorStamp ? new Date().toISOString() : null,
                verification_mr_sign_by: mrSign, verification_mr_status: mrStamp, verification_mr_date: mrStamp ? new Date().toISOString() : null
            };

            $.ajax({
                url: '@Url.Action("UpsertVerification", "EAudit")',
                type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                success: function (response) {
                    if (response.status === "success") Swal.mixin({ toast: true, position: 'bottom-end', showConfirmButton: false, timer: 1500 }).fire({ icon: 'success', title: 'Verifikasi 1 auto-saved' });
                }
            });
        }, 1000);

        $('#v1_comment, #sign_name_v1_auditor, #sign_name_v1_mr').on('input change', autoSaveVerificationV1);
        $('input[name="v1_status"], #status_v1_auditor, #status_v1_mr').on('change', autoSaveVerificationV1);

        const autoSaveVerificationV2 = debounce(function () {
            if (!isAuditor) return;
            const noReport = $('#no_report').val();
            if (!noReport) return;

            let radioStatus = $('input[name="v2_status"]:checked').val() || null; let commentText = $('#v2_comment').val() || null;
            let mrDate = $('#v2_date').val() ? $('#v2_date').val() : null; let auditorSign = $('#sign_name_v2_auditor').val() || null;
            let auditorStamp = $('#status_v2_auditor').val() || null; let mrSign = $('#sign_name_v2_mr').val() || null; let mrStamp = $('#status_v2_mr').val() || null;

            let verifId = $('#verification_id_v2').val();
            if (!verifId && !radioStatus && !commentText && !mrDate && !auditorSign && !auditorStamp && !mrSign && !mrStamp) return;
            if (!verifId) { verifId = generateGUID().replace('PRB-', 'VRF2-'); $('#verification_id_v2').val(verifId); }

            const payload = {
                verification_id: verifId, no_report: noReport, verification_name: "Verifikasi 2", verification_status: radioStatus, verification_comment: commentText,
                verification_mr_date: mrDate, verification_auditor_sign_by: auditorSign, verification_auditor_status: auditorStamp, verification_auditor_date: auditorStamp ? new Date().toISOString() : null,
                verification_mr_sign_by: mrSign, verification_mr_status: mrStamp
            };

            $.ajax({
                url: '@Url.Action("UpsertVerification", "EAudit")',
                type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
                success: function (response) {
                    if (response.status === "success") Swal.mixin({ toast: true, position: 'bottom-end', showConfirmButton: false, timer: 1500 }).fire({ icon: 'success', title: 'Verifikasi 2 auto-saved' });
                }
            });
        }, 1000);

