    function renderEvidenceItem(id, name, url) {
        if (!url) return;

        let rootPath = '@Url.Content("~/")';
        let finalUrl = url;

        if (url.startsWith('/')) {
            if (rootPath.endsWith('/')) {
                finalUrl = rootPath + url.substring(1);
            } else {
                finalUrl = rootPath + url;
            }
        }

        let isImage = finalUrl.startsWith('data:image') || /\.(jpeg|jpg|gif|png|webp|bmp)(\?.*)?$/i.test(finalUrl);

        let previewHtml = isImage
            ? `<img src="${finalUrl}" class="w-full h-32 object-cover rounded-md mb-2 border">`
            : `<div class="w-full h-32 flex items-center justify-center bg-gray-100 rounded-md mb-2 border"><span class="text-4xl text-gray-400">📄</span></div>`;

        let deleteBtn = isAuditee
            ? `<button type="button" onclick="window.deleteEvidence('${id}')" class="absolute top-2 right-2 bg-red-500 text-white rounded-full p-1.5 opacity-0 group-hover:opacity-100 transition shadow hover:bg-red-600 cursor-pointer z-10" title="Hapus Evidence">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
           </button>` : '';

        let html = `
        <div id="evd_${id}" class="border border-gray-200 shadow-sm rounded-lg p-3 relative group flex flex-col bg-white hover:bg-teal-50 transition">
            <div class="cursor-pointer evd-clickable flex-1 flex flex-col" data-url="${finalUrl}" data-name="${name}" title="Klik untuk lihat/download">
                ${previewHtml}
                <span class="text-xs text-center truncate w-full font-semibold text-gray-700 mt-auto pt-1 block" title="${name}">${name}</span>
            </div>
            ${deleteBtn}
        </div>
        `;

        $('#evidence_gallery').append(html);
    }

