    async function forceDownloadFile(url, name) {
        if (!url) return;
        console.log('[forceDownloadFile] url:', url, 'name:', name);

        // Handle inline data URIs quickly
        if (url.startsWith('data:')) {
            const a = document.createElement('a');
            a.href = url;
            let ext = ".bin";
            if (url.includes('image/jpeg')) ext = ".jpg";
            else if (url.includes('image/png')) ext = ".png";
            else if (url.includes('application/pdf')) ext = ".pdf";
            const filename = (name || 'file') + ext;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            return;
        }

        // Resolve relative URL against application root
        let rootPath = '@Url.Content("~/")';
        let finalUrl = url;
        /*try {
            if (url.startsWith('/')) {
                // Ensure single slash between rootPath and url
                finalUrl = (rootPath.endsWith('/') ? rootPath.replace(/\/$/, '') : rootPath) + url;
            } else if (!/^https?:\/\//i.test(url) && !url.startsWith('//')) {
                // relative path (not starting with /) -> assume app-root relative
                finalUrl = (rootPath.endsWith('/') ? rootPath : rootPath + '/') + url;
            }
        } catch (e) {
            console.warn('[forceDownloadFile] Url resolution failed, fallback to original url', e);
            finalUrl = url;
        }*/

        console.log('[forceDownloadFile] finalUrl:', finalUrl);

        // Try HEAD first to check availability (best-effort - may fail on some servers)
        let ok = false;
        try {
            const headResp = await fetch(finalUrl, { method: 'HEAD', credentials: 'same-origin' });
            ok = headResp && headResp.ok;
            console.log('[forceDownloadFile] HEAD status:', headResp.status);
        } catch (headErr) {
            console.warn('[forceDownloadFile] HEAD request failed (server may not allow). Will try GET. Error:', headErr);
        }

        try {
            // Fetch the file as blob (will include cookies for same-origin)
            const resp = await fetch(finalUrl, { method: 'GET', credentials: 'same-origin' });
            if (!resp.ok) throw new Error('HTTP ' + resp.status + ' - ' + resp.statusText);

            const blob = await resp.blob();

            // Try to get filename from Content-Disposition or fallback to provided name or URL segment
            const cd = resp.headers.get('content-disposition') || '';
            let filename = name || null;
            if (!filename) {
                const match = /filename\*?=(?:UTF-8'')?\"?([^\";]+)/i.exec(cd);
                if (match && match[1]) filename = decodeURIComponent(match[1]);
            }
            if (!filename) {
                filename = finalUrl.substring(finalUrl.lastIndexOf('/') + 1) || 'download';
            }

            const blobUrl = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = blobUrl;
            a.download = filename;
            // For some browsers/hosts, opening in new tab helps for cross-origin PDFs:
            a.target = '_blank';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            // release memory later
            setTimeout(() => URL.revokeObjectURL(blobUrl), 10000);

            console.log('[forceDownloadFile] downloaded as:', filename);
        } catch (err) {
            console.error('[forceDownloadFile] download failed', err);
            Swal.fire('Error', 'File wasn\'t available on site. See console / Network tab for details: ' + (err && err.message ? err.message : ''), 'error');
        }
    }

