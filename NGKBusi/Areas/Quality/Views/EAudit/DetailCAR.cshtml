    function setStamp(id, status) {
        const noReport = document.getElementById('no_report').value;
        if (!noReport) {
            Swal.fire({ icon: 'warning', title: 'Oops...', text: 'Silakan isi No. Laporan terlebih dahulu!' });
            return;
        }

        // 1. Validasi hanya dijalankan saat Approve/Reject (bukan saat Reset/"")
        if (status !== "") {
            if (id === 'disetujui_1' || id === 'diperiksa_1' || id === 'dibuat_1') {
                let missingFields = [];
                if (!$('#to_Dept').val()) missingFields.push("Kepada Dept.");
                if (!$('#attention').val()) missingFields.push("Attention");
                if (!$('#date').val()) missingFields.push("Tanggal Laporan");
                if (!$('#from_auditor').val()) missingFields.push("Dept. Pembuat/Auditor");
                if (!$('#problem_name').val()) missingFields.push("Nama Masalah");
                if (!$('#problem_location').val()) missingFields.push("Lokasi Ditemukan");
                if (!$('input[name="incident_status"]:checked').val()) missingFields.push("Status Kejadian (Pertama/Pernah)");
                if (!$('#problem_detail').val()) missingFields.push("Detail Masalah");

                let category = $('input[name="problem_category"]:checked').val();
                if (!category) {
                    missingFields.push("Kategori Asal Masalah");
                } else if (category === "Lain" && !$('#problem_category_lain').val()) {
                    missingFields.push("Penjelasan Kategori Lain-lain");
                }

                if (!$('input[name="problem_status"]:checked').val()) missingFields.push("Status Problem");
                if (!$('#reply_deadline').val()) missingFields.push("Batas Tanggal Jawab");

                if (missingFields.length > 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Data Tab 1 Belum Lengkap!',
                        html: '<div class="text-sm text-left mb-2">Mohon lengkapi data Tab 1 berikut sebelum Approval:</div>' +
                              '<ul class="text-left text-sm text-red-600 bg-red-50 p-3 rounded list-disc list-inside">' +
                              missingFields.map(f => `<li>${f}</li>`).join('') +
                              '</ul>',
                        confirmButtonColor: '#0f766e'
                    });
                    return;
                }
            }
            else if (id === 'dept_disetujui' || id === 'dept_diperiksa' || id === 'dept_dibuat') {
                let missingFieldsTab2 = [];
                if (!$('#PIC_dept').val().trim()) missingFieldsTab2.push("Departemen Penanggung Jawab");
                if (!$('#action_date_d').val().trim() || !$('#action_date_m').val().trim() || !$('#action_date_y').val().trim()) {
                    missingFieldsTab2.push("Tanggal Action (Hari, Bulan, & Tahun wajib diisi)");
                }
                if (!$('#why_1').val().trim()) missingFieldsTab2.push("Analisa Why 1");
                if (!$('#why_2').val().trim()) missingFieldsTab2.push("Analisa Why 2");
                if (!$('#why_3').val().trim()) missingFieldsTab2.push("Analisa Why 3");
                if (!$('#why_4').val().trim()) missingFieldsTab2.push("Analisa Why 4");
                if (!$('#why_5').val().trim()) missingFieldsTab2.push("Analisa Why 5");
                if (!$('#review_PFMEA').val().trim()) missingFieldsTab2.push("Review PFMEA");

                if (!$('#containment_action').val().trim()) missingFieldsTab2.push("Tindakan Penahanan (Containment Action)");
                if (!$('#PIC_containment').val().trim()) missingFieldsTab2.push("PIC Containment");
                if (!$('#date_containment').val()) missingFieldsTab2.push("Tanggal Tindakan Penahanan");

                if (!$('#detail_correction').val().trim()) missingFieldsTab2.push("Details of Correction");
                if (!$('#PIC_detail_correction').val().trim()) missingFieldsTab2.push("PIC Correction");
                if (!$('#date_detail_correction').val()) missingFieldsTab2.push("Tanggal Correction");

                if (!$('#detail_corrective_action').val().trim()) missingFieldsTab2.push("Details of Corrective Action");
                if (!$('#PIC_detail_corrective_action').val().trim()) missingFieldsTab2.push("PIC Corrective Action");
                if (!$('#date_detail_corrective_action').val()) missingFieldsTab2.push("Tanggal Corrective Action");

                if (!$('#yokotenkai').val().trim()) missingFieldsTab2.push("Yokotenkai (Perbaikan Horizontal)");
                if (!$('#initial_lot_after_repair').val().trim()) missingFieldsTab2.push("Lot Awal Setelah Perbaikan");
                if (!$('#PIC_yokotenkai').val().trim()) missingFieldsTab2.push("PIC Yokotenkai");
                if (!$('#date_yokotenkai').val()) missingFieldsTab2.push("Tanggal Yokotenkai");

                let isDocUpdated = $('input[name="is_document_updated"]:checked').val();
                if (!isDocUpdated) {
                    missingFieldsTab2.push("Status Dokumen yang diperbaharui (Ya/Tidak)");
                } else if (isDocUpdated === "Ya") {
                    if ($('input[name="document_type_updated"]:checked').length === 0) {
                        missingFieldsTab2.push("Tipe Dokumen yang diperbaharui (Minimal pilih 1 Checkbox)");
                    }
                    if (!$('#document_number').val().trim()) {
                        missingFieldsTab2.push("Dokumen Number");
                    }
                }

                if (missingFieldsTab2.length > 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Data Jawaban Belum Lengkap!',
                        html: '<div class="text-sm text-left mb-2">Mohon lengkapi data Analisa & Perbaikan berikut sebelum melakukan Approval:</div>' +
                              '<ul class="text-left text-sm text-red-600 bg-red-50 p-3 rounded list-disc list-inside max-h-60 overflow-y-auto leading-relaxed">' +
                              missingFieldsTab2.map(f => `<li>${f}</li>`).join('') +
                              '</ul>',
                        confirmButtonColor: '#0f766e'
                    });
                    return;
                }
            }
        }

        const signInput = document.getElementById('sign_name_' + id);
        if (!signInput.value && currentUserName) signInput.value = currentUserName;
        const signName = signInput.value;

        if (!signName && status !== "") {
            Swal.fire({ icon: 'warning', title: 'Oops...', text: 'Nama Terang tidak ditemukan. Silakan isi manual.' });
            return;
        }

        let roleTypeStr = "";
        if (id.includes("disetujui")) roleTypeStr = "Disetujui";
        else if (id.includes("diperiksa")) roleTypeStr = "Diperiksa";
        else if (id.includes("dibuat")) roleTypeStr = "Dibuat";

        let groupTypeStr = id.includes("dept_") ? "Auditee Approval" : "Auditor Approval";
        let approvalId = $('#approval_id_' + id).val();
        if (!approvalId) {
            const generateUUID = () => {
                return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                    const r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                });
            };
            approvalId = `APV-${generateUUID()}`;
        }

        const payload = { approval_id: approvalId, no_report: noReport, group_type: groupTypeStr, role_type: roleTypeStr, sign_by: signName, sign_date: new Date().toISOString(), status: status };

        $.ajax({
            url: '@Url.Action("UpsertApproval", "EAudit")',
            type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
            success: function (response) {
                if (response.status === "success") {
                    document.getElementById('status_' + id).value = status;
                    const btnGroup = document.getElementById('btn-group-' + id);
                    const stampContainer = document.getElementById('stamp-container-' + id);

                    // 2. Perbaikan pada logic Update DOM berdasarkan value status
                    if (status === "") {
                        // RESET STATE: Hapus cap, kembalikan tombol Approve/Reject
                        btnGroup.classList.remove('hidden');
                        stampContainer.classList.add('hidden');
                        stampContainer.innerHTML = '';

                    } else {
                        // APPROVE / REJECT STATE: Tampilkan cap
                        btnGroup.classList.add('hidden');
                        stampContainer.classList.remove('hidden');

                        const dateObj = new Date();
                        const dateString = `${String(dateObj.getDate()).padStart(2, '0')} ${["JAN", "FEB", "MAR", "APR", "MEI", "JUN", "JUL", "AGU", "SEP", "OKT", "NOV", "DES"][dateObj.getMonth()]} ${dateObj.getFullYear()}`;

                        if (status === 'Approved') {
                            stampContainer.innerHTML = `<div class="stamp-circle stamp-approved-circle group-hover:opacity-30 transition"><span class="stamp-text">APPROVED</span><span class="stamp-date">${dateString}</span></div>`;
                        } else {
                            stampContainer.innerHTML = `<div class="stamp-circle stamp-rejected-circle group-hover:opacity-30 transition"><span class="stamp-text">REJECTED</span><span class="stamp-date">${dateString}</span></div>`;
                        }

                        Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 2500 }).fire({ icon: 'success', title: `${roleTypeStr} berhasil disimpan!` });
                    }

                    checkTab1Lock();
                    checkTab2Lock();
                    checkVerification();

                } else {
                    signInput.value = "";
                    Swal.fire({ icon: 'error', title: 'Gagal Menyimpan', text: response.message });
                }
            },
            error: function () {
                signInput.value = "";
                Swal.fire({ icon: 'error', title: 'Koneksi Gagal', text: 'Tidak dapat terhubung ke server.' });
            }
        });
    }

    function resetStamp(id) {
        setStamp(id, "");
    }

    function setVerificationStamp(id, status) {


        if (id === 'v1_auditor' || id === 'v1_mr') {
            let missingV1 = [];

            if ($('#status_disetujui_1').val() !== 'Approved') {
                missingV1.push("Approval Auditor (Disetujui) di Tab 1 belum di-Approve");
            }
            if ($('#status_dept_disetujui').val() !== 'Approved') {
                missingV1.push("Approval Auditee (Disetujui) di Tab 2 belum di-Approve");
            }
            if (!$('input[name="v1_status"]:checked').val()) {
                missingV1.push("Status Verifikasi-1 (Selesai / Belum Selesai) belum dipilih");
            }
            if (!$('#v1_comment').val() || !$('#v1_comment').val().trim()) {
                missingV1.push("Kolom Comments Verifikasi-1 belum diisi");
            }

            // MR tidak bisa jalan duluan sebelum Auditor approve
            if (id === 'v1_mr' && $('#status_v1_auditor').val() !== 'Approved') {
                missingV1.push("Verifikasi-1 Auditor/Mgr belum di-Approve (MR tidak bisa verifikasi sebelum Auditor)");
            }




            if (missingV1.length > 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Verifikasi-1 Belum Bisa Dilakukan!',
                    html: '<div class="text-sm text-left mb-2">Mohon lengkapi hal berikut terlebih dahulu:</div>' +
                        '<ul class="text-left text-sm text-red-600 bg-red-50 p-3 rounded list-disc list-inside">' +
                        missingV1.map(f => `<li>${f}</li>`).join('') +
                        '</ul>',
                    confirmButtonColor: '#0f766e'
                });
                return;
            }
        }

        // ------------------ VALIDASI VERIFIKASI-2 (Auditor & MR) ------------------
        if (id === 'v2_auditor' || id === 'v2_mr') {
            let missingV2 = [];

            if ($('#status_v1_auditor').val() !== 'Approved') {
                missingV2.push("Verifikasi-1 Auditor/Mgr belum di-Approve");
            }
            if ($('#status_v1_mr').val() !== 'Approved') {
                missingV2.push("Verifikasi-1 MR belum di-Approve");
            }
            if (!$('input[name="v2_status"]:checked').val()) {
                missingV2.push("Status Verifikasi-2 (Effektif / Tidak Effektif) belum dipilih");
            }
            if (!$('#v2_comment').val() || !$('#v2_comment').val().trim()) {
                missingV2.push("Kolom Comments Verifikasi-2 belum diisi");
            }

            if (id === 'v2_mr' && $('#status_v2_auditor').val() !== 'Approved') {
                missingV2.push("Verifikasi-2 Auditor/Mgr belum di-Approve (MR tidak bisa verifikasi sebelum Auditor)");
            }

            if (missingV2.length > 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Verifikasi-2 Belum Bisa Dilakukan!',
                    html: '<div class="text-sm text-left mb-2">Mohon lengkapi hal berikut terlebih dahulu:</div>' +
                        '<ul class="text-left text-sm text-red-600 bg-red-50 p-3 rounded list-disc list-inside">' +
                        missingV2.map(f => `<li>${f}</li>`).join('') +
                        '</ul>',
                    confirmButtonColor: '#0f766e'
                });
                return;
            }
        }

        const signInput = document.getElementById('sign_name_' + id);
        if (!signInput.value && currentUserName) signInput.value = currentUserName;
        if (!signInput.value) { Swal.fire({ icon: 'warning', title: 'Oops...', text: 'Nama Terang tidak ditemukan.' }); return; }

        document.getElementById('status_' + id).value = status;
        document.getElementById('btn-group-' + id).classList.add('hidden');

        const stampContainer = document.getElementById('stamp-container-' + id);
        stampContainer.classList.remove('hidden');

        const dateObj = new Date();
        const dateString = `${String(dateObj.getDate()).padStart(2, '0')} ${["JAN", "FEB", "MAR", "APR", "MEI", "JUN", "JUL", "AGU", "SEP", "OKT", "NOV", "DES"][dateObj.getMonth()]} ${dateObj.getFullYear()}`;

        if (status === 'Approved') stampContainer.innerHTML = `<div class="stamp-circle stamp-approved-circle group-hover:opacity-30 transition" style="transform: rotate(-12deg) scale(0.85);"><span class="stamp-text">APPROVED</span><span class="stamp-date">${dateString}</span></div>`;
        else stampContainer.innerHTML = `<div class="stamp-circle stamp-rejected-circle group-hover:opacity-30 transition" style="transform: rotate(-12deg) scale(0.85);"><span class="stamp-text">REJECTED</span><span class="stamp-date">${dateString}</span></div>`;

        $(signInput).trigger('change');
        $('#status_' + id).trigger('change');

        if (id === 'v1_mr' && $('#status_v1_mr').val() !== 'Approved') {
            resetVerificationStamp('v1_auditor')
            resetStamp('dept_disetujui')
            resetStamp('dept_diperiksa')
            resetStamp('dept_dibuat')
        }else if (id === 'v1_auditor' && $('#status_v1_mr').val() !== 'Approved' && $('#status_v1_auditor').val() == 'Approved') {
            resetVerificationStamp('v1_mr')
        }

        checkTab1Lock();
        checkTab2Lock()
        checkVerification()
    }

    function resetVerificationStamp(id) {
        document.getElementById('status_' + id).value = '';
        document.getElementById('btn-group-' + id).classList.remove('hidden');
        document.getElementById('stamp-container-' + id).classList.add('hidden');
        document.getElementById('stamp-container-' + id).innerHTML = '';
        $('#status_' + id).trigger('change');
        checkTab1Lock();
        checkTab2Lock()
        checkVerification()
    }

    function renderExistingStamp(id, status, dateStr) {
        if (!status) return;
        document.getElementById('status_' + id).value = status;
        let btnGroup = document.getElementById('btn-group-' + id);
        if (btnGroup) btnGroup.classList.add('hidden');

        const stampContainer = document.getElementById('stamp-container-' + id);
        if (!stampContainer) return;
        stampContainer.classList.remove('hidden');

        const dateObj = parseDotNetDate(dateStr) || new Date();
        const dateString = `${String(dateObj.getDate()).padStart(2, '0')} ${["JAN", "FEB", "MAR", "APR", "MEI", "JUN", "JUL", "AGU", "SEP", "OKT", "NOV", "DES"][dateObj.getMonth()]} ${dateObj.getFullYear()}`;

        if (status.toLowerCase() === 'approved') stampContainer.innerHTML = `<div class="stamp-circle stamp-approved-circle group-hover:opacity-30 transition"><span class="stamp-text">APPROVED</span><span class="stamp-date">${dateString}</span></div>`;
        else if (status.toLowerCase() === 'rejected') stampContainer.innerHTML = `<div class="stamp-circle stamp-rejected-circle group-hover:opacity-30 transition"><span class="stamp-text">REJECTED</span><span class="stamp-date">${dateString}</span></div>`;
    }

    function renderExistingVerificationStamp(id, status, dateStr) {
        if (!status) return;
        document.getElementById('status_' + id).value = status;
        let btnGroup = document.getElementById('btn-group-' + id);
        if (btnGroup) btnGroup.classList.add('hidden');

        const stampContainer = document.getElementById('stamp-container-' + id);
        if (!stampContainer) return;
        stampContainer.classList.remove('hidden');

        const dateObj = parseDotNetDate(dateStr) || new Date();
        const dateString = `${String(dateObj.getDate()).padStart(2, '0')} ${["JAN", "FEB", "MAR", "APR", "MEI", "JUN", "JUL", "AGU", "SEP", "OKT", "NOV", "DES"][dateObj.getMonth()]} ${dateObj.getFullYear()}`;

        if (status.toLowerCase() === 'approved') stampContainer.innerHTML = `<div class="stamp-circle stamp-approved-circle group-hover:opacity-30 transition" style="transform: rotate(-12deg) scale(0.85);"><span class="stamp-text">APPROVED</span><span class="stamp-date">${dateString}</span></div>`;
        else if (status.toLowerCase() === 'rejected') stampContainer.innerHTML = `<div class="stamp-circle stamp-rejected-circle group-hover:opacity-30 transition" style="transform: rotate(-12deg) scale(0.85);"><span class="stamp-text">REJECTED</span><span class="stamp-date">${dateString}</span></div>`;
    }

    function checkTab2Lock() {
        const isTab1Approved = $('#status_disetujui_1').val() === 'Approved';
        if (!isTab1Approved) {
            $('#auditee-section').addClass('pointer-events-none opacity-50 grayscale');

            if ($('#tab2-lock-warning').length === 0) {
                $('#tab-2').prepend('<div id="tab2-lock-warning" class="bg-amber-50 border border-amber-300 text-amber-800 p-3 rounded mb-4 font-semibold text-sm text-center shadow-sm flex items-center justify-center gap-2"><svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg> <span><b>Tab 2 Terkunci.</b> Mohon selesaikan dan "Approve" kolom <b>Disetujui</b> (Auditor/Mgr) di Tab 1 terlebih dahulu.</span></div>');
            }
        }
        else {
            $('#auditee-section').removeClass('pointer-events-none opacity-50 grayscale');
            $('#tab2-lock-warning').remove();
        }
    }

    function checkTab1Lock(){
        const isTab2Approved = $('#status_dept_disetujui').val() === 'Approved';
        if (isTab2Approved) {
            $('#auditor-section').addClass('pointer-events-none opacity-50 grayscale');
            if ($('#tab1-lock-warning').length === 0) {
                $('#tab-1').prepend('<div id="tab1-lock-warning" class="bg-amber-50 border border-amber-300 text-amber-800 p-3 rounded mb-4 font-semibold text-sm text-center shadow-sm flex items-center justify-center gap-2"><svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg> <span><b>Tab 1 Terkunci.</b> Tindak perbaikan telah di <b>Approve</b> oleh <b>Auditee</b>.</span></div>');
            }
        }
        else {
            $('#auditor-section').removeClass('pointer-events-none opacity-50 grayscale');
            $('#tab1-lock-warning').remove();
        }

    }

    function checkVerification(){
         const isVerificationApproved = $('#status_v1_auditor').val() === 'Approved';

        const isTab2Approved = $('#status_dept_disetujui').val() === 'Approved';

        const isTab1Approved = $('#status_disetujui_1').val() === 'Approved';

         if(isVerificationApproved){
            $('#auditee-section').addClass('pointer-events-none opacity-50 grayscale');
            if ($('#tab2-lock-warning').length === 0) {
                $('#tab-2').prepend('<div id="tab2-lock-warning" class="bg-amber-50 border border-amber-300 text-amber-800 p-3 rounded mb-4 font-semibold text-sm text-center shadow-sm flex items-center justify-center gap-2"><svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg> <span><b>Tab 2 Terkunci.</b> Verifikasi 1 telah di <b>Approve</b> oleh <b>Auditor</b>.</span></div>');
            }
            $('#auditor-section').addClass('pointer-events-none opacity-50 grayscale');
            if ($('#tab1-lock-warning').length === 0) {
                $('#tab-1').prepend('<div id="tab1-lock-warning" class="bg-amber-50 border border-amber-300 text-amber-800 p-3 rounded mb-4 font-semibold text-sm text-center shadow-sm flex items-center justify-center gap-2"><svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg> <span><b>Tab 1 Terkunci.</b> Tindak perbaikan telah di <b>Approve</b> oleh <b>Auditee</b>.</span></div>');
            }
        }

   if(!isTab1Approved || !isTab2Approved){
        // 1. Tambahkan efek visual redup
        $('#verification-section').addClass('pointer-events-none opacity-50 grayscale');

        $('#verification-section').find('input, textarea, button').prop('disabled', true);

    } else {
        $('#verification-section').removeClass('pointer-events-none opacity-50 grayscale');

        $('#verification-section').find('input, textarea, button').prop('disabled', false);
    }
    }

    function openReminderModal() {
        const modal = document.getElementById('reminderModal');
        modal.classList.remove('hidden');
    }

    function closeReminderModal() {
        const modal = document.getElementById('reminderModal');
        modal.classList.add('hidden');

        // Reset form saat ditutup
        document.getElementById('reminderMessage').value = "";
        const checkboxes = document.querySelectorAll('input[name="reminderUsers"]');
        checkboxes.forEach(cb => cb.checked = false);
    }

    function processReminder(jenisReminder, docId) {
        // 1. Tutup modal terlebih dahulu agar layar fokus ke loading alert


        // 2. Ambil semua checkbox yang dicentang
        const selectedCheckboxes = document.querySelectorAll('input[name="reminderUsers"]:checked');
        const selectedEmails = Array.from(selectedCheckboxes).map(cb => cb.value);
        const message = document.getElementById('reminderMessage').value;

        // 3. Validasi: pastikan user sudah dipilih minimal 1
        if (selectedEmails.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Penerima Kosong',
                text: 'Silakan pilih minimal satu penerima (Auditee atau Auditor).',
                confirmButtonColor: '#0f766e'
            }).then(() => {
                // Buka kembali modal jika validasi gagal
                openReminderModal();
            });
            return;
        }
        closeReminderModal();
        // 4. Tampilkan loading (menunggu respon server)
        Swal.fire({
            title: 'Mengirim Reminder...',
            text: 'Mohon tunggu sebentar, email sedang dikirim.',
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        // 5. Setup data (payload) yang akan dikirim ke Controller
        const payload = {
            emails: selectedEmails,
            message: message,
            id: docId,
            jenisReminder: jenisReminder
        };

        // 6. Eksekusi AJAX ke Backend (Menggunakan Razor Url.Action)
        $.ajax({
            url: '@Url.Action("SendReminderEmail", "EAudit")', // URL Dinamis Razor
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.status === "success") {
                    Swal.fire({
                        icon: 'success',
                        title: 'Berhasil!',
                        text: response.message,
                        confirmButtonColor: '#0f766e'
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Gagal!',
                        text: response.message,
                        confirmButtonColor: '#dc2626'
                    });
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Error Koneksi',
                    text: 'Terjadi kesalahan saat menghubungi server untuk mengirim email.',
                    confirmButtonColor: '#dc2626'
                });
            }
        });
    }
</script>