@{
    ViewBag.Title = "Detail CAR (Corrective Action Request)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/printThis/1.15.0/printThis.min.js"></script>

<style>
    html, body {
        background-image: linear-gradient(135deg, #2563eb 0%, #bae6fd 55%, #f8fafc 100%);
        background-size: cover;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
    }

    .form-input-elegant {
        width: 100%;
        padding: 0.375rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        outline: none;
        transition: border-color 0.15s ease-in-out;
    }

        .form-input-elegant:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 2px rgba(15, 118, 110, 0.2);
        }

    .print-only-layout {
        display: none;
    }

    .excel-input {
        width: 100%;
        height: 100%;
        background-color: transparent;
        outline: none;
        border: none;
        font-family: inherit;
        font-size: inherit;
        padding: 0.25rem;
    }

    textarea.excel-input {
        resize: none;
        padding: 0.5rem;
    }

    .vertical-text {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        text-align: center;
        white-space: nowrap;
        margin: auto;
    }

    /* Efek Cap Bulat (Circular Stamp) UI Modern */
    .stamp-circle {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        border: 2.5px solid;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transform: rotate(-12deg);
        opacity: 0.85;
        user-select: none;
        pointer-events: none;
        position: relative;
    }

        .stamp-circle::before {
            content: '';
            position: absolute;
            top: 2px;
            left: 2px;
            right: 2px;
            bottom: 2px;
            border-radius: 50%;
            border: 1px solid;
        }

        .stamp-circle .stamp-text {
            font-size: 0.6rem;
            font-weight: 900;
            letter-spacing: 0.5px;
            line-height: 1;
            margin-bottom: 2px;
        }

        .stamp-circle .stamp-date {
            font-size: 0.45rem;
            font-weight: 800;
            border-top: 1px solid;
            padding-top: 2px;
            width: 80%;
            text-align: center;
        }

    .stamp-approved-circle {
        color: #059669;
        border-color: #059669;
    }

        .stamp-approved-circle::before, .stamp-approved-circle .stamp-date {
            border-color: #059669;
        }

    .stamp-rejected-circle {
        color: #dc2626;
        border-color: #dc2626;
    }

        .stamp-rejected-circle::before, .stamp-rejected-circle .stamp-date {
            border-color: #dc2626;
        }

    @@media (max-width: 1023px) {
        #desktop-content {
            display: none !important;
        }

        #mobile-blocker {
            display: flex !important;
        }
    }

    /* Tabel Layout Fixed Global (Untuk Print Baru) */
    table.print-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        font-family: Arial, sans-serif;
        color: black;
        font-size: 10px;
        word-wrap: break-word;
    }

        table.print-table th, table.print-table td {
            border: 1px solid black;
            padding: 2px;
            vertical-align: middle;
            text-align: center;
            overflow: hidden;
            line-height: 1.1;
        }

        table.print-table .header-cell {
            font-weight: bold;
        }

    /* KONFIGURASI KETIKA DI-PRINT (CTRL + P) & PRINTTHIS */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 5mm;
        }

        body {
            background: white !important;
            padding: 0 !important;
            -webkit-print-color-adjust: exact;
            color-adjust: exact;
        }

        table.print-table {
            font-size: 9px !important;
        }

            table.print-table th, table.print-table td {
                padding: 2px !important;
            }
        /* Sembunyikan Form Modern & Elemen Lainnya */
        #elegant-section, .mb-4, #desktop-content > .min-h-screen {
            display: none !important;
        }
        /* Tampilkan Layout Print */
        .print-only-layout {
            display: block !important;
            width: 100% !important;
            max-width: none !important;
            background: white !important;
            margin: 0 auto;
            box-shadow: none !important;
        }
        /* Stamp versi Print (Lebih Kecil) */
        .print-stamp {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            border: 2px solid;
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transform: rotate(-15deg);
            opacity: 0.9;
            margin: 1px auto;
        }

            .print-stamp .s-text {
                font-size: 0.45rem;
                font-weight: bold;
            }

            .print-stamp .s-date {
                font-size: 0.4rem;
                border-top: 1px solid;
                width: 80%;
                text-align: center;
                margin-top: 1px;
            }

        .print-approved {
            color: #059669;
            border-color: #059669;
        }

        .print-rejected {
            color: #dc2626;
            border-color: #dc2626;
        }
    }
</style>

<div id="mobile-blocker" class="hidden fixed inset-0 bg-slate-900 z-[9999] flex-col items-center justify-center text-center px-6">
    <svg class="w-20 h-20 text-red-500 mb-6 drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
    </svg>
    <h2 class="text-3xl font-extrabold text-white mb-2 tracking-wide">Access Denied</h2>
    <p class="text-slate-300 text-lg mb-6 max-w-md leading-relaxed">
        This CAR Form page is specifically optimized for large screens. Please open it using your <b>Laptop</b> or <b>Desktop PC</b>.
    </p>
    <a href="javascript:history.back()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-all">
        Go Back
    </a>
</div>

<div id="desktop-content">
    <div class="min-h-screen pt-3 sm:px-4 flex justify-center items-start">
        <div class="w-full max-w-6xl">
            <div class="mb-4">
                <a href="javascript:history.back()" class="inline-flex items-center text-sm font-medium text-white hover:text-blue-400 transition-colors">
                    <svg class="w-4 h-4 mr-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5H1m0 0 4 4M1 5l4-4" />
                    </svg>
                    Back to CAR & OFI Management
                </a>
            </div>

            <div id="elegant-section" class="bg-white rounded shadow-2xl overflow-hidden mb-12 hidden lg:block">
                <div class="px-6 pt-6 pb-0 border-b border-gray-200 bg-gray-50">
                    <div class="flex justify-between items-center mb-6">
                        <div class="w-1/4">
                            @if (ViewBag.IsAdministrator != null && (bool)ViewBag.IsAdministrator)
                            {
                                <button type="button" onclick="openReminderModal()" class="shrink-0 bg-amber-500 text-white px-4 py-2.5 rounded-lg shadow-md font-bold hover:bg-amber-600 transition flex items-center gap-2 text-sm cursor-pointer">
                                    <svg class="w-5 h-5 animate-pulse-hover" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                                    </svg>
                                    Send Reminder
                                </button>
                            }
                        </div>
                        <div class="w-2/4 text-center">
                            <h2 class="text-xl font-bold uppercase underline">Formulir Integrasi</h2>
                            <h3 class="text-lg font-bold uppercase mt-1 text-teal-800">Permintaan Tindakan Perbaikan</h3>
                            <p class="text-sm italic text-gray-600">( Corrective Action Request )</p>
                        </div>
                        <div class="w-1/3 flex justify-end gap-3">
                            <button type="button" onclick="printForm()" class="bg-gray-800 text-white px-4 py-2.5 rounded-lg shadow-md font-bold hover:bg-gray-700 transition flex items-center gap-2 text-sm cursor-pointer">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                Print PDF
                            </button>
                            <button type="button" onclick="exportExcel()" class="bg-green-600 text-white px-4 py-2.5 rounded-lg shadow-md font-bold hover:bg-green-700 transition flex items-center gap-2 text-sm cursor-pointer">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                </svg>
                                Export Excel
                            </button>
                        </div>
                    </div>

                    <div class="flex space-x-2">
                        <button type="button" id="btn-tab-1" onclick="switchTab(1)" class="px-6 py-2.5 bg-teal-700 text-white font-semibold rounded-t-lg focus:outline-none shadow-md cursor-pointer">Problem Identification</button>
                        <button type="button" id="btn-tab-2" onclick="switchTab(2)" class="px-6 py-2.5 bg-gray-200 text-gray-600 hover:bg-gray-300 font-semibold rounded-t-lg focus:outline-none transition-colors shadow-inner cursor-pointer">Analysis & Corrective Actions</button>
                        <button type="button" id="btn-tab-3" onclick="switchTab(3)" class="px-6 py-2.5 bg-gray-200 text-gray-600 hover:bg-gray-300 font-semibold rounded-t-lg focus:outline-none transition-colors shadow-inner cursor-pointer">Evidence</button>
                    </div>
                </div>

                <form action="#" method="POST" id="carFormElegant" class="p-6">

                    <div id="tab-1">
                        <div id="auditor-section">
                            <div class="grid grid-cols-1 md:grid-cols-[35%_30%_35%] border border-gray-200 shadow-sm bg-white overflow-hidden">
                                <div class="md:col-start-1 md:row-start-1 border-b md:border-r border-gray-200 pb-5 pr-4 pt-2 pl-2 md:p-5 flex flex-col justify-center transition hover:bg-gray-50 focus-within:bg-teal-50">
                                    <div class="flex items-end mb-3">
                                        <span class="text-sm font-bold text-gray-800 whitespace-nowrap w-28">Kepada Dept. :</span>
                                        <input type="text" id="to_Dept" name="to_Dept" class="flex-1 bg-transparent border-b border-gray-300 outline-none text-sm text-gray-800 focus:border-teal-600 transition px-1 pb-1 elegant-sync" placeholder="Ketik departemen...">
                                    </div>
                                    <div class="flex items-end">
                                        <span class="text-sm text-gray-800 whitespace-nowrap w-28">Attention :</span>
                                        <input type="text" id="attention" name="attention" class="flex-1 bg-transparent border-b border-gray-300 outline-none text-sm text-gray-800 focus:border-teal-600 transition px-1 pb-1 elegant-sync" placeholder="Ketik attention...">
                                    </div>
                                </div>

                                <div class="md:col-start-2 md:row-start-1 border-b md:border-r border-gray-200 flex flex-col text-sm h-full">
                                    <div class="flex border-b border-gray-200 flex-1 transition hover:bg-gray-50 focus-within:bg-teal-50">
                                        <div class="w-28 px-3 bg-gray-50 text-gray-700 border-r border-gray-200 flex items-center">No. Laporan</div>
                                        <div class="flex-1 px-3 py-1 flex items-center">
                                            <input type="text" id="no_report" name="no_report" class="w-full bg-transparent outline-none text-gray-800 font-medium elegant-sync" placeholder="...">
                                        </div>
                                    </div>
                                    <div class="flex border-b border-gray-200 flex-1 transition hover:bg-gray-50 focus-within:bg-teal-50">
                                        <div class="w-28 px-3 bg-gray-50 text-gray-700 border-r border-gray-200 flex items-center">Tanggal</div>
                                        <div class="flex-1 px-3 py-1 flex items-center">
                                            <input type="date" id="date" name="date" class="w-full bg-transparent outline-none text-gray-800 font-medium elegant-sync cursor-pointer">
                                        </div>
                                    </div>
                                    <div class="flex flex-1 transition hover:bg-gray-50 focus-within:bg-teal-50">
                                        <div class="w-[155px] px-3 bg-gray-50 font-bold text-gray-800 border-r border-gray-200 flex items-center leading-tight">Dept. Pembuat/Auditor</div>
                                        <div class="flex-1 px-3 py-1 flex items-center">
                                            <input type="text" id="from_auditor" name="from_auditor" class="w-full bg-transparent outline-none text-gray-800 font-medium elegant-sync" placeholder="...">
                                        </div>
                                    </div>
                                </div>

                                <div class="md:col-start-1 md:col-span-2 md:row-start-2 bg-teal-50 border-b md:border-b-0 md:border-r border-gray-200 p-2.5 text-center font-bold text-teal-800 text-sm flex items-center justify-center">
                                    Harap melakukan perbaikan terhadap problem di bawah ini
                                </div>

                                <div class="md:col-start-3 md:row-start-1 md:row-span-2 flex bg-white h-full text-center">
                                    <div class="flex-1 border-r border-gray-200 flex flex-col h-full">
                                        <div class="py-1.5 bg-gray-50 font-bold text-gray-700 border-b border-gray-200 text-[13px] h-[33px] flex items-center justify-center">Disetujui</div>
                                        <div class="flex-1 min-h-[75px] bg-white transition hover:bg-gray-50 p-2 flex flex-col items-center justify-center relative overflow-hidden border-b border-gray-200">
                                            <input type="hidden" id="approval_id_disetujui_1" value="">
                                            <input type="hidden" id="status_disetujui_1" name="status_disetujui_1" value="" class="elegant-sync">
                                            <input type="hidden" id="problem_id" name="problem_id" value="">
                                            <div id="btn-group-disetujui_1" class="flex flex-col gap-1.5 w-full px-1 no-print">
                                                <button type="button" onclick="setStamp('disetujui_1', 'Approved')" class="text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-300 py-1 rounded hover:bg-emerald-600 hover:text-white transition uppercase shadow-sm cursor-pointer">Approve</button>
                                                <button type="button" onclick="setStamp('disetujui_1', 'Rejected')" class="text-[10px] font-bold bg-red-50 text-red-700 border border-red-300 py-1 rounded hover:bg-red-600 hover:text-white transition uppercase shadow-sm cursor-pointer">Reject</button>
                                            </div>
                                            <div id="stamp-container-disetujui_1" onclick="resetStamp('disetujui_1')" class="absolute inset-0 flex items-center justify-center hidden cursor-pointer group bg-white hover:bg-gray-50 transition" title="Klik untuk mengubah pilihan"></div>
                                        </div>
                                        <div class="p-1 bg-white h-[40px] flex items-center">
                                            <input type="text" id="sign_name_disetujui_1" name="sign_name_disetujui_1" class="w-full text-center text-xs outline-none bg-transparent font-semibold text-gray-800 focus:bg-teal-50 rounded transition h-full elegant-sync" placeholder="Nama Terang">
                                        </div>
                                    </div>

                                    <div class="flex-1 border-r border-gray-200 flex flex-col h-full">
                                        <div class="py-1.5 bg-gray-50 font-bold text-gray-700 border-b border-gray-200 text-[13px] h-[33px] flex items-center justify-center">Diperiksa</div>
                                        <div class="flex-1 min-h-[75px] bg-white transition hover:bg-gray-50 p-2 flex flex-col items-center justify-center relative overflow-hidden border-b border-gray-200">
                                            <input type="hidden" id="approval_id_diperiksa_1" value="">
                                            <input type="hidden" id="status_diperiksa_1" name="status_diperiksa_1" value="" class="elegant-sync">
                                            <div id="btn-group-diperiksa_1" class="flex flex-col gap-1.5 w-full px-1 no-print">
                                                <button type="button" onclick="setStamp('diperiksa_1', 'Approved')" class="text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-300 py-1 rounded hover:bg-emerald-600 hover:text-white transition uppercase shadow-sm cursor-pointer">Approve</button>
                                                <button type="button" onclick="setStamp('diperiksa_1', 'Rejected')" class="text-[10px] font-bold bg-red-50 text-red-700 border border-red-300 py-1 rounded hover:bg-red-600 hover:text-white transition uppercase shadow-sm cursor-pointer">Reject</button>
                                            </div>
                                            <div id="stamp-container-diperiksa_1" onclick="resetStamp('diperiksa_1')" class="absolute inset-0 flex items-center justify-center hidden cursor-pointer group bg-white hover:bg-gray-50 transition" title="Klik untuk mengubah pilihan"></div>
                                        </div>
                                        <div class="p-1 bg-white h-[40px] flex items-center">
                                            <input type="text" id="sign_name_diperiksa_1" name="sign_name_diperiksa_1" class="w-full text-center text-xs outline-none bg-transparent font-semibold text-gray-800 focus:bg-teal-50 rounded transition h-full elegant-sync" placeholder="Nama Terang">
                                        </div>
                                    </div>

                                    <div class="flex-1 flex flex-col h-full">
                                        <div class="py-1.5 bg-gray-50 font-bold text-gray-700 border-b border-gray-200 text-[13px] h-[33px] flex items-center justify-center">Dibuat</div>
                                        <div class="flex-1 min-h-[75px] bg-white transition hover:bg-gray-50 p-2 flex flex-col items-center justify-center relative overflow-hidden border-b border-gray-200">
                                            <input type="hidden" id="approval_id_dibuat_1" value="">
                                            <input type="hidden" id="status_dibuat_1" name="status_dibuat_1" value="" class="elegant-sync">
                                            <div id="btn-group-dibuat_1" class="flex flex-col gap-1.5 w-full px-1 no-print">
                                                <button type="button" onclick="setStamp('dibuat_1', 'Approved')" class="text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-300 py-1 rounded hover:bg-emerald-600 hover:text-white transition uppercase shadow-sm cursor-pointer">Approve</button>
                                                <button type="button" onclick="setStamp('dibuat_1', 'Rejected')" class="text-[10px] font-bold bg-red-50 text-red-700 border border-red-300 py-1 rounded hover:bg-red-600 hover:text-white transition uppercase shadow-sm cursor-pointer">Reject</button>
                                            </div>
                                            <div id="stamp-container-dibuat_1" onclick="resetStamp('dibuat_1')" class="absolute inset-0 flex items-center justify-center hidden cursor-pointer group bg-white hover:bg-gray-50 transition" title="Klik untuk mengubah pilihan"></div>
                                        </div>
                                        <div class="p-1 bg-white h-[40px] flex items-center">
                                            <input type="text" id="sign_name_dibuat_1" name="sign_name_dibuat_1" class="w-full text-center text-xs outline-none bg-transparent font-semibold text-gray-800 focus:bg-teal-50 rounded transition h-full elegant-sync" placeholder="Nama Terang">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="border border-gray-200 shadow-sm bg-white overflow-hidden mb-6 flex flex-col">
                                <div class="overflow-x-auto border-b border-gray-200">
                                    <table class="w-full text-sm text-center">
                                        <thead class="bg-gray-50 border-b border-gray-200 text-gray-800">
                                            <tr>
                                                <th class="p-3 border-r border-gray-200 font-semibold">Nama masalah</th>
                                                <th class="p-3 border-r border-gray-200 font-semibold">Lokasi ditemukan</th>
                                                <th class="p-3 border-r border-gray-200 font-semibold">Part No./ Part Name</th>
                                                <th class="p-3 border-r border-gray-200 font-semibold">Lot number</th>
                                                <th class="p-3 border-r border-gray-200 font-semibold">Qty Problem</th>
                                                <th class="p-3 border-r border-gray-200 font-semibold">QTY check/lot</th>
                                                <th class="p-3 border-r border-gray-200 font-extrabold text-teal-700">NG Ratio(%)</th>
                                                <th class="p-3 font-semibold min-w-[130px]">Status kejadian</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr class="transition hover:bg-gray-50 focus-within:bg-teal-50 group">
                                                <td class="border-r border-gray-200 p-0"><input type="text" id="problem_name" name="problem_name" class="w-full h-12 bg-transparent outline-none text-center px-2 elegant-sync"></td>
                                                <td class="border-r border-gray-200 p-0"><input type="text" id="problem_location" name="problem_location" class="w-full h-12 bg-transparent outline-none text-center px-2 elegant-sync"></td>
                                                <td class="border-r border-gray-200 p-0"><input type="text" id="problem_part_name" name="problem_part_name" class="w-full h-12 bg-transparent outline-none text-center px-2 elegant-sync"></td>
                                                <td class="border-r border-gray-200 p-0"><input type="text" id="problem_lot_number" name="problem_lot_number" class="w-full h-12 bg-transparent outline-none text-center px-2 elegant-sync"></td>
                                                <td class="border-r border-gray-200 p-0"><input type="number" id="problem_qty" name="problem_qty" class="w-full h-12 bg-transparent outline-none text-center px-2 elegant-sync"></td>
                                                <td class="border-r border-gray-200 p-0"><input type="number" id="qty_check" name="qty_check" class="w-full h-12 bg-transparent outline-none text-center px-2 elegant-sync"></td>
                                                <td class="border-r border-gray-200 p-0"><input type="text" id="ng_rasio" name="ng_rasio" class="w-full h-12 bg-transparent outline-none text-center px-2 font-bold text-teal-700 elegant-sync"></td>
