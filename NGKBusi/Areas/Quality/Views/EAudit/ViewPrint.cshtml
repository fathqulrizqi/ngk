@{
    ViewBag.Title = "Audit Event";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    /* Styling Dasar Layout */
    html, body {
        background-image: linear-gradient(135deg, #2563eb 0%, #bae6fd 55%, #f8fafc 100%);
        background-size: cover;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
        margin: 0;
        font-family: Arial, sans-serif;
    }

    .page-wrapper {
        min-height: 100vh;
        padding: 2rem 1rem;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        overflow-x: auto;
    }

    .a4-landscape-page {
        width: 100%;
        max-width: 792px;
        min-height: 1116px;
        background-color: white;
        padding: 10px;
        color: #333;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        box-sizing: border-box;
    }

    /* KUNCI MENCEGAH DOUBLE BORDER: border-collapse */
    .print-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    /* Terapkan border ke semua cell secara seragam */
    .print-table td, .print-table th {
        border: 1px solid #000;
        padding: 6px 8px;
        vertical-align: middle;
        font-size: 13px;
    }

    /* Class Bantuan (Utility) */
    .text-center { text-align: center; }
    .text-left { text-align: left; }
    .font-semibold { font-weight: bold; }
    .text-medium { font-size: 15px; }
    .text-small { font-size: 11px; }

    /* Class untuk menghilangkan sekat vertikal antara label dan titik dua */
    .no-border-right { border-right: none !important; }
    .no-border-left { border-left: none !important; }
    .no-border-x { border-left: none !important; border-right: none !important; }
    /* Class untuk border putus-putus (atas dan bawah) */
    .td-dashed-y {
        border-top: 1px dashed #000 !important;
        border-bottom: 1px dashed #000 !important;
    }
    /* Styling Print */
    @@media print {
        body {
            background: none;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .page-wrapper {
            padding: 0;
            display: block;
        }

        .no-print {
            display: none;
        }

        .a4-landscape-page {
            width: 297mm;
            height: 210mm;
            margin: 0 auto;
            padding: 15mm;
            box-shadow: none;
            background: white;
            page-break-after: always;
        }

        @@page {
            size: A4 landscape;
            margin: 0;
        }
    }
</style>

