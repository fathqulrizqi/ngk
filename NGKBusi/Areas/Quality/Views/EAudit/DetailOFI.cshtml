@{
    ViewBag.Title = "Opportunities For Improvement";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/printThis/1.15.0/printThis.min.js"></script>

<style>
    html, body {
        background-image: linear-gradient(135deg, #2563eb 0%, #bae6fd 55%, #f8fafc 100%);
        background-size: cover;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .stamp-circle {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        border: 2.5px solid;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transform: rotate(-12deg);
        opacity: 0.85;
        user-select: none;
        pointer-events: none;
        position: relative;
    }

        .stamp-circle::before {
            content: '';
            position: absolute;
            top: 2px;
            left: 2px;
            right: 2px;
            bottom: 2px;
            border-radius: 50%;
            border: 1px solid;
        }

        .stamp-circle .stamp-text {
            font-size: 0.6rem;
            font-weight: 900;
            letter-spacing: 0.5px;
            line-height: 1;
            margin-bottom: 2px;
        }

        .stamp-circle .stamp-date {
            font-size: 0.45rem;
            font-weight: 800;
            border-top: 1px solid;
            padding-top: 2px;
            width: 80%;
            text-align: center;
        }

    .stamp-approved-circle {
        color: #059669;
        border-color: #059669;
    }

        .stamp-approved-circle::before, .stamp-approved-circle .stamp-date {
            border-color: #059669;
        }

    .stamp-rejected-circle {
        color: #dc2626;
        border-color: #dc2626;
    }

        .stamp-rejected-circle::before, .stamp-rejected-circle .stamp-date {
            border-color: #dc2626;
        }

    .stamp-signed-circle {
        color: #2563eb;
        border-color: #2563eb;
    }

        .stamp-signed-circle::before, .stamp-signed-circle .stamp-date {
            border-color: #2563eb;
        }

    .print-only {
        display: none;
    }

    .excel-input {
        width: 100%;
        height: 100%;
        background: transparent;
        outline: none;
        border: none;
        font-family: inherit;
        font-size: inherit;
        resize: none;
    }

    /* =========================================================
       DEVICE BLOCKER CSS
       ========================================================= */
    @@media (max-width: 1023px) {
        #desktop-content {
            display: none !important;
        }

        #mobile-blocker {
            display: flex !important;
        }
    }

    /* =========================================================
       PRINT CSS - POTRET & MULTIPAGE HANDLING
       ========================================================= */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 10mm 10mm;
        }

        #print-ui-section table, #print-ui-section th, #print-ui-section td, #print-ui-section .border-black, #print-ui-section .border-r, #print-ui-section .border-b, #print-ui-section .border-l, #print-ui-section .border-t {
            border-color: #000000 !important;
        }
        /* Lindungi warna asli stempel */
        .stamp-approved-circle, .stamp-approved-circle::before, .stamp-approved-circle .stamp-date {
            border-color: #059669 !important;
            color: #059669 !important;
        }

        .stamp-rejected-circle, .stamp-rejected-circle::before, .stamp-rejected-circle .stamp-date {
            border-color: #dc2626 !important;
            color: #dc2626 !important;
        }

        .stamp-signed-circle, .stamp-signed-circle::before, .stamp-signed-circle .stamp-date {
            border-color: #2563eb !important;
            color: #2563eb !important;
        }

        body {
            background: white !important;
            padding: 1px !important;
            -webkit-print-color-adjust: exact;
        }

        #web-ui-section, #mobile-blocker, .no-print {
            display: none !important;
        }

        .print-only {
            display: block !important;
        }
        /* Konfigurasi spesifik agar tabel terpotong rapi antar halaman */
        table {
            page-break-after: auto;
            border-collapse: collapse;
            width: 100%;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        td {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        thead {
            display: table-header-group;
        }

        tfoot {
            display: table-footer-group;
        }

        #print-ui-section {
            box-shadow: none !important;
            margin: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            border: none !important;
        }
    }
</style>

<div id="mobile-blocker" class="hidden fixed inset-0 bg-slate-900 z-[9999] flex-col items-center justify-center text-center px-6">
    <svg class="w-20 h-20 text-red-500 mb-6 drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
    </svg>
    <h2 class="text-3xl font-extrabold text-white mb-2 tracking-wide">Access Denied</h2>
    <p class="text-slate-300 text-lg mb-6 max-w-md leading-relaxed">
        This Opportunities For Improvement (OFI) page is specifically optimized for large screens. Please open it using your <b>Laptop</b> or <b>Desktop PC</b>.
    </p>
    <a href="javascript:history.back()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-all">
        Go Back
    </a>
</div>

<div id="desktop-content">
    <div class="min-h-screen pt-3 sm:px-4 flex justify-center items-start mb-10">
        <div class="w-full max-w-6xl">
            <div class="mb-4">
                <a href="javascript:history.back()" class="inline-flex items-center text-sm font-medium text-white hover:text-blue-400 transition-colors no-print">
                    <svg class="w-4 h-4 mr-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5H1m0 0 4 4M1 5l4-4" />
                    </svg>
                    Back to CAR & OFI Management
                </a>
            </div>

            <div id="web-ui-section" class="w-full max-w-7xl bg-white rounded-xl shadow-2xl overflow-hidden">
                <input type="hidden" id="ofi_header_id" />

                <div class="p-6 border-b border-gray-200 bg-gray-50 flex flex-col md:flex-row justify-between items-center gap-4">
                    <div class="w-full md:w-1/4 text-center md:text-left">
                        @if (ViewBag.IsAdministrator != null && (bool)ViewBag.IsAdministrator)
                        {
                            <button type="button" onclick="openReminderModal()" class="shrink-0 bg-amber-500 text-white px-4 py-2.5 rounded-lg shadow-md font-bold hover:bg-amber-600 transition flex items-center gap-2 text-sm cursor-pointer">
                                <svg class="w-5 h-5 animate-pulse-hover" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                                </svg>
                                Send Reminder
                            </button>
                        }
                    </div>
                    <div class="w-full md:w-2/4 text-center flex flex-col items-center">
                        <h2 class="text-2xl font-bold uppercase tracking-wider text-gray-800">Opportunities For Improvement</h2>
                        <div class="flex flex-col items-center gap-1 mt-2 font-semibold text-gray-700">
                            <div class="flex items-center gap-2 text-sm">
                                <span>Kriteria :</span>
                                <input type="text" id="kriteria_web" class="border-b border-gray-300 bg-transparent outline-none focus:border-teal-600 text-center w-48 transition elegant-sync" value="Audit Internal IATF 16949">
                            </div>
                            <div class="text-xs text-gray-500 font-bold tracking-wide mt-0.5">
                                Periode : <span id="periode_web">-</span>
                            </div>
                        </div>
                    </div>

                    <div class="w-full md:w-1/4 flex justify-center md:justify-end gap-2 no-print">
                        <button type="button" onclick="exportExcel()" class="flex items-center gap-2 bg-emerald-600 text-white px-4 py-2 rounded-lg shadow hover:bg-emerald-700 transition font-bold text-sm">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            Excel
                        </button>
                        <button type="button" onclick="printForm()" class="flex items-center gap-2 bg-slate-600 text-white px-4 py-2 rounded-lg shadow hover:bg-slate-700 transition font-bold text-sm">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                            </svg>
                            Print
                        </button>
                    </div>
                </div>

                <div class="p-6">
                    <div class="flex items-center gap-3 mb-4 w-full md:w-1/3">
                        <label class="font-bold text-gray-800 text-sm whitespace-nowrap">Proses :</label>
                        <input type="text" id="input-proses" class="flex-1 border-b-2 border-gray-300 bg-transparent outline-none focus:border-teal-600 text-gray-800 font-semibold transition px-2 py-1 elegant-sync" readonly>
                    </div>

                    <div class="border border-gray-200 rounded-xl overflow-hidden shadow-sm mb-6">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-teal-50 border-b border-gray-200 text-teal-800">
                                <tr>
                                    <th class="p-3 border-r border-gray-200 font-bold text-center w-24">Clause</th>
                                    <th class="p-3 border-r border-gray-200 font-bold text-center w-[45%]">Observation and comments</th>
                                    <th class="p-3 border-r border-gray-200 font-bold text-center w-[35%]">Action Plan</th>
                                    <th class="p-3 font-bold text-center w-32">Date</th>
                                </tr>
                            </thead>
                            <tbody id="web-tbody">
                            </tbody>
                        </table>
                    </div>

                    <div class="flex flex-col items-end">
                        <div class="w-full md:w-[450px]">
                            <div class="flex border border-gray-300 bg-white rounded-lg shadow-sm overflow-hidden text-sm">

                                <div class="flex-1 border-r border-gray-200 flex flex-col h-full">
                                    <div class="py-1 bg-gray-50 font-bold text-gray-700 border-b border-gray-200 text-[11px] h-[33px] flex items-center justify-center">Disetujui</div>
                                    <div class="flex-1 min-h-[80px] bg-white transition hover:bg-gray-50 p-2 flex flex-col items-center justify-center relative overflow-hidden border-b border-gray-200">
                                        <input type="hidden" id="status_Disetujui">
                                        <div id="btn-group-Disetujui" class="flex flex-col gap-1.5 w-full px-1 no-print">
                                            <button type="button" onclick="setStamp('Disetujui', 'Approved')" class="text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-300 py-1 rounded hover:bg-emerald-600 hover:text-white transition uppercase shadow-sm cursor-pointer">Approve</button>
                                            <button type="button" onclick="setStamp('Disetujui', 'Rejected')" class="text-[10px] font-bold bg-red-50 text-red-700 border border-red-300 py-1 rounded hover:bg-red-600 hover:text-white transition uppercase shadow-sm cursor-pointer">Reject</button>
                                        </div>
                                        <div id="stamp-container-Disetujui" onclick="resetStamp('Disetujui')" class="absolute inset-0 flex items-center justify-center hidden cursor-pointer group bg-white hover:bg-gray-50 transition"></div>
                                    </div>
                                    <div class="p-1 bg-white h-[35px] flex items-center">
                                        <input type="text" id="sign_name_Disetujui" class="w-full text-center text-xs outline-none bg-transparent font-semibold text-gray-800 focus:bg-teal-50 rounded transition h-full elegant-sync auto-save-trigger" placeholder="Nama Terang">
                                    </div>
                                </div>

                                <div class="flex-1 border-r border-gray-200 flex flex-col h-full">
                                    <div class="py-1 bg-gray-50 font-bold text-gray-700 border-b border-gray-200 text-[11px] h-[33px] flex items-center justify-center">Diperiksa</div>
                                    <div class="flex-1 min-h-[80px] bg-white transition hover:bg-gray-50 p-2 flex flex-col items-center justify-center relative overflow-hidden border-b border-gray-200">
                                        <input type="hidden" id="status_Diperiksa">
                                        <div id="btn-group-Diperiksa" class="flex flex-col gap-1.5 w-full px-1 no-print">
                                            <button type="button" onclick="setStamp('Diperiksa', 'Approved')" class="text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-300 py-1 rounded hover:bg-emerald-600 hover:text-white transition uppercase shadow-sm cursor-pointer">Approve</button>
                                            <button type="button" onclick="setStamp('Diperiksa', 'Rejected')" class="text-[10px] font-bold bg-red-50 text-red-700 border border-red-300 py-1 rounded hover:bg-red-600 hover:text-white transition uppercase shadow-sm cursor-pointer">Reject</button>
                                        </div>
                                        <div id="stamp-container-Diperiksa" onclick="resetStamp('Diperiksa')" class="absolute inset-0 flex items-center justify-center hidden cursor-pointer group bg-white hover:bg-gray-50 transition"></div>
                                    </div>
                                    <div class="p-1 bg-white h-[35px] flex items-center">
                                        <input type="text" id="sign_name_Diperiksa" class="w-full text-center text-xs outline-none bg-transparent font-semibold text-gray-800 focus:bg-teal-50 rounded transition h-full elegant-sync auto-save-trigger" placeholder="Nama Terang">
                                    </div>
                                </div>

                                <div class="flex-1 flex flex-col h-full">
                                    <div class="py-1 bg-gray-50 font-bold text-gray-700 border-b border-gray-200 text-[11px] h-[33px] flex items-center justify-center">Dibuat</div>
                                    <div class="flex-1 min-h-[80px] bg-white transition hover:bg-gray-50 p-2 flex flex-col items-center justify-center relative overflow-hidden border-b border-gray-200">
                                        <input type="hidden" id="status_Dibuat">
                                        <div id="btn-group-Dibuat" class="flex flex-col gap-1.5 w-full px-1 no-print justify-center">
                                            <button type="button" onclick="setStamp('Dibuat', 'Signed')" class="text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-300 py-2 rounded hover:bg-blue-600 hover:text-white transition uppercase shadow-sm cursor-pointer">Sign / TTD</button>
                                        </div>
                                        <div id="stamp-container-Dibuat" onclick="resetStamp('Dibuat')" class="absolute inset-0 flex items-center justify-center hidden cursor-pointer group bg-white hover:bg-gray-50 transition"></div>
                                    </div>
                                    <div class="p-1 bg-white h-[35px] flex items-center">
                                        <input type="text" id="sign_name_Dibuat" class="w-full text-center text-xs outline-none bg-transparent font-semibold text-gray-800 focus:bg-teal-50 rounded transition h-full elegant-sync auto-save-trigger" placeholder="Nama Terang">
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="mt-8 flex justify-end no-print">
                        <button type="button" onclick="submitForm()" class="flex items-center justify-center gap-2 bg-teal-700 text-white px-10 py-2.5 rounded-lg shadow-xl hover:bg-teal-800 transition font-bold text-lg">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Simpan Laporan
                        </button>
                    </div>
                </div>
            </div>

            <div id="print-ui-section" class="print-only text-black text-[12px] font-sans w-full bg-white">
                <table class="w-full text-left border-collapse border border-black" style="table-layout: fixed;">
                    <colgroup>
                        <col style="width: 8%;" />
                        <col style="width: 45%;" />
                        <col style="width: 35%;" />
                        <col style="width: 10%;" />
                    </colgroup>
                    <thead class="table-header-group">
                        <tr>
                            <td colspan="4" class="p-0 border border-black align-top">
                                <div class="flex border-b border-black">
                                    <div class="w-[200px] border-r border-black p-2 flex flex-col justify-center items-center box-border">
                                        <img src="@Url.Content("~/Images/niterra-logo.jpg")" alt="Niterra-Logo" style="max-height: 50px; max-width: 100%; object-fit: contain;" />
                                    </div>
                                    <div class="flex-1 flex flex-col justify-center items-center py-2 box-border">
                                        <div class="text-[16px] mb-1 font-bold">OPPORTUNITIES FOR IMPROVEMENT</div>
                                        <div class="flex flex-col items-center gap-0.5 text-[13px]">
                                            <div>Kriteria : <span id="kriteria_print" class="inline-block"></span></div>
                                            <div class="text-[11px] text-gray-700 font-normal">Periode : <span id="periode_print" class="inline-block"></span></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="px-2 py-1 flex items-center border-top border-black gap-1 font-semibold bg-gray-50">
                                    Proses : <span id="proses_print" class="w-48 inline-block"></span>
                                </div>
                            </td>
                        </tr>
                        <tr class="bg-gray-50">
                            <th class="border border-black p-1 text-center font-semibold">Clause</th>
                            <th class="border border-black p-1 text-center font-semibold">Observation and comments</th>
                            <th class="border border-black p-1 text-center font-semibold">Action Plan</th>
                            <th class="border border-black p-1 text-center font-semibold">Date</th>
                        </tr>
                    </thead>

                    <tbody id="print-tbody">
                    </tbody>

                    <tfoot class="table-footer-group">
                        <tr>
                            <td colspan="4" style="height: 35px; border: none !important; background: transparent;"></td>
                        </tr>

                        <tr>
                            <td colspan="2" style="border: none !important; background: transparent;"></td>

                            <td colspan="2" class="p-0 border border-black align-top">
                                <div class="flex justify-end w-full">
                                    <div class="w-full">
                                        <div class="flex w-full">
                                            <div class="flex-1 border-r border-black flex flex-col box-border">
                                                <div class="text-center border-b border-black p-0.5 font-bold">Disetujui,</div>
                                                <div class="h-16 border-b border-black flex items-center justify-center font-bold text-lg" id="print-status-Disetujui"></div>
                                                <div class="text-center p-0.5"><div id="print-name-Disetujui" class="text-center font-bold w-full min-h-[16px]"></div></div>
                                            </div>
                                            <div class="flex-1 border-r border-black flex flex-col box-border">
                                                <div class="text-center border-b border-black p-0.5 font-bold">Diperiksa,</div>
                                                <div class="h-16 border-b border-black flex items-center justify-center font-bold text-lg" id="print-status-Diperiksa"></div>
                                                <div class="text-center p-0.5"><div id="print-name-Diperiksa" class="text-center font-bold w-full min-h-[16px]"></div></div>
                                            </div>
                                            <div class="flex-1 flex flex-col box-border">
                                                <div class="text-center border-b border-black p-0.5 font-bold">Dibuat,</div>
                                                <div class="h-16 border-b border-black flex items-center justify-center font-bold text-lg" id="print-status-Dibuat"></div>
                                                <div class="text-center p-0.5"><div id="print-name-Dibuat" class="text-center font-bold w-full min-h-[16px]"></div></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="reminderModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[1000] flex items-center justify-center no-print transition-opacity">

    <div class="bg-white rounded shadow-2xl w-full max-w-md transform transition-all overflow-hidden flex flex-col max-h-[90vh] border border-gray-200">

        <div class="bg-gray-50 p-3 border-b border-gray-200 flex justify-between items-center">
            <div>
                <h3 class="text-sm font-bold text-teal-800 uppercase tracking-wide">Send Reminder</h3>
                <p class="text-[11px] text-gray-500 mt-0.5">Select recipients and add an optional message.</p>
            </div>
            <button type="button" onclick="closeReminderModal()" class="text-gray-400 hover:text-red-600 transition cursor-pointer p-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="p-3 overflow-y-auto flex-1 space-y-4">

            <div>
                <label class="block text-[13px] font-bold text-gray-800 mb-2">Pilih Penerima :</label>

                <div class="max-h-48 overflow-y-auto border border-gray-200 rounded bg-white p-2 space-y-3 shadow-inner">

                    @if (ViewBag.ListAuditee != null)
                    {
                        <div>
                            <div class="text-[10px] font-bold text-gray-500 mb-1 px-1 uppercase border-b border-gray-100 pb-1">Auditee</div>
                            <div class="space-y-0.5">
                                @foreach (var auditee in ViewBag.ListAuditee)
                                {
                                    <label class="flex items-center p-2 hover:bg-teal-50 rounded cursor-pointer transition">
                                        <input type="checkbox" name="reminderUsers" value="@auditee.Email" class="w-3.5 h-3.5 accent-teal-600 cursor-pointer">
                                        <div class="ml-2 flex flex-col leading-tight">
                                            <span class="text-[13px] font-semibold text-gray-800">@auditee.Name</span>
                                            <span class="text-[10px] text-gray-500">NIK: @auditee.NIK</span>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    @if (ViewBag.ListAuditor != null)
                    {
                        <div>
                            <div class="text-[10px] font-bold text-gray-500 mb-1 px-1 uppercase border-b border-gray-100 pb-1 mt-2">Auditor</div>
                            <div class="space-y-0.5">
                                @foreach (var auditor in ViewBag.ListAuditor)
                                {
                                    <label class="flex items-center p-2 hover:bg-teal-50 rounded cursor-pointer transition">
                                        <input type="checkbox" name="reminderUsers" value="@auditor.Email" class="w-3.5 h-3.5 accent-teal-600 cursor-pointer">
                                        <div class="ml-2 flex flex-col leading-tight">
                                            <span class="text-[13px] font-semibold text-gray-800">@auditor.Name</span>
                                            <span class="text-[10px] text-gray-500">NIK: @auditor.NIK</span>
                                        </div>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div>
                <label for="reminderMessage" class="block text-[13px] font-bold text-gray-800 mb-2">Message :</label>
                <textarea id="reminderMessage" rows="3" placeholder="Type your reminder message here..." class="w-full text-[13px] border border-gray-300 rounded bg-transparent p-2.5 outline-none focus:border-teal-600 transition text-gray-800 resize-none shadow-sm"></textarea>
            </div>
        </div>

        <div class="bg-gray-50 px-2 py-2 border-t border-gray-200 flex justify-end gap-2">
            <button type="button" onclick="closeReminderModal()" class="text-xs px-5 py-2 font-bold bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition cursor-pointer shadow-sm">Cancel</button>
            <button type="button" onclick="processReminder('OFI', '@ViewBag.OFI_ID')" class="text-xs px-5 py-2 font-bold bg-teal-700 text-white rounded-lg hover:bg-teal-800 transition shadow-md flex items-center gap-1.5 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                Send Reminder
            </button>
        </div>
    </div>
</div>


<script>
    let loggedInUserName = '@Html.Raw(ViewBag.Name)';
    let autoSaveTimer;

    $(document).ready(function () {
        const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        if (isMobile || window.innerWidth < 1024) {
            $('#desktop-content').hide();
            $('#mobile-blocker').removeClass('hidden').css('display', 'flex');
            return;
        }

        const urlParams = new URLSearchParams(window.location.search);
        const ofiId = '@Html.Raw(ViewBag.OFI_ID)' || urlParams.get('id');
        if (ofiId) loadOFIData(ofiId);

        $(document).on('input change', '.auto-save-trigger', function() {
            clearTimeout(autoSaveTimer);
            autoSaveTimer = setTimeout(function() { submitForm(true); }, 1500);
        });

        $(document).on('input', 'textarea.elegant-sync', function () {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';
        });
    });

    function loadOFIData(id) {
        Swal.fire({ title: 'Loading...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });
        $.ajax({
            url: '@Url.Action("GetDetailOFI", "EAudit")',
            type: 'GET', data: { id: id },
            success: function (res) {
                if (res.success) {
                    if(res.currentUserName) {
                        loggedInUserName = res.currentUserName;
                    }
                    renderDataToUI(res.data);
                    Swal.close();
                } else Swal.fire('Error', res.message, 'error');
            }
        });
    }

    function renderDataToUI(data) {
        $('#ofi_header_id').val(data.ofi_header_id);
        $('#input-proses').val(data.section);

        if (data.Periode) {
            let startDate = parseDotNetDate(data.Periode.start);
            let endDate = parseDotNetDate(data.Periode.end);
            if (startDate && !isNaN(startDate.getTime()) && endDate && !isNaN(endDate.getTime())) {
                const months = ["JAN", "FEB", "MAR", "APR", "MEI", "JUN", "JUL", "AGU", "SEP", "OKT", "NOV", "DES"];
                let startStr = `${String(startDate.getDate()).padStart(2, '0')} ${months[startDate.getMonth()]} ${startDate.getFullYear()}`;
                let endStr = `${String(endDate.getDate()).padStart(2, '0')} ${months[endDate.getMonth()]} ${endDate.getFullYear()}`;
                let txtPeriode = `${startStr} s/d ${endStr}`;

                $('#periode_web').text(txtPeriode);
                $('#periode_print').text(txtPeriode);
            }
        }

        const webTbody = $('#web-tbody');
        const printTbody = $('#print-tbody');
        webTbody.empty();
        printTbody.empty();

        if (data.Details) {
            data.Details.forEach(dtl => {
                let formattedDate = '';

                if (dtl.action_date) {
                    let dateObj = parseDotNetDate(dtl.action_date);
                    if (dateObj && !isNaN(dateObj.getTime())) {
                        let year = dateObj.getFullYear();
                        let month = String(dateObj.getMonth() + 1).padStart(2, '0');
                        let day = String(dateObj.getDate()).padStart(2, '0');
                        formattedDate = `${year}-${month}-${day}`;
                    }
                }

                // MENGUBAH ALIGN-TOP MENJADI ALIGN-MIDDLE PADA WEB UI (KLAUSUL & TANGGAL)
                let webRow = `
                    <tr class="border-b border-gray-200 web-detail-row group transition hover:bg-gray-50 focus-within:bg-teal-50">
                        <td class="border-r border-gray-200 p-2 align-middle"><input type="hidden" class="inp-detail-id" value="${dtl.ofi_detail_id}"><input type="text" class="w-full text-center bg-transparent outline-none font-semibold text-gray-700" value="${dtl.clause || '-'}" readonly></td>
                        <td class="border-r border-gray-200 p-4 align-top"><textarea class="inp-obs-comment w-full min-h-[120px] bg-transparent outline-none resize-none elegant-sync auto-save-trigger" placeholder="Type observation...">${dtl.observation_comment || ''}</textarea></td>
                        <td class="border-r border-gray-200 p-4 align-top"><textarea class="inp-action-plan w-full min-h-[120px] bg-transparent outline-none resize-none elegant-sync auto-save-trigger" placeholder="Type action plan...">${dtl.action_plan || ''}</textarea></td>
                        <td class="p-2 align-middle text-center">
                            <input type="date"
                                   class="inp-action-date w-full text-center bg-transparent outline-none font-semibold text-gray-700 elegant-sync auto-save-trigger"
                                   value="${formattedDate}">
                        </td>
                    </tr>`;
                webTbody.append(webRow);

                // MENGUBAH ALIGN-TOP MENJADI ALIGN-MIDDLE PADA PRINT UI (KLAUSUL & TANGGAL)
                let printRow = `
                    <tr style="page-break-inside: avoid; border-bottom: 1px solid #000000;">
                        <td class="p-1 align-middle text-center font-semibold" style="border: 1px solid #000000; word-wrap: break-word; vertical-align: middle;">${dtl.clause || '-'}</td>
                        <td class="p-2 align-top" style="border: 1px solid #000000; white-space: pre-line;" id="p-obs-${dtl.ofi_detail_id}">${dtl.observation_comment || ''}</td>
                        <td class="p-2 align-top" style="border: 1px solid #000000; white-space: pre-line;" id="p-plan-${dtl.ofi_detail_id}">${dtl.action_plan || ''}</td>
                        <td class="p-1 align-middle text-center font-semibold" style="border: 1px solid #000000; vertical-align: middle;" id="p-date-${dtl.ofi_detail_id}">${formattedDate}</td>
                    </tr>`;
                printTbody.append(printRow);
            });



            // Trigger tinggi awal dari textarea sesuai isi saat dimuat
            $('textarea.elegant-sync').each(function () {
                this.style.height = 'auto';
                this.style.height = this.scrollHeight + 'px';
            });
        }

        if (data.Approvals) {
            data.Approvals.forEach(app => {
                let rawType = app.sign_type || "";
                let titleCased = rawType.replace(/\w\S*/g, function (txt) {
                    return txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase();
                });
                let idTarget = titleCased.replace(/\s+/g, "");

                if (app.status) {
                    setStamp(idTarget, app.status, app.sign_by, app.sign_date, false);
                }
            });
        }
    }

    function parseDotNetDate(dateVal) {
        if (!dateVal) return null;
        if (typeof dateVal === 'string' && dateVal.indexOf('/Date(') !== -1) {
            return new Date(parseInt(dateVal.replace(/\/Date\((-?\d+)\)\//, '$1')));
        }
        return new Date(dateVal);
    }

    function setStamp(target, status, existingName = null, existingDate = null, triggerAutoSave = true) {
        const btnElement = document.getElementById('btn-group-' + target);
        const containerElement = document.getElementById('stamp-container-' + target);

        if (!btnElement || !containerElement) return;

        btnElement.classList.add('hidden');
        containerElement.classList.remove('hidden');

        const dateObj = existingDate ? parseDotNetDate(existingDate) : new Date();
        const months = ["JAN", "FEB", "MAR", "APR", "MEI", "JUN", "JUL", "AGU", "SEP", "OKT", "NOV", "DES"];
        const dateString = `${String(dateObj.getDate()).padStart(2, '0')} ${months[dateObj.getMonth()]} ${dateObj.getFullYear()}`;

        let stampHtml = '';
        if (status === 'Approved') {
            stampHtml = `<div class="stamp-circle stamp-approved-circle group-hover:opacity-30 transition"><span class="stamp-text">APPROVED</span><span class="stamp-date">${dateString}</span></div>`;
        } else if (status === 'Rejected') {
            stampHtml = `<div class="stamp-circle stamp-rejected-circle group-hover:opacity-30 transition"><span class="stamp-text">REJECTED</span><span class="stamp-date">${dateString}</span></div>`;
        } else if (status === 'Signed') {
            stampHtml = `<div class="stamp-circle stamp-signed-circle group-hover:opacity-30 transition"><span class="stamp-text" style="font-size:0.55rem;">SIGNED</span><span class="stamp-date">${dateString}</span></div>`;
        }

        containerElement.innerHTML = stampHtml;
        $('#status_' + target).val(status);

        const signInput = document.getElementById('sign_name_' + target);
        if (signInput) {
            if (existingName) signInput.value = existingName;
            else signInput.value = loggedInUserName;

            if (!signInput.value) {
                Swal.fire({ icon: 'warning', title: 'Oops...', text: `Nama Terang untuk ${target} tidak ditemukan. Silakan isi manual.` });
            }
        }

        if (triggerAutoSave) submitForm(true);
    }

    function resetStamp(target) {
        $('#status_' + target).val('');
        $('#sign_name_' + target).val('');

        const container = document.getElementById('stamp-container-' + target);
        container.classList.add('hidden');
        container.innerHTML = '';

        document.getElementById('btn-group-' + target).classList.remove('hidden');

        submitForm(true);
    }

    function submitForm(isAutoSave = false) {
        let postData = {
            ofi_header_id: $('#ofi_header_id').val(),
            Details: [],
            Approvals: [
                { sign_type: "Disetujui", status: $('#status_Disetujui').val(), sign_by: $('#sign_name_Disetujui').val() },
                { sign_type: "Diperiksa", status: $('#status_Diperiksa').val(), sign_by: $('#sign_name_Diperiksa').val() },
                { sign_type: "Dibuat", status: $('#status_Dibuat').val(), sign_by: $('#sign_name_Dibuat').val() }
            ]
        };

        $('.web-detail-row').each(function() {
            let detailId = $(this).find('.inp-detail-id').val();
            let obsVal = $(this).find('.inp-obs-comment').val();
            let planVal = $(this).find('.inp-action-plan').val();
            let rawDate = $(this).find('.inp-action-date').val();
            let dateVal = (rawDate && rawDate.trim() !== "") ? rawDate : null;

            postData.Details.push({
                ofi_detail_id: detailId,
                observation_comment: obsVal,
                action_plan: planVal,
                action_date: dateVal
            });

            // Update teks untuk UI Print Preview
            $(`#p-obs-${detailId}`).text(obsVal);
            $(`#p-plan-${detailId}`).text(planVal);
            $(`#p-date-${detailId}`).text(rawDate ? rawDate : '-');
        });

        let Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 2000 });
        if(isAutoSave) Toast.fire({ icon: 'info', title: 'Saving...' });
        else Swal.fire({ title: 'Saving...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });

        $.ajax({
            url: '@Url.Action("SaveOFI", "EAudit")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(postData),
            success: function(res) {
                if (res.success) {
                    if(!isAutoSave) Swal.fire('Saved!', res.message, 'success');
                    else Toast.fire({ icon: 'success', title: 'Auto-Saved' });

                } else {
                    if(!isAutoSave) Swal.fire('Error', res.message, 'error');
                }
            },
            error: function(xhr, status, error) {
                console.error("Payload Error:", xhr.responseText);
                if(!isAutoSave) Swal.fire('Error', 'Terjadi kesalahan sistem saat menyimpan data tanggal.', 'error');
            }
        });
    }

    function printForm() {
        // Sinkronisasi data web -> print section (Gunakan .text() karena sekarang elemennya span/div)
        $('#kriteria_print').text($('#kriteria_web').val());
        $('#proses_print').text($('#input-proses').val());

        document.getElementById('print-status-Disetujui').innerHTML = document.getElementById('stamp-container-Disetujui').innerHTML || '';
        document.getElementById('print-status-Diperiksa').innerHTML = document.getElementById('stamp-container-Diperiksa').innerHTML || '';
        document.getElementById('print-status-Dibuat').innerHTML = document.getElementById('stamp-container-Dibuat').innerHTML || '';

        $('#print-name-Disetujui').text($('#sign_name_Disetujui').val() || '');
        $('#print-name-Diperiksa').text($('#sign_name_Diperiksa').val() || '');
        $('#print-name-Dibuat').text($('#sign_name_Dibuat').val() || '');

        // Eksekusi library printThis pada kontainer cetak
        $('#print-ui-section').printThis({
            importCSS: true,
            importStyle: true,
            pageTitle: "OFI Report",
            removeInline: false,
            printDelay: 500
        });
    }

    function exportExcel() {
        const ofiId = $('#ofi_header_id').val();

        if (!ofiId || ofiId === "0" || ofiId === "") {
            Swal.fire({
                icon: 'warning',
                title: 'Data Belum Disimpan',
                text: 'Silakan klik tombol "Simpan Laporan" terlebih dahulu sebelum melakukan Export Excel.'
            });
            return;
        }

        const Toast = Swal.mixin({
            toast: true, position: 'top-end', showConfirmButton: false, timer: 3000
        });
        Toast.fire({ icon: 'info', title: 'Mempersiapkan File Excel...' });

        window.location.href = '@Url.Action("ExportExcelOFI", "EAudit")' + '?id=' + ofiId;
    }

    function openReminderModal() {
        const modal = document.getElementById('reminderModal');
        modal.classList.remove('hidden');
    }

    function closeReminderModal() {
        const modal = document.getElementById('reminderModal');
        modal.classList.add('hidden');

        // Reset form saat ditutup
        document.getElementById('reminderMessage').value = "";
        const checkboxes = document.querySelectorAll('input[name="reminderUsers"]');
        checkboxes.forEach(cb => cb.checked = false);
    }

    // Memproses pengiriman reminder
    function processReminder(jenisReminder, docId) {
    // 1. Tutup modal terlebih dahulu agar layar fokus ke loading alert
        

        // 2. Ambil semua checkbox yang dicentang
        const selectedCheckboxes = document.querySelectorAll('input[name="reminderUsers"]:checked');
        const selectedEmails = Array.from(selectedCheckboxes).map(cb => cb.value);
        const message = document.getElementById('reminderMessage').value;
        console.log(selectedEmails, selectedCheckboxes)

        // 3. Validasi: pastikan user sudah dipilih minimal 1
        if (selectedEmails.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Penerima Kosong',
                text: 'Silakan pilih minimal satu penerima (Auditee atau Auditor).',
                confirmButtonColor: '#0f766e'
            }).then(() => {
                // Buka kembali modal jika validasi gagal
                openReminderModal();
            });
            return;
        }
        closeReminderModal();
        // 4. Tampilkan loading (menunggu respon server)
        Swal.fire({
            title: 'Mengirim Reminder...',
            text: 'Mohon tunggu sebentar, email sedang dikirim.',
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        // 5. Setup data (payload) yang akan dikirim ke Controller
        const payload = {
            emails: selectedEmails,
            message: message,
            id: docId,
            jenisReminder: jenisReminder
        };

        // 6. Eksekusi AJAX ke Backend (Menggunakan Razor Url.Action)
        $.ajax({
            url: '@Url.Action("SendReminderEmail", "EAudit")', // URL Dinamis Razor
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.status === "success") {
                    Swal.fire({
                        icon: 'success',
                        title: 'Berhasil!',
                        text: response.message,
                        confirmButtonColor: '#0f766e'
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Gagal!',
                        text: response.message,
                        confirmButtonColor: '#dc2626'
                    });
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Error Koneksi',
                    text: 'Terjadi kesalahan saat menghubungi server untuk mengirim email.',
                    confirmButtonColor: '#dc2626'
                });
            }
        });
    }
</script>