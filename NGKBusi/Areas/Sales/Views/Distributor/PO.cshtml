@using Microsoft.AspNet.Identity;
@using System.Security.Claims;
@{
    ViewBag.Title = "PO List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currUser = ((ClaimsIdentity)User.Identity);
}

@section cssHead{
    <link href="@Url.Content("~/Content/handsontable/handsontable.full.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/handsontable/ht-theme-main-min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Sales/Distributor/PO.css")" rel="stylesheet" />
}
@section scriptHead{
    <script src="@Url.Content("~/Scripts/handsontable/handsontable.full.min.js")"></script>
    <script src="@Url.Content("~/Scripts/Sales/Distributor/PO.js")"></script>
}

<h2>PO</h2>
<button type="button" id="btnSalesPOSave">Save</button>
<hr />

<div class="container-fluid">
    <div class="row">
        <div class="col-6">
            <form class="bg-white rounded-lg shadow p-2">
                <input type="hidden" id="txtHeaderID" value="0" />
                <div class="form-group row">
                    <label for="lblNiterraPO" class="col-sm-4 col-form-label">PO No</label>
                    <div class="col-sm-8">
                        <label id="lblNiterraPO">-</label>
                    </div>
                </div>
                <div class="form-group row">
                    <label for="txtCustName" class="col-sm-4 col-form-label">Nama Distro</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" id="txtCustName" placeholder="Customer Name" value="@currUser.FindFirstValue("DeptName")" readonly>
                    </div>
                </div>
                <div class="form-group row">
                    <label for="txtCustCode" class="col-sm-4 col-form-label">Cust. Code</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" id="txtCustCode" placeholder="Customer Code" value="@currUser.FindFirstValue("DeptID")" readonly>
                    </div>
                </div>
                <div class="form-group row">
                    <label for="txtPODate" class="col-sm-4 col-form-label">Tanggal PO</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control jqDate" id="txtPODate" placeholder="Purchase Order Date" value="@DateTime.Now.ToString("dd-MM-yyyy")">
                    </div>
                </div>
                <div class="form-group row">
                    <label for="txtPONo" class="col-sm-4 col-form-label">Nomor PO Distro</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" id="txtPONo" placeholder="Distributor Purchase Order">
                    </div>
                </div>
                <div class="form-group row">
                    <label for="txtSONo" class="col-sm-4 col-form-label">Nomor SO Niterra</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" id="txtSONo" placeholder="Niterra Sales Order" readonly>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-6">
            <table class="tblDistPOSign table table-bordered rounded-lg shadow p-2 text-center">
                <thead>
                    <tr><th>Approved By</th><th>Created By</th></tr>
                </thead>
                <tbody>
                    <tr><td style="height:125px;"></td><td></td></tr>
                </tbody>
                <tfoot>
                    <tr><th></th><th></th></tr>
                    <tr><th></th><th></th></tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div id="divPOPartList" class="mt-4"></div>
        </div>
    </div>
</div>