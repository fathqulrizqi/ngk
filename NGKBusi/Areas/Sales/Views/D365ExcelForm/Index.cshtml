<script>
    var $table = $('#fresh-table');
    $(function () {
        $('#fresh-table').bootstrapTable({
            exportDataType: "all",
            exportTypes: ['excel', 'pdf'],
            buttonsClass: 'primary',
        })
    });

    $('#btn-reload').click(function () {
        $('#fresh-table').bootstrapTable('refresh');
    });

    var $table2 = $('#fresh-pickinglist-table');
    $(function () {
        $('#fresh-pickinglist-table').bootstrapTable({
            exportDataType: "all",
            exportTypes: ['excel', 'pdf'],
            buttonsClass: 'primary',
        })
    });

    $('#btn-reload').click(function () {
        $('#fresh-pickinglist-table').bootstrapTable('refresh');
    });


    function queryParams(params) {
        params.switch = "";//   <<<----------catch like this
        return params;
    }
    function ajaxRequest(params) {
            //var RequestNo = "@(ViewBag.RequestNo)";
            $.ajax({
                type: "post",
                url: "@Url.Action("GetDataBackOrder", "D365ExcelForm", new { area = "Sales" })",
                dataType: 'json',
                //data: $('#formFilter').serialize(),
                success: function (items) {
                    //console.log(items.rows);
                    params.success({
                        rows: items,
                        data: items
                    }, null);
                },
                error: function (er) {
                    console.log(params.error(er))
                    console.log("error", er);
                }
            })
    }

    function getDataPickingList(params) { // Diperbaiki dari getDataPackinglist
    //var RequestNo = "@(ViewBag.RequestNo)";
    $.ajax({
        type: "get",
        // URL ini sudah benar sejak awal, mengarah ke "GetDataPickingList"
        url: "@Url.Action("GetDataPickingList", "D365ExcelForm", new { area = "Sales" })",
        dataType: 'json',
        //data: $('#formFilter').serialize(),
        success: function (items) {
            params.success({
                rows: items,
                data: items
            }, null);
        },
        error: function (er) {
            // Perbaikan kecil untuk penanganan error yang lebih baik
            console.log("Error fetching Picking List data:", er);
            params.error(er);
        }
    })
}
    function dateFormat(value) {
        return moment(value).format('DD/MM/YYYY');
    }

    $(document).ready(function () {
        var totalData;
        var data;
        var totalRow;
        var startRow = 0;
        var startRowSales;
        var successInsert;
        var arrayInsert = 0;
        var insertDataRow;





        $('#FormUploadOrderLine').on('submit', (function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            var $submitBtn = $(this).find('button[type="submit"]');
            var originalBtnHtml = $submitBtn.html();

            $.ajax({
                type: 'POST',
                url: "@Url.Action("OrderLines", "D365ExcelForm", new { area = "Sales" })",
                data: formData,
                cache: false,
                contentType: false,
                processData: false,
