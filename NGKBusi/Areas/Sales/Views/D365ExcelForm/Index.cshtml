        $('#formUploadPickinglist').submit(function (e) {
            // Mencegah pengiriman form standar (default)
            e.preventDefault();

            var form = $(this);
            var url = form.attr('action');
            var formData = new FormData(form[0]);


            // Lakukan AJAX POST
            $.ajax({
                url: url,
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                dataType: 'json',
                beforeSend: function () {
                    $('.loading').css("display", "");
                },
                success: function (response) {
                    $('.loading').css("display", "");
                    $('#process').hide();


                    if (response.status === 1) {
                        $('.loading').css("display", "none");
                        var successMsg = response.msg;

                        // Panggil SweetAlert untuk Sukses
                        Swal.fire({
                            icon: 'success',
                            title: 'Import Successful!',
                            text: successMsg,
                            timer: 3500, // Otomatis menutup setelah 3.5 detik
                            showConfirmButton: false
                        });

                    } else {
                        // Import Gagal (Validasi File/Data/Database Error)
                        var failedMsg = response.msg;
                        $('#process_data').html('<span class="text-danger font-weight-bold">❌ FAILED: ' + failedMsg + '</span>');

                        // Panggil SweetAlert untuk Gagal
                        Swal.fire({
                            icon: 'error',
                            title: 'Import Failed!',
                            text: failedMsg,
                            footer: 'Please check the file format or database constraints.',
                            showConfirmButton: true
                        });
                    }
                },
                error: function (xhr, status, error) {
                    $('#process').hide();
                    $('#btnImport').prop('disabled', false).text('Impor');

                    // Tangani error koneksi atau server 500
                    var serverErrorMsg = 'Server responded with status ' + xhr.status + '. Could not complete the upload.';
                    $('#process_data').html('<span class="text-danger font-weight-bold">❌ ' + serverErrorMsg + '</span>');

                    // Panggil SweetAlert untuk Error Server
                    Swal.fire({
                        icon: 'error',
                        title: 'Server Error!',
                        text: serverErrorMsg,
                        footer: 'Check the browser console (F12) for detailed server response.',
                        showConfirmButton: true
                    });

                    console.log("AJAX Error Response:", xhr.responseText);
                }
            });
        });
        function start_import_order_line(insertData) {
            $('#processOrderLine').css('display', 'block');
            $.ajax({
                url: "@Url.Action("ImportRowOrderLines", "D365ExcelForm", new { area = "Sales" })",
