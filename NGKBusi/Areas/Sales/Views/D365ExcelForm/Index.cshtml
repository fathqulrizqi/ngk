                    // Show SweetAlert2 loading progress
                    Swal.fire({
                        title: 'Importing Data',
                        html: 'Saving data to the database, please wait...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function (response) {
                    $submitBtn.prop('disabled', false).html(originalBtnHtml);
                    Swal.close();
                    if (response.status == 1) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: response.msg,
                            showConfirmButton: true
                        });
                        $('#FormUploadOrderLine')[0].reset();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed!',
                            text: response.msg,
                            showConfirmButton: true
                        });
                    }
                },
