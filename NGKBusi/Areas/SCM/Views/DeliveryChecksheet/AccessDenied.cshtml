@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Akses Terbatas - Checksheet</title>
    <!-- Load Tailwind CSS -->
    <script src="@Url.Content("~/Scripts/tailwind/tailwind.js")"></script>
    <style>
        @@keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.05); opacity: 0.4; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }
        .pulse-ring {
            animation: pulse-ring 3s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-slate-50 flex items-center justify-center min-h-screen font-sans">
    <div class="w-full max-w-lg p-6">
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden transition-all duration-300 transform hover:scale-[1.01]">
            <div class="p-8 text-center">
                <!-- Lock Icon with pulsed animation -->
                <div class="relative w-24 h-24 mx-auto mb-6 flex items-center justify-center">
                    <div class="absolute inset-0 rounded-full bg-red-100 opacity-60 pulse-ring"></div>
                    <div class="relative w-16 h-16 rounded-full bg-red-500 flex items-center justify-center shadow-lg shadow-red-200">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                    </div>
                </div>

                <!-- Headline -->
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Akses Terbatas</h1>
                <p class="text-sm text-gray-500 mb-6">Modul Checksheet Kendaraan Operasional</p>

                <!-- Detailed Information Card -->
                <div class="bg-slate-50 rounded-xl p-5 mb-8 border border-slate-100 text-left space-y-3">
                    <div class="flex justify-between items-center text-xs pb-2.5 border-b border-slate-200">
                        <span class="text-gray-400 font-medium uppercase">NIK Anda</span>
                        <span class="font-bold text-slate-800 bg-slate-200 px-2 py-0.5 rounded">@ViewBag.UserNIK</span>
                    </div>
                    <p class="text-xs text-gray-600 leading-relaxed">
                        Maaf, NIK Anda tidak terdaftar atau dalam status tidak aktif di database otorisasi pengguna checksheet (`WHFG_Checksheet_Users`).
                    </p>
                    <p class="text-xs text-gray-500 leading-relaxed italic">
                        Hubungi Administrator Departemen SCM untuk mendaftarkan NIK Anda agar mendapatkan hak akses pengisian atau pemantauan checksheet ini.
                    </p>
                </div>

                <!-- Action Button -->
                <a href="@Url.Content("~/Home")" class="inline-flex items-center justify-center w-full px-5 py-3 bg-gradient-to-r from-slate-800 to-slate-900 hover:from-slate-900 hover:to-black text-white font-semibold text-sm rounded-xl shadow-md transition-all duration-200 outline-none">
                    <svg class="w-4.5 h-4.5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Kembali ke Dashboard Utama
                </a>
            </div>
        </div>
    </div>
</body>
</html>
