@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- DataTables CSS CDN (Bootstrap 4/5 compatible) -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap4.min.css" />

<style>
    body {
        background: #f3f4f6;
    }

    .page-header-modern {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        /*        margin: 2.5rem 0 2rem 0;*/
        margin-bottom: 2rem;
        padding: 2rem 1rem 1.5rem 1rem;
        background: linear-gradient(90deg, #2563eb 0%, #60a5fa 100%);
        border-radius: 1.5rem;
        box-shadow: 0 6px 32px rgba(0,0,0,0.10);
        position: relative;
        overflow: hidden;
    }

        .page-header-modern h1 {
            color: #fff;
            font-size: 2.7rem;
            font-weight: 800;
            letter-spacing: 2px;
            margin: 0;
            text-shadow: 0 2px 8px rgba(0,0,0,0.10);
            text-align: center;
        }

        .page-header-modern .header-underline {
            width: 80px;
            height: 5px;
            background: #fff;
            border-radius: 3px;
            margin: 1.2rem auto 0 auto;
            opacity: 0.7;
        }

        .page-header-modern .header-icon {
            position: absolute;
            right: 2.5rem;
            top: 1.5rem;
            font-size: 3.5rem;
            color: rgba(255,255,255,0.12);
            pointer-events: none;
            user-select: none;
        }

    @@media (max-width: 767.98px) {
        .page-header-modern {
            padding: 1.2rem 0.5rem 1rem 0.5rem;
            border-radius: 1rem;
        }

            .page-header-modern h1 {
                font-size: 1.5rem;
            }

            .page-header-modern .header-icon {
                font-size: 2.2rem;
                right: 1rem;
                top: 0.7rem;
            }

            .page-header-modern .header-underline {
                width: 40px;
                height: 3px;
            }
    }

    .section-bg {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        border-radius: 1rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
        margin-bottom: 2.5rem;
        padding: 2.5rem 1.5rem;
        transition: box-shadow 0.2s;
    }

        .section-bg:hover {
            box-shadow: 0 8px 32px rgba(0,0,0,0.12);
        }

    .section-title {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #2d3748;
        margin-bottom: 1.5rem;
        text-align: left;
    }

    .form-card {
        background: #fff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        padding: 2rem 1.5rem 1.5rem 1.5rem;
        margin-bottom: 1.5rem;
    }

        .form-card label {
            font-weight: 600;
            color: #374151;
        }

        .form-card .form-control {
            border-radius: 0.5rem;
            font-size: 1.1rem;
        }

        .form-card .btn {
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 0.5rem;
        }

    .toggle-btn-group {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
        gap: 1rem;
    }

        .toggle-btn-group .btn {
            min-width: 180px;
            font-size: 1.1rem;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

    .table-wrapper {
        background: #fff;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        padding: 1.5rem 1rem;
        margin-bottom: 1.5rem;
        position: relative;
    }

    .table-loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255,255,255,0.7);
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.75rem;
        display: none;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
        color: #2563eb;
    }

    @@media (max-width: 767.98px) {
        .section-bg {
            padding: 1.2rem 0.5rem;
        }

        .section-title {
            font-size: 1.3rem;
        }

        .table-wrapper {
            padding: 0.5rem 0.2rem;
        }
    }
</style>

<div>
    <!-- Modern Centered Page Header -->
    <div class="page-header-modern">
        <h1>Claim Tracing System</h1>
        <div class="header-underline"></div>
        <span class="header-icon">
            <svg width="48" height="48" fill="none" viewBox="0 0 48 48">
                <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="3" opacity="0.2" />
                <path d="M16 24h16M24 16v16" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.3" />
            </svg>
        </span>
    </div>

    <div class="toggle-btn-group">
        <button id="btnShowBN" class="btn btn-outline-primary active" type="button">
            Search by BN
        </button>
        <button id="btnShowLotType" class="btn btn-outline-success" type="button">
            Search by LotNo &amp; Type
        </button>
        <button id="btnShowRepacking" class="btn btn-outline-warning" type="button">
            Find Repacking Data
        </button>
    </div>

    <!-- Section 1: Search by BN -->
    <section id="sectionBN" class="section-bg mx-auto mb-5" style="max-width: 100%;">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="form-card">
                    <div class="section-title mb-3">Search by <span class="text-primary">BN</span></div>
                    <form id="formBN" autocomplete="off">
                        <div class="form-group mb-3">
                            <label for="bnInput">BN</label>
                            <input type="text" class="form-control" id="bnInput" name="BN" placeholder="Enter BN" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 shadow-sm">Search</button>
                    </form>
                </div>
            </div>
            <div class="col-12">
                <div class="table-wrapper position-relative">
                    <div class="table-loading-overlay" id="tableBNLoading">
                        <div class="spinner-border" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered" id="tableBN" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>BN</th>
                                    <th>Item</th>
                                    <th>Delivery Date</th>
                                    <th>Receive Date</th>
                                    <th>Third Party Name</th>
                                    <th>Address</th>
                                    <th>Quantity</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>BN</th>
                                    <th>Item</th>
                                    <th>Delivery Date</th>
                                    <th>Receive Date</th>
                                    <th>Third Party Name</th>
                                    <th>Address</th>
                                    <th>Quantity</th>
                                </tr>
                            </tfoot>
                            <tbody>
                                <!-- Data will be loaded via AJAX -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 2: Search by LotNo & Type -->
    <section id="sectionLotType" class="section-bg mx-auto" style="max-width: 100%; display:none;">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="form-card">
                    <div class="section-title mb-3">Search by <span class="text-success">LotNo &amp; Type</span></div>
                    <form id="formLotType" autocomplete="off">
                        <div class="form-group mb-3">
                            <label for="lotNoInput">Lot No</label>
                            <input type="text" class="form-control" id="lotNoInput" name="LotNo" placeholder="Enter Lot No" required />
                        </div>
                        <div class="form-group mb-3">
                            <label for="typeInput">Type</label>
                            <input type="text" class="form-control" id="typeInput" name="Type" placeholder="Enter Type" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100 shadow-sm">Search</button>
                    </form>
                </div>
            </div>
            <div class="col-12">
                <div class="table-wrapper">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered" id="tableLotType" style="width:100%;">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Item</th>
                                    <th>Quantity</th>
                                    <th>Third Party Name</th>
                                    <th>Address</th>
                                    <th>Received Date</th>
                                    <th>Delivery Date</th>
                                    <th>Lot No</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>Item</th>
                                    <th>Quantity</th>
                                    <th>Third Party Name</th>
                                    <th>Address</th>
                                    <th>Received Date</th>
                                    <th>Delivery Date</th>
                                    <th>Lot No</th>
                                </tr>
                            </tfoot>
                            <tbody>
                                <!-- Data will be loaded via AJAX -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 3: Find Repacking Data -->
    <section id="sectionRepacking" class="section-bg mx-auto" style="max-width: 100%; display:none;">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="form-card">
                    <div class="section-title mb-3">Find <span class="text-warning">Repacking Data</span></div>
                    <form id="formRepacking" autocomplete="off">
                        <div class="form-group mb-3">
                            <label for="repackingLotNoInput">Lot No</label>
                            <input type="text" class="form-control" id="repackingLotNoInput" name="LotNo" placeholder="Enter Lot No" required />
                        </div>
                        <div class="form-group mb-3">
                            <label for="repackingTypeInput">Type</label>
                            <input type="text" class="form-control" id="repackingTypeInput" name="Type" placeholder="Enter Type" required />
                        </div>
                        <button type="submit" class="btn btn-warning w-100 shadow-sm">Search</button>
                    </form>
                </div>
            </div>
            <div class="col-12">
                <div class="table-wrapper">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered" id="tableRepacking" style="width:100%;">
                            <thead class="thead-dark">
                                <tr>
                                    <th>IC No</th>
                                    <th>From Type</th>
                                    <th>To Repack Type</th>
                                    <th>Lot No</th>
                                    <th>Quantity</th>
                                    <th>Repack Date</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>IC No</th>
                                    <th>From Type</th>
                                    <th>To Repack Type</th>
                                    <th>Lot No</th>
                                    <th>Quantity</th>
                                    <th>Repack Date</th>
                                </tr>
                            </tfoot>
                            <tbody>
                                <!-- Data will be loaded via AJAX -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- jQuery and DataTables JS CDN -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap4.min.js"></script>

@section Scripts {
    <script>
    // Helper to format .NET JSON date to yyyy-MM-dd
    function formatDotNetDate(jsonDate) {
        if (!jsonDate) return '';
        var match = /\/Date\((\d+)\)\//.exec(jsonDate);
        if (!match) return '';
        var date = new Date(parseInt(match[1]));
        var yyyy = date.getFullYear();
        var mm = ('0' + (date.getMonth() + 1)).slice(-2);
        var dd = ('0' + date.getDate()).slice(-2);
        return yyyy + '-' + mm + '-' + dd;
    }

    function formatDotNetDateId(jsonDate) {
        if (!jsonDate) return '';
        var match = /\/Date\((\d+)\)\//.exec(jsonDate);
        if (!match) return '';
        var date = new Date(parseInt(match[1]));
        var day = ('0' + date.getDate()).slice(-2);
        var monthNames = [
            'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
            'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
        ];
        var month = monthNames[date.getMonth()];
        var year = date.getFullYear();
        return day + ' ' + month + ' ' + year;
    }

    $(function () {
        // Toggle between forms
        $('#btnShowBN').on('click', function () {
            $('#sectionBN').show();
            $('#sectionLotType').hide();
            $('#sectionRepacking').hide();
            $(this).addClass('active');
            $('#btnShowLotType').removeClass('active');
            $('#btnShowRepacking').removeClass('active');
        });
        $('#btnShowLotType').on('click', function () {
            $('#sectionBN').hide();
            $('#sectionLotType').show();
            $('#sectionRepacking').hide();
            $(this).addClass('active');
            $('#btnShowBN').removeClass('active');
            $('#btnShowRepacking').removeClass('active');
            setTimeout(function () {
                tableLotType.columns.adjust().draw();
            }, 10);
        });
        $('#btnShowRepacking').on('click', function () {
            $('#sectionBN').hide();
            $('#sectionLotType').hide();
            $('#sectionRepacking').show();
            $(this).addClass('active');
            $('#btnShowBN').removeClass('active');
            $('#btnShowLotType').removeClass('active');
            setTimeout(function () {
                tableRepacking.columns.adjust().draw();
            }, 10);
        });

        // DataTables initialization for BN
        var tableBN = $('#tableBN').DataTable({
            paging: true,
            searching: true,
            info: true,
            lengthChange: true,
            pageLength: 20,
            autoWidth: false,
            scrollX: true,
            orderCellsTop: true,
            fixedHeader: true,
            columns: [
                { data: 'FScanBarcodeID' },
                { data: 'FPM' },
                { data: 'FEntryDate', render: function (data) { return formatDotNetDateId(data); } },
                { data: 'FHistorySysDateReceived', render: function (data) { return formatDotNetDateId(data); } },
                { data: 'ThirdpartyName' },
                { data: 'ThirdpartyAddress' },
                { data: 'FQtyReal' }
            ]
        });

        // DataTables initialization for LotNo & Type
        var tableLotType = $('#tableLotType').DataTable({
            paging: true,
            searching: true,
            info: true,
            lengthChange: true,
            pageLength: 10,
            autoWidth: false,
            scrollX: true,
            orderCellsTop: true,
            fixedHeader: true,
            columns: [
                { data: 'FPM' },
                { data: 'Qty' },
                { data: 'ThirdpartyName' },
                { data: 'ThirdpartyAddress' },
                { data: 'FHistorySysDateReceived'},
                { data: 'FEntryDate'},
                { data: 'LotNo' }
            ]
        });

        // DataTables initialization for Repacking
        var tableRepacking = $('#tableRepacking').DataTable({
            paging: true,
            searching: true,
            info: true,
            lengthChange: true,
            pageLength: 10,
            autoWidth: false,
            scrollX: true,
            orderCellsTop: true,
            fixedHeader: true,
            columns: [
                { data: 'FICNo' },
                { data: 'FType' },
                { data: 'FWillRepackIntoType' },
                { data: 'FLot' },
                { data: 'totalQty'},
                { data: 'FRequestDate', render: function (data) { return formatDotNetDateId(data); } }
            ]
        });

        // AJAX submit for BN with loading animation
        $('#formBN').on('submit', function (e) {
            e.preventDefault();
            var bn = $('#bnInput').val();
            $('#tableBNLoading').show();
            $.ajax({
                url: '@Url.Action("GetClaimByBN", "FinishGoodsClaim", new { area = "SCM" })',
                type: 'POST',
                data: { bn: bn },
                success: function (result) {
                    tableBN.clear().rows.add(result.data).draw();
                    $('#tableBNLoading').hide();
                },
                error: function () {
                    tableBN.clear().draw();
                    $('#tableBNLoading').hide();
                    alert('Failed to load data.');
                }
            });
        });

        // AJAX submit for LotNo & Type
        $('#formLotType').on('submit', function (e) {
            e.preventDefault();
            var lotNo = $('#lotNoInput').val();
            var type = $('#typeInput').val();
            $.ajax({
                url: '@Url.Action("GetClaimByLotNoAndType", "FinishGoodsClaim", new { area = "SCM" })',
                type: 'POST',
                data: { lotNo: lotNo, type: type },
                success: function (result) {
                    tableLotType.clear().rows.add(result.data).draw();
                },
                error: function () {
                    tableLotType.clear().draw();
                    alert('Failed to load data.');
                }
            });
        });

        // AJAX submit for Repacking
        $('#formRepacking').on('submit', function (e) {
            e.preventDefault();
            var lotNo = $('#repackingLotNoInput').val();
            var type = $('#repackingTypeInput').val();
            $.ajax({
                url: '@Url.Action("GetRepackingData", "FinishGoodsClaim", new { area = "SCM" })',
                type: 'POST',
                data: { lotNo: lotNo, type: type },
                success: function (result) {
                    tableRepacking.clear().rows.add(result.data).draw();
                },
                error: function () {
                    tableRepacking.clear().draw();
                    alert('Failed to load data.');
                }
            });
        });
    });
    </script>
}