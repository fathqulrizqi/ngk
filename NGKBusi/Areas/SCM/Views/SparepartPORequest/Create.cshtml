@model NGKBusi.Areas.SCM.Models.SCM_Sparepart_PO_Request_Header
@{
    ViewBag.Title = "Create Sparepart PO Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isEdit = Model.ID > 0;
}

<!-- Tailwind Play CDN -->
<script src="https://cdn.tailwindcss.com"></script>
<!-- SweetAlert2 CSS and JS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<!-- Select2 CSS and JS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    primary: {
                        50: '#f0f9ff',
                        100: '#e0f2fe',
                        500: '#0284c7',
                        600: '#0369a1',
                        700: '#1d4ed8',
                        800: '#1e40af'
                    }
                }
            }
        }
    }
</script>

<style>
    /* Select2 Tailwind Custom Styles */
    .select2-container .select2-selection--single {
        height: 48px !important;
        border-radius: 0.5rem !important;
        border-color: #cbd5e1 !important;
        display: flex;
        align-items: center;
        width: 100% !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #1e293b !important;
        font-size: 0.875rem !important;
        padding-left: 0.75rem !important;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 48px !important;
        right: 10px !important;
    }
    
    /* Multiple Selection Styling to match standard inputs */
    .select2-container .select2-selection--multiple {
        min-height: 48px !important;
        border-radius: 0.5rem !important;
        border-color: #cbd5e1 !important;
        display: flex !important;
        align-items: center !important;
        flex-wrap: wrap !important;
        width: 100% !important;
        padding: 4px 8px !important;
        background-color: #ffffff !important;
    }
    .select2-container--default.select2-container--focus .select2-selection--multiple {
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.5) !important;
        outline: none !important;
    }
    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background-color: #eff6ff !important;
        border: 1px solid #bfdbfe !important;
        color: #1e3a8a !important;
        border-radius: 0.375rem !important;
        padding: 4px 8px !important;
        margin-top: 2px !important;
        margin-bottom: 2px !important;
        font-size: 0.875rem !important;
        font-weight: 500 !important;
        display: inline-flex !important;
        align-items: center !important;
    }
    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        position: static !important;
        float: none !important;
        color: #ef4444 !important;
        margin-right: 6px !important;
        border: none !important;
        background: transparent !important;
        font-weight: bold !important;
        cursor: pointer !important;
    }
    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
        background-color: #fee2e2 !important;
        color: #b91c1c !important;
        border-radius: 0.25rem !important;
    }
    .select2-container--default .select2-selection--multiple .select2-search--inline .select2-search__field {
        margin-top: 0 !important;
        height: 32px !important;
        line-height: 32px !important;
        font-size: 0.875rem !important;
        font-family: inherit !important;
    }

    .select2-dropdown {
        border-radius: 0.5rem !important;
        border-color: #cbd5e1 !important;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
        z-index: 9999 !important;
    }
    .select2-container--default .select2-results__option--highlighted[aria-selected] {
        background-color: #2563eb !important;
    }
    .select2-container {
        width: 100% !important;
    }
</style>

<div class="w-full p-6">
    <!-- Back Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">
                @(isEdit ? "Edit Draft Request" : "New Sparepart PO Request")
            </h1>
            <p class="text-sm text-slate-500 mt-1">Isi form di bawah untuk membuat permintaan PO sparepart import.</p>
        </div>
        <a href="@Url.Action("Index", "SparepartPORequest", new { area = "SCM" })" 
           class="inline-flex items-center px-4  py-2 text-sm font-semibold text-slate-600 bg-white border border-slate-300 rounded-lg shadow-sm hover:bg-slate-50 transition duration-150">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Kembali ke Daftar
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-lg text-red-700 text-sm font-medium">
            @TempData["Error"]
        </div>
    }

    <!-- Form Container -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden">
        <form action="@Url.Action("Create", "SparepartPORequest", new { area = "SCM" })" method="post" enctype="multipart/form-data" id="requestForm" class="p-8 space-y-8">
            @Html.AntiForgeryToken()
            @if (isEdit)
            {
                <input type="hidden" name="ID" value="@Model.ID" />
            }

            <!-- Section 1: General Info -->
            <div>
                <h3 class="text-lg font-bold text-slate-700 mb-4 border-b border-slate-100 pb-2">Informasi Umum</h3>
                
                <!-- Category Selector (Interactive Cards) -->
                <div class="mb-6">
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        Kategori Pengajuan (Request Category) <span class="text-red-500">*</span>
                    </label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Regular Option -->
                        <label class="category-card relative flex items-start p-4 rounded-xl border-2 cursor-pointer transition-all duration-200 @(string.IsNullOrEmpty(Model.Category) || Model.Category == "Regular" ? "border-blue-500 bg-blue-50/40 shadow-sm" : "border-slate-200 bg-white hover:border-slate-300")">
                            <input type="radio" name="Category" value="Regular" class="sr-only" @(string.IsNullOrEmpty(Model.Category) || Model.Category == "Regular" ? "checked" : "") onchange="handleCategoryChange()" />
                            <div class="p-2.5 rounded-lg mr-3.5 flex-shrink-0 transition-colors @(string.IsNullOrEmpty(Model.Category) || Model.Category == "Regular" ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-500") category-icon">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                            </div>
                            <div class="flex-grow">
                                <div class="flex items-center justify-between">
                                    <span class="font-bold text-sm text-slate-800">Regular</span>
                                    <span class="category-badge text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full @(string.IsNullOrEmpty(Model.Category) || Model.Category == "Regular" ? "bg-blue-100 text-blue-700" : "bg-slate-100 text-slate-500")">Consumables / Operasional</span>
                                </div>
                                <p class="text-xs text-slate-500 mt-1">Pengadaan sparepart rutin untuk perawatan atau pemeliharaan operasional standar pabrik.</p>
                            </div>
                        </label>

                        <!-- Project Option -->
                        <label class="category-card relative flex items-start p-4 rounded-xl border-2 cursor-pointer transition-all duration-200 @(Model.Category == "Project" ? "border-indigo-500 bg-indigo-50/40 shadow-sm" : "border-slate-200 bg-white hover:border-slate-300")">
                            <input type="radio" name="Category" value="Project" class="sr-only" @(Model.Category == "Project" ? "checked" : "") onchange="handleCategoryChange()" />
                            <div class="p-2.5 rounded-lg mr-3.5 flex-shrink-0 transition-colors @(Model.Category == "Project" ? "bg-indigo-600 text-white" : "bg-slate-100 text-slate-500") category-icon">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            </div>
                            <div class="flex-grow">
                                <div class="flex items-center justify-between">
                                    <span class="font-bold text-sm text-slate-800">Project</span>
                                    <span class="category-badge text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full @(Model.Category == "Project" ? "bg-indigo-100 text-indigo-700" : "bg-slate-100 text-slate-500")">Khusus / Improvement</span>
                                </div>
                                <p class="text-xs text-slate-500 mt-1">Pengadaan sparepart khusus untuk kebutuhan project baru, instalasi mesin, atau modifikasi kustom.</p>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-600 mb-2">Title / Judul Request <span class="text-red-500">*</span></label>
                        <input type="text" name="Title" value="@Model.Title" required placeholder="Contoh: Permintaan Sparepart Caulking Cope BK"
                               class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-slate-800" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-600 mb-2">Target Department (Penerima Info) <span class="text-red-500">*</span></label>
                        <select name="TargetDepartment" id="TargetDepartment" multiple="multiple"
                                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-slate-800 bg-white">
                            @foreach (var dept in (List<System.Web.Mvc.SelectListItem>)ViewBag.Departments)
                            {
                                <option value="@dept.Value" @(Model.TargetDepartment != null && Model.TargetDepartment.Split(',').Contains(dept.Value) ? "selected" : "")>@dept.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Section 2: Excel Upload & Preview -->
            <div>
                <div class="flex flex-wrap items-center justify-between border-b border-slate-100 pb-2 mb-4 gap-2">
                    <h3 class="text-lg font-bold text-slate-700">Upload Data Item (File Excel)</h3>
                    <a href="@Url.Action("DownloadTemplate", "SparepartPORequest", new { area = "SCM" })" 
                       class="inline-flex items-center px-3 py-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-lg transition shadow-sm"
                       title="Download format file Excel template">
                        <svg class="w-4 h-4 mr-1.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Download Template Excel
                    </a>
                </div>
                <div class="space-y-4">
                    <div class="flex items-center space-x-4">
                        <div class="flex-grow">
                            <input type="hidden" name="ClearExistingExcel" id="ClearExistingExcel" value="false" />
                            <input type="file" id="excelFile" name="excelFile" accept=".xlsx, .xls"
                                   class="w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 border border-slate-300 rounded-lg p-1.5 bg-slate-50 transition" />
                        </div>
                        <button type="button" id="btnClearExcel" class="@(isEdit && Model.Details != null && Model.Details.Any() ? "" : "hidden") px-4 py-2.5 bg-rose-50 text-rose-600 border border-rose-200 hover:bg-rose-100 font-semibold text-sm rounded-lg transition duration-150">
                            Clear Excel
                        </button>
                    </div>
                    <p class="text-xs text-slate-400">Dimulai dari kolom nomor di A7, Partname di B7, Machine Number di E7, Ax_ItemID di F7, Maker di G7, Quantity di H7, Dimensi di I7, Machine di J7, Drawing No di K7, DRAWING NO KANRIKOGU di L7, LEAD TIME di M7, ETA di N7.</p>

                    <!-- Preview Table Container -->
                    <div id="previewContainer" class="@(isEdit && Model.Details != null && Model.Details.Any() ? "" : "hidden") border border-slate-200 rounded-xl overflow-hidden mt-6 bg-slate-50">
                        <div class="p-4 bg-slate-100 border-b border-slate-200 flex justify-between items-center">
                            <span class="font-bold text-sm text-slate-700">Preview Data Item dari Excel</span>
                            <span id="previewCount" class="px-2.5 py-1 text-xs font-semibold bg-blue-100 text-blue-800 rounded-full">@(isEdit && Model.Details != null ? Model.Details.Count : 0) Item</span>
                        </div>
                        <div class="overflow-x-auto max-h-[350px]">
                            <table class="w-full text-left text-xs border-collapse">
                                <thead>
                                    <tr class="bg-slate-200 text-slate-600 font-semibold border-b border-slate-300 sticky top-0">
                                        <th class="p-3">No</th>
                                        <th class="p-3">Part Name</th>
                                        <th class="p-3">Machine Number</th>
                                        <th class="p-3">Ax Item ID</th>
                                        <th class="p-3">Maker</th>
                                        <th class="p-3">Qty</th>
                                        <th class="p-3">Dimensi</th>
                                        <th class="p-3">Machine</th>
                                        <th class="p-3">Drawing No</th>
                                        <th class="p-3">Drawing No Kanrikogu</th>
                                        <th class="p-3">Lead Time</th>
                                        <th class="p-3">ETA</th>
                                    </tr>
                                </thead>
                                <tbody id="previewBody" class="divide-y divide-slate-200 bg-white">
                                    @if (isEdit && Model.Details != null && Model.Details.Any())
                                    {
                                        foreach (var detail in Model.Details.OrderBy(d => d.No))
                                        {
                                            <tr>
                                                <td class="p-3">@detail.No</td>
                                                <td class="p-3">@detail.PartName</td>
                                                <td class="p-3">@detail.MachineNumber</td>
                                                <td class="p-3">@detail.AxItemID</td>
                                                <td class="p-3">@detail.Maker</td>
                                                <td class="p-3">@(detail.Quantity.HasValue ? detail.Quantity.Value.ToString("G29") : "0")</td>
                                                <td class="p-3">@detail.Dimensi</td>
                                                <td class="p-3">@detail.Machine</td>
                                                <td class="p-3">@detail.DrawingNo</td>
                                                <td class="p-3">@detail.DrawingNoKanrikogu</td>
                                                <td class="p-3">@detail.LeadTime</td>
                                                <td class="p-3">@(detail.ETA.HasValue ? detail.ETA.Value.ToString("dd MMM yyyy") : "-")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 3: Multiple Attachments -->
            <div>
                <h3 class="text-lg font-bold text-slate-700 mb-4 border-b border-slate-100 pb-2">Upload Multiple Attachments</h3>
                <div>
                    <label class="block text-sm font-semibold text-slate-600 mb-2">Pilih File (PDF, Image, Excel, Word) - <span class="text-slate-400 font-normal">Opsional</span></label>
                    <input type="file" id="attachmentInput" name="attachments" multiple accept=".pdf, .png, .jpg, .jpeg, .xlsx, .xls, .doc, .docx"
                           class="w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 border border-slate-300 rounded-lg p-1.5 bg-slate-50 transition" />
                    <div id="attachmentChips" class="flex flex-wrap gap-2 mt-3"></div>
                    
                    @if (isEdit && Model.Attachments != null && Model.Attachments.Any())
                    {
                        <div class="mt-3">
                            <span class="text-xs font-semibold text-slate-500">Attachment Sebelumnya:</span>
                            <div class="flex flex-wrap gap-2 mt-2">
                                @foreach (var att in Model.Attachments)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">
                                        @att.FileName
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Section 4: Email Reminder Settings -->
            <div>
                <h3 class="text-lg font-bold text-slate-700 mb-4 border-b border-slate-100 pb-2">Pengaturan Email Reminder</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-600 mb-2">Kapan Dikirim (H+ Hari) <span class="text-red-500">*</span></label>
                        <input type="number" name="ReminderDaysAfter" min="1" value="@(Model.ReminderDaysAfter > 0 ? Model.ReminderDaysAfter : 1)"
                               class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-slate-800" />
                        <span class="text-[10px] text-slate-400 mt-1 block">Jumlah hari setelah tanggal task diterima approver.</span>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-600 mb-2">Jam Pengiriman (WIB) <span class="text-red-500">*</span></label>
                        <select name="ReminderSendTime" id="ReminderSendTime"
                                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-slate-800 bg-white">
                            @for (int hour = 7; hour <= 18; hour++)
                            {
                                int currentHour = Model.ReminderSendTime > 0 ? Model.ReminderSendTime : 8;
                                <option value="@hour" @(currentHour == hour ? "selected" : "")>Pukul @hour.ToString("D2"):00 WIB</option>
                            }
                        </select>
                        <span class="text-[10px] text-slate-400 mt-1 block">Jam eksekusi email reminder dikirimkan.</span>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-600 mb-2 flex items-center">
                            <input type="checkbox" id="IsReminderRepeated" name="IsReminderRepeated" value="true" @(Model.IsReminderRepeated ? "checked" : "") class="mr-2 rounded text-blue-600 focus:ring-blue-500 h-4 w-4" />
                            Kirim Secara Berulang
                        </label>
                        <div id="repeatIntervalContainer" class="mt-2 @(Model.IsReminderRepeated ? "" : "hidden")">
                            <select name="ReminderRepeatInterval" id="ReminderRepeatInterval"
                                    class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-slate-800 bg-white">
                                <option value="Daily" @(Model.ReminderRepeatInterval == "Daily" ? "selected" : "")>Setiap Hari (Daily)</option>
                                <option value="Weekly" @(Model.ReminderRepeatInterval == "Weekly" ? "selected" : "")>Setiap Minggu (Weekly)</option>
                                <option value="Custom" @(Model.ReminderRepeatInterval == "Custom" ? "selected" : "")>Kustom (X Hari)</option>
                            </select>
                        </div>
                    </div>
                    <div id="customDaysContainer" class="@(Model.IsReminderRepeated && Model.ReminderRepeatInterval == "Custom" ? "" : "hidden")">
                        <label class="block text-sm font-semibold text-slate-600 mb-2">Ulangi Setiap (Hari) <span class="text-red-500">*</span></label>
                        <input type="number" name="ReminderCustomDays" id="ReminderCustomDays" min="1" value="@Model.ReminderCustomDays"
                               class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition text-slate-800" />
                    </div>
                </div>
            </div>

            <!-- Footer Buttons -->
            <div class="flex justify-end items-center space-x-4 border-t border-slate-100 pt-6">
                <input type="hidden" name="submitType" id="submitType" value="Submit" />
                
                <button type="submit" onclick="setSubmitType('Draft')"
                        class="px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-lg shadow-sm border border-slate-200 transition duration-150">
                    Save as Draft
                </button>
                <button type="submit" onclick="setSubmitType('Submit')"
                        class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg shadow-md hover:shadow-lg transition duration-150">
                    Submit Request
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function setSubmitType(type) {
        document.getElementById('submitType').value = type;
    }

    $(document).ready(function () {
        // Initialize Select2 Search
        $('#TargetDepartment').select2({
            placeholder: "-- Pilih Departemen --",
            allowClear: true
        });

        // Add modern SweetAlert2 confirm only for final submit action
        $('#requestForm').on('click', 'button[type="submit"][onclick*="setSubmitType(\'Submit\')"]', function (e) {
            e.preventDefault();
            setSubmitType('Submit');

            const submitButton = this;
            Swal.fire({
                title: 'Submit PO Request?',
                html: '<div class="text-sm text-slate-600">Apakah Anda yakin ingin mengirim permintaan PO sparepart ini?</div>',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Ya, Submit',
                cancelButtonText: 'Batal',
                reverseButtons: true,
                allowOutsideClick: false,
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#64748b',
                customClass: {
                    popup: 'rounded-2xl shadow-2xl border border-slate-100',
                    title: 'font-bold text-slate-800',
                    confirmButton: 'rounded-lg px-5 py-2 font-bold',
                    cancelButton: 'rounded-lg px-5 py-2 font-bold'
                },
                didOpen: function () {
                    $('.swal2-popup').attr('data-theme', 'modern');
                }
            }).then(function (result) {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Mengirim Request...',
                        html: '<div class="flex items-center justify-center gap-2 text-sm font-semibold text-slate-600"><span class="animate-spin inline-block h-5 w-5 rounded-full border-2 border-blue-500 border-t-transparent"></span>Mohon tunggu, proses sedang berjalan.</div>',
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        showConfirmButton: false,
                        didOpen: function () {
                            $('.swal2-popup').attr('data-theme', 'modern');
                        }
                    });

                    $(submitButton).closest('form').off('submit').submit();
                }
            });
        });

        // Form submit validation
        $('#requestForm').submit(function (e) {
            var submitType = $('#submitType').val();
            var errors = [];
            
            var title = $('input[name="Title"]').val().trim();
            if (!title) {
                errors.push("Title / Judul Request wajib diisi.");
            }
            
            if (submitType === 'Submit') {
                var depts = $('#TargetDepartment').val();
                if (!depts || depts.length === 0) {
                    errors.push("Target Department wajib dipilih minimal 1.");
                }
                
                var excelInput = $('#excelFile')[0];
                var hasExcelFile = excelInput && excelInput.files && excelInput.files.length > 0;
                var hasExistingDetails = @(isEdit && Model.Details != null && Model.Details.Any() ? "true" : "false");
                if (!hasExcelFile && !hasExistingDetails) {
                    errors.push("File Excel berisi data item wajib diunggah.");
                }
                
                var reminderDays = $('input[name="ReminderDaysAfter"]').val();
                if (!reminderDays || parseInt(reminderDays) < 1) {
                    errors.push("Kapan email reminder dikirim (H+ Hari) wajib diset minimal 1 hari.");
                }

                var isRepeated = $('#IsReminderRepeated').is(':checked');
                var repeatInterval = $('#ReminderRepeatInterval').val();
                var customDays = $('#ReminderCustomDays').val();
                if (isRepeated && repeatInterval === 'Custom' && (!customDays || parseInt(customDays) < 1)) {
                    errors.push("Ulangi Setiap (Hari) wajib diset minimal 1 hari jika interval Kustom.");
                }
            }

            if (errors.length > 0) {
                e.preventDefault();
                
                var alertHtml = '<div id="submitErrors" class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-lg text-red-700 text-sm font-medium space-y-1">';
                alertHtml += '<p class="font-bold text-base mb-1">' + (submitType === 'Submit' ? 'Pengajuan tidak dapat disubmit karena:' : 'Draft tidak dapat disimpan karena:') + '</p>';
                $.each(errors, function (i, error) {
                    alertHtml += '<p>• ' + error + '</p>';
                });
                alertHtml += '</div>';
                
                $('#submitErrors').remove();
                $('#requestForm').prepend(alertHtml);
                
                $('html, body').animate({
                    scrollTop: $('#requestForm').offset().top - 100
                }, 300);
                return false;
            }
        });

        // Toggle reminder settings
        $('#IsReminderRepeated').change(function () {
            if ($(this).is(':checked')) {
                $('#repeatIntervalContainer').removeClass('hidden');
                triggerIntervalCheck();
            } else {
                $('#repeatIntervalContainer').addClass('hidden');
                $('#customDaysContainer').addClass('hidden');
            }
        });

        $('#ReminderRepeatInterval').change(function () {
            triggerIntervalCheck();
        });

        function triggerIntervalCheck() {
            var val = $('#ReminderRepeatInterval').val();
            if (val === 'Custom') {
                $('#customDaysContainer').removeClass('hidden');
            } else {
                $('#customDaysContainer').addClass('hidden');
            }
        }

        // Live Excel preview parsing via AJAX
        $('#excelFile').change(function () {
            var fileInput = this;
            if (fileInput.files.length === 0) {
                clearPreview();
                return;
            }
            $('#ClearExistingExcel').val('false');

            var formData = new FormData();
            formData.append("excelFile", fileInput.files[0]);

            $('#previewBody').html('<tr><td colspan="12" class="p-4 text-center text-slate-500 font-medium">Memparsing data Excel, mohon tunggu...</td></tr>');
            $('#previewContainer').removeClass('hidden');
            $('#btnClearExcel').removeClass('hidden');

            $.ajax({
                url: '@Url.Action("PreviewExcel", "SparepartPORequest", new { area = "SCM" })',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        $('#previewBody').empty();
                        $('#previewCount').text(res.items.length + " Item");
                        
                        if (res.items.length === 0) {
                            $('#previewBody').html('<tr><td colspan="12" class="p-4 text-center text-slate-400">Tidak ada item yang ditemukan mulai baris 7.</td></tr>');
                            return;
                        }

                        $.each(res.items, function (index, item) {
                            var rowHtml = '<tr>' +
                                '<td class="p-3 text-slate-600 border-b border-slate-200">' + (item.No || '') + '</td>' +
                                '<td class="p-3 text-slate-800 font-medium border-b border-slate-200">' + (item.PartName || '') + '</td>' +
                                '<td class="p-3 text-slate-600 border-b border-slate-200">' + (item.MachineNumber || '') + '</td>' +
                                '<td class="p-3 text-slate-600 font-mono border-b border-slate-200">' + (item.AxItemID || '') + '</td>' +
                                '<td class="p-3 text-slate-600 border-b border-slate-200">' + (item.Maker || '') + '</td>' +
                                '<td class="p-3 text-slate-800 font-semibold border-b border-slate-200">' + (item.Quantity || 0) + '</td>' +
                                '<td class="p-3 text-slate-600 border-b border-slate-200">' + (item.Dimensi || '') + '</td>' +
                                '<td class="p-3 text-slate-600 border-b border-slate-200">' + (item.Machine || '') + '</td>' +
                                '<td class="p-3 text-slate-600 border-b border-slate-200">' + (item.DrawingNo || '') + '</td>' +
                                '<td class="p-3 text-slate-600 border-b border-slate-200">' + (item.DrawingNoKanrikogu || '') + '</td>' +
                                '<td class="p-3 text-slate-600 border-b border-slate-200">' + (item.LeadTime || '') + '</td>' +
                                '<td class="p-3 text-slate-600 border-b border-slate-200">' + (item.ETA || '') + '</td>' +
                                '</tr>';
                            $('#previewBody').append(rowHtml);
                        });
                    } else {
                        $('#previewBody').html('<tr><td colspan="12" class="p-4 text-center text-rose-500 font-semibold">Error: ' + res.message + '</td></tr>');
                    }
                },
                error: function () {
                    $('#previewBody').html('<tr><td colspan="12" class="p-4 text-center text-rose-500 font-semibold">Error: Gagal menghubungi server.</td></tr>');
                }
            });
        });

        $('#btnClearExcel').click(function () {
            clearPreview();
        });

        // Live attachment chips preview (PDF, Image, Word, Excel)
        $('#attachmentInput').change(function () {
            var files = this.files;
            var container = $('#attachmentChips');
            container.empty();

            for (var i = 0; i < files.length; i++) {
                var file = files[i];
                var fileUrl = URL.createObjectURL(file);
                var ext = file.name.split('.').pop().toLowerCase();

                // Icon selection
                var icon = '<svg class="w-4 h-4 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>';
                if (ext === 'pdf') {
                    icon = '<svg class="w-4 h-4 mr-1.5 text-rose-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9 2a2 2 0 00-2 2v8a2 2 0 002 2h3a2 2 0 002-2V8l-4-4H9z"></path></svg>';
                } else if (['jpg', 'jpeg', 'png', 'gif'].indexOf(ext) >= 0) {
                    icon = '<svg class="w-4 h-4 mr-1.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path></svg>';
                } else if (['xlsx', 'xls'].indexOf(ext) >= 0) {
                    icon = '<svg class="w-4 h-4 mr-1.5 text-teal-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm2 10a1 1 0 10-2 0v2a1 1 0 102 0v-2zm3-3a1 1 0 011 1v4a1 1 0 11-2 0v-4a1 1 0 011-1z" clip-rule="evenodd"></path></svg>';
                } else if (['doc', 'docx'].indexOf(ext) >= 0) {
                    icon = '<svg class="w-4 h-4 mr-1.5 text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path d="M9 2a2 2 0 00-2 2v8a2 2 0 002 2h3a2 2 0 002-2V8l-4-4H9z"></path></svg>';
                }

                var chipHtml = '<a href="' + fileUrl + '" target="_blank" class="inline-flex items-center px-3 py-1.5 bg-slate-50 border border-slate-200 text-slate-700 hover:bg-blue-50 hover:text-blue-600 hover:border-blue-200 text-xs font-semibold rounded-lg shadow-sm transition duration-150">' +
                    icon +
                    '<span class="truncate max-w-[150px]">' + file.name + '</span>' +
                    '</a>';
                
                container.append(chipHtml);
            }
        });

        function clearPreview() {
            $('#excelFile').val('');
            $('#ClearExistingExcel').val('true');
            $('#previewBody').empty();
            $('#previewContainer').addClass('hidden');
            $('#btnClearExcel').addClass('hidden');
            $('#previewCount').text("0 Item");
        }
    });

    function handleCategoryChange() {
        $('input[name="Category"]').each(function() {
            var card = $(this).closest('.category-card');
            var icon = card.find('.category-icon');
            var badge = card.find('.category-badge');
            var val = $(this).val();

            if ($(this).is(':checked')) {
                if (val === 'Project') {
                    card.removeClass('border-slate-200 bg-white hover:border-slate-300')
                        .addClass('border-indigo-500 bg-indigo-50/40 shadow-sm');
                    icon.removeClass('bg-slate-100 text-slate-500').addClass('bg-indigo-600 text-white');
                    badge.removeClass('bg-slate-100 text-slate-500').addClass('bg-indigo-100 text-indigo-700');
                } else {
                    card.removeClass('border-slate-200 bg-white hover:border-slate-300')
                        .addClass('border-blue-500 bg-blue-50/40 shadow-sm');
                    icon.removeClass('bg-slate-100 text-slate-500').addClass('bg-blue-600 text-white');
                    badge.removeClass('bg-slate-100 text-slate-500').addClass('bg-blue-100 text-blue-700');
                }
            } else {
                card.removeClass('border-blue-500 bg-blue-50/40 border-indigo-500 bg-indigo-50/40 shadow-sm')
                    .addClass('border-slate-200 bg-white hover:border-slate-300');
                icon.removeClass('bg-blue-600 bg-indigo-600 text-white').addClass('bg-slate-100 text-slate-500');
                badge.removeClass('bg-blue-100 text-blue-700 bg-indigo-100 text-indigo-700').addClass('bg-slate-100 text-slate-500');
            }
        });
    }
</script>
