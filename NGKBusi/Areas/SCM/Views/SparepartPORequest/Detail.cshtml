@model NGKBusi.Areas.SCM.Models.SCM_Sparepart_PO_Request_Header
@{
    ViewBag.Title = "Request Details & Approval";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isApproverActive = ViewBag.IsApproverActive ?? false;
    var approvalFlow = ViewBag.ApprovalFlow as List<NGKBusi.Areas.SCM.Models.SCM_Sparepart_PO_Approval_Flow_Item>;
}

<!-- Google Font: Outfit, SweetAlert2 & Tailwind Play CDN -->
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;850&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="w-full p-6 font-['Outfit',sans-serif]">
    <!-- Back Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <span class="text-xs font-bold text-blue-600 uppercase tracking-wider">SCM Area</span>
            <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight mt-1">Detail Permintaan PO</h1>
        </div>
        <a href="@Url.Action("Index", "SparepartPORequest", new { area = "SCM" })" 
           class="inline-flex items-center px-4 py-2 text-sm font-semibold text-slate-600 bg-white border border-slate-300 rounded-lg shadow-sm hover:bg-slate-50 transition duration-150">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Kembali ke Daftar
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 bg-emerald-50 border-l-4 border-emerald-500 rounded-r-lg text-emerald-700 text-sm font-medium">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-lg text-red-700 text-sm font-medium">
            @TempData["Error"]
        </div>
    }

    <!-- Status Banner for Rejected Requests -->
    @if (Model.Status == "Rejected")
    {
        <div class="mb-6 bg-rose-50 border border-rose-200 rounded-2xl p-6 flex items-start space-x-4">
            <div class="p-3 bg-rose-100 text-rose-600 rounded-xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <div>
                <h4 class="font-bold text-rose-800 text-lg">Permintaan Ditolak (Rejected)</h4>
                <p class="text-sm text-rose-600 mt-1"><strong>Alasan Penolakan:</strong> @(string.IsNullOrEmpty(Model.RejectReason) ? "Tidak ditentukan" : Model.RejectReason)</p>
            </div>
        </div>
    }

    <!-- Main Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left 2 Columns: Request Details & Items -->
        <div class="lg:col-span-2 space-y-8">
            
            <!-- Detail Card -->
            <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-6 space-y-6">
                <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-800 tracking-tight">@Model.Title</h2>
                        <div class="flex flex-wrap items-center gap-2 mt-2">
                            <span class="text-xs font-mono font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-md border border-blue-100 inline-block shadow-sm">
                                # @Model.RequestNo
                            </span>
                            @if (Model.Category == "Project")
                            {
                                <span class="text-xs font-bold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-md border border-indigo-200 inline-flex items-center shadow-sm">
                                    <svg class="w-3.5 h-3.5 mr-1 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                                    Project
                                </span>
                            }
                            else
                            {
                                <span class="text-xs font-bold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md border border-blue-200 inline-flex items-center shadow-sm">
                                    <svg class="w-3.5 h-3.5 mr-1 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                                    Regular
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(Model.PONumber))
                            {
                                <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200 inline-flex items-center shadow-sm">
                                    <svg class="w-3.5 h-3.5 mr-1 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    PO: @Model.PONumber
                                </span>
                            }
                        </div>
                    </div>
                    <div>
                        @if (Model.Status == "Draft")
                        {
                            <span class="px-3 py-1.5 text-xs font-semibold bg-slate-100 text-slate-650 rounded-full border border-slate-200 shadow-sm">Draft</span>
                        }
                        else if (Model.Status == "Pending Approval")
                        {
                            <span class="px-3 py-1.5 text-xs font-semibold bg-amber-50 text-amber-700 rounded-full border border-amber-200 shadow-sm">Pending Approval</span>
                        }
                        else if (Model.Status == "Completed" || Model.Status == "Approved")
                        {
                            <span class="px-3 py-1.5 text-xs font-semibold bg-emerald-50 text-emerald-700 rounded-full border border-emerald-200 shadow-sm">Completed</span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="px-3 py-1.5 text-xs font-semibold bg-rose-50 text-rose-700 rounded-full border border-rose-200 shadow-sm">Rejected</span>
                        }
                    </div>
                </div>

                <!-- Structured 5-Column Metadata Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
                    <!-- Category Card -->
                    <div class="p-4 bg-slate-50/75 border border-slate-100 rounded-xl flex items-center space-x-3.5 shadow-sm">
                        <div class="p-2.5 @(Model.Category == "Project" ? "bg-indigo-50 text-indigo-600" : "bg-blue-50 text-blue-600") rounded-lg">
                            @if (Model.Category == "Project")
                            {
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            }
                            else
                            {
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                            }
                        </div>
                        <div>
                            <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Kategori</span>
                            <span class="text-xs font-bold @(Model.Category == "Project" ? "text-indigo-700" : "text-blue-700") block mt-0.5">
                                @(string.IsNullOrEmpty(Model.Category) ? "Regular" : Model.Category)
                            </span>
                            <span class="text-[10px] text-slate-500 block">
                                @(Model.Category == "Project" ? "Khusus / Project" : "Rutin / Operasional")
                            </span>
                        </div>
                    </div>

                    <!-- Requester Card -->
                    <div class="p-4 bg-slate-50/75 border border-slate-100 rounded-xl flex items-center space-x-3.5 shadow-sm">
                        <div class="p-2.5 bg-blue-50 text-blue-600 rounded-lg">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        </div>
                        <div class="overflow-hidden">
                            <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Pemohon (Requester)</span>
                            <span class="text-xs font-bold text-slate-700 block truncate mt-0.5" title="@ViewBag.RequesterName">@ViewBag.RequesterName</span>
                            <span class="text-[10px] font-mono text-slate-500 block">@Model.RequesterNIK</span>
                        </div>
                    </div>

                    <!-- Target Department Card -->
                    <div class="p-4 bg-slate-50/75 border border-slate-100 rounded-xl flex items-start space-x-3.5 shadow-sm col-span-1">
                        <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-lg mt-0.5">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                        </div>
                        <div class="flex-grow overflow-hidden">
                            <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider mb-1">Target Departemen</span>
                            <div class="flex flex-wrap gap-1 max-h-[44px] overflow-y-auto pr-1">
                                @if (ViewBag.TargetDepartmentNames != null)
                                {
                                    foreach (var name in ((string)ViewBag.TargetDepartmentNames).Split(new[] { ", " }, StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100/50">
                                            @name
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400 font-bold">-</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Created Date Card -->
                    <div class="p-4 bg-slate-50/75 border border-slate-100 rounded-xl flex items-center space-x-3.5 shadow-sm">
                        <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-lg">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        </div>
                        <div>
                            <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Tanggal Pengajuan</span>
                            <span class="text-xs font-bold text-slate-700 block mt-0.5">@Model.CreatedDate.ToString("dd MMM yyyy")</span>
                            <span class="text-[10px] text-slate-500 block">Pukul @Model.CreatedDate.ToString("HH:mm")</span>
                        </div>
                    </div>

                    <!-- Last Approval Date Card -->
                    <div class="p-4 bg-slate-50/75 border border-slate-100 rounded-xl flex items-center space-x-3.5 shadow-sm">
                        <div class="p-2.5 bg-amber-50 text-amber-655 rounded-lg">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <div>
                            <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Approval Akhir</span>
                            @if (Model.LastApprovalDate.HasValue)
                            {
                                <span class="text-xs font-bold text-slate-700 block mt-0.5">@Model.LastApprovalDate.Value.ToString("dd MMM yyyy")</span>
                                <span class="text-[10px] text-slate-500 block">Pukul @Model.LastApprovalDate.Value.ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="text-xs font-bold text-slate-400 block mt-0.5">-</span>
                                <span class="text-[10px] text-slate-400 block">Belum disetujui</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items Table Card -->
            <div class="bg-white rounded-2xl shadow-lg border border-slate-100 overflow-hidden">
                <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
                    <h3 class="font-bold text-slate-800 text-base">Daftar Item Barang PO</h3>
                    <span class="px-2.5 py-1 text-xs font-semibold bg-blue-100 text-blue-800 rounded-full">@(Model.Details != null ? Model.Details.Count : 0) Item</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="bg-slate-100 text-slate-600 font-semibold border-b border-slate-200">
                                <th class="p-3 pl-5">No</th>
                                <th class="p-3">Part Name</th>
                                <th class="p-3">Machine Number</th>
                                <th class="p-3">Ax Item ID</th>
                                <th class="p-3">Maker</th>
                                <th class="p-3">Qty</th>
                                <th class="p-3">Dimensi</th>
                                <th class="p-3">Machine</th>
                                <th class="p-3">Drawing No</th>
                                <th class="p-3">Drawing No Kanrikogu</th>
                                <th class="p-3">Lead Time</th>
                                <th class="p-3 pr-5">ETA</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (Model.Details == null || !Model.Details.Any())
                            {
                                <tr>
                                    <td colspan="12" class="p-8 text-center text-slate-400 font-medium">Tidak ada rincian item barang.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Details)
                                {
                                    <tr class="hover:bg-slate-50/50 transition">
                                        <td class="p-3 pl-5 text-slate-500">@item.No</td>
                                        <td class="p-3 font-semibold text-slate-800">@item.PartName</td>
                                        <td class="p-3 text-slate-600">@item.MachineNumber</td>
                                        <td class="p-3 font-mono text-slate-600">@item.AxItemID</td>
                                        <td class="p-3 text-slate-600">@item.Maker</td>
                                        <td class="p-3 font-bold text-slate-800">@item.Quantity</td>
                                        <td class="p-3 text-slate-600">@item.Dimensi</td>
                                        <td class="p-3 text-slate-600">@item.Machine</td>
                                        <td class="p-3 text-slate-600">@item.DrawingNo</td>
                                        <td class="p-3 text-slate-600">@item.DrawingNoKanrikogu</td>
                                        <td class="p-3 text-slate-600">@item.LeadTime</td>
                                        <td class="p-3 pr-5 text-slate-500">@(item.ETA.HasValue ? item.ETA.Value.ToString("dd MMM yyyy") : "-")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Attachments Card -->
            <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-6">
                <h3 class="font-bold text-slate-800 text-base border-b border-slate-100 pb-3 mb-4">Lampiran Pendukung (Attachments)</h3>
                @if (Model.Attachments == null || !Model.Attachments.Any())
                {
                    <p class="text-sm text-slate-400">Tidak ada lampiran file yang diunggah.</p>
                }
                else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var att in Model.Attachments)
                        {
                            <a href="@Url.Content(att.FilePath)" target="_blank" 
                               class="flex items-center p-3 rounded-xl border border-slate-200 hover:border-blue-300 hover:bg-blue-50/30 transition duration-150 group">
                                <div class="p-2 bg-slate-100 text-slate-600 group-hover:bg-blue-100 group-hover:text-blue-600 rounded-lg mr-3 transition duration-150">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                </div>
                                <div class="overflow-hidden">
                                    <span class="block text-sm font-bold text-slate-700 truncate group-hover:text-blue-700 transition">@att.FileName</span>
                                    <span class="text-[10px] text-slate-400">Diunggah: @att.UploadedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Right 1 Column: Approval Log & Reminder Config & Approval panel -->
        <div class="space-y-8">
            
            <!-- Dynamic Approval Action Panel (For Active Approver Only) -->
            @if (isApproverActive)
            {
                <div class="bg-white rounded-2xl border border-slate-100 shadow-xl p-6 relative overflow-hidden">
                    <!-- Top accent line -->
                    <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-blue-500 to-indigo-600"></div>
                    
                    <h3 class="font-bold text-slate-800 text-lg mb-2 mt-1 flex items-center">
                        <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        Approval Action Required
                    </h3>
                    <p class="text-xs text-slate-450 mb-5 leading-relaxed">Silakan tinjau rincian permintaan di sebelah kiri sebelum memberikan respon persetujuan atau penolakan di bawah ini.</p>
                    
                    <form id="approvalForm" method="post" class="space-y-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ID" value="@Model.ID" />
                        <input type="hidden" name="poNumber" id="hiddenPoNumber" />
                        
                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">Komentar / Catatan Penolakan</label>
                            <textarea name="comment" id="approvalComment" rows="3" placeholder="Masukkan catatan komentar (catatan penolakan wajib diisi)..."
                                      class="w-full px-4 py-3 text-sm rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition bg-slate-50/50 hover:bg-slate-50 focus:bg-white text-slate-800 placeholder-slate-400"></textarea>
                            <span id="commentValidationMsg" class="hidden text-xs font-semibold text-rose-500 mt-1.5 flex items-center">
                                <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                                Alasan penolakan wajib diisi untuk melakukan Reject.
                            </span>
                        </div>

                        <div class="grid grid-cols-2 gap-4 pt-2">
                            <button type="submit" id="btnReject" onclick="setApprovalAction('Reject')"
                                     class="w-full py-3 bg-rose-50 text-rose-600 hover:bg-rose-100 border border-rose-200 font-bold rounded-xl transition duration-150 text-center text-sm shadow-sm">
                                Reject
                            </button>
                            <button type="submit" id="btnApprove" onclick="setApprovalAction('Approve')"
                                    class="w-full py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold rounded-xl shadow-md hover:shadow-lg active:scale-[0.98] transition duration-150 text-center text-sm">
                                Approve
                            </button>
                        </div>
                    </form>
                </div>
            }

            <!-- Reminder Config Summary -->
            <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-6 space-y-4">
                <h3 class="font-bold text-slate-800 text-base border-b border-slate-100 pb-3">Setelan Email Reminder</h3>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between border-b border-slate-50 pb-2">
                        <span class="text-slate-500">Waktu Pengiriman</span>
                        <span class="font-semibold text-slate-800">H+ @Model.ReminderDaysAfter Hari</span>
                    </div>
                    <div class="flex justify-between border-b border-slate-50 pb-2">
                        <span class="text-slate-500">Jam Pengiriman</span>
                        <span class="font-semibold text-slate-800">Pukul @(Model.ReminderSendTime > 0 ? Model.ReminderSendTime.ToString("D2") : "08"):00 WIB</span>
                    </div>
                    <div class="flex justify-between border-b border-slate-50 pb-2">
                        <span class="text-slate-500">Pengulangan (Repeat)</span>
                        <span class="font-semibold text-slate-800">@(Model.IsReminderRepeated ? "Aktif" : "Tidak Aktif")</span>
                    </div>
                    @if (Model.IsReminderRepeated)
                    {
                        <div class="flex justify-between border-b border-slate-50 pb-2">
                            <span class="text-slate-500">Interval</span>
                            <span class="font-semibold text-slate-800">
                                @(Model.ReminderRepeatInterval == "Custom" ? $"Setiap {Model.ReminderCustomDays} Hari" : Model.ReminderRepeatInterval)
                            </span>
                        </div>
                    }
                    <div class="flex justify-between border-b border-slate-50 pb-2">
                        <span class="text-slate-500">Jadwal Berikutnya</span>
                        <span class="font-semibold text-slate-800 text-xs">
                            @(Model.ReminderDateStart.HasValue ? Model.ReminderDateStart.Value.ToString("dd/MM/yyyy") : (Model.Status == "Completed" || Model.Status == "Approved" || Model.Status == "Rejected" ? "-" : "Menunggu Trigger Approve"))
                        </span>
                    </div>
                    <div class="flex justify-between pb-1">
                        <span class="text-slate-500">Terakhir Dikirim</span>
                        <span class="font-semibold text-slate-800 text-xs">
                            @(Model.LastReminderSentDate.HasValue ? Model.LastReminderSentDate.Value.ToString("dd/MM/yyyy HH:mm") : "Belum pernah")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Approval Progress Log -->
            <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-6">
                <h3 class="font-bold text-slate-800 text-base border-b border-slate-100 pb-3 mb-5">Log Alur Approval</h3>
                @if (approvalFlow == null || !approvalFlow.Any())
                {
                    <p class="text-sm text-slate-400">Belum ada alur approval yang terkonfigurasi.</p>
                }
                else
                {
                    <div class="relative pl-6 border-l-2 border-slate-100 space-y-6">
                        @foreach (var step in approvalFlow)
                        {
                            <div class="relative">
                                <!-- Marker Dot -->
                                @if (step.Status == "Approved")
                                {
                                    <span class="absolute -left-[33px] top-1 flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500 text-white border border-emerald-600 shadow-sm">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                                    </span>
                                }
                                else if (step.Status == "Rejected")
                                {
                                    <span class="absolute -left-[33px] top-1 flex h-5 w-5 items-center justify-center rounded-full bg-rose-500 text-white border border-rose-600 shadow-sm">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
                                    </span>
                                }
                                else if (step.Status == "Skipped")
                                {
                                    <span class="absolute -left-[33px] top-1 flex h-5 w-5 items-center justify-center rounded-full bg-slate-150 text-slate-400 border border-slate-200 shadow-sm">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
                                    </span>
                                }
                                else if (step.Status == "Pending")
                                {
                                    <span class="absolute -left-[33px] top-1 flex h-5 w-5 items-center justify-center rounded-full bg-amber-500 text-white border border-amber-600 ring-4 ring-amber-100 shadow-sm animate-pulse">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path></svg>
                                    </span>
                                }
                                else
                                {
                                    <span class="absolute -left-[33px] top-1 flex h-5 w-5 items-center justify-center rounded-full bg-white text-slate-300 border-2 border-dashed border-slate-200 shadow-sm">
                                        <span class="h-1.5 w-1.5 rounded-full bg-slate-200"></span>
                                    </span>
                                }

                                <div class="bg-slate-50/50 hover:bg-slate-50 p-3.5 rounded-xl border border-slate-100/50 transition">
                                    <div class="flex items-center justify-between gap-2">
                                        <span class="text-xs font-bold text-slate-700 block">@step.ApproverName</span>
                                        @if (step.Status == "Approved")
                                        {
                                            <span class="px-2 py-0.5 text-[9px] font-bold bg-emerald-50 text-emerald-700 rounded border border-emerald-200">Approved</span>
                                        }
                                        else if (step.Status == "Rejected")
                                        {
                                            <span class="px-2 py-0.5 text-[9px] font-bold bg-rose-50 text-rose-700 rounded border border-rose-200">Rejected</span>
                                        }
                                        else if (step.Status == "Skipped")
                                        {
                                            <span class="px-2 py-0.5 text-[9px] font-bold bg-slate-100 text-slate-500 rounded border border-slate-200">Skipped</span>
                                        }
                                        else if (step.Status == "Pending")
                                        {
                                            <span class="px-2 py-0.5 text-[9px] font-bold bg-amber-50 text-amber-700 rounded border border-amber-200 animate-pulse">Active</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 text-[9px] font-bold bg-white text-slate-400 rounded border border-slate-200 border-dashed">Queued</span>
                                        }
                                    </div>
                                    <div class="flex items-center justify-between text-[10px] text-slate-450 mt-1">
                                        <span class="font-semibold text-slate-500">@(string.IsNullOrEmpty(step.TaskTitle) ? "Level " + step.Level : step.TaskTitle) @(step.IsOptional ? "(Opsional)" : "")</span>
                                        <span class="font-mono text-[9px]">@step.NIK</span>
                                    </div>
                                    @if (step.Status == "Approved" && step.Date != null)
                                    {
                                        <span class="block text-[10px] text-emerald-600 font-medium mt-1">Disetujui: @step.Date.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                    else if (step.Status == "Rejected" && step.Date != null)
                                    {
                                        <span class="block text-[10px] text-rose-600 font-medium mt-1">Ditolak: @step.Date.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                    else if (step.Status == "Skipped")
                                    {
                                        <span class="block text-[10px] text-slate-400 italic mt-1">Dilewati karena approval di atas disetujui</span>
                                    }
                                    else if (step.Status == "Pending")
                                    {
                                        <span class="block text-[10px] text-amber-600 font-semibold mt-1">Menunggu respon approver</span>
                                    }

                                    @if (!string.IsNullOrEmpty(step.Comment))
                                    {
                                        <div class="mt-2 text-[11px] bg-white p-2 rounded-lg border border-slate-200/75 text-slate-600 italic">
                                            <span class="font-semibold not-italic text-slate-500">Catatan:</span> "@step.Comment"
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    var currentAction = "Approve";

    function setApprovalAction(action) {
        currentAction = action;
        var form = document.getElementById('approvalForm');
        if (action === "Approve") {
            form.action = '@Url.Action("Approve", "SparepartPORequest", new { area = "SCM" })';
        } else {
            form.action = '@Url.Action("Reject", "SparepartPORequest", new { area = "SCM" })';
        }
    }

    $(document).ready(function () {
        $('#approvalForm').submit(function (e) {
            e.preventDefault(); // Stop standard form submission
            
            var commentVal = $('#approvalComment').val().trim();

            if (currentAction === "Reject") {
                if (commentVal === "") {
                    $('#commentValidationMsg').removeClass('hidden');
                    $('#approvalComment').addClass('border-rose-450 ring-2 ring-rose-100 bg-rose-50/20');
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'Catatan Komentar Wajib',
                        text: 'Silakan isi komentar atau alasan penolakan terlebih dahulu!',
                        confirmButtonColor: '#3b82f6',
                        customClass: {
                            popup: 'font-[\'Outfit\']',
                            confirmButton: 'font-bold px-5 py-2.5 rounded-lg'
                        }
                    });
                    return false;
                }
                
                // Show Reject SweetAlert
                Swal.fire({
                    title: 'Apakah Anda yakin?',
                    text: "Anda akan MENOLAK permintaan PO ini!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Ya, Tolak!',
                    cancelButtonText: 'Batal',
                    customClass: {
                        popup: 'font-[\'Outfit\']',
                        confirmButton: 'font-bold px-5 py-2.5 rounded-lg mr-2',
                        cancelButton: 'font-bold px-5 py-2.5 rounded-lg'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#commentValidationMsg').addClass('hidden');
                        $('#approvalComment').removeClass('border-rose-455 ring-2 ring-rose-100 bg-rose-50/20');
                        // Submit natively
                        document.getElementById('approvalForm').submit();
                    }
                });
            } else if (currentAction === "Approve") {
                var isLevel5 = @(ViewBag.IsLevel5Approver != null && (bool)ViewBag.IsLevel5Approver ? "true" : "false");

                if (isLevel5) {
                    Swal.fire({
                        title: 'Konfirmasi Approval Level 5 (Purchasing)',
                        html: `
                            <div style="text-align: left; margin-bottom: 12px;">
                                <label style="display:block; font-size: 11px; font-weight: bold; color: #475569; text-transform: uppercase; margin-bottom: 4px;">
                                    Nomor PO (PO Number) <span style="color: #ef4444;">*</span>
                                </label>
                                <input id="swal-input-po" class="swal2-input" style="width: 100%; margin: 0; font-size: 13px; padding: 8px 12px; height: 38px; border-radius: 8px;" placeholder="Contoh: PO-2026-09-0012">
                            </div>
                            <div style="text-align: left;">
                                <label style="display:block; font-size: 11px; font-weight: bold; color: #475569; text-transform: uppercase; margin-bottom: 4px;">
                                    Catatan Tambahan (Opsional)
                                </label>
                                <textarea id="swal-input-comment" class="swal2-textarea" style="width: 100%; margin: 0; font-size: 13px; padding: 8px 12px; height: 70px; border-radius: 8px;" placeholder="Masukkan catatan...">${commentVal}</textarea>
                            </div>
                        `,
                        icon: 'info',
                        showCancelButton: true,
                        confirmButtonColor: '#2563eb',
                        cancelButtonColor: '#6b7280',
                        confirmButtonText: 'Ya, Setujui & Simpan PO',
                        cancelButtonText: 'Batal',
                        focusConfirm: false,
                        preConfirm: () => {
                            const po = document.getElementById('swal-input-po').value.trim();
                            const comm = document.getElementById('swal-input-comment').value.trim();
                            if (!po) {
                                Swal.showValidationMessage('Nomor PO (PO Number) wajib diisi untuk approval Level 5!');
                                return false;
                            }
                            // AJAX Uniqueness Check
                            return $.ajax({
                                url: '@Url.Action("CheckPONumberUnique", "SparepartPORequest", new { area = "SCM" })',
                                type: 'GET',
                                data: { poNumber: po, excludeId: @Model.ID }
                            }).then(function (res) {
                                if (res && !res.isUnique) {
                                    Swal.showValidationMessage(`Nomor PO "${po}" sudah digunakan pada pengajuan lain! Silakan gunakan No PO yang berbeda.`);
                                    return false;
                                }
                                return { poNumber: po, comment: comm };
                            }).catch(function () {
                                return { poNumber: po, comment: comm };
                            });
                        },
                        customClass: {
                            popup: 'font-[\'Outfit\'] text-left',
                            confirmButton: 'font-bold px-5 py-2.5 rounded-lg mr-2',
                            cancelButton: 'font-bold px-5 py-2.5 rounded-lg'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $('#hiddenPoNumber').val(result.value.poNumber);
                            if (result.value.comment) {
                                $('#approvalComment').val(result.value.comment);
                            }
                            document.getElementById('approvalForm').submit();
                        }
                    });
                } else {
                    // Show standard Approve SweetAlert for other levels
                    Swal.fire({
                        title: 'Konfirmasi Persetujuan',
                        text: "Apakah Anda yakin ingin MENYETUJUI permintaan PO ini?",
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#2563eb',
                        cancelButtonColor: '#6b7280',
                        confirmButtonText: 'Ya, Setujui!',
                        cancelButtonText: 'Batal',
                        customClass: {
                            popup: 'font-[\'Outfit\']',
                            confirmButton: 'font-bold px-5 py-2.5 rounded-lg mr-2',
                            cancelButton: 'font-bold px-5 py-2.5 rounded-lg'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $('#commentValidationMsg').addClass('hidden');
                            $('#approvalComment').removeClass('border-rose-455 ring-2 ring-rose-100 bg-rose-50/20');
                            // Submit natively
                            document.getElementById('approvalForm').submit();
                        }
                    });
                }
            }
        });
    });
</script>
