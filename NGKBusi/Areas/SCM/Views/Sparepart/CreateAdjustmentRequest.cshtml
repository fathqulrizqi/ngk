@{
    ViewBag.Title = "Create Adjustment Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section cssHead {
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.6/css/dataTables.dataTables.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <link href="@Url.Content("~/Content/sweetalert2/sweetalert2.min.css")" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .modal-hidden {
            opacity: 0;
            pointer-events: none;
        }

        .modal-show {
            opacity: 1;
            pointer-events: auto;
        }

        .page-content {
            background: linear-gradient(135deg, #1E555C 10%, #fefee3 100%);
            padding-top: 1rem !important;
        }

        .custom-input {
            width: 100%;
            border-radius: 0.5rem;
            border: 1px solid #d1d5db;
            padding: 0.6rem 0.75rem;
            font-size: 0.875rem;
            transition: all 0.2s;
        }

            .custom-input:focus {
                outline: none;
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            }

        .select2-container--default .select2-selection--single {
            border: 1px solid #d1d5db !important;
            height: 42px !important;
            border-radius: 0.5rem !important;
            padding-top: 5px;
        }

            .select2-container--default .select2-selection--single .select2-selection__arrow {
                height: 40px !important;
            }

        .fade-in {
            animation: fadeIn 0.3s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        table.dataTable,
        table.dataTable thead th,
        table.dataTable tbody td,
        table.dataTable tfoot th {
            border: none !important;
        }

            table.dataTable thead {
                border-bottom: none !important;
            }

            table.dataTable tbody tr {
                border-bottom: none !important;
            }

        .divide-y > :not([hidden]) ~ :not([hidden]) {
            border-top-width: 1px;
            border-color: #f3f4f6;
        }
    </style>
}

@section scriptHead {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.6/js/dataTables.js"></script>

    <script src="@Url.Content("~/Content/sweetalert2/sweetalert2.all.min.js")"></script>
    <script>
        $(document).ready(function () {
            initSelect2();
            document.getElementById("Date_Created").value = new Date().toISOString().slice(0, 10);

            // SAVE ITEM
            $("#stockAdjustmentForm").on("submit", function (e) {
                e.preventDefault();

                const data = {
                    ItemID: $("#ItemID").val(),
                    Qty: $("#Qty").val(),
                };

                if (!data.ItemID || !data.Qty) {
                    Swal.fire("Warning", "Item and Qty are required", "warning");
                    return;
                }

                $.ajax({
                    url: "@Url.Action("SaveAdjustmentItem", "Sparepart", new { area = "SCM" })",
                    type: "POST",
                    data: data,
                    success: function (res) {
                        if (res.success) {
                            Swal.fire({
                                icon: "success",
                                title: "Success",
                                text: "Item added successfully"
                            }).then(() => {
                                location.reload();
                            });

                        } else {
                            Swal.fire("Error", res.message || "Failed to save", "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Server error", "error");
                    }
                });
            });

            // GET ITEM
            let adjustmentTable = $("#listAdjustmentItemTable").DataTable({
            ajax: {
                url: "@Url.Action("GetAdjustmentItemByUser", "Sparepart", new { area = "SCM" })",
                type: "GET",
                dataSrc: function (res) {
                    if (!res.success) {
                        Swal.fire("Error", res.message || "Failed to load data", "error");
                        return [];
                    }
                    return res.data;
                }
            },
            paging: false,
            searching: false,
            info: false,
            ordering: false,
                columns: [
                    {
                        // Column 1: Checkbox
                        data: "ItemID",
                        className: "text-left",
                        render: function (data, type, row) {
                            return `<input type="checkbox" class="row-checkbox cursor-pointer" value="${row.ID}" data-name="${data}">`;
                        }
                    },
                    {
                        // Column 0: Index Number
                        data: null,
                        className: "text-left",
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        }
                    },
                    {
                        // Column 2: Item ID Text
                        data: "ItemID",
                        className: "text-left"
                    },
                    {
                        // Column 3: Qty with conditional coloring
                        data: "Qty",
                        className: "text-center",
                        render: function (data) {
                            return `<span class="${data < 0 ? 'text-red-600' : 'text-green-600'} font-bold">
                        ${data}
                    </span>`;
                        }
                    },
                    {
                        // Column 4: Action Button
                        data: null,
                        className: "text-right",
                        render: function (data) {
                            return `
                <button type="button" class="btn-delete text-red-500 hover:text-red-700"
                    data-id="${data.ID}">
                    <i class="fas fa-trash"></i>
                </button>
            `;
                        }
                    }
                ]
            });

            // DELETE ITEM
            $("#listAdjustmentItemTable").on("click", ".btn-delete", function () {
                const id = $(this).data("id");

                Swal.fire({
                    title: "Delete this item?",
                    text: "This action cannot be undone",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Yes, delete",
                    cancelButtonText: "Cancel"
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: "@Url.Action("DeleteAdjustmentItem", "Sparepart", new { area = "SCM" })",
                        type: "POST",
                        data: { id: id },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire("Deleted", res.message, "success")
                                    .then(() => {
                                        adjustmentTable.ajax.reload(null, false);
                                    });
                            } else {
                                Swal.fire("Error", res.message || "Failed to delete", "error");
                            }
                        },
                        error: function () {
                            Swal.fire("Error", "Server error", "error");
                        }
                    });
                });
            });

// CHECKBOX SELECT ALL & ROW SELECT

function toggleBulkDeleteButton() {
    let count = $('.row-checkbox:checked').length;
    if (count > 1) {
        $('#btnDeleteSelected').removeClass('hidden');
        $('#selectedCount').text(count);
    } else {
        $('#btnDeleteSelected').addClass('hidden');
    }
}

$('#select-all').on('change', function () {
    let isChecked = $(this).is(':checked');
    $('.row-checkbox').prop('checked', isChecked);
    toggleBulkDeleteButton();
});

$('#listAdjustmentItemTable').on('change', '.row-checkbox', function () {
    if (!$(this).is(':checked')) {
        $('#select-all').prop('checked', false);
    }

    if ($('.row-checkbox:checked').length === $('.row-checkbox').length) {
        $('#select-all').prop('checked', true);
    }

    toggleBulkDeleteButton();
});

// DELETE MULTIPLE
$('#btnDeleteSelected').on('click', function () {
    let selectedIDs = [];

    $('.row-checkbox:checked').each(function () {
        selectedIDs.push($(this).val());
    });

    let totalSelected = selectedIDs.length;

    if (totalSelected === 0) return;

    Swal.fire({
        title: `Delete ${totalSelected} items?`,
        text: `Are you sure want to delete ${totalSelected} items permanently?`,
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete all",
        cancelButtonText: "Cancel"
    }).then((result) => {
        if (!result.isConfirmed) return;

        Swal.fire({
            title: 'Deleting...',
            text: 'Please wait while we delete the items.',
            allowOutsideClick: false, 
            allowEscapeKey: false,    
            didOpen: () => {
                Swal.showLoading();
            }
        });

        let deletePromises = selectedIDs.map(id => {
            return $.ajax({
                url: "@Url.Action("DeleteAdjustmentItem", "Sparepart", new { area = "SCM" })",
                type: "POST",
                data: { id: id }
            });
        });

        Promise.all(deletePromises)
            .then(results => {
                let allSuccess = results.every(res => res.success);

                if (allSuccess) {
                    Swal.fire("Deleted!", `${totalSelected} item berhasil dihapus.`, "success").then(() => {
                        $('#select-all').prop('checked', false);
                        toggleBulkDeleteButton();
                        location.reload();
                    });
                } else {
                    Swal.fire("Warning", "Beberapa item mungkin gagal dihapus oleh server.", "warning");
                    adjustmentTable.ajax.reload(null, false);
                }
            })
            .catch(err => {
                Swal.fire("Error", "Terjadi kesalahan server saat menghapus data.", "error");
            });
    });
});

            // SAVE REQUEST
            $('#adjustmentForm').on('submit', function (e) {
                e.preventDefault();

                Swal.fire({
                    title: 'Create Adjustment?',
                    text: 'All items will be submitted',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, submit',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: "@Url.Action("SaveAdjustmentRequest", "Sparepart", new { area = "SCM" })",
                        type: 'POST',
                        data: {
                            remark: $('#Remark').val()
                        },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Success', res.message, 'success')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'Server error', 'error');
                        }
                    });
                });
            });


        });

        function initSelect2() {
            $('#ItemID').select2({
                placeholder: '-- Select Item --',
                allowClear: true,
                width: '100%'
            });
        }



        let isUploadMode = false;
        let excelTable = null;

        function toggleMode() {
            const manualSec = document.getElementById('manualFormSection');
            const uploadSec = document.getElementById('uploadFormSection');
            const formTitle = document.getElementById('formTitle');
            const toggleText = document.getElementById('toggleText');
            const toggleIcon = document.getElementById('toggleIcon');

            isUploadMode = !isUploadMode;

            if (isUploadMode) {
                manualSec.classList.add('hidden');
                uploadSec.classList.remove('hidden');
                formTitle.innerHTML = '<i class="fas fa-file-excel mr-2 text-green-600"></i> Excel Upload';
                toggleText.innerText = "Switch to Manual Form";
                toggleIcon.className = "fas fa-keyboard";
            } else {
                manualSec.classList.remove('hidden');
                uploadSec.classList.add('hidden');
                formTitle.innerHTML = '<i class="fas fa-edit mr-2 text-blue-600"></i> Stock Adjustment Form';
                toggleText.innerText = "Switch to Upload Excel";
                toggleIcon.className = "fas fa-file-excel";

                setTimeout(initSelect2, 50);
            }

        }
    </script>

    @*HANDLING FILE EXCEL*@
<script>
document.addEventListener("DOMContentLoaded", function () {

    const fileInput = document.getElementById("dropzone-file");
    const modal = document.getElementById("adjustmentDetail");

    if (!fileInput) {
        console.error("dropzone-file not found");
        return;
    }

    // ======================
    // FILE SELECT
    // ======================
    fileInput.addEventListener("change", function () {
        if (this.files.length > 0) {
            uploadFile(this.files[0]);
        }
    });

    // ======================
    // DRAG & DROP
    // ======================
    const dropZone = fileInput.closest("label");

    if (dropZone) {
        dropZone.addEventListener("dragover", function (e) {
            e.preventDefault();
            dropZone.classList.add("border-blue-400");
        });

        dropZone.addEventListener("dragleave", function () {
            dropZone.classList.remove("border-blue-400");
        });

        dropZone.addEventListener("drop", function (e) {
            e.preventDefault();
            dropZone.classList.remove("border-blue-400");

            const file = e.dataTransfer.files[0];
            if (file) uploadFile(file);
        });
    }

    // ======================
    // UPLOAD
    // ======================
    function uploadFile(file) {
        const formData = new FormData();
        formData.append("file", file);
        const uploadUrl = "@Url.Action("UploadItemXls", "Sparepart", new { area = "SCM" })";

        const xhr = new XMLHttpRequest();
        xhr.open("POST", uploadUrl, true);

        xhr.onload = function () {
            if (xhr.status === 200) {

                const res = JSON.parse(xhr.responseText);
                console.log("UPLOAD RESPONSE:", res);

                if (res.success) {
                    renderDetailTable(res.data);
                    openModal();
                } else {
                    alert(res.message);
                }

            } else {
                alert("Upload failed");
            }
        };


        xhr.send(formData);
    }

    function renderDetailTable(items) {
        console.log("ITEMS FROM EXCEL:", items);

        const tbody = document.getElementById("detailItemBody");
        if (!tbody) {
            console.error("detailItemBody not found");
            return;
        }

        tbody.innerHTML = "";

        items.forEach((item, index) => {
            tbody.innerHTML += `
            <tr>
                <td class="px-3 py-2">${index + 1}</td>
                <td class="px-3 py-2">${item.ItemName}</td>
                <td class="px-3 py-2 text-center">${item.Qty}</td>
            </tr>
        `;
        });
    }


    // ======================
    // MODAL
    // ======================
    function openModal() {
        document.body.classList.add("overflow-hidden");
        modal.classList.remove("modal-hidden");
        modal.classList.add("modal-show");
    }

    function closeModal() {
        document.body.classList.remove("overflow-hidden");
        modal.classList.add("modal-hidden");
        modal.classList.remove("modal-show");
    }

    document.querySelectorAll("[data-dialog-close]").forEach(btn => {
        btn.addEventListener("click", closeModal);
    });

    modal?.addEventListener("click", function (e) {
        if (e.target === modal) closeModal();
    });

    $("#btnAddAdjustment").on("click", function () {

    const items = [];

    $("#detailItemBody tr").each(function () {
        const itemName = $(this).find("td:eq(1)").text().trim();
        const qty = parseInt($(this).find("td:eq(2)").text().trim());

        if (itemName) {
            items.push({
                ItemName: itemName,
                Qty: qty
            });
        }
    });

    console.log("ITEMS TO SAVE:", items);

    if (items.length === 0) {
        Swal.fire("Warning", "No item to save", "warning");
        return;
    }

    $.ajax({
        url: "@Url.Action("SaveAdjustmentItemExcel", "Sparepart", new { area = "SCM" })",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ items: items }),
        success: function (res) {
            if (res.success) {
                Swal.fire("Success", res.message, "success")
                    .then(() => location.reload());
            } else {
                Swal.fire("Error", res.message, "error");
            }
        },
        error: function () {
            Swal.fire("Error", "Server error", "error");
        }
    });
});

});
</script>

}

<div class="p-4">
    <div class="flex items-center space-x-4">
        <div class="w-1.5 h-8 bg-gradient-to-b from-yellow-500 to-orange-600 rounded-full shadow-sm"></div>
        <h1 class="text-2xl font-bold text-gray-50 drop-shadow-sm">Create Adjustment Request</h1>
    </div>
</div>

<div class="px-4">
    <nav class="mt-3 mb-6 bg-gray-50 py-2 rounded-md" aria-label="Breadcrumb">
        <ol class="flex px-2 items-center gap-2 text-sm text-gray-400">
            <li class="flex items-center gap-1 hover:text-white transition">
                <a href="@Url.Action("AdjustmentRequest", "Sparepart", new { area = "SCM" })"
                   class="flex items-center gap-1">
                    <i class="fa-solid fa-house pr-1"></i>
                    Home
                </a>
            </li>

            <li class="text-gray-500">/</li>

            <li class="font-semibold text-gray-500">
                Create Adjustment
            </li>
        </ol>
    </nav>
</div>


<div class="flex flex-col lg:flex-row gap-6 px-4">
    <div class="flex-1 bg-white rounded-2xl shadow-xl overflow-hidden border border-white/20">
        <div class="px-6 py-4 bg-gray-50 border-b flex justify-between items-center">
            <h3 id="formTitle" class="text-lg font-bold text-gray-800 flex items-center">
                <i class="fas fa-edit mr-2 text-blue-600"></i> Manual Form
            </h3>
            <button id="toggleBtn" onclick="toggleMode()" class="flex items-center gap-2 px-4 py-1.5 bg-blue-50 text-blue-700 rounded-lg text-sm font-bold hover:bg-blue-100 transition-all border border-blue-200">
                <i id="toggleIcon" class="fas fa-file-excel"></i>
                <span id="toggleText">Switch to Upload Excel</span>
            </button>
        </div>

        <div id="manualFormSection" class="p-8 fade-in">
            <form id="stockAdjustmentForm" class="space-y-6">
                <div class="grid grid-cols-1">

                    <div>
                        <label class="block mb-1.5 text-xs font-bold text-gray-500 uppercase tracking-wider">Created By</label>
                        <input type="text" id="Creator_NIK" value="@ViewBag.CurrUserName" readonly class="custom-input bg-gray-100 text-gray-500 cursor-not-allowed border-none" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2 items-end">
                    <div class="md:col-span-1">
                        <label class="block mb-1.5 text-sm font-semibold text-gray-700">Item</label>
                        <select id="ItemID" name="SelITEMID" class="form-control" required>
                            <option value="">-- Select Item --</option>
                            @if (ViewBag.ItemListAdjust != null)
                            {
                                foreach (var item in ViewBag.ItemListAdjust)
                                {
                                    <option value="@item">@item</option>
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block mb-1.5 text-sm font-semibold text-gray-700">Quantity</label>
                        <input type="number" id="Qty" placeholder="0" class="custom-input" required />
                    </div>

                </div>

                <div class="pt-6 border-t flex justify-end">
                    <button type="submit" class="px-8 py-2.5 bg-blue-600 text-white rounded-xl hover:bg-blue-700 font-bold transition-all shadow-lg">
                        Add to List <i class="fas fa-plus ml-2"></i>
                    </button>
                </div>
            </form>
        </div>

        <div id="uploadFormSection" class="p-8 hidden fade-in">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
                <div class="space-y-4">
                    <h4 class="font-bold text-gray-700">1. Download Template</h4>
                    <p class="text-sm text-gray-500 italic">Please use our latest template.</p>
                    <a href="@Url.Action("DownloadAdjustmentTemplate", "Sparepart", new { area = "SCM" })"
                       class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-orange-500 to-yellow-600 text-white font-bold rounded-xl shadow-md">
                        <i class="fas fa-download mr-2"></i> Get Template .xlsx
                    </a>

                </div>
                <div class="space-y-4">
                    <h4 class="font-bold text-gray-700">2. Upload & Preview</h4>
                    <label class="flex flex-col items-center justify-center w-full h-44 border-2 border-dashed border-blue-200 rounded-2xl cursor-pointer bg-blue-50/30">
                        <i class="fas fa-cloud-upload-alt text-3xl text-blue-400 mb-3"></i>
                        <p class="text-xs font-semibold text-blue-600">CLICK OR DRAG FILE HERE</p>
                        <input type="file" id="dropzone-file" class="hidden" />
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="w-full lg:w-[400px] bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col h-[520px]">
        <div class="px-6 py-4 bg-gradient-to-r from-gray-50 to-gray-100 border-b border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900 flex items-center">
                <i class="fas fa-list-ul mr-2 text-green-600"></i> Adjustment List
            </h3>
        </div>

        <div class="flex-1 overflow-y-auto p-4 gap-2">
            <form id="adjustmentForm">
                <div class="mb-2">
                    <label class="block mb-1.5 text-xs font-bold text-gray-500 uppercase tracking-wider">Date</label>
                    <input type="text" id="Date_Created" readonly
                           class="custom-input bg-gray-100 text-gray-500 cursor-not-allowed border-none" />
                </div>

                <div>
                    <label class="block mb-1.5 text-sm font-semibold text-gray-700">Remark</label>
                    <input type="text" id="Remark" placeholder="Enter Remark" class="custom-input" />
                </div>

                <div class="flex justify-start">
                    <button type="button" id="btnDeleteSelected" class="mt-2 hidden px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg font-bold transition-all text-sm flex items-center gap-2">
                        Delete Selected (<span id="selectedCount">0</span>) <i class="fas fa-trash"></i>
                    </button>
                </div>

                <table id="listAdjustmentItemTable" class="w-full text-sm">
                    <thead class="bg-gray-50 text-gray-400 text-[11px] uppercase tracking-widest font-bold">
                        <tr>
                            <th class="px-2 py-3 text-left">
                                <input type="checkbox" id="select-all" class="cursor-pointer">
                            </th>
                            <th class="px-2 py-3 text-left">No</th>
                            <th class="px-2 py-3 text-left">Item ID</th>
                            <th class="px-2 py-3 text-center">Qty</th>
                            <th class="px-2 py-3 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody id="listTableBody" class="divide-y divide-gray-50"></tbody>
                </table>

                <!-- BUTTON MASUK FORM -->
                <div class="p-4 border-t">
                    <button id="btnCreateAll"
                            type="submit"
                            class="w-full py-3 bg-gray-800 hover:bg-black text-white rounded-xl font-bold transition-all shadow-lg flex justify-center items-center gap-2">
                        CREATE ALL REQUESTS <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL DETAIL -->
