
@{
    ViewBag.Title = "Report For D365";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section cssHead{
    <style>
        .card {
            /*border-top-left-radius: 2em;
        border-top-right-radius: 2em;*/

            box-shadow: 0 5px 10px rgba(0,0,0,.2);
        }

            .card .card-header {
                /*border-top-left-radius: inherit;
        border-top-right-radius:inherit;*/
                text-align: center;
                color: white;
                font-weight: bold;
                font-size: medium;
                box-shadow: inset;
            }
    </style>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-table@1.22.6/dist/bootstrap-table.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/akottr/dragtable@master/dragtable.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jquery-resizable-columns@0.2.3/dist/jquery.resizableColumns.min.css">
    <link href="@Url.Content("~/Content/datepicker/datepicker.css")" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />

    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />

    <!-- bootstrap-select -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/css/bootstrap-select.min.css">
}

@section scriptHead {
    <script src="https://cdn.jsdelivr.net/npm/jqueryui@1.11.1/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.22.6/dist/bootstrap-table.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/js/bootstrap-select.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/akottr/dragtable@master/jquery.dragtable.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.22.6/dist/extensions/reorder-columns/bootstrap-table-reorder-columns.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tableexport.jquery.plugin@1.29.0/tableExport.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tableexport.jquery.plugin@1.29.0/libs/jsPDF/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.22.6/dist/extensions/export/bootstrap-table-export.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-resizable-columns@0.2.3/dist/jquery.resizableColumns.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.22.6/dist/extensions/resizable/bootstrap-table-resizable.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="@Url.Content("~/Content/datepicker/datepicker.js")"></script>
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-info">Sparepart Adjustment Data</div>
            <div class="card-body">
                <form action='@Url.Action("exportExcelReport", "Sparepart", new { area = "SCM" })' method="post" id="formReport">
                    <div class="form-group row">
                        <label for="dateRange" class="col-md-1 col-form-label">Periode</label>
                        <div class="col-md-2">
                            <input type="text" class="form-control dateFrom" id="dateRange" name="dateFrom" placeholder="Start Date" required autocomplete="off">
                        </div>
                        <div class="col-md-2">
                            <input type="text" class="form-control dateTo" id="dateRange" name="dateTo" placeholder="End Date" required autocomplete="off">
                        </div>
                        <label for="inputPassword" class="col-md-1 col-form-label">Item ID</label>
                        <div class="col-md-2">

                            <select class="form-control selectpicker" data-live-search="true" name="SelITEMID" data-placeholder="Select Item" required>
                                <option value="all">-- All Item --</option>
                                @foreach (var item in ViewBag.ItemListAdjust)
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <input type="button" class="btn btn-info" id="findData" value="View Data" />
                        </div>
                    </div>
                    <div class="row">

                        <div class="col-md-12">
                            
                            
                        </div>

                    </div>
                </form>
                <hr />
                <div id="toolbar">

                </div>
                <table id="fresh-table"
                       data-id-table="advancedTable"
                       data-pagination="true"
                       data-ajax="ajaxRequest"
                       data-show-columns="true"
                       data-show-toggle="true"
                       data-toolbar="#toolbar"
                       data-show-columns-toggle-all="true"
                       data-reorderable-columns="true"
                       data-resizable="true"
                       data-page-list="[25, 50, 100, all]"
                       data-page-size="20"
                       class="table table-sm table-hover table-striped">
                    <thead>
                        <tr>
                            <th data-field="DateAdjustment" data-sortable="true" data-width="150">Adjustment Date</th>
                            <th data-field="ITEMID" data-sortable="true" data-width="150">ITEM ID</th>
                            <th data-field="QtyAdjustment" data-sortable="true" data-width="150">Quantity</th>
                            <th data-field="RemarkAdjustment" data-sortable="true" data-width="550">Remark</th>
                        </tr>
                    </thead>
                    <tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        $('#fresh-table').bootstrapTable({
            exportDataType: "all",
            exportTypes: ['excel', 'pdf'],
            buttonsClass: 'primary',
        })
    });

    $(function () {
        //$('.selectpicker').selectpicker();

        $(document).on('click', '#findData', function (e) {

            $('#fresh-table').bootstrapTable('refresh', function () {
                console.log('tes');
            });
        });
    });

    $(function () {
        var $startDate = $('.dateFrom');
        var $endDate = $('.dateTo');

        $startDate.datepicker({
            autoHide: true,
            format: 'yyyy-mm-dd'
        });

        $endDate.datepicker({
            autoHide: true,
            format: 'yyyy-mm-dd',
            startDate: $startDate.datepicker('getDate'),
        });

        $startDate.on('change', function () {
            $endDate.datepicker('setStartDate', $startDate.datepicker('getDate'));
        });

    })

    function queryParams(params) {

        return params;
    }

    function ajaxRequest(params) {

        $.ajax({
            type: "post",
            url: "@Url.Action("GetAdjusmentData", "Sparepart", new { area = "SCM" })",
            dataType: 'json',
            data: $('#formReport').serialize(),
            success: function (items) {
                //console.log(items.notReady);
                params.success({
                    rows: items.rows
                }, null);
                $('#toolbar').html(items.title);
            },
            error: function (er) {
                console.log(params.error(er))
                console.log("error", er);
            }
        })

    }
</script>