    $(function () {
        // Event listener untuk tombol print
        $('#buttonPrint').on('click', function () {
            // Ambil instance dari bootstrap table
            const $table = $('#table');

            // Dapatkan semua baris yang dipilih (dicentang)
            const selections = $table.bootstrapTable('getSelections');

            // Jika tidak ada baris yang dipilih, tampilkan peringatan
            if (selections.length === 0) {
                Swal.fire(
                    'Perhatian!',
                    'Silakan pilih setidaknya satu item untuk dicetak.',
                    'warning'
                );
                return; // Hentikan eksekusi
            }

            // Ekstrak ID dari setiap baris yang dipilih
            // Pastikan 'ITEMID' sesuai dengan 'data-field' di tabel Anda
            const selectedIds = selections.map(row => row.Id);

            console.log('ID : ', selectedIds);

            // Panggil fungsi untuk mengirim daftar ID ke server
            printSelectedLabels(selectedIds);
        });
    });

async function printSelectedLabels(ids) {
    // Tampilkan dialog konfirmasi
    const result = await Swal.fire({
        title: 'Konfirmasi Cetak',
        text: `Apakah Anda yakin ingin mencetak ${ids.length} jenis label yang dipilih?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Ya, Cetak!'
    });

    if (result.isConfirmed) {
        Swal.fire({
            title: 'Processing...',
            text: 'Mengirim data ke printer, mohon tunggu.',
            allowOutsideClick: false,
            showConfirmButton: false,
            showCloseButton: false,
            didOpen: () => {
                Swal.showLoading();
                setTimeout(() => {
                    Swal.update({
                        text: 'Close dan batalkan cek printer terlebih dahulu jika terlalu lama.',
                        showCloseButton: true,
                        showConfirmButton: false
                    });
                    Swal.showLoading();
                }, 20000);
            }
        });
       

        try {
            const url = '@Url.Action("SparepartPrintQr", "Sparepart", new { area = "SCM" })';
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                },
                
                body: new URLSearchParams({
                    'ids': ids,
                })
            });

            const data = await response.json();

            if (data.success) {
                Swal.fire('Berhasil!', data.message, 'success');
            } else {
                Swal.fire('Gagal!', data.message, 'error');
            }

        } catch (error) {
            Swal.fire('Error!', 'Terjadi kesalahan saat menghubungi server.', 'error');
            console.error('Error:', error);
        }
    }
}

</script>
