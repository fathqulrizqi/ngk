<!doctype html>
@{
    ViewBag.Title = "Detail Request";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currUser = ViewBag.CurrUser;
}

<link href="https://unpkg.com/bootstrap-table@1.21.0/dist/bootstrap-table.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://unpkg.com/bootstrap-table@1.21.0/dist/bootstrap-table.min.js"></script>
<script src="https://cdn.jsdelivr.net/gh/schmich/instascan-builds@master/instascan.min.js"></script>
<style>
    #preview {
        width: 400px;
        height: 400px;
        margin: 0px auto;
    }
</style>

@section cssHead{
    <link href="@Url.Content("~/Content/sweetalert2/sweetalert2.min.css")" rel="stylesheet" />
    <style type="text/css">
        .has-error .select2-selection {
            border-color: #dc3545 !important;
        }

        .card

        .card .card-header {
            text-align: center;
            color: white;
            font-weight: bold;
            font-size: medium;
            box-shadow: inset;
        }

        .swal2-popup.loader-di-bawah .swal2-footer {
            flex-direction: column-reverse; 
            gap: 1rem;
        }


        .swal2-popup.loader-di-bawah .swal2-loader {
            margin: 0 auto;
        }
