        var $close = $('#confirmClose');

        $close.click(function () {

            var Link = "@Url.Action("CloseRequest", "Sparepart", new { area = "SCM" })";
            var id = "@ViewBag.RequestNo";
            ConfirmSendRequest(Link, "Confirm To Close Request ?", id, '#28a745', 'Yes, Close');
