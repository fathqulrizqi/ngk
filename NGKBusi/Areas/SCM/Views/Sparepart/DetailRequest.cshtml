                    <input type="hidden" id="id" name="Id" />
                </div>
            </form>
        </div>
    </div>
</div>
<script type="text/javascript">
    var txtScanner = document.getElementById('txtScanItem');
    var scanner = new Instascan.Scanner({ video: document.getElementById('preview'), scanPeriod: 5, mirror: false });
    scanner.addListener('scan', function (content) {
        //alert(content);
        document.getElementById('txtScanItem').value = content;
        submitScanner(content);
        txtScanner.dispatchEvent(new Event('keydown'));
    });
    Instascan.Camera.getCameras().then(function (cameras) {
        if (cameras.length > 0) {
            var frontCamera = null;
            var backCamera = null;

            // Loop to search for front/back keywords in camera name
            for (var i = 0; i < cameras.length; i++) {
                var name = (cameras[i].name || "").toLowerCase();
                if (name.indexOf('back') !== -1 || name.indexOf('rear') !== -1 || name.indexOf('environment') !== -1) {
                    backCamera = cameras[i];
                } else if (name.indexOf('front') !== -1 || name.indexOf('user') !== -1) {
                    frontCamera = cameras[i];
                }
            }

            // Fallback strategy if keywords aren't found or distinguish:
            if (!frontCamera) {
                frontCamera = cameras[0];
            }
            if (!backCamera) {
                backCamera = cameras.length > 1 ? cameras[1] : cameras[0];
            }

            // Start with front camera by default
            scanner.start(frontCamera);

            $('[name="options"]').on('change', function () {
                if ($(this).val() == 1) {
                    if (frontCamera) {
                        scanner.start(frontCamera);
                    } else {
                        alert('No Front camera found!');
                    }
                } else if ($(this).val() == 2) {
                    if (backCamera) {
                        scanner.start(backCamera);
                    } else {
                        alert('No Back camera found!');
                    }
                }
            });
        } else {
            console.error('No cameras found.');
            alert('No cameras found.');
        }
    }).catch(function (e) {
        console.error(e);
        document.getElementById("cameraStandBy").style.display = "none";

    });
</script>
<script>
