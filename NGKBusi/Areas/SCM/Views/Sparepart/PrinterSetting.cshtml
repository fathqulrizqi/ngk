@*@model NGKBusi.Areas.SCM.Models.PrinterAndQrViewModel*@

@{
    ViewBag.Title = "Print QR Code";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section scriptHead{
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3"></script>
    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3/dist/style.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /* CSS untuk menyembunyikan scrollbar di Firefox */
        .custom-scrollbar {
            scrollbar-width: thin;
            scrollbar-color: #a0aec0 #edf2f7; /* warna thumb dan track */
        }

            /* CSS untuk styling scrollbar di browser berbasis WebKit (Chrome, Safari, Edge) */
            .custom-scrollbar::-webkit-scrollbar {
                width: 8px; /* Lebar scrollbar */
            }

            .custom-scrollbar::-webkit-scrollbar-track {
                background: transparent; /* Membuat track transparan */
            }

            .custom-scrollbar::-webkit-scrollbar-thumb {
                background-color: #cbd5e0; /* Warna scrollbar thumb */
                border-radius: 10px; /* Membuat sudut thumb membulat */
                border: 2px solid transparent; /* Memberi sedikit padding di sekitar thumb */
                background-clip: content-box;
            }

                .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                    background-color: #a0aec0; /* Warna saat di-hover */
                }

        .datatable-input {
            border: 1px solid #d1d5db; /* Warna abu-abu (Tailwind gray-300) */
            border-radius: 0.375rem; /* Membuat sudut sedikit melengkung */
            padding: 0.5rem 0.75rem;
        }
        .datatable-dropdown label {
            font-weight: 400;
        }
        .datatable-selector {
            border: 1px solid #d1d5db; /* Warna abu-abu (Tailwind gray-300) */
            border-radius: 0.375rem; /* Membuat sudut sedikit melengkung */
            padding: 0.5rem 0.75rem;
        }

            .datatable-input:focus {
                border-color: #6b7280; /* Warna border saat di-klik (Tailwind gray-500) */
                outline: none; /* Menghilangkan outline biru default */
                box-shadow: 0 0 0 2px rgba(199, 210, 254, 0.5); /* Efek shadow halus seperti Tailwind */
            }
        /* Style for the status toggle switch */
        .toggle-checkbox:checked {
            right: 0;
            border-color: #4A90E2;
        }

            .toggle-checkbox:checked + .toggle-label {
                background-color: #4A90E2;
            }
    </style>
}

@{
    var printers = ViewBag.Printers as List<NGKBusi.Areas.SCM.Models.SCM_Sparepart_Printer>;
    var qrResult = ViewBag.QrCodesResult as List<NGKBusi.Areas.SCM.Models.SCM_Sparepart_QR_Result>;
}

<body class="bg-gray-50">
    <div class="max-w-7xl mx-auto">

        @* Page Title *@
        <h1 class="text-2xl font-bold text-gray-800 mb-6">Printer & QR Management</h1>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <div class="lg:col-span-1 bg-white p-6 rounded-lg shadow">

                <div class="flex justify-between items-center border-b pb-3 mb-4">
                    <h2 class="text-lg font-semibold text-gray-700">Select Printer</h2>

                    <button id="addPrinterBtn" class="bg-blue-600 text-white text-sm font-semibold py-2 px-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all duration-200 shadow hover:shadow-md">
                        <span class="fas fa-plus"></span> Add Printer
                    </button>
                </div>

                <div class="flex items-center gap-4">
                    <div>
                        <img src="@Url.Content("~/Images/printer_icon.png")" alt="Printer Icon" class="h-16 w-16">
                    </div>
                    <div class="flex-grow">
                        <label for="selectPrinter" class="block text-sm font-medium text-gray-600 mb-1">Printer Name</label>
                        <select name="selectPrinter" id="selectPrinter" required class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 transition duration-150 ease-in-out">
                            @if (printers != null && printers.Any())
                            {
                                foreach (var item in printers)
                                {
                                    if (item.printer_status)
                                    {
                                        <option value="@item.id" selected>@item.printer_name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.id">@item.printer_name</option>
                                    }
                                }
                            }
                            else
                            {
                                <option value="">No printers available</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mt-6 flex justify-end">
                    <button type="submit" id="changePrintButton" class="w-full bg-blue-600 text-white font-bold py-2 px-5 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all duration-200 w-full shadow hover:shadow-md">
                        Print Selected
                    </button>
                </div>
            </div>

            <div class="lg:col-span-2 bg-white p-2 rounded-lg shadow">
                <div class="overflow-y-auto max-h-[230px] custom-scrollbar">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-100 sticky top-0">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Printer Name</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">IP Printer</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Port</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Shared Path</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @if (printers != null && printers.Any())
                            {
                                foreach (var item in printers)
                                {
                                    <tr class="hover:bg-gray-50 transition-colors duration-200">
                                        <td class="px-4 py-3 whitespace-nowrap text-sm font-medium text-gray-800">@(item.printer_name)</td>
                                        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">@(string.IsNullOrWhiteSpace(item.printer_ip) ? "-" : item.printer_ip)</td>
                                        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">@(item.port)</td>
                                        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">@(item.shared_printer)</td>
                                        <td class="px-4 py-3 whitespace-nowrap text-sm">
                                            @if (item.printer_status)
                                            {
                                                <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                                    Inactive
                                                </span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">
                                            <button class="badge badge-warning p-2 edit-printer-btn"
                                                    data-id="@item.id"
                                                    data-name="@item.printer_name"
                                                    data-ip="@item.printer_ip"
                                                    data-port="@item.port"
                                                    data-location="@item.shared_printer"
                                                    data-status="@item.printer_status.ToString().ToLower()">
                                                <span class="fas fa-edit"></span>
                                            </button>
                                            <button class="badge badge-danger p-2 delete-printer-btn"
                                                    data-id="@item.id"
                                                    data-name="@item.printer_name">
                                                <span class="fas fa-trash"></span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="px-6 py-10 text-center text-sm text-gray-500">
                                        Belum ada printer tersedia.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow">
            <h2 class="text-lg font-semibold text-gray-700 p-6 border-b">Reprint QR Codes</h2>
            <div class="overflow-x-auto">
                <table id="filter-table" class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item Number</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Item Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">QRCode</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created At</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Print</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @if (qrResult != null && qrResult.Any())
                        {
                            foreach (var item in qrResult)
                            {
                                <tr class="hover:bg-gray-50 transition-colors duration-200">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@(item.item_number)</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@(item.item_name)</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600 font-mono">@( item.QRcode)</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@(item.created_at)</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@(item.updated_at)</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                        <button onclick="reprintLabel(@item.id)" class="badge badge-dark py-2 px-3 text-[13px] text-white hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-all duration-200">
                                            Re-Print
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="px-6 py-10 text-center text-sm text-gray-500">
                                    Belum ada data QR yang tersimpan.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="printerFormModal" class="fixed inset-0 bg-gray-900 bg-opacity-60 overflow-y-auto h-full w-full hidden backdrop-blur-sm">
        <div class="relative top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 p-6 border w-full max-w-lg shadow-2xl rounded-xl bg-white transform transition-all">
            <div class="flex items-center space-x-3 pb-4 border-b border-gray-200">
                <span id="modalIcon" class="text-blue-500 bg-blue-100 p-2 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                    </svg>
                </span>
                <p id="modalTitle" class="text-xl font-semibold text-gray-800"></p>
                <button class="modal-close-btn cursor-pointer z-50 absolute top-4 right-4 text-gray-400 hover:text-gray-700 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="mt-4">
                <form id="printerForm">
                    <input type="hidden" id="printerId" name="id">
                    <input type="hidden" id="formMode" name="mode">

                    <div class="space-y-5">

                        <div>
                            <label for="printerName" class="block text-sm font-medium text-gray-600 mb-1.5">Printer Name</label>
                            <div class="relative">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
                                </div>
                                <input type="text" id="printerName" name="printer_name" class="block w-full rounded-lg border-gray-300 bg-gray-50 pl-10 py-2.5 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition duration-150" required placeholder="Contoh: Printer Gudang A">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-600 mb-2">Tipe Koneksi</label>
                            <div class="flex items-center space-x-6">
                                <div class="flex items-center">
                                    <input id="typeTcp" type="radio" name="connection_type" value="tcp" class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" checked>
                                    <label for="typeTcp" class="ml-2 block text-sm text-gray-900">TCP/IP</label>
                                </div>
                                <div class="flex items-center">
                                    <input id="typeShared" type="radio" name="connection_type" value="shared" class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500">
                                    <label for="typeShared" class="ml-2 block text-sm text-gray-900">Shared Printer</label>
                                </div>
                            </div>
                        </div>

                        <div id="tcpFields" class="space-y-5">
                            <div class="flex flex-col sm:flex-row gap-4">
                                <div class="w-full sm:w-2/3">
                                    <label for="printerIp" class="block text-sm font-medium text-gray-600 mb-1.5">IP Address</label>
                                    <div class="relative">
                                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9V3m0 18a9 9 0 009-9m-9 9a9 9 0 00-9-9" /></svg>
                                        </div>
                                        <input type="text" id="printerIp" name="printer_ip" class="block w-full rounded-lg border-gray-300 bg-gray-50 pl-10 py-2.5 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition duration-150" placeholder="192.168.1.100">
                                    </div>
                                </div>
                                <div class="w-full sm:w-1/3">
                                    <label for="printerPort" class="block text-sm font-medium text-gray-600 mb-1.5">Port</label>
                                    <div class="relative">
                                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" /></svg>
                                        </div>
                                        <input type="number" id="printerPort" name="port" class="block w-full rounded-lg border-gray-300 bg-gray-50 pl-10 py-2.5 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition duration-150" placeholder="9100">
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div id="sharedFields" class="hidden">
                            <label for="printerSharePath" class="block text-sm font-medium text-gray-600 mb-1.5">Printer Share Path (UNC)</label>
                            <div class="relative">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path d="M5 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H7a2 2 0 01-2-2V5zm0 7a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H7a2 2 0 01-2-2v-2zm9-7a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zm0 7a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                                </div>
                                <input type="text" id="printerSharePath" name="shared_printer" class="block w-full rounded-lg border-ray-300 bg-gray-50 pl-10 py-2.5 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition duration-150" placeholder="\\NAMA-PC\NamaSharePrinter">
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="mt-3">
                            <button type="button" id="checkConnectionBtn" class="w-full sm:w-auto bg-gray-600 hover:bg-gray-700 text-white font-semibold py-2 px-4 rounded-lg shadow-sm transition-all duration-150 flex items-center justify-center gap-2">
                                <span id="checkBtnIcon" class="fas fa-network-wired"></span>
                                <span id="checkBtnText">Check Connection</span>
                            </button>
                        </div>
                    </div>

                    <div class="flex items-center justify-end pt-6 border-t border-gray-200 mt-6 space-x-3">
                        <button type="button" class="modal-close-btn w-full sm:w-auto bg-white hover:bg-gray-100 text-gray-700 font-semibold py-2 px-5 rounded-lg border border-gray-300 shadow-sm transition-all duration-150">
                            Cancel
                        </button>
                        <button id="submitBtn" type="submit" class="text-white font-semibold w-full sm:w-auto py-2 px-5 rounded-lg shadow-sm transition-all duration-150"></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div id="deletePrinterModal" class="fixed inset-0 bg-gray-900 bg-opacity-60 overflow-y-auto h-full w-full hidden backdrop-blur-sm">
        <div class="relative top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 p-6 border w-full max-w-md shadow-2xl rounded-xl bg-white transform transition-all">

            <button class="modal-close-btn cursor-pointer z-50 absolute top-4 right-4 text-gray-400 hover:text-gray-700 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <div class="justify-center">
                <div class="mx-auto flex h-24 w-24 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0">
                    <svg class="h-16 w-16 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z" />
                    </svg>
                </div>

                <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                    <h3 class="text-lg font-semibold leading-6 text-gray-900" id="modal-title">Confirm Deletion</h3>
                    <div class="mt-2">
                        <p class="text-sm text-gray-600">
                            Are you sure you want to delete the printer
                            <strong id="deletePrinterName" class="font-medium text-gray-800"></strong>?
                            <br>
                            <span class="font-medium text-red-500">This action cannot be undone.</span>
                        </p>
                    </div>
                </div>
            </div>

            <form id="deletePrinterForm" class="mt-4 sm:mt-5 sm:flex sm:flex-row-reverse sm:space-x-2 sm:space-x-reverse justify-content-center">
                <input type="hidden" id="deletePrinterId" name="id">
                <button type="submit" class="inline-flex w-full justify-center rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:w-auto transition-all duration-150">
                    Yes, Delete
                </button>
                <button type="button" class="modal-close-btn inline-flex w-full justify-center rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto transition-all duration-150">
                    Cancel
                </button>
            </form>

        </div>
    </div>

    <div id="changePrinterModal" class="fixed inset-0 bg-gray-900 bg-opacity-60 overflow-y-auto h-full w-full hidden backdrop-blur-sm">
        <div class="relative top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 p-6 border w-full max-w-md shadow-2xl rounded-xl bg-white transform transition-all">

            <button class="change-modal-close-btn cursor-pointer z-50 absolute top-4 right-4 text-gray-400 hover:text-gray-700 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <div class="justify-center">
                <div class="mx-auto flex h-24 w-24 flex-shrink-0 items-center justify-center rounded-full bg-blue-100 sm:mx-0">
                    <svg class="h-16 w-16 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
                    </svg>
                </div>

                <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                    <h3 class="text-lg font-semibold leading-6 text-gray-900">Confirm Change</h3>
                    <div class="mt-2">
                        <p class="text-sm text-gray-600">
                            Are you sure you want to set
                            <strong id="changePrinterName" class="font-medium text-gray-800"></strong>
                            as the default printer?
                        </p>
                    </div>
                </div>
            </div>

            <form id="changePrinterForm" class="mt-4 sm:mt-5 sm:flex sm:flex-row-reverse sm:space-x-2 sm:space-x-reverse justify-content-center">
                <input type="hidden" id="changePrinterId" name="id">
                <button type="submit" class="inline-flex w-full justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 sm:w-auto transition-all duration-150">
                    Yes, Change
                </button>
                <button type="button" class="change-modal-close-btn inline-flex w-full justify-center rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto transition-all duration-150">
                    Cancel
                </button>
            </form>

        </div>
    </div>

</body>




<script>


    @if (qrResult != null && qrResult.Any())
    {
        @:if (document.getElementById("filter-table") && typeof simpleDatatables !== 'undefined') {
            @:const dataTable = new simpleDatatables.DataTable("#filter-table");
        @:}
    }

    let mode = 'add';
    document.addEventListener('DOMContentLoaded', function () {

        // --- Seleksi Elemen ---
        const printerFormModal = document.getElementById('printerFormModal');
        const deletePrinterModal = document.getElementById('deletePrinterModal');
        const modalTitle = document.getElementById('modalTitle');
        const submitBtn = document.getElementById('submitBtn');
        const printerForm = document.getElementById('printerForm');
        const deletePrinterForm = document.getElementById('deletePrinterForm');
        const addPrinterBtn = document.getElementById('addPrinterBtn');
        const printerTable = document.querySelector('.min-w-full');
        const allCloseBtns = document.querySelectorAll('.modal-close-btn');

        // --- Elemen Baru ---
        const checkConnectionBtn = document.getElementById('checkConnectionBtn');
        const checkBtnIcon = document.getElementById('checkBtnIcon');
        const checkBtnText = document.getElementById('checkBtnText');
        const printerIpInput = document.getElementById('printerIp');
        const printerPortInput = document.getElementById('printerPort');

        const connectionTypeRadios = document.querySelectorAll('input[name="connection_type"]');
        const tcpFields = document.getElementById('tcpFields');
        const sharedFields = document.getElementById('sharedFields');
        const printerSharePathInput = document.getElementById('printerSharePath');

        function togglePrinterFields() {
            // Cari tahu radio button mana yang sedang dipilih
            const selectedType = document.querySelector('input[name="connection_type"]:checked').value;
            resetCheckButton();
            if (selectedType === 'tcp') {
                // Jika TCP/IP dipilih:
                // Tampilkan kolom TCP dan sembunyikan kolom Shared
                tcpFields.classList.remove('hidden');
                sharedFields.classList.add('hidden');

                // Jadikan input TCP 'required' dan hapus 'required' dari Shared
                printerIpInput.required = true;
                printerPortInput.required = true;
                printerSharePathInput.required = false;
                // Kosongkan nilai input shared agar tidak terkirim
                printerSharePathInput.value = '';

            } else if (selectedType === 'shared') {
                // Jika Shared Printer dipilih:
                // Sembunyikan kolom TCP dan tampilkan kolom Shared
                tcpFields.classList.add('hidden');
                sharedFields.classList.remove('hidden');

                // Jadikan input Shared 'required' dan hapus 'required' dari TCP
                printerIpInput.required = false;
                printerPortInput.required = false;
                printerSharePathInput.required = true;
                // Kosongkan nilai input TCP agar tidak terkirim
                printerIpInput.value = '';
                printerPortInput.value = '';
            }
        }

        // Tambahkan event listener untuk setiap radio button
        connectionTypeRadios.forEach(radio => {
            radio.addEventListener('change', togglePrinterFields);
        });

        togglePrinterFields();



    // --- Fungsi Modal ---
    function openModal(modal) {
        if (modal) modal.classList.remove('hidden');
    }

    function closeModal(modal) {
        if (modal) modal.classList.add('hidden');
    }

    function setupModal(mode, data = null) {
        printerForm.reset();
        document.getElementById('formMode').value = mode;

        // --- Modifikasi: Nonaktifkan tombol submit saat modal dibuka ---
        submitBtn.disabled = true;
        resetCheckButton();
        submitBtn.className = 'w-full sm:w-auto text-gray-400 font-semibold py-2 px-5 rounded-lg shadow-sm transition-all duration-150 bg-gray-100';
        modeForm = mode;
        if (mode === 'add') {
            modalTitle.textContent = 'Add New Printer';
            submitBtn.textContent = 'Save Printer';
            document.getElementById('printerId').value = '';
        } else if (mode === 'edit') {
            modalTitle.textContent = 'Edit Printer';
            submitBtn.textContent = 'Update Printer';
            document.getElementById('printerId').value = data.id;
            document.getElementById('printerName').value = data.name;
            printerIpInput.value = data.ip;
            printerPortInput.value = data.port;
        }
        openModal(printerFormModal);
    }

    function resetCheckButton() {
        checkConnectionBtn.disabled = false;
        checkConnectionBtn.className = "w-full sm:w-auto bg-gray-600 hover:bg-gray-700 text-white font-semibold py-2 px-4 rounded-lg shadow-sm transition-all duration-150 flex items-center justify-center gap-2";
        checkBtnIcon.className = "fas fa-network-wired";
        checkBtnText.textContent = "Check Connection";
        submitBtn.disabled = true;
        submitBtn.className = 'w-full sm:w-auto text-gray-400 font-semibold py-2 px-5 rounded-lg shadow-sm transition-all duration-150 bg-gray-100';
    }

    // --- Event Listeners Lama (tidak banyak berubah) ---
    if (addPrinterBtn) {
        addPrinterBtn.addEventListener('click', () => setupModal('add'));
    }
    if (printerTable) {
        printerTable.addEventListener('click', function (e) {
            const editBtn = e.target.closest('.edit-printer-btn');
            const deleteBtn = e.target.closest('.delete-printer-btn');
            if (editBtn) setupModal('edit', editBtn.dataset);
            if (deleteBtn) {
                document.getElementById('deletePrinterId').value = deleteBtn.dataset.id;
                document.getElementById('deletePrinterName').textContent = `"${deleteBtn.dataset.name}"`;
                openModal(deletePrinterModal);
            }
        });
    }
    allCloseBtns.forEach(btn => {
        btn.addEventListener('click', () => closeModal(btn.closest('.fixed')));
    });
    window.addEventListener('click', (event) => {
        if (event.target === printerFormModal) closeModal(printerFormModal);
        if (event.target === deletePrinterModal) closeModal(deletePrinterModal);
    });

    // --- FUNGSI BARU: Event Listener untuk Tombol Cek Koneksi ---
    checkConnectionBtn.addEventListener('click', async function() {
        const ip = printerIpInput.value;
        const port = printerPortInput.value;
        const sharedPrinter = printerSharePathInput.value;

        const selectedType = document.querySelector('input[name="connection_type"]:checked').value;

        if (selectedType == 'tcp') {
            if (!ip && !port) {
                Swal.fire('Input Required', 'Please enter both IP Address and Port .', 'warning');
                return;
            }
        } else {
            if (!sharedPrinter) {
                Swal.fire('Input Required', 'Please enter both Shared Printer Path .', 'warning');
                return;
            }
        }


        checkConnectionBtn.disabled = true;
        checkBtnIcon.className = "fas fa-spinner fa-spin";
        checkBtnText.textContent = "Checking...";
        submitBtn.disabled = true;


        const url = "@Url.Action("CheckingPrinter", "Sparepart", new { area = "SCM" })";
        const requestData = { ip: ip, port: parseInt(port), shared_printer: sharedPrinter };

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(requestData)
            });
            const data = await response.json();

            if (data.success) {
                checkConnectionBtn.className = "w-full sm:w-auto bg-green-600 text-white font-semibold py-2 px-4 rounded-lg shadow-sm flex items-center justify-center gap-2";
                checkBtnIcon.className = "fas fa-check-circle";
                checkBtnText.textContent = "Connected";
                submitBtn.disabled = false;
                if (modeForm === 'add') {
                    submitBtn.className = 'w-full sm:w-auto text-white font-semibold py-2 px-5 rounded-lg shadow-sm transition-all duration-150 bg-blue-600 hover:bg-blue-700';
                } else if (modeForm === 'edit') {
                    submitBtn.className = 'w-full sm:w-auto text-white font-semibold py-2 px-5 rounded-lg shadow-sm transition-all duration-150 bg-yellow-500 hover:bg-yellow-600';
                }
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Printer is Online!', showConfirmButton: false, timer: 2000 });
            } else {
                // Jika koneksi gagal
                checkConnectionBtn.disabled = false;
                checkConnectionBtn.className = "w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg shadow-sm transition-all duration-150 flex items-center justify-center gap-2";
                checkBtnIcon.className = "fas fa-sync-alt";
                checkBtnText.textContent = "Try Again";
                Swal.fire('Connection Failed', data.message, 'error');
            }
        } catch (error) {
            checkConnectionBtn.disabled = false;
            resetCheckButton();
            Swal.fire('Request Error', 'Could not connect to the server.', 'error');
        }
    });

    // --- FUNGSI BARU: Reset status jika IP atau Port diubah ---
    printerIpInput.addEventListener('input', () => {
        submitBtn.disabled = true;
        resetCheckButton();
    });
    printerPortInput.addEventListener('input', () => {
        submitBtn.disabled = true;
        resetCheckButton();
    });

        printerForm.addEventListener('submit', function (e) {
            e.preventDefault();
            mode = document.getElementById('formMode').value;

            const urlTemplate = '@Url.Action("ACTION_PLACEHOLDER", "Sparepart", new { area = "SCM" })';

            const controllerFunction = (mode === 'add') ? `CreatePrinter` : `EditPrinter`;

            const url = urlTemplate.replace('ACTION_PLACEHOLDER', controllerFunction);

            const formData = new FormData(printerForm);
            const printerData = Object.fromEntries(formData.entries());

            Swal.fire({
                title: 'Processing...',
                text: 'Please wait while we save the data.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(printerData)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        closeModal(printerFormModal);
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: data.message,
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: data.message || 'An unknown error occurred.',
                        });
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Request Failed',
                        text: 'Could not connect to the server. Please check your connection.',
                    });
                    console.error('Error:', error);
                });
        });

        deletePrinterForm.addEventListener('submit', function (e) {
            e.preventDefault();
            const printerId = document.getElementById('deletePrinterId').value;
            const url = "@Url.Action("DeletePrinter", "Sparepart", new { area = "SCM" })";

            Swal.fire({
                title: 'Deleting...',
                text: 'Please wait.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({
                    'id': printerId
                })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        closeModal(deletePrinterModal);
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: data.message,
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Deletion Failed',
                            text: data.message || 'Could not delete the printer.',
                        });
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'error',
                        title: 'Request Failed',
                        text: 'Could not connect to the server.',
                    });
                    console.error('Error:', error);
                });
        });
    });

   const mainTriggerButton = document.getElementById('changePrintButton');

    const changeModal = document.getElementById('changePrinterModal');
    const changeForm = document.getElementById('changePrinterForm');
    const changePrinterNameSpan = document.getElementById('changePrinterName');
    const changePrinterIdInput = document.getElementById('changePrinterId');
    const changeCloseButtons = document.querySelectorAll('.change-modal-close-btn');

    const openChangeModal = (id, name) => {
        changePrinterNameSpan.textContent = name;
        changePrinterIdInput.value = id;
        changeModal.classList.remove('hidden');
    };

    const closeChangeModal = () => {
        changeModal.classList.add('hidden');
    };

    mainTriggerButton.addEventListener('click', (e) => {
        e.preventDefault();

        const printerSelect = document.getElementById('selectPrinter');
        const selectedId = printerSelect.value;
        const selectedOption = printerSelect.options[printerSelect.selectedIndex];

        if (!selectedId) {
            Swal.fire('Peringatan', 'Silakan pilih printer terlebih dahulu.', 'warning');
            return;
        }

        const selectedName = selectedOption.text;
        openChangeModal(selectedId, selectedName);
    });

    changeCloseButtons.forEach(button => {
        button.addEventListener('click', (e) => {
            e.preventDefault();
            closeChangeModal();
        });
    });

    changeForm.addEventListener('submit', function(e) {
        e.preventDefault();

        const printerId = changePrinterIdInput.value;
        const url = "@Url.Action("ChangePrinter", "Sparepart", new { area = "SCM" })";

        Swal.fire({
            title: 'Changing Printer...',
            text: 'Please wait.',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams({
                'id': printerId,
            })
        })
        .then(response => response.json())
        .then(data => {
            closeChangeModal();
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: data.message,
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Operation Failed',
                    text: data.message || 'Could not change the default printer.',
                });
            }
        })
        .catch(error => {
            closeChangeModal();
            Swal.fire({
                icon: 'error',
                title: 'Request Failed',
                text: 'Could not connect to the server.',
            });
            console.error('Error:', error);
        });
    });

    async function reprintLabel(QrResultId) {
    const result = await Swal.fire({
        title: 'Konfirmasi',
        text: "Apakah Anda yakin ingin mencetak ulang label ini?",
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Ya, Cetak Ulang!'
    });

    // Jika pengguna menekan tombol "Ya"
    if (result.isConfirmed) {

        // Tampilkan notifikasi loading
        Swal.fire({
            title: 'Processing...',
            text: 'Mengirim data ke printer, mohon tunggu.',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        try {
            const url = '@Url.Action("RePrint", "Sparepart", new { area = "SCM" })';
            // Ganti 'YourControllerName' dengan nama Controller Anda yang sebenarnya
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({
                    'id': QrResultId,
                })
            });

            const data = await response.json();

            if (data.success) {
                Swal.fire(
                    'Berhasil!',
                    data.message,
                    'success'
                );
            } else {
                Swal.fire(
                    'Gagal!',
                    data.message,
                    'error'
                );
            }

        } catch (error) {
            Swal.fire(
                'Error!',
                'Terjadi kesalahan saat menghubungi server.',
                'error'
            );
            console.error('Error:', error);
        }
    }
}

</script>
