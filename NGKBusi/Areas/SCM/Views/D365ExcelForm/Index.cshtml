    <script>
        $('#formAffiliateEDI').on('submit', function (e) {
            e.preventDefault(); // Mencegah form reload halaman

            var $form = $(this);
            var formData = new FormData(this);

            var $btnSubmit = $('#btnSubmit');
            var $progressContainer = $('#uploadProgress');
            var $progressBar = $('#uploadProgressBar');
            var $alert = $('#uploadAlert');

            // 1. Reset UI (Tampilan Loading)
            $btnSubmit.prop('disabled', true).text('Memproses...');
            $progressContainer.show();
            $progressBar.removeClass('bg-danger').addClass('bg-success').css('width', '0%').text('0%');
            $alert.hide().removeClass('alert-success alert-danger'); // Sembunyikan alert lama

            $.ajax({
                url: $form.attr('action'),
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                xhrFields: {
                    responseType: 'blob' // Wajib agar bisa menerima file CSV dari Controller
                },
                xhr: function () {
                    var xhr = new window.XMLHttpRequest();
                    // Menangkap event upload progress
                    xhr.upload.addEventListener("progress", function (evt) {
                        if (evt.lengthComputable) {
                            var percentComplete = Math.round((evt.loaded / evt.total) * 100);
                            $progressBar.css('width', percentComplete + '%').text(percentComplete + '%');

                            if (percentComplete === 100) {
                                $progressBar.text('Mengonversi Excel...');
                            }
                        }
                    }, false);
                    return xhr;
                },
                success: function (data, status, xhr) {
                    // Mengecek apakah kembaliannya berupa file CSV (Attachment)
                    var disposition = xhr.getResponseHeader('Content-Disposition');

                    if (disposition && disposition.indexOf('attachment') !== -1) {
                        // SUKSES! 
                        // Ambil nama file dari C# (Contoh: ID-000018049.csv)
                        var filename = "Download.csv";
                        var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                        var matches = filenameRegex.exec(disposition);
                        if (matches != null && matches[1]) {
                            filename = matches[1].replace(/['"]/g, '');
                        }

                        // Download file secara otomatis
                        var blob = new Blob([data], { type: 'text/csv' });
                        var downloadUrl = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = downloadUrl;
                        a.download = filename;
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(downloadUrl);
                        a.remove();

                        // Update UI Sukses
                        $progressBar.text('Selesai!');
                        $alert.addClass('alert-success').html('<strong>Berhasil!</strong> File CSV telah diunduh.').show();

                        // (Opsional) Kosongkan input file agar siap dipakai lagi
                        $('#inputFile').val('');

                    } else {
                        // GAGAL dari Controller (Contoh: Masuk ke catch(Exception ex) dan return Json)
                        var reader = new FileReader();
                        reader.onload = function () {
                            try {
                                var json = JSON.parse(reader.result);
                                $alert.addClass('alert-danger').html('<strong>Gagal!</strong> ' + json.message).show();
                            } catch (err) {
                                $alert.addClass('alert-danger').html('<strong>Gagal!</strong> Terjadi kesalahan sistem.').show();
                            }
                        };
                        reader.readAsText(data);

                        $progressBar.removeClass('bg-success').addClass('bg-danger').text('Gagal');
                    }
                },
                error: function (xhr, status, error) {
                    // ERROR Jaringan / Server Mati
                    $alert.addClass('alert-danger').html('<strong>Gagal!</strong> Terjadi kesalahan jaringan atau server error.').show();
                    $progressBar.removeClass('bg-success').addClass('bg-danger').text('Error');
                },
                complete: function () {
                    // Mengembalikan tombol "Impor" seperti semula
                    $btnSubmit.prop('disabled', false).text('Impor');
                }
            });
        });
        $('#FormUploadStock').on('submit', (function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                type: 'POST',
                url: $(this).attr('action'),
                data: formData,
                cache: false,
                contentType: false,
                processData: false,
                beforeSend: function () {
                    $('.loading').css("display", "");
                },
                success: function (json) {
                    $('.loading').css("display", "none");
                    // SweetAlert2 success
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: (json && json.msg) ? json.msg : 'Operation completed'
                    });
                },
                error: function (data) {
                    console.log("error");
                    $('.loading').css("display", "none");
                    var errMsg = (data && data.responseJSON && data.responseJSON.msg) ? data.responseJSON.msg : 'An error occurred';
                    // SweetAlert2 error
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed!',
                        text: errMsg
                    });
                },
                complete: function (data) {

                }
            });
        }));

