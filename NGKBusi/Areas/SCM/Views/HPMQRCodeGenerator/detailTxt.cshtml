    <script>
        $(document).ready(function () {
            const slides = $('.printable-page');
            const totalSlides = slides.length;
            let currentIndex = 0;

            const sliderWrapper = $('#slider-wrapper');
            const pageCounter = $('#page-counter');
            const prevButton = $('#prev-button');
            const nextButton = $('#next-button');

            function showSlide(index) {
                // Pindahkan wrapper sejauh -index * 100%
                sliderWrapper.css('transform', `translateX(-${index * 100}%)`);
                // Perbarui text counter
                pageCounter.text(`Halaman ${index + 1} dari ${totalSlides}`);

                // Atur visibilitas tombol prev/next
                prevButton.prop('disabled', index === 0);
                nextButton.prop('disabled', index === totalSlides - 1);
            }

            // Inisialisasi slider
            showSlide(currentIndex);

            // Event listener untuk tombol next
            nextButton.on('click', function () {
                if (currentIndex < totalSlides - 1) {
                    currentIndex++;
                    showSlide(currentIndex);
                }
            });

            // Event listener untuk tombol prev
            prevButton.on('click', function () {
                if (currentIndex > 0) {
                    currentIndex--;
                    showSlide(currentIndex);
                }
            });

            // Logika untuk generate QR Code dan Barcode untuk setiap halaman
           let cardCounter = 0;

        // Ambil semua data dari ViewBag dalam bentuk array JSON
        const allData = @Html.Raw(Json.Encode(ViewBag.detail));

        // Loop setiap halaman/slide
        $('.printable-page').each(function(pageIndex) {
            // Loop setiap 'card-label' di dalam halaman ini
            $(this).find('.card-label').each(function (cardIndexInPage) {
                cardCounter++; // Naikkan counter agar sinkron dengan ID di HTML

                // Ambil data yang sesuai untuk kartu ini
                const itemData = allData[pageIndex][cardIndexInPage];

                const qrcodeContainer = $(`#qrcode-container-${cardCounter}`);
                if (qrcodeContainer.length && itemData.qr_code) {
                    new QRCode(qrcodeContainer[0], {
                        text: itemData.qr_code,
                        width: 37.5,
                        height: 37.5,
                        correctLevel: QRCode.CorrectLevel.M
                    });
                }

                // --- Generate Barcode ---
                const barcodeElement = $(`#barcode-generator-${cardCounter}`);
                if (barcodeElement.length && itemData.barcode_no) {
                    console.log('✅ Mencoba generate barcode...');
                    try {
                        JsBarcode(barcodeElement[0], itemData.barcode_no, {
                            format: "CODE39",
                            mod43: true,
                            width: 0.635,
                            height: 35,
                            displayValue: true,
                            text: itemData.barcode_no,
                            fontSize: 12,
                            textAlign: "center",
                            margin: 0
                        });
                    } catch (e) {
                        console.error('❌ JsBarcode GAGAL:', e); // Menangkap error spesifik dari JsBarcode
                    }
                }
            });
        });

            // Logika Tombol Cetak
            $('#print-button').on('click', function () {

                $('#slider-wrapper').printThis({
                    importCSS: true,
                    importStyle: true,
                    loadCSS: "",
                    pageTitle: "Parts Contents Card",
                });
            });
        });
    </script>
</body>