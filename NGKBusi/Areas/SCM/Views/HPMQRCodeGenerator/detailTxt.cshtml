@{
    ViewBag.Title = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Counter untuk membuat ID unik pada setiap halaman
    int pageCounter = 0;
    int cardCounter = 0;
    int cardByPage = 0;
}

@section scriptHead {
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.3/themes/base/jquery-ui.css">

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/printThis/1.15.0/printThis.min.js"></script>

    <style>
        .main-barcode, .hanko-barcode {
            width: 100%;
            height: auto;
        }

        td {
            padding: 0;
        }

        /* Styling untuk Slider */
        #slider-container {
            width: 21cm;
            overflow: hidden;
            margin: auto;
            padding: 0;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        #slider-wrapper {
            display: flex;
            transition: transform 0.5s ease-in-out; /* Animasi geser */
        }

        .printable-page {
            flex-shrink: 0; /* Mencegah slide menyusut */
            width: 100%;
        }

        /* Sembunyikan tombol navigasi dan print saat mencetak */
        @@media print {
            body {
                margin: 0;
                padding: 0;
            }

            .no-print {
                display: none !important;
            }

            #slider-container {
                /* Hapus overflow hidden agar semua halaman terlihat saat print */
                overflow: visible !important;
                border: none !important;
                box-shadow: none !important;
            }

            #slider-wrapper {
                /* **INI KUNCI UTAMANYA** */
                /* Ubah dari flex (menyamping) menjadi block (ke bawah) */
                display: block !important;
                /* Hapus efek geser dari JavaScript */
                transform: none !important;
            }

            .printable-page {
                width: 21cm;
                height: 29.7cm;
                padding: 1.2cm;
                page-break-after: always;
            }
        }
    </style>
}

