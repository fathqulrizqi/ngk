@{
    ViewBag.Title = "Data";
    Layout = null;
    Response.ContentType = "text/xml";
    var enc = new Func<object, string>(v => System.Web.HttpUtility.HtmlEncode(v?.ToString() ?? ""));
}
<data>
    @foreach (var myevent in ViewBag.events)
    {
        <event id="@(enc(myevent.id))">
            <start_date>@(enc(myevent.start_date.ToString("MM/dd/yyyy HH:mm")))</start_date>
            <end_date>@(enc(myevent.end_date.ToString("MM/dd/yyyy HH:mm")))</end_date>
            <text>@(enc(myevent.text))</text>
            <type>@(enc(myevent.type))</type>
        </event>
    }
</data>

