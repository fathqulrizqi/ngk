@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = "Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-content {
        background: linear-gradient(135deg, #1E555C 10%, #fefee3 100%);
        padding-top: 0 !important;
        margin-top: 0 !important;
    }

    .error-page-wrapper {
        background-size: cover;
        background-position: center;
        min-height: 85vh; 
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .niterra-error-card {
        background-color: #fff;
        border-radius: 4px; 
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        width: 100%;
        max-width: 600px;
        overflow: hidden;
        text-align: center;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Header Biru (Meniru header 'Task List') */
    .niterra-card-header {
        background-color: #007bff; /* Warna biru Niterra (sesuaikan jika perlu, misal #009efb) */
        color: white;
        padding: 15px;
        font-weight: bold;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .niterra-card-body {
        padding: 40px 30px;
    }

    .error-icon-svg {
        margin-bottom: 20px;
        color: #007bff; /* Icon mengikuti warna tema */
    }

    .error-title-text {
        font-size: 1.5rem;
        color: #333;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .error-desc-text {
        color: #666;
        margin-bottom: 30px;
        font-size: 1rem;
        line-height: 1.5;
    }

    .btn-niterra {
        background-color: #007bff;
        color: white;
        padding: 10px 30px;
        border-radius: 4px;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.3s;
        display: inline-block;
    }

        .btn-niterra:hover {
            background-color: #0056b3;
            color: white;
            text-decoration: none;
        }

    .tech-details-box {
        margin-top: 30px;
        padding: 15px;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 4px;
        text-align: left;
        font-size: 0.85rem;
        color: #555;
    }
</style>

<div class="error-page-wrapper">

    <div class="niterra-error-card">
        <div class="niterra-card-header">
            System Notification
        </div>

        <div class="niterra-card-body">

            <div class="error-icon-svg">
                <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>

            <h3 class="error-title-text">Oops! Something Went Wrong.</h3>

            <p class="error-desc-text">
                We detected an unexpected system error.<br>
                Please try reloading or returning to the dashboard.
            </p>

            <a href="@Url.Action("Index", "Home")" class="btn-niterra">
                Back to Dashboard
            </a>

            @if (Model != null && HttpContext.Current.IsDebuggingEnabled)
            {
                <div class="tech-details-box">
                    <strong style="color:white;">Debug Info:</strong><br />
                    <span style="color: #ff6b6b;">@Model.Exception.Message</span>
                    <br />
                    <small style="color: #888;">Controller: @Model.ControllerName | Action: @Model.ActionName</small>
                </div>
            }
        </div>
    </div>

</div>