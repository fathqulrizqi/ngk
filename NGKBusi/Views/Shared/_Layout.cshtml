<script src="@Url.Content("~/Content/sweetalert2/sweetalert2.all.min.js")"></script>
<script>
    // SweetAlert2 compatibility shim for legacy SweetAlert v1 calls
    if (typeof Swal !== 'undefined') {
        window.swal = window.sweetalert = function (...args) {
            let callback = null;
            if (args.length > 0 && typeof args[args.length - 1] === 'function') {
                callback = args.pop();
            }

            if (args.length === 1 && typeof args[0] === 'object' && args[0] !== null) {
                const options = { ...args[0] };
                if (options.type && !options.icon) {
                    options.icon = options.type;
                }
                return Swal.fire(options).then((result) => {
                    if (callback) {
                        callback(result.isConfirmed);
                    }
                    return result;
                });
            }

            return Swal.fire(...args).then((result) => {
                if (callback) {
                    callback(result.isConfirmed);
                }
                return result;
            });
        };
    }
</script>

<script>
    // --- FUNGSI NOTIFIKASI SIGNALR (DITAMBAHKAN DARI KODE KEDUA) ---
    $(document).ready(function () {

        if ($.connection === undefined) {
            console.error("SignalR Library belum terload!");
            return;
        }

        var notifHub = $.connection.notificationHub;

        if (notifHub === undefined) {
            console.error("Hub 'notificationHub' tidak ditemukan! Cek Startup.cs atau HubName.");
            return;
        }

        // --- A. FUNGSI RENDER HTML ---
        function renderList(data) {
            var html = '';

            if (data.length === 0) {
                html = '<div class="text-center py-3 text-muted small">No notifications</div>';
            } else {
                $.each(data, function (i, item) {

                    var date = new Date(parseInt(item.CreatedDate.substr(6)));
                    var timeStr = date.toLocaleDateString() + ' ' + date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                    var iconHtml = '';
                    var msgLower = item.Message.toLowerCase();

                    // Tambahkan style CSS flexbox & ukuran statis agar icon presisi di tengah border
                    var centerStyle = 'display: inline-flex; align-items: center; justify-content: center;';

                    if (msgLower.includes("approve") || msgLower.includes("complete")) {
                        iconHtml = '<i class="fas fa-check text-success border border-success" style="' + centerStyle + '"></i>';
                    } else if (msgLower.includes("return") || msgLower.includes("revisi")) {
                        iconHtml = '<i class="fas fa-exclamation-triangle text-warning border border-warning" style="' + centerStyle + '"></i>';
                    } else {
                        iconHtml = '<i class="fas fa-exclamation text-info border border-info" style="' + centerStyle + '"></i>';
                    }

                    var bgStyle = item.IsRead ? '' : 'background-color: #e1f5fe;';

                    html += `
                    <a class="dropdown-item" href="javascript:void(0)" onclick="readAndRedirect(${item.ID}, '${item.LinkUrl}')" style="${bgStyle}; white-space: normal;">
                        <div class="notification-content d-flex align-items-start">
                            <div class="icon mr-2 mt-1">
                                ${iconHtml}
                            </div>
                            <div class="content">
                                <div class="notification-detail" style="font-size: 12px; line-height: 1.2;">
                                    <span class="font-weight-bold text-dark d-block mb-1">${item.senderNIK}</span>
                                    ${item.Message}
                                </div>
                                <div class="notification-time text-muted mt-1" style="font-size: 10px;">
                                    ${timeStr}
                                </div>
                            </div>
                        </div>
                    </a>
                    <div class="dropdown-divider m-0"></div>`;
                });
            }

            $('#notifContainer').html(html);
        }

        // --- B. UPDATE ANGKA BADGE ---
        function updateBadge(count) {
            var badge = $('#notifBadge');
            if (count > 0) {
                badge.text(count).show();
            } else {
                badge.hide();
            }
        }

        // --- C. LOAD DATA DARI SERVER ---
        function loadNotifications() {
            $.get('@Url.Action("GetNotifications", "Notification", new { area = "" })', function (res) {
                updateBadge(res.count);
                renderList(res.data);
            });
        }

        // --- D. SIGNALR REALTIME SETUP ---
        try {
            var notifHub = $.connection.notificationHub;

            // Request Notification Permission on load
            if (window.Notification && Notification.permission !== "granted" && Notification.permission !== "denied") {
                Notification.requestPermission();
            }

            function showHTML5Notification(title, message, url) {
                if (window.Notification && Notification.permission === "granted") {
                    var options = {
                        body: message,
                        icon: '/ngk-portal/favicon.ico', // Default app favicon path
                        silent: true
                    };
                    var notification = new Notification(title, options);
                    notification.onclick = function (event) {
                        event.preventDefault();
                        window.focus();
                        if (url) {
                            window.location.href = url;
                        }
                    };
                }
            }

            function playNotificationSound() {
                try {
                    var audio = new Audio('@Url.Content("~/Sound/mixkit-software-interface-remove-2576.wav")');
                    var playPromise = audio.play();
                    if (playPromise !== undefined) {
                        playPromise.catch(function(error) {
                            console.warn("Audio playback blocked by browser autoplay policy:", error);
                        });
                    }
                } catch (e) {
                    console.error("Audio playback error:", e);
                }
            }

            notifHub.client.broadcastNotif = function (sender, message, url) {
                console.log("🔥 PESAN DITERIMA DARI SERVER (broadcastNotif)!", { sender, message });

                loadNotifications();

                const Toast = Swal.mixin({
                    toast: true, position: 'top-end', showConfirmButton: false, timer: 10000
                });
                Toast.fire({ icon: 'info', title: sender + ' : '  + message });

                showHTML5Notification(sender, message, url);
                playNotificationSound();
            };

            notifHub.client.receiveNotification = function (message) {
                console.log("🔥 PESAN DITERIMA DARI SERVER (receiveNotification)!", message);

                loadNotifications();

                const Toast = Swal.mixin({
                    toast: true, position: 'top-end', showConfirmButton: false, timer: 10000
                });
                Toast.fire({ icon: 'info', title: 'New System Request : ' + message });

                showHTML5Notification("Portal Notification", message, "/ngk-portal/IT/RequestSystem/RequestList");
                playNotificationSound();
            };

            $.connection.hub.logging = true;

            $.connection.hub.start()
                .done(function () { console.log("✅ SignalR TERHUBUNG! Connection ID: " + $.connection.hub.id); })
                .fail(function (err) { console.error("❌ SignalR GAGAL KONEK: " + err); });

        } catch (e) {
            console.error("SignalR Error: ", e);
        }

        // --- E. EVENT LISTENER ---
        loadNotifications();

        $('#dropdownMenuNotification').click(function() {
            loadNotifications();
        });

        window.readAndRedirect = function(id, url) {
            $.post('@Url.Action("MarkAsRead", "Notification", new { area = "" })', { id: id }, function() {
                window.location.href = url;
            });
        };
    });

