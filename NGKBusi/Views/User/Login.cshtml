@using NGKBusi.Models
@using NGKBusi.Controllers

@model Users

@{
    ViewBag.Title = "Log in";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!--===============================================================================================-->
    <link rel="icon" type="image/png" href="images/icons/favicon.ico" />
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/bootstrap/css/bootstrap.min.css")">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/font-awesome/css/font-awesome.min.css")">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/Login_v18/fonts/Linearicons-Free-v1.0.0/icon-font.min.css")">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/Login_v18/vendor/animate/animate.css")">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/Login_v18/vendor/css-hamburgers/hamburgers.min.css")">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/Login_v18/vendor/animsition/css/animsition.min.css")">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/Login_v18/vendor/select2/select2.min.css")">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/Login_v18/vendor/daterangepicker/daterangepicker.css")">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/Login_v18/css/util.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/Content/Login_v18/css/main.css?v=2")">
    <!--===============================================================================================-->
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <style>
        .img_qrcode {
            bottom: 8px;
            max-width:45%;
            margin-top:5%
        }
        @@keyframes zoomInPop {
            0% {
                opacity: 0;
                /* Mulai sangat kecil (scale 0.3), translate dipertahankan agar dari pusat */
                transform: translate(-50%, -50%) scale(0.3);
            }

            70% {
                /* Sedikit lebih besar dari ukuran akhir untuk efek "pop" */
                transform: translate(-50%, -50%) scale(1.05);
            }

            100% {
                opacity: 1;
                /* Ukuran asli (scale 1) dan posisi tetap di tengah */
                transform: translate(-50%, -50%) scale(1);
            }
        }

        /* Terapkan animasi ke elemen alert */
        #cyber-security-alert {
            /* Gunakan animasi baru, tambahkan sedikit durasi untuk efek yang lebih terasa */
            animation: zoomInPop 1s ease-out forwards;
        }

        .lang-btn {
            background: none;
            border: none;
            color: #fff;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
            padding: 2px 5px;
            opacity: 0.6;
        }

            .lang-btn.active {
                opacity: 1;
                border-bottom: 2px solid #e74c3c;
            }
    </style>
</head>
<body style="background-color: #666666;">

    <div class="limiter">
        <div class="container-login100">
            <div class="wrap-login100">

                @using (Html.BeginForm("Login", "User", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "login100-form validate-form", role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="ClientConnected" name="ClientConnected" value="false" />
                    <span class="login100-form-title p-b-43">
                        <img class="logo" src="@Url.Content("~/Images/niterra-id.png")" />
                    </span>

                    <span class="login100-form-title p-b-43">
                        Login to Portal
                    </span>

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="wrap-input100 validate-input" data-validate="User is required">
                        @Html.TextBoxFor(m => m.NIK, new { @class = "input100 has-val" })
                        <span class="focus-input100"></span>
                        <span class="label-input100">User</span>
                        @Html.ValidationMessageFor(m => m.NIK, "", new { @class = "text-danger" })
                    </div>

                    <div class="wrap-input100 validate-input" data-validate="Password is required">
                        @Html.PasswordFor(m => m.Password, new { @class = "input100 has-val", autocomplete = "off" })
                        <span class="focus-input100"></span>
                        <span class="label-input100">Password</span>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>
                    <div id="recaptcha-container" style="margin-top:10px; margin-bottom:10px; display:none;">
                        <div class="g-recaptcha" data-sitekey="6LfoyyoqAAAAAKg-ocYxO3S53_PysEXjvRQ_ycyQ"></div>
                    </div>
                    <!--<div class="flex-sb-m w-full p-t-3 p-b-32">
        <div class="contact100-form-checkbox">
            <input class="input-checkbox100" id="ckb1" type="checkbox" name="remember-me">
            <label class="label-checkbox100" for="ckb1">
                Remember me
            </label>
        </div>-->

                    @*<div>
                <a href="#" class="txt1">
                    Forgot Password?
                </a>
            </div>*@
                    <!--</div>-->

                    <div class="container-login100-form-btn">
                        <button class="login100-form-btn">
                            Login
                        </button>
                    </div>
                    <div class="w-100 mt-2 flex-shrink-0">
                        <div class="p-3 d-flex flex-column align-items-center justify-content-center position-relative overflow-hidden text-center shadow-lg"
                             style="background: linear-gradient(to bottom right, #0f172a, #1e293b); border-radius: 0.5rem;">

                            <div class="position-absolute w-100" style="top: 0; left: 0; height: 4px; background: linear-gradient(to right, #ef4444, #f97316, #eab308); opacity: 0.8;"></div>

                            <p class="text-uppercase font-weight-bold mb-1" style="font-size: 12px; color: #94a3b8; letter-spacing: 0.1em;">
                                Whistleblower System
                            </p>

                            <p class="mb-2" style="font-size: 12px; color: #cbd5e1; line-height: 1.4;">
                                Saluran Pengaduan Pelanggaran Anti Persaingan Usaha Tidak Sehat dan Anti Korupsi
                            </p>

                            <button onclick="window.open('https://forms.office.com/Pages/ResponsePage.aspx?id=IDr1UI_Qck6wlggdPyGI9YLRakx_7Q9Plz_YIFVMyT1UM01JWFVNUFdOTEZGQzVES0dJN0w0Sk0yMi4u', '_blank')"
                                    class="btn text-white shadow font-weight-bold px-4 py-2"
                                    style="font-size: 12px; border-radius: 50px; background: linear-gradient(to right, #ef4444, #f97316); border: none; transition: transform 0.2s ease-in-out;"
                                    onmouseover="this.style.transform='scale(1.05)'"
                                    onmouseout="this.style.transform='scale(1)'">
                                Submit Report
                            </button>
                        </div>
                    </div>


                }
                <div class="login100-more" style="background-image: url('../Images/6221846.jpg'); position: relative;">

                    <div id="cyber-security-alert" style="position: absolute; top: 35%; left: 50%; transform: translate(-50%, -50%); width: 85%; background: rgba(15, 15, 15, 0.70); padding: 35px 40px; border-radius: 8px; border-left: 6px solid #e74c3c; text-align: left; backdrop-filter: blur(5px); box-shadow: 0 15px 25px rgba(0,0,0,0.4); transition: opacity 0.4s ease; z-index: 10;">

                        <div style="position: absolute; top: 10px; left: 15px;">
                            <button class="lang-btn active" id="btn-en" onclick="setLanguage('en')">EN</button>
                            <button class="lang-btn" id="btn-id" onclick="setLanguage('id')">ID</button> |
                        </div>

                        <button type="button" id="close-alert-btn" style="position: absolute; top: 15px; right: 20px; background: transparent; border: none; color: #888; font-size: 18px; cursor: pointer;">
                            <i class="fa fa-times"></i>
                        </button>

                        <div>
                            <h3 id="alert-title" style="font-size: 22px; font-weight: bold; margin-bottom: 15px; color: #e74c3c; display: flex; align-items: center; margin-top: 10px;">
                                <i class="fa fa-shield" style="margin-right: 12px; font-size: 24px;"></i> Security Awareness Brief
                            </h3>

                            <p id="alert-intro" style="font-size: 15px; line-height: 1.6; color: #dcdcdc; margin-bottom: 12px;">
                                For the security of your data and the company, please observe the following guidelines:
                            </p>

                            <div style="display: flex; align-items: center;">
                                <ul style="font-size: 14.5px; line-height: 1.6; color: #dcdcdc; padding-left: 20px; margin-bottom: 0; text-align: justify;">
                                    <li style="margin-bottom: 10px;">
                                        <strong id="t1" style="color: #ffffff;">Credential Confidentiality:</strong> <span id="d1">Never share your password. Our IT team will never ask for it via phone, email, or text message.</span>
                                    </li>
                                    <li style="margin-bottom: 10px;">
                                        <strong id="t2" style="color: #ffffff;">Beware of Phishing:</strong> <span id="d2">Always verify the URL in your browser before entering login credentials. Do not click suspicious links from unknown emails.</span>
                                    </li>
                                    <li>
                                        <strong id="t3" style="color: #ffffff;">Malware Threats:</strong> <span id="d3">Exercise caution when downloading files or opening attachments from untrusted sources to prevent Malware or Ransomware infections.</span>
                                    </li>
                                </ul>
                                <div style="flex-shrink: 0;">
                                    <img src="@Url.Content("~/Images/Mascot-IT-Security-V3.png")" alt="Maskot IT Security" style="max-width: 300px; height: auto;" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!--===============================================================================================-->
    <script src="@Url.Content("~/Content/Login_v18/vendor/jquery/jquery-3.2.1.min.js")"></script>
    <!--===============================================================================================-->
    <script src="@Url.Content("~/Content/Login_v18/vendor/animsition/js/animsition.min.js")"></script>
    <!--===============================================================================================-->
    <script src="@Url.Content("~/Content/Login_v18/vendor/bootstrap/js/popper.js")"></script>
    <script src="@Url.Content("~/Content/Login_v18/vendor/bootstrap/js/bootstrap.min.js")"></script>
    <!--===============================================================================================-->
    <script src="@Url.Content("~/Content/Login_v18/vendor/select2/select2.min.js")"></script>
    <!--===============================================================================================-->
    <script src="@Url.Content("~/Content/Login_v18/vendor/daterangepicker/moment.min.js")"></script>
    <script src="@Url.Content("~/Content/Login_v18/vendor/daterangepicker/daterangepicker.js")"></script>
    <!--===============================================================================================-->
    <script src="@Url.Content("~/Content/Login_v18/vendor/countdowntime/countdowntime.js")"></script>
    <!--===============================================================================================-->
    <script src="@Url.Content("~/Content/Login_v18/js/main.js")"></script>

    <script>
        const translations = {
            id: {
                title: "Peringatan Keamanan",
                intro: "Demi keamanan data Anda dan perusahaan, mohon perhatikan pedoman berikut:",
                t1: "Kerahasiaan Kredensial:", d1: "Jangan pernah membagikan kata sandi Anda. Tim IT kami tidak akan pernah memintanya melalui telepon, email, maupun pesan teks.",
                t2: "Waspada Phishing:", d2: "Selalu periksa ulang alamat URL pada browser sebelum memasukkan data login. Jangan mengklik tautan mencurigakan dari email yang tidak dikenal.",
                t3: "Ancaman Malware:", d3: "Berhati-hatilah saat mengunduh (download) file atau membuka lampiran dari sumber yang tidak terpercaya untuk mencegah infeksi Malware atau Ransomware."
            },
            en: {
                title: "Security Awareness Brief",
                intro: "For the security of your data and the company, please observe the following guidelines:",
                t1: "Credential Confidentiality:", d1: "Never share your password. Our IT team will never ask for it via phone, email, or text message.",
                t2: "Beware of Phishing:", d2: "Always verify the URL in your browser before entering login credentials. Do not click suspicious links from unknown emails.",
                t3: "Malware Threats:", d3: "Exercise caution when downloading files or opening attachments from untrusted sources to prevent Malware or Ransomware infections."
            }
        };

        function setLanguage(lang) {
            localStorage.setItem('preferredLang', lang);
            
            // Update UI
            $('#alert-title').contents().filter(function(){ return this.nodeType == 3; }).remove(); 
            $('#alert-title').append(translations[lang].title);
            $('#alert-intro').text(translations[lang].intro);
            $('#t1').text(translations[lang].t1); $('#d1').text(translations[lang].d1);
            $('#t2').text(translations[lang].t2); $('#d2').text(translations[lang].d2);
            $('#t3').text(translations[lang].t3); $('#d3').text(translations[lang].d3);
            
            // Style active button
            $('.lang-btn').removeClass('active');
            $('#btn-' + lang).addClass('active');
        }
        $('document').ready(function () {
            $('.input100').val("");

            var testImage = new Image();

            testImage.onload = function () {
                // Client HAS internet
                console.log("Client is Online");
                $('#ClientConnected').val("true");
                $('#recaptcha-container').show(); // Show the captcha
            };

            testImage.onerror = function () {
                // Client has NO internet (or Google is blocked)
                console.log("Client is Offline");
                $('#ClientConnected').val("false");
                $('#recaptcha-container').hide(); // Hide the captcha
            };

            $('#close-alert-btn').on('click', function () {
                // Memberikan efek perlahan menghilang (fade out)
                $('#cyber-security-alert').css('opacity', '0');

                // Menghilangkan elemen dari tampilan setelah efek transisi selesai (400ms)
                setTimeout(function () {
                    $('#cyber-security-alert').hide();
                }, 400);
            });

            // Attempt to load google logo with a timestamp to prevent caching
            testImage.src = "https://www.google.com/favicon.ico?" + (new Date()).getTime();
        });
    </script>
</body>
</html>